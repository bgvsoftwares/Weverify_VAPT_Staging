@*@using GridMvc.Html*@
@*@model IEnumerable<ViewModels.MonthelyProjection>*@
@model ViewModels.ClientInfoListPagedModel


@section DisplayTitle{ @Html.Partial("_DisplayTitle") }

@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

@if (Model.BillingUploadDetail != null)
{
    var fileName = "";
    if (Request.QueryString["fileName"] != null)
    {
        fileName = @Request.QueryString["fileName"].ToString();
    }
    <div class="total-record">Total Records: @Model.TotalRecords</div>
    <div class="total-record">Error in Records: @Model.ErrorRecord</div>
    <div style="height:300px;overflow-y:scroll;">

        @{
            WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
            grid.Bind(Model.BillingUploadDetail, autoSortAndPage: false, rowCount: Model.TotalRecords);
        }
        @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {                                     




            grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),

grid.Column(columnName: "ErrorStatus", header: "Error Status", canSort: false, style:"col-md-2"),
grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-2"),
grid.Column(columnName: "CompanyRefNo", header: "Ref No.", canSort: false, style:"col-md-2"),
grid.Column(columnName: "Month", header: "Month", canSort: false, style:"col-md-2"),
grid.Column(columnName: "Year", header: "Year", canSort: false, style:"col-md-2"),
grid.Column(columnName: "AnnexureValue", header: "AnnexureValue", canSort: false, style:"col-md-2"),
grid.Column(columnName: "AdditionCost", header: "AdditionCost", canSort: false, style:"col-md-2"),
grid.Column(columnName: "FinalAnnexureAmount", header: "FinalAnnexureAmount", canSort: false, style:"col-md-2"),
grid.Column(columnName: "Approvalstatus", header: "Approvalstatus", canSort: false, style:"col-md-2"),
grid.Column(columnName: "Status", header: "Status", canSort: false, style:"col-md-2"),
grid.Column(columnName: "InvoiceNo", header: "InvoiceNo", canSort: false, style:"col-md-2"),
grid.Column(columnName: "InvoiceDate", header: "InvoiceDate", canSort: false, style:"col-md-2"),
grid.Column(columnName: "PenaltyAmount", header: "Panalty", canSort: false, style:"col-md-2"),                                              }
                                                )


    </div>
    <div>
        @using (Html.BeginForm("InvoiceProceedConfirm", "Billing", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            if (Request.QueryString["fileName"] != null)
            {
                @Html.Hidden("fileName", Request.QueryString["fileName"].ToString())
            }
            if (@Model.BillingUploadDetail.Count() > 0)
            {
                <input class="btn btn=info" id="Proceed" type="submit" onclick="return confirm('Are you sure to want to proceed?')" name="Command" value="Proceed" />
                <input class="btn btn=info" id="Cancel" type="submit" onclick="return confirm('Are you sure to want to cancel?')" name="Command" value="Cancel" />
            }

        }

    </div>
}

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>


    <script type="text/javascript">

    </script>
}
