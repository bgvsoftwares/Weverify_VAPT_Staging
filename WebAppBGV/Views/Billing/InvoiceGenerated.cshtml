@model ViewModels.ClientInfoListPagedModel
@{
    ViewBag.Title = "Invoice Generated";
}




@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("InvoiceGenerated", "Billing", FormMethod.Post))
                        {
                        <div class="form-horizontal">
                            <div class="form-group branch search-frame">
                                <div class="container">
                                    <div class="row">
                                <div class="col-sm-2 control-label">Month :</div>
                                <div class="col-sm">
                                    @Html.DropDownListFor(model => model.BillingInvoiceGenerated.Month, new List<SelectListItem>
 { new SelectListItem{Text="January", Value="January"},
 new SelectListItem{Text="February", Value="February"},
 new SelectListItem{Text="March", Value="March"},
 new SelectListItem{Text="April", Value="April"},
  new SelectListItem{Text="May", Value="May"},
   new SelectListItem{Text="June", Value="June"},
    new SelectListItem{Text="July", Value="July"},
     new SelectListItem{Text="August", Value="August"},
      new SelectListItem{Text="September", Value="September"},
      new SelectListItem{Text="October", Value="October"},
      new SelectListItem{Text="November", Value="November"},
      new SelectListItem{Text="December", Value="December"},
                               },
 "-- Select Month --",
 new { @class = "form-control" })

                                </div>

                                <div class="col-sm-2 control-label">
                                  Year:
                                </div>
                                <div class="col-sm">
                                    @Html.DropDownListFor(model => model.BillingInvoiceGenerated.Year, new List<SelectListItem>
{ new SelectListItem{Text="2019", Value="2019"},
new SelectListItem{Text="2020", Value="2020"},
new SelectListItem{Text="2021", Value="2021"},
new SelectListItem{Text="2022", Value="2022"}},
"-- Select Year --",
new { @class = "form-control" })
                                </div>
                                    </div>
                            </div>
                                </div>

                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">Client Name :</label>
                                <div class="col-md-5">
                                    @Html.DropDownListFor(model => model.BillingInvoiceGenerated.ClientRowId,
                       new SelectList(ViewBag.clientList, "ClientId", "ClientName"),
                       "-- Select Client -- ",
                       new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.BillingInvoiceGenerated.ClientRowId, "", new { @class = "text-danger" })

                                </div>
                            </div>


                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">Annexure No :</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(m => m.BillingInvoiceGenerated.AnnexureNo, null, new { @class = "form-control" })

                                </div>
                            </div>
                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">Invoice No :</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(m => m.BillingInvoiceGenerated.InvoiceNo, null, new { @class = "form-control" })

                                </div>
                            </div>

                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">Invoice Amount :</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(m => m.BillingInvoiceGenerated.InvoiceAmount, null, new { @class = "form-control" })
                                </div>
                            </div>


                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">GST Amount :</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(m => m.BillingInvoiceGenerated.GSTAmount, null, new { @class = "form-control" })
                                </div>
                            </div>


                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">TDS Amount :</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(m => m.BillingInvoiceGenerated.TDSAmount, null, new { @class = "form-control" })

                                </div>
                            </div>

                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">GST :</label>
                                <div class="col-md-5">
                                    @Html.DropDownListFor(model => model.BillingInvoiceGenerated.GST, new List<SelectListItem>
{ new SelectListItem{Text="Paid By client", Value="Paid By client"},
new SelectListItem{Text="Paid By Securitas", Value="Paid By Securitas"}},
"-- Select --",
new { @class = "form-control" })
                                </div>
                            </div>

                            <div class="form-group branch search-frame">

                                <label class="col-md-2 control-label">Total amount :</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(m => m.BillingInvoiceGenerated.TotalAmount, null, new { @class = "form-control" })

                                </div>
                            </div>




                            <div class="all-button-bg">


                                @*<input class="btn bun-bg btn-default" type="submit" value="CheckDelete" name="CheckDel" onclick="DeleteCheck()" />*@
                                @*<input class="btn bun-bg btn-default" type="submit" value="CheckMove" name="MoveCheck" onclick="DeleteCheck()" />*@
                                <input class="btn bun-bg btn-default" id="Submit" type="submit" value="Submit" name="Submit" />
                                @*<button type="button" class="btn bun-bg btn-default" onclick="location.href='@Url.Action("DeleteCheck", "ClientServicing")'">DeleteCheck</button>*@





                            </div>
                            <br />
                            <br>
                        </div>
                        }
                    </div>


                </div>
             

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $("#BillingInvoiceGenerated_InvoiceAmount").on("input", function (evt) {
                var self = $(this);
                self.val(self.val().replace(/[^0-9\.]/g, ''));
                if ((evt.which != 46 || self.val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)) {
                    evt.preventDefault();
                }
            });

            //$("#BillingInvoiceGenerated_InvoiceNo").on("input", function (evt) {
            //    var self = $(this);
            //    self.val(self.val().replace(/[^0-9\.]/g, ''));
            //    if ((evt.which != 46 || self.val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)) {
            //        evt.preventDefault();
            //    }
            //});

            $("#BillingInvoiceGenerated_TotalAmount").on("input", function (evt) {
                var self = $(this);
                self.val(self.val().replace(/[^0-9\.]/g, ''));
                if ((evt.which != 46 || self.val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)) {
                    evt.preventDefault();
                }
            });

            $("#BillingInvoiceGenerated_AnnexureNo").on("input", function (evt) {
                var self = $(this);
                self.val(self.val().replace(/[^\d].+/, ""));
                if ((evt.which < 48 || evt.which > 57)) {
                    evt.preventDefault();
                }
            });


            $("#BillingInvoiceGenerated_GSTAmount").on("input", function (evt) {
                var self = $(this);
                self.val(self.val().replace(/[^0-9\.]/g, ''));
                if ((evt.which != 46 || self.val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)) {
                    evt.preventDefault();
                }
            });



            $("#BillingInvoiceGenerated_TDSAmount").on("input", function (evt) {
                var self = $(this);
                self.val(self.val().replace(/[^0-9\.]/g, ''));
                if ((evt.which != 46 || self.val().indexOf('.') != -1) && (evt.which < 48 || evt.which > 57)) {
                    evt.preventDefault();
                }
            });

            // 
        });

        $("#Submit").click(function () {
            var month = $("#BillingInvoiceGenerated_Month");
            var year = $("#BillingInvoiceGenerated_Year");           
            var ClientRowId = $("#BillingInvoiceGenerated_ClientRowId");
            var GST = $("#BillingInvoiceGenerated_GST");
            var InvoiceNo = $("#BillingInvoiceGenerated_InvoiceNo");
            var AnnexureNo = $("#BillingInvoiceGenerated_AnnexureNo");
            var InvoiceAmount = $("#BillingInvoiceGenerated_InvoiceAmount");
            var TotalAmount = $("#BillingInvoiceGenerated_TotalAmount");
            var GSTAmount = $("#BillingInvoiceGenerated_GSTAmount");
            var TDSAmount = $("#BillingInvoiceGenerated_TDSAmount");

            // 
            //alert(AnnexureNo);
            if (month.val() == "") {
               
                alert("Please select Month!");
                return false;
            }

            if (AnnexureNo.val() == "") {               
                alert("Please fill AnnexureNo!");
                return false;
            }

            if (InvoiceAmount.val() == "") {              
                alert("Please fill Invoice Amount!");
                return false;
            }

            if (InvoiceNo.val() == "") {               
                alert("Please fill Invoice No!");
                return false;
            }

            if (TotalAmount.val() == "") {               
                alert("Please fill Total Amount!");
                return false;
            }


            if (GSTAmount.val() == "") {            
                alert("Please fill GST Amount!");
                return false;
            }

            if (TDSAmount.val() == "") {               
                alert("Please fill TDS Amount!");
                return false;
            }

            // 

            if (year.val() == "") {               
                alert("Please select year!");
                return false;
            }

            if (ClientRowId.val() == "") {              
                alert("Please select Client name!");
                return false;
            }

            if (GST.val() == "") {               
                alert("Please select GST!");
                return false;
            }

            //
            return true;
        });
    </script>
    <script>
        function myFunction() {
            confirm("Do you want to delete!");
        }
        function myFunction1() {
            var txt;
            var r = confirm("Press a button!");
            if (r == true) {
                txt = "You pressed OK!";
            } else {

            }
            document.getElementById("demo").innerHTML = txt;
        }
    </script>


}



