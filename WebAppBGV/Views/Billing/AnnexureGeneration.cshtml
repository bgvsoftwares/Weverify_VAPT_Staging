        <div class="row">
            @using (Html.BeginForm("MonthelyProjection", "Billing", FormMethod.Get))
            {
                <div class="column col-md-4">
                    <h4 class="text-center">Drop Here</h4>
                    <ul class="connected-sortable droppable-area2" style="height:400px;overflow-y:scroll;" id="myDiv">
                        @*<li class="draggable-item">Drag File from left to here</li>*@
                    </ul>

                    @Html.Hidden("ClientIds", null)

                    <input class="btn btn=info" id="getDetails" type="submit" name="Command" value="Get Detail" />
                    @*if (Model.MonthelyProjectionList != null)
                {
                    <input class="btn btn=info" id="btnProceed" type="submit" name="Command" value="Proceed" />
                }*@
                    @*<button class="btn btn=info" id="getDetails" type="submit">Get Detail</button>*@
                    @*<button class="btn btn=info" id="btnProceed" type="submit">Proceed</button>*@

                </div>
                <div>

                    @if (Model.MonthelyProjectionList != null)
                    {

                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-md-12">
                                    <div style="overflow-y:auto; margin-top:50px; width:100%">
                                        <input type="hidden" name="getID" id="getId" />
                                        <h3 class="text-center">Annexure Details</h3><hr />
                                        @*@Html.Partial("MonthelyProjection", Model)*@

                                        <div class="grid">

                                            @{
                                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                                grid.Bind(Model.MonthelyProjectionList, autoSortAndPage: false, rowCount: Model.TotalRecords);
                                            }
                                            @grid.GetHtml(
                                                                                      htmlAttributes: new { id = "grid", @class = "table" },
                                                                                      headerStyle: "thead-inverse",
                                                                                      rowStyle: "ordertxt",
                                                                                      footerStyle: "custpaging",
                                                                                      mode: WebGridPagerModes.All,
                                                                                      columns: new[]
                                                                                      {

                            grid.Column(header: "No.", style:"name", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                            grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"name"),
                            grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"name"),
                            grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"name"),
                            grid.Column(columnName: "CheckOrPackage", header: "CheckOrPackage", canSort: false, style:"name"),
                            grid.Column(columnName: "InitianDate", header: "InitianDate", canSort: false, style:"name"),
                            grid.Column(columnName: "CaseStatus", header: "CaseStatus", canSort: false, style:"name"),
                            grid.Column(columnName: "ReportSendDate", header: "ReportSendDate", canSort: false, style:"name"),
                            grid.Column(columnName: "ReportColor", header: "ReportColor", canSort: false, style:"name") })


                                        </div>
                                        <input class="btn btn=info" id="btnProceed" type="submit" name="Command" value="Proceed" />




                                    </div>

                                </div>

                            </div>

                        </div>


                    }
                </div>
            }

        </div>

</div>
