    $(document).on('change', 'input[class="ClientId"]', function (e) {// on change of state
        var ClientIds = '';
        $('input[class="ClientId"]').each(function (index, value) {
            if (this.checked) { ClientIds += this.value + ','; }
        });

        if (false == $(this).prop("checked")) { //if this item is unchecked
            $("#select_all").prop('checked', false); //change "select all" checked status to false
        }
        //check "select all" if all checkbox items are checked
        if ($('.ClientId:checked').length == $('.ClientId').length) {
            $("#select_all").prop('checked', true);
        }

        if (ClientIds.length > 0) {
            ClientIds = ClientIds.substring(0, ClientIds.length - 1);
        } else { ClientIds = ''; }
        $('#ClientIds').val(ClientIds.trim());
        //alert(ClientIds);
    });

    function myFunction() {
        var input, filter, ul, li, a, i, txtValue;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        ul = document.getElementById("myUL");
        li = ul.getElementsByTagName("li");
        for (i = 0; i < li.length; i++) {
            a = li[i].getElementsByTagName("a")[0];
            txtValue = a.innerHTML;
            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                li[i].style.display = "";
            } else {
                li[i].style.display = "none";
            }
        }
    }
</script>
