                    connectWith: ".connected-sortable",
                    stack: ".connected-sortable ul"
                })
                .disableSelection();

        };

        $("#getDetails").click(function () {
            var ids = $("#myDiv")
                .find("li") //Find the spans
                .map(function () { return this.id; }) //Project Ids
                .get().join(",");
            $('#ClientIds').val(ids);



           
        });
        //console.log(ids);
        // })

