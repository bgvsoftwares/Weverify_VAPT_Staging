        //    } else { ClientIds = ''; }
        //    $('#ClientIds').val(ClientIds.trim());
        //    //alert(ClientIds);
        //});

        $(".ddlstatus").change(function () {
            //alert('1');
            var dataRow = $(this).closest("tr");
            dataRow.find("td:eq(4)").find("textarea").attr("disabled", false);
            var col5 = dataRow.find("td:eq(6)").text();
            //alert(col5);
            $("#getId").val(col5);
            // alert(col3);
        });

        $(".Update").click(function ()
        {
            var dataRow = $(this).closest("tr");
            //dataRow.find("td:eq(4)").find("textarea").attr("disabled", false);
            var billedValue = dataRow.find("td:eq(3)").find("input").val();
            var Remark = dataRow.find("td:eq(4)").find("textarea").val();
            var status = dataRow.find("td:eq(1)").find("option:selected").text();
            var CompanyRefNo = dataRow.find("td:eq(6)").text();

          
        $.ajax({
            type: "Post",
            data: { RefNo: CompanyRefNo, billedValue:billedValue, Remark:Remark, status:status},
            url: "/Billing/SaveAnnuxure",
            success: function (msg) {
                dataRow.find("td:eq(4)").find("textarea").attr("disabled", true);
                dataRow.find("td:eq(3)").find("input").attr("disabled", true);

            }
            });
        });
    });



    //$("#btnGetdetail").click(function () {
