<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js" integrity="sha512-AA1Bzp5Q0K1KanKKmvN/4d3IRKVlv9PYgwFPvm32nPO6QS8yH1HO7LbgB1pgiOxPtfeg5zEn2ba64MUcqJx6CA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
@{
    Layout = null;
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        
    }

    html {
        overflow: hidden;
        font-size: 62.5%;
    }

    body {
        overflow: hidden;
        font-size: 1.6rem !important;
        background-color: #f2f2f2;
    }

    .my-box {
        height: 95vh;
        max-width: 95%;
        margin: 1.5rem auto;
    }

    #Feedback_form {
        width: 100%;
        height: 95vh;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        margin: 0rem auto;
        box-shadow: 1px 1px 8px 1px #565656;
        border-radius: 2rem;
        padding: 0 1rem;
        background-color: #fff;
    }

    .my-heading {
        margin: 2rem auto 0 !important;
        font-size: 2.7rem;
    }

    .form-control {
        font-size: 1.7rem !important;
        border-radius: 1rem !important;
    }

    .my-para {
        font-size: 1.8rem;
        padding: 2rem 0 !important;
    }

    .rating {
        width: 95%;
        margin: 0 auto;
        border: 1px #5f5f5f solid;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 500;
        flex-direction: row-reverse;
        background: linear-gradient(to right, #f00, #ff0, #0f0);
    }

        .rating input {
            display: none;
        }

        .rating label {
            display: flex;
            width: 130px;
            height: 4.2rem;
            font-size: 1.7rem;
            justify-content: center;
            align-items: center;
            background: #fff;
            color: #000;
            border-left: 1px #999 solid;
            cursor: pointer;
        }

        .rating input[type="radio"]:hover ~ label,
        input[type="radio"]:checked ~ label {
            background: none;
            color: #000 !important;
        }

    .my--btn {
        font-size: 1.8rem !important;
    }

    .ErrorMsg {
        text-align: center !important;
        font-size: 2.2rem;
        margin: 1rem auto;
        background: #AFE1AF;
        font-weight: 600;
        border-radius:1rem;
        color: #000 !important;
        width: 90%;
        padding: 1rem 0;
    }

    @@media only screen and (max-width: 999px) {
        .my-box {
            width: 100% !important;
        }
    }
</style>


<section class="container">
    <div class="row">
        <div class="col-md-6 mx-auto my-box">
            @using (Html.BeginForm("GetFeedback", "Account", FormMethod.Post, new { @id = "Feedback_form" }))
            {
                
                if (ViewBag.ErrorMsg != null && @ViewBag.ErrorMsg != "")
                {
                    <div class="text-center ErrorMsg">
                        @ViewBag.ErrorMsg
                    </div>
                }
                <h1 class="text-center my-heading">Welcome To Feedback Page</h1>
                <p class="m-0 my-para py-2 text-center">
                    Based on our recent service. How likely are you to rate us based
                    on below Rating.
                </p>
                <div class="rating">
                    <input type="radio" name="rating" value="5" id="rata5" required />
                    <label for="rata5">5</label>
                    <input type="radio" name="rating" value="4" id="rata4" required />
                    <label for="rata4">4</label>
                    <input type="radio" name="rating" value="3" id="rata3" required />
                    <label for="rata3">3</label>
                    <input type="radio" name="rating" value="2" id="rata2" required />
                    <label for="rata2">2</label>
                    <input type="radio" name="rating" value="1" id="rata1" required />
                    <label for="rata1">1</label>
                </div>
                <div class="col-md-11 my-3">
                    <label class="my-para text-center">Would You Like To Add Your Valuable Comment !!</label>
                    <textarea class="form-control mt-2"
                              cols="0"
                              rows="3"
                              name="comment"
                              id="comment"
                              placeholder="Enter Your Valuable  Comment..."></textarea>
                </div>
                <div class="text-center my-4">
                    <input type="submit"
                           class="btn btn-secondary text-white my--btn p-3"
                           value="SUBMIT" />
                </div>
            }
        </div>
    </div>
</section>