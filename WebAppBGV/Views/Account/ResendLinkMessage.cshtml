<body>
    <style>
        body {
            font-family: 'Securitas Pro';
        }

        .card {
            position: fixed;
            left: 0;
            right: 0;
            top: 100px;
        }

        .card-link {
            background: #031F30;
            color: #FFF;
            padding: 10px 40px;
            border: 1px solid #031F30;
            border-radius: .25rem;
        }

            .card-link:hover {
                background: #FFF;
                color: #031F30;
            }

        .fas {
            font-size: 4rem;
            color: #8D5FFF;
        }

        img {
            width: 100px;
        }
    </style>
    @if (ViewBag.Success != null && ViewBag.Success != "")
    {
        <nav class="navbar bg-body-tertiary">
            <div class="container-fluid justify-content-end">
                <a class="navbar-brand">
                    <img src="https://bgv.securitas-india.com/assets/LoginCarusol/img/Securitas-logo.png" />
                </a>
            </div>
        </nav>
        <div class="card w-50 m-auto  h-auto text-center">
            <div class="card-body p-4">
                <h5 class="card-title">
                    <i class="fas fa-paper-plane"></i>
                </h5>
                <h5 class="card-title" style="font-size:20px;">Mail Sent Successfully</h5>
                <p class="card-text w-75 m-auto">A new email containing your login credentials has been sent to you separately. Please check your inbox for further details.</p>
                <br />
                <a href="https://bgv.securitas-india.com/Account/CandidateLogin" class="card-link">Go Further</a>
            </div>
        </div>
    }
    else if (ViewBag.ErrorMsg != null && ViewBag.ErrorMsg != "")
    {
        <nav class="navbar bg-body-tertiary">
            <div class="container-fluid justify-content-end">
                <a class="navbar-brand">
                    <img src="https://bgv.securitas-india.com/assets/LoginCarusol/img/Securitas-logo.png" />
                </a>
            </div>
        </nav>
        <div class="card w-50 m-auto  h-auto text-center">
            <div class="card-body p-4">
                <h5 class="card-title">
                    <i class="fas fa-paper-plane"></i>
                </h5>
                <h5 class="card-title" style="color:#FC273F;font-size:20px;">Mail Sent Failure</h5>
                <p class="card-text" style="font-size:.70rem;">@ViewBag.ErrorMsg</p>
                <p class="card-text w-75 m-auto">We regret to inform you that there was a failure in sending your email. Please try again after some time. Alternatively, you may reach us at <sapn style="color:#8D5FFF;font-weight:bold;">bgv.helpdesk@securitas-india.com</sapn> for further assistance.</p>
                <br />
                @*<a href="https://bgv.securitas-india.com/Account/CandidateLogin" class="card-link">Go Further</a>*@
            </div>
        </div>
    }
    else
    {
        <p class="card-text" style="font-size: 2rem;
  position: fixed;
  left: 0;
  top: 100px;
  display: flex;
  justify-content: center;
  right: 0;">Your session has timed out.</p>
    }
</body>
</html>

