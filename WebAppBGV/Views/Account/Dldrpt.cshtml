@model ViewModels.ProvidedInfoViewModel.ReportDownload
@{
    ViewBag.Title = " Report Download";
    Layout = "~/Views/Shared/_insuffLayout.cshtml";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="container">
    <div class="row">

        <div class="col-md-12">

            @using (Html.BeginForm("Dldrpt", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.reportName);
                @Html.HiddenFor(model => model.ClientRowId);
                <div class="form-horizontal">
                    <div class="form-group row branch">
                        <div class='container' style="margin-top:20px;">
                            <div class='row'>
                                <div class='col-md-2'>
                                    Key
                                </div>
                                <div class='col-md-4'>
                                    @Html.TextBoxFor(model => model.reportId, new { @class = "form-control" , @autocomplete = "off" })
                                </div>
                                <div class='col-md-4'>
                                    <input class="btn bun-bg btn-default" type="submit" id="btnSubmit" value="Submit" />
                                </div>
                            </div>
                        </div>
                    </div>


                </div>

            }

        </div>
    </div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>


}
