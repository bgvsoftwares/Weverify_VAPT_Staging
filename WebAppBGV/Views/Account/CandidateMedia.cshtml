        ViewBag.Title = "Media Gallary";
        Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";


    }*@
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>MediaGallary</title>
    <style>
        #vid {
            height: 500px;
            width: auto;
            position: relative;
            left: 0;
            right: 0;
            margin: auto;
        }
    </style>
</head>
<body>
    <div>

        <div class="container">
            <div class="row">
                <div class="col-md-1 d-sm-none d-xs-none"></div>
                <div class="col-md-10">
                    <video width="100%" height="100%" controls autoplay loop muted id="vid">
                        <source src="~/MediaLibrary/Candidate portal_HowToUse.mp4" type="video/mp4">
                        <source src="~/MediaLibrary/Candidate portal_HowToUse.mp4" type="video/ogg">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="col-md-1  d-sm-none d-xs-none"></div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            document.getElementById('vid').play();
        });
    </script>
</body>
</html>