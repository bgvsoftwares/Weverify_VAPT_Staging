<div class="container">
    @using (Html.BeginForm("InsuffClear", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        if (ViewBag.CheckStatus == true)
        {

            @Html.HiddenFor(model => model.CheckRowID)
            @Html.HiddenFor(model => model.SubCheckName)
            @Html.HiddenFor(model => model.INFReason)
            <input type="hidden" value="@Model.ClientRowID" id="ClientRowID" name="ClientRowID" />
            <input type="hidden" value="@Model.ChFamilRowId" id="ChFamilRowId" name="ChFamilRowId" />
            <input type="hidden" value="@Model.SubCheckRowID" id="SubCheckRowID" name="SubCheckRowID" />
            <input type="hidden" value="@Model.PersonalRowID" id="PersonalRowID" name="PersonalRowID" />
            <input type="hidden" value="@Model.SecuritasID" id="SecuritasID" name="SecuritasID" />
            <input type="hidden" value="" id="UploadHid" name="UploadHid" />           
            <div class="container">
                <div class="row">
                    <div class="col-md-2">
                        @Html.LabelFor(model => model.SubCheckName, htmlAttributes: new { @class = "control-label", style = "font-weight:bolder; font-size:1.2rem!important; color:#031F30;" })
                    </div>
                    <div class="col-md-6">
                        <p style="font-weight:bolder; font-size:1.2rem!important; color:#031F30;">@Model.SubCheckName</p>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-md-2">
                        @Html.Label("Insuff Remark:", htmlAttributes: new { @class = "control-label", style = "font-weight:bolder; font-size:1.2rem!important; color:#031F30;" })
                    </div>
                    <div class="col-md-6">
                        <p style="font-weight:bolder; font-size:1.2rem!important; color:#ff0000;">@Model.INFReason</p>
                    </div>
                </div>
            </div>
            <div class="container" id="dvUplodDoc">

            </div>
            <div class="container">
                <div class="row mb-3">
                    <div class="col-md-2">
                        @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "control-label" })
                    </div>
                    <div class="col-md-6">
                        @Html.TextAreaFor(model => model.EmployeeID, new { @class = "form-control", @rows = "2" })
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-md-2">
                        @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "control-label" })
                    </div>
                    <div class="col-md-6">
                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "4" })
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="row m-3">
                    <div class="col-md-4 m-auto text-center">
                        <input class="btn bun-bg btn-default" type="submit" id="btnSubmit" value="Submit" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="all-button-bg">
                <a>Successfully Clear Insufficiency</a>
            </div>
        }
    }

</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <script>
        $(document).ready(function () {
            if ($("#SubCheckRowID").val() > 0) {
                var url1 = "/Account/GetDocumentTypeListBySubCheckID/" + $("#SubCheckRowID").val();
                $.ajax({
                    url: url1,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (allData) {
                        if (allData != null && allData != "") {
                            $('#dvChksPcks').show();
                            var items = '';
                            jQuery.each(allData, function (index, allData) {
                                items += "<div class='row'><div class='col-lg-4'><label class='control-label'> " + allData.Text + " :</label></div><div class='col-md-6 dflexcheck'><div class='col-md-2'><input type='checkbox' name='chkDoc' value=" + allData.Value + " class='form-control' style='width:20px;' /></div><div class='col-md-4 mt-1'><input data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + " id=" + allData.Value + "></div></div></div>"

                            });
                            $('#dvUplodDoc').html(items);
                        }
                        else {
                            $('#dvChksPcks').hide();
                            alert("No Doc Selected");
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        alert("some error");
                    }
                });
            }

        });

        $(document).on('change', 'input[name="chkDoc"]', function (e) {// on change of state
            var chkDocs = '';
            $('input[name="chkDoc"]').each(function (index, value) {
                if (this.checked) {
                    chkDocs += this.value + ',';
                    $("#" + this.value + "").removeAttr("disabled");
                }
                else {
                    $("#" + this.value + "").attr("disabled", "disabled");
                }
            });

            if (chkDocs.length > 0) {
                chkDocs = chkDocs.substring(0, chkDocs.length - 1);
            } else { chkDocs = ''; }
            $('#UploadHid').val(chkDocs.trim());
        }); 


    </script>
}
