@{
    ViewBag.Title = "livelinessMessage";
    Layout = null;
    var data = ViewBag.Error;
}
<!doctype html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
</head>
<body style="background-image:url(/assets/DashboaredImages/snapedit_1744893166283.png);background-repeat:no-repeat;">
    <nav class="navbar bg-none">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <img src="https://bgv.securitas-india.com/assets/LoginCarusol/img/Securitas-logo.png" width="100" />
            </a>
        </div>
    </nav>
    @if (string.IsNullOrEmpty(data))
    {
        <div class="container mt-5" style="line-height:1.2;">
            <p style="font-size: 5rem;font-weight: bolder;color: #031F30;margin-bottom:0px;">Thank You!</p>
            <p style="font-size:1.2rem;color: #031F30;font-family:'Securitas Pro';margin-left: 15px;">You have just done the hardest!</p>
        </div>

        <div class="container mt-5" style="line-height:1.2;">
            <p style="font-size: 1.5rem;color: #031F30;font-family:'Securitas Pro';margin-left: 15px;">What you want to do next?</p>
            <div class="row ms-2 mt-4">
                <div class="col-md-2">
                    <a href="https://www.google.com/" class="btn1">Go back home</a>
                </div>
                <div class="col-md-2">
                    <a href="https://www.securitas.com/en/" class="btn2">Explore more</a>
                </div>
            </div>
        </div>
    }
    else
    {

        <div id="OCRspinner" class="overlay1">
            <!-- Pop-up content -->
            <div class="popup">
                <div class="d-flex justify-content-center">
                    <b class="text-danger p-2">@ViewBag.Error</b>

                </div>
            </div>
        </div>
    }

    @*<nav class="navbar bg-none" style="position: fixed;width: 100%;bottom: 0;">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">
                    <img src="~/assets/LoginCarusol/img/Securitas-logo.png" width="100" />
                </a>
            </div>
        </nav>*@
    <style>
        .btn1 {
            border: 2px solid #031F30;
            border-radius: 0px;
            color: #031F30;
            transition: .3s ease-in-out;
            text-decoration: none;
            padding: 10px 20px;
            cursor: pointer;
        }

            .btn1:hover {
                background: #031F30;
                color: #FFF;
            }

        .btn2 {
            background: #031F30;
            border: 2px solid #031F30;
            border-radius: 0px;
            color: #FFF;
            transition: .3s ease-in-out;
            text-decoration: none;
            padding: 10px 20px;
            cursor: pointer;
        }

            .btn2:hover {
                background: #FFF;
                color: #031F30;
            }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>
</body>
</html>