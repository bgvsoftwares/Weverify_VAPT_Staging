@{
    //ViewBag.Title = "Initiateliveliness";
    Layout = null;
}
<body class="dark-mode">



    <div class="login-page">
        <div class="login-banner">
            <img src="/assets/LoginCarusol/img/SBC - Page-3.png" alt="" />
        </div>
        <div class="container edit-conatiner">
            <div class="login-header">
                <h1>Candidate Details</h1>
            </div>
            @using (Html.BeginForm("Initiateliveliness", "Account", FormMethod.Post))
            {
                <form id="loginForm">
                    <div class="inputGroup">
                        <label for="">Candidate Full Name</label>
                        <div class="d-flex flex-wrap ">

                            @Html.Editor("fullName", new { @class = "form-control", placeholder = "Full Name...", required = "required" })
                            <p class="text-danger p-2">@ViewBag.fullName</p>
                        </div>
                    </div>
                    <div class="inputGroup">
                        <label for="">Aadhaar Number</label>
                        <div class="d-flex flex-wrap ">
                            @Html.Editor("aadhaarNumber", new { @class = "form-control",  placeholder = "Aadhhaar No...", htmlAttributes = new { @maxlength = "12" , @type = "number", } })
                            <p class="text-danger p-2">@ViewBag.aadhaarNumber</p>
                        </div>
                    </div>
                    <div class="inputGroup">
                        <label for="">Mobile No</label>
                        <div class="d-flex flex-wrap ">

                            @Html.Editor("MobileNo", new { @class = "form-control", placeholder = "Mobile No..." ,  htmlAttributes = new { @maxlength = "10", @type = "number", } })
                            <p class="text-danger p-2">@ViewBag.MobileNo</p>
                        </div>
                    </div>
                    <div class="inputGroup">
                        <label for="">Email Id</label>
                        <div class="d-flex flex-wrap ">
                            @Html.Editor("EmailId", new { @class = "form-control", placeholder = "Email Id..." })
                            <p class="text-danger p-2">@ViewBag.EmailId</p>
                        </div>
                    </div>
                    <div class="inputGroup">
                        <button type="submit">Click here to Send</button>
                    </div>
                    <br />
                    <div class="inputGroup">
                        <div class="d-flex flex-wrap ">
                            <p class="text-danger p-2">@ViewBag.Error2</p>
                        </div>
                    </div>

                    <div id="OCRspinner" class="overlay1">
                        <!-- Pop-up content -->
                        <div class="popup">
                            <div class="d-flex justify-content-center">
                                <div class="spinner-border" role="status">
                                    <span class="sr-only">.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            }
        </div>
    </div>




</body>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .login-banner {
        background: #26224c;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 50%;
    }

        .login-banner img {
            margin - top: 3rem;
            width: 80%;
        }

    .login-page {
        display: flex;
    }

    .edit-conatiner {
        width: 50%;
        background: #c2b4fc;
    }

    .container.edit-conatiner form {
        width: 100%;
        max-width: 400px;
        padding: 30px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .inputGroup div p {
        padding: 0;
        margin: 0;
        color: #ea0101;
        font-size: 12px;
    }

    .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .login-header h1 {
        margin: 0 0 1em;
        letter-spacing: 1px;
        text-align: center;
        color: #fff;
    }

    body:not(.dark-mode) .login-header h1 {
        color: #333;
    }

    .login-form {
        width: 90%;
        max-width: 600px;
        padding: 2.25em;
        border-radius: 0.5em;
        background-color: rgba(59, 62, 64, 0.2);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        border: none;
    }



    .inputGroup label {
        color: #fff;
        display: inline-block;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .inputGroup input {
        width: 100%;
        height: 45px;
        padding: 0 1em;
        font-size: 14px;
        border: none;
        border-radius: 4px;
        outline: none;
        background: #fff;
        color: #000;
        box-shadow: rgba(60, 64, 67, 0.3) 0px 1px 2px 0px, rgba(60, 64, 67, 0.15) 0px 1px 3px 1px;
    }

    input::placeholder {
        color: #000;
    }

    .edit-conatiner input::placeholder {
        color: rgba(0, 0, 0, 0.7);
    }

    .inputGroup button {
        width: 100%;
        height: 50px;
        font-size: 14px;
        font-weight: 600;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        background-color: #000;
        color: #fff;
        margin-top: 15px;
    }

    .edit-conatiner .inputGroup button {
        background - color: #000;
        color: #fff;
    }



    @@media (max-width: 540px) {
        .inputGroup {
            flex-wrap: wrap;
        }
    }







    .modal-content {
        border: none !important;
    }

    .modal-dialog-centered::before {
        display: none !important;
    }

    .spinner-border {
        width: 12rem !important;
        height: 12rem !important;
        border: .25em solid rgb(251 252 255) !important;
        border-right-color: transparent !important;
    }

    .modal-header {
        border-bottom: unset !important;
    }

    .modal-content {
        background-color: none !important;
    }


    /* Overlay style */
    .overlay1 {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;
    }

    /* Pop-up style */
    .popup {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: unset;
        padding: 20px;
        border-radius: 8px;
    }

    /* Close button */
    .close-btn {
        background: red;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 5px;
        cursor: pointer;
    }
</style>


