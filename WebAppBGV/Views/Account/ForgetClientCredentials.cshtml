                                                    <legend class="legend">New Password</legend>
                                                    @Html.EditorFor(model => model.CRPNewPwd, new { htmlAttributes = new { @placeholder = "New Password", @class = "form-control_fwd", @id = "CRPNewPwd", @autocomplete = "off" } })
