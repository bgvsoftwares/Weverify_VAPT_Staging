                            </div>
                            @using (Html.BeginForm("ForgetClientCredentials", "Account", FormMethod.Post, new { @autocomplete = "off", @class = "Forget_class" }))
                            {
                                @Html.AntiForgeryToken()

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.WebUserRowID, new { @id = "WebUserRowID" })
                                @Html.HiddenFor(model => model.EncPWD, new { @id = "EncPWD" })
                                @Html.HiddenFor(model => model.CRPOldPwd1, new { @id = "CRPOldPwd1" })
                                @Html.HiddenFor(model => model.CRPUserName, new { @id = "CRPUserName" })
