@if (ViewBag.ErrorMsg != null && ViewBag.ErrorMsg != "")
{
    <script>
        $(document).ready(function () {
            Swal.fire({
                icon: 'info',

                //title: 'Mandatory Fields.',
        text: '@ViewBag.ErrorMsg',
        timer: 20000
})
        })
    </script>
}
<div class="container-fluid m-0 p-0">
    <nav class="navbar shadow mb-5" style="background: #031F30;">
        @if (Model.LoginByMailID != "")
        {
            <a class="navbar-brand text-white d-flex align-items-center" href="#">
                <i class="fa-solid fa-user" style="font-size: 20px; color: #031F30; background: #FFF; width: 35px; height: 35px; padding: 10px 5px; border-radius: 50%; margin-right: 10px; "></i>
                @Model.LoginByMailID
            </a>
            <input type="hidden" value="@WebAppBGV.CommonMethods.clsCommonMethods.PEncrypt(Model.LoginByMailID)" id="PEncryptUserID" />
        }
        <img src="~/assets/Client_Page_images/Securitas_newlogo.png" style="width:100px;">
    </nav>
    <div class="row">
        <div class="col-md-12 d-flex justify-content-center align-items-center">
            <div class="card h-auto w-50 mt-4">
                <div class="card-body p-0">
                    <div class="container-fluid">
                        @if (ViewBag.ErorrMsg != null)
                        {
                            <div class="row p-2">
                                <div class="col-md-12" style="text-align:center;">
                                    <span style="color:Red;font-weight:bold;font-size:1rem;">@ViewBag.ErorrMsg</span>
                                </div>
                            </div>
                        }
                        @using (Html.BeginForm("ClientOnboardingTemplateDetails", "Account", FormMethod.Get, new { enctype = "multipart/form-data" }))
                        {
                            <input type="hidden" id="ClientRowID" name="ClientRowID">
                            <input type="hidden" value="" name="UserEmailID" id="UserEmailID" />
                            <div class="row p-2">
                                <div class="col-md-9">
                                    <label class="form-label">Select Client Name</label>
                                    <input list="brow" id="clientSearch" class="form-control">
                                    <datalist id="brow">
                                        @foreach (var a in ViewBag.ClientList)
                                        {
                                            <option value="@a.ClientName" data-id="@a.ClientRowID"></option>
                                        }
                                    </datalist>

                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">&nbsp;</label>
                                    <input type="submit" value="Search" class="submit-btn w-100" />
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.ClientRowID != 0)
                    {
                        <div class="container-fluid">
                            @using (Html.BeginForm("ClientOnboardingTemplateDetails", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <div class="row p-2">
                                    <div class="col-md-6">
                                        <label class="form-label">From EmailID</label>
                                        <input type="text" value="" class="form-control" name="FromEmailID" required />
                                    </div>
                                    <div class="col-md-6">
                                        @if (Model.ClientRowID != 0)
                                        {
                                            <input type="hidden" value="@Model.ClientRowID" name="ClientRowID" />
                                            <input type="hidden" value="@WebAppBGV.CommonMethods.clsCommonMethods.PEncrypt(Model.LoginByMailID)" name="UserEmailID" />
                                        }
                                        <label class="form-label">Client EmailID</label>
                                        <input type="text" value="" class="form-control" name="ToEmailID" required />
                                    </div>
                                </div>
                                <div class="row justify-content-center p-2">
                                    <div class="col-md-3">
                                        <input type="submit" value="Send" class="submit-btn w-100" />
                                    </div>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
