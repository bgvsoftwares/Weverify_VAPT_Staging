<script>
    $(document).on("input", "#clientSearch", function () {
        var inputValue = $(this).val();
        var selectedOption = $("#brow option").filter(function () {
            return $(this).val() === inputValue;
        }).first();

        if (selectedOption.length) {
            $("#ClientRowID").val(selectedOption.data("id"));
        } else {
            $("#ClientRowID").val(""); // Clear if no match
        }
    });
    $(document).ready(function () {
        var ids = $("#PEncryptUserID").val();
        $("#UserEmailID").val(ids);
    });
</script>