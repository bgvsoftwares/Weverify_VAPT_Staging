<html>
<head>
    <title>Error Page</title>
    <style>



        img {
            max-width: 100%;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        html, body {
            height: 100%;
        }

        body {
            background: #fff;
        }

        .wrapper {
            position: relative;
            padding: 20px;
        }

            .wrapper .oops {
                color: #4B4F4B;
                font-size: 8em;
                letter-spacing: 0.05em;
                margin-top: 30px;
            }

            .wrapper .info {
                color: #4B4F4B;
                padding: 5px;
            }

            .wrapper .button {
                background: #FF5659;
                color: #fff;
                text-transform: uppercase;
                padding: 10px 40px;
                border-radius: 50px;
                transition: 150ms;
            }

                .wrapper .button:hover {
                    background: #FF2629;
                    transition: 150ms;
                }

                    .wrapper .button:hover .fa-angle-left {
                        animation: test 700ms ease-out;
                        animation-iteration-count: infinite;
                    }

                .wrapper .button .fa-angle-left {
                    font-size: 1.2em;
                    margin-right: 15px;
                }

            .wrapper img {
                padding: 10px;
            }
    </style>
</head>
<body>
    <div class="wrapper">
        <h2 class="text-danger">It seems that some compatibility issue with your system, </h2>
        <h2 class="text-danger">please contact with the Administrator or write us on bgv.helpdesk@securitas-india.com </h2>

        @if (Convert.ToString(Session["UserLogin"]) == "Client User")
        {
            <h2><a href="@Url.Action("DashboardClient", "Home", new { area = "ClientArea" })"> Go Back To Home Page</a></h2>
        }
        else if (Convert.ToString(Session["UserLogin"]) == "Internal User")
        {
            <h2><a href="@Url.Action("SelectDesignation", "Home")"> Go Back To Home Page</a></h2>
        }
        else if (Convert.ToString(Session["UserLogin"]) == "Partner User")
        {
            <h2><a href="@Url.Action("Index", "Home", new { area = "Partner" })"> Go Back To Home Page</a></h2>
        }
        else if (Convert.ToString(Session["UserLogin"]) == "Candidate User")
        {
            if (Convert.ToString(Session["ClientRowID"]) == "635")
            {
                <h2><a href="@Url.Action("Index", "Home", new { area = "Candidate" })"> Go Back To Home Page</a></h2>
            }
            else if (Convert.ToString(Session["ClientRowID"]) == "1015")
            {
                <h2><a href="@Url.Action("PersonalInfo", "Home", new { area = "Candidate" })"> Go Back To Home Page</a></h2>
            }
            else
            {
                <h2><a href="@Url.Action("CandidateFOA", "Home", new { area = "Candidate" })"> Go Back To Home Page</a></h2>
            }
        }
        else if (Convert.ToString(Session["UserLogin"]) == "!Candidate User")
        {
            <meta http-equiv="Refresh" content="0; url='https://bgv.securitas-india.com/Account/CandidateLogin'" />
        }
        else if (Convert.ToString(Session["UserLogin"]) == "!Client User")
        {
            <meta http-equiv="Refresh" content="0; url='https://bgv.securitas-india.com/Account/ClientLogin'" />
        }
        else if (Convert.ToString(Session["UserLogin"]) == "!Internal User")
        {
            <meta http-equiv="Refresh" content="0; url='https://bgv.securitas-india.com/Account/Index'" />
        }
        else if (Convert.ToString(Session["UserLogin"]) == "!Partner User")
        {
            <meta http-equiv="Refresh" content="0; url='https://bgv.securitas-india.com/Account/VendorLogin'" />
        }


    </div>

    @*<script>
        window.location.hash = "no-back-button";
        window.location.hash = "Again-No-back-button";
        window.onhashchange = function () { window.location.hash = "no-back-button"; }
    </script>*@
</body>
</html>

