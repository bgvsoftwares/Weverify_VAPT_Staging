@model ViewModels.TempViewModel.ClientOnboadringviewModel
@{
    Layout = null;
}
<title>BGV Client - @ViewBag.Title</title>
<link href="~/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link href="~/assets/css/style.css" rel="stylesheet">
<script src="~/assets/plugins/jquery/jquery.min.js"></script>
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<script src="~/Scripts/sweetalert2.all.min.js"></script>

@if (ViewBag.ErrorMsg != null && ViewBag.ErrorMsg != "")
{
    <script>
        $(document).ready(function () {
                Swal.fire({
     icon: 'info',
     //title: 'Mandatory Fields.',
        text: '@ViewBag.ErrorMsg',
        timer: 20000
})
        })
    </script>
}
<style>
    .submit-progress {
        position: absolute;
        width: 100%;
        height: 100%;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        background: #FFF;
        opacity: .5;
    }
    .fa-spinner {
        font-size: 3rem;
        color:#031F30;
    }
    .btn {
        background: #031F30;
        color: #fff;
        font-size: 14px !important;
        border: 1px solid #031F30;
    }
        .btn:hover {
            background: #FFF;
            color: #031F30;
        }
</style>
<div class="submit-progress hidden">
    <i class="fa fa-2x fa-spinner fa-spin"></i>
    @*<label>Please wait...</label>*@
</div>
<div class="container-fluid align-items-center h-100" style="border:none;background: linear-gradient(180deg,rgba(194, 180, 252, 1) 0%, rgba(194, 180, 252, 1) 0%, rgba(255, 255, 255, 1) 90%)!important;">
    <nav class="navbar bg-none d-felx justify-content-end mb-3">
       <img src="https://bgv.securitas-india.com/assets/LoginCarusol/img/Securitas-logo.png" style="width:100px;"/>
    </nav>
<div class="card h-auto w-50 m-auto justify-content-center d-flex" style="border: none; background: linear-gradient(180deg,rgba(194, 180, 252, 1) 0%, rgba(194, 180, 252, 1) 0%, rgba(255, 255, 255, 1) 95%)!important;">
<div class="card-header text-center" style="background:none;">
    <div class="row w-100 d-felx justify-content-center mb-3 mt-3">
        <div class="icon" style="background: #FFF; border: none; border-radius: 0.65rem; padding: 15px 13px; width: 50px;">
            <i class="fa-solid fa-arrow-right-to-bracket" style="font-size:20px;"></i>
        </div>
    </div>
    <h1 style="color:#031F30;font-weight:bolder;font-size:18px;font-family:'Securitas Pro';">Sign in with email</h1>
    <p style="color:#031F30;font-weight:lighter;font-size:16px;font-family:'Securitas Pro';">Please enter your company registred mail id on <br />  which you will recived login otp.</p>
</div>
<div class="card-body w-75 m-auto">
    <div class="row" id="emailid_box">
        <div class="col-md-12">
            <i class="fa-solid fa-envelope" style="position: absolute; padding: 10px; font-size: 20px; color: #031F30;"></i>
            <input type="email" class="form-control ps-5" placeholder="Email" style="border-radius:.75rem!important;" name="UserEmailID" id="UserEmailID" required />
        </div>
        <div class="col-md-12 d-flex justify-content-center mt-3">
            <input type="submit" class="btn" value="Send OTP..." id="sendopt" />
        </div>
    </div>
    @using (Html.BeginForm("LoginToSendOnboardingMailToClient", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="row mt-3" id="otp_box" style="display:none;">
            <div class="col-md-12">
                <input type="hidden" value="" id="CheckOTPbyInput" name="CheckOTPbyInput" />
                <input type="hidden" value="" id="PassInputEmailID" name="PassInputEmailID" />
                <i class="fa-solid fa-key" style="position: absolute; padding: 10px; font-size: 20px; color: #031F30;"></i>
                <input type="text" class="form-control ps-5" placeholder="OTP" style="border-radius:.75rem!important;" name="UserOTP" />
            </div>
            <div class="col-md-12 d-flex justify-content-center mt-3">
                <input type="submit" class="btn" value="Submit" />
            </div>
        </div>
    }
    </div>
</div>
</div>


<script src='@Url.Content("~/assets/plugins/bootstrap/js/bootstrap.bundle.min.js")'></script>
<script src="~/assets/plugins/bootstrap/js/popper.min.js"></script>
<script src="~/assets/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        $("#sendopt").click(function () {
            $(".submit-progress").css("display", "flex"); // show
            let emailid = $("#UserEmailID").val();
            var url1 = "/Account/LoginToSendOnboardingMailToClientOTP?UserEmailID=" + emailid;
            $.ajax({
                url: url1,
                type: 'GET',
                async: false,
                dataType: 'json',
                success: function (result) {
                    if (result != null && result != "") {
                        if (result.msg == "Please enter a valid company email address(securitas-india.com or securitas-india.in).") {
                            Swal.fire({
                                icon: 'info',
                                title: 'Information',
                                text: result.msg,
                                timer: 20000
                            });
                            $("#otp_box").hide();
                            $("#emailid_box").show();
                            $(".submit-progress").css("display", "none"); // hide
                        }
                        else
                        {
                            $("#otp_box").show();
                            $("#emailid_box").hide();
                            $("#CheckOTPbyInput").val(result.msg);
                            $("#PassInputEmailID").val(emailid);
                            $(".submit-progress").css("display", "none"); // hide
                        }
                    }
                }
            });
        });
    });
</script>