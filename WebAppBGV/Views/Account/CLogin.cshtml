@model ViewModels.CandidateViewModel.CandidateLoginViewModel
@{
    ViewBag.Title = "Candidate Login";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";

    string SecretDataSitekeyHcaptcha = System.Configuration.ConfigurationManager.AppSettings["Secret_data-sitekey_hcaptcha"].ToString();

    string msg = "";
    if (ViewBag.ErrorMsg != null)
    {
        msg = ViewBag.ErrorMsg.ToString();
    }
}

@using (Html.BeginForm("CLogin", "Account", FormMethod.Post, new { @onsubmit = "return validateForm()", @autocomplete = "off" }))
{
    @Html.AntiForgeryToken() 
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <form class="sign-in-form forms">
        <div class="d-flex align-items-center login_error_div" style="width: 440px;height:35px;
text-align: center;
font-size: .90rem;
color:#AA1834!important; display:flex;">
            @{
                if (ViewBag.EncData != null)
                {
                    <input type="hidden" id="EnSalt" value="@ViewBag.EncData.ToString()" />
                }
              
                if (msg != "")
                {

                    <div class="errormsglogin" style="position: relative;top:0px;">
                        <div class="drop">
                            <p class="img_p">1</p>
                            <img src="~/assets/LoginPageImages/marker.png" width="35" />
                        </div>
                        <ul class="Error_ul">
                            <li>
                                @msg.ToString()
                            </li>
                        </ul>
                    </div>
                }
            }
            @{
                if (TempData["ErrorMsg"] != null)
                {
                    <div class="errormsglogin">@TempData["ErrorMsg"].ToString()</div>
                }
                if (TempData["SuccessMsg"] != null)
                {
                    <div class="successmsg">@TempData["SuccessMsg"].ToString()</div>
                }
            }
        </div>
        <div class="heading">
            <h2>Candidate Login</h2>
        </div>
        <div class="actual-form">
            <div class="d-flex align-items-center mt-1 mb-3">
                <fieldset class="highlight" id="fieldset">
                    <legend class="legend">UserName</legend>
                    @Html.EditorFor(model => model.CRPUserName, new { htmlAttributes = new { @placeholder = "User Name", @class = "form-control", @id = "Username", required = "required", @maxlength = "50", @onmousedown = "return noCopyMouse(event);", @onkeydown = "return DisableEscape(event);", @onkeypress = "return BlockBlacklist(event);" } })
                    <div class="loginerror" style="font-size:.70rem; color:#FC273F!important;">@Html.ValidationMessageFor(model => model.CRPUserName, "", new { @class = "text-danger" })</div>
                </fieldset>
            </div>
            <div class="d-flex align-items-center password mt-1 mb-4">
                <fieldset class="highlight" id="fieldset">
                    <legend class="legend">Password</legend>
                    <div class="fake-input"><span style=""></span></div>
                    @Html.EditorFor(model => model.CRPPassWord, new { htmlAttributes = new { @placeholder = "Password", @class = "form-control-pass_candidate", @id = "CRPPassWord", @autocomplete = "off", @onKeyUp = "RemoveSavedPassword()" } })
                    <div class="loginerror" style="font-size:.70rem; color:#FC273F!important;">@Html.ValidationMessageFor(model => model.CRPPassWord, "", new { @class = "text-danger" })</div>

                </fieldset>
            </div>
            <div class="mt-2 mb-4 gap-2">
                <img id="captchaImg" src="@Url.Action("GetImgCaptcha", "Account")" style="width:200px; height:50px;" alt="CAPTCHA" />
                <button type="button" class="btn  btn-login-submit" style=" background:none !important; border:none !important; height:50px !important; padding:0px !important; display:unset; width:50px; font-size:24px !important; color:#fff;" onclick="reloadCaptcha()">&#x21bb;</button>

                <input type="text" name="CaptchaVal" id="CaptchaVal" class="form-control" style="top:0px!important; margin-top:12px; " placeholder="Enter CAPTCHA" />
            </div>
            <div class="d-flex align-items-center btn_box">
                @Html.Hidden("hdnEnptStatus", "false")
                <button type="submit" id="submit" class="btn  btn-login-submit" onclick="return SubmitsEncry();">Submit</button>
            </div>
            <div class="row" style="display:flex; width:380px!important; margin-top:10px;">
                <div class="col-md-10">
                    <a class="login_as" href="mailto:bgv.helpdesk@securitas-india.com">
                        <div class="d-flex align-items-center Login_as_box link_box">
                            Can't Access The Software
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts{
    <script src="~/Scripts/aes.js"></script>

    <script>
        $(document).ready(function () {
            $("#Username").val("");
            var captchaVal = $("#CaptchaVal").val();
            var iNumber = captchaVal;
            $("#divGenerateRandomValues").html("<p id='txtNewInput'></p>");

            $("#textInput").addClass('form-control');
            $("#txtNewInput").text(iNumber);
            $("#txtNewInput").prop('disabled', true);
        });

        function blankInput() {
            document.getElementById("textInput").value = "";
        }
        blankInput();
        $(document).ready(function () {

            $("form").attr('autocomplete', 'off');

            $('input').focus(function () {
                $(this).removeAttr('readonly');
            });

            $('input').blur(function () {
                $(this).attr('readonly', true);

            });

            document.getElementsByName("CRPUserName")[0].value = "";
            document.getElementsByName("CRPPassWord")[0].value = "";
        });
        $('#submit').click(function () {
            var pass = $.trim($("[id*=Password]").val());
            var uName = $.trim($("[id*=Username]").val());
            if (uName.includes("alert") || uName.includes("script") || uName.includes("<") || uName.includes(">") || uName.includes("select") || uName.includes("exec") || uName.includes("execute") || uName.includes("drop") || uName.includes("truncate") || uName.includes("insert") || uName.includes("update") || uName.includes("delete")) {
                alert("You can not use any special text as usename like alert,script,etc.");
                document.getElementsByName("CRPUserName")[0].value = "";
                document.getElementsByName("CRPPassWord")[0].value = "";
                return false;
            }
        })

    </script>
    <style>
        .drop {
            position: fixed;
            -webkit-transform: rotate(270deg);
        }

        .errormsglogin {
            width: 440px !important;
            left: 22px;
        }

        .Error_ul {
            padding: 0px;
            margin: 0px;
            position: fixed;
            top: 10px;
            left: 80px;
        }

            .Error_ul li::marker {
                color: #fff !important;
            }

        .img_p {
            color: #fff !important;
            color: #fff !important;
            position: fixed;
            left: 16px;
            -webkit-transform: rotate(90deg);
            bottom: 2px;
            font-family: 'Securitas Pro';
            font-size: .90rem;
        }
    </style>
    <style>
        @@media (min-width: 300px) and (max-width:500px) {
            .captcha_number_candidate {
                bottom: 140px !important;
            }
        }


        @@media (min-width: 500px) and (max-width:550px) {
            .captcha_number_candidate {
                bottom: 141px !important;
            }
        }

        @@media only screen and (max-width: 500px) {
            .form_body {
                left: 56%;
            }
        }
    </style>


    <script type="text/javascript">
        function SubmitsEncry() {
            var txtpassword = document.getElementsByName("CRPPassWord")[0].value.trim();
            var text = CryptoJS.enc.Utf8.parse(txtpassword);
            var Key = CryptoJS.enc.Utf8.parse("PSVJQRk9QTEpNVU1DWUZCRVFGV1VVT0="); //secret key
            var IV = CryptoJS.enc.Utf8.parse("2314345645678765"); //16 digit
            var encryptedText = CryptoJS.AES.encrypt(text, Key, { keySize: 128 / 8, iv: IV, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 });
            var encrypted = document.getElementById('CRPPassWord');
            encrypted.value = encryptedText;

        }
    </script>  
    <script>
        function validateForm() {
            var response = document.getElementsByName("CaptchaVal")[0].value;
            if (response.length == 0) {
                alert("Please Enter Captcha.");
                return false;
            }
            return true;
        }
    </script>
}


