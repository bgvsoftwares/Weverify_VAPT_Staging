<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>

        .div_icon {
            width: 80px;
            height: 80px;
            border: 2px solid #FFF;
            border-radius: 50%;
            margin: auto;
        }

            .div_icon .fa {
                color: #ffff;
                padding: 15px 15px;
                font-size: 3.2rem;
            }
    </style>
</head>
<body>
    <div class="card" style="margin:70px auto; width:600px;">
        <div class="card-header p-4" style="background:#11c9b7;">
            <div class="div_icon">
                <i class="fa fa-check"></i>
            </div>
            <h5 class="text-center text-white mt-2">SUCCESS</h5>
        </div>
        <div class="card-body p-4">
            <p class="text-center m-3" style="font-size:18px;"><span style="color:#000; font-weight:bolder;">Congratulations</span>, Approved successfully.</p>
        </div>
    </div>

</body>
</html>
