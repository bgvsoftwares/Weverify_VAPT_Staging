
@{
    ViewBag.Title = "DigiLockerRedirect_uri";
    Layout = null;

}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Background Verification</title>
    <link href="https://bgv.securitas-india.com/assets/LoginCarusol/img/Securitas-logo.png" type="image/x-icon" rel="shortcut icon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    @using (Html.BeginForm("DigiLockerRedirect_uri", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @*<div class="">
                <div class="">
                    @ViewBag.msg
                </div>
            </div>*@
        if (ViewBag.msg != "")
        {
            if (ViewBag.msg == "Documents Received")
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="card shadow p-3 mb-5 bg-body-tertiary rounded">
                            <img src="~/Content/images/check-mark.png" class="card-img-top" alt="Img">
                            <div class="card-body text-center">
                                <h4 class="card-title text-center fw-bold" style="color:#8D5FFF;">Thank you so much !</h4>
                                <p class="card-text text-center mt-4">Thank you for providing the consent about the verification. we appreciate your patience.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (ViewBag.msg == "Already Submit")
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="card shadow p-3 mb-5 bg-body-tertiary rounded">
                            <img src="~/Content/images/check-mark.png" class="card-img-top" alt="Img">
                            <div class="card-body text-center">
                                <h4 class="card-title text-center fw-bold" style="color:#8D5FFF;">Already Submit !</h4>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="card shadow p-3 mb-5 bg-body-tertiary rounded">
                        <div class="card-body text-center">
                            <h4 class="card-title text-center fw-bold" style="color:#8D5FFF;">Sorry !</h4>
                            <p class="card-text text-center mt-4">Your Background Verification unsuccessfully Please connect BGV Admin Team !!!</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        window.history.pushState(null, null, null);
        window.addEventListener('popstate', function (event) {
            window.location.href = 'https://www.google.com';
        });
    </script>

    <style>

        .card {
            width: 25rem;
            margin: auto;
            top: 80px;
            width: 40rem;
        }

        .card-img-top {
            width: 130px;
            margin: auto;
            padding: 10px;
        }

        .btn {
            padding: 10px 30px;
            background: #FC273F;
            border: 1px solid #FC273F;
            transition: 0.3s ease-in-out;
        }

            .btn:hover {
                color: #FC273F;
                background: #FFF;
                border: 1px solid #FC273F;
            }

        .logo {
            width: 130px;
        }

        p {
            color: #031F30 !important;
            font-weight: 600;
            font-family: 'Securitas Pro';
        }
    </style>
</body>
</html>