@model ViewModels.HRViewModels.CompanyLoginViewModel
@{
    ViewBag.Title = "Client Login";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";

    string SecretDataSitekeyHcaptcha = System.Configuration.ConfigurationManager.AppSettings["Secret_data-sitekey_hcaptcha"].ToString();


    string msg = "";
    if (ViewBag.ErrorMsg != null)
    {
        msg = ViewBag.ErrorMsg.ToString();
    }
}

@using (Html.BeginForm("Loginsso", "Account", FormMethod.Post, new { @onsubmit = "return validateForm()", @autocomplete = "off", @class = "sign-in-form index_form new-sign-login" }))
{
    <div class="heading mb-2">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-solid-danger">
                @TempData["Message"]
            </div>
        }
    </div>
    <div >
        <div class="actual-form p-3">
            <div class="d-flex align-items-center btn_box">
                @Html.Hidden("hdnEnptStatus", "false")
                <button type="submit" id="btnSubmit" class="btn btn-login-submit">Login</button>
            </div>

        </div>
    </div>
}
@section Scripts{

    <script>

    </script>
    <script>
    </script>
    <script>
        String.prototype.trim = function () {
            var trimmed = this.replace(/^\s+|\s+$/g, '');
            return trimmed;
        };
        String.prototype.ltrim = function () {
            var trimmed = this.replace(/^\s+/g, '');
            return trimmed;
        };
        String.prototype.rtrim = function () {
            var trimmed = this.replace(/\s+$/g, '');
            return trimmed;
        };
    </script>


}



<style>

    .alert-solid-danger{
        color:#ff0000;
        font-size:20px;
        font-weight:600;
        padding-right:20px;
        position:unset;
    }
    .new-sign-login {
        display: flex;
        flex-direction:column;
        justify-content:center;
        position:unset !important;
    }
</style>