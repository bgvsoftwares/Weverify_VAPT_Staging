
@{
    ViewBag.Title = "User Active Details";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    string TeamMemberID = Convert.ToString(Session["TeamMemberRowID"]);
}

@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">

                        @using (Html.BeginForm("UserActiveDetails", "ClientServicing", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">User Id</label>
                                    <div class="col-md-3">
                                        <input type="text" id="txtUserId" class="form-control" name="UserId">
                                        @if (ViewBag.Error != null && ViewBag.Error == "Please fill mandatory fields")
                                        {
                                            <p class="text-danger p-2">@ViewBag.Error</p>
                                        }
                                    </div>
                                    <label class="col-md-2 control-label">Action</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("ddlActionType", new List<SelectListItem>
                                        {
                                        new SelectListItem{Text="Active", Value="1"},},
                                           "-- Select request type -- ",
                                           new { @id = "ID", @class = "form-control" })
                                        @if (ViewBag.Error != null && ViewBag.Error == "Please fill mandatory fields")
                                        {
                                            <p class="text-danger p-2">@ViewBag.Error</p>
                                        }
                                    </div>
                                    <label class="col-md-2 control-label">Remarks</label>
                                    <div class="col-md-3">
                                        <input type="text" id="txtremarks" class="form-control" name="Remarks">
                                        @if (ViewBag.Error != null && ViewBag.Error == "Please fill mandatory fields")
                                        {
                                            <p class="text-danger p-2">@ViewBag.Error</p>
                                        }
                                    </div>
                                    <br />
                                    <div class="col-md-5">
                                        <input class="btn bun-bg btn-default" type="submit" value="Send" name="SaveWork" />
                                    </div>
                                    <br />
                                    
                                        <p class="text-danger p-2">@ViewBag.Succe</p>
                                    
                                </div>

                            </div>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
}


<style>
    @@media screen and (max-width: 1450px) and (min-width: 600px) {
        #grid {
            font-size: 1.2rem !important;
            width: 100%;
        }

        .table td, .table th {
            padding: .55rem !important;
        }

        .thead-inverse {
            font-size: 1.2rem !important;
        }

        table, td, .edit {
            font-size: 1.2rem !important;
        }
    }
</style>