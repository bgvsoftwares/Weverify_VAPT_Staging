@{Layout = null; }

<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

@*<script src="~/Scripts/jquery-3.1.1.min.js"></script>*@
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>


@{
    ViewBag.Title = "";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row"><div class="col-md-12">&nbsp;</div></div>
<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group branch search-frame text-center">
                        @if (ViewBag.Message != null)
                        {
                            <center>@ViewBag.Message</center>
                        }


                        <form id="uploadForm" action="@Url.Action("UploadMultiDoc", "ClientServicing")" method="post" enctype="multipart/form-data">
                            <input type="file" name="files" accept=".jpg,.JPG,.PNG,.png,.pdf,.PDF" class="form-control" multiple />
                            <div style="margin-top:10px;">
                                <input type="submit" value="Upload" class="btn btn-primary" />

                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


