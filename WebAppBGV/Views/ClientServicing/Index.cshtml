@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Welcome To " + ViewBag.Dashboard;
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{ 
    string TeamMemberRowID1 = Convert.ToString(Session["TeamMemberRowID"]);
}

@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<script src="~/Scripts/sweetalert2.all.min.js"></script>
<link href="~/Content/MultiselectcNew.css" rel="stylesheet" type="text/css" />
<link href="~/MultiSelection/docs/css/prettify.css" rel="stylesheet" />
<link rel="stylesheet" href="~/MultiSelection/dist/css/bootstrap-multiselect.css" type="text/css">

<div class="container">
    <div class="col-md-12">
        <div class="form-horizontal">
          
                <div class="container" style="margin:0px!important;">
                    <div class="row">
                        <div class="col-md-2" style="margin-top:26px;">
                            @Html.Label("Select Client", htmlAttributes: new { @class = "control-label required", })
                        </div>
                        <div class="col-md-4" style="margin-top:26px;">
                            @Html.DropDownList("ClientRowID", new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
       new { @class = "form-control", @id = "ClientRowID", @multiple = "multiple", @size = "3" })
                        </div>
                        <div class="col-md-3">
                            <label class="control-label">From Date :</label>
                            @Html.TextBox("FromDate", null, new { @class = "form-control", @id = "FromDate", @placeholder = "DD-MMM-YYY", @autocomplete = "off", @style = "height:35px!important;" })
                        </div>

                        <div class="col-md-3">
                            <label class="control-label">To Date :</label>
                            @Html.TextBox("ToDate", null, new { @class = "form-control", @id = "ToDate", @placeholder = "DD-MMM-YYY", @autocomplete = "off", @style = "height:35px!important;" })
                        </div>
                    </div>
                </div>
                <div class="row col-md-12" style="margin:20px 0px 50px 0px!important; text-align:center;">
                    <div class="col-md-12">
                        <input type="button" id="btnExportCaseStatus" value="Export to Excel" class="btn bun-bg btn-default" />
                        <input type="button" id="btnE2EMIS" value="MIS" class="btn bun-bg btn-default" />
                        <input type="button" id="btnCheckwisemis" value="Check MIS" class="btn bun-bg btn-default" />
                        <input type="button" id="btnRejectCheckwisemis" value="Reject Check MIS" class="btn bun-bg btn-default" />
                        <input type="button" id="btncheckmisnew" value="Check MIS New" class="btn bun-bg btn-default" />

                        @if (TeamMemberRowID1 == "524" || TeamMemberRowID1 == "160" || TeamMemberRowID1 == "864" || TeamMemberRowID1 == "926" || TeamMemberRowID1 == "882" || TeamMemberRowID1 == "557")
                        {
                            <input type="button" id="btnclientmis" value="Client Tracker" class="btn bun-bg btn-default" />
                        }
                        @if (TeamMemberRowID1 == "196")
                        {
                            <input type="button" id="btnBGCStatusTracker" value="BGC Status Tracker" class="btn bun-bg btn-default" />
                        }
                        @if (TeamMemberRowID1 == "1002" || TeamMemberRowID1 == "160" || TeamMemberRowID1 == "524" || TeamMemberRowID1 == "1156" || TeamMemberRowID1 == "1043" || TeamMemberRowID1 == "1184")
                        {
                            <input type="button" id="btnGallgherTracker" value="Gallagher Auto Interim Tracker" class="btn bun-bg btn-default" />
                        }
                        @if (TeamMemberRowID1 == "524" || TeamMemberRowID1 == "1156" || TeamMemberRowID1 == "1002")
                        {
                            <input type="button" id="btnGallgherNewMISTracker" value="Gallagher New MIS Tracker" class="btn bun-bg btn-default" />
                        }


                    </div>
                    <div class="col-md-3"></div>
                </div>

           
            @{
                if (Request.QueryString["ClientRowID"] != null && Convert.ToInt16(Request.QueryString["ClientRowID"]) > 0)
                {
                    @Html.Hidden("hdnClientRowID", clsCommonMethods.PEncrypt(Request.QueryString["ClientRowID"]))
                    @*@Html.Hidden("ClientRowID", clsCommonMethods.PEncrypt(Request.QueryString["ClientRowID"]))*@
                }
                @*else
                    {
                        @Html.Hidden("hdnClientRowID", clsCommonMethods.PEncrypt("0"))
                        @Html.Hidden("ClientRowID", clsCommonMethods.PEncrypt("0"))
                    }*@
            }
        </div>
    </div>
</div>
<div class="row" id="dvPartialView">
    @{Html.RenderAction("RefreshDashboardDetails", "ClientServicing");}
</div>

@*<script type="text/javascript" src="~/MultiSelection/docs/js/jquery-2.1.3.min.js"></script>*@
<script type="text/javascript" src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/MultiSelection/dist/js/popper.min.js"></script>
<script type="text/javascript" src="~/MultiSelection/docs/js/bootstrap-3.3.2.min.js"></script>
<script type="text/javascript" src="~/MultiSelection/docs/js/prettify.min.js"></script>
<script type="text/javascript" src="~/MultiSelection/dist/js/bootstrap-multiselect.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#ClientRowID').multiselect({
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true,
            buttonWidth: '250px',
            maxHeight: 250,
            numberDisplayed: 1,

        });

        $("#ClientRowID").change(function () {
            var ptn = $("#ClientRowID").val() || "0";;
            if (ptn == "0") {
                $(".multiselect-selected-text").html('None selected');
            }

        });

    });
</script>
