        }

    .tile-stats {
        /*background: #81d3c9;*/
        border-radius: 10px !important;
        box-shadow: 30px 30px 30px #1b1c1b, !important;
        transition: 0.3s;
        box-shadow: 0 8px 12px 0 rgba(0,0,0,0.2);
        cursor: pointer;
    }

        .tile-stats:hover {
            box-shadow: 20px 25px 24px 15px rgba(0,0,0,0.2);
        }

    .count a {
        color: #000 !important;
    }


    .tile-stats .icon {
        width: 20px !important;
        height: 20px !important;
        color: #0375b3b0 !important;
        position: absolute !important;
        left: 12px !important;
        top: 10px !important;
        z-index: 1 !important;
    }

    .tile-stats > h4 {
        margin: 10px 0 0 3% !important;
        font-weight: 500 !important;
    }

    @@media only screen and (max-width: 760px) {
        .tile-stats {
            width: 25rem;
        }
    }

    @@media only screen and (max-width: 573px) {
