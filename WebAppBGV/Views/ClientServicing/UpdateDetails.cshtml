
@{
    ViewBag.Title = "UpdateDetails";
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }

<!DOCTYPE html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
</head>
<body>
    @if (ViewBag.ErrorMsg != null)
    {
        <script>
                    Swal.fire({
                    icon: 'info',
                    //title: 'Mandatory Fields.',
                    html: '@ViewBag.ErrorMsg',
                    timer: 20000
           })
        </script>
    }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("UpdateDetails", "ClientServicing", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row align-items-center search-frame">
                                
                                    <div class="col-md-3">

                                            <label class="control-label">Upload Excel File :</label>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center">
                                            <div class="updated-details">
                                                <label class=""> Please Upload only excle file</label>

                                                <input type="file" name="file" class="form-control" />
                                                <div class="buttons">
                                                    <input class="btn bun-bg btn-default m-3" type="submit" value="Upload and Update" />         
                                                        <a href="@Url.Action("DownloadTemplate", "ClientServicing" )" class="btn bun-bg btn-default" id="Excel">
                                                            Download Template
                                                        </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .updated-details{
        width:100%;
    }
    .updated-details label {
        font-size: 16px;
        font-weight: 600;
    }

        .updated-details input.form-control {
            padding: 8px;
            height: 40px;
        }

        .buttons{
            margin-top:15px;
        }

        #Excel{
            margin-left: 150px;
            height:30px;
        }
</style>
    </body>