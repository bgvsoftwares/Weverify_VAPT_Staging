
@{
    ViewBag.Title = "Spoc Remark";
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AddSpocActionRemarkNew", "ClientServicing", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">CompanyRefNo :</label>
                                    <div class="col-md-4">
                                        <input class="form-control" type="text" name="CompanyRefNo" id="CompanyRefNo" value="@ViewBag.CompanyRefNo" placeholder="Ex Enter CompanyRefNo..." required />
                                    </div>

                                    <div class="col-md-2">
                                        <input class="btn bun-bg btn-default" type="submit" value="Search" name="Action" />
                                    </div>
                                </div>
                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">Action type :</label>
                                    <div class="col-md-4">

                                        @{
                                            List<SelectListItem> ActiontypeList = new List<SelectListItem>();
                                            ActiontypeList.Add(new SelectListItem { Text = "=", Value = "-- select --" });
                                            ActiontypeList.Add(new SelectListItem { Text = "Set Priority", Value = "Set Priority" });
                                            ActiontypeList.Add(new SelectListItem { Text = "Reopen", Value = "Reopen" });
                                        }

                                        @if (ActiontypeList != null)
                                        {
                                            @Html.DropDownList("ActionType", new SelectList(ActiontypeList, "Text", "Value"), new { @class = "form-control" })
                                        }

                                    </div>

                                </div>
                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">Check Details :</label>
                                    <div class="col-md-4">


                                        @if (ViewBag.chek != null)
                                        {
                                            @Html.DropDownList("SubCheckRowId", new SelectList(ViewBag.chek, "SubCheckRowID", "SubCheckName"), new { @class = "form-control" })
                                        }
                                    </div>

                                </div>

                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">Remark Priority type :</label>
                                    <div class="col-md-4">

                                        @{
                                            List<SelectListItem> RemarkPrioritytypeList = new List<SelectListItem>();
                                            RemarkPrioritytypeList.Add(new SelectListItem { Text = "=", Value = "-- select --" });
                                            RemarkPrioritytypeList.Add(new SelectListItem { Text = "High", Value = "High" });
                                            RemarkPrioritytypeList.Add(new SelectListItem { Text = "Low", Value = "Low" });
                                        }

                                        @if (RemarkPrioritytypeList != null)
                                        {
                                            @Html.DropDownList("Prioritytype", new SelectList(RemarkPrioritytypeList, "Text", "Value"), new { @class = "form-control" })
                                        }

                                    </div>

                                </div>

                                <div class="form-group branch row  search-frame">

                                    <label class="col-md-2 control-label">Action Remarks :</label>
                                    <div class="col-md-5">
                                        <textarea class="form-control" placeholder="Ex Enter Remarks..." name="SpocRemark" value="" id="SpocRemark"></textarea>
                                    </div>
                                </div>
                                <div class="form-group branch row  search-frame">

                                    <label class="col-md-2 control-label">Upload Document :</label>
                                    <div class="col-md-5">
                                        <input type="file" name="UploadDoc" />
                                    </div>
                                </div>
                                <div class="all-button-bg">

                                    <input class="btn bun-bg btn-default" type="submit" value="Add Remark" name="Action" />
                                </div>
                            </div>
                        }
                    </div>

                </div>


            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <script>
        function myFunction()
        {
            confirm("Do you want to delete!");
        }
        function myFunction1()
        {
            var txt;
            var r = confirm("Press a button!");
            if (r == true)
            {
                txt = "You pressed OK!";
            } else
            {

            }
            document.getElementById("demo").innerHTML = txt;
        }
    </script>

    <script type="text/javascript">
        $(".delete").on("click", function () {
            var str = $(this).attr("id").split("_");
            id = str[1];
            //Sub = str[2];

            var flag = confirm('Do you want to Reject the Record ?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("RejectCase", "ClientServicing")',
                    data: { "id": id },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Record Reject Successfully!!");
                            setTimeout(function () { window.location.replace("ManageAbbreviation"); }, 500);
                        }
                        else {
                            //alert('There is some error');
                            setTimeout(function () { window.location.replace("ManageAbbreviation"); }, 500);
                        }
                    }
                });
            }
        });
    </script>
}



