@model ViewModels.ProvidedInfoViewModel.InsuffCheckClearViewModel
@{
    ViewBag.Title = "Insufficiency Check Clear By Spoc";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='bx bx-reply' aria-hidden='true'></i>");
    string hyperLink = string.Format("<a class='headerbacklink' onclick='window.history.back()'><i class='fa fa-reply' aria-hidden='true'></i>Back</a>");
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-lg-12 col-md-12" style="background:#EAEAEA!important;">
        <div class="card" style="height:auto!important;box-shadow: none; border-radius: 0px; background:#EAEAEA!important;">
            <div class="card-body ps-0 pt-0">
                <div class="d-flex">
                    <div class="col-md-3" style="background: #11c9b7;">
                        <ul class="DataMenuList h-100 mt-0 ps-0" style="list-style-type:none;">
                            @if (Session["NavInputDataMenuList"] != null)
                            {
                                @Html.Raw(Session["NavInputDataMenuList"].ToString());
                            }
                        </ul>
                    </div>
                    <div class="col-md-9">
                        <div class="pd-30 pd-sm-20">
                            @using (Html.BeginForm("InsufficiencyClearBySpoc", "ClientServicing", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()

                                @Html.HiddenFor(model => model.CheckRowID)
                                @Html.HiddenFor(model => model.SubCheckName)
                                @Html.HiddenFor(model => model.INFReason)
                                <input type="hidden" value="@Model.ClientRowID" id="ClientRowID" name="ClientRowID" />
                                <input type="hidden" value="@Model.ChFamilRowId" id="ChFamilRowId" name="ChFamilRowId" />
                                <input type="hidden" value="@Model.SubCheckRowID" id="SubCheckRowID" name="SubCheckRowID" />
                                <input type="hidden" value="@Model.PersonalRowID" id="PersonalRowID" name="PersonalRowID" />
                                <input type="hidden" value="@Model.SecuritasID" id="SecuritasID" name="SecuritasID" />

                                <div class="row row-xs align-items-center mg-b-20">
                                    <div class="col-md-4">
                                        @Html.LabelFor(model => model.SubCheckName, htmlAttributes: new { @class = "form-label mg-b-0" })
                                    </div>
                                    <div class="col-md-8 mg-t-5 mg-md-t-0">
                                        <input class="form-control" type="text" value="@Model.SubCheckName" readonly>
                                    </div>
                                </div>
                                <div class="row row-xs align-items-center mg-b-20">
                                    <div class="col-md-4">
                                        @Html.Label("Insuff Remark:", htmlAttributes: new { @class = "form-label mg-b-0" })
                                    </div>
                                    <div class="col-md-8 mg-t-5 mg-md-t-0">
                                        <textarea typeof="text" readonly class="form-control">@Model.INFReason</textarea>
                                    </div>
                                </div>
                                <div class="container" id="dvUplodDoc">

                                </div>
                                <div class="row row-xs align-items-center mg-b-20">
                                    <div class="col-md-5">
                                        @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "form-label mg-b-0" })
                                    </div>
                                    <div class="col-md-5">
                                        @Html.TextAreaFor(model => model.EmployeeID, new { @class = "form-control" })
                                    </div>
                                    <div class="col-md-2">
                                        @Html.ActionLink("Download", "InsuffClientAddresspdf", "ClientInsuff", new { PersonalRowID = Model.PersonalRowID, SubCheckRowID = Model.SubCheckRowID }, new { @class = "ManageClientCompany" })
                                    </div>
                                </div>

                                <div class="row row-xs align-items-center mg-b-20">
                                    <div class="col-md-5">
                                        @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "form-label mg-b-0" })
                                        @Html.Hidden("UploadHid", null)
                                    </div>
                                    <div class="col-md-7">
                                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control" })
                                    </div>
                                </div>
                                @Html.HiddenFor(model => model.CheckWithFile, new { id = "CheckWithFileName" })
                                <div class="row row-xs align-items-center mg-b-20 justify-content-center">
                                    @*<div class="col-md-3">
                    <input class="ManageClientCompany rounded-0 m-1" type="submit" value="Back" onclick="window.history.back()" />
                </div>*@
                                    <div class="col-md-3">
                                        <input class="submit-btn btn-block rounded-0 m-1" type="submit" value="Submit" id="validbtn" onclick="fnGetFiles()" />
                                        @*<input class="btn bun-bg btn-default" type="submit" value="Submit"  id="validbtn" onclick="return fnGetFiles()" />*@
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <script>
        $(document).ready(function () {
            if ($("#SubCheckRowID").val()>0) {
                var url1 = "/ProvidedInfo/GetDocumentTypeListBySubCheckID/" + $("#SubCheckRowID").val();
                $.ajax({
                    url: url1,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (allData) {
                        if (allData != null && allData != "") {
                            $('#dvChksPcks').show();
                            var items = '';
                            jQuery.each(allData, function (index, allData) {

                                //items += "<div class='row row-xs align-items-center mg-b-20'><div class='col-md-4'><label class='form-label mg-b-0'>" + allData.Text + "</label></div><div class='col-md-1'><input type='checkbox' name='chkDoc' value=" + allData.Value + " '/></div><div class='col-md-7'><input class='form-control dropify' data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + " id=" + allData.Value + " style='height:34px!important;'></div></div>"
                                items += "<div class='row row-xs align-items-center mg-b-20'><div class='col-md-4'><label class='form-label mg-b-0'>" + allData.Text + "</label></div><div class='col-md-1'><input type='checkbox' name='chkDoc' value=" + allData.Value + " '/></div><div class='col-md-7'><input class='form-control dropify' data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + " id=" + allData.Value + " onchange='return fileValidation(this)' accept='.png, .jpg, .jpeg, .pdf, .doc, .msg' multiple style='height:34px!important;'></div></div>"
                                        //"<label class='col-md-8 control-label'>" + allData.Text + " :</label><input type='checkbox' name='chkDoc'  value=" + allData.Value + " class='col-md-1'/><div class='col-md-2'><input data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + "  id=" + allData.Value + "> </div>";
                                //"<label class='col-md-8 control-label'>" + allData.Text + " :</label><input type='checkbox' name='chkDoc'  value=" + allData.Value + " class='col-md-1'/><div class='col-md-2'><input data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + "  id=" + allData.Value + "> </div>";



                            });
                            $('#dvUplodDoc').html(items);
                        }
                        else {
                            $('#dvChksPcks').hide();
                            alert("No Doc Selected");
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        alert("some error");
                    }
                });
            }

        });

       //
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
                $("#INFRemarks").prop("disabled", false);
            }
            else {
                $("#INFRemarks").prop("disabled", true);
            }



        });
        $(document).ready(function () {
            if ($("#SubCheckRowID").val() != 0) {
                var url1 = "/ProvidedInfo/GetDocumentTypeListBySubCheckID/" + $("#SubCheckRowID").val();
                $.ajax({
                    url: url1,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (allData) {
                        if (allData != null && allData != "") {
                            $('#dvChksPcks').show();
                            var items = '';
                            jQuery.each(allData, function (index, allData) {
                                items += "<div class='row' style='margin-top:15px;'><div class='col-md-3'><label class='branch rowname form-label'>" + allData.Text + " :</label></div><div class='col-md-1'><input type='checkbox' name='chkPkgChks'  value=" + allData.Value + " class='form-check'/></div><div class='col-md-5'><input class='form-control' data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + "  id=" + allData.Value + " onchange='return fileValidation(this)' accept='.png, .jpg, .jpeg, .pdf, .doc, .zip, .msg' multiple> </div></div>";
                            });
                            $('#dvUplodDoc').html(items);
                        }
                        else {
                            $('#dvChksPcks').hide();
                            alert("No Doc Selected");
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        alert("some error");
                    }
                });
            }
            else {
                $('#dvChksPcks').hide();
            }
        });

        $(document).on('change', 'input[name="chkPkgChks"]', function (e) {// on change of state
            var chkPkgChkss = '';
            $('input[name="chkPkgChks"]').each(function (index, value) {
                if (this.checked) {
                    chkPkgChkss += this.value + ',';
                    $("#" + this.value + "").removeAttr("disabled");
                }
                else {
                    $("#" + this.value + "").attr("disabled", "disabled");
                }
            });

            if (chkPkgChkss.length > 0) {
                chkPkgChkss = chkPkgChkss.substring(0, chkPkgChkss.length - 1);
            } else { chkPkgChkss = ''; }
            $('#UploadHid').val(chkPkgChkss.trim());

        });

        function fileValidation(fileInput) {
            var filePath = fileInput.value;
            var allowedExtensions = /(\.gif|\.GIF\.doc|\.docx|\.xls|\.xlsx|\.pdf|\.rtf|\.txt|\.jpeg|\.jpg|\.png|\.eml|\.email|\.msg|\.DOC|\.DOCX|\.XLS|\.XLSX|\.PDF|\.RTF|\.TXT|\.JPEG|\.JPG|\.PNG|\.EML|\.EMAIL|\.MSG|\.WEBP|\.webp)$/i;
            if (!allowedExtensions.exec(filePath)) {
                alert('Please upload file having extensions .doc/.gif/.GIF/.docx/.xls/.xlsx/.pdf/.rtf/.txt/.jpeg/.jpg/.png/.eml/.email/.msg/.DOC/.DOCX/.XLS/.XLSX/.PDF/.RTF/.TXT/.JPEG/.JPG/.PNG/.EML/.EMAIL/.MSG/.WEBP/.webp only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }

        $(document).on('change', 'input[name="chkDoc"]', function (e) {// on change of state
            var chkDocs = '';
            $('input[name="chkDoc"]').each(function (index, value) {
                if (this.checked) {
                    chkDocs += this.value + ',';
                    $("#" + this.value + "").removeAttr("disabled");
                }
                else {
                    $("#" + this.value + "").attr("disabled", "disabled");
                }
            });

            if (chkDocs.length > 0) {
                chkDocs = chkDocs.substring(0, chkDocs.length - 1);
            } else { chkDocs = ''; }
            $('#UploadHid').val(chkDocs.trim());
        });
    </script>

