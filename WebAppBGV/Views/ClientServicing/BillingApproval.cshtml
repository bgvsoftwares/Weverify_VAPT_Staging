        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageAddressInsuffForCSSpoc", "ClientServicing", FormMethod.Get))
                        {
                            @*<div class="form-horizontal">
