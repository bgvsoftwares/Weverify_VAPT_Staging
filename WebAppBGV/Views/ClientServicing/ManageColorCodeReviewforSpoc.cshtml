@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
        <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
        <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
        <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
        <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
        <link href="~/Content/colorbox.css" rel="stylesheet" />
        <script src="~/Scripts/jquery.colorbox-min.js"></script>*@
    <script>
        $(document).ready(function () {
            // Add checkbox to header
            $("table thead tr th:first").html('Bulk Approve<input type="checkbox" id="chkHeader" />');

            // Function to update hidden input
            function updateHiddenInput() {
                var selected = [];
                $("input[name='chkRow']:checked").each(function () {
                    $(".bulkApprovediv").css("display", "block");
                    selected.push($(this).val()); // get value of checked checkbox
                });
                $("#hdnSelected").val(selected.join(","));
                console.log("Hidden input updated:", $("#hdnSelected").val());
            }

            // Toggle all checkboxes when header is clicked
            $(document).on("click", "#chkHeader", function () {
                var checked = this.checked;
                $("input[name='chkRow']").prop("checked", checked);
                updateHiddenInput();
            });

            // Update hidden input when any row checkbox is clicked
            $(document).on("click", "input[name='chkRow']", function () {
                updateHiddenInput();

                // Keep header checkbox in sync (checked if all rows checked)
                var allChecked = $("input[name='chkRow']").length === $("input[name='chkRow']:checked").length;
                $("#chkHeader").prop("checked", allChecked);
            });
        });
    </script>
    <script>
        function validateForm(ctl, msg) {
            event.preventDefault();
            // Turn off the "Save" button and change text
            $(ctl).prop("disabled", true).val(msg);
            // Gray out background on page
            $("body").addClass("submit-progress-bg");
            // Wrap in setTimeout so the UI can update the spinners
            $(".submit-progress").removeClass("hidden");
            //submit the form.
            setTimeout(function () {
                $("form").submit();
            }, 1);
            return true;
        }
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "60%", height: "80%" });
            $(".iframeFundPendingApprove").colorbox({ iframe: true, width: "60%", height: "80%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(false);
                }
            });
            $(".Remindermail").colorbox({ iframe: true, width: "40%", height: "50%" });
            $('#RecievingDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                //showButtonPanel: true,
                yearRange: "-66:+0",
            });
            $('#CompletedDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}
