@section Scripts{


    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "60%", height: "80%" });
            $(".iframeFundPendingApprove").colorbox({ iframe: true, width: "60%", height: "80%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(false);
                }
            });
            $(".Remindermail").colorbox({ iframe: true, width: "40%", height: "50%" });
            $('#RecievingDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                //showButtonPanel: true,
                yearRange: "-66:+0",
            });
            $('#CompletedDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}
<script>
    $(document).ready(function () {
        var table = $('#grid').DataTable({
            responsive: true,
        });
        new $.fn.dataTable.FixedHeader(table);
    });
</script>
<style>
    #ExportExcel {
        margin: 1px 450px;
    }

    .total-record {
