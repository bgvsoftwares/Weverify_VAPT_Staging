                                            {
                                                if (temp.Count() == 1)
                                                {
                                                    if (nm[0] == "135")
                                                    {

                                                        <textarea class="form-control" type="text" name="@nm[0]" id="@temp[0]" value="@temp[0]" style="text-align:left; height:50px">@temp[0]</textarea>


                                                    }
                                                    else
                                                    {
                                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' maxlength="@nm[5]">


                                                    }
                                                }
                                                else
                                                {
                                                    if (nm[0] == "135")
                                                    {

                                                        <textarea class="form-control" type="text" name="@nm[0]" id="@temp[0]" value="@temp[1]" style="text-align:left; height:50px">@temp[1]</textarea>
                                                        <input type="text" class="form-control" name="@nm[0].ToString()_1" id=@nm[0] value='' maxlength="@nm[5]">

                                                    }
                                                    else
                                                    {
                                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' maxlength="@nm[5]">


                                                    }
                                                }


                                            }

                                            else
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] maxlength="@nm[5]">


                                            }
                                        </div>


                                    </div>
                                </div>
                            }

                            if (@nm[2] == "dropdown")
