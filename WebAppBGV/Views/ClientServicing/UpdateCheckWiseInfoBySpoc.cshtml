                        }

                    </div>

                }
                <div class="container">
                    <div class="row">
                        <div class="col-sm">
                            <p>Severity</p>
                        </div>
                        <div class="col-sm">
                            &nbsp;
                        </div>
                        <div class="col-sm">
                            <input id="Severity" type="text" width="300" name="Severity" disabled="disabled" value=@SeverityGrid>
                        </div>
                    </div>
                </div>

                <div class="container">
                    <div class="row">
                        <div class="col-sm">
                            <p>Color</p>
                        </div>
                        <div class="col-sm">
                            &nbsp;
                        </div>
                        <div class="col-sm">
                            <input id="ColorName" type="text" name="ColorName" disabled="disabled" value=@ColorCode>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12 cytoscape-parent">
                        <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                    </div>
                </div>
                List<SelectListItem> RemarkPrioritytypeList = new List<SelectListItem>();
                RemarkPrioritytypeList.Add(new SelectListItem { Text = "High", Value = "High" });
                RemarkPrioritytypeList.Add(new SelectListItem { Text = "Low", Value = "Low" });

                <div class="container">
                    <div class="row">
                        <div class="col-md-4">
                            <p>Remark Priority type :</p>
                        </div>
                        <div class="col-sm-4">
                            &nbsp;
                        </div>
                        <div class="col-md-4">
                            @if (RemarkPrioritytypeList != null)
                            {
                                @Html.DropDownList("Prioritytype", new SelectList(RemarkPrioritytypeList, "Text", "Value"), new { @class = "form-control" })
                            }
                        </div>
                    </div>
                </div>


                <div class="container">
                    <div class="row">
                        <div class="col-md-4">
                            <p>Action Remarks:</p>
                        </div>
                        <div class="col-md-8">

                            <textarea id="Remarks" class="form-control" type="text" name="Remarks" value="@ReportComment" style="text-align:left; height:50px"> @ReportComment </textarea>
                        </div>
                    </div>
                </div>
                <div class="row">

                    @Html.ActionLink("Back", "ManageClientReviewClearDashboardInfo", "ClientServicing", new { CaseStatus = "SpocReview", cr = clsCommonMethods.PEncrypt(clientRowId.ToString()), tmr = Session["Teammemberrowid"].ToString() }, new { @class = "btn btn-default VerEmailDetails" })

                    <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" name="action" />
                    @*<input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Reject" name="action" />*@

                </div>
                <br />
                <br />
                <br />


            }
        </div>
    </div>
    @section Scripts{
        <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
        <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
        <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
        <link href="~/Content/colorbox.css" rel="stylesheet" />
        <script src="~/Scripts/jquery.colorbox-min.js"></script>
        <script src="~/Scripts/tinymceNew.min.js"></script>
        <script src="~/Scripts/tinymce-jquery.min.js"></script>

        <script>
            $('textarea').tinymce({
                height: 200,
                plugins: [
                    'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                    'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                    'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
                ],
                toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                    'alignleft aligncenter alignright alignjustify | ' +
                    'bullist numlist outdent indent | removeformat | help'
            });
            // Prevent jQuery UI dialog from blocking focusin
            $(document).on('focusin', function (e) {
                if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                    e.stopImmediatePropagation();
                }
            });
        </script>
        <style>
            .tox-tinymce {
                margin-top: 10px !important;
            }

            .tox-editor-header {
                box-shadow: none !important;
                z-index: 0 !important;
                border-bottom: 0.5px solid #000 !important;
            }

            .tox-statusbar__branding {
                display: none !important;
            }
        </style>

        <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            var CountryName = '@(ViewBag.CountryName)';
            var StateName = '@(ViewBag.StateName)';
            var CityName = '@(ViewBag.CityName)';

            var Countryid = '@(ViewBag.countryid)';
            var Stateid = '@(ViewBag.StateId)';
            var Cityid = '@(ViewBag.CityId)';

            if ($('#34').val() != null) {

                $.getJSON('/Master/BindCountry/', function (data) {
                    var items = '<option value="">-- Select Country --</option>';
                    $.each(data, function (i, countries) {
                        items += "<option value='" + countries.Value + "'>" + countries.Text + "</option>";
                    });
                    $('#34').html(items);
                    $("#34 option").filter(function () {
                        return this.text == CountryName;
                    }).attr('selected', true);
                    //$('#34').val($('#hdnAV_State').val());
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');

                });
            }

            if ($('#44').val() != null) {

                $.getJSON('/Master/BindState/' + Countryid, function (data) {
                    var items = '<option value="">-- Select State --</option>';
                    $.each(data, function (i, States) {
                        items += "<option value='" + States.Value + "'>" + States.Text + "</option>";
                    });
                    $('#44').html(items);
                    $("#44 option").filter(function () {
                        return this.text == StateName;
                    }).attr('selected', true);
                    //$('#34').val($('#hdnAV_State').val());
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');

                });
            }

            if ($('#32').val() != null) {

                $.getJSON('/Master/BindDistrict/' + Stateid, function (data) {
                    var items = '<option value="">-- Select District --</option>';
                    $.each(data, function (i, Districts) {
                        items += "<option value='" + Districts.Value + "'>" + Districts.Text + "</option>";
                    });
                    $('#32').html(items);
                    $("#32 option").filter(function () {
                        return this.text == CityName;
                    }).attr('selected', true);
                    //$('#34').val($('#hdnAV_State').val());
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');

                });
            }

        });

        $(function () {

            //Bind State base on CountryRowID
            $('#34').change(function () {

                $.getJSON('/Master/BindState/' + $('#34').val(), function (data) {
                    var items = '<option value="">-- Select State --</option>';
                    $.each(data, function (i, States) {
                        items += "<option value='" + States.Value + "'>" + States.Text + "</option>";
                    });
                    $('#44').html(items);
                    $('#HfCountryName').val($('#34 option:selected').html());

                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');
                });
            });

            //Bind District base on StateRowID
            $('#44').change(function () {
                $.getJSON('/Master/BindDistrict/' + $('#44').val(), function (data) {
                    var items = '<option value="">-- Select District --</option>';
                    $.each(data, function (i, Districts) {
                        items += "<option value='" + Districts.Value + "'>" + Districts.Text + "</option>";
                    });
                    $('#32').html(items);
                    $('#HfStateName').val($('#44 option:selected').html());


                });
            });

            $('#32').change(function () {

                $('#HfCityName').val($('#32 option:selected').html());

            });



        });

        function validateFormReject() {
            if ($('#Remarks').val() == '') {
                alert("Please mention the reason!");
                $('#Remarks').focus();
                return false;
            }

            return true;
        }
        </script>

    }

