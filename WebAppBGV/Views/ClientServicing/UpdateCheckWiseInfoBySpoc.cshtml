                                <div class="container">
                                    <div class="row">

                                        <div class="col-sm">
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <h7>*</h7>
                                                }
                                            }
                                            @nm[1]
                                        </div>
                                        <div class="col-sm">
                                            @if (temp.Count() > 0)
                                            {
                                                <p>@temp[0]</p>
                                            }
                                        </div>

                                        <div class="col-sm">
                                            <p>@nm[4]</p>
