@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Welcome To  Tracker";
}

@section DisplayTitle { @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage { @Html.Partial("_DisplayErrorMessage") }

@using (Html.BeginForm("REALTIMELTmindTRACKER", "ClientServicing", FormMethod.Post, new { id = "misForm" }))

{
    <div class="form-horizontal">
        <div class="form-group row search-frame">
            <label class="col-md-2 control-label">  Date From:</label>
            <div class="col-md-3">
                <input type="text" id="CompletedFromDate" name="CompletedFromDate" class="form-control" placeholder="dd-MMM-yyyy" autocomplete="off" />
            </div>

            <label class="col-md-2 control-label">  Date To:</label>
            <div class="col-md-3">
                <input type="text" id="CompletedToDate" name="CompletedToDate" class="form-control" placeholder="dd-MMM-yyyy" autocomplete="off" />
            </div>
        </div>

        @Html.Hidden("ClientRowID", Request.QueryString["ClientRowID"])

        <div class="form-group row">
            <div class="col-md-12 text-center">
                <button type="submit" id="btnE2EMIS" class="btn bun-bg btn-default">MIS</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />

    <script type="text/javascript">
		$(document).ready(function () {
			// Prepopulate dropdown if hidden value exists
			$('#ClientRowID').val($('#hdnClientRowID').val());

			// Apply jQuery UI datepicker
			$('#CompletedFromDate, #CompletedToDate').datepicker({
				dateFormat: "dd-M-yy",
				changeMonth: true,
				changeYear: true,
				yearRange: "-66:+0"
			});

		});
    </script>
}
