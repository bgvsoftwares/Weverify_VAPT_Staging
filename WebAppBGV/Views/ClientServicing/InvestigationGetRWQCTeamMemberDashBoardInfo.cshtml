@{
    ViewBag.Title = "Case Details";

    if (Request.QueryString["ClientRowID"] != null && Convert.ToInt16(Request.QueryString["ClientRowID"]) > 0)
    {
        @Html.Hidden("ClientRowID", Request.QueryString["ClientRowID"])

        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "Index", "ClientServicing", new { ClientRowID = Request.QueryString["ClientRowID"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else
    {
        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "Index", "ClientServicing", new { ClientRowID = 0 }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("InvestigationGetRWQCTeamMemberDashBoardInfo", "ClientServicing", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Securitas Id...", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Recieving Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingDate", null, new { @class = "form-control", @id = "RecievingDate", @placeholder = "dd-MMM-yyyy", @autocomplete = "off" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedDate", null, new { @class = "form-control", @id = "CompletedDate", @placeholder = "dd-MMM-yyyy", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group branch search-frame">
                                    @{
                                        if (Request.QueryString["CaseStatus"] != null)
                                        {
                                            @Html.Hidden("CaseStatus", Request.QueryString["CaseStatus"].ToString())
                                        }
                                    }
                                    <div style="text-align:center;">
                                        <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.DashboardClientCandidates != null)
                {
                <div class="row">
                    <div class="col-md-12">
                        @{

        WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
        grid.Bind(Model.DashboardClientCandidates, autoSortAndPage: false, rowCount: Model.TotalRecords);
                        }
                        @grid.GetHtml(
                      htmlAttributes: new { id = "grid", @class = "table" },
                      headerStyle: "thead-inverse",
                      rowStyle: "ordertxt",
                      footerStyle: "custpaging",
                      mode: WebGridPagerModes.All,
                      columns: new[]
                      {
                                    grid.Column(header: "No.", style:"col-md-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-3"),

                                    grid.Column(header : "Securitas ID", format : (item) => {
                                        string CompanyRefNo=item.CompanyRefNo;
                                                var link = Html.ActionLink(CompanyRefNo, "ManageCandidateChecksForReportQCTM", "ReportQC", new { PersonalRowID = item.PersonalRowID, dispFor="TeamMember"  }, new { @class="edit" });
                                             return link;
                                    }, style:"col-md-2"),
                                    grid.Column(header : "Interim", format : (item) => {
                                        if (item.InterimReport==1)
                                         {
                                            var link = Html.ActionLink("Report","InvestigationUploadReportPDFFileBYRWTM", "ClientServicing", new { id = item.PersonalRowID,Report_Type=item.Report_Type }, new { @target="_blank", @class="edit" });
                                            return link;
                                          }
                                     return "";
                                    }, style:"col-md-1"),


                                    grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"col-md-2"),
                                    grid.Column("CreatedDate", "Created-Date", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd-MMM-yyyy") : "", canSort: false,style:"col-md-2"),
                                  
                                   

                                


             

                  }
               )
                        <div class="total-record">Total Records: @Model.TotalRecords</div>
                    </div>

                </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "60%", height: "80%" });
            $(".Remindermail").colorbox({ iframe: true, width: "40%", height: "50%" });
            $('#RecievingDate').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                //showButtonPanel: true,
                yearRange: "-66:+0",
            });
            $('#CompletedDate').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}

