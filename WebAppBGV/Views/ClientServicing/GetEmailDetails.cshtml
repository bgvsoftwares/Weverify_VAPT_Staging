@model List<ViewModels.ProvidedInfoViewModel.UserEmailDetails>
@{
    ViewBag.Title = "Get Email Details";
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            @using (Html.BeginForm("GetEmailDetails", "ClientServicing", FormMethod.Post))
            {
                <div class="form-group branch row ">
                    <div class="row">
                        <div class="col-md-2">
                            @Html.Label("ClientRowID", "Client Name", new { @class = "required" })
                        </div>
                        <div class="col-md-5">
                            @Html.DropDownList("ClientRowID",
                         new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                         "-- Select Client --",
                         new { @class = "form-control" })

                            @Html.ValidationMessage("ClientRowID", "", new { @class = "text-danger" })
                        </div>
                        
                        <div class="col-md-2">
                            <input class="btn bun-bg btn-default" type="submit" name="btnSubmit" value="Search" />
                        </div>
                    </div>

                </div>
            }
            <div class="container-fluid p-0">
                <div class="row p-0">
                    <div class="col-lg-12 p-0">
                        <div class=" table-edit-responsive">
                            <table class="table table-striped table-bordered nowrap">
                                <thead>
                                    <tr>
                                        <th>Client Name</th>
                                        <th>User Name</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null)
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr data-userid="@item.ClientUserRowID">
                                                <td class="editable" data-field="UserEmailID">@item.ClientName</td>
                                                <td class="editable" data-field="UserEmailID">@item.UserID</td>
                                                @*<td class="editable" data-field="CaseInitiationMail">@item.CaseInitiationMail</td>
                                                <td class="editable" data-field="SendInsuffEmail">@item.SendInsuffEmail</td>
                                                <td class="editable" data-field="SendRedReportEmail">@item.SendRedReportEmail</td>
                                                <td class="editable" data-field="SendFundsApprovedMail">@item.SendFundsApprovedMail</td>
                                                <td class="editable" data-field="SendYTRMail">@item.SendYTRMail</td>
                                                <td class="editable" data-field="SendReportEmail">@item.SendReportEmail</td>*@
                                            <td>
                                                @Html.ActionLink("Edit", "UpdateEmailDetails", "ClientServicing", new { Id = @item.ClientUserRowID }, null) <i class="fa fa-eye tx-14" style="color:#8D5FFF;"></i>
                                            </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <style>

        .table-edit-responsive {
            display: inline-block;
            max-width: 1150px;
            width: 100%;
            overflow: scroll;
        }
    </style>
}
