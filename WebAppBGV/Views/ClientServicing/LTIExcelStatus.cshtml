
@{
    ViewBag.Title = "LTIMindtree Sent Status";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">

                        @using (Html.BeginForm("LTIExcelStatus", "ClientServicing", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Execl Sheet:</label>
                                    <div class="col-md-3">
                                        <input type="file" id="DigitalVer" class="form-control" name="DigitalVer" accept=".xlsx,.xls">
                                        @if (ViewBag.Error != null )
                                        {
                                            <p class="text-danger p-2">@ViewBag.Error</p>
                                        }
                                        <br />
                                    </div>

                                    <div class="col-md-2">
                                        <input class="btn bun-bg btn-default" type="submit" value="Send" name="SaveWork" />
                                    </div>

                                </div>

                            </div>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
}


<style>
    @@media screen and (max-width: 1450px) and (min-width: 600px) {
        #grid {
            font-size: 1.2rem !important;
            width: 100%;
        }

        .table td, .table th {
            padding: .55rem !important;
        }

        .thead-inverse {
            font-size: 1.2rem !important;
        }

        table, td, .edit {
            font-size: 1.2rem !important;
        }
    }
</style>