                        <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                    </div>
                </div>
            }
        }


    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#DOL').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+00",
            });

            // Handle Till Date selection
            $('#DOLOption').change(function () {
                if ($(this).val() == "Till Date") {
                    $('#DOL').val('Till Date'); // Set DOL field to "Till Date"
                    $('#DOL').prop('readonly', true); // Make date picker read-only when "Till Date" is selected
                } else {
                    $('#DOL').prop('readonly', false); // Allow date selection again
                }
            });
        });


        $(document).ready(function () {
            $('#DOJ').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+00",
            });

            // Handle Till Date selection
            $('#DOJOption').change(function () {
                if ($(this).val() == "Till Date") {
                    $('#DOJ').val('Till Date'); // Set DOL field to "Till Date"
                    $('#DOJ').prop('readonly', true); // Make date picker read-only when "Till Date" is selected
                } else {
                    $('#DOJ').prop('readonly', false); // Allow date selection again
                }
            });
        });


        function fileValidation(fileInput) {
            //var fileInput = document.getElementById('file');
            var filePath = fileInput.value;
            var allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif|\.pdf\.JPG|\.JPEG|\.PNG|\.GIF|\.PDF|\.ZIP|\.zip)$/i;
            if (!allowedExtensions.exec(filePath)) {
                alert('Please upload file having extensions .jpeg/.jpg/.png/.gif/.pdf only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }
        function validateForm() {
            var Remarks = $("#Remarks");
            if (Remarks.val() == "") {
               //If the "Please Select" option is selected display error.
                alert("Please Fill Remarks !");
                return false;
            }
        }
    </script>
}
