                <input type="hidden" value="@Model.PersonalRowID" id="PersonalRowID" name="PersonalRowID" />

                <div class="form-horizontal">
                    <div class="form-group branch">
                        @Html.LabelFor(model => model.DOJ, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-3">
                            @*@Html.EditorFor(model => model.DOL, new { htmlAttributes = new { @class = "date-picker form-control", @placeholder = "yyyy-MM-dd", required =  "required" } })*@
                         
                                <!-- Date Picker with Till Date Option -->
                                <div class="input-group">
                                    <input type="text" class="form-control date-picker" id="DOJ" name="DOJ" placeholder="yyyy-mm-dd" required />
                                    @*<div class="input-group-append">
                                        <select id="DOLOption" class="form-control">
                                            <option value="">Select Option</option>
                                            <option value="Till Date">Till Date</option>
                                        </select>
                                    </div>*@
                                </div>
                             
                         
                        </div>
                    </div>

                  
                    <div class="form-group branch">
                        @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "2" })
                        </div>
                    </div>
                    <div class="all-button-bg">
                        <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                    </div>
                </div>
            }
        }
        else
        {
            using (Html.BeginForm("EmploymentYTRChecksClearByClient", "ClientServicing", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" value="@Model.EmploymentRowID" id="EmploymentRowID" name="EmploymentRowID" />
                <input type="hidden" value="@Model.SubCheckRowID" id="SubCheckRowID" name="SubCheckRowID" />
                <input type="hidden" value="@Model.CheckFamilyRowID" id="CheckFamilyRowID" name="CheckFamilyRowID" />
                <input type="hidden" value="@Model.PersonalRowID" id="PersonalRowID" name="PersonalRowID" />

                <div class="form-horizontal">
                    <div class="form-group branch">
                        @Html.LabelFor(model => model.DOL, htmlAttributes: new { @class = "col-md-2 control-label" })
