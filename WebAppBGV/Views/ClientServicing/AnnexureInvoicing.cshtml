<script type="text/javascript">
    $(".delete").on("click", function () {
        var str = $(this).attr("AnnexureInvoicingId").split("_");
        id = str[1];
        var flag = confirm('Do you want to Delete the Record ?');
        if (id != "" && flag) {
            $.ajax({
                type: "GET",
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("DeleteAnnexureInvoicing", "ClientServicing")',
                data: { "id": id },
                dataType: "json",
                beforeSend: function () { },
                success: function (data) {
                    if (data.result == true) {
                        alert("Record Deleted Successfully!!");
                        setTimeout(function () { window.location.replace("AnnexureInvoicing"); }, 500);
                    }
                    else {
                        setTimeout(function () { window.location.replace("AnnexureInvoicing"); }, 500);
                    }
                }
            });
        }
    });
</script>
<script type="text/javascript">
    $(".SendMail").on("click", function () {
        var str = $(this).attr("AnnexureInvoicingId").split("_");
        id = str[1];
        var ReminderSendOption = 0;
        var flag = confirm('Do you want to send mail ?');
        if (id != "" && flag) {
            $.ajax({
                type: "GET",
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SendMailAnnexureInvoicing", "ClientServicing")',
                data: { "id": id, "ReminderSendOption": ReminderSendOption },
                dataType: "json",
                beforeSend: function () { },
                success: function (data) {
                    if (data.result == true) {
                        alert("Mail has been sent Successfully!!");
                        setTimeout(function () { window.location.replace("AnnexureInvoicing"); }, 500);
                    }
                    else {
                        setTimeout(function () { window.location.replace("AnnexureInvoicing"); }, 500);
                    }
                }
            });
        }
    });
</script>
<script>
    document.getElementById("AnnexureAmount").addEventListener("input", function (e) {
        let value = e.target.value;
        if (!/^\d{0,8}(\.\d{0,4})?$/.test(value)) {
            let match = value.match(/^(\d{0,8})(\.\d{0,4})?/);
            if (match) {
                e.target.value = match[0];
            } else {
                e.target.value = "";
            }
        }
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        const clientDropdown = document.getElementById("ddlClientRowID");
        const annexureAmount = document.getElementById("AnnexureAmount");
        const billingWise = document.getElementById("BillingWiseId");

        const clientError = document.getElementById("clientError");
        const amountError = document.getElementById("amountError");
        const billingError = document.getElementById("billingError");

        clientDropdown.addEventListener("change", function () {
            if (clientDropdown.value && clientDropdown.value !== "-- Select Client --") {
                clientError.textContent = "";
            }
        });

        annexureAmount.addEventListener("input", function () {
            if (annexureAmount.value.trim() && !isNaN(annexureAmount.value)) {
                amountError.textContent = "";
            }
        });

        billingWise.addEventListener("input", function () {
            const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
            if (billingWise.value.trim() && dateRegex.test(billingWise.value)) {
                billingError.textContent = "";
            }
        });

        form.addEventListener("submit", function (e) {
            let isValid = true;

            clientError.textContent = "";
            amountError.textContent = "";
            billingError.textContent = "";

            if (!clientDropdown.value || clientDropdown.value === "-- Select Client --") {
                clientError.textContent = "Client Name is required.";
                isValid = false;
            }

            if (!annexureAmount.value.trim()) {
                amountError.textContent = "Annexure Amount is required.";
                isValid = false;
            } else if (isNaN(annexureAmount.value)) {
                amountError.textContent = "Must be a valid number.";
                isValid = false;
            }

            const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
            if (!billingWise.value.trim()) {
                billingError.textContent = "Billing Wise date is required.";
                isValid = false;
            } else if (!dateRegex.test(billingWise.value)) {
                billingError.textContent = "Use yyyy-mm-dd format.";
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault();
            }
        });
    });
</script>

