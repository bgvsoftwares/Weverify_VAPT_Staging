@model IEnumerable<ViewModels.ClientViewModel.ClientDDLViewModel>
@{
    ViewBag.Title = "Data Purge Process";
    var clientList = ViewBag.ClientList as IEnumerable<ViewModels.ClientViewModel.ClientDDLViewModel>;
}

<link href="https://googleapis.com" rel="stylesheet">
<link rel="stylesheet" href="https://cloudflare.com">
<link rel="stylesheet" href="https://unpkg.com">

@if (TempData["SuccessMessage"] != null)
{
    <div>
     <center><p><b>@TempData["SuccessMessage"]</b></p></center>
    </div>
}

<div class="purge-container">
    <div class="purge-card">

        <!-- Header Section -->
        <div class="purge-header">
            <div class="icon-box">
                <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                    <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5" />
                </svg>

            </div>
            <div>
                <h2>Data Bulk Purge Dashboard</h2>
                <p>Configure parameters, upload the data file, and safely execute the background purge process.</p>
            </div>
        </div>

        <form id="purgeForm" method="post" action="@Url.Action("PurgeProcess", "ClientServicing")" enctype="multipart/form-data">

            <!-- Step 1: Searchable Dropdown -->
            <div class="form-group">
                <label for="ClientRowID">1. Select Client <span class="required">*</span></label>
                <input type="hidden" name="ClientRowID" id="ClientRowID" value="" />

                <div class="custom-dropdown" id="customDropdown">
                    <div class="dropdown-trigger" id="ClientRowIDS" onclick="toggleDropdown()">-- Choose a Client --</div>
                    <div class="dropdown-menu-content">
                        <div class="search-box-wrapper">
                            <input type="text" id="dropdownSearch" placeholder="Search client..." onkeyup="filterDropdown()">
                        </div>
                        <ul class="dropdown-options" id="optionsList">
                            @if (ViewBag.ClientList != null)
                            {
                                foreach (var item in (SelectList)ViewBag.ClientList)
                                {
                                    <li data-value="@item.Value" onclick="selectOption(this)">@item.Text</li>
                                }
                            }
                        </ul>
                    </div>
                </div>
                <div class="error-msg" id="clientError">Please select a client from the list.</div>
            </div>

            <!-- New Step 2: Date Range Field -->
            <div class="form-group">
                <label for="PurgDateFrom">2. Purge Date From <span class="required">*</span></label>
                <div class="date-input-wrapper">
                    <i class="bi bi-calendar-range date-icon"></i>
                    <input type="text" id="PurgDateFrom" name="PurgDateFrom1" class="custom-input date-picker" placeholder="Choose Purge Date From..." />
                </div>
                @*<div class="error-msg" id="dateError">Please select a valid date range.</div>*@
            </div>

            <div class="form-group">
                <label for="PurgDateTo">3. Purge Date To <span class="required">*</span></label>
                <div class="date-input-wrapper">
                    <i class="bi bi-calendar-range date-icon"></i>
                    <input type="text" id="PurgDateTo" name="PurgDateTo1" class="custom-input date-picker" placeholder="Choose Purge Date From..." />
                </div>
                @*<div class="error-msg" id="dateError">Please select a valid date range.</div>*@
            </div>

            <div class="form-group">
                <label for="fileNameReq">4. FileName <span class="required">*</span></label>
                <div class="date-input-wrapper">
                    <i class="bi bi-calendar-range date-icon"></i>
                    <input type="text" id="fileNameReq" name="fileNameReq1" class="custom-input date-picker" placeholder="Choose Purge Date From..." />
                </div>
                @*<div class="error-msg" id="dateError">Please select a valid date range.</div>*@
            </div>

            <!-- New Step 3: Document Required Option (Default No) -->
            <div class="form-group">
                <label>5. Document Required? <span class="required">*</span></label>
                <div class="toggle-switch-container">
                    <label class="toggle-option">
                        <input type="radio" name="IsDocumentRequired" value="false" checked onclick="triggerAutoValidate()">
                        <span class="radio-tile"><i class="bi bi-x-circle"></i> No</span>
                    </label>
                    <label class="toggle-option">
                        <input type="radio" name="IsDocumentRequired" value="true" onclick="triggerAutoValidate()">
                        <span class="radio-tile"><i class="bi bi-check-circle"></i> Yes</span>
                    </label>
                </div>
            </div>

            <!-- New Step 4: Excel Upload Zone with Template Link -->
            <div class="form-group">
                <div class="label-row">
                    <label>6. Upload Excel File (.xlsx) <span class="required">*</span></label>
                    <a href="@Url.Action("DownloadPurgeTemplate", "ClientServicing")" class="template-link">
                        <i class="bi bi-cloud-arrow-down"></i> Download Template
                    </a>
                </div>

                <!-- Outer Interactive Visual Container Only -->
                <div class="upload-dropzone" id="dropzone">
                    <i class="bi bi-file-earmark-excel excel-icon"></i>
                    <p class="dropzone-text">Drag and drop your Excel file here or <span>Browse Files</span></p>
                    <p class="dropzone-subtext">Only .xlsx files are allowed</p>
                </div>

                <!-- Hidden Native Controller Field Placed Safely Outside Container Bounds -->
                <input type="file" id="ExcelFileInput" name="ExcelFile" accept=".xlsx" style="display:none;" />

                <div id="fileDisplayZone" class="file-status-box" style="display: none;">
                    <i class="bi bi-file-check-fill text-success"></i>
                    <span id="fileNameText">filename.xlsx</span>
                    <button type="button" class="remove-file-btn" onclick="removeSelectedFile()"><i class="bi bi-x"></i></button>
                </div>
                <div class="error-msg" id="fileError">Please upload a valid Microsoft Excel (.xlsx) spreadsheet.</div>
            </div>

            <!-- Permanent Warning Alert Strip -->
            <div class="smart-alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <span><strong>Permanent System Action Risk:</strong> Purging cannot be undone. Data records will be removed securely from active system production tables immediately.</span>
                </div>
            </div>

            <!-- Action Buttons Row -->
            <div class="action-row">
                <button type="button" id="btnExecute" class="btn-clean btn-danger" disabled>
                    <i class="bi bi-shield-lock-fill"></i> Execute Permanent Purge
                </button>
            </div>

        </form>
    </div>
</div>

<div class="purge-grid-section" style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h3 style="margin: 0; color: #333;">Purged Logs / History</h3>
        <!-- Total Records Indicator -->
        <span class="badge" style="background-color: #6c757d; color: white; padding: 5px 10px; border-radius: 4px; font-weight: bold;">
            Total Records: @(ViewBag.TotalRecords ?? 0)
        </span>
    </div>

    <div class="table-responsive" style="overflow-x: auto; background: #fff; border: 1px solid #dee2e6; border-radius: 8px;">
        <table class="table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                    <th style="padding: 12px; font-weight: 600;">Reference Number</th>
                    <th style="padding: 12px; font-weight: 600;">Customer Name</th>
                    <th style="padding: 12px; font-weight: 600;">Customer Add.</th>
                    <th style="padding: 12px; font-weight: 600;">Date Range</th>
                    <th style="padding: 12px; font-weight: 600;">Total Records</th>
                    <th style="padding: 12px; font-weight: 600;">Purged Date</th>
                    <th style="padding: 12px; font-weight: 600;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.PurgeRecords != null && ((System.Data.DataTable)ViewBag.PurgeRecords).Rows.Count > 0)
                {
                    foreach (System.Data.DataRow row in ((System.Data.DataTable)ViewBag.PurgeRecords).Rows)
                    {
                        <tr style="border-bottom: 1px solid #dee2e6;">
                            <!-- Ensure the column string names match your exact database/DataTable column names -->
                            <td style="padding: 12px;">@row["Reference Number"]</td>
                            <td style="padding: 12px;">@row["Customer Name"]</td>
                            <td style="padding: 12px;">@row["Customer Add."]</td>
                            <td style="padding: 12px;">@row["Date range"]</td>
                            <td style="padding: 12px;">@row["TotalRecords"]</td>
                            <td style="padding: 12px;">
                                @(row["CreatedOn"] != DBNull.Value ? Convert.ToDateTime(row["CreatedOn"]).ToString("dd-MMM-yyyy") : "")
                            </td>
                            <td>
                                <a href="@Url.Action("DownloadCertificate", "ClientServicing", new { id = row["Id"] })" class="btn btn-success">
                                    <i class="bi bi-cloud-arrow-down"></i> Download Certificate
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="padding: 20px; text-align: center; color: #6c757d;">
                            No purge history records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    :root {
        --primary-color: #2563eb;
        --danger-color: #dc2626;
        --text-main: #1f2937;
        --text-sub: #4b5563;
        --border-color: #e5e7eb;
        --bg-body: #f8fafc;
        --success-color: #16a34a;
    }

    body {
        background-color: var(--bg-body);
        font-family: 'Inter', sans-serif;
        color: var(--text-main);
        margin: 0;
        padding: 0;
    }

    .purge-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 40px 20px;
        box-sizing: border-box;
    }

    .purge-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
        width: 100%;
        max-width: 680px;
        padding: 40px;
        border: 1px solid var(--border-color);
        box-sizing: border-box;
    }

    .purge-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 35px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 24px;
    }

    .icon-box {
        background: #fef2f2;
        color: var(--danger-color);
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .purge-header h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .purge-header p {
        margin: 6px 0 0 0;
        font-size: 14px;
        color: var(--text-sub);
        line-height: 1.5;
    }

    .form-group {
        margin-bottom: 28px;
    }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--text-main);
        }

    .required {
        color: var(--danger-color);
    }

    .label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2px;
    }

    .custom-input {
        width: 100%;
        padding: 12px 16px;
        font-size: 15px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background-color: #fff;
        color: var(--text-main);
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .custom-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }

    /* Searchable Dropdown Styling */
    .custom-dropdown {
        position: relative;
        width: 100%;
    }

    .dropdown-trigger {
        width: 100%;
        padding: 14px 40px 14px 16px;
        font-size: 15px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background-color: #fff;
        cursor: pointer;
        user-select: none;
        box-sizing: border-box;
        position: relative;
        text-align: left;
    }

        .dropdown-trigger::after {
            content: "\F2E0";
            font-family: "bootstrap-icons";
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-sub);
            font-size: 14px;
            transition: transform 0.2s ease;
        }

    .custom-dropdown.open .dropdown-trigger::after {
        transform: translateY(-50%) rotate(180deg);
    }

    .dropdown-menu-content {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        width: 100%;
        border: 1px solid var(--border-color);
        background: #fff;
        z-index: 1050;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    .custom-dropdown.open .dropdown-menu-content {
        display: block;
    }

    .search-box-wrapper {
        padding: 10px;
        background: #f8fafc;
        border-bottom: 1px solid var(--border-color);
    }

    #dropdownSearch {
        width: 100%;
        padding: 10px 12px;
        font-size: 14px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        outline: none;
    }

    .dropdown-options {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 200px;
        overflow-y: auto;
    }

        .dropdown-options li {
            padding: 12px 16px;
            font-size: 14.5px;
            cursor: pointer;
        }

            .dropdown-options li:hover {
                background-color: #f1f5f9;
                color: var(--primary-color);
            }

    /* Date Picker Custom Wrapper */
    .date-input-wrapper {
        position: relative;
        width: 100%;
    }

    .date-picker {
        padding-left: 44px !important;
        cursor: pointer;
    }

    .date-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-sub);
        font-size: 18px;
        pointer-events: none;
    }

    /* Toggle Choice Blocks (Yes/No Switch) */
    .toggle-switch-container {
        display: flex;
        gap: 12px;
    }

    .toggle-option {
        flex: 1;
        cursor: pointer;
    }

        .toggle-option input {
            display: none;
        }

    .radio-tile {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px;
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-sub);
        transition: all 0.2s ease;
        text-align: center;
    }

    .toggle-option input:checked + .radio-tile {
        border-color: var(--primary-color);
        background: #f0f6ff;
        color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
    }

    /* Modern Drag and Drop Excel Area */
    .upload-dropzone {
        border: 2px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 12px;
        padding: 32px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .upload-dropzone:hover, .upload-dropzone.dragover {
            border-color: var(--primary-color);
            background: #f0f6ff;
        }

    .excel-icon {
        font-size: 38px;
        color: #0f766e;
        margin-bottom: 12px;
        display: inline-block;
    }

    .dropzone-text {
        font-size: 14.5px;
        font-weight: 500;
        margin: 0 0 4px 0;
        color: #334155;
    }

        .dropzone-text span {
            color: var(--primary-color);
            text-decoration: underline;
            font-weight: 600;
        }

    .dropzone-subtext {
        font-size: 12px;
        color: #94a3b8;
        margin: 0;
    }

    .template-link {
        font-size: 13px;
        font-weight: 600;
        color: var(--primary-color);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .template-link:hover {
            text-decoration: underline;
        }

    .file-status-box {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        padding: 12px 16px;
        border-radius: 10px;
        margin-top: 12px;
        font-size: 14px;
    }

    #fileNameText {
        flex-grow: 1;
        font-weight: 500;
        color: #166534;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .remove-file-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        font-size: 20px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
    }

        .remove-file-btn:hover {
            color: var(--danger-color);
        }

    /* Alerts and Submissions */
    .smart-alert {
        display: flex;
        gap: 12px;
        padding: 16px;
        border-radius: 12px;
        font-size: 13.5px;
        line-height: 1.5;
        margin-bottom: 28px;
    }

    .alert-warning {
        background-color: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .action-row {
        display: flex;
        justify-content: flex-end;
    }

    .btn-clean {
        width: 100%;
        padding: 14px 28px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .btn-danger {
        background-color: var(--danger-color);
        color: white;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
    }

        .btn-danger:hover:not([disabled]) {
            background-color: #b91c1c;
        }

        .btn-danger:disabled {
            background-color: #f1f5f9;
            color: #94a3b8;
            box-shadow: none;
            cursor: not-allowed;
        }

    .error-msg {
        color: var(--danger-color);
        font-size: 12.5px;
        margin-top: 6px;
        display: none;
        font-weight: 500;
    }

    .input-error {
        border-color: var(--danger-color) !important;
    }
</style>
<!-- Core Production Infrastructure Engines -->
@*<script src="https://jquery.com"></script>
<script src="https://cloudflare.com"></script>
<script src="https://jsdelivr.net"></script>*@

<script>
    // GLOBAL NATIVE CONTROL HOOKS REGISTERED OUTSIDE READY STATE
    window.toggleDropdown = function () {
        var dropdown = document.getElementById("customDropdown");
        if (!dropdown) return;
        dropdown.classList.toggle("open");
        if (dropdown.classList.contains("open")) {
            var searchInput = document.getElementById("dropdownSearch");
            if (searchInput) searchInput.focus();
        }
    };

    window.selectOption = function (element) {
        var text = element.innerText;
        var value = element.getAttribute("data-value");

        document.getElementById("ClientRowIDS").innerText = text;
        document.getElementById("ClientRowID").value = value;
        document.getElementById("customDropdown").classList.remove("open");

        $("#clientError").hide();
        window.triggerAutoValidate();
    };

    window.filterDropdown = function () {
        var input = document.getElementById("dropdownSearch");
        var filter = input.value.toLowerCase();
        var ul = document.getElementById("optionsList");
        var li = ul.getElementsByTagName("li");

        for (var i = 0; i < li.length; i++) {
            var txtValue = li[i].textContent || li[i].innerText;
            if (txtValue.toLowerCase().indexOf(filter) > -1) {
                li[i].style.display = "";
            } else {
                li[i].style.display = "none";
            }
        }
    };

    window.removeSelectedFile = function () {
        $('#ExcelFileInput').val('');
        var fileInputElement = document.getElementById('ExcelFileInput');
        if (fileInputElement) fileInputElement.value = "";

        $('#fileDisplayZone').hide();
        $('#dropzone').show();
        window.triggerAutoValidate();
    };

    window.triggerAutoValidate = function () {
        debugger;
        const clientId = $("#ClientRowID").val();
        const PurgDateFrom = $("#PurgDateFrom").val();
        const PurgDateTo = $("#PurgDateTo").val();
        const fileNameReq = $("#fileNameReq").val();

        var fileInputElement = document.getElementById('ExcelFileInput');
        const hasFile = fileInputElement && fileInputElement.files && fileInputElement.files.length > 0;

        if (clientId) $("#customDropdown").removeClass("input-error");
       // if (dateRange && dateRange.includes("to")) $("#DateRangeInput").removeClass("input-error");

        if (clientId && PurgDateFrom && PurgDateTo && PurgDateTo  && hasFile) {
            $("#btnExecute").removeAttr("disabled");
        } else {
            $("#btnExecute").attr("disabled", true);
        }
    };

    // SECURE DOM INTERCEPT ENGAGEMENT BLOCK
    $(document).ready(function () {

        // Fallback Protected Flatpickr Initialization Routine
        //if (typeof flatpickr !== "undefined") {
        //    flatpickr("#DateRangeInput", {
        //        mode: "range",
        //        dateFormat: "Y-m-d",
        //        onChange: function (selectedDates, dateStr, instance) {
        //            window.triggerAutoValidate();
        //        }
        //    });
        //} else {
        //    console.error("Critical Asset Error: flatpickr script wrapper reference dropped or timed out.");
        //}

        // Loop-Free Browser Explorer Invoker Click Routine
        $('#dropzone').on('click', function () {
            $('#ExcelFileInput').click();
        });

        // Drag-Drop Zone Tracker Event Interceptors
        $('#dropzone').on('dragover', function (e) {
            e.preventDefault();
            $(this).addClass('dragover');
        });

        $('#dropzone').on('dragleave dropzone-exit', function () {
            $(this).removeClass('dragover');
        });

        $('#dropzone').on('drop', function (e) {
            e.preventDefault();
            $(this).removeClass('dragover');
            const files = e.originalEvent.dataTransfer.files;
            if (files && files.length > 0) {
                // Update file input files collection data natively
                document.getElementById('ExcelFileInput').files = files;
                handleFileSelection(files[0]);
            }
        });

        $('#ExcelFileInput').on('change', function () {
            if (this.files && this.files.length > 0) {
                handleFileSelection(this.files[0]);
            }
        });

        function handleFileSelection(file) {
            if (!file) return;
            const extension = file.name.split('.').pop().toLowerCase();

            if (extension !== 'xlsx') {
                if (typeof Swal !== "undefined") {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid File Format',
                        text: 'Please upload only standardized Excel arrays (.xlsx spreadsheets).',
                        confirmButtonColor: '#2563eb'
                    });
                } else {
                    alert("Invalid Format! Please provide valid .xlsx schema sheets.");
                }
                window.removeSelectedFile();
                return;
            }

            $('#fileNameText').text(file.name);
            $('#dropzone').hide();
            $('#fileDisplayZone').css('display', 'flex');
            $('#fileError').hide();

            window.triggerAutoValidate();
        }

        // Execution Submit Orchestrator Flow
        $("#btnExecute").click(function () {
            const clientName = $("#ClientRowIDS").text().trim();
            const dateRangeText = $("#DateRangeInput").val();
            const isDocReq = $("input[name='IsDocumentRequired']:checked").val() === "true" ? "Yes" : "No";


            if (isDocReq === "Yes") {
                const userConfirmed = confirm("Have you retrieved All the documents to give to your client?");

              
                if (!userConfirmed) {
                    return false;  
                }
            }


            if (typeof Swal !== "undefined") {
                Swal.fire({
                    title: 'Verify Purge Parameters',
                    html: `<div style="text-align:left; font-size:14px; background:#f8fafc; padding:15px; border-radius:10px; border:1px solid #e5e7eb; line-height:1.6;">
                            <strong>Client Target:</strong> ${clientName}<br/>
                            <strong>Selected Date Range:</strong> ${dateRangeText}<br/>
                            <strong>Purge Attachments:</strong> ${isDocReq}
                           </div><br/>
                           <p style="color:#dc2626; font-weight:600; margin:0;">Are you sure you want to perform this structural delete?</p>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Yes, Purge Data',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'FINAL IRREVERSIBLE ACTION CONFIRMATION',
                            text: 'Production system entries will be wiped out from core server spaces. Are you absolutely certain?',
                            icon: 'error',
                            showCancelButton: true,
                            confirmButtonColor: '#dc2626',
                            cancelButtonColor: '#6b7280',
                            confirmButtonText: 'I Confirm, Execute Now!',
                            cancelButtonText: 'Abort'
                        }).then((finalResult) => {
                            if (finalResult.isConfirmed) {
                                Swal.fire({
                                    title: 'Processing Purge Pipeline...',
                                    text: 'Wiping background records...',
                                    allowOutsideClick: false,
                                    didOpen: () => { Swal.showLoading(); }
                                });
                                $("#purgeForm").submit();
                            }
                        });
                    }
                });
            } else {
                if (confirm("Proceed with permanent database purge process for: " + clientName)) {
                    $("#purgeForm").submit();
                }
            }
        });

        document.addEventListener("click", function (event) {
            var dropdown = document.getElementById("customDropdown");
            if (dropdown && !dropdown.contains(event.target)) {
                dropdown.classList.remove("open");
            }
        });
    });
</script>