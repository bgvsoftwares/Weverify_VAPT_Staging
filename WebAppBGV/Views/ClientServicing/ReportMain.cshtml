@model ViewModels.ReportQCViewModel.ReportViewModel
@{

    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

@if (Model.ReportPart == "OFAC" && Model.ClientRowID == 762)
{
    @section ReportPersonalInfo{ @Html.Partial("_ReportPersonalInfo") }

    @section ReportChecksShortInfo{ @Html.Partial("OFACCheckShortInfo") }
    @section ReportSpecialCheckInfo{ @Html.Partial("_ReportSpecialOFAC") }
    @section ReportDisclaimer{ @Html.Partial("_ReportDisclaimer") }
}
else
{
    @section ReportPersonalInfo{ @Html.Partial("_ReportPersonalInfo") }

    @*@section ReportPersonalInfo{ @Html.Partial("ReportPersonalInfo") }*@
    @section ReportCheckShortInfo{ @Html.Partial("ReportCheckShortInfo") }
    @section ReportAddressCheckInfo{ @Html.Partial("_ReportAddressInfo") }
    @section ReportEducationCheckInfo{ @Html.Partial("ReportEducationInfo") }
    @section ReportEmploymentCheckInfo{ @Html.Partial("ReportEmploymentInfo") }
    @section ReportCriminalCheckInfo{ @Html.Partial("ReportCriminalInfo") }
    @section ReportNationalIdentityCheckInfo{ @Html.Partial("ReportNationalInfo") }
    @section ReportReferenceCheckInfo{ @Html.Partial("ReportReferenceInfo") }
    @section ReportSpecialCheckInfo{ @Html.Partial("ReportSpecialInfo") }
    @*@section ReportSpecialKeyword{ @Html.Partial("REportSpecialKeyword") }*@


    @section ReportDisclaimer{ @Html.Partial("_ReportDisclaimer") }
}










