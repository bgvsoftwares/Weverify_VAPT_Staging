
@{
    ViewBag.Title = "Completed_check_MIS";
}

<div class="row mt-2">
    <div class="col-md-12">
        <p style="color: red; font-weight: bold; font-size : 17px">Please Select Date Range within 1 year !</p>
    </div>
</div>

<br />


@using (Html.BeginForm("Completed_check_MIS", "ClientServicing", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="row g-3 align-items-center mt-2">
        <div class="col-md-2 text-end">
            <label for="FromDate" class="col-form-label">From :</label>
        </div>
        <div class="col-md-3">
            @Html.TextBox("FromDate", null, new { @class = "form-control", @id = "FromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxlength = "10", type = "date" })
        </div>
        <div class="col-md-2 text-end">
            <label for="ToDate" class="col-form-label">To :</label>
        </div>
        <div class="col-md-3">
            @Html.TextBox("ToDate", null, new { @class = "form-control", @id = "ToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxlength = "10", type = "date" })
        </div>

        <div class="col-md-2">
            <input class="search-btn" type="submit" value="Export" id="btnSearch" />
        </div>
    </div>

}



