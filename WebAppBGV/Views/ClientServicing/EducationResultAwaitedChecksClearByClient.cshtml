
@model ViewModels.ProvidedInfoViewModel.PQEmploymentYTRClearViewModel
@{
    ViewBag.Title = "Employment YTR Checks Clear by Client";
    // Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "ClientServicing", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));


    var clid = "";
    clid = Model.ClientRowId.ToString();
    var isRequired = Model.DOLisRequired;
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("EducationResultAwaitedChecksClearByClient", "ClientServicing", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" value="@Model.EmploymentRowID" id="EmploymentRowID" name="EmploymentRowID" />
            <input type="hidden" value="@Model.SubCheckRowID" id="SubCheckRowID" name="SubCheckRowID" />
            <input type="hidden" value="@Model.CheckFamilyRowID" id="CheckFamilyRowID" name="CheckFamilyRowID" />
            <input type="hidden" value="@Model.PersonalRowID" id="PersonalRowID" name="PersonalRowID" />

            <div class="form-horizontal">
                

                <div class="form-group branch">
                    @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.EmployeeID, new { @class = "form-control", @rows = "2" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.UploadDoc, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextBoxFor(model => model.UploadDoc, new { type = "File", @accept = ".jpg, .jpeg, .gif, .png", @onchange = "return fileValidation(this)" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "2" })
                    </div>
                </div>
                <div class="all-button-bg">
                    <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#DOL').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+00",
            });

            // Handle Till Date selection
            $('#DOLOption').change(function () {
                if ($(this).val() == "Till Date") {
                    $('#DOL').val('Till Date'); // Set DOL field to "Till Date"
                    $('#DOL').prop('readonly', true); // Make date picker read-only when "Till Date" is selected
                } else {
                    $('#DOL').prop('readonly', false); // Allow date selection again
                }
            });
        });

        function fileValidation(fileInput) {
            //var fileInput = document.getElementById('file');
            var filePath = fileInput.value;
            var allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif|\.pdf\.JPG|\.JPEG|\.PNG|\.GIF|\.PDF)$/i;
            if (!allowedExtensions.exec(filePath)) {
                alert('Please upload file having extensions .jpeg/.jpg/.png/.gif/.pdf only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }
        function validateForm() {
            var Remarks = $("#Remarks");
            if (Remarks.val() == "") {
               //If the "Please Select" option is selected display error.
                alert("Please Fill Remarks !");
                return false;
            }
        }
    </script>
}
