@model ViewModels.ProvidedInfoViewModel.UserEmailDetails
@{
    ViewBag.Title = "Update Email Details";
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            @using (Html.BeginForm("UpdateEmailDetails", "ClientServicing", FormMethod.Post))
            {
                <div class="container-fluid p-0">
                    <div class="row p-0">
                        <div class="col-lg-12 p-0">
                            @if (Model != null)
                            {
                                <br />
                                <div class="row">
                                    @if (ViewBag.msg != null)
                                    {
                                        <h3 style="color: green; text-align: center; margin-left: 471px;">@ViewBag.msg </h3>
                                    }
                                </div>
                                @Html.Hidden("ClientUserRowID", @Model.ClientUserRowID)
                                <br />
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="form-label">User Email ID</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea class="form-control" id="emailInput" name="UserEmailID">@Model.UserEmailID</textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="form-label">Case Initiation Mail</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea class="form-control" id="emailInput" name="CaseInitiationMail">@Model.CaseInitiationMail</textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="form-label">Send Insuff   Email</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea class="form-control" id="emailInput" name="SendInsuffEmail">@Model.SendInsuffEmail</textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="form-label">Send Red Report Email</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea class="form-control" id="emailInput" name="SendRedReportEmail">@Model.SendRedReportEmail</textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="form-label">SendFunds Approved Mail</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea class="form-control" id="emailInput" name="SendFundsApprovedMail">@Model.SendFundsApprovedMail</textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="form-label">Send YTR Mail</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea class="form-control" id="emailInput" name="SendYTRMail">@Model.SendYTRMail</textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="form-label">Send Report Email</label>
                                    </div>
                                    <div class="col-md-8">
                                        <textarea class="form-control" id="emailInput" name="SendReportEmail">@Model.SendReportEmail</textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-5">

                                    </div>
                                    <input class="btn bun-bg btn-default" id="btn-submit" type="submit" name="btnSubmit" value="Submit" />
                                    <br />
                                </div>
                                <br />
                            }
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/sweetalert2.all.min.js"></script>
<script src="~/Scripts/tinymceNew.min.js"></script>
<script src="~/Scripts/tinymce-jquery.min.js"></script>
<script>
    $(document).ready(function () {

        $('#btn-submit').click(function () {

            $(".error").hide();
            var hasError = false;
            var emailReg = /^([\w-\.]+([\w-]+\.)+[\w-]{2,4})?$/;

            var emailaddressVal = $("#emailInput").val();
            if (emailaddressVal == '') {

                hasError = true;
            }

            else if (!emailReg.test(emailaddressVal)) {
                alter("Enter a valid email address.")
                hasError = true;
            }

            if (hasError == true) { return false; }

        });
    });
</script>