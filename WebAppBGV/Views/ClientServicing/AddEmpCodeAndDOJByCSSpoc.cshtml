@model ViewModels.ViewEmpData

@{
    Layout = null;

}
<style>
</style>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>

@*<script src="http://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>*@
<script src="~/Scripts/jquery-ui-1-14.1.js"></script>
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
<link href="~/Content/newcss/font-awesome.min.css" rel="stylesheet" />

@*@section LeftNavigation{ @Html.Partial("_NavLeftClientServicingInsuff") }*@


<div class="row">
    <div class="col-md-12">

        <div class="row">
            <div class="col-md-12">
                @if (ViewBag.SuccessMsg != null)
                {
                    <div class="successmsg" style="text-align:center" id="divsucc">@ViewBag.SuccessMsg.ToString()</div>
                }
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AddEmpCodeAndDOJByCSSpoc", "ClientServicing"))
                        {


                            @Html.HiddenFor(model => model.PersonalRowID)
                            @Html.HiddenFor(model => model.ClientRowID)


                            <div class="row">
                                <div class="col-md-6">
                                    <label class="control-label">EmployeeId :</label>
                                    @Html.TextAreaFor(model => model.EmployeeID, new { @class = "form-control", @style = "width:100%;" })
                                </div>
                                <div class="col-md-6">
                                    <label class="control-label">DOJ :</label>
                                    @Html.EditorFor(model => model.DateofJoining, new { htmlAttributes = new { @class = "form-control", @placeholder = "yyyy-mm-dd" } })

                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    @if (Model.ClientRowID == "1749")
                                    {
                                        <label class="control-label col-md-12">Joining Status :</label>
                                    }
                                    else
                                    {
                                        <label class="control-label col-md-12">ClientRefID :</label>
                                    }
                                    @Html.TextAreaFor(model => model.ClientRefID, new { @class = "form-control", @rows = "2", @style = "width:100%;" })

                                </div>
                                <div class="col-md-6">
                                    <label class="control-label col-md-12">Location :</label>
                                    @Html.TextAreaFor(model => model.location, new { @class = "form-control", @rows = "2", @style = "width:100%;" })
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <label class="control-label col-md-12">Pan Card :</label>
                                    @Html.TextBoxFor(model => model.PanCard, new { @class = "form-control", @style = "width:100%;" })
                                </div>
                            </div>
                            <br />


                            if (Model.ClientRowID == "576" || Model.ClientRowID == "684")
                            {
                                <div class="form-group">
                                    <label class="control-label col-md-12">Entity :</label>
                                    <div class="col-md-12">
                                        @Html.TextAreaFor(model => model.EntityName, new { @class = "form-control col-md-12", @rows = "2", @style = "width:100%;" })
                                    </div>
                                </div>
                            }

                            if (Model.ClientRowID == "1803")
                            {
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="control-label col-md-12">Process Name :</label>
                                        @Html.TextAreaFor(model => model.ProcessName, new { @class = "form-control", @rows = "2", @style = "width:100%;" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="control-label col-md-12">Line of Business :</label>
                                        @Html.TextAreaFor(model => model.LineOfBusiness, new { @class = "form-control", @rows = "2", @style = "width:100%;" })
                                    </div>
                                </div>
                                <br />
                            }

                            <div class="form-group branch search-frame">
                                <div style="text-align:center;">

                                    <input class="btn bun-bg btn-success" type="submit" value="Update" name="Process" />
                                </div>
                            </div>

                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
<script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
<script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<link href="~/Content/colorbox.css" rel="stylesheet" />
<script src="~/Scripts/jquery.colorbox-min.js"></script>
<script>
    $(function () {

        $("#date_ex").datepicker();


    });


    $(document).ready(function () {

        var ClientRowID = $('#ClientRowID').val();
        if (ClientRowID == 249) {
            $("#EmployeeID").attr('maxlength', '10');
            $("#ClientRefID").attr('maxlength', '10');
        }
        else {
            $("#EmployeeID").attr('maxlength', '50');
            $("#ClientRefID").attr('maxlength', '50');
        }

        $('input[type=datetime]').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            showButtonPanel: true,
            yearRange: "-66:+10",
            //onClose: function (dateText, inst) {
            //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
            //}
        });
    });
    //$("input[type=text]").click(function () {
    //    $('#DateofJoining').attr('type', 'date');

    //});


</script>










