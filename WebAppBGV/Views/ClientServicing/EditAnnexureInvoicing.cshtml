@model ViewModels.ClientViewModel.ClientCandidateViewModel
@{
    ViewBag.Title = "Edit Annexure and Invoicing";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "AnnexureInvoicing", "ClientServicing", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.ClientName, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.ClientName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                    </div>
                    @Html.LabelFor(model => model.ClientCode, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.ClientCode, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.BillingWise, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.BillingWise, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                    </div>
                    @Html.LabelFor(model => model.SpocName, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.TextAreaFor(model => model.SpocName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.AnnexureSentDate, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.AnnexureSentDate, new { htmlAttributes = new { @class = "form-control", @id = "AnnexureSentDateId", @placeholder = "yyyy-mm-dd" } })
                        @Html.ValidationMessageFor(model => model.AnnexureSentDate, "", new { @class = "text-danger" })

                    </div>
                    @Html.LabelFor(model => model.AnnexureAmount, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.AnnexureAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AnnexureAmount, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.AnnexureApprovedDate, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.AnnexureApprovedDate, new { htmlAttributes = new { @class = "form-control", @id = "AnnexureApprovedDateId", @placeholder = "yyyy-mm-dd" } })
                        @Html.ValidationMessageFor(model => model.AnnexureApprovedDate, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.AnnexureApprovedAmount, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.AnnexureApprovedAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AnnexureApprovedAmount, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.InvoiceNo, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.InvoiceNo, new { htmlAttributes = new { @class = "form-control required" } })
                        @Html.ValidationMessageFor(model => model.InvoiceNo, "", new { @class = "text-danger" })

                    </div>
                    @Html.LabelFor(model => model.InvoiceSendDate, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.TextBoxFor(model => model.InvoiceSendDate, new { @class = "form-control", @id = "InvoiceSendDateId", @placeholder = "yyyy-mm-dd"})
                        @Html.ValidationMessageFor(model => model.InvoiceSendDate, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.InvoiceAmount, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.InvoiceAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.InvoiceAmount, "", new { @class = "text-danger" })

                    </div>
                    @Html.LabelFor(model => model.PaymentReceivedDate, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.TextBoxFor(model => model.PaymentReceivedDate,new { @class = "form-control", @id = "PaymentReceivedDateId", @placeholder = "yyyy-mm-dd" })
                        @Html.ValidationMessageFor(model => model.PaymentReceivedDate, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.PaymentReceivedAmount, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.PaymentReceivedAmount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.PaymentReceivedAmount, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.SettlementOption, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.DropDownListFor(model => model.SettlementOption, new List<SelectListItem>
                                {
                                new SelectListItem { Text = "-- Select --", Value = "", Selected = true },
                                new SelectListItem{Text="Settled", Value="Settled"},
                                new SelectListItem{Text="Due",Value="Due"}
                                }, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.SettlementOption, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.AcknowledgementDate, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.TextBoxFor(model => model.AcknowledgementDate,new { @class = "form-control", @id = "AcknowledgementDateId", @placeholder = "yyyy-mm-dd" })
                        @Html.ValidationMessageFor(model => model.AcknowledgementDate, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.PaymentExpectedDate, new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.TextBoxFor(model => model.PaymentExpectedDate, new { @class = "form-control", @id = "PaymentExpectedDateId", @placeholder = "yyyy-mm-dd" })
                        @Html.ValidationMessageFor(model => model.PaymentExpectedDate, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="form-group branch row">
                    @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-6">
                        @Html.TextAreaFor(model => model.Remarks, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.HiddenFor(model => model.AnnexureInvoicingId)
                        @Html.HiddenFor(model => model.ClientRowID)
                    </div>
                </div>
                <div class="all-button-bg">
                    @Html.ActionLink("Back", "AnnexureInvoicing", "ClientServicing", null, new { @class = "btn bun-bg btn-default" })
                    <input class="btn bun-bg btn-default" type="submit" value="Submit" />
                </div>

            </div>
        }
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src="~/Scripts/Formvalidation.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            /*$(".Remindermail").colorbox({ iframe: true, width: "40%", height: "50%" });*/
            $('#AnnexureSentDateId').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#AnnexureApprovedDateId').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#InvoiceSendDateId').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#PaymentReceivedDateId').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#AcknowledgementDateId').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#PaymentExpectedDateId').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>   

}