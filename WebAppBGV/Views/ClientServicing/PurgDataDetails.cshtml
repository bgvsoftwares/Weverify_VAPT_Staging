    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.DateTo, htmlAttributes: new { @class = "control-label col-md-2 required " })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.DateTo, new { @type = "date", @class = "form-control datepicker " })

            @Html.ValidationMessageFor(model => model.DateTo, "", new { @class = "text-danger" })
