        @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "control-label col-md-2 required " })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control ", required = "required" })

            @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
        </div>
    </div>

    @*<div class="form-group">
            @Html.LabelFor(model => model.ApprovalByOperationHead, htmlAttributes: new { @class = "control-label col-md-2" })
