@using ViewModels.ProvidedInfoViewModel;
@model ViewModels.ProvidedInfoViewModel.UpdatePQReferenceInsuffClearViewModel
@{
    ViewBag.Title = "Reference Insuff Check Clear For (" + Convert.ToString(Session["CandidateName"]) + ")";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "ManageReferenceInsuff", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section LeftNavigation{ @Html.Partial("_NavLeftInsuff") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("ReferenceInsuffCheckClear", "Insuff", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ReferenceRowID)
            @Html.HiddenFor(model => model.ClientRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.SubCheckRowID)
            @Html.HiddenFor(model => model.UniqueComponentID)

            <div class="form-horizontal">
                <div class="form-group branch">
                    @Html.LabelFor(model => model.CheckStatus, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-4">
                        @Html.DropDownListFor(model => model.CheckStatus, new List<SelectListItem>
                               { new SelectListItem{Text="Allocated-DE", Value="Allocated-DE"}},
                               new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.CheckStatus, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.INFRemarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.INFRemarks, new { @class = "form-control", @rows = "2" })
                    </div>
                </div>
                <div class="all-button-bg">
                    @Html.ActionLink("Back", "ManageReferenceInsuff", "Insuff", null, new { @class = "btn bun-bg btn-default" })
                    <input class="btn bun-bg btn-default" type="submit" value="Submit" />
                    @Html.ActionLink("Check Action History", "CheckActionHistory", "Verification", new { scid = Model.SubCheckRowID, pe = Model.PersonalRowID }, new { @class = "iframeActionHistories cboxElement btn btn-default" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
<link href="~/Content/colorbox.css" rel="stylesheet" />
<script src="~/Scripts/jquery.colorbox-min.js"></script>
<script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
</script>
}
