
@{
    ViewBag.Title = "Manage Rejected Checks By TeamMember For Data-Entry Quality-Check";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageRejectedChecksByDepTMForDEQC", "Insuff", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-4">
                                        @Html.DropDownList("ClientRowID",
                                        new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                        "-- Select Client -- ",
                                        new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-4">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
                                    </div>
                                </div>
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"col-md-2"),

                                    grid.Column(header : "Unique Component Id", format : (item) => {
                                            string ComponentID=item.UniqueComponentID;

                                        if (item.CheckFamilyRowID==2)
                                            {
                                                var link = Html.ActionLink(ComponentID, "ViewAddressInfo", "ProvidedInfo", new {id = item.VerificationRowID }, null);
                                                return link;
                                            }
                                         else if (item.CheckFamilyRowID==5)
                                            {
                                                var link = Html.ActionLink(ComponentID, "ViewCriminalInfo", "ProvidedInfo", new {id = item.VerificationRowID }, null);
                                                return link;
                                            }
                                        else if (item.CheckFamilyRowID==11)
                                            {
                                                var link = Html.ActionLink(ComponentID, "ViewEducationInfo", "ProvidedInfo", new {id = item.VerificationRowID }, null);
                                                return link;
                                            }
                                        else if (item.CheckFamilyRowID==12)
                                            {
                                                var link = Html.ActionLink(ComponentID, "ViewEmploymentInfo", "ProvidedInfo", new {id = item.VerificationRowID }, null);
                                                return link;
                                            }
                                         else if (item.CheckFamilyRowID==26)
                                            {
                                                var link = Html.ActionLink(ComponentID, "ViewNationalIdentityInfo", "ProvidedInfo", new {id = item.VerificationRowID }, null);
                                                return link;
                                            }
                                        else if (item.CheckFamilyRowID==30)
                                            {
                                                var link = Html.ActionLink(ComponentID, "ViewReferenceInfo", "ProvidedInfo", new {id = item.VerificationRowID }, null);
                                                return link;
                                            }
                                         else if (item.CheckFamilyRowID==40)
                                            {
                                                var link = Html.ActionLink(ComponentID, "ViewSpecialCheckInfo", "ProvidedInfo", new {id = item.VerificationRowID }, null);
                                                return link;
                                            }
                                        else
                                            {
                                                return ComponentID;
                                            }
                                        }, style:"edit col-md-2"),

                                     grid.Column("InternalOutDate", "Internal TAT", format: (item) => item.InternalOutDate != DateTime.MinValue ? item.InternalOutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"col-md-2"),
                                     grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:"col-md-2"),

                                      grid.Column(header : "Action", format : (item) => {
                                        var link = Html.ActionLink("History", "CheckActionHistory", "Verification", new { scid = item.SubCheckRowID, pe = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement" });
                                        return link;
                                    }, style:"edit col-md-2"),

                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                //onOpen: function () { alert('onOpen: colorbox is about to open'); },
                //onLoad: function () { alert('onLoad: colorbox has started to load the targeted content'); },
                //onComplete: function () { alert('onComplete: colorbox has displayed the loaded content'); },
                //onCleanup: function () { alert('onCleanup: colorbox has begun the close process'); },
                onClosed: function () {
                    //alert('onClosed: colorbox has completely closed');
                    window.location.reload(false);
                }
            });

            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            //$(".callbacks").colorbox({
            //    onClosed: function () {
            //        window.location.reload(false);
            //    }
            //});
        });
    </script>
}


