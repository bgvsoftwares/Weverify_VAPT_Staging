        $(document).ready(function () {
            // Hidden fields validate karne ke liye standard setting
            if ($.validator) {
                $.validator.setDefaults({ ignore: [] });
            }

            var $input = $('#CustomSearchInput');
            var $list = $('#CustomDropdownList');
            var $hiddenInput = $('#DataRetentionPeriodDropdown');
            var $errorSpan = $('#DataRetentionError');

            // 1. Saare options memory mein (Array)
            var dropdownOptions = [
                { val: "", text: "-- Select Option --" },
                { val: "Till life of contract", text: "Till life of contract" }
            ];

            for (var i = 1; i <= 1000; i++) {
                dropdownOptions.push({ val: i.toString(), text: i.toString() });
            }

            // Initial values ko track karne ke liye variables (Strict validation ke liye)
            var initialHiddenVal = $hiddenInput.val() || "";
            var initialInputText = "";

            // 2. Saved Value check (Edit Page ke liye)
            var savedValue = $hiddenInput.val();
            if (savedValue) {
                var matched = dropdownOptions.find(o => o.val === savedValue);
                if (matched) {
                    $input.val(matched.text);
                    initialInputText = matched.text; // Store initial text
                } else {
                    $input.val(savedValue);
                    initialInputText = savedValue; // Store initial custom value if any
                }
            }

            // 3. Input click / focus par list dikhana
            $input.on('click focus', function () {
                $('.custom-dropdown-list-box').not($list).hide();
                $list.show();
                renderFilteredOptions($(this).val());
            });

            // 4. Keyup / input par filtering aur clear logic
            $input.on('keyup input', function () {
                var currentVal = $(this).val().trim();
                renderFilteredOptions(currentVal);

                if (currentVal === "") {
                    $hiddenInput.val("").trigger('change');
                }
            });

            // CRITICAL FIX: Blur Event (Kuch bhi random type karne se rokne ke liye)
            $input.on('blur', function () {
                var enteredText = $(this).val().trim();

                if (enteredText === "") {
                    $hiddenInput.val("").trigger('change');
                    return;
                }

                // Check 1: Kya typed text dropdown list ke kisi option se match karta hai?
                var matchedOption = dropdownOptions.find(o => o.text.toLowerCase() === enteredText.toLowerCase());

                // Check 2: Kya typed text page load ki initial text value ke barabar hai?
                var isInitialTextMatch = (enteredText.toLowerCase() === initialInputText.toLowerCase());

                if (matchedOption && matchedOption.val !== "") {
                    // Valid option mila: input aur hidden field sync karo
                    $hiddenInput.val(matchedOption.val).trigger('change');
                    $input.val(matchedOption.text);
                    clearValidationError();
                } else if (isInitialTextMatch) {
                    // Initial selected value se match hua: Initial values restore karo
                    $hiddenInput.val(initialHiddenVal).trigger('change');
                    $input.val(initialInputText);
                    clearValidationError();
                } else {
                    // Invalid entry: Random text ko reject karo aur pichli valid value par revert karo
                    var currentHiddenVal = $hiddenInput.val();
                    var lastValidOption = dropdownOptions.find(o => o.val === currentHiddenVal);

                    if (lastValidOption && currentHiddenVal !== "") {
                        $input.val(lastValidOption.text);
                    } else if (initialHiddenVal !== "") {
                        // Agar kuch galat hai toh page load wali original value par le jao
                        $hiddenInput.val(initialHiddenVal).trigger('change');
                        $input.val(initialInputText);
                    } else {
                        // Kuch bhi valid nahi hai toh poora saaf kar do
                        $input.val("");
                        $hiddenInput.val("").trigger('change');
                    }
                }
            });

            function renderFilteredOptions(query) {
                var value = query.toLowerCase().trim();
                var htmlContent = '';
                var count = 0;

                for (var i = 0; i < dropdownOptions.length; i++) {
                    var item = dropdownOptions[i];

                    if (item.val === "" || item.text.toLowerCase().indexOf(value) > -1) {
                        htmlContent += '<div class="custom-opt-item" data-val="' + item.val + '" style="padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0;">' + item.text + '</div>';
                        count++;

                        if (count > 30 && value !== "") {
                            break;
                        }
                    }
                }
                $list.html(htmlContent).show();
            }

            // 5. Hover effects
            $list.on('mouseenter', '.custom-opt-item', function () {
                $(this).css({ 'background-color': '#337ab7', 'color': 'white' });
            }).on('mouseleave', '.custom-opt-item', function () {
                $(this).css({ 'background-color': 'white', 'color': '#333' });
            });

            // 6. Option selection logic (Click ki jagah MouseDown use kiya taaki blur se pehle execute ho)
            $list.on('mousedown', '.custom-opt-item', function (e) {
                e.preventDefault(); // Blur event ko temporary rokta hai jab tak value select na ho
                var selectedVal = $(this).data('val');
                var selectedText = $(this).text();

                $hiddenInput.val(selectedVal).trigger('change');

                if (selectedVal === "" || selectedVal === null) {
                    $input.val("");
                } else {
                    $input.val(selectedText);
                    clearValidationError();
                }

                $list.hide();
            });

            // Outside click to close
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.custom-search-dropdown-wrapper').length) {
                    $list.hide();
                }
            });

            function clearValidationError() {
                $errorSpan.hide();
                $input.css('border-color', '');
            }

            // CRITICAL PART: SUBMIT PAR VALIDATION ERROR CHECK
            $('form').on('submit', function (e) {
                var selectedValue = $hiddenInput.val();

                // Agar value khali ("") hai ya fir select nahi hui hai
                if (!selectedValue || selectedValue === "") {
                    e.preventDefault(); // Form submit hone se rok dega

                    $errorSpan.show(); // Error text dikhayega
                    $input.css('border-color', '#a94442'); // Input box ka border red kar dega
                    $input.focus(); // Window focus field par le aayega

                    return false;
                } else {
                    $errorSpan.hide();
                }
            });
        });

    </script>
