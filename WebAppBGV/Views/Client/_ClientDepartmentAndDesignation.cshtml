
@{int count = 0; }
@foreach (var item in ViewBag.Departments)
{
    count++;

    <div class="card">
        <div class="card-header" id="headingOne-@item.DepartmentRowID">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-4 text-left">
                        @count.
                        <input type="checkbox" name="department" class="@item.DepartmentRowID" value="@item.DepartmentRowID" />
                        <a class="btn collapsed" data-toggle="collapse" data-target="#panel-@(item.DepartmentRowID)" aria-expanded="false" aria-controls="@item.DepartmentRowID">
                            @item.DepartmentName
                        </a>
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
            </div>
        </div>

        <div id="panel-@item.DepartmentRowID" class="collapse" aria-labelledby="headingOne-@item.DepartmentRowID" data-parent="#accordionExample1">
            <div class="card-body">
                @foreach (var teamlist in ViewBag.TeamMemberList)
                {
                    if (item.DepartmentRowID == teamlist.DepartmentRowID)
                    {
                        <div class="col-md-8 offset-md-1" style="line-height:2em;">
                            <input type="checkbox" class="designation @(item.DepartmentRowID)_@(teamlist.TeamDepartmentRowID)" name="@item.DepartmentRowID" value="@(item.DepartmentRowID)_@(teamlist.TeamDepartmentRowID)" />
                            @teamlist.TeamMemeberName
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    @*<div class="card">
            <div class="card-header dvPnlHeading" role="tab" id="headingOne">
                <div class="dvChkFmlySrNo">@count.</div>
                <div class="ml-4">
                    <input type="checkbox" name="department" class="@item.DepartmentRowID" value="@item.DepartmentRowID" />
                    <a data-toggle="collapse" class="" data-parent="#accordion" href="#@(item.DepartmentRowID)" aria-expanded="false" aria-controls="@item.DepartmentRowID">
                        @item.DepartmentName
                    </a>
                </div>
            </div>
            <div id="@item.DepartmentRowID" class="panel-collapse " role="tabpanel" aria-labelledby="headingOne">
                <div class="card-body">
                    <div class="col-md-11 col-md-offset-1 dvpnlChild">
                        @foreach (var teamlist in ViewBag.TeamMemberList)
                        {
                            if (item.DepartmentRowID == teamlist.DepartmentRowID)
                            {
                                <div class="col-md-4">
                                    <input type="checkbox" class="designation @(item.DepartmentRowID)_@(teamlist.TeamDepartmentRowID)" name="@item.DepartmentRowID" value="@(item.DepartmentRowID)_@(teamlist.TeamDepartmentRowID)" />
                                    @teamlist.TeamMemeberName
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>*@
}
<style>

    .show {
        display: block !important;
    }

    .hide {
        display: none !important;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>$(document).ready(function () {
        const cardIds = ['#panel-1',
            '#panel-2',
            '#panel-6',
            '#panel-5',
            '#panel-7',
            '#panel-8',
            '#panel-9',
            '#panel-10',
            '#panel-11',
            '#panel-3',
            '#panel-4',
            '#panel-13',
            '#panel-14',
            '#panel-15',
            '#panel-16',
            '#panel-17',
            '#panel-19',
            '#panel-20',
            '#panel-21',
            '#panel-23'
        ];

        function toggleCard(cardToToggle) {
            const $targetCard = $(cardToToggle);
            const isAlreadyVisible = $targetCard.hasClass('show');

            // First, hide all cards
            cardIds.forEach(id => {
                $(id).removeClass('show').addClass('hide');
            });

            // If it was not visible before, show it
            if (!isAlreadyVisible) {
                $targetCard.removeClass('hide').addClass('show');
            }
            // If it was already visible, it stays hidden (toggle off)
        }

        $('#headingOne-1').on('click',  () => toggleCard('#panel-1'));
        $('#headingOne-2').on('click', () => toggleCard('#panel-2'));
        $('#headingOne-5').on('click', () => toggleCard('#panel-5'));
        $('#headingOne-6').on('click', () => toggleCard('#panel-6'));
        $('#headingOne-7').on('click', () => toggleCard('#panel-7'));
        $('#headingOne-8').on('click', () => toggleCard('#panel-8'));
        $('#headingOne-9').on('click', () => toggleCard('#panel-9'));
        $('#headingOne-10').on('click',() => toggleCard('#panel-10'));
        $('#headingOne-3').on('click', () => toggleCard('#panel-3'));
        $('#headingOne-4').on('click', () => toggleCard('#panel-4'));
        $('#headingOne-16').on('click',() => toggleCard('#panel-16'));
        $('#headingOne-17').on('click',() => toggleCard('#panel-17'));
        $('#headingOne-19').on('click',() => toggleCard('#panel-19'));
        $('#headingOne-20').on('click',() => toggleCard('#panel-20'));
        $('#headingOne-21').on('click',() => toggleCard('#panel-21'));
        $('#headingOne-23').on('click', () => toggleCard('#panel-23'));
        $('#headingOne-11').on('click', () => toggleCard('#panel-11'));
        $('#headingOne-13').on('click', () => toggleCard('#panel-13'));
        $('#headingOne-14').on('click', () => toggleCard('#panel-14'));
        $('#headingOne-15').on('click', () => toggleCard('#panel-15'));




    });</script>

