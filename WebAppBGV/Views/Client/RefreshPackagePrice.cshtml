

@model ViewModels.ClientViewModel.AddClientPackageViewModel

@{
    Layout = null;

}
<div class="form-group branch row  search-frame">
    @Html.LabelFor(model => model.Price, htmlAttributes: new { @class = "col-md-1 control-label required" })

    <div class="col-md-1">
    @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control" } })
    @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
    </div>
        @Html.LabelFor(model => model.InternalTATPack, htmlAttributes: new { @class = "col-md-1 control-label required" })
        <div class="col-md-1">
            @Html.EditorFor(model => model.InternalTATPack, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.InternalTATPack, "", new { @class = "text-danger" })
        </div>

        @Html.LabelFor(model => model.ExternalTAT, htmlAttributes: new { @class = "col-md-1 control-label required" })
        <div class="col-md-2">
            @Html.EditorFor(model => model.ExternalTAT, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.ExternalTAT, "", new { @class = "text-danger" })
        </div>
        @Html.LabelFor(model => model.IsTATInWorkingDays, htmlAttributes: new { @class = "col-md-2 control-label required" })

        <div class="col-md-3">
            &nbsp;&nbsp;&nbsp;&nbsp;
            @Html.RadioButtonFor(model => model.IsTATInWorkingDays, "1", new { @class = "Working Day", @checked = "checked" })&nbsp;
            Working Day&nbsp;&nbsp;&nbsp;
            @Html.RadioButtonFor(model => model.IsTATInWorkingDays, "0", new { @class = "Calendar days" })&nbsp;
            Calendar days
        </div>
    </div>
