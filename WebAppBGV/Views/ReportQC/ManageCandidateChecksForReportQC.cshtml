
@{
    ViewBag.Title = "Manage ReportQC Manager Checks";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    if (Request.QueryString["dispFor"] != null && Request.QueryString["dispFor"].ToString() == "Manager")
    {
        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "ManageAllCandidateListForReportQCManager", "ReportQC", new { CaseStatus = Session["CaseStatus"].ToString() }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else if (Request.QueryString["dispFor"] != null && Request.QueryString["dispFor"].ToString() == "TeamLeader")
    {
        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "ManageAllCandidateListForReportQCTL", "ReportQC", null, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else if (Request.QueryString["dispFor"] != null && Request.QueryString["dispFor"].ToString() == "TeamMember")
    {
        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "ManageAllCandidateListForReportQCTeamMember", "ReportQC", null, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else
    {
        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "Index", "ReportQC", null, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageCandidateChecksForReportQC", "ReportQC", FormMethod.Get))
                        {
                            if (Request.QueryString["PersonalRowID"] != null)
                            {
                                @Html.Hidden("PersonalRowID", Convert.ToInt32(Request.QueryString["PersonalRowID"]))
                            }
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-4">
                                        @Html.DropDownList("ClientRowID",
                                        new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                        "-- Select Client -- ",
                                        new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-4">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
                                    </div>
                                </div>
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: 50, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "Severity", header: "Severity", canSort: false, style:"td-1"),
                                    grid.Column(columnName: "ColorName", header: "Color Name", canSort: false, style:"td-1"),
                                     grid.Column(columnName: "AllocatedTLName", header: "OPTL Name", canSort: false, style:"td-1"),
                                    grid.Column(columnName: "AllocatedTMName", header: "OPTM Name", canSort: false, style:"td-1"),
                                    grid.Column(columnName: "AllocatedQCName", header: "OPQC Name", canSort: false, style:"td-1"),
                                    grid.Column(header : "Unique Component Id", format : (item) => {
                                        string ComponentID=item.UniqueComponentID;
                                        if (item.CheckFamilyRowID==2 )
                                            {
                                                var link = Html.ActionLink(ComponentID, "UpdateAddressVerInfoByRWQC", "ReportQC", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusId,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID}, new { @class="edit" });
                                            return link;
                                            }
                                         else if (item.CheckFamilyRowID==5 )
                                            {
                                                var link = Html.ActionLink(ComponentID, "UpdateCriminalVerInfoByRWQC", "ReportQC", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusId,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                            return link;
                                            }
                                        else if (item.CheckFamilyRowID==11 )
                                            {
                                                var link = Html.ActionLink(ComponentID, "UpdateEducationVerInfoByRWQC", "ReportQC", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusId,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                            return link;
                                            }
                                        else if (item.CheckFamilyRowID==12 )
                                            {
                                                var link = Html.ActionLink(ComponentID, "UpdateEmploymentVerInfoByRWQC", "ReportQC", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusId,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                            return link;
                                            }
                                         else if (item.CheckFamilyRowID==26 )
                                            {
                                                var link = Html.ActionLink(ComponentID, "UpdateNationalIdentityVerInfoByRWQC", "ReportQC", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusId,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                            return link;
                                            }
                                        else if (item.CheckFamilyRowID==30 )
                                            {
                                                var link = Html.ActionLink(ComponentID, "UpdateReferenceVerInfoByRWQC", "ReportQC", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusId,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                            return link;
                                            }
                                         else if (item.CheckFamilyRowID==40 )
                                            {
                                                var link = Html.ActionLink(ComponentID, "UpdateSpecialCheckVerInfoByRWQC", "ReportQC", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusId,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                            return link;
                                            }
                                        else
                                            {
                                                return ComponentID;
                                            }
                                    }, style:"td-2"),

                                     grid.Column("InternalOutDate", "TAT", format: (item) => item.InternalOutDate != DateTime.MinValue ? item.InternalOutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                     grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:"td-2"),
                                     
                                      grid.Column(header : "Action", format : (item) => {
                                        var link = Html.ActionLink("History", "CheckActionHistory", "Verification", new { scid = item.SubCheckRowID, pe = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement" });
                                        return link;
                                    }, style:"edit td-1"),

                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
}


