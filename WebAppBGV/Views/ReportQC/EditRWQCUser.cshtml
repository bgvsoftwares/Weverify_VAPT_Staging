@model  ViewModels.RwqcTrackerUserDatas
@{
    ViewBag.Title = "Edit RWQC User";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
}

<h2>Edit RWQC User</h2>

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("EditRWQCUser", "ReportQC", FormMethod.Post))
        {
            
                <div class="form-horizontal" style="margin-bottom: 30px; padding: 20px; border: 1px solid #ccc; border-radius: 5px;">
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="form-group">
                        <label class="col-md-2 control-label">Client Name:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(m => Model.ClientName, new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <label class="col-md-2 control-label">Team Member:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(m => Model.RWQC_Teammember, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>

                </div>
                <div class="form-horizontal" style="margin-bottom: 30px; padding: 20px; border: 1px solid #ccc; border-radius: 5px;">


                    <div class="form-group">
                        <label class="col-md-2 control-label">Allocation Percentage:</label>
                        <div class="col-md-4">
                            @Html.TextBoxFor(m => Model.Allocation_Percentage, new { @class = "form-control", type = "number", step = "0.01", @placeholder = "Enter Allocation Percentage" })
                        </div>
                        <label class="col-md-2 control-label">Enable:</label>
                        <div class="col-md-4">
                            @Html.DropDownList("Enable", new SelectList(new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Yes", Value = "1" },
                                new SelectListItem { Text = "No", Value = "0" }
                            }, "Value", "Text", Model.Enable), new { @class = "form-control" })
                        </div>
                    </div>




                </div>

                <div class="form-horizontal" style="margin-bottom: 30px; padding: 20px;">
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-4">
                          <center><input type="submit" value="Update" class="btn btn-primary" /></center>  
                        </div>
                    </div>
                </div>
                    
                    }
                </div>
            </div>
