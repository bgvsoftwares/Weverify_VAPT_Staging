
@model ViewModels.ViewEmpData

@{
    Layout = null;

}
<style>
</style>

<script src="~/Scripts/jquery-ui-1.14.1.js"></script>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/newcss/font-awesome.min.css" rel="stylesheet" />
@*@section LeftNavigation{ @Html.Partial("_NavLeftClientServicingInsuff") }*@


<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AddEmpCodeAndDOJByCSSpoc", "ClientServicing"))
                        {


                            @Html.HiddenFor(model => model.PersonalRowID)





                            <div class="form-group">

                                <label class="control-label col-md-12">EmployeeId :</label>

                                <div class="col-md-12">
                                    @Html.TextAreaFor(model => model.EmployeeID, new { @class = "form-control col-md-12", @rows = "2", @style = "width:100%;" })
                                    @*@Html.TextBox("TxtEmployeeId", null, new { @class = "form-control", placeholder = "EmployeeId..." })*@
                                </div>
                            </div>
                            <div class="form-group branch search-frame">

                                <label class="col-md-12 control-label">DOJ :</label>
                                <div class="col-md-12">

                                    @Html.TextBoxFor(m => m.DateofJoining, new { @class = "form-control col-md-12 col-sm-12", @id = "DateofJoining", @placeholder = "dd-mm-yyyy", @type = "text" })<i class="fa fa-calendar" style="font-size: 33px;
    margin-left: -37px;
    margin-top: 11px;
    position: absolute;
    top: 6px;
    right: 16px;
    top: -13px;"></i>

                                    @*<input type="date" class="form-control col-md-2 col-sm-12 " name="Date Of Birth" placeholder="(DD/MM/YYYY)" style="width:100%; height:40px;">*@

                                </div>

                            </div>
                            <br />
                            <div class="form-group branch search-frame">
                                <div style="text-align:center;">

                                    <input class="btn bun-bg btn-success" type="submit" value="Update" name="Process" />
                                </div>
                            </div>

                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>














}
<script>
    $(function () {

        $("#date_ex").datepicker();


    });

    $("input[type=text]").click(function () {
        $('#DateofJoining').attr('type', 'date');

    });


</script>










}

