@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Manage Candidate List For Report QC Team Member";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "ReportQC", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    string Message = "";
    string FinalCaseStatus = "";
    string version = "";



    FinalCaseStatus = ViewBag.CaseStatus;
    version = ViewBag.version;
    if (Request.QueryString["tatHours"] != null)
    {
        tatHours1 = Request.QueryString["tatHours"].ToString();
    }
    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CaseStatus"] != null)
    {
        CaseStatus1 = @Request.QueryString["CaseStatus"].ToString();
    }
    if (Request.QueryString["Message"] != null)
    {
        Message = @Request.QueryString["Message"].ToString();
    }

    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportAddressMge", "ReportQC", new { CaseStatus = CaseStatus1, tatHours = tatHours1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@*@section LeftNavigation{ @Html.Partial("_NavLeftReportQC") }*@
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @if (Message != "")
                        {
                            <div style="text-align:center;font-size:15px;color:red">@Message  </div>
                        }

                        @using (Html.BeginForm("GetRWQCTeamMemberDashBoardSigleCheck", "ReportQC", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
"-- Select Client -- ",
new { @class = "form-control Keyword1" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control Keyword1", placeholder = "Ex. Enter Candidate name, Securitas Id...", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingDate", null, new { @class = "form-control", @id = "RecievingDate", @placeholder = "dd-MMM-yyyy", @autocomplete = "off" })
                                    </div>
                                    <label class="col-md-2 control-label">To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedDate", null, new { @class = "form-control", @id = "CompletedDate", @placeholder = "dd-MMM-yyyy", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    @{
                                        if (Request.QueryString["CaseStatus"] != null)
                                        {
                                            @Html.Hidden("CaseStatus", Request.QueryString["CaseStatus"].ToString())
                                        }
                                    }

                                    <div style="text-align:center;" class="col-md-12">
                                        <input class="btn bun-bg btn-default" type="submit" onclick="SearchFunction()" value="Search" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.DashboardDetailsRWQC != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.DashboardDetailsRWQC, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table table-striped table-bordered nowrap" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    //grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-3"),

                                  grid.Column(header : "Client Name", format : (item) => {
                                        string ClientName=item.ClientName;
                                       if (item.ClientRowID==317 || item.ClientRowID==327 )
                                         {
                                                var link = Html.ActionLink(ClientName, "ReportInterimWipro", "ReportQC", new { id = item.PersonalRowID,Report_Type=item.Report_Type }, new { @target="_blank",  });
                                             return link;
                                      }
                                       if (item.ClientRowID==607 )
                                         {
                                                 var link = Html.ActionLink(ClientName, "ReportMain", "ReportQC", new { PersonalRowID = item.PersonalRowID,Report_Type=item.Report_Type,ReportPart="CDB",ClientRowId=item.ClientRowid }, new { @target="_blank"});
                                             return link;
                                      }
                                       else  if (item.ClientRowID==1172 )
                                         {
                                                 var link = Html.ActionLink(ClientName, "ReportMain", "ReportQC", new { PersonalRowID = item.PersonalRowID,Report_Type=item.Report_Type,ReportPart="CRC",ClientRowId=item.ClientRowid }, new { @target="_blank"});
                                             return link;
                                      }
                                       else if(item.ClientRowID==1160)
                                      {
                                          var link = Html.ActionLink(ClientName,"ReportMain", "ReportQC", new { PersonalRowID = item.PersonalRowID,Report_Type=item.Report_Type,CaseStatus=CaseStatus1,ClientRowId=item.ClientRowid,ReportStatus="Final",ReportPart="CRC" }, new { @target="_blank", @class="edit"  });
                                            return link;
                                      }
                                         else if(item.ClientRowID==1315)
                                      {
                                          var link = Html.ActionLink(ClientName,"ReportMain", "ReportQC", new { PersonalRowID = item.PersonalRowID,Report_Type=item.Report_Type,CaseStatus=CaseStatus1,ClientRowId=item.ClientRowid,ReportStatus="Interim",ReportPart="CRCNAT" }, new { @target="_blank", @class="edit"  });
                                            return link;
                                      }
                                         else if(item.ClientRowID==787)
                                      {
                                          var link = Html.ActionLink(ClientName,"ReportMain", "ReportQC", new { PersonalRowID = item.PersonalRowID,Report_Type=item.Report_Type,CaseStatus=CaseStatus1,ClientRowId=item.ClientRowid,ReportStatus="Final",ReportPart="UAN" }, new { @target="_blank", @class="edit"  });
                                            return link;
                                      }
                                      else
                                      {
                                          return ClientName;
                                      }
                                        //return "";
                                    }),


                                    grid.Column(header : "Securitas ID", format : (item) => {
                                        string CompanyRefNo=item.CompanyRefNo;
                                                var link = Html.ActionLink(CompanyRefNo, "ManageCandidateChecksForReportQCTM", "ReportQC", new { PersonalRowID = item.PersonalRowID, dispFor="TeamMember"  }, new {@class="edit"  });
                                             return link;
                                    }),
                                    grid.Column(header : "Interim", format : (item) => {


                                         var link = Html.ActionLink("Report","ReportMain", "ReportQC", new { PersonalRowID = item.PersonalRowID,Report_Type=item.Report_Type,CaseStatus=CaseStatus1,ClientRowId=item.ClientRowid,ReportStatus="Final" }, new { @target="_blank", @class="edit"  });
                                            return link;

                                    }),
                                    grid.Column(header : "InterimCompress", format : (item) => {
                                        var link = Html.ActionLink("CompressReport","CompressReportMain", "ReportQC", new { PersonalRowID = item.PersonalRowID,Report_Type=item.Report_Type,CaseStatus=CaseStatus1,ClientRowId=item.ClientRowid,ReportStatus="Final" }, new { @target="_blank", @class="edit"  });
                                        return link;
                                    }),
                                     grid.Column("Report", canSort: false, format: (item)=> {
                                        if (item.IsReportUploaded && !string.IsNullOrEmpty(item.ReportUploadedName))
                                        {
                                            string FldPathDoc = System.Configuration.ConfigurationManager.AppSettings["CandidateReportdoc"].ToString();
                                             string DownloadLink = string.Format("<a class='edit' href=\"{0}\" target=\"_blank\">Download</a>",Url.Content(FldPathDoc + item.ReportUploadedName));
                                             return new HtmlString(DownloadLink);
                                        }
                                            return null;
                                    }),
                                        grid.Column(header : "Cand Name", format : (item) => {
                                          string CandName=item.CandidateName;
                                           if (item.ClientRowID == 268)
                                         {

                                              string FldPathDoc = System.Configuration.ConfigurationManager.AppSettings["TCSFinalReport"].ToString();
                                              string rtnLink = string.Format("<a class='edit' href=\"{0}\" target=\"_blank\">"+CandName+"</a>",Url.Content(FldPathDoc + item.CompanyRefNo));
                                             return new HtmlString(rtnLink);
                                         }
                                         else
                                         {
                                           return CandName;
                                         }


                                    }),
                                    grid.Column(columnName: "SpocName", header: "Spoc Name", canSort: false),
                                    grid.Column(columnName: "Caseageing", header: "Case Ageing", canSort: false),
                                    grid.Column(columnName: "Applicantid", header: "Applicant ID", canSort: false),
                                    //grid.Column(columnName: "Location", header: "Location", canSort: false),
                                    grid.Column(columnName: "Package", header: "Package", canSort: false, style:"word-break:break-all;"),
                                    //grid.Column(columnName: "Category", header: "Category", canSort: false),
                                    //grid.Column("CreatedDate", "Created-Date", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd-MMM-yyyy") : "", canSort: false),
                                    grid.Column(columnName: "CaseStatus", header: "Status", canSort: false),
                                    grid.Column(columnName: "AllocatedTmem", header: "Allocated To", canSort: false),
                                    grid.Column(columnName: "Remark", header: "Spoc Remark", canSort: false),
                                   grid.Column(header : "Action", format : (item) =>
                                    {
                                        var link = Html.ActionLink("History", "CaseActionHistories", "ReportQC", new { pid = item.PersonalRowID }, new { @class = "edit iframeActionHistories cboxElement" });
                                        return link;
                                    }),

                                     grid.Column(header : "Report History", format : (item) =>
                                    {
                                        var link = Html.ActionLink("History", "CaseReportHistories", "ReportQC", new { pid = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement" });
                                        return link;
                                    }),
                                       grid.Column(header : "Candidate Details", format : (item) => {
                                            var linkPerInfo = Html.ActionLink("Show", "PersonalInformation", "ClientServicing", new { PersonalRowID=clsCommonMethods.PEncrypt(item.PersonalRowID.ToString()) }, new {@class = "#" });
                                            return linkPerInfo;
                                        }),

                            grid.Column(header : "Map", format : (item) => {
                                                var link = Html.ActionLink("Artifacts", "UpdateReportArtifactsCaseDocByRWQCTM", "ReportQC", new { Pid = item.PersonalRowID}, new { @class="edit iframeRptArtifactCaseDoc cboxElement" });
                                            return link;
                                    }),
                            grid.Column(header : "Update Personal Info", format : (item) => {
                                                    if(CaseStatus1!="Closed"){
                                                var link = Html.ActionLink("Update", "UpdateCandidateDetails", "ReportQC", new { id = item.PersonalRowID,CaseStatus=CaseStatus1}, new { @class="edit" });
                                            return link; }
                                else
                                {
                                    return null;
                                }


                                    }),
                             grid.Column(header : "Report Edit", format : (item) => {
                                                if(CaseStatus1!="Closed"){
                                                var link = Html.ActionLink("Edit/Update", "UpdateAllChecksDetails", "ReportQC", new { id = item.PersonalRowID,CaseStatus = CaseStatus1,version=version}, new { @class="edit" });
                                            return link;
                                 }
                                                else
                                 {
                                     return null;
                                 }

                                    }),
                             grid.Column(header : "Scop Edit", format : (item) => {
                                                if(CaseStatus1!="Closed"){
                                                var link = Html.ActionLink("Update", "UpdateScopOfVerificationDetails", "ReportQC", new { id = item.PersonalRowID,CaseStatus = CaseStatus1,version=version}, new { @class="edit" });
                                            return link;
                                 }
                                 else
                                 {
                                     return null;
                                 }

                                    }),

                                    grid.Column(header : "Gap Details", format : (item) => {
                                        if(item.ClientRowID==1219 )
                                          {
                                             var link=@Html.ActionLink("Comperative", "Comperative_Tiger", "Verification", new {PersonalRowID=item.PersonalRowID }, new {@class = "Remindermail  callbacks"});
                                             return link;
                                          }
                                        else if((item.ClientRowID==317 || item.ClientRowID==327))
                                        {
                                               var link = Html.ActionLink("WiproGapDetails", "WiproGapDetails", "ReportQC", new { personalRowid = item.PersonalRowID}, new { @class="edit" });
                                            return link;
                                        }
                                        return null;

                                    })

                                }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
        <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
        <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
        <link href="~/Content/colorbox.css" rel="stylesheet" />
        <script src="~/Scripts/jquery.colorbox-min.js"></script>*@

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            $(".iframeRptArtifactCaseDoc").colorbox({ iframe: true, width: "80%", height: "65%" });
            $(".Remindermail").colorbox({ iframe: true, width: "80%", height: "100%" });
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });

            $('#RecievingDate').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                //showButtonPanel: true,
                yearRange: "-66:+0",
            });
            $('#CompletedDate').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}

<script>
    $(document).ready(function () {
        var table = $('#grid').DataTable({
            responsive: true,
        });

        new $.fn.dataTable.FixedHeader(table);
    });
</script>
<style>
    @@media screen and (max-width: 1450px) and (min-width: 600px) {
        #grid {
            font-size: .90rem;
            width: 80%;
        }

        .table td, .table th {
            padding: .55rem !important;
        }

        .thead-inverse {
            font-size: .90rem !important;
        }

        table, td, .edit {
            font-size: .95rem !important;
        }
    }
</style>