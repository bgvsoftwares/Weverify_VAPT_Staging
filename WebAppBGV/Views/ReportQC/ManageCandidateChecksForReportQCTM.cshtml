@using WebAppBGV.CommonMethods;
@{   
    string CheckStatus1 = "";
    string Designation = "";
    var ClientRowID1 = "";

    if (Session["Designation"] != null)
    {
        Designation = Session["Designation"].ToString();

    }
    if (Request.QueryString["cr"] != null)
    {
        ClientRowID1 = @Request.QueryString["cr"].ToString();
    }
    else
    {
        ClientRowID1 = "0";
    }
    ViewBag.Title = "Manage ReportQC Manager Checks";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    var CaseStatus1 = "";
    if (Session["CaseStatus"] !=null)
    {
        CaseStatus1 = Session["CaseStatus"].ToString();
    }
    short teamMemerRowId = 0;
    short clientid = 0;

    if (CaseStatus1 != "")
    {
        if (Designation == "Team Leader-CS" || Designation == "Team Member-CS")
        {
            if (@ViewBag.CaseStatus == "Funds Pending")
            {
                string hyperLink = Html.ActionLink("linkTitle", "ManageFundApprovelforSpoc", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus, teamMemerRowId = Convert.ToInt16(Session["TeamMemberRowID"]), cr = clsCommonMethods.PEncrypt(Session["cr"].ToString()) }, new { @class = "headerbacklink" }).ToString();
                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else if (@ViewBag.CaseStatus == "Completed")
            {
                string hyperLink = Html.ActionLink("linkTitle", "ClientServicingDashboardInfo", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus, teamMemerRowId = Convert.ToInt16(Session["TeamMemberRowID"]), cr = clsCommonMethods.PEncrypt(Session["cr"].ToString()) }, new { @class = "headerbacklink" }).ToString();
                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else if (@ViewBag.CaseStatus == "WIP")
            {
                string hyperLink = Html.ActionLink("linkTitle", "ClientServicingDashboardInfo", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus, teamMemerRowId = Convert.ToInt16(Session["TeamMemberRowID"]), cr = clsCommonMethods.PEncrypt(Session["cr"].ToString()) }, new { @class = "headerbacklink" }).ToString();
                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else if (@ViewBag.CaseStatus == "HRPending")
            {
                string hyperLink = Html.ActionLink("linkTitle", "ClientServicingDashboardInfo", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus, teamMemerRowId = Convert.ToInt16(Session["TeamMemberRowID"]), cr = clsCommonMethods.PEncrypt(Session["cr"].ToString()) }, new { @class = "headerbacklink" }).ToString();
                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else if (@ViewBag.CaseStatus == "Pendingcandidate")
            {
                string hyperLink = Html.ActionLink("linkTitle", "ClientServicingDashboardInfo", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus, teamMemerRowId = Convert.ToInt16(Session["TeamMemberRowID"]), cr = clsCommonMethods.PEncrypt(Session["cr"].ToString()) }, new { @class = "headerbacklink" }).ToString();
                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else if (@ViewBag.CaseStatus == "Insufficient")
            {
                string hyperLink = Html.ActionLink("linkTitle", "ClientServicingDashboardInfo", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus, teamMemerRowId = Convert.ToInt16(Session["TeamMemberRowID"]), cr = clsCommonMethods.PEncrypt(Session["cr"].ToString()) }, new { @class = "headerbacklink" }).ToString();
                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else if (@ViewBag.CaseStatus == "YTR Hold")
            {
                string hyperLink = Html.ActionLink("linkTitle", "ClientServicingDashboardInfo", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus, teamMemerRowId = Convert.ToInt16(Session["TeamMemberRowID"]), cr = clsCommonMethods.PEncrypt(Session["cr"].ToString()) }, new { @class = "headerbacklink" }).ToString();
                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else if (@ViewBag.CaseStatus == "ColorCodeReview")
