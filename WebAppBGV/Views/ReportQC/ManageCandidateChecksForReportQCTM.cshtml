                            return null;
                        }, style:"td-1" ),
                        grid.Column("UAN", canSort: false, format: (item)=> {
                            if ((item.ClientRowID==317  || item.ClientRowID==327) && ( item.CheckFamilyRowID==12) && item.ColorName=="DRAFT")
                            {
                                var link=@Html.ActionLink("UAN", "WiproUANValidation", "Verification", new {PersonalRowID=item.PersonalRowID }, new {@class = "Remindermail  callbacks"});
                                return link;
                            }
                            return null;
                        }, style:"td-1" ),
                        
                                grid.Column(
                                    header: "Send Mail for Insuff",
                                    format: (item) =>
                                    {
                                        if (@ViewBag.CaseStatus != "Insufficient") 
                                        {
                                            return Html.Raw("");        // hide column content
                                        }
                                        return Html.Raw(
                                            "<input type='checkbox' onchange='CheckMailSend(this)' class='chkRowInsuff' " +
                                            "data-personalrowid='" + item.PersonalRowID + "' " +
                                            "data-subcheckid='" + item.SubCheckRowID + "' " +
                                            "data-checkstatusid='" + item.CheckStatusId + "' " +
                                            "data-checkfamilyrowid='" + item.CheckFamilyRowID + "' " +
                                            "data-clientrowid='" + item.ClientRowID + "' " +
                                            "data-candcheckrowid='" + item.VerificationRowID + "' " +
                                            "value='" + item.PersonalRowID + "' />"
                                        );
                                    },
                                    canSort: false,
                                    style: "5rem !important"
                                )                           

                        }
                        )
                        <div class="total-record">Total Records: @Model.TotalRecords</div>
                    </div>
                </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
<script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
<script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<link href="~/Content/colorbox.css" rel="stylesheet" />
<script src="~/Scripts/jquery.colorbox-min.js"></script>
<script>
    $(document).ready(function () {
        $(".Remindermail").colorbox({ iframe: true, width: "80%", height: "100%" });
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
        $(".iframeRptArtifactDoc").colorbox({ iframe: true, width: "80%", height: "70%" });

        // Start by Anil for Insuff Mail
        $(".chkRowInsuff").each(function () {
            var CheckStatusid = $(this).attr("data-CheckStatusid");   // read condition            
            if (CheckStatusid == 11 || CheckStatusid == 22) {
                $(this).prop("disabled", false);    // disable checkbox
            } else {
                $(this).prop("disabled", true);   // enable checkbox
            }
        });
        // End by Anil for Insuff Mail
    });    
        
        $(".Complete").on("click", function () {
            var str = $(this).attr("id");
            var Subcheckid = $(this).attr("Subcheckid");


            var flag = confirm('Are you sure to delete the check?');
            if (str != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteCheck", "ReportQC")',
                    data: { "id": str, "Subcheckid": Subcheckid },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Check delete Successfully!");
                           // "ManageCandidateChecksForReportQCTM", new { PersonalRowID = id });
                            setTimeout(function () { window.location.replace("ManageCandidateChecksForReportQCTM?PersonalRowID=" + str); }, 500);
                            //setTimeout(function () { window.location.replace("ManageClientLogin"); }, 500);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });

    $("#btnMailsend").on("click", function () {
        var personalRowid = 0; //1698887;        
        var Subcheckid = 0;//56;        
        var ClientRowID = 0; //684;
        var CheckRowID = 0;
        var CheckFamilyRowID = 0; //11;
        var clientuserRowId = 0; //4890;
        var CheckStatusId = 0; //11;
        var candcheckrowid = 0;

        var selected = [];

        $(".chkRowInsuff:checked").each(function () {
            personalRowid = $(this).data("personalrowid");
            Subcheckid = $(this).data("subcheckid");
            CheckStatusId = $(this).data("checkstatusid");
            CheckFamilyRowID = $(this).data("checkfamilyrowid");
            ClientRowID = $(this).data("clientrowid");
            candcheckrowid = $(this).data("candcheckrowid");            
            // push both values
            selected.push({
                personalRowid: personalRowid,
                subcheckid: Subcheckid,
                CheckFamilyRowID: CheckFamilyRowID,
                CheckStatusId: CheckStatusId,
                ClientRowID: ClientRowID,
                candcheckrowid: candcheckrowid
            });
            console.log(selected);   // test output          
            var flag = confirm('Are you sure to send mail the check for insuff?');                       
            if (personalRowid > 0 && flag) {                
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("SendMailInsuffClear", "ReportQC")',
                    data: { "personalRowid": personalRowid, "SubCheckRowID": Subcheckid, "ClientRowID": ClientRowID, "CheckRowID": CheckRowID, "CheckFamilyRowID": CheckFamilyRowID, "clientuserRowId": clientuserRowId, "CheckStatusId": CheckStatusId, "candcheckrowid": candcheckrowid },
                               

                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Mail has been Sent successfully!!!");                            
                            //setTimeout(function () { window.location.replace("ManageCandidateChecksForReportQCTM?PersonalRowID=" + personalRowid); }, 500);
                          
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });
        if (selected.length <= 0) {
            alert('Please select at least one checkbox of Send Mail for Insuff ');
            return;
        }
    });
</script>
<script type="text/javascript">

    function adchange(ChkData)
    {

        var id = ChkData.id;
        var checkeds = ChkData.checked;
        var subCheckid = ChkData.name;
        var flag = "";
        if (ChkData.checked == true) {
            flag = confirm('Are you sure to Enable this Record ?');
        }
        if (ChkData.checked == false)
        {
            flag = confirm('Are you sure to Disable this Record ?');
        }
        if (id != "" && flag)
        {
            $.ajax({
                type: "GET",
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("ClientReportCheckActive", "ClientServicing")',
                data: { "id": id, "checkeds": checkeds, "scheckid": subCheckid },
                dataType: "json",
                beforeSend: function () { },
                success: function (data) {
                    if (data.result == true) {
                        alert("Record Update Successfully!!");
                        setTimeout(function () { window.location.replace("ManageCandidateChecksForReportQCTM"); }, 500);
                    }
                    else {
                        alert('There is some error');
                    }
                }
            });
        }
        else {
            if (ChkData.checked == false) {
                ChkData.checked = true;
            }
            else {
                ChkData.checked = false;
            }
        }
    } 

</script>

