                ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
            }
            else
            {
                if (ViewBag.BackPageUrl != "" && ViewBag.BackPageUrl != null)
                {
                    if (ViewBag.BackPageUrl == "ManageAddressInsuffForCSSpoc")
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageAddressInsuffForCSSpoc", "ClientServicing",new {ClientRowID= clsCommonMethods.PEncrypt(ClientRowID1) }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                    if (ViewBag.BackPageUrl == "ManageEmploymentInsuffForCSSpoc")
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageEmploymentInsuffForCSSpoc", "ClientServicing", new { ClientRowID = clsCommonMethods.PEncrypt(ClientRowID1) }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                    if (ViewBag.BackPageUrl == "ManageEducationInsuffForCSSpoc")
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageEducationInsuffForCSSpoc", "ClientServicing", new { ClientRowID = clsCommonMethods.PEncrypt(ClientRowID1) }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                    if (ViewBag.BackPageUrl == "ManageCriminalInsuffForCSSpoc")
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageCriminalInsuffForCSSpoc", "ClientServicing", new { ClientRowID = clsCommonMethods.PEncrypt(ClientRowID1) }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                    if (ViewBag.BackPageUrl == "ManageNationalIdentityInsuffForCSSpoc")
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageNationalIdentityInsuffForCSSpoc", "ClientServicing", new { ClientRowID = clsCommonMethods.PEncrypt(ClientRowID1) }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                    if (ViewBag.BackPageUrl == "ManageReferenceInsuffForCSSpoc")
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageReferenceInsuffForCSSpoc", "ClientServicing", new { ClientRowID = clsCommonMethods.PEncrypt(ClientRowID1) }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                    if (ViewBag.BackPageUrl == "ManageSpecialCheckInsuffForCSSpoc")
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageSpecialCheckInsuffForCSSpoc", "ClientServicing", new { ClientRowID = clsCommonMethods.PEncrypt(ClientRowID1) }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                }
                else
                {
                    if (Designation.Contains("Leader") || Designation.Contains("Manager"))
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "ManageAddressInsuffForCSSpoc", "ClientServicing", new { CaseStatus = @ViewBag.CaseStatus }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                    else
                    {
                        string hyperLink = Html.ActionLink("linkTitle", "GetRWQCTeamMemberDashBoardInfo", "ReportQC", new { CaseStatus = @ViewBag.CaseStatus }, new { @class = "headerbacklink" }).ToString();
                        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
                    }
                }
            }
        }
    }
    else
    {

    }

    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportCheckExcel", "ReportQC", new { CaseStatus = CaseStatus1, PersonalRowID = ViewBag.PersonalRowID, ClientRowId = ViewBag.ClientRowId, SubCheckRowID = ViewBag.SubCheckRowID }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}
@section NavigationButton{ @Html.Partial("_NavigationButton")}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageCandidateChecksForReportQCTM", "ReportQC", FormMethod.Get))
