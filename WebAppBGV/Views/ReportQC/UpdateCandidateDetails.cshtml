    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script type="text/javascript">
        $(function () {
            //Bind Candidate code
            $('#CaseType').change(function () {
                if ($("#CaseType").val() == "Normal") {
                    GetClientTAT();
                    var tat= $('#hdnTAT').val();
                    $('#TAT').val(tat);
                    $('#TAT').attr("readonly",true);
                }
                if ($("#CaseType").val() == "Priority") {
                    $('#TAT').val(0);
                    $('#TAT').attr("readonly", false);
                }
            });
        });

        function GetClientTAT()
        {
            var url = "/ProvidedInfo/GetClientTATByCandidateId/" + $("#PersonalRowID").val();
            $.ajax({
                url: url,
                type: 'GET',
                async: false,
                dataType: 'json',
                success: function (tat) {
                    $('#hdnTAT').val(tat);
                }
            });
        }

        function validateForm() {
            var ClientRowID = $('#ClientRowID').val();
            if (ClientRowID == 607) { // Concentrix Daksh Services India Private Limited
                var EmpId = $("#EmployeeID").val();
                var POJ = $("#PlaceofJoining").val();
                var ProcessName = $("#ProcessName").val();
                if (EmpId == "") {
                    alert("Please fill Employee Id!!!");
                    $("#EmployeeID").focus();
                    return false;
                }

                if (POJ == "") {
                    alert("Please fill Place of Joining!!!");
                    $("#PlaceofJoining").focus();
                    return false;
                }

                if (ProcessName == "") {
                    alert("Please fill Process Name!!!");
                    $("#ProcessName").focus();
                    return false;
                }

            }

            if (ClientRowID == 446) {// Tech Mahindra Limited
                var EmpId = $("#EmployeeID").val();
                var POJ = $("#PlaceofJoining").val();
                var ProcessName = $("#ProcessName").val();
                if (EmpId == "") {
                    alert("Please fill Employee Id!!!");
                    $("#EmployeeID").focus();
                    return false;
                }

                if (POJ == "") {
                    alert("Please fill Place of Joining!!!");
                    $("#PlaceofJoining").focus();
                    return false;
                }

            }

            if (ClientRowID == 535) { // Muthoot Microfin Ltd
                var EmpId = $("#EmployeeID").val();
                var POJ = $("#PlaceofJoining").val();
                var ProcessName = $("#ProcessName").val();
                if (EmpId == "") {
                    alert("Please fill Employee Id!!!");
                    $("#EmployeeID").focus();
                    return false;
                }
            }

            if (ClientRowID == 722) { // Muthoot Microfin Ltd
                var EmpId = $("#EmployeeID").val();
                var ProcessName = $("#ProcessName").val();
                var COESDO  = $("#BusinessName").val();
                if (EmpId == "") {
                    alert("OHR ID/ Taleo ID!!!");
                    $("#EmployeeID").focus();
                    return false;
                }

                if (ProcessName == "") {
                    alert("plesae fill Process ID !!!");
                    $("#ProcessName").focus();
                    return false;
                }

                if (COESDO == "") {
                    alert("please fill COE/SDO !!!");
                    $("#BusinessName").focus();
                    return false;
                }

                if ($("#ddlGenBand").val() == "-- Select --")
                {
                    alert("please select Band !!!");
                    $("#ddlGenBand").focus();
                    return false;
                }
            }

            if (ClientRowID == 649) {// Ageas Federal Life Insurance Company Limited
                var EmpId = $("#EmployeeID").val();

                if (EmpId == "") {
                    alert("Please fill Employee Id!!!");
                    $("#EmployeeID").focus();
                    return false;
                }
            }

            var dob = $('#DOB').val();
            var doj = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';

            if (dob != '') {
                var str = dob.split('-');
                var dojday1 = str[2];
                var dojmonth1 = str[1];
                var dojyear1 = str[0];

                var dateOfBorth = new Date(dojyear1, dojmonth1 - 1, dojday1);

                var str1 = doj.split('-');
                var day = str1[2];
                var month = str1[1];
                var year = str1[0];

                var DateOfJoin = new Date(year, month - 1, day)

                var timeDiff = DateOfJoin - dateOfBorth;

                var diffDays = timeDiff / (1000 * 3600 * 24 * 365);
                var age = parseInt(diffDays);

                if (age < 18) {
                    alert("Age should be more than 18 years. from date of joining!");
                    return false;
                }
            }

            if ($("#CaseType").val() == "Priority") {
                GetClientTAT();
                var tat=$("#TAT").val();
                var hdtat = $("#hdnTAT").val();
                if (parseInt(tat)==0 || parseInt(tat) >= parseInt(hdtat)) {
                    alert("Please enter valid TAT!");
                    return false;
                }
            }

            var count = 0;
            if ($("#AadhaarCardNo").val() != '') {
                count += 1;
            }
            if ($("#DrivingLicenseNo").val() != '') {
                count += 1;
            }
            if ($("#PassportNo").val() != '') {
                count += 1;
            }
            if ($("#PanCardNo").val() != '') {
                count += 1;
            }
            if ($("#VoterIDCardNo").val() != '') {
                count += 1;
            }
            if (count == 0) {
                alert("Please enter atleast one document no details!");
                return false;
            }

            return true;
        }
    </script>

    <script type="text/javascript">
        $(document).ready(function () {

            $('#DateofJoining').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+00",
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });

            var start = new Date();
            start.setFullYear(start.getFullYear() - 60);
            var end = new Date();
            end.setFullYear(end.getFullYear() - 18);

            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                minDate: start,
                maxDate: end,
                //yearRange: "-66:-10",
                yearRange: start.getFullYear() + ':' + end.getFullYear(),
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });


            var ClientRowID = $('#ClientRowID').val();
            if (ClientRowID == 249) {
                $("#EmployeeID").attr('maxlength', '6');
                $("#EmployeeID").keypress(function (event) {
                    // Allow only backspace and delete
                    if (event.keyCode == 46 || event.keyCode == 8) {
                        // let it happen, don't do anything
                    }
                    else {
                        // Ensure that it is a number and stop the keypress
                        if (event.keyCode < 48 || event.keyCode > 57) {
                            event.preventDefault();
                        }
                    }
                });
            }
            else {
                $("#EmployeeID").attr('maxlength', '50');
                $('#EmployeeID').unbind("keypress");
            }
        });
    </script>
}