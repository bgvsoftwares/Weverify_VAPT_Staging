@section ReportPersonalInfo{ @Html.Partial("_ReportPersonalInfo") }
@*@section ReportFinalPersonalInfo{ @Html.Partial("_ReportFinalPersonalInfo") }*@
@if (Model.ClientRowID != 317 && Model.ClientRowID != 327)
{
    @section ReportChecksShortInfo{ @Html.Partial("_ReportChecksShortInfo") }
}
@*@section ReportFinalChecksShortInfo{ @Html.Partial("_ReportFinalChecksShortInfo") }*@

 if (Model.ReportTemplate == 6)//TCSBPO
