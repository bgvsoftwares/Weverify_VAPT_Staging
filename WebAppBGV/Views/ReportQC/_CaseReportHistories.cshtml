<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />

<link href="~/Content/admin.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<table width="100% ">
    <tr>
        <td class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> Report History :</td>
    </tr>
    <tr>
        <td height="2"></td>
    </tr>
    <tr>
        <td valign="top">
            @if (ViewBag.ReportHistories != null && ViewBag.ReportHistories.Count > 0)
            {
                <table class="table">
                    <thead class="thead-inverse">
                        <tr>
                            <th class="top-head" style="display:none;">ReportId</th>
                            <th class="top-head" style="display:none;">PersonalRowID</th>
                            <th class="top-head" style="display:none;">ClientRowID</th>
                            <th class="top-head">CompanyRefNo</th>
                            <th class="top-head">ReportType</th>
                            <th class="top-head">UploadedBy</th>
                            <th class="top-head">ReportColor</th>
                            <th class="top-head">UploadedDate</th>
                            <th class="top-head">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.ReportHistories)
                        {
                            <tr>
                                <th class="name" style="display:none;">@item.ReportId</th>
                                <th class="name" style="display:none;">@item.PersonalRowID</th>
                                <th class="name" style="display:none;">@item.ClientRowID</th>
                                <th class="name">@item.CompanyRefNo</th>
                                <th class="name">@item.ReportType</th>
                                <th class="name">@item.UploadedBy</th>
                                <th class="name">@item.ReportColor</th>
                                <td class="name">@item.UploadedDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                                <th class="name"><span><a href="@item.url">Download</a></span></th>

                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="errormsg">No Action Performed!</div>
            }
        </td>
    </tr>
</table>
