
@model ViewModels.VerificationViewModel.WiproGapCheck

@{
    ViewBag.Title = "WiproGapDetails";
}

<h2>WiproGapDetails</h2>
@{ 
    if (ViewBag.ErrMess != null)
    {
        <h5 style="color:red;">@ViewBag.ErrMess</h5>
    }
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal my-3">

        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.GapType, htmlAttributes: new { @class = "control-label col-md-2", style = "font-size:14px" })
            <div class="col-md-10 form-select py-3">
                @Html.DropDownListFor(model => model.GapType,
               new List <SelectListItem > {
                    new SelectListItem { Text = "Gap 1" , Value = "1" } ,
                    new SelectListItem { Text = "Gap 2" , Value = "2" },
                    new SelectListItem { Text = "Gap 3" , Value = "3" },
                    new SelectListItem { Text = "Gap 4" , Value = "4" },
                    new SelectListItem { Text = "Gap 5" , Value = "5" },
                    new SelectListItem { Text = "Gap 6" , Value = "6" },
                    new SelectListItem { Text = "Gap 7" , Value = "7" },
                    new SelectListItem { Text = "Gap 8" , Value = "8" },
                    new SelectListItem { Text = "Gap 9" , Value = "9" }
                 },
               new { @class="myselect"})
                @Html.ValidationMessageFor(model => model.GapType, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="container-fluid">
            <div class="row d-flex justify-content-between">
                <div class="col-md-5">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.LabelFor(model => model.GapFrom, htmlAttributes: new { @class = "control-label col-md-2", style = "font-size:14px" })
                        <div>
                            @Html.EditorFor(model => model.GapFrom, new { htmlAttributes = new { @class = "form-control py-2 ", required = "required", style = "font-size:13px" } })
                            @Html.ValidationMessageFor(model => model.GapFrom, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        @Html.LabelFor(model => model.GapTo, htmlAttributes: new { @class = "control-label col-md-2", style = "font-size:14px " })
                        <div>
                            @Html.EditorFor(model => model.GapTo, new { htmlAttributes = new { @class = "form-control py-2", required = "required", style = "font-size:13px" } })
                            @Html.ValidationMessageFor(model => model.GapTo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                
            </div>
        </div>






