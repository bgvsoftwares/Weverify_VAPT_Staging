@model dynamic


@{
    string Designation = "";


    if (Session["Designation"] != null)
    {
        Designation = Session["Designation"].ToString();
        //ViewBag.Title = "Add Employment Info (" + Convert.ToString(Session["CandidateName"]) + ")";
    }//



    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CheckStatusid = "";
    string ReportComment = "";

    PersonalRowid = ViewBag.PersonalRowid;
    SubCheckId = ViewBag.SubCheckId;
    clientRowId = ViewBag.clientRowId;
    CheckStatusid = ViewBag.CheckStatusid;
    ReportComment = ViewBag.ReportComment;

    string DesignationName = Convert.ToString(Session["Designation"]);
    string hyperLink = string.Empty;
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    if (DesignationName == "Team Member Quality Check")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageCandidateChecksForReportQCTM", "ReportQC", new { PersonalRowID = PersonalRowid, dispFor = "" }, new { @class = "headerbacklink" }).ToString();

        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else if (DesignationName == "Team Leader-DE")
    {
        if (Request.QueryString["window"] == "TLDE")
        {
            hyperLink = Html.ActionLink("linkTitle", "ManageCandidateChecksForReportQCTM", "ProvidedInfo", new { PersonalRowID = PersonalRowid, dispFor = "TeamMember" }, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
    }
    else if (DesignationName == "Manager-CS")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageCandidateChecksForReportQCTM", "ReportQC", new { PersonalRowID = PersonalRowid, dispFor = "TeamMember" }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }

    int SeverityRowID = 0;
    string ColorCode = "";
    string SeverityGrid = "";



    SeverityRowID = ViewBag.SeverityRowID;
    ColorCode = ViewBag.ColorCode;
    SeverityGrid = ViewBag.SeverityGrid;
}

