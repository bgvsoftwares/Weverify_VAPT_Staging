<script>
    function UploadReport(pid, Cid) {
        debugger;
        var Status = $('#status_' + pid).val();
        var ColorCode = $('#ColorCode_' + pid).val();
        var file = $('#file_' + pid).val();
        if (Status == "")
        {
            alert("Please select report type")
            return false;
        }
        if (ColorCode == "") {
            alert("Please select color code type")
            return false;
        }
        if (file == "") {
            alert("Please update report file")
            return false;
        }

        //$("body").addClass("submit-progress-bg");
        //// Wrap in setTimeout so the UI can update the spinners
        //$(".submit-progress").removeClass("hidden");
        ////submit the form.
        //setTimeout(function () {
        //    $("form").submit();
        //}, 1);
        var formData = new FormData();
        formData.append("Fid", $('#file_' + pid)[0].files[0]);
        formData.append("Ccode", $('#ColorCode_' + pid).val());
        formData.append("Rid", $('#status_' + pid).val());
        formData.append("Pid", pid);
        formData.append("Cid", Cid);
        $(".submit-progress").css("display", "flex");
            $.ajax({
                url: '@Url.Action("UploadReport", "ReportQC")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success == true) {
                        $(".submit-progress").css("display", "none");
                        Swal.fire({
                            title: "Success",
                            text: "Report Uploaded Successfully",
                            icon: "success"
                        });
                        location.reload();
                    }
                    else {
                        $(".submit-progress").css("display", "none");
                        Swal.fire({
                            title: "Failed",
                            text: response.message,
                            icon: "failed"
                        });
                    }

                },
                error: function (xhr, status, error) {

                    alert('Error uploading file: ' + error);
                }
            });
    }

</script>
