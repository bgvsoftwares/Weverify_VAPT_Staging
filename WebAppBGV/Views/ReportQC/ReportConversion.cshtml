@{
    ViewData["Title"] = "Premium PDF to Word Converter";
}

<!-- Custom Premium CSS Styling -->
<style>
    /* Premium Glassmorphism Container styling */
    .premium-card-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 160px); /* Existing header/footer spacing adjustment */
        padding: 2rem 1rem;
    }

    /* Futuristic Glowing Card */
    .premium-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 24px;
        padding: 3px; /* Space for the gradient border */
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        width: 100%;
        max-width: 450px;
    }

    /* Animated Gradient Border Layer */
    .premium-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: conic-gradient(from 0deg, transparent, #3b82f6, #8b5cf6, #ec4899, transparent);
        animation: rotateBorder 6s linear infinite;
        z-index: 1;
    }

    .card-inner {
        background: #0b0f19;
        border-radius: 22px;
        padding: 2.5rem;
        position: relative;
        z-index: 2;
    }

    @@keyframes rotateBorder {
        100% { transform: rotate(360deg); }
    }

    /* Modern Glass Drag & Drop Zone */
    .upload-zone {
        border: 2px dashed rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.02);
        border-radius: 16px;
        padding: 2.5rem 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .upload-zone:hover {
        border-color: #a855f7;
        background: rgba(168, 85, 247, 0.05);
        transform: translateY(-2px);
    }

    /* Hidden Native Input */
    .hidden-input {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }

    /* Cyberpunk Styled Button */
    .btn-gradient {
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);
        border: none;
        color: white;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 14px;
        border-radius: 12px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
    }

    .btn-gradient:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(236, 72, 153, 0.6);
        filter: brightness(1.1);
    }

    .btn-gradient:disabled {
        background: #334155;
        box-shadow: none;
        cursor: not-allowed;
    }

    /* Glow Text */
    .glow-text {
        text-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
        font-weight: 700;
        letter-spacing: 0.5px;
    }
</style>

<div class="premium-card-wrapper">
    <div class="premium-card">
        <div class="card-inner">

            <!-- Header Element (Replaced broken emojis with clean vector SVG) -->
            <div class="text-center mb-4">
                <div class="mb-3 text-center d-flex justify-content-center">
                    <svg xmlns="http://w3.org" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="filter: drop-shadow(0 0 8px rgba(168,85,247,0.6));">
                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </div>
                <h4 class="glow-text text-white mb-1">PDF to Word</h4>
                <p class="text-muted small mb-0">Convert your files instantly with AI precision</p>
            </div>

            <!-- Form Construction -->
            <form asp-controller="ReportQC" asp-action="ReportConversion" method="post" enctype="multipart/form-data">

                <!-- Upload Drop Zone Area -->
                <div class="mb-4">
                    <label for="pdfFile" class="upload-zone d-block" id="dropZone">
                        <div class="mb-3">
                            <svg xmlns="http://w3.org" width="42" height="42" fill="currentColor" class="mb-1" viewBox="0 0 16 16" style="color: #a855f7;">
                                <path fill-rule="evenodd" d="M7.646 5.146a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 6.707V10.5a.5.5 0 0 1-1 0V6.707L6.354 7.854a.5.5 0 1 1-.708-.708z" />
                                <path d="M4.406 3.342A5.53 5.5 0 0 1 8 2c2.69 0 4.923 2 5.166 4.579C14.758 6.804 16 8.137 16 9.773 16 11.569 14.502 13 12.687 13H3.781C1.708 13 0 11.366 0 9.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383zm.653.757c-.757.653-1.153 1.44-1.153 2.056A.5.5 0 0 1 3.4 6.657C1.945 6.89 1 8.01 1 9.317 1 10.789 2.257 12 3.781 12h8.906C13.98 12 15 11.008 15 9.773c0-1.176-.941-2.146-2.125-2.146a.5.5 0 0 1-.493-.414C12.13 4.771 10.272 3 8 3c-1.397 0-2.65.688-3.41 1.638a.5.5 0 0 1-.531.134z" />
                            </svg>
                        </div>
                        <span class="d-block fw-bold text-white mb-1" id="fileLabel">Choose PDF File</span>
                        <span class="text-muted d-block small">or drag and drop it here</span>
                        <input type="file" name="pdfFile" id="pdfFile" class="hidden-input" accept=".pdf" required />
                    </label>
                    <div class="text-center mt-2">
                        <small class="text-danger d-none" id="errorMsg">Sirf .pdf file hi select karein!</small>
                    </div>
                </div>

                <!-- Action Interactive Button -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-gradient" id="uploadBtn">
                        <span class="spinner-border spinner-border-sm d-none me-2" id="loader"></span>
                        <span id="btnText">Convert & Download</span>
                    </button>
                </div>

            </form>

            <!-- Server Status Notification Indicator -->
            <div class="text-center mt-3">
                <p id="statusMsg" class="text-warning small mb-0" style="display:none; font-weight: 500;">
                  Please wait, We are Working on it...
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const fileInput = document.getElementById('pdfFile');
        const fileLabel = document.getElementById('fileLabel');
        const errorMsg = document.getElementById('errorMsg');

        // Dynamic File Name Display System & Validation Fix
        fileInput.addEventListener('change', function (e) {
            if (this.files && this.files.length > 0) {
                const fileName = this.files[0].name; // Structural index property bug fix applied here
                if (!fileName.toLowerCase().endsWith('.pdf')) {
                    errorMsg.classList.remove('d-none');
                    fileLabel.innerText = "Choose PDF File";
                    fileLabel.style.color = '#ffffff';
                    this.value = '';
                    return;
                }
                errorMsg.classList.add('d-none');
                fileLabel.innerText = fileName;
                fileLabel.style.color = '#3b82f6';
            }
        });

        function getCookie(name) {
            var parts = document.cookie.split(name + "=");
            if (parts.length == 2) return parts.pop().split(";").shift();
        }

        function expireCookie(name) {
            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:01 GMT; path=/;';
        }

        document.querySelector('form').onsubmit = function () {
            document.getElementById('loader').classList.remove('d-none');
            document.getElementById('uploadBtn').disabled = true;
            document.getElementById('btnText').innerText = "Converting...";
            document.getElementById('statusMsg').style.display = 'block';

            var downloadTimer = window.setInterval(function () {
                var token = getCookie("fileDownloadToken");

                if (token === "true") {
                    document.getElementById('loader').classList.add('d-none');
                    document.getElementById('uploadBtn').disabled = false;
                    document.getElementById('btnText').innerText = "Convert & Download";
                    document.getElementById('statusMsg').style.display = 'none';

                    expireCookie("fileDownloadToken");
                    window.clearInterval(downloadTimer);
                }
            }, 1000);
        };
    </script>
}
