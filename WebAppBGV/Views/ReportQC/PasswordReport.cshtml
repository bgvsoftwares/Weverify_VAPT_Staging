@model  ViewModels.TempViewModel.UpdateTempPQPersonalViewModel

@{
    ViewBag.Title = "Protect Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "ReportQC", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
<!DOCTYPE html>
<meta name="viewport" content="width=device-width" />
<div class="form-group branch search-frame">


</div>
<div class="col-md-6">
    <div class="col-md-12" style="color:red; text-align:center"><br /></div>
    <label class="col-md-4 branchname control-label"> file  :<em>*</em></label>
    <div class="col-md-4">
        @using (Html.BeginForm("PasswordReport", "ReportQC", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex Enter Enter Password..." })


            @Html.TextBox("file", "", new { type = "file", @class = "btn bun-bg btn-default", @accept = "pdf", @onchange = "return fileValidation(this)", @style = "padding: 5px 10px 5px 10px;font-weight: bold;" })
            <br />
            <br />
            <input id="pdfupload" type="submit" style="padding: 5px 10px 5px 10px;font-weight: bold;" class="btn bun-bg btn-default" value="Password Protected Report" />

        }

    </div>

</div>

<div>
</div>
