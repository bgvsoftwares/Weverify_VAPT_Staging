
@model ViewModels.ViewTCSPenaltyamount

@{
    Layout = null;

}



@*@section LeftNavigation{ @Html.Partial("_NavLeftClientServicingInsuff") }*@
<script src="~/Scripts/bootstrap.min.js"></script>

<script src="~/Scripts/jquery-ui-1.14.1.js"></script>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>

<link href="~/Content/newcss/font-awesome.min.css" rel="stylesheet" />
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AddPenaltyamount", "ReportQC"))
                        {
                            @Html.AntiForgeryToken()

                            @Html.HiddenFor(model => model.PersonalRowID)

                            @Html.HiddenFor(model => model.ClientRowId)


                            if (Model.ClientRowId == 3)
                            {
                                <div class="form-group">

                                    <label class="control-label col-md-6">Penalty amount  :</label>

                                    <div class="col-md-6">
                                        @Html.TextAreaFor(model => model.Penaltyamount, new { @class = "form-control col-md-6", @rows = "2", @style = "width:100%;" })
                                        @*@Html.TextBox("TxtEmployeeId", null, new { @class = "form-control", placeholder = "EmployeeId..." })*@
                                    </div>

                                </div>
                                <div class="form-group">

                                    <label class="control-label col-md-6">Incentive Amount  :</label>

                                    <div class="col-md-6">
                                        @Html.TextAreaFor(model => model.IncentiveAmount, new { @class = "form-control col-md-6", @rows = "2", @style = "width:100%;" })
                                        @*@Html.TextBox("TxtEmployeeId", null, new { @class = "form-control", placeholder = "EmployeeId..." })*@
                                    </div>

                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-6">Location  :</label>
                                    <div class="col-md-6">
                                        @Html.TextAreaFor(model => model.Location, new { @class = "form-control col-md-6", @rows = "2", @style = "width:100%;" })
                                        @*@Html.TextBox("TxtEmployeeId", null, new { @class = "form-control", placeholder = "EmployeeId..." })*@
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-6">Interim Status/ Report Shared date:</label>
                                    <div class="col-md-6">
                                        @*@Html.text(model => model.InterimdateTCSBPO, new {@id="InterimdateTCSBPO", @class = "form-control col-md-6", @rows = "2", @style = "width:100%;" })*@
                                        @*@Html.TextBox("TxtEmployeeId", null, new { @class = "form-control", placeholder = "EmployeeId..." })*@
                                        @Html.TextBoxFor(model => model.InterimdateTCSBPO, new { @class = "form-control col-md-12 col-sm-12", @id = "InterimdateTCSBPO", @placeholder = "dd-mm-yyyy", @type = "date" })
                                    </div>
                                </div>
                            }
                            else

                            {
                                <div class="form-group">

                                    <label class="control-label col-md-6">SOW  :</label>

                                    <div class="col-md-6">
                                        @Html.TextAreaFor(model => model.SOW, new { @class = "form-control col-md-6", @rows = "2", @style = "width:100%;" })
                                        @*@Html.TextBox("TxtEmployeeId", null, new { @class = "form-control", placeholder = "EmployeeId..." })*@
                                    </div>

                                </div>
                            }


                            <br />
                            <div class="form-group branch search-frame">
                                <div style="text-align:center;">

                                    <input class="btn bun-bg btn-success" type="submit" value="Update" name="Process" />
                                </div>
                            </div>

                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>













}











