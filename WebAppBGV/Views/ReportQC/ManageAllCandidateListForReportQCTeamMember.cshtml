
@{
    ViewBag.Title = "Manage Report QC TeamMember Cases";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
}

@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatHours"] != null)
    {
        tatHours1 = Request.QueryString["tatHours"].ToString();
    }
    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CaseStatus"] != null)
    {
        CaseStatus1 = @Request.QueryString["CaseStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportAddressMge", "ReportQC", new { CaseStatus = "CaseForReportQc" }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

    @*//@ViewBag.NavigationBtnExportWord
        //string faIconExportWord = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Word");
        //string hyperLinkExportWord = Html.ActionLink("linkTitle", "ExportCountryInWord", "Master", null, new { class = "btn bun-bg btn-default" }).ToString();
        //ViewBag.NavigationBtnExportWord = new HtmlString(hyperLinkExportWord.ToString().Replace("linkTitle", faIconExportWord));

        //@ViewBag.NavigationBtnBackExportPDF
        //string faIconExportPDF = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export PDF");
        //string hyperLinkExportPDF = Html.ActionLink("linkTitle", "ExportCountryInPDF", "Master", null, new { class = "btn bun-bg btn-default" }).ToString();
        //ViewBag.NavigationBtnBackExportPDF = new HtmlString(hyperLinkExportPDF.ToString().Replace("linkTitle", faIconExportPDF));*@
}
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageAllCandidateListForReportQCTeamMember", "ReportQC", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-4">
                                        @Html.DropDownList("ClientRowID",
                                        new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                        "-- Select Client -- ",
                                        new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-4">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
                                    </div>
                                </div>
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" onclick="SearchFunction()" value="Search" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQPersonalForReportQC != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            @{
                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQPersonalForReportQC, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"col-md-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "Name", header: "Candidate Name", canSort: false, style:"col-md-2"),
                                    //grid.Column(columnName: "ClientRefID", header: "Client-Ref-ID", canSort: false, style:"col-md-2"),
                                    
                                    //grid.Column(header : "SecuritasID", format : (item) => {
                                    //     string CompanyRefNo=item.CompanyRefNo;
                                    //            var link = Html.ActionLink(CompanyRefNo,"ManageCandidateChecksForReportQCTM", "ReportQC", new { PersonalRowID = item.PersonalRowID, dispFor="TeamMember"  }, new { @class="edit" });
                                    //         return link;
                                    //}, style:"col-md-2"),

                                    grid.Column(header : "Securitas ID", format : (item) => {
                                        string CompanyRefNo=item.CompanyRefNo;
                                                var link = Html.ActionLink(CompanyRefNo, "ManageCandidateChecksForReportQC", "ReportQC", new { PersonalRowID = item.PersonalRowID, dispFor="TeamMember"  }, new { @class="edit" });
                                             return link;
                                    }, style:"col-md-2"),

                                    grid.Column(header : "Interim", format : (item) => {
                                        if (item.InterimReport==1)
                                         {
                                            var link = Html.ActionLink("Report","ReportInterim", "ReportQC", new { id = item.PersonalRowID,Report_Type= item.InterimReport}, new { @target="_blank", @class="edit" });
                                            return link;
                                          }
                                     return "";
                                    }, style:"col-md-1"),

                                     grid.Column("Uploaded-Report", canSort: false, format: (item)=> {
                                        if (item.IsReportUploaded && !string.IsNullOrEmpty(item.ReportUploadedName))
                                        {
                                            string FldPathDoc = System.Configuration.ConfigurationManager.AppSettings["CandidateReportdoc"].ToString();
                                             string DownloadLink = string.Format("<a href=\"{0}\" target=\"_blank\">Download</a>",Url.Content(FldPathDoc + item.ReportUploadedName));
                                             return new HtmlString(DownloadLink);
                                        }
                                            return null;
                                    }, style:"delete col-md-1"),

                                    //grid.Column(header : "Final", format : (item) => {
                                    //      if (!string.IsNullOrEmpty(item.FinalColor))
                                    //        {
                                    //              var link = Html.ActionLink("Report","ReportInterim", "ReportQC", new { id = item.PersonalRowID }, new { @class="edit" });
                                    //              return link; 
	                                   //     }
                                    //      return "";
                                    //}, style:"col-md-1"),

                                    grid.Column(columnName: "CaseStatus", header: "Case-Status", canSort: false, style:"col-md-1"),
                                     grid.Column(header : "Map", format : (item) => {
                                                var link = Html.ActionLink("Artifacts", "UpdateReportArtifactsCaseDocByRWQCTM", "ReportQC", new { Pid = item.PersonalRowID}, new { @class="edit iframeRptArtifactCaseDoc cboxElement" });
                                            return link;
                                    }, style:"col-md-1"),
                                     grid.Column(header : "Action", format : (item) => {
                                        var link = Html.ActionLink("History", "CaseActionHistories", "ReportQC", new { pid = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement" });
                                        return link;
                                    }, style:"edit col-md-1"),
                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            $(".iframeRptArtifactCaseDoc").colorbox({ iframe: true, width: "80%", height: "70%" });
        });
    </script>
}



