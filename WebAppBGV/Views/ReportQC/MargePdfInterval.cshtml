@model IEnumerable<ViewModels.MargePdfModel>
@{
    ViewBag.Title = "MargePdfInterval";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "ReportQC", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    //List<string> objList = (List<string>)ViewBag.FilesDetails;
}
@if (TempData["ErrorMsg"] != null)
{
    <script>
         Swal.fire({
         icon: 'warning',
         html:' <div class="errormsg" style="color:red;">@TempData["ErrorMsg"].ToString()</div>',
         showConfirmButton: false,
         timer: 1500
         })
    </script>
}
@if (TempData["SuccessMsg"] != null)
{
    <script>
         Swal.fire({
         icon: 'success',
         html:'<div class="errormsg">@TempData["SuccessMsg"].ToString()</div>',
         showConfirmButton: false,
         timer: 1500
         })
    </script>
}
<div class="container-fluid">
    <div class="container">
        <div class="row">
            <div class="col-sm-1"></div>
            <div class="card  col-sm-10">
                <div class="card-body">
                    @using (Html.BeginForm("MargePdfInterval", "ReportQC", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="container">
                            <div class="row">
                                <div class="col-md-3">
                                    <h3 style="margin-top:10px;">Upload Pdf file<sup style="color:red;">*</sup>:</h3>
                                </div>
                                <div class="col-md-6">
                                    @Html.TextBox("upfile", "", new { type = "file", @class = "btn bun-bg btn-default", @accept = "pdf", @onchange = "return fileValidation(this)", @style = "padding: 5px 10px 5px 10px;font-weight: bold;" })
                                </div>
                                <div class="col-md-3">
                                    <input id="pdfupload" type="submit" name="btnSubmit" style="padding: 10px 0px 10px 0px; font-weight: bold; width: 150px!important;font-weight: bold;" class="btn bun-bg btn-default" value="Upload Pdf" />
                                    <br />
                                    <p style="color:red"></p>
                                </div>
                            </div>
                            <div class="clearfix"><br /></div>
                            <div class="row">
                                <div class="col-md-3">
                                    <h3 style="margin-top:10px;">Uploaded File :</h3>
                                </div>
                                <div class="col-md-6"  style="font-size:18px"> 
                                    <table>
                                        <tbody>

                                            @foreach (var file in Model)
                                            {
                                            <tr>
                                                <td id="dvFileName">
                                                    @file.FileName
                                                </td>
                                            </tr>
                                            }
                                             
                                            </tbody>
                                     </table>
                                </div>
                                <div class="col-md-3">
                                    <input id="pdfMarge" type="submit" name="btnSubmit" style="padding: 10px 0px 10px 0px; font-weight: bold; width: 150px!important;font-weight: bold;" value="Marge Pdf" />
                                </div>
                            </div>
                            <div class="clearfix"><br /></div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-sm-1"></div>
        </div>

    </div>
</div>
@section Scripts{
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script type="text/javascript">
        $("#pdfMarge").click(function () {
            var fn = $.trim($("#dvFileName").html());
            if (fn == '') {
                Swal.fire('', 'Please upload file');
                return false;
            }
        });    
    </script>
   
}


