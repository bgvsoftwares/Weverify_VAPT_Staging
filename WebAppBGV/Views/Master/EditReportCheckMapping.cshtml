            }
            //on load (returns to form)
            fnIdentityChk();
            //Identity changes event
            $('input[class="rdoIdentityChk"]').on('change', function () {
                fnIdentityChk();
            });

            //Reference
            function fnReferenceChk() {
                var ReferenceChk = $('input[id=rdoReferenceChkYes]:checked').val()

                if (ReferenceChk == 1) {
                    $('#btnReferenceChk').show();
                }
                else {
                    $('#btnReferenceChk').hide();
                }
            }
            //on load (returns to form)
            fnReferenceChk();
            //Reference changes event
            $('input[class="rdoReferenceChk"]').on('change', function () {
                fnReferenceChk();
            });

            //Special
            function fnSpecialChk() {
                var SpecialChk = $('input[id=rdoSpecialChkYes]:checked').val()

                if (SpecialChk == 1) {
                    $('#btnSpecialChk').show();
                }
                else {
                    $('#btnSpecialChk').hide();
                }
            }
            //on load (returns to form)
            fnSpecialChk();
            //Special changes event
            $('input[class="rdoSpecialChk"]').on('change', function () {
                fnSpecialChk();
            });

        });
        
    </script>

}
