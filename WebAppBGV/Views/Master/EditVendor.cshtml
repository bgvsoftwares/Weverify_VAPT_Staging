    <script>
        function storeImage(input, hiddenFieldId, previewBtnId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById(hiddenFieldId).value = e.target.result;
                    document.getElementById(previewBtnId).hidden = false;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function showImage(hiddenFieldId) {
            const imageSrc = document.getElementById(hiddenFieldId).value;
            if (imageSrc) {
                document.getElementById('previewModalImage').src = imageSrc;
                new bootstrap.Modal(document.getElementById('imagePreviewModal')).show();
            } else {
                alert("Please select a file first.");
            }
        }
    </script>
