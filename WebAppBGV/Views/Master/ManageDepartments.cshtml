@section LeftNavigation{ @Html.Partial("_NavLeftMaster") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("ManageDepartments", "Master", FormMethod.Get))
                {
                    <div class="form-horizontal">
                        <div class="form-group branch row  search-frame">
                            <label class="col-md-3 control-label">Department Name :</label>
                            <div class="col-md-5">
                                @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Department name..." })
                            </div>
                            <div class="col-md-2">
                                <input class="btn bun-bg btn-default" type="submit" value="Search" />
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
        @if (Model != null && Model.Departments != null)
        {
            <div class="row">
                <div class="col-md-12 table">
                    @{

                        WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                        grid.Bind(Model.Departments, autoSortAndPage: false, rowCount: Model.TotalRecords);
                    }
                    @grid.GetHtml(
                                              htmlAttributes: new { id = "grid", @class = "table" },
                                              headerStyle: "thead-inverse",
                                              rowStyle: "ordertxt",
                                              footerStyle: "custpaging",
                                              mode: WebGridPagerModes.All,
                                              columns: new[]
                                              {
                                            grid.Column(header: "S.No.", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                            grid.Column(columnName: "DepartmentName", header: "Department", canSort: true, style:"td-6"),

                                             grid.Column(header: "Active", canSort: false, format: (item) => {
                                     string strActive=string.Empty;
                                     if (item.Status == 1)
                                        {
                                            strActive += "<input name="+ item.DepartmentRowID +" id="+ item.DepartmentRowID +" checked='true' type='checkbox' onchange='adchange(this)' />";
                                        }
                                     else
                                        {
                                            strActive += "<input name="+ item.DepartmentRowID +" id="+ item.DepartmentRowID +" type='checkbox' onchange='adchange(this)' />";
                                        }
                                        return new HtmlString(strActive);
                                 },style:"delete td-1"),

                                 //grid.Column(header: "Delete", canSort: false, format: (item) => {
                                 //    string strActive=string.Empty;
                                 //           strActive += "<input name=btn_"+ item.DepartmentRowID +" id="+ item.DepartmentRowID + " type='button' onclick='remdept(this)' />";
                                 //       return new HtmlString(strActive);
                                 //},style:"delete td-1"),
                                  grid.Column("Delete", canSort: false, format: (item)=> {

                                                    string DeleteLink = string.Format("<a href=\"#\" id=\"Complete_{0}\" class=\"Complete\" >{1}</a>", item.DepartmentRowID, "Delete");
                                                    return new HtmlString(DeleteLink);

                                        }, style:"td-1")


                                                  //grid.Column(header : "Edit", format : (item) => {
                                                  //    var link = Html.ActionLink("Edit", "EditDepartment", "Master", new { id = item.DepartmentRowID }, null);
                                                  //    return link;
                                                  //}, style:"edit td-1"),
                                              }
                                      )
                    <div class="total-record">Total Records: @Model.TotalRecords</div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        function adchange(ChkData) {

            var id = ChkData.id;
            var checkeds = ChkData.checked;
            var flag = "";
            if (ChkData.checked == true) {
                flag = confirm('Are you sure to Enable this Record ?');
            }
            if (ChkData.checked == false) {
                flag = confirm('Are you sure to Disable this Record ?');
            }
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DepartmentActive", "Master")',
                    data: { "id": id, "checkeds": checkeds },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Record Update Successfully!!");
                            setTimeout(function () { window.location; }, 300);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
            else {
                if (ChkData.checked == false) {
                    ChkData.checked = true;
                }
                else {
                    ChkData.checked = false;
                }
            }
        }
    </script>
    <script type="text/javascript">
        $(".Complete").on("click", function () {
            var str = $(this).attr("id").split("_");
            //var CheckStatusId = $(this).attr("CheckStatusId");
            //var SubCheckId = $(this).attr("SubCheckId");
            //var CaseStatus = $(this).attr("CaseStatus");
            id = str[1];
            alert(id);

            var flag = confirm('Are you sure to delete the job?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DepartmentRemove", "Master")',
                    data: { "id": id},
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Department Deleted Successfully!!");
                            setTimeout(function () { window.location.replace("ManageDepartments" ); }, 500);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });
    </script>

