                }
            });
            //GST Reg Snapshot Enable Desable
            $('#GST').change(function () {
                var GST = $('#GST').val();
                if (GST == 'Yes') {
                    $('#GSTImage').prop("disabled", false);
                    $('#GSTImage').focus();
                } else {
                    $('#GSTImage').prop("disabled", true);
                }
            });
            //BSE Reg Snapshot Enable Desable
            $('#BSE').change(function () {
                var BSE = $('#BSE').val();
                if (BSE == 'Yes') {
                    $('#BSEImage').prop("disabled", false);
                    $('#BSEImage').focus();
                } else {
                    $('#BSEImage').prop("disabled", true);
                }
            });
            //NSE Reg Snapshot Enable Desable
