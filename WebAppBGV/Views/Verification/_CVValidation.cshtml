@model List<ViewModels.VerificationViewModel.VerificationDetailModel1>

<div class="table-responsive">

    <table id="verification-table"
           class="table table-bordered table-striped table-hover">

        <thead>
            <tr style="background-color:#11c9b7;color:white;">
                <th style="width:30%;">Data Fields</th>
                <th style="width:35%;">Applicant Submitted Details</th>
                <th style="width:35%;">Resume/CV Details</th>
            </tr>
        </thead>

        <tbody>

            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>

                    <td>
                        @Model[i].DataField

                        <input type="hidden"
                               name="CVValidation[@i].PersonalRowID"
                               value="@Model[i].PersonalRowID" />

                        <input type="hidden"
                               name="CVValidation[@i].DataField"
                               value="@Model[i].DataField" />
                    </td>

                    <td>
                        <input type="text"
                               class="form-control"
                               name="CVValidation[@i].ApplicantSubmittedDetails"
                               value="@Model[i].ApplicantSubmittedDetails" />
                    </td>

                    <td>
                        <input type="text"
                               class="form-control"
                               name="CVValidation[@i].ResumeCVDetails"
                               value="@Model[i].ResumeCVDetails" />
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
