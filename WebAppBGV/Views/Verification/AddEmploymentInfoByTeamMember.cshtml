@model dynamic
@using WebAppBGV.CommonMethods;

@{
    string Designation = Session["Designation"].ToString();
    string CheckStatusAction = Session["CheckStatus"].ToString();
    ViewBag.Title = "Add Employment Info (" + Convert.ToString(Session["CandidateName"]) + ")";
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = "";
    if (Designation.Contains("Leader"))
    {
        hyperLink = Html.ActionLink("linkTitle", "DepartmentTeamLeaderAllocation", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else if (Designation.Contains("Manager"))
    {

        hyperLink = Html.ActionLink("linkTitle", "DepartmentManagerAllocation", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    }
    else
    {
        if (Session["CheckStatus"].ToString() == "FundsApproval")
        {
            hyperLink = Html.ActionLink("linkTitle", "TeamMemberFundsResolved", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
        else
        {
            hyperLink = Html.ActionLink("linkTitle", "ManageTeamMemberChecks", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }

    }


    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CandCheckRowid = "";
    string CheckStatusid = "";
    string CheckStatus = "";
    string ReportComments = "";
    int EmployeeRowId;
    string[] AntecedId = { "92", "81", "353", "354", "355", "356", "357", "358", "359", "360" };
    string[] isNewCompanyAntecedId = { "629", "632", "630", "631" };
    PersonalRowid = @ViewBag.PersonalRowid;
    EmployeeRowId = Convert.ToInt32(@Session["EmployeeRowId"]);
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CandCheckRowid = @ViewBag.CandCheckRowID;
    CheckStatusid = @ViewBag.CheckStatusid;
    CheckStatus = @ViewBag.CheckStatus;
    ReportComments = Convert.ToString(ViewBag.ReportComments);
    int isNewCompany = ViewBag.isNewCompany;
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }

<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>

        </tr>
        <tr>
            <td>@Html.Partial("_CaseDocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("MailList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentEMPList")</td>
        </tr>
    </table>
    @if (ViewBag.SpocActionRemark != null)
    {
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td colspan="2">
                    <div class=" col-12 personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>  Spoc Remark :</div>
                </td>
            </tr>
            <tr>
                @foreach (var item in ViewBag.SpocActionRemark)
                {
                    if (item.PriorityType == "High")
                    {
                        <td style="font-weight: bold; background-color: #ff0000; color:white; width: 5%; ">High</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color:azure;"> @item.SpocRemark </p>
                        </td>
                    }
                    else
                    {
                        <td style="font-weight: bold; background-color: #02fd58; width: 5%; ">Low</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color: azure; "> @item.SpocRemark </p>
                        </td>
                    }

                }
            </tr>
        </table>
    }

    <div class="col-md-12">
        @if (ViewBag.ErrorMsg != null)
        {
            <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="errormsg">@ViewBag.Success.ToString()</div>
        }
        @using (Html.BeginForm("AddEmploymentInfoByTeamMember", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
            @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

            <input id="SubCheckId" type="hidden" value=@SubCheckId>
            @Html.Hidden("SubCheckId", SubCheckId.ToString())

            <input id="clientRowId" type="hidden" value=@clientRowId>
            @Html.Hidden("clientRowId", clientRowId.ToString())

            @*@Html.ValidationSummary()*@
            <input id="CheckStatusid" type="hidden" value=@CheckStatusid>
            @Html.Hidden("CheckStatusid", CheckStatusid.ToString())

            <input id="CheckStatus" type="hidden" value=@CheckStatus>
            @Html.Hidden("CheckStatus", CheckStatus.ToString())
            int cnt = 0;
            foreach (var category in Model)
            {
                //string[] nm = category.Key.Split('_');
                //string[] temp = category.Value.Split('_');

                string[] nm = category.Key.Split('_');
                string[] temp;
                if (nm[0] == "96" || nm[0] == "149")
                {
                    temp = category.Value.Split('$');
                }
                else
                {
                    temp = category.Value.Split('_');
                }


                <div class="row" style="margin-bottom:10px;">
                    @if (clientRowId.ToString() == "722" && isNewCompanyAntecedId.Contains(nm[0]) && isNewCompany > 0)
                    {
                        if (cnt == 0)
                        {
                            <div class="col-md-4">
                                <p style="color:red">New employer is found. fill the required fields</p>

                            </div>
                            cnt = 1;
                        }

                    }
                </div>
                <div class="row" style="margin-bottom:10px;">
                    @{

                        if (@nm[2] == "textbox")
                        {
                            <div class="col-md-4">
                                @{
                                    if (nm[4] != "")
                                    {
                                        <p style="margin-top:30px!important;">
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }
                                            @nm[1]
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }
                                            @nm[1]
                                        </p>
                                    }
                                }
                            </div>

                            if (@nm[0] != "81")
                            {

                                if (@nm[0] == "92")
                                {
                                    <div class="col-md-4">
                                        @*<a href='@Url.Action("EmployerDetailsName", "Master", new { id = Convert.ToString(@temp[0]).Replace(".", "") })' target="_blank">@temp[0]</a>*@
                                        @*<a href='@Url.Action("EmployerDetailsName", "Master",  new { id = Convert.ToString (clsCommonMethods.PEncrypt( @temp[0].ToString()))})' target="_blank">@temp[0]</a>*@
                                        <br />
                                        <a href='@Url.Action("EditEmployers", "Master",  new { id = @EmployeeRowId})' target="_blank">@temp[0]</a>
                                    </div>
                                }
                                else
                                {
                                    if (nm[4] != "")
                                    {
                                        <div class="col-md-4">
                                            <p style="margin-top: 30px;">@temp[0]</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            <p>@temp[0]</p>
                                        </div>
                                    }
                                }

                            }



                            if (temp.Count() > 1 && @temp[1] != "")
                            {
                                if (@nm[0] == "81")
                                {
                                    <div class="col-md-8">
                                        <textarea name="81" id="81">@temp[1]</textarea>
                                    </div>

                                }
                                else
                                {
                                    <div class="col-md-4">
                                        @if (nm[4] != "")
                                        {
                                            <p style="color:red">@nm[4]</p>
                                        }
                                        @if (clientRowId.ToString() == "860")
                                        {
                                            if (AntecedId.Contains(@nm[0]))
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                                <input type="text" class="form-control" name="@nm[0].ToString()_1" id=@nm[0] value='' maxlength="@nm[5]">
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                            }
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                        }
                                    </div>
                                }

                            }
                            else
                            {
                                if (@nm[0] == "81")
                                {
                                    <div class="col-md-8">
                                        <textarea name="81" id="81">@temp[0]</textarea>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        @if (nm[4] != "")
                                        {
                                            <p style="color:red">@nm[4]</p>
                                        }

                                        @if (clientRowId.ToString() == "860")
                                        {
                                            if (AntecedId.Contains(@nm[0]))
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off">

                                                <input type="text" class="form-control" name="@nm[0].ToString()_1" id=@nm[0] value=''>
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off">
                                            }

                                        }
                                        else
                                        {
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off">
                                        }
                                    </div>
                                }

                            }


                        }

                        if (@nm[2] == "dropdown")
                        {

                            <div class="col-md-4">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7>*</h7>
                                    }
                                }
                                @nm[1]
                            </div>
                            <div class="col-md-4">
                                @if (temp.Count() > 1)
                                {
                                    <p>@temp[0]</p>
                                }
                            </div>
                            <div class="col-md-4">
                                <span> @nm[4] </span>
                                @{
                                    int lastindex = nm.Length;
                                    string[] nmOption = nm[lastindex - 1].Split(',');
                                    string Fvalue = nm[lastindex - 2].ToString();
                                }
                                @if (clientRowId.ToString() == "722" && isNewCompanyAntecedId.Contains(nm[0]) && isNewCompany == 1)
                                {
                                    <select name=@nm[0] id=@nm[0] autocomplete="off" class="form-control" required="required">
                                        @for (int i = 0; i < nmOption.Length; i++)
                                        {
                                            if (@nmOption[i].Trim() == Fvalue)
                                            {
                                                <option selected>@nmOption[i]</option>
                                            }
                                            else
                                            {
                                                <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                            }

                                        }
                                    </select>
                                }
                                else
                                {
                                    <select name=@nm[0] id=@nm[0] autocomplete="off" class="form-control">
                                        @for (int i = 0; i < nmOption.Length; i++)
                                        {
                                            if (@nmOption[i].Trim() == Fvalue)
                                            {
                                                <option selected>@nmOption[i]</option>
                                            }
                                            else
                                            {
                                                <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                            }

                                        }
                                    </select>
                                }

                            </div>


                        }
                        if (@nm[2] == "checkbox")
                        {
                            <div class="container">
                                <div class="row">
                                    <div class="col-sm">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-sm">
                                        <span> @nm[4] </span>
                                        @{
                                            if (@nm[6] == "TRUE")
                                            {
                                                <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                            }
                                            else
                                            {
                                                <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                            }
                                        }

                                    </div>
                                    <div class="col-sm">
                                        <span id="message" class="text-danger"></span>

                                    </div>
                                    @*<div class="col-sm">
                                            @nm[4]
                                        </div>*@
                                </div>
                            </div>
                        }
                        if (@nm[2] == "fileUpload")
                        {
                            <div class="container">
                                <div class="row">
                                    <div class="col-sm">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-sm">
                                        <span> @nm[4] </span>
                                        <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                    </div>

                                </div>
                            </div>

                        }
                    }

                </div>

            }
            <div class="row">
                <div class="col-sm-12 cytoscape-parent">
                    <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                </div>
            </div>

            if (ReportComments != "")
            {
                <div class="row">
                    <div class="col-md-4">
                        Action Remarks :
                    </div>
                    <div class="col-md-8">
                        <textarea name="Remarks" id="Remarks" rows="5" cols="8">@ReportComments</textarea>
                    </div>
                </div>
            }


        <div class="container">
            <div class="row">
                <div class="col-sm">
                    &nbsp;
                </div>
                @if ((Session["Designation"].ToString() == "Manager-Emp" || Session["Designation"].ToString() == "Team Leader-Emp") && (CheckStatusAction == "WIPALL" || CheckStatusAction == "totalWIP"))
                {
                    <div class="col-sm" style="text-align:center;">
                        <input type="submit" value="Submit" style="width:15rem!important; padding:2% 0 2% 0; border-radius:.90rem; font-size:1.6rem!important;" onclick="uanuploadDoc()" />
                    </div>
                }
                @if ((Session["Designation"].ToString() == "Team Member-Emp" || Session["Designation"].ToString() == "Team Member-Emp-QC") && CheckStatusid != "64")
                {
                    <div class="col-sm" style="text-align:center;">
                        <input type="submit" value="Submit" style="width:15rem!important; padding:2% 0 2% 0; border-radius:.90rem; font-size:1.6rem!important;" onclick="uanuploadDoc()" />
                    </div>
                }
                <div class="col-sm">
                    &nbsp;
                </div>
                <div class="col-sm">
                    &nbsp;
                </div>
            </div>
        </div>
        <br />
        <br />
        <div class="container">
            @if ((Session["Designation"].ToString() == "Team Member-Emp" || Session["Designation"].ToString() == "Team Member-Emp-QC") && CheckStatusid != "64")
            {
                <div class="row">
                    <div class="col-sm">
                        @Html.ActionLink("Back", "ManageTeamMemberChecks", "Verification", new { CheckStatusid = CheckStatusid, CheckStatus = CheckStatus }, new { @class = "btn btn-default VerEmailDetails" })

                        </div>
                        <div class="col-sm">

                            @Html.ActionLink("Closer Details", "EmploymentVerCloserDetails", "Verification", new { PersonalRowID = PersonalRowid, SubcheckRowID = SubCheckId, ClientRowID = clientRowId, Aging = "" }, new { @class = "btn btn-default VerEmailDetails", @id = "VerificationCloserDetails", @disabled = "disabled", })

                        </div>
                        <div class="col-sm">
                            @Html.ActionLink("Attachment", "UplodEmploymentVerDocs", "Verification", new { scid = SubCheckId, pe = PersonalRowid, ClientRowID = clientRowId }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @id = "UplodVerificationDocs" })
                        </div>
                        <div class="col-sm">
                            @Html.ActionLink("Sent Mail", "EmploymentVerEmailDetails", "Verification", new { subcheckrowid = SubCheckId, personalrowid = PersonalRowid }, new { @class = "iframeEmailStatus cboxElement callbacks btn btn-default VerEmailDetails", @id = "EmploymentVerificationEmailDetails" })

                        </div>
                        <div class="col-sm">
                            @Html.ActionLink("Capture Effort Log", "CaptureActionHistoryByVerTM", "Verification", new { CandCheckRowid = CandCheckRowid, cid = clientRowId, scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateStatus cboxElement callbacks btn btn-default", @id = "VerificationActionHistostry" })
                        </div>
                        <div class="col-sm">
                            @if (Designation == "Team Member-Emp")
                            {
                                if (ViewBag.PersonalBind != null)
                                {
                                    @Html.ActionLink("Stop Automation", "StopAutomation", "Verification", new { scid = @ViewBag.PersonalBind.SubCheckRowID, pe = @ViewBag.PersonalBind.PersonalRowID, CheckStatusId = @ViewBag.PersonalBind.CheckStatusID, AuditType = @ViewBag.PersonalBind.CheckFamilyRowID }, new { @class = "iframeActionHistories cboxElement btn btn-default" })
                                }
                            }
                        </div>
                        <div class="col-sm">
                            @if (Designation == "Team Member-Emp")
                            {
                                if (ViewBag.PersonalBind != null)
                                {
                                    @Html.ActionLink("StopAutomationResume", "StopAutomationResume", "Verification", new { scid = @ViewBag.PersonalBind.SubCheckRowID, pe = @ViewBag.PersonalBind.PersonalRowID, AuditType = @ViewBag.PersonalBind.CheckFamilyRowID }, new { @class = "iframeActionHistories cboxElement btn btn-default" })
                                }
                            }
                        </div>
                        @*<div class="col-sm">
                                @if (Designation == "Team Member-Emp")
                                {
                                    @Html.ActionLink("Stop Automation", "StopAutomation", "Verification", new { scid = @ViewBag.PersonalBind.SubCheckRowID, pe = @ViewBag.PersonalBind.PersonalRowID, CheckStatusId = @ViewBag.PersonalBind.CheckStatusID, AuditType = @ViewBag.PersonalBind.CheckFamilyRowID }, new { @class = "iframeActionHistories cboxElement btn btn-default" })
                                }
                            </div>*@
                    </div>
                }
            </div>

        <div class="container">
            @if (Session["Designation"].ToString() == "Manager-Emp" && CheckStatusid == "17")
            {
                <div class="row">
                    <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" name="action" />
                    <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Reject" name="action" />
                </div>
            }
            @if (Session["Designation"].ToString() == "Manager-Emp" && CheckStatusid == "19")
            {
                <div class="row">
                    <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" name="action" />
                    <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Reject" name="action" />
                </div>
            }

        </div>
            <br />
            <br />
            <br />
            <br />

        }
    </div>
</div>

<style>

    .btn {
        padding: 10px 40px 10px 40px !important;
    }

    input[type=text], textarea {
        width: 100%;
        padding: 22px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    select {
        width: 100%;
        padding: 14px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    label {
        padding: 12px 12px 12px 0;
        display: inline-block;
    }

    input[type=submit] {
        background-color: #04AA6D;
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        float: right;
    }

        input[type=submit]:hover {
            background-color: #45a049;
        }

    .container {
        border-radius: 5px;
        /*background-color: #f2f2f2;*/
        padding: 8px;
        font-size: 1.2rem !important;
    }

    .col-25 {
        float: left;
        width: 25%;
        margin-top: 6px;
    }

    .col-75 {
        float: left;
        width: 40%;
        margin-top: 6px;
        margin-left: 90px;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }

    .ui-widget.ui-widget-content {
        width: 20%;
    }

    img {
        width: 50px;
        height: 25px;
    }
    /* Responsive layout - when the screen is less than 600px wide, make the two columns stack on top of each other instead of next to each other */
    @@media screen and (max-width: 600px) {
        .col-25, .col-75, input[type=submit] {
            width: 100%;
            margin-top: 0;
        }
    }
</style>


@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/tinymceNew.min.js"></script>
    <script src="~/Scripts/tinymce-jquery.min.js"></script>

    <script>
        $('textarea').tinymce({
            height: 200,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | removeformat | help'
        });
        // Prevent jQuery UI dialog from blocking focusin
        $(document).on('focusin', function (e) {
            if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                e.stopImmediatePropagation();
            }
        });
    </script>
    <style>
        .tox-tinymce {
            margin-top: 10px !important;
        }

        .tox-editor-header {
            box-shadow: none !important;
            z-index: 0 !important;
            border-bottom: 0.5px solid #000 !important;
        }

        .tox-statusbar__branding {
            display: none !important;
        }
    </style>
    <script>
        $(document).ready(function () {
             var ErrorMsg = '@(ViewBag.ErrorMsg)';

                    if (ErrorMsg=='')
                    {

                        //$('#VerificationCloserDetails').prop('disabled', false);
                        $('#VerificationCloserDetails').css('visibility', 'visible');
                    }
                    else
                    {

                        $('#VerificationCloserDetails').css('visibility', 'hidden');
                    }
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
