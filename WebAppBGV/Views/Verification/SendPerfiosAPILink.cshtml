@model dynamic
@{
    ViewBag.Title = "Send Perfios EPFO UAN Link";
    //Layout = "~/Views/Shared/_Layout.cshtml";

}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

@using (Html.BeginForm("SendPerfiosAPILink", "Verification", FormMethod.Post, new { enctype = "multipart/form-data", style = "margin-left: 40px;" }))
{
    <div class="card">
        <div class="card-header">
            Welcome to the EPFO UAN Validation Portal
        </div>

        <div class="card-body">
            <div class="container">

                <div class="row row-sm mt-4">
                    <div class="col-md-6">
                        <lable class="lable">CompanyRef No</lable>
                        <input type="text" id='CompanyRefNo' name='CompanyRefNo' class="form-control" placeholder="CompanyRef No" Value="@ViewBag.CompanyRefNo" autocomplete="off" required>
                    </div>
                    <div class="col-md-6">
                        <input type="submit" class="btn_submit" value="SEARCH" style="margin-top:18px;" name="Action">
                    </div>

                </div>
                <div class="row row-sm mt-3" style="justify-content: center;">
                    <div class="col-md-4">
                        <input type="submit" class="btn_submit" value="SUBMIT" name="Action">
                        <br />
                    </div>

                </div>
                <br/>
                <div class="row row-sm mt-3" style="justify-content: center;">
                    <h4 class="card-title text-center fw-bold" style="color:#8D5FFF;">@ViewBag.msg</h4>
                </div>
            </div>
        </div>
    </div>

}
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />



}