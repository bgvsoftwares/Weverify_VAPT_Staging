@model dynamic


@{
    string Designation = "";
    if (Session["Designation"] != null)
    {
        Designation = Session["Designation"].ToString();
        //ViewBag.Title = "Add Employment Info (" + Convert.ToString(Session["CandidateName"]) + ")";
    }//


    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CheckStatusid = "";

    string degreeid = "";
    string degreeName = "";
    string CandidateName = "";
    string CompanyRefNo = "";
    string SubReferenceID = "";
    //var list = @ViewBag.Disposition;


    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CheckStatusid = @ViewBag.CheckStatusid;
    string CDispositionName = ViewBag.CDispositionName;
    string ReportComments = ViewBag.ReportComments;
    degreeName = @ViewBag.degreeName.Trim();
    CandidateName = ViewBag.CandidateName;
    CompanyRefNo = ViewBag.CompanyRefNo;
    SubReferenceID = ViewBag.SubReferenceID;
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_CaseDocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentList")</td>
        </tr>

    </table>
    @if (ViewBag.SpocActionRemark != null)
    {
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td colspan="2">
                    <div class="col-12 personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>  Spoc Remark :</div>
                </td>
            </tr>
            <tr>
                @foreach (var item in ViewBag.SpocActionRemark)
                {
                    if (item.PriorityType == "High")
                    {
                        <td style="font-weight: bold; background-color: #ff0000; color: white; width: 5%; ">High</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color:azure;"> @item.SpocRemark </p>
                        </td>
                    }
                    else
                    {
                        <td style="font-weight: bold; background-color: #02fd58; width: 5%; ">Low</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color: azure; "> @item.SpocRemark </p>
                        </td>
                    }
                }
            </tr>
        </table>
    }
    <div class="container">
        @using (Html.BeginForm("UpdateEducationInfoByTMQC", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
            @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

            <input id="SubCheckId" type="hidden" value=@SubCheckId>
            @Html.Hidden("SubCheckId", SubCheckId.ToString())

            <input id="clientRowId" type="hidden" value=@clientRowId>
            @Html.Hidden("clientRowId", clientRowId.ToString())

            <input id="CheckStatusid" type="hidden" value=@CheckStatusid>
            @Html.Hidden("CheckStatusid", CheckStatusid.ToString())

            <input id="CandidateName" type="hidden" value=@CandidateName>
            @Html.Hidden("CandidateName", CandidateName.ToString())

            <input id="CompanyRefNo" type="hidden" value=@CompanyRefNo>
            @Html.Hidden("CompanyRefNo", CompanyRefNo.ToString())


            <input id="SubReferenceID" type="hidden" value=@SubReferenceID>
            @Html.Hidden("SubReferenceID", SubReferenceID.ToString())

            <input id="hdnDispositionID" type="hidden" name="hdnDispositionID">
            <input id="hdnSeverity" type="hidden" name="hdnSeverity">
            <input id="ColorsName" type="hidden" name="ColorsName">

            <input type="hidden" id="CollegeId" name="CollegeId" value=@ViewBag.CollgegIdn />
            <input type="hidden" id="CollegeNameTemp" name="CollegeNameTemp" />

            <input id="Hfdegreeid" type="hidden" value=@degreeid>
            @Html.Hidden("Hfdegreeid", degreeid.ToString())

            <input id="HfdegreeName" type="hidden" value='@degreeName'>

            @Html.Hidden("HfdegreeName", degreeName.ToString())


            @Html.ValidationSummary()

            foreach (var category in Model)
            {
                <div class="row">
                    @{
                        string[] nm = category.Key.Split('_');
                        string[] temp = category.Value.Split('_');

                        if (@nm[2] == "textbox")
                        {
                            <div class="col-md-4 class_anti">
                                @{
                                    if (nm[4] != "")
                                    {
                                        <p style="margin-top:30px!important;">
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }


                                            @nm[1]
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }


                                            @nm[1]
                                        </p>
                                    }
                                }
                            </div>

                            if (nm[0].ToString() != "66")
                            {
                                if (nm[4] != "")
                                {
                                    <div class="col-md-4">
                                        <p id="refValue" @*id="p_@nm[0]"*@ style="margin-top: 30px;">@temp[0]</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        <p id="refValue" @*id="p_@nm[0]"*@>@temp[0]</p>
                                    </div>
                                }

                            }
                            if (nm[0].ToString() == "66")
                            {
                                <div class="col-md-8">
                                    @if (temp.Count() > 1 && @temp[1] != "")
                                    {

                                        <div class="row">
                                            <div class="col-md-12 ">
                                                <div class="d-flex gap-4">
                                                    <textarea name="66" id="66" rows="5" cols="8" maxlength="@nm[5]" onfocus="getremarkData()">@temp[1]</textarea>

                                                    @if (temp.Count() > 1)
                                                    {

                                                        if (@temp[0] == @temp[1])
                                                        {
                                                            <i class="fa fa-check-circle" style="font-size: 20px; color: green; margin-left: 3px;"></i>
                                                        }
                                                        else
                                                        {
                                                            <i style="font-size:20px;color:green; margin-left:19px;"></i>
                                                        }
                                                    }

                                                </div>
                                            </div>
                                        </div>



                                    }
                                    else
                                    {

                                        <div class="row">
                                            <div class="col-md-12 ">
                                                <div class="d-flex gap-4">
                                                    <textarea name="66" id="66" rows="5" cols="8" maxlength="@nm[5]">@temp[0]</textarea>

                                                    @if (temp.Count() > 1)
                                                    {
                                                        if (@temp[0] == @temp[1])
                                                        {
                                                            <i class="fa fa-check-circle" style="font-size: 20px; color: green; margin-left: 3px;"></i>
                                                        }
                                                        else
                                                        {
                                                            <i style="font-size:20px;color:green; margin-left:19px;"></i>
                                                        }
                                                    }


                                                </div>
                                            </div>
                                        </div>



                                    }


                                </div>

                            }
                            else
                            {
                                <div class="col-md-4">
                                    @if (nm[4] != "")
                                    {
                                        <p style="color:red">@nm[4]</p>
                                    }

                                    @if (temp.Count() > 1 && @temp[1] != "")
                                    {
                                        <div class="row">
                                            <div class="col-md-12 ">
                                                <div class="d-flex gap-4">

                                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]" data-ref="@temp[0]" oninput="checkMatch(this)">

                                                    @if (temp.Count() > 1)
                                                    {
                                                        if (@temp[0] == @temp[1])
                                                        {
                                                            <i id="icon-@nm[0]" class="fa fa-check-circle" style="font-size:20px;color:green;margin-left:3px;"></i>
                                                            <i id="iconx-@nm[0]" class="fa fa-times-circle" style="display:none; font-size:20px;color:red;"></i>
                                                            @*<p id="mes" style="color: forestgreen; font-weight: bolder;">Matched</p>*@
                                                        }
                                                        else
                                                        {
                                                            <i id="icon-@nm[0]" class="fa fa-check-circle" style="display:none; font-size:20px;color:green;margin-left:3px;"></i>
                                                            <i id="iconx-@nm[0]" class="fa fa-times-circle" style="font-size:20px;color:red; "></i>
                                                        }
                                                    }



                                                </div>
                                            </div>

                                        </div>


                                    }
                                    else
                                    {
                                        <div class="row">

                                            <div class="col-md-12">
                                                <div class="d-flex gap-4">
                                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off" maxlength="@nm[5]" data-ref="@temp[0]" oninput="checkMatch(this)">

                                                    @if (temp.Count() > 1)
                                                    {
                                                        if (@temp[0] == @temp[1])
                                                        {
                                                            <i id="icon-@nm[0]" class="fa fa-check-circle" style="font-size: 20px; color: green; margin-left:3px;"></i>
                                                            <i id="iconx-@nm[0]" class="fa fa-times-circle" style="display:none; font-size:20px;color:red;"></i>
                                                            @*<p id="mes" style="color: forestgreen; font-weight: bolder;">Matched</p>*@
                                                        }
                                                        else
                                                        {
                                                            <i id="icon-@nm[0]" class="fa fa-check-circle" style="display:none; font-size:20px;color:green;margin-left:3px;"></i>
                                                            <i id="iconx-@nm[0]" class="fa fa-times-circle" style="font-size:20px;color:red; "></i>
                                                        }
                                                    }



                                                </div>

                                            </div>


                                        </div>

                                    }



                                </div>

                            }
                        }
                        if (@nm[2] == "dropdown")
                        {
                            <div class="col-md-4">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7 style="color:red!important;">*</h7>
                                    }
                                    else
                                    {
                                        <h7 style="color:red!important;">&nbsp;</h7>
                                    }
                                }
                                @nm[1]
                            </div>

                            <div class="col-md-4">

                                @if (temp.Count() > 1)
                                {
                                    @temp[0]
                                }
                            </div>
                            <div class="col-md-4">



                                <div class="row">
                                    <div class="col-md-12 ">
                                        <div class="d-flex gap-4">

                                            @nm[4]
                                            @{
                                                int lastindex = nm.Length;
                                                string[] nmOption = nm[lastindex - 1].Split(',');
                                                string Fvalue = nm[lastindex - 2].ToString();
                                            }
                                            <select name=@nm[0] id='@nm[0]' autocomplete="off" class="form-control" data-ref="@temp[0]" onchange="checkMatch(this)">
                                                @for (int i = 0; i < nmOption.Length; i++)
                                                {
                                                    if (@nmOption[i].Trim() == Fvalue)
                                                    {
                                                        <option selected>@nmOption[i]</option>

                                                    }
                                                    else
                                                    {

                                                        <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                                    }

                                                }
                                            </select>


                                            @if (@temp[0] == Fvalue)
                                            {
                                                <i id="iconx-@nm[0]" class="fa fa-times-circle" style="display:none; font-size:20px;color:red;"></i>
                                                <i id="icon-@nm[0]" class="fa fa-check-circle" style="font-size:20px;color:green; margin-left:3px;"></i>
                                            }
                                            else
                                            {
                                                <i id="icon-@nm[0]" class="fa fa-check-circle" style="display:none; font-size:20px;color:green;margin-left:3px;"></i>
                                                <i id="iconx-@nm[0]"  class="fa fa-times-circle" style="font-size:20px;color:red; "></i>
                                            }

                                        </div>
                                    </div>
                                </div>





                            </div>

                        }
                        if (@nm[2] == "checkbox")
                        {
                            <div class="row">
                                <div class="col-sm-4" style="padding-top:10px!important;">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm-2" style="padding-top:10px!important; text-align:left;">

                                    @{
                                        if (@nm[6] == "TRUE")
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                        }
                                        else
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                        }
                                    }

                                </div>
                                <div class="col-sm-4">
                                    @nm[4]
                                </div>
                            </div>
                        }
                        if (@nm[2] == "fileUpload")
                        {
                            <div class="row">
                                <div class="col-sm-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm-4">
                                    <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                </div>
                                <div class="col-sm-4">
                                    @nm[4]
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            <div class="row">
                <div class="col-sm-12 cytoscape-parent">
                    <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                </div>
            </div>


            if (Designation != "Team Member-PV-QC")
            {
                <div class="row">
                    <div class="col-md-4">
                        Select Disposition :
                    </div>
                    <div class="col-md-8">
                        @Html.DropDownList("CDispositionRowId",
                                                                new SelectList(ViewBag.Disposition, "DispositionRowId", "Disposition"),
                                                                "-- Select -- ",
                                                                new { @class = "form-control" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        Report Comment :
                    </div>
                    <div class="col-md-8">
                        <textarea name="Remarks" id="Remarks" rows="5" cols="8">@ReportComments</textarea>
                    </div>
                </div>
                <div class="row" style="margin-top:10px;">
                    <div class="col-md-3">
                        Severity :
                    </div>
                    <div class="col-md-3">
                        @Html.Editor("Severity", new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                    <div class="col-md-3">
                        Color :
                    </div>
                    <div class="col-md-3">
                        @Html.Editor("ColorName", new { htmlAttributes = new { @class = "form-control", @disabled = "disabled", @name = "ColorName" } })
                    </div>
                </div>

                if (CheckStatusid == "58")
                {
                    <div class="row">
                        <div class="col-md-4">
                            Amount :
                        </div>
                        <div class="col-md-8">
                            @Html.Editor("Amount", new { htmlAttributes = new { @class = "form-control", @name = "Amount" } })

                        </div>
                    </div>
                }

            }

            <div class="row" style="margin-top:30px!important; margin-bottom:40px!important;">
                @if (Designation == "Team Member-Edu-QC")
                {
                    <div class="col-md-4" style="text-align:end!important;">
                        @Html.ActionLink("Back", "DepartmentTeamMemberQCChecks", "Verification", new { CheckStatusId = CheckStatusid }, new { @class = "btn btn-default VerEmailDetails", @style = "padding:5px 20px 5px 20px!important;" })
                    </div>
                    //if (Model.CheckStatus != "Allocated-TM")
                    if (CheckStatusid == "70" || CheckStatusid == "71" || CheckStatusid == "24" || CheckStatusid == "25" || CheckStatusid == "53" || CheckStatusid == "74" || CheckStatusid == "58" || CheckStatusid == "114" || CheckStatusid == "117")
                    {
                        <div class="col-md-4" style="text-align:center!important;">
                            <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" name="action" style="padding:5px 20px 5px 20px!important;" />

                        </div>
                        <div class="col-md-4">
                            <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Rejected" name="action" style="padding:5px 20px 5px 20px!important;" />
                        </div>
                    }
                }

            </div>
        }

    </div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/tinymceNew.min.js"></script>
    <script src="~/Scripts/tinymce-jquery.min.js"></script>

    <script>
        $('textarea').tinymce({
            height: 200,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | removeformat | help'
        });
        // Prevent jQuery UI dialog from blocking focusin
        $(document).on('focusin', function (e) {
            if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                e.stopImmediatePropagation();
            }
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#172').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+0",
            });
            var dNow = new Date();
            var localdate = (dNow.getFullYear() + '-' + (dNow.getMonth() + 1) + '-' + dNow.getDate());
            $('#OrderDate').val(localdate);
            $('#goBack').click(function () {
                parent.history.back();
                return false;
            });
        });
        $("#172").keypress(function (e) {
            return false;
        });
        $("#172").keydown(function (e) {
            return false;
        });
    </script>
    <script>
        $(document).ready(function () {
            var dispid = '@ViewBag.CDispositionName';
            var Severityid = '@ViewBag.Severityid';
            var ColorName = '@ViewBag.ColorName';
            var Remarks = '@ViewBag.ReportComments';
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            //For Clouse details
            $("#CDispositionRowId option:selected").each(function () {
                var $this = $(this);
                if ($this.length) {
                    var selText = $this.text();
                    var SelectDispositionID = $this.val();
                    $('#hdnDispositionID').append(SelectDispositionID + ',');
                    SelectDispositionID += $this.val() + ',';
                    if ($('#CDispositionRowId').val() == '') {
                        $('#CDispositionRowId').append(selText + '\n');
                    }
                    if (dispid!='')
                    {
                        $('#CDispositionRowId').val(dispid);
                        $('#hdnDispositionID').val(dispid);
                        $('#hdnSeverity').val(Severityid);
                        $('#ColorsName').val(ColorName);
                        $('#Remarks').val(Remarks);
                    }
                }
            });

            $("#CDispositionRowId").change(function () {
                $('#selected').html(' ');
                var SelectDispositionID = '';
                $("#CDispositionRowId option:selected").each(function () {
                    var $this = $(this);
                    if ($this.length) {
                        var selText = $this.text();
                        SelectDispositionID += $this.val() + ',';
                        //console.log(selText);
                        $('#selected').append(selText + '\n');
                    }
                });
                if (SelectDispositionID.length > 0) {
                    SelectDispositionID = SelectDispositionID.substring(0, SelectDispositionID.length - 1);
                } else { SelectDispositionID = ''; }
                $('#hdnDispositionID').val(SelectDispositionID);

            });

            $(function () {
                $('#CDispositionRowId').change(function () {
                    var url = "/Verification/GetSeverityColor?ClientRowId=" + $("#clientRowId").val() + "&Dispositions=" + $("#hdnDispositionID").val();
                    $.ajax({
                        url: url,
                        type: 'GET',
                        async: false,
                        dataType: 'json',
                        success: function (colors) {
                            $('#Severity').val(colors.SeverityName);
                            $('#ColorName').val(colors.ColorName);
                            $('#ColorsName').val(colors.ColorName);
                            $('#hdnSeverity').val(colors.SeverityRowId);

                        }
                    });
                });
            });
        });

        $(document).ready(function () {
        var text1 = $('#HfdegreeName').val();
        $('#HfdegreeName').val(text1);
        if ($('#72').val() != null) {
            $.getJSON('/Master/GetDegreeList/', function (data) {
                var items = '<option value="">-- Select Degree --</option>';
                $.each(data, function (i, degree) {
                    items += "<option value='" + degree.Value + "'>" + degree.Text + "</option>";
                });
                $('#72').html(items);
                $("#72 option").filter(function () {
                    return this.text == text1;
                }).attr('selected', true);
            });
               }

            if ($("#EV_Colg_Schl_Inst_Name").val() != null) {
                var url = "/ProvidedInfo/AffiliatedCollege/" + $("#EV_Colg_Schl_Inst_Name").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (AfflCollage) {
                        $('#strEV_Affl_University_Name').val(AfflCollage);
                    }
                });
            }
        });

        $(function () {


            $('#72').change(function () {

                $('#HfdegreeName').val($('#72 option:selected').text());

            });
        });

        function validateFormApprove() {
            var CheckStatusid = '@ViewBag.CheckStatusid';
            if ((CheckStatusid == '53' || CheckStatusid == '58') && ($('#Remarks').val() == '')) {
                alert("Please mention the reason!");
                $('#Remarks').focus();
                return false;
            }
            else
            {
                //event.preventDefault();
                //// Turn off the "Save" button and change text
                //$(ctl).prop("disabled", true).val(msg);
                //// Gray out background on page
                //$("body").addClass("submit-progress-bg");
                //// Wrap in setTimeout so the UI can update the spinners
                //$(".submit-progress").removeClass("hidden");
                ////submit the form.
                //setTimeout(function () {
                //    $("form").submit();
