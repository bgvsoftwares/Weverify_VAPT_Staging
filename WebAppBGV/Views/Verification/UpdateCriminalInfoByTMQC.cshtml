        });
    </script>
    <script>
        function checkMatch(inputEl) {
            debugger;
            const refValue = inputEl.getAttribute("data-ref").trim();
            const inputValue = inputEl.value.trim();

            const checkIcon = document.getElementById("icon-" + inputEl.id);
            const crossIcon = document.getElementById("iconx-" + inputEl.id);


            if (!checkIcon || !crossIcon) return;


            if (inputValue === refValue) {
                checkIcon.style.display = "inline-block";
                crossIcon.style.display = "none";
            } else {
                checkIcon.style.display = "none";
                crossIcon.style.display = "inline-block";
            }
        }


        document.addEventListener("DOMContentLoaded", function () {
            const inputs = document.querySelectorAll(".match-input");
            inputs.forEach(el => checkMatch(el));
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            var cli = $("#clientRowId").val();
            $('#171').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+0",
            });
            if (cli === "1680") {
                $("#645").attr("placeholder", "DD-MM-YYYY");
                $("#645").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });
                $("#646").attr("placeholder", "DD-MM-YYYY");
                $("#646").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });

                function updateDurationStay() {
                    var fromVal = $("#645").val();
                    var toVal = $("#646").val();

                    if (fromVal && toVal) {
                        $("#60").val(fromVal + " to " + toVal);
                    }
                }
            }

            if (cli == 446) {
                $("#60").attr("placeholder", "DD-MM-YYYY");
                $("#60").datepicker({
                    dateFormat: 'dd-MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true
                });
            }
            var dNow = new Date();
            var localdate = (dNow.getFullYear() + '-' + (dNow.getMonth() + 1) + '-' + dNow.getDate());
            $('#OrderDate').val(localdate);
            $('#goBack').click(function () {
                parent.history.back();
                return false;
            });
        });

        //$('#172').bind('copy paste cut', function (e) {
        //    e.preventDefault();
        //    alert('cut,copy & paste options are disabled !!');
        //});
        var cli1 = $("#clientRowId").val();
        $("#171").keypress(function (e) {
            return false;
        });
        $("#171").keydown(function (e) {
            return false;
        });
    </script>
}

