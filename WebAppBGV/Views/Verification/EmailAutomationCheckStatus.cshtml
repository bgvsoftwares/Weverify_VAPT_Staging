@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("EmailAutomationCheckStatus", "Verification", FormMethod.Get))
                        {
                        <div class="form-horizontal">
                            <div class="form-group branch search-frame">
                                <label class="col-md-2 control-label">Keyword :</label>
                                <div class="col-md-8">
                                    @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Securitas Id..." })
                                </div>
                            </div>
                            <div class="form-group branch">
                                @Html.Label("Select Client", htmlAttributes: new { @class = "col-md-2 control-label required" })
                                <div class="col-md-8">
                               
                                    @Html.DropDownList("CheckStatusId",
                                new SelectList(ViewBag.CheckId, "CheckStatusId", "Checkstatus"),
                                "-- Select Check Status -- ",
                                new { @class = "form-control", @id = "CheckStatusId" })
                                </div>
                                <div class="row">
                                    @*@Html.ActionLink("Export to Excel", "ExportCaseStatus", "ClientServicing", new { @class = "btn bun-bg btn-default", id = "btnExportCaseStatus" })*@

                                    @*<input type="button" id="btnExportCaseStatus" value="Export to Excel" class="btn bun-bg btn-default" />
                                    <input type="button" id="btnE2EMIS" value="MIS" class="btn bun-bg btn-default" />*@

                                </div>
                            </div>

                            <div class="form-group branch search-frame">
                                <label class="col-md-2 control-label">Recieving Date :</label>
                                <div class="col-md-3">
                                    @Html.TextBox("datefrom", null, new { @class = "form-control", @id = "datefrom", @placeholder = "mm-dd-yyyy" })
                                </div>
                                <label class="col-md-2 control-label">Completed Date :</label>
                                <div class="col-md-3">
                                    @Html.TextBox("dateTo", null, new { @class = "form-control", @id = "dateTo", @placeholder = "mm-dd-yyyy" })
                                </div>
                            </div>
                            <div class="form-group branch search-frame">
                                @{
                                    if (Request.QueryString["CaseStatus"] != null)
                                    {
                                        @Html.Hidden("CaseStatus", Request.QueryString["CaseStatus"].ToString())
                                    }
                                }
                                <div style="text-align:center;">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />

                                    @Html.ActionLink("Excel", "ExportAutomationMIS", "Verification", new { Export = 1}, new { @class = "btn bun-bg btn-default" })
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.EmailAutomationCheckStatusMIS != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.EmailAutomationCheckStatusMIS, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"col-md-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "CompanyRefNo", header: "CompanyRefNo", canSort: false, style:"col-md-1"),
                                   // grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"col-md-2"),
                                     
                                    grid.Column(columnName: "CheckName", header: "CheckName", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "Subject", header: "Subject", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "UpdatedOn", header: "Updated On", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "MainStatus", header: "Main Status", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "SubStatus", header: "Sub Status", canSort: false, style:"col-md-1"),



                                }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "60%", height: "80%" });

            $('#datefrom').datepicker({
                dateFormat: "mm-dd-yy",
                changeMonth: true,
                changeYear: true,
                //showButtonPanel: true,
                yearRange: "-66:+0",
            });
            $('#dateTo').datepicker({
                dateFormat: "mm-dd-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}

