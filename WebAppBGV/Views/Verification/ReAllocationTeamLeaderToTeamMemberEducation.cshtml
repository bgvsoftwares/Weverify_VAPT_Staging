
@{
    ViewBag.Title = "TeamLeader Case Re-Allocation To TeamMember";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@{
    string tatdays1 = "";
    string CheckStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatdays"] != null)
    {
        tatdays1 = Request.QueryString["tatdays"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CheckStatus"] != null)
    {
        CheckStatus1 = @Request.QueryString["CheckStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportChecksReport", "Verification", new { CheckStatus = "ReAllocated" }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}

@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="container-fluid">
    @using (Html.BeginForm("ReAllocationTeamLeaderToTeamMemberEducation", "Verification", FormMethod.Get))
    {
        <div class="row row-sm">
            <div class="col-md-2">
                <label class="ontrol-label">Keyword :</label>
            </div>
            <div class="col-lg-4 col-md-4">
                @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
            </div>
            <div class="col-md-2">
                <label class="control-label">Team Member :</label>
            </div>
            <div class="col-md-4">
                @Html.DropDownList("SearchMemberRowID",
                                            new SelectList(ViewBag.depTM, "TeamMemberRowID", "TeamMemberName"),
                                            "-- Select Member -- ",
                                            new { @class = "form-control" })
            </div>
        </div>
        <div class="row row-sm justify-content-center mt-3 mb-3">
            <div class="col-md-3 text-center">
                <input class="btn bun-bg btn-default p-3" type="submit" onclick="SearchFunction()" value="Search" style="width: 133px!important;" />
            </div>
        </div>

        <div class="row row-sm">
            <div class="col-md-2">
                <label class="control-label">Select TeamMember :</label>
            </div>
            <div class="col-md-4">
                @Html.DropDownList("AllocateTM",
                   new SelectList(ViewBag.depTM, "TeamMemberRowID", "TeamMemberName"),
                   "-- Select Member -- ",
                   new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <label class="control-label">Select TeamMember-QC :</label>
            </div>
            <div class="col-md-4">
                @Html.DropDownList("AllocateTMQC",
                     new SelectList(ViewBag.depTMQC, "TeamMemberRowID", "TeamMemberName"),
                     "-- Select Member -- ",
                     new { @class = "form-control" })
            </div>
        </div>
        <div class="row row-sm justify-content-center mt-3 mb-3">
            <div class="col-md-3 text-center">
                <input class="btn bun-bg btn-default p-3" type="submit" id="btnAllocation" onclick="return validateForm()" value="Allocate" style="width: 133px!important;" />
            </div>
        </div>
        <div class="form-horizontal">
            <div class="form-group branch search-frame">
                @Html.Hidden("VerificationIds", null)
                @Html.Hidden("OCVerIDs", null)
                @if (Request.QueryString["CheckStatus"] != null)
                {
                    @Html.Hidden("CheckStatus", Request.QueryString["CheckStatus"].ToString())
                }
            </div>
        </div>
    }


    @if (Model != null && Model.PQVerificationInfo != null)
    {
        <div class="row">
            <div class="col-md-12">
                @{

                    WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                    grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                }
                @grid.GetHtml(
               htmlAttributes: new { id = "grid", @class = "table" },
               headerStyle: "thead-inverse",
               rowStyle: "ordertxt",
               footerStyle: "custpaging",
               mode: WebGridPagerModes.All,
               columns: new[]
               {
                   grid.Column(header: "{checkall}",format: @<text> <input type="checkbox" value="@(item.VerificationRowID+"_"+item.CheckFamilyRowID)" name="verificationId" class="verificationId" style="width: 10rem!important" /> </text>),
                                                                   grid.Column(header: "No.",style:"td-2", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                                   grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-2"),
                                                                   grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"td-2"),
                                                                   grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"td-2"),
                                                                   grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-2"),
                                                                   grid.Column(columnName: "AllocatedTMName", header: "OPTM Name", canSort: false, style:"td-2"),
                                                                   grid.Column(columnName: "AllocatedQCName", header: "OPQC Name", canSort: false, style:"td-2"),
                                                                   grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:"td-2"),
                                                                              }
                                                                              )
                <div class="total-record">Total Records: @Model.TotalRecords</div>
            </div>
        </div>
    }
</div>
@section Scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            // 1st replace first column header text with checkbox
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "", style:"width: 10rem!important;" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });

            //2nd click event for header checkbox for select /deselect all
            $('#select_all').change(function () {
                $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                var VerificationIds = '';
                var OCVerIDs = '';
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';
                        OCVerIDs += this.value + ',';
                    }
                });
                if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                    OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
                } else {
                    VerificationIds = '';
                    OCVerIDs = '';
                }
                $('#VerificationIds').val(VerificationIds.trim());
                $('#OCVerIDs').val(OCVerIDs.trim());
            });
        });

        function SearchFunction() {
            $('#VerificationIds').val("");
        }

        //3rd click event for checkbox of each row
        $(document).on('change', 'input[class="verificationId"]', function (e) {// on change of state
            var VerificationIds = '';
            var OCVerIDs = '';
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) {
                    var id = this.value.split('_');
                    VerificationIds += id[0] + ',';
                    OCVerIDs += this.value + ',';
                }
            });

            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("#select_all").prop('checked', false); //change "select all" checked status to false
            }
            //check "select all" if all checkbox items are checked
            if ($('.verificationId:checked').length == $('.verificationId').length) {
                $("#select_all").prop('checked', true);
            }

            if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
            } else {
                VerificationIds = '';
                OCVerIDs = '';
            }
            $('#VerificationIds').val(VerificationIds.trim());
            $('#OCVerIDs').val(OCVerIDs.trim());
        })

        function validateForm() {
            if ($("#AllocateTM").val() == 0 && $("#AllocateTMQC").val() == 0) {
                alert("Select  Member For Allocate.");
                return false;
            }


            var count = 0;
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one case.");
                return false;
            }
            return true;
        }
    </script>
}


