@model dynamic


@{
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "ManageRWQCApprovalChecksForDepartmentTL", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));


    string Designation = "";
    if (Session["Designation"] != null)
    {
        Designation = Session["Designation"].ToString();
        //ViewBag.Title = "Add Employment Info (" + Convert.ToString(Session["CandidateName"]) + ")";
    }//

    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CheckStatusid = "";


    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CheckStatusid = @ViewBag.CheckStatusid;
    string CDispositionName = ViewBag.CDispositionName;
    string ReportComments = ViewBag.ReportComments;
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>
        </tr>

        <tr>
            <td>@Html.Partial("_CaseDocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("MailList")</td>
        </tr>
        <tr>
            <td>
                @Html.Partial("_DocumentEDUList")
            </td>
        </tr>

    </table>
    @if (ViewBag.SpocActionRemark != null)
    {
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td colspan="2">
                    <div class="col-12 personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>  Spoc Remark :</div>
                </td>
            </tr>
            <tr>
                @foreach (var item in ViewBag.SpocActionRemark)
                {
                    if (item.PriorityType == "High")
                    {
                        <td style="font-weight: bold; background-color: #ff0000; color: white; width: 5%; ">High</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color:azure;"> @item.SpocRemark </p>
                        </td>
                    }
                    else
                    {
                        <td style="font-weight: bold; background-color: #02fd58; width: 5%; ">Low</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color: azure; "> @item.SpocRemark </p>
                        </td>
                    }
                }
            </tr>
        </table>
    }
<div class="row">
    @using (Html.BeginForm("UpdateEducationVerInfoByTeamLeader", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
        @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SubCheckId>
        @Html.Hidden("SubCheckId", SubCheckId.ToString())

        <input id="clientRowId" type="hidden" value=@clientRowId>
        @Html.Hidden("clientRowId", clientRowId.ToString())

        <input id="CheckStatusid" type="hidden" value=@CheckStatusid>
        @Html.Hidden("CheckStatusid", CheckStatusid.ToString())



        <input id="hdnDispositionID" type="hidden" name="hdnDispositionID">
        <input id="hdnSeverity" type="hidden" name="hdnSeverity">
        <input id="ColorsName" type="hidden" name="ColorsName">



        @Html.ValidationSummary()

        foreach (var category in Model)
        {
            <div class="container">
                @{
                    string[] nm = category.Key.Split('_');
                    string[] temp = category.Value.Split('_');
                    @Html.Hidden("CheckStatusid", CheckStatusid.ToString())
                    if (@nm[2] == "textbox")
                    {
                        <div class="row" style="margin-bottom:.10rem!important; width:70rem;">

                            <div class="col-sm-4" style="padding-top:10px!important;">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7>*</h7>
                                    }
                                }
                                @nm[1]
                            </div>
                            <div class="col-sm-4">


                                <p> @temp[0]</p>
                            </div>

                            <div class="col-sm-4">
                                @if (temp.Count() > 1)
                                {
                                    <label name=@nm[0] id=@nm[0]>@temp[1]</label>
                                }
                                else
                                {
                                    <label name=@nm[0] id=@nm[0]>@temp[0]</label>
                                }

                            </div>


                        </div>
                    }
                    if (@nm[2] == "dropdown")
                    {
                        <div class="row">

                            <div class="col-sm-4">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7>*</h7>
                                    }
                                }
                                @nm[1]
                            </div>
                            <div class="col-sm-4">
                                @{
                                    string[] nmOption = nm[7].Split(',');
                                }
                                <select name=@nm[0] id=@nm[0]>
                                    @for (int i = 0; i < nmOption.Length; i++)
                                    {
                                        if (@nmOption[i].Trim() == @nm[6])
                                        {
                                            <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                        }
                                        if (@nmOption[i].Trim() != @nm[6])
                                        {
                                            <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                        }
                                    }
                                </select>

                            </div>
                            <div class="col-sm-4">
                                @nm[4]
                            </div>
                        </div>

                    }
                    if (@nm[2] == "checkbox")
                    {
                        <div class="row">
                            <div class="col-sm-4" style="padding-top:10px!important;">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7>*</h7>
                                    }
                                }
                                @nm[1]
                            </div>
                            <div class="col-sm-2" style="padding-top:10px!important; text-align:left;">

                                @{
                                    if (@nm[6] == "TRUE")
                                    {
                                        <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                    }
                                    else
                                    {
                                        <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                    }
                                }

                            </div>
                            <div class="col-sm-4">
                                @nm[4]
                            </div>
                        </div>
                    }
                    if (@nm[2] == "fileUpload")
                    {
                        <div class="row">
                            <div class="col-sm-4">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7>*</h7>
                                    }
                                }
                                @nm[1]
                            </div>
                            <div class="col-sm-4">
                                <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                            </div>
                            <div class="col-sm-4">
                                @nm[4]
                            </div>
                        </div>

                    }
                }

            </div>

        }
        <div class="row">
            <div class="col-sm-12 cytoscape-parent">
                <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
            </div>
        </div>




        if (Designation != "Team Member-PV-QC")
        {
            <div class="row">
                <table style="width:100%!important">

                    <tr>
                        <td>
                            <table>
                                <tr class="personal_heading">
                                    <td>Severity :</td>
                                    <td>
                                        <label id="Severity">@ViewBag.Severity </label>
                                    </td>
                                    <td align="right">Color :</td>
                                    <td>
                                        <label id="ColorName">@ViewBag.ColorName</label>
                                    </td>
                                </tr>


                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        }


        <div class="row">

            @if (Designation == "Team Leader-Edu" && CheckStatusid == "19")
            {
                if (Session["TeamMemberRowID"].ToString() == "998")
                {

                    var TMAllocatedTo = @ViewBag.TMAllocatedTo;
                    <input id="TMAllocatedTo" type="hidden" name="TMAllocatedTo" value="@TMAllocatedTo">
                }

                <table>
                    <tr class="personal_heading btmborder">
                        <td width="20%">Action Remarks :</td>
                        <td colspan="2">
                            @Html.TextArea("Remark", new { @class = "form-control ", @id = "selected", @rows = "1" })

                        </td>
                        <td width="1%">&nbsp;</td>
                    </tr>
                    <tr class="personal_heading btmborder">
                        <td colspan="4" class="personal-details-head" align="center">
                            @{
                                <input class="btn bun-bg btn-default" name="action" onclick="return validateFormReject()" type="submit" value="Reject" />
                                <input class="btn bun-bg btn-default" name="action" type="submit" value="Approve" />
                            }
                        </td>


                    </tr>
                </table>
            }
            else if (Designation == "Team Leader-Edu" && CheckStatusid == "54")
            {
                <div class="container">
                    <div class="row">
                        <div class="col-md-4">
                            Action Remarks :
                        </div>
                        <div class="col-md-8">
                            <textarea name="Remark" id="selected" rows="5" class="form-control">@ReportComments</textarea>
                        </div>
                    </div>
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-sm">
                            @{
                                <input class="btn bun-bg btn-default" name="action" onclick="return validateFormReject()" type="submit" value="Reject" />
                                <input class="btn bun-bg btn-default" name="action" type="submit" value="Approve" />
                            }
                        </div>
                        <div class="col-sm">
                            &nbsp;
                        </div>
                    </div>
                </div>
                <div class="container">
                    <div class="col-sm">
                        &nbsp;
                    </div>
                </div>
            }

        </div>

        <div class="row">
            <div class="container">
                <div class="col-sm">
                    &nbsp;
                </div>
            </div>
        </div>

    }
</div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {

            var dispid = '@ViewBag.CDispositionName';
            var Severityid = '@ViewBag.Severityid';
            var ColorName = '@ViewBag.ColorName';
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({

                onClosed: function () {
                    //alert('onClosed: colorbox has completely closed');
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            //For Clouse details
            $("#CDispositionRowId option:selected").each(function () {
                var $this = $(this);


                if ($this.length) {
                    var selText = $this.text();
                    var SelectDispositionID = $this.val();
                    $('#hdnDispositionID').append(SelectDispositionID + ',');
                    SelectDispositionID += $this.val() + ',';
                    //console.log(selText);
                    if ($('#CDispositionRowId').val() == '') {
                        $('#CDispositionRowId').append(selText + '\n');
                    }
                    if (dispid != '') {
                        $('#CDispositionRowId').val(dispid);
                        $('#hdnDispositionID').val(dispid);
                        $('#hdnSeverity').val(Severityid);
                        $('#ColorsName').val(ColorName);





                    }


                    //alert('1');
                    //alert($('#hdnDispositionID').val());
                }
            });            $("#CDispositionRowId").change(function () {
                $('#selected').html(' ');

                var SelectDispositionID = '';
                $("#CDispositionRowId option:selected").each(function () {
                    var $this = $(this);
                    if ($this.length) {
                        var selText = $this.text();
                        SelectDispositionID += $this.val() + ',';
                        //console.log(selText);
                        $('#selected').append(selText + '\n');
                    }
                });
                if (SelectDispositionID.length > 0) {
                    SelectDispositionID = SelectDispositionID.substring(0, SelectDispositionID.length - 1);
                } else { SelectDispositionID = ''; }
                $('#hdnDispositionID').val(SelectDispositionID);

            });

            $(function () {
                $('#CDispositionRowId').change(function () {

                    var url = "/Verification/GetSeverityColor?ClientRowId=" + $("#clientRowId").val() + "&Dispositions=" + $("#hdnDispositionID").val();
                    $.ajax({
                        url: url,
                        type: 'GET',
                        async: false,
                        dataType: 'json',
                        success: function (colors) {
                            $('#Severity').val(colors.SeverityName);
                            $('#ColorName').val(colors.ColorName);
                            $('#ColorsName').val(colors.ColorName);
                            $('#hdnSeverity').val(colors.SeverityRowId);

                        }
                    });
                });
            });
        });
    </script>
    <style>
        img {
            width: 50px;
            height: 25px;
        }
    </style>
}