@{
    ViewBag.Title = "Bulk Closure";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row"><div class="col-md-12">&nbsp;</div></div>
<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group branch search-frame text-center">
                        @if (ViewBag.Message != null)
                        {
                            <center>@ViewBag.Message</center>
                        }
                        @if (TempData["Success"] != null)
                        {
                            <center>@TempData["Success"]</center>
                        }
                        <center><b style="color:red; font-size:16px;">Date of Verification will be like e.g 30-Dec-2024 in Excel </b></center><br />


                        <form id="uploadForm" action="@Url.Action("BulKClosureEmployement", "verification")" method="post" enctype="multipart/form-data">
                            <b style="font-size:12px;">Common Artifact Bulk closure</b>
                            <label style="font-weight:bold;float:left;"> Upload Excel </label>
                            <input type="file" name="fileUpload" accept=".xls,.xlsx" class="form-control" required /><br><br />
                            <label style="font-weight:bold;float:left"> Upload File </label>
                            <input type="file" name="fileUpload1" accept=".pdf,.png,.jpeg,.jpg" class="form-control" required />
                            <div style="margin-top:10px;">
                                <input type="submit" value="Upload Excel File" class="btn btn-primary" />
                                <a href="@Url.Action("DownloadDummyExcelEmp", "verification")" class="btn bun-bg btn-default">Download Dummy Excel File</a>
                            </div>

                        </form>

                        <br />
                        <br />
                        <hr />
                        <br />
                        <br />

                        <form id="uploadForm" action="@Url.Action("BulKClosureEmployement1", "verification")" method="post" enctype="multipart/form-data">
                            <b style="font-size:12px;">Different Artifact Bulk closure</b>
                            <label style="font-weight:bold;float:left;"> Upload Excel </label>
                            <input type="file" name="fileUpload" accept=".xls,.xlsx" class="form-control" required /><br><br />
                            @*<label style="font-weight:bold;float:left"> Upload File </label>
            <input type="file" name="fileUpload1" accept=".pdf,.png,.jpeg,.jpg" class="form-control" required />*@
                            <div style="margin-top:10px;">
                                <input type="submit" value="Upload Excel File" class="btn btn-primary" />
                                <a href="@Url.Action("DownloadDummyExcelEmp1", "verification")" class="btn bun-bg btn-default">Download Dummy Excel File</a>
                            </div>

                        </form>

                        <!-- Download Link -->
                        <!-- Other Button -->

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



