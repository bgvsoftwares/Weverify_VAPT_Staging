<div class="row">
    <div class="col-md-12 table table-striped">
        @{

            WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
            grid.Bind(Model.comperative_Tigerlsts, autoSortAndPage: false, rowCount: Model.TotalRecords);
        }
        @{
            @grid.GetHtml(
                                      htmlAttributes: new { id = "grid", @class = "table table-striped table-responsive" },
                                      headerStyle: "thead-inverse",
                                      rowStyle: "ordertxt",
                                      footerStyle: "custpaging",
                                      mode: WebGridPagerModes.All,
                                      columns: new[]
                                      {
                                                                   grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                                   grid.Column(columnName: "CompanyName", header: "Company Name", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "StartDate", header: "Start Date", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "EndDate", header: "End Date", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "CompanyNameOnboarding", header: "Company Name Onboarding", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "StartDateOnboarding", header: "Start Date Onboarding", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "EndDateOnboarding", header: "End Date Onboarding", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "CompanyNameUAN", header: "Company Name UAN", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "StartDateUAN", header: "Start Date UAN", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "EndDateUAN", header: "End Date UAN", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "Remarks", header: "Remarks", canSort: false, style:"td-1"),
                                                                   grid.Column(columnName: "EmailVerification", header: "Email Verification", canSort: false, style:"td-1"),

                                                                   grid.Column(header: "Action",format:@<text><a class="btn btn-primary " href=@Url.Action("Comperative_Tiger", "Verification", new { id =item.ID})><span class="txt" style="color:#FFF!important;">Edit</span></a></text>),
grid.Column(header: "Action",format:@<text><a class="btn btn-primary " href=@Url.Action("Comperative_Tiger_Remove", "Verification", new { id =item.ID})><span class="txt" style="color:#FFF!important;">Remove</span></a></text>),

}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     );
        }
    </div>
</div>

