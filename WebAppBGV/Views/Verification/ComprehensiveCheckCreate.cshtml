    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    @*<script src="~/Scripts/tinymce49.min.js"></script>
        <script src="~/Scripts/tinymce.min.js"></script>*@
    <script type="text/javascript">
        // tinymce.init({ selector: '#66', width: 800 });
    </script>
    <script type="text/javascript">
                $(document).ready(function () {
                    var ErrorMsg = '@(ViewBag.ErrorMsg)';

                    if (ErrorMsg=='')
                    {

                        //$('#VerificationCloserDetails').prop('disabled', false);
                        $('#VerificationCloserDetails').css('visibility', 'visible');
                    }
                    else
                    {

                        $('#VerificationCloserDetails').css('visibility', 'hidden');
                    }
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                //onOpen: function () { alert('onOpen: colorbox is about to open'); },
                //onLoad: function () { alert('onLoad: colorbox has started to load the targeted content'); },
                //onComplete: function () { alert('onComplete: colorbox has displayed the loaded content'); },
                //onCleanup: function () { alert('onCleanup: colorbox has begun the close process'); },
                onClosed: function () {
                    //alert('onClosed: colorbox has completely closed');
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

                //var text1 = "@(ViewBag.degreeName)";
                var text1 = $('#HfdegreeName').val();



                //$('#HfdegreeName').val(text1);


        if ($('#72').val() != null) {

            $.getJSON('/Master/GetDegreeList/', function (data) {
                var items = '<option value="">--Select--</option>';
                $.each(data, function (i, degree) {
                    items += "<option value='" + degree.Value + "'>" + degree.Text + "</option>";
                });
                $('#72').html(items);
                $("#72 option").filter(function () {
                    return this.text == text1;
                }).attr('selected', true);



            });
             }

            $("#CollegeName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Master/getAutoCollegelist",
                        type: "POST",
                        dataType: "json",
                        data: { CollegeName: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.CollegeName, value: item.CollegeId };
                            }))
                        }
                    })
                },
                minLength: 2,
                select: function (event, ui) {
                    event.preventDefault();
                },
                focus: function (event, ui) {
                    event.preventDefault();
                    $("#CollegeName").val(ui.item.label);
                    $("#CollegeNameTemp").val(ui.item.label);
                    $('#CollegeId').val(ui.item.value);

                }
            });
        })

        $("#CollegeName").blur(function () {
            if ($("#CollegeName").val() != $("#CollegeNameTemp").val()) {
                $("#CollegeName").val("");
                $('#CollegeId').val("0");
                $('#CollegeAddress').val("");
            }
        });

        $(function () {
            $('#CollegeName').change(function () {
                var CurOrg = $("#CollegeName").val();
                var url = "/ProvidedInfo/CollegeAddress/" + $("#CollegeId").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (Address) {
                        $('#CollegeAddress').val(Address);
                    }
                });
            });

            $('#72').change(function () {

                $('#HfdegreeName').val($('#72 option:selected').text());

            });
                });



    </script>

}
<style>

    .mandatory-star {
        color: red;
    }

    .btn {
        padding: 5px 40px 5px 40px !important;
    }

    input[type=text], textarea {
        width:20rem;
        padding: 22px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    select {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    label {
        padding: 12px 12px 12px 0;
        display: inline-block;
    }

    input[type=submit] {
        background-color: #04AA6D;
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        float: right;
    }

        input[type=submit]:hover {
            background-color: #45a049;
        }

    .container {
        border-radius: 5px;
        /*background-color: #f2f2f2;*/
        padding: 8px;
        font-size: 1rem !important;
        margin:0px!important;
    }
    .row{
        padding-bottom:10px!important;
    }

    .col-25 {
        float: left;
        width: 25%;
        margin-top: 6px;
    }

    .col-75 {
        float: left;
        width: 40%;
        margin-top: 6px;
        margin-left: 90px;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }


    /* Responsive layout - when the screen is less than 600px wide, make the two columns stack on top of each other instead of next to each other */
    @@media screen and (max-width: 600px) {
        .col-25, .col-75, input[type=submit] {
            width: 100%;
            margin-top: 0;
        }
    }
</style>
<style>
    .ui-widget.ui-widget-content {
        width: 20%;
