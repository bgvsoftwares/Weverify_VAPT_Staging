    <script>
        $("#grid > thead > tr").each(function () {
            $(this).find('th').each(function (index) {
                // Check if the header text is "checkFackEdu"
                if ($(this).text().trim() === "checkFackEdu") {
                    // Hide the corresponding column header
                    $(this).css("display", "none");

                    // Now hide the corresponding cells (td) in the body for that column
                    $("#grid > tbody > tr").each(function () {
                        $(this).find('td').eq(index).css("display", "none");
                    });
                }
            });
        });
    </script>
    <script>
        $('#grid > tbody > tr').each(function () {
            var sixthTdValue = $(this).find('td:nth-child(2)').text();
            var columnIndex = $("table thead th").filter(function () {
                return $(this).text().trim() === "Client Name";
            }).index() + 1;
            var client = $(this).find("td:nth-child(" + columnIndex + ")").text();
            if (sixthTdValue == "fake") {
                if (client == "LTIMindtree Limited") {
                    $(this).css('background-color', '#7179bf');
                } else {
                    $(this).css('background-color', '#F8D7DA');
                }
            }
            else if (sixthTdValue == "Capgeminivendorsupp") {
                $(this).css('background-color', '#34eb9b');
            }
            else {
                //$(this).css('background-color', '#f2f2f2');
            }
        });
    </script>

    <script>
        $('#ChkExportExcel').change(function () {
            if (this.checked) {
                document.getElementById("btnExportExcel").style.display = "block";
            }
            else {
                document.getElementById("btnExportExcel").style.display = "None";
            }
        });

        $(document).ready(function () {
            $('#ChkExportExcel').val() = false;
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            // 1st replace first column header text with checkbox
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });

            var cID = 0;
            cID = $('#ClientRowID').val();
            $("#btnAllocation").attr("disabled", true);
            $("#AllocateTL").attr("disabled", true);
            if (cID > 0) {
                $("#btnAllocation").attr("disabled", false);
                $("#AllocateTL").attr("disabled", false);
                $.getJSON('/Verification/GetTLMemberForAllocate/' + $('#ClientRowID').val(), function (data) {
                    var items = '<option value="0" >-- Select Member --</option>';
                    $.each(data, function (i, DETM) {
                        items += "<option value='" + DETM.Value + "'>" + DETM.Text + "</option>";
                    });
                    $('#AllocateTL').html(items);
                });
            }
            //2nd click event for header checkbox for select /deselect all
            $('#select_all').change(function () {
                $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                var VerificationIds = '';
                var OCVerIDs = '';
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';
                        OCVerIDs += this.value + ',';

                    }
                });
                if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                    OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
                } else {
                    VerificationIds = '';
                    OCVerIDs = '';
                }
                $('#VerificationIds').val(VerificationIds.trim());
                $('#OCVerIDs').val(OCVerIDs.trim());
            });

            $('#ClientRowID').change(function () {
                $("#btnAllocation").attr("disabled", true);
                $("#AllocateTL").attr("disabled", true);
            });

            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });

        function AllocatebtnShow() {
            $("#btnAllocation").attr("disabled", false);
            $("#AllocateTL").attr("disabled", false);
        }

        //3rd click event for checkbox of each row
        $(document).on('change', 'input[class="verificationId"]', function (e) {// on change of state
            var VerificationIds = '';
            var OCVerIDs = '';
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) {
                    var id = this.value.split('_');
                    VerificationIds += id[0] + ',';
                    OCVerIDs += this.value + ',';
                }
            });

            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("#select_all").prop('checked', false); //change "select all" checked status to false
            }
            //check "select all" if all checkbox items are checked
            if ($('.verificationId:checked').length == $('.verificationId').length) {
                $("#select_all").prop('checked', true);
            }

            if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
            } else {
                VerificationIds = '';
                OCVerIDs = '';
            }
            $('#VerificationIds').val(VerificationIds.trim());
            $('#OCVerIDs').val(OCVerIDs.trim());
        })

        function validateForm() {
            if ($("#AllocateTL").val() == 0) {
                alert("Select Team Leader For Allocate.");
                return false;
            }

            var count = 0;
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one case.");
                return false;
            }
            return true;
        }

    </script>
}

