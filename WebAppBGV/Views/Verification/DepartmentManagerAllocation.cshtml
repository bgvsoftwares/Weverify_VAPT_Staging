<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("DepartmentManagerAllocation", "Verification", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                         new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                         "-- Select Client -- ",
                                         new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    @if (CheckStatus1 == "Closed")
                                    {
                                        <div class="col-md-2 mg-t-5 mg-md-t-0">
                                            @Html.DropDownList("SearchType", new List<SelectListItem>
                        {
                                           new SelectListItem{Text="Securitas ID", Value="SecuritasID"},
                                           new SelectListItem{Value="CheckID", Text="Unique Check ID" },
                                           new SelectListItem{Text="Company Name",Value="CompanyName"}
                        },
                             new { @class = "form-control", style = "height:33px;" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-2 mg-t-5 mg-md-t-0">
                                            @Html.DropDownList("SearchType", new List<SelectListItem>
                        {
                                           new SelectListItem{Text="Securitas ID", Value="SecuritasID"},
                                           new SelectListItem{Value="CheckID", Text="Unique Check ID" },
                                           new SelectListItem{Value="Allocation", Text="Allocation" }
                        },
                             new { @class = "form-control", style = "height:33px;" })
                                        </div>
                                    }
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off" })
                                    </div>
                                </div>

                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">CheckStatus :</label>
