

@model dynamic
@{
    ViewBag.Title = "Send Whats App Message for Digital Verification";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("DigitalVerificationLink", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="container">
                <div class="row" style="margin-top:20px">

                    <div class="col-sm-4">
                        Download Sheet
                    </div>
                    <div class="col-sm-4">
                        <a class="ManageClientCompany" target="_blank" href='@Url.Action("DigitalVerificationTemplateDownload", "Verification",new {templateName="DigitalVerificationLink" })' style="padding: 0.35rem 0.8rem 0.35rem 0.8rem!important;"><i class="fa fa-file-excel me-2"></i>Excel Template</a>
                    </div>
                </div>
                <div class="row" style="margin-top:20px">
                    <div class="col-sm-4">
                        Execl Sheet
                    </div>
                    <div class="col-sm-4">
                        <input type="file" id="DigitalVer" name="DigitalVer" accept=".xlsx,.xls">
                    </div>
                </div>
                <div class="row" style="margin-top:20px">
                    <input class="btn bun-bg btn-default" type="submit" name="action" value="Send Whats App Message" />
                </div>
            </div>
        }
    </div>
</div>

<br />

<div class="col-sm-4">

    <strong>Send message for Not To Pay Money</strong>
</div>
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("DigitalVerificationLink2", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="container">
                <div class="row" style="margin-top:20px">

                    <div class="col-sm-4">
                        Download Sheet
                    </div>
                    <div class="col-sm-4">
                        <a class="ManageClientCompany" target="_blank" href='@Url.Action("DigitalVerificationTemplateDownload", "Verification",new {templateName="DigitalVerificationLink2" })' style="padding: 0.35rem 0.8rem 0.35rem 0.8rem!important;"><i class="fa fa-file-excel me-2"></i>Excel Template</a>
                    </div>
                </div>
                <div class="row" style="margin-top:20px">
                    <div class="col-sm-4">
                        Execl Sheet
                    </div>
                    <div class="col-sm-4">
                        <input type="file" id="DigitalVer1" name="DigitalVer1" accept=".xlsx,.xls">
                    </div>
                </div>
                <div class="row" style="margin-top:20px">
                    <input class="btn bun-bg btn-default" type="submit" name="action" value="Send Alert Message" />
                </div>
            </div>
        }
    </div>

    @if (TempData["SuccessMsg"] != null)
    {
        <script type="text/javascript">
        alert('@TempData["SuccessMsg"]');
        </script>
    }

    <style>


        select {
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
        }

            select:focus {
                outline: none;
            }
    </style>





