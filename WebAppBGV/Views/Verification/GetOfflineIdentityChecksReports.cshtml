
@model dynamic
@{
    ViewBag.Title = "Get Instant Check Report";
}
<div class="row">
    @using (Html.BeginForm("GetOfflineIdentityChecksReports" ,  "Verification", FormMethod.Post, new { enctype = "multipart/form-data", @class="edit-verfifaction-form" }))
    {
            <div class="container">
            <div class="row" style="margin-top:20px">

                <div class="col-sm-4">
                    <label class="contorl-lable">  Download Sheet</label>
                  
                </div>
                <div class="col-sm-4">
                    <a class="ManageClientCompany" target="_blank" href='@Url.Action("DigitalVerificationTemplateDownload", "Verification",new {templateName="OfflineInstantIDCheck" })' style="padding: 0.35rem 0.8rem 0.35rem 0.8rem!important;"><i class="fa fa-file-excel me-2"></i>Excel Template</a>
                </div>
            </div>

            <div class="row">
                <div class="col-4">
                    <label class="contorl-lable">File Upload</label>
                </div>
                <div class="col-4">
                    <input type="file" id="UploadFile" name="UploadFile" accept=".xls,.xlsx" />
                </div>
                <div class="col-4">
                    <input type="submit" name="Submit" value="Submit" />
                </div>
            </div>

        </div>
        
    }
</div>


<style>
    .edit-verfifaction-form {
        width: 100%;
        border: 1px solid #c7c7c7;
        padding: 11px;
    }

    label.contorl-lable{
        font-weight:600;
        font-size:14px;
    }
</style>