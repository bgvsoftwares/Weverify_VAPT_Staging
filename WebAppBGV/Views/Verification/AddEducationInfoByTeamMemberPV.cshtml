@using WebAppBGV.CommonMethods;
@model dynamic


@{
    string Designation = Session["Designation"].ToString();
    ViewBag.Title = "Add Education Info (" + Convert.ToString(Session["CandidateName"]) + ")";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = "";
    if (Designation.Contains("Leader"))
    {
        hyperLink = Html.ActionLink("linkTitle", "DepartmentTeamLeaderAllocation", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else if (Designation.Contains("Manager"))
    {

        hyperLink = Html.ActionLink("linkTitle", "DepartmentManagerAllocation", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else
    {
        if (Session["CheckStatus"].ToString() == "FundsApproval")
        {
            hyperLink = Html.ActionLink("linkTitle", "TeamMemberFundsResolved", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
        else
        {
            hyperLink = Html.ActionLink("linkTitle", "ManageTeamMemberChecks", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
    }

    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CheckStatuss = "";
    string checkStatusid = "";
    string degreeid = "";
    string degreeName = "";
    string CandCheckRowid = "";
    string TeamMemberRowID = "";

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CheckStatuss = @ViewBag.CheckStatus;
    checkStatusid = @ViewBag.checkStatusid;
    CandCheckRowid = @ViewBag.CandCheckRowID;
    degreeName = @ViewBag.degreeName.Trim();
    TeamMemberRowID = Session["TeamMemberRowID"].ToString();
    string Department = Session["Department"].ToString();

}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }

<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>
        </tr>
        @if (TeamMemberRowID == "662" || TeamMemberRowID == "663" || TeamMemberRowID == "664" || TeamMemberRowID == "665" || TeamMemberRowID == "672" || TeamMemberRowID == "673" || TeamMemberRowID == "681" || TeamMemberRowID == "682" || TeamMemberRowID == "683" || TeamMemberRowID == "684" || TeamMemberRowID == "757" || TeamMemberRowID == "788" || TeamMemberRowID == "787")
        {
            <tr>
                <td>@Html.Partial("_DocumentList")</td>
            </tr>
        }
        else
        {
            <tr><td> @Html.Partial("_CaseDocumentList") </td></tr>
            <tr><td> @Html.Partial("_DocumentList") </td></tr>
            <tr><td> @Html.Partial("MailList") </td></tr>
        }

    </table>
    <div class="col-md-12">
        <div class="container">
            @if (ViewBag.ErrorMsg != null)
            {
                <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="errormsg">@ViewBag.Success.ToString()</div>
            }
            @using (Html.BeginForm("AddEducationInfoByTeamMemberPV", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
                @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

                <input id="SubCheckId" type="hidden" value=@SubCheckId>
                @Html.Hidden("SubCheckId", SubCheckId.ToString())

                <input id="clientRowId" type="hidden" value=@clientRowId>
                @Html.Hidden("clientRowId", clientRowId.ToString())

                <input id="checkStatusid" type="hidden" value=@checkStatusid>
                @Html.Hidden("checkStatusid", checkStatusid.ToString())

                <input id="CheckStatuss" type="hidden" value=@CheckStatuss>
                @Html.Hidden("CheckStatuss", CheckStatuss.ToString())

                <input type="hidden" id="CollegeId" name="CollegeId" value=@ViewBag.CollgegIdn />
                <input type="hidden" id="CollegeNameTemp" name="CollegeNameTemp" />

                <input id="Hfdegreeid" type="hidden" value=@degreeid>
                @Html.Hidden("Hfdegreeid", degreeid.ToString())

                @Html.Hidden("HfdegreeName", degreeName.ToString())
                foreach (var category in Model)
                {
                    <div class="row" style="margin-bottom:10px;">
                        @{
                            string[] nm = category.Key.Split('_');
                            string[] temp = category.Value.Split('_');


                            if (@nm[2] == "textbox")
                            {
                                <div class="col-md-4">
                                    @if (nm[4] != "")
                                    {
                                        <p style="margin-top:30px!important;">
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }
                                            @nm[1]
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }
                                            @nm[1]
                                        </p>
                                    }
                                </div>
                                if (@nm[0] != "66")
                                {
                                    <div class="col-md-4">
                                        @if (@nm[0] == "69")
                                        {
                                            <a href='@Url.Action("CollegeDetailsName", "Master",  new { id = @temp[0]})' target="_blank">@temp[0]</a>
                                        }
                                        else
                                        {
                                            if (nm[4] != "")
                                            {
                                                <p style="margin-top: 30px;">@temp[0]</p>
                                            }
                                            else
                                            {
                                                <p>@temp[0]</p>
                                            }
                                        }
                                    </div>
                                }      //isse aage krna hain



                                if (temp.Count() > 1 && @temp[1] != "")
                                {
                                    if (@nm[0] == "66")
                                    {
                                        <div class="col-md-8">
                                            <textarea name="66" id="66">@temp[1]</textarea>
                                        </div>

                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            @if (nm[4] != "")
                                            {
                                                <p style="color:red">@nm[4]</p>
                                            }
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                        </div>

                                    }

                                }
                                else
                                {
                                    if (@nm[0] == "66")
                                    {
                                        <div class="col-md-8">
                                            <textarea name="66" id="66">@temp[0]</textarea>
                                        </div>

                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            @if (nm[4] != "")
                                            {
                                                <p style="color:red">@nm[4]</p>
                                            }
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off" maxlength="@nm[5]">
                                        </div>

                                    }

                                }




                            }
                            if (@nm[2] == "dropdown")
                            {

                                <div class="col-md-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-md-4">

                                    @if (temp.Count() > 1)
                                    {
                                        <p>@temp[0]</p>
                                    }
                                </div>
                                <div class="col-md-4">
                                    @nm[4]
                                    @{
                                        int lastindex = nm.Length;
                                        string[] nmOption = nm[lastindex - 1].Split(',');
                                        string Fvalue = "";
                                        Fvalue = nm[lastindex - 2].ToString();
                                        if (Fvalue == "")
                                        {
                                            Fvalue = nm[lastindex - 3].ToString();
                                        }
                                    }
                                    <select name=@nm[0] id='@nm[0]' autocomplete="off">
                                        @for (int i = 0; i < nmOption.Length; i++)
                                        {



                                            if (@nmOption[i].Trim() == Fvalue)
                                            {
                                                <option selected>@nmOption[i]</option>

                                            }
                                            else
                                            {

                                                <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                            }

                                        }
                                    </select>

                                    @Html.Hidden("HfdegreeName")
                                    <input id="HfdegreeName" type="hidden" value=@degreeName>


                                </div>


                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="container">
                                    <div class="row">
                                        <div class="col-sm">
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <h7>*</h7>
                                                }
                                            }
                                            @nm[1]
                                        </div>
                                        <div class="col-sm">

                                            @{
                                                if (@nm[6] == "TRUE")
                                                {
                                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked autocomplete="off">
                                                }
                                                else
                                                {
                                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0] autocomplete="off">
                                                }
                                            }

                                        </div>

                                    </div>
                                </div>

                            }
                            if (@nm[2] == "fileUpload")

                            {
                                <div class="container">
                                    <div class="row">
                                        <div class="col-sm">
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <h7>*</h7>
                                                }
                                            }
                                            @nm[1]
                                        </div>
                                        <div class="col-sm">
                                            <input type="file" id=@nm[0] name='@nm[0]' autocomplete="off" accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                        </div>

                                    </div>
                                </div>

                            }
                        }

                    </div>

                }
                <div class="row">
                    <div class="col-sm-12 cytoscape-parent">
                        <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                    </div>
                </div>





                if (Session["Designation"] != null)
                {

                    if (Designation == "Team Member-PV" || Designation == "Team Member-PV-QC")
                    {

                        @Html.ActionLink("Back", "ManageTeamMemberChecks", "Verification", new { }, new { @class = "btn btn-default VerEmailDetails" })

                        <div class="container" style="margin-bottom:30px!important;">
                            <div class="row">
                                <div class="col-sm">
                                    <input type="submit" value="Submit" style="width:15rem!important; padding:5% 0 5% 0; border-radius:.90rem; font-size:1.6rem!important;" />
                                </div>
                                <div class="col-sm">
                                    @Html.ActionLink("Attachment", "UplodEducationVerDocs", "Verification", new { scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @id = "UplodVerificationDocs" })
                                </div>                                                              
                            </div>
                        </div>

                    }
                    <div class="container">
                        @if (Session["Designation"].ToString() == "Manager-PV" && checkStatusid == "17")
                        {
                            <div class="row">
                                <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" name="action" />
                                <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Reject" name="action" />
                            </div>
                        }
                    </div> 
                }

            }

        </div>
    </div>
</div>

