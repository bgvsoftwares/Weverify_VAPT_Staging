@model dynamic


@{
    string Designation = "";
    if (Session["Designation"] != null)
    {
        Designation = Session["Designation"].ToString();
    }


    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CheckStatusid = "";

    string degreeid = "";
    string degreeName = "";

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CheckStatusid = @ViewBag.CheckStatusid;
    degreeName = @ViewBag.degreeName.Trim();
    string ReportComments = ViewBag.ReportComments;
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<style>
    .tox-tinymce {
        margin-top: 10px !important;
    }

    .tox-editor-header {
        box-shadow: none !important;
        z-index: 0 !important;
        border-bottom: 0.5px solid #000 !important;
    }

    .tox-statusbar__branding {
        display: none !important;
    }
</style>
<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_CaseDocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentList")</td>
        </tr>

    </table>
    <div class="container">
        @using (Html.BeginForm("UpdateEducationInfoByPVQC", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
            @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

            <input id="SubCheckId" type="hidden" value=@SubCheckId>
            @Html.Hidden("SubCheckId", SubCheckId.ToString())

            <input id="clientRowId" type="hidden" value=@clientRowId>
            @Html.Hidden("clientRowId", clientRowId.ToString())

            <input id="CheckStatusid" type="hidden" value=@CheckStatusid>
            @Html.Hidden("CheckStatusid", CheckStatusid.ToString())

            <input id="hdnDispositionID" type="hidden" name="hdnDispositionID">
            <input id="hdnSeverity" type="hidden" name="hdnSeverity">
            <input id="ColorsName" type="hidden" name="ColorsName">

            <input type="hidden" id="CollegeId" name="CollegeId" value=@ViewBag.CollgegIdn />
            <input type="hidden" id="CollegeNameTemp" name="CollegeNameTemp" />

            <input id="Hfdegreeid" type="hidden" value=@degreeid>
            @Html.Hidden("Hfdegreeid", degreeid.ToString())

            <input id="HfdegreeName" type="hidden" value='@degreeName'>

            @Html.Hidden("HfdegreeName", degreeName.ToString())



            @Html.ValidationSummary()

            foreach (var category in Model)
            {
                <div class="row">
                    @{
                        string[] nm = category.Key.Split('_');
                        string[] temp = category.Value.Split('_');

                        if (@nm[2] == "textbox")
                        {
                            <div class="col-md-4 class_anti">
                                @{
                                    if (nm[4] != "")
                                    {
                                        <p style="margin-top:30px!important;">
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }


                                            @nm[1]
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }


                                            @nm[1]
                                        </p>
                                    }
                                }
                            </div>

                            if (nm[0].ToString() != "66")
                            {
                                if (nm[4] != "")
                                {
                                    <div class="col-md-4">
                                        <p style="margin-top: 30px;">@temp[0]</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        <p>@temp[0]</p>
                                    </div>
                                }

                            }
                            if (nm[0].ToString() == "66")
                            {
                                <div class="col-md-8">
                                    @if (temp.Count() > 1 && @temp[1] != "")
                                    {
                                        <textarea name="66" id="66" rows="5" cols="8" maxlength="@nm[5]" onfocus="getremarkData()">@temp[1]</textarea>
                                    }
                                    else
                                    {
                                        <textarea name="66" id="66" rows="5" cols="8" maxlength="@nm[5]">@temp[0]</textarea>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="col-md-4">
                                    @if (nm[4] != "")
                                    {
                                        <p style="color:red">@nm[4]</p>
                                    }

                                    @if (temp.Count() > 1 && @temp[1] != "")
                                    {

                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off" maxlength="@nm[5]">
                                    }
                                </div>
                            }
                        }
                        if (@nm[2] == "dropdown")
                        {
                            <div class="col-md-4">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7 style="color:red!important;">*</h7>
                                    }
                                    else
                                    {
                                        <h7 style="color:red!important;">&nbsp;</h7>
                                    }
                                }
                                @nm[1]
                            </div>

                            <div class="col-md-4">

                                @if (temp.Count() > 1)
                                {
                                    @temp[0]
                                }
                            </div>
                            <div class="col-md-4">
                                @nm[4]
                                @{
                                    int lastindex = nm.Length;
                                    string[] nmOption = nm[lastindex - 1].Split(',');
                                    string Fvalue = nm[lastindex - 2].ToString();
                                }
                                <select name=@nm[0] id='@nm[0]' autocomplete="off" class="form-control">
                                    @for (int i = 0; i < nmOption.Length; i++)
                                    {
                                        if (@nmOption[i].Trim() == Fvalue)
                                        {
                                            <option selected>@nmOption[i]</option>
                                        }
                                        else
                                        {
                                            <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                        }

                                    }
                                </select>

                            </div>
                        }
                        if (@nm[2] == "checkbox")
                        {
                            <div class="row">
                                <div class="col-sm-4" style="padding-top:10px!important;">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm-2" style="padding-top:10px!important; text-align:left;">

                                    @{
                                        if (@nm[6] == "TRUE")
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                        }
                                        else
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                        }
                                    }

                                </div>
                                <div class="col-sm-4">
                                    @nm[4]
                                </div>
                            </div>
                        }
                        if (@nm[2] == "fileUpload")
                        {
                            <div class="row">
                                <div class="col-sm-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm-4">
                                    <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                </div>
                                <div class="col-sm-4">
                                    @nm[4]
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            <div class="row">
                <div class="col-sm-12 cytoscape-parent">
                    <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    Report Comment :
                </div>
                <div class="col-md-8">
                    <textarea name="Remarks" id="Remarks" rows="5" cols="8">@ReportComments</textarea>
                </div>
            </div>


            <div class="row" style="margin-top:30px!important; margin-bottom:40px!important;">
                @if (Designation == "Team Member-PV-QC")
                {
                    <div class="col-md-4" style="text-align:end!important;">
                        @Html.ActionLink("Back", "DepartmentTeamMemberPVQCChecks", "Verification", new { CheckStatusId = CheckStatusid }, new { @class = "btn btn-default VerEmailDetails", @style = "padding:5px 20px 5px 20px!important;" })
                    </div>
                    if (CheckStatusid == "34")
                    {
                        <div class="col-md-4" style="text-align:center!important;">
                            <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" name="action" style="padding:5px 20px 5px 20px!important;" />

                        </div>
                        <div class="col-md-4">
                            <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Rejected" name="action" style="padding:5px 20px 5px 20px!important;" />
                        </div>
                    }
                }

            </div>
        }

    </div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/tinymceNew.min.js"></script>
    <script src="~/Scripts/tinymce-jquery.min.js"></script>

    <script>
        $('textarea').tinymce({
            height: 200,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | removeformat | help'
        });
        // Prevent jQuery UI dialog from blocking focusin
        $(document).on('focusin', function (e) {
            if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                e.stopImmediatePropagation();
            }
        });
    </script>
    <style>

        img {
            width: 50px;
            height: 25px;
        }
    </style>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#172').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+0",
            });
            var dNow = new Date();
            var localdate = (dNow.getFullYear() + '-' + (dNow.getMonth() + 1) + '-' + dNow.getDate());
            $('#OrderDate').val(localdate);
            $('#goBack').click(function () {
                parent.history.back();
                return false;
            });
        });
      
        $("#172").keypress(function (e) {
            return false;
        });
        $("#172").keydown(function (e) {
            return false;
        });
    </script>
    <script>
        $(document).ready(function () {

            var dispid = '@ViewBag.CDispositionName';
            var Severityid = '@ViewBag.Severityid';
            var ColorName = '@ViewBag.ColorName';
            var Remarks = '@ViewBag.ReportComments';




            //alert(dispid);
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
               onClosed: function () {                    
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            //For Clouse details
            $("#CDispositionRowId option:selected").each(function () {
                var $this = $(this);
             
                if ($this.length) {
                    var selText = $this.text();
                    var SelectDispositionID = $this.val();
                    $('#hdnDispositionID').append(SelectDispositionID + ',');
                    SelectDispositionID += $this.val() + ',';
                    //console.log(selText);
                    if ($('#CDispositionRowId').val() == '') {
                        $('#CDispositionRowId').append(selText + '\n');
                    }
                
                    if (dispid!='')
                    {
                        $('#CDispositionRowId').val(dispid);
                        $('#hdnDispositionID').val(dispid);
                        $('#hdnSeverity').val(Severityid);
                        $('#ColorsName').val(ColorName);
                        $('#Remarks').val(Remarks);


                    }
                }
            });

            $("#CDispositionRowId").change(function () {
                $('#selected').html(' ');
                //alert('hdnDispositionID Change');
                var SelectDispositionID = '';
                $("#CDispositionRowId option:selected").each(function () {
                    var $this = $(this);
                    if ($this.length) {
                        var selText = $this.text();
                        SelectDispositionID += $this.val() + ',';
                        //console.log(selText);
                        $('#selected').append(selText + '\n');
                    }
                });
                if (SelectDispositionID.length > 0) {
                    SelectDispositionID = SelectDispositionID.substring(0, SelectDispositionID.length - 1);
                } else { SelectDispositionID = ''; }
                $('#hdnDispositionID').val(SelectDispositionID);

            });

            $(function () {
                $('#CDispositionRowId').change(function () {
                    //alert('3');
                    var url = "/Verification/GetSeverityColor?ClientRowId=" + $("#clientRowId").val() + "&Dispositions=" + $("#hdnDispositionID").val();
                    $.ajax({
                        url: url,
                        type: 'GET',
                        async: false,
                        dataType: 'json',
                        success: function (colors) {
                            $('#Severity').val(colors.SeverityName);
                            $('#ColorName').val(colors.ColorName);
                            $('#ColorsName').val(colors.ColorName);
                            $('#hdnSeverity').val(colors.SeverityRowId);

                        }
                    });
                });
            });
        });

        $(document).ready(function () {
            @*var text1 = '@(ViewBag.degreeName)';*@
            var text1 = $('#HfdegreeName').val();

            $('#HfdegreeName').val(text1);


        if ($('#72').val() != null) {

            $.getJSON('/Master/GetDegreeList/', function (data) {
                var items = '<option value="">-- Select Degree --</option>';
                $.each(data, function (i, degree) {
                    items += "<option value='" + degree.Value + "'>" + degree.Text + "</option>";
                });
                $('#72').html(items);
                $("#72 option").filter(function () {
                    return this.text == text1;
                }).attr('selected', true);



            });
               }


            if ($("#EV_Colg_Schl_Inst_Name").val() != null) {
                var url = "/ProvidedInfo/AffiliatedCollege/" + $("#EV_Colg_Schl_Inst_Name").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (AfflCollage) {
                        $('#strEV_Affl_University_Name').val(AfflCollage);
                    }
                });
            }
        });

        $(function () {


            $('#72').change(function () {

                $('#HfdegreeName').val($('#72 option:selected').text());

            });
        });

        function validateFormApprove() {        
            var CheckStatusid = '@ViewBag.CheckStatusid';

            if ((CheckStatusid == '53' || CheckStatusid == '58') && ( $('#Remarks').val() == '')) {
                alert("Please mention the reason!");
                $('#Remarks').focus();
                return false;
            }
         
        }

        function validateFormReject() {
            if ($('#Remarks').val() == '') {
                alert("Please mention the reason!");
                $('#Remarks').focus();
                return false;
            }

            return true;
        }
    </script>

}
