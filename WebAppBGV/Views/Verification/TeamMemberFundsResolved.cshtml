



@{
    ViewBag.Title = "Team Member Funds Resolved";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}
@{
    //@ViewBag.NavigationBtnExportExcel
    string tatdays1 = "";
    string CheckStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatdays"] != null)
    {
        tatdays1 = Request.QueryString["tatdays"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CheckStatus"] != null)
    {
        CheckStatus1 = @Request.QueryString["CheckStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportChecksReport", "Verification", new { CheckStatus = CheckStatus1, tatdays = tatdays1, AllocatedToTL = AllocatedToTL1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

    @*//@ViewBag.NavigationBtnExportWord
        //string faIconExportWord = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Word");
        //string hyperLinkExportWord = Html.ActionLink("linkTitle", "ExportCountryInWord", "Master", null, new { class = "btn bun-bg btn-default" }).ToString();
        //ViewBag.NavigationBtnExportWord = new HtmlString(hyperLinkExportWord.ToString().Replace("linkTitle", faIconExportWord));

        //@ViewBag.NavigationBtnBackExportPDF
        //string faIconExportPDF = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export PDF");
        //string hyperLinkExportPDF = Html.ActionLink("linkTitle", "ExportCountryInPDF", "Master", null, new { class = "btn bun-bg btn-default" }).ToString();
        //ViewBag.NavigationBtnBackExportPDF = new HtmlString(hyperLinkExportPDF.ToString().Replace("linkTitle", faIconExportPDF));*@
string clientRowId = "";
clientRowId = @ViewBag.clientRowId;
}




@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageTeamMemberChecks", "Verification", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                                   new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                                   "-- Select Client -- ",
                                                   new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">CheckStatus :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("DCheckStatus",
                                              new SelectList(ViewBag.CheckStatusOptionList, "Value", "Text"),
                                              "-- Select Check -- ",
                                              new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Case Status :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("CaseStatus",
                                                   new SelectList(ViewBag.CaseStatusOptionList, "Value", "Text"),
                                                   "-- Select Case -- ",
                                                   new { @class = "form-control" })
                                    </div>
                                </div>
                                @{ string Designation = Session["Designation"].ToString();
                                    if (!string.IsNullOrWhiteSpace(Designation) && Designation != "Team Member-Ref" && Designation != "Team Member-Ide")
                                    {
                                        if (Designation != null && Designation == "Team Member-Add")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">State :</label>
                                                <div class="col-md-3">
                                                    @Html.DropDownList("State", new SelectList(ViewBag.States, "StateRowID", "StateName"), "-- Select State -- ", new { @class = "form-control" })
                                                </div>
                                                <label class="col-md-2 control-label">City :</label>
                                                <div class="col-md-3">
                                                    @Html.DropDownList("City", new SelectList(ViewBag.Cities, "LocationRowID", "LocationName"), "-- Select City -- ", new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Partner :</label>
                                                <div class="col-md-3">
                                                    @Html.DropDownList("Partner", new SelectList(ViewBag.Partner, "PartnerRowId", "PartnerName"), "-- Select Partner -- ", new { @class = "form-control" })
                                                </div>
                                            </div>
                                        }
                                        if (Designation != null && Designation == "Team Member-Emp")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Employer Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }
                                        if (Designation != null && Designation == "Team Member-Edu")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Institute Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }

                                    }
                                }
                                @{
                                    if (Request.QueryString["CheckStatus"] != null)
                                    {
                                        @Html.Hidden("CheckStatus", Request.QueryString["CheckStatus"].ToString())
                                    }

                                    if (Request.QueryString["tatdays"] != null)
                                    {
                                        @Html.Hidden("tatdays", Request.QueryString["tatdays"].ToString())
                                    }
                                }
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @{
                                string Designation = Convert.ToString(Session["Designation"]);




                                @grid.GetHtml(
                                 htmlAttributes: new
                                 {
                                     id = "grid",
                                     @class = "table" },
                                                            headerStyle: "thead-inverse",
                                                            rowStyle: "ordertxt",
                                                            footerStyle: "custpaging",
                                                            mode: WebGridPagerModes.All,
                                                            columns: new[]
                                                            {
                                            grid.Column(header: "No.", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                            grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),

                                           grid.Column(header : "Securitas ID", format : (item) => {
                                                          string SecuritasID=item.CompanyRefNo;

                                                       if (item.CheckFamilyRowID==2 && item.CheckStatus != "Allocated-TL")
                                                            {
                                                                var link = Html.ActionLink(SecuritasID, "AddAddressInfoByTeamMember", "Verification", new { id = item.VerificationRowID }, new { @class="edit" });
                                                            return link;
                                                            }
                                                         else if (item.CheckFamilyRowID==5 && item.CheckStatus != "Allocated-TL")
                                                            {
                                                  
                                                    var link = Html.ActionLink(SecuritasID, "AddCriminalInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                                            return link;
                                                            }
                                                        else if (item.CheckFamilyRowID==11 && item.CheckStatus != "Allocated-TL")
                                                            {
                                                                var link = Html.ActionLink(SecuritasID, "AddEducationInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                                            return link;
                                                            }
                                                        else if (item.CheckFamilyRowID==12 && item.CheckStatus != "Allocated-TL")
                                                            {
                                                                var link = Html.ActionLink(SecuritasID, "AddEmploymentInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID  }, new { @class="edit" });
                                                            return link;
                                                            }
                                                         else if (item.CheckFamilyRowID==26 && item.CheckStatus != "Allocated-TL")
                                                            {
                                                                var link = Html.ActionLink(SecuritasID, "AddNationalIdentityInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID  }, new { @class="edit" });
                                                            return link;
                                                            }
                                                        else if (item.CheckFamilyRowID==30 && item.CheckStatus != "Allocated-TL")
                                                            {
                                                                var link = Html.ActionLink(SecuritasID, "AddReferenceInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID  }, new { @class="edit" });
                                                            return link;
                                                            }
                                                        else if (item.CheckFamilyRowID==40 && item.CheckStatus != "Allocated-TL")
                                                            {
                                                                var link = Html.ActionLink(SecuritasID, "AddSpecialCheckInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID  }, new { @class="edit" });
                                                            return link;
                                                            }
                                                        else
                                                            {
                                                                return SecuritasID;
                                                            }
                                                    }, style:"td-1"),
                                            grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-1"),
                                           // grid.Column(columnName: "ClientRemarks", header: "Client Remarks", canSort: false, style:"td-1"),
                                            //grid.Column(columnName: "Remarks", header: "Funds Status", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "TypeOfBusinesses", header: "Type Of Business", canSort: true, style:"td-1"),
                                            grid.Column("Remarks", canSort: false, format: (item)=> {

                                                             if( item.CheckStatusID==61)
                                                            {
                                                                 var link=@Html.ActionLink("Remarks", "FundsPendindRemark", "Verification", new { PersonalRowID = item.PersonalRowID ,SubCheckRowID = item.SubCheckRowID ,checkstatusid=item.CheckStatusID,CheckRowid=item.CheckFamilyRowID ,processName="Funds-Pending-TM"}, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
                                                                return link;
                                                            }
                                                            return null;
                                                        }, style:"td-1" ),
                                            grid.Column("SendMail", canSort: false, format: (item)=> {
                                                                                                            if ( item.checkstatusid==61 && item.CheckFamilyRowID==12)
                                                                                                            {//UplodAddressCheckDocsAndComplete(short scid = 0, int pe = 0, string cstatus = "")
                                                                                                                //scid = Model.SubCheckRowId, pe = Model.PersonalRowID, cstatus = Model.CheckStatus
                                                                                                                var link=@Html.ActionLink("open", "ReminderMail", "Verification", new { SubCheckRowID = item.SubCheckRowID,PersonalRowID=item.PersonalRowID,ReminderStatus=item.CheckStatus,CheckStatusId=item.CheckStatusid,UniqueCompId= item.UniqueComponentID,CandName=item.PersonalName,CandCheckRowID=item.CandCheckRowID,OrgnName=item.Organization_Name,mailStatus=item.MailStatus},  new { @class = "Remindermail  callbacks"});
                                                                                                                return link;
                                                                                                            }
                                                                                                            return null;
                                                                                                        }, style:"td-1" ),

   grid.Column("Reminder", canSort: false, format: (item)=> {
                                                                                                                                                    if (item.CheckStatusid==61 && item.CheckFamilyRowID==11)
                                                                                                                                                            {//UplodAddressCheckDocsAndComplete(short scid = 0, int pe = 0, string cstatus = "")
                                                                                                                                                                //scid = Model.SubCheckRowId, pe = Model.PersonalRowID, cstatus = Model.CheckStatus
                                                                                                                                                                var link=@Html.ActionLink("open", "EducationReminderMail", "Verification", new { SubCheckRowID = item.SubCheckRowID,PersonalRowID=item.PersonalRowID,CheckStatusId=item.CheckStatusid,CandCheckRowID=item.CandCheckRowID,CandName=item.PersonalName,ToEmail=item.OfficialEmailId,OrgnName=item.UniversityName},  new { @class = "Remindermail  callbacks"});
                                                                                                                                                                return link;
                                                                                                                                                            }
                                                                                                                                                            return null;
                                                                                                                                                        }, style:"td-1" )
                                                            }

                                                            )


                            }

                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });



            $(".Remindermail").colorbox({ iframe: true, width: "80%", height: "100%" });

            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });
        });
        $('#RecievingToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#RecievingFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
    </script>
}

