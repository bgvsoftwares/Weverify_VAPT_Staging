@{
    ViewBag.Title = "Welcome To  Feedback Tracker";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row"><div class="col-md-12">&nbsp;</div></div>
<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            @using (Html.BeginForm("Export_Feedback", "Verification", FormMethod.Post, new { @id = "Feedback_form" }))
            {
                <div class="row">
                    <div class="col-md-12">



                        <div class="form-group branch row search-frame">
                            <label class="col-md-2 control-label"> From Date :</label>
                            <div class="col-md-3">
                                @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "dd-MMM-yyyy", @autocomplete = "off" })
                            </div>
                            <label class="col-md-2 control-label">To Date :</label>
                            <div class="col-md-3">
                                @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "dd-MMM-yyyy", @autocomplete = "off" })
                            </div>
                        </div>

                    </div>
                </div>



                <div class="row">


                    <div class="col-md-12 text-center">
                        <input type="submit" id="btnE2EMIS" value="Export Excel" class="btn bun-bg btn-default" name="submit" />
                    </div>


                </div>
                <br />
                <div class="row">


                    <div class="col-md-12 text-center">
                        <input type="submit" id="btnE2EMIS" value="Export Excel Address Check" class="btn bun-bg btn-default" name="submit" />
                    </div>


                </div>

            }
        </div>
    </div>
</div>



@section Scripts{

    <script type="text/javascript">

        $(document).ready(function () {


            $('#CompletedToDate').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });


        });


    </script>
}
