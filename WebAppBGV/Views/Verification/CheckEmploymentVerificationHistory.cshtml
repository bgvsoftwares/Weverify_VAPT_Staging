

<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />

<link href="~/Content/admin.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

@*<script src="~/scripts/jquery-2.2.3.min.js"></script>*@
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<link href="~/Content/colorbox.css" rel="stylesheet" />
<script src="~/Scripts/jquery.colorbox-min.js"></script>

<table width="100% ">
    <tr>
        <td class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> Check Employment Verification History :</td>
    </tr>
    <tr>
        <td height="2"></td>
    </tr>
    <tr>
        <td valign="top">
            @if (ViewBag.GetEmploymentVerificationHistories != null)
            {
                <table class="table">
                    <thead class="thead-inverse">
                        <tr>
                            <th class="top-head">Employment Name</th>
                            <th class="top-head">Concern Person Name</th>
                            <th class="top-head">Desig Concern Person</th>
                            <th class="top-head">Category</th>
                            <th class="top-head">Official Email Id</th>
                            <th class="top-head">Official Landline No.</th>
                            <th class="top-head">Creation Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.GetEmploymentVerificationHistories)
                        {
                        <tr>
                            <td class="name">@item.EmploymentName</td>
                            <td class="name">@item.ConcernPersonName</td>
                            <td class="name">@item.DesigConcernPerson</td>
                            <td class="name">@item.Category</td>
                            <td class="name">@item.OfficialEmailId</td>
                            <td class="name">@item.OfficialLandlineNo</td>
                            <td class="name">@item.CreationDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                        </tr>
                        }
                    </tbody>
                </table>
            }
        </td>
    </tr>
</table>


