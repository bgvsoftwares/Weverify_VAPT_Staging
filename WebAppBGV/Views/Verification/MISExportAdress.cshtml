@model IEnumerable<ViewModels.ProvidedInfoViewModel.MISExport>

@{
    ViewBag.Title = "MISExportAdress";
    WebGrid grid = new WebGrid(Model, rowsPerPage: 500);

}

@{
    //@ViewBag.NavigationBtnExportExcel
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excels");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "GetExportExcelDE", "Verification", null, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));
}
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
@if (ViewBag.UnAllocated == null)
{
    ViewBag.UnAllocated = "";
}
@{



    string DE_UnAllocate = (@ViewBag.DE_UnAllocate).ToString();
    string Fund_Pedning = @ViewBag.Fund_Pedning.ToString();
    string Insuff_Bucket = @ViewBag.Insuff_Bucket.ToString();
    string QCBucket = @ViewBag.QCBucket.ToString();
    string Rejection = @ViewBag.Rejection.ToString();
    string Out_Of_Tat = @ViewBag.Out_Of_Tat.ToString();
    string UnAllocated = ViewBag.UnAllocated.ToString();
    string Total_WIP = @ViewBag.Total_WIP.ToString();
    string Todays_Closure = @ViewBag.Todays_Closure.ToString();
    string Assigned_Today = @ViewBag.Assigned_Today.ToString();
    string Special_Attention = @ViewBag.Special_Attention.ToString();
}

<div class="row">
    <div class="col-md-12" style="margin-bottom:30px;">
        @if (Session["Designation"].ToString() == "Manager-Add")
        {
            <table class="table js-serial">
                <thead>
                    <tr>
                        <th style="text-align:left;">TM First Name</th>
                        <th>DE_UnAllocate</th>
                        <th>Fund_Pedning</th>
                        <th>Insuff_Bucket</th>
                        <th>QC Bucket</th>
                        <th>Rejection</th>
                        <th>Out_Of_Tat</th>
                        <th>UnAllocated</th>
                        <th>Total_WIP</th>
                        <th>Todays_Closure</th>
                        <th>Assigned_Today</th>
                        <th>Special_Attention</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align:left;">@item.TMFirstName</td>
                                <td>@item.DE_UnAllocate</td>
                                <td>@item.Fund_Pedning</td>
                                <td>@item.Insuff_Bucket</td>
                                <td>@item.QCBucket</td>
                                <td>@item.Rejection</td>
                                <td>@item.Out_Of_Tat</td>
                                <td>@item.UnAllocated</td>
                                <td>@item.Total_WIP</td>
                                <td>@item.Todays_Closure</td>
                                <td>@item.Assigned_Today</td>
                                <td>@item.Special_Attention</td>
                            </tr>
                        }
                    }
                </tbody> 
                <tfoot>
                    <tr>
                        <td style="font-weight:bold; text-align:left;">Total Count</td>
                        <td class="font-weight:bold;">@Html.ActionLink(DE_UnAllocate, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "DE_UnAllocate" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Fund_Pedning, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Fund_Pedning" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Insuff_Bucket, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Insuff_Bucket" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(QCBucket, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "QC_Bucket" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Rejection, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Rejection" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Out_Of_Tat, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Out_Of_Tat" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(UnAllocated, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "User_UnAllocated" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Total_WIP, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Total_WIP" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Todays_Closure, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Todays_Closure" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Assigned_Today, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Assigned_Today" }, htmlAttributes: null) </td>
                        <td class="font-weight:bold;">@Html.ActionLink(Special_Attention, "GetMISTATInfoAdress", "Verification", routeValues: new { Type = "Special_Attention" }, htmlAttributes: null) </td>
                    </tr>
                </tfoot>
            </table>
        }
        <div class="total-record">Total Records: @ViewBag.record</div>
    </div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {

            $(".iframeShow").colorbox({ iframe: true, width: "70%", height: "80%" });
        });
    </script>
    <script>
        function addRowCount(tableAttr) {
            $(tableAttr).each(function () {
                $('th:first-child, thead td:first-child', this).each(function () {
                    var tag = $(this).prop('tagName');
                    $(this).before('<' + tag + '>S.No</' + tag + '>');
                });
                $('td:first-child', this).each(function (i) {
                    $(this).before('<td>' + (i + 1) + '</td>');
                });
            });
        }

        // Call the function with table attr on which you want automatic serial number
        addRowCount('.js-serial');
    </script>
}
<style>
    table, tr, th, td {
        text-align: center;
    }

    thead {
        background-color: #9c9595;
        color: #FFF;
    }

    th {
        padding: 5px !important;
    }
</style>
