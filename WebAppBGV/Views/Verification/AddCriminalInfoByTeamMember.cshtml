@model dynamic
@{

    ViewBag.Title = "Add Criminal Info (" + Convert.ToString(Session["CandidateName"]) + ")";

    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CandCheckRowid = "";
    string CheckStatusid = "";
    string CheckStatus = "";

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CandCheckRowid = @ViewBag.CandCheckRowID;
    CheckStatusid = @ViewBag.CheckStatusid;
    CheckStatus = @ViewBag.CheckStatus;
    string ReportComments = Convert.ToString(ViewBag.ReportComments);
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }

<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_CaseDocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentList")</td>
        </tr>

    </table>
    @if (ViewBag.SpocActionRemark != null)
    {
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td colspan="2">
                    <div class=" col-12 personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>  Spoc Remark :</div>
                </td>
            </tr>
            <tr>
                @foreach (var item in ViewBag.SpocActionRemark)
                {
                    if (item.PriorityType == "High")
                    {
                        <td style="font-weight: bold; background-color: #ff0000; color: white; width: 5%; ">High</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color:azure;"> @item.SpocRemark </p>
                        </td>
                    }
                    else
                    {
                        <td style="font-weight: bold; background-color: #02fd58; width: 5%; ">Low</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color: azure; "> @item.SpocRemark </p>
                        </td>
                    }
                }
            </tr>
        </table>
    }

    <div class="container">
        @if (ViewBag.ErrorMsg != null)
        {
            <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="errormsg">@ViewBag.Success.ToString()</div>
        }
        @using (Html.BeginForm("AddCriminalInfoByTeamMember", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
            @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

            <input id="SubCheckId" type="hidden" value=@SubCheckId>
            @Html.Hidden("SubCheckId", SubCheckId.ToString())

            <input id="clientRowId" type="hidden" value=@clientRowId>
            @Html.Hidden("clientRowId", clientRowId.ToString())

            @*@Html.ValidationSummary()*@
            <input id="CheckStatusid" type="hidden" value=@CheckStatusid>
            @Html.Hidden("CheckStatusid", CheckStatusid.ToString())

            <input id="CheckStatus" type="hidden" value=@CheckStatus>
            @Html.Hidden("CheckStatus", CheckStatus.ToString())
            foreach (var category in Model)
            {
                <div class="row" style=" margin-bottom:10px">
                    @{
                        string[] nm = category.Key.Split('_');
                        string[] temp = category.Value.Split('_');

                        if (@nm[2] == "textbox")
                        {

                            <div class="col-md-4">
                                @{
                                    if (nm[4] != "")
                                    {
                                        <p style="margin-top:30px!important;">
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }


                                            @nm[1]
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }


                                            @nm[1]
                                        </p>
                                    }
                                }
                            </div>
                            if (@nm[0] != "51")
                            {
                                <div class="col-md-4">

                                    @if (temp.Count() > 0)
                                    {
                                        if (nm[4] != "")
                                        {
                                            <p style="margin-top: 30px;">@temp[0]</p>

                                        }
                                        else
                                        {
                                            <p>@temp[0]</p>
                                        }
                                    }
                                </div>
                            }


                            if (temp.Count() > 1 && @temp[1] != "")
                            {
                                if (@nm[0] == "51")
                                {
                                    <div class="col-md-8">
                                        <textarea name="51" id="51">@temp[1]</textarea>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        @if (nm[4] != "")
                                        {
                                            <p style="color:red">@nm[4]</p>
                                        }
                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                    </div>

                                }

                            }
                            else
                            {
                                if (@nm[0] == "51")
                                {
                                    <div class="col-md-8">
                                        <textarea name="51" id="51">@temp[0]</textarea>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        @if (nm[4] != "")
                                        {
                                            <p style="color:red">@nm[4]</p>
                                        }
                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off" maxlength="@nm[5]">
                                    </div>

                                }

                            }


                        }
                        if (@nm[2] == "dropdown")
                        {

                            <div class="col-md-4">
                                @{
                                    if (@nm[3] == "mandatory")
                                    {
                                        <h7>*</h7>
                                    }
                                }
                                @nm[1]
                            </div>
                            <div class="col-md-4">
                                @nm[4]
                            </div>
                            <div class="col-md-4">
                                @{
                                    int lastindex = nm.Length;
                                    string[] nmOption = nm[lastindex - 1].Split(',');
                                    string Fvalue = nm[lastindex - 2].ToString();
                                }
                                @if (@nm[0] == "592")
                                {
                                    <input type="text" class="form-control" value="@temp[0]" readonly />
                                }
                                else
                                {

                                    <select name=@nm[0] id=@nm[0] autocomplete="off" class="form-control">
                                        @for (int i = 0; i < nmOption.Length; i++)
                                        {
                                            if (@nmOption[i].Trim() == Fvalue)
                                            {
                                                <option selected>@nmOption[i]</option>

                                            }
                                            else
                                            {

                                                <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                            }

                                        }
                                    </select>
                                }
                            </div>



                        }
                        if (@nm[2] == "checkbox")
                        {
                            <div class="row">
                                <div class="col-sm-4" style="padding-top:10px!important;">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm-2" style="padding-top:10px!important; text-align:left;">

                                    @{
                                        if (@nm[6] == "TRUE")
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                        }
                                        else
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                        }
                                    }

                                </div>
                                <div class="col-sm-4">
                                    @nm[4]
                                </div>
                            </div>
                        }
                        if (@nm[2] == "fileUpload")
                        {
                            <div class="row">
                                <div class="col-sm-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm-4">
                                    <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                </div>
                                <div class="col-sm-4">
                                    @nm[4]
                                </div>
                            </div>

                        }
                    }

                </div>

            }
            <div class="row">
                <div class="col-sm-12 cytoscape-parent">
                    <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    @Html.Label("Check Status", htmlAttributes: new { @class = "control-label" })
                </div>
                <div class="col-md-4">
                    @Html.DropDownList("CheckStatus", new List<SelectListItem>
                                                       { new SelectListItem{Text="Completed", Value="Completed"},
                                                         new SelectListItem{Text="Insufficent", Value="Insufficent"},
                                                         new SelectListItem{Text="Rejected", Value="Rejected"},
                                                         new SelectListItem{Text="Review Requested", Value="Review Requested"},
                                                         new SelectListItem { Text = "WIP-Pending", Value = "WIP-Pending" },
                                                         new SelectListItem { Text = "Not Applicable", Value = "Not Applicable" }},
                                             new { @class = "form-control", @id = "CheckStatus" })

                </div>
            </div>
                      


            if (ReportComments != "")
            {
                <div class="row">
                    <div class="col-md-4">
                        Action Remarks :
                    </div>
                    <div class="col-md-8">
                        <textarea name="Remarks" id="Remarks" rows="5" cols="8">@ReportComments</textarea>
                    </div>
                </div>
            }


            <div class="row" style="margin-bottom:20px !important;">
                <div class="col-sm-2" style="margin-left:15%; margin-top:20px;">
                    <input type="submit" value="Submit" style="width:15rem!important; padding:2% 0 2% 0; border-radius:.90rem; font-size:1.6rem!important;" />
                </div>
                <div class="col-sm-2" style="margin-left:15%; margin-top:20px;">
                    <input type="button" id="btnCRCReportDownload" value="CRC Report Download" class="btn-modern" />
                </div>

                <div class="col-sm-6" style="margin-left:15%; margin-top:20px;">

                    @Html.ActionLink("Closer Details", "CriminalVerCloserDetails", "Verification", new { PersonalRowID = PersonalRowid, SubcheckRowID = SubCheckId, ClientRowID = clientRowId, Aging = "" }, new { @class = "btn btn-default VerEmailDetails", @id = "VerificationCloserDetails", @disabled = "disabled" })

                    @Html.ActionLink("Attachment", "UplodCriminalVerDocs", "Verification", new { scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @id = "UplodVerificationDocs" })

                    @Html.ActionLink("Capture Action", "CaptureActionHistoryByVerTM", "Verification", new { CandCheckRowid = CandCheckRowid, cid = clientRowId, scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateStatus cboxElement callbacks btn btn-default", @id = "VerificationActionHistostry" })

                    @Html.ActionLink("Back", "ManageTeamMemberChecks", "Verification", new { CheckStatusId = CheckStatusid, CheckStatus = CheckStatus }, new { @class = "btn btn-default VerEmailDetails" })

                </div>
            </div>
        }
    </div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/tinymceNew.min.js"></script>
    <script src="~/Scripts/tinymce-jquery.min.js"></script>
    <style>
        .btn-modern {
            background-color: #2563eb;
            color: white;
            font-weight: 600;
            font-size: 14px;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.1s ease;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .btn-modern:hover {
                background-color: #1d4ed8;
            }

            .btn-modern:active {
                transform: scale(0.98);
            }
    </style>

    <script type="text/javascript">
    $(document).ready(function () {
       $("#btnCRCReportDownload").click(function () {

    var Pid = $("#PersonalRowid").val();
    var Sid = $("#SubCheckId").val();

    $.ajax({
        url: '@Url.Action("CheckReportStatus","Verification")',
        type: 'GET',
        data: {
            Pid: Pid,
            Sid: Sid
        },
        success: function (response) {

            alert(response.Message);

            if (response.Success) {

                window.location =
                    '@Url.Action("DownloadReportFile","Verification")'
                    + '?requestId=' + response.RequestId;
            }
        },
        error: function () {
            alert("Error occurred.");
        }
    });

});
    });
    </script>
    <script>
        $('textarea').tinymce({
            height: 200,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | removeformat | help'
        });
        // Prevent jQuery UI dialog from blocking focusin
        $(document).on('focusin', function (e) {
            if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                e.stopImmediatePropagation();
            }
        });
    </script>
    <style>
        .tox-tinymce {
            margin-top: 10px !important;
        }

        .tox-editor-header {
            box-shadow: none !important;
            z-index: 0 !important;
            border-bottom: 0.5px solid #000 !important;
        }

        .tox-statusbar__branding {
            display: none !important;
        }
    </style>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <style>
        .ui-widget.ui-widget-content {
            width: 20%;
        }

        img {
            width: 50px;
            height: 25px;
        }
    </style>
    <script>
        $(document).ready(function () {
            var ErrorMsg = '@(ViewBag.ErrorMsg)';

                    if (ErrorMsg=='')
                    {

                        //$('#VerificationCloserDetails').prop('disabled', false);
                        $('#VerificationCloserDetails').css('visibility', 'visible');
                    }
                    else
                    {

                        $('#VerificationCloserDetails').css('visibility', 'hidden');
                    }
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                //onOpen: function () { alert('onOpen: colorbox is about to open'); },
                //onLoad: function () { alert('onLoad: colorbox has started to load the targeted content'); },
                //onComplete: function () { alert('onComplete: colorbox has displayed the loaded content'); },
                //onCleanup: function () { alert('onCleanup: colorbox has begun the close process'); },
                onClosed: function () {
                    //alert('onClosed: colorbox has completely closed');
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "60%", height: "75%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(false);
                }
            });

        });
    </script>

    <style>
        img {
            width: 50px;
            height: 25px;
        }
    </style>
    <script type="text/javascript">
        $(document).ready(function () {
            var cli = $("#clientRowId").val();
            $('#171').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+0",
            });
            if (cli === "1680") {
                $("#645").attr("placeholder", "DD-MM-YYYY");
                $("#645").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });
                $("#646").attr("placeholder", "DD-MM-YYYY");
                $("#646").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });

                function updateDurationStay() {
                    var fromVal = $("#645").val();
                    var toVal = $("#646").val();

                    if (fromVal && toVal) {
                        $("#60").val(fromVal + " to " + toVal);
                    }
                }
            }

            if (cli == 446) {
                $("#60").attr("placeholder", "DD-MM-YYYY");
                $("#60").datepicker({
                    dateFormat: 'dd-MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true
                });
            }
            var dNow = new Date();
            var localdate = (dNow.getFullYear() + '-' + (dNow.getMonth() + 1) + '-' + dNow.getDate());
            $('#OrderDate').val(localdate);
            $('#goBack').click(function () {
                parent.history.back();
                return false;
            });
        });
        //$('#172').bind('copy paste cut', function (e) {
        //    e.preventDefault();
        //    alert('cut,copy & paste options are disabled !!');
        //});
        var cli1 = $("#clientRowId").val();;
        $("#171").keypress(function (e) {
            return false;
        });
        $("#171").keydown(function (e) {
            return false;
        });
        $('#622').attr('readonly', true);
        @*if(@Session["Mode"].ToString() == '1')
        {
             $("#UplodVerificationDocs").css('pointer-events', ' ');
             Session["Mode"]=null;
        }
         else
        {
             $("#UplodVerificationDocs").css('pointer-events', 'none');
             Session["Mode"]=null;
        }*@
    </script>


    <script>
        $(document).ready(function () {

            $('#Severity').change(function () {
                var url = "/Verification/GetColorBySeverity?ClientRowId=" + + $("#clientRowId").val() + "&SeverityRowId=" + $("#Severity").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (colors) {
                        $('#ColorName').val(colors);
                        //$("#hdnColorName").val(colors);
                        $("#ColorsName").val(colors);
                        $("#ColorsName").text = colors;
                    }
                });
            });
        });
    </script>
}