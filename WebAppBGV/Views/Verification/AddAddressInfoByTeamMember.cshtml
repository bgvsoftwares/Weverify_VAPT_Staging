@model dynamic


@{
    string Designation = Session["Designation"].ToString();
    ViewBag.Title = "Add Address Info (" + Convert.ToString(Session["CandidateName"]) + ")";
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = "";
    if (Designation.Contains("Leader"))
    {
        hyperLink = Html.ActionLink("linkTitle", "DepartmentTeamLeaderAllocation", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    else if (Designation.Contains("Manager"))
    {

        hyperLink = Html.ActionLink("linkTitle", "DepartmentManagerAllocation", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    }
    else
    {

        hyperLink = Html.ActionLink("linkTitle", "ManageTeamMemberChecks", "Verification", new { CheckStatus = Session["CheckStatus"], version = Session["version"] }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));


    }



    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string countryid = "";
    string StateId = "";
    string CityId = "";
    string CandCheckRowid = "";
    string checkStatusid = ViewBag.checkStatusid;

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;

    countryid = @ViewBag.countryid;
    StateId = @ViewBag.stateId;
    CityId = @ViewBag.Cityid;

    string CountryName = "";
    CountryName = @ViewBag.CountryName.Trim();

    string StateName = "";
    StateName = @ViewBag.StateName.Trim();

    string CityName = "";
    CityName = @ViewBag.CityName.Trim();
    CandCheckRowid = @ViewBag.CandCheckRowID;
    string Success = @ViewBag.SuccessMsg;
    //string ReportComments = Convert.ToString(ViewBag.ReportComments);

}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }

<div class="row">
    <div class="col-md-12">
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td>@Html.Partial("_PersonalDetails")</td>
            </tr>
            <tr>
                <td>@Html.Partial("_CaseDocumentList")</td>
            </tr>
            <tr>
                <td>@Html.Partial("_DocumentList")</td>
            </tr>

        </table>
        @if (ViewBag.SpocActionRemark != null)
        {
            <table class="main-tableframe personal-details-frame" border="0">
                <tr>
                    <td colspan="2">
                        <div class=" col-12 personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>  Spoc Remark :</div>
                    </td>
                </tr>
                <tr>
                    @foreach (var item in ViewBag.SpocActionRemark)
                    {
                        if (item.PriorityType == "High")
                        {
                            <td style="font-weight: bold; background-color: #ff0000; width: 5%; ">High</td>
                            <td style="width:95%;">
                                <p style="font-size: medium; background-color:azure;"> @item.SpocRemark </p>
                            </td>
                        }
                        else
                        {
                            <td style="font-weight: bold; background-color: #02fd58; width: 5%; ">Low</td>
                            <td style="width:95%;">
                                <p style="font-size: medium; background-color: azure; "> @item.SpocRemark </p>
                            </td>
                        }
                    }
                </tr>
            </table>
        }

        @if (ViewBag.ErrorMsg != null)
        {
            <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="errormsg">@ViewBag.Success.ToString()</div>
        }
        <div class="container">
            @using (Html.BeginForm("AddAddressInfoByTeamMember", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
                @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

                <input id="SubCheckId" type="hidden" value=@SubCheckId>
                @Html.Hidden("SubCheckId", SubCheckId.ToString())

                <input id="clientRowId" type="hidden" value=@clientRowId>
                @Html.Hidden("clientRowId", clientRowId.ToString())

                if (countryid != null)
                {
                    <input id="Hfcountryid" type="hidden" value=@countryid>
                    @Html.Hidden("Hfcountryid", countryid.ToString())
                }

                if (StateId != null)
                {
                    <input id="HfStateId" type="hidden" value=@StateId>
                    @Html.Hidden("HfStateId", StateId.ToString())
                }

                if (CityId != null)
                {
                    <input id="HfCityId" type="hidden" value=@CityId>
                    @Html.Hidden("HfCityId", CityId.ToString())
                }

                <input id="HfCountryName" type="hidden" value=@CountryName>

                <input id="HfStateName" type="hidden" value=@StateName>

                <input id="HfCityName" type="hidden" value=@CityName>

                @Html.ValidationSummary()
                foreach (var category in Model)
                {
                    <div class="row" style="margin-bottom:10px;">
                        @{
                            string[] nm = category.Key.Split('_');
                            string[] temp = category.Value.Split('_');

                            if (@nm[2] == "textbox")
                            {

                                <div class="col-md-4">
                                    @{
                                        if (nm[4] != "")
                                        {
                                            <p style="margin-top:30px!important;">
                                                @if (@nm[3] == "mandatory")
                                                {
                                                    <span style="color:red!important;">*</span>
                                                }
                                                else
                                                {
                                                    <span style="color:red!important;">&nbsp;</span>
                                                }
                                                @nm[1]
                                            </p>
                                        }
                                        else
                                        {
                                            <p>
                                                @if (@nm[3] == "mandatory")
                                                {
                                                    <span style="color:red!important;">*</span>
                                                }
                                                else
                                                {
                                                    <span style="color:red!important;">&nbsp;</span>
                                                }
                                                @nm[1]
                                            </p>
                                        }
                                    }
                                </div>

                                if (@nm[0] != "135")
                                {
                                    if (nm[4] != "")
                                    {
                                        <div class="col-md-4">
                                            <p style="margin-top: 30px;">@temp[0]</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            <p>@temp[0]</p>
                                        </div>
                                    }
                                }




                                if (temp.Count() > 1 && @temp[1] != "")
                                {
                                    if (@nm[0] == "135")
                                    {
                                        <div class="col-md-8">
                                            <textarea name="135" id="135">@temp[1]</textarea>
                                        </div>

                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            @if (nm[4] != "")
                                            {
                                                <p style="color:red">@nm[4]</p>
                                            }
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                        </div>

                                    }

                                }
                                else
                                {
                                    if (@nm[0] == "135")
                                    {
                                        <div class="col-md-8">
                                            <textarea name="135" id="135">@temp[0]</textarea>
                                        </div>

                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            @if (nm[4] != "")
                                            {
                                                <p style="color:red">@nm[4]</p>
                                            }
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off" maxlength="@nm[5]">
                                        </div>

                                    }

                                }


                            }
                            if (@nm[2] == "dropdown")
                            {
                                <div class="col-md-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-md-4">
                                    &nbsp;
                                </div>
                                <div class="col-md-4">
                                    <span> @nm[4] </span>
                                    @{
                                        int lastindex = nm.Length;
                                        string[] nmOption = nm[lastindex - 1].Split(',');
                                        string Fvalue = nm[lastindex - 2].ToString();
                                    }
                                    @if (@nm[0] == "591")
                                    {
                                        <input type="text" class="form-control" value="@temp[0]" readonly />
                                    }
                                    else
                                    {
                                        <select name=@nm[0] id=@nm[0] autocomplete="off" class="form-control ">
                                            @for (int i = 0; i < nmOption.Length; i++)
                                            {



                                                if (@nmOption[i].Trim() == Fvalue)
                                                {
                                                    <option selected>@nmOption[i]</option>

                                                }
                                                else
                                                {

                                                    <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                                }

                                            }
                                        </select>
                                        @Html.Hidden("HfCountryName")
                                        @Html.Hidden("HfStateName")
                                        @Html.Hidden("HfCityName")

                                    }
                                </div>

                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="col-sm">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm">
                                    <span> @nm[4] </span>
                                    @{
                                        if (@nm[6] == "TRUE")
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                        }
                                        else
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                        }
                                    }

                                </div>

                            }
                            if (@nm[2] == "fileUpload")
                            {
                                <div class="col-sm">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-sm">
                                    <sapn>@nm[4]</sapn>
                                    <input type="file" id=@nm[0] name=@nm[0] multiple accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                </div>


                            }
                        }

                    </div>

                }
                <div class="row">
                    <div class="col-sm-12 cytoscape-parent">
                        <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                    </div>
                </div>

                @*if (ReportComments != "")
                    {
                        <div class="row">
                            <div class="col-md-4">
                                Report Comment :
                            </div>
                            <div class="col-md-8">
                                <textarea name="Remarks" id="Remarks" rows="5" cols="8">@ReportComments</textarea>
                            </div>
                        </div>
                    }*@


                <div class="row" style="margin-bottom:20px;">
                    <div>
                        @{
                            if (Session["Designation"] != null)
                            {

                                if (Designation == "Team Member-Add" || Designation.StartsWith("Team Leader"))
                                {
                                    if (Designation.StartsWith("Team Leader"))
                                    {
                                        @Html.ActionLink("Back", "DepartmentTeamLeaderAllocation", "Verification", null, new { @class = "btn btn-default VerEmailDetails" })
                                    }
                                    else
                                    {
                                        @Html.ActionLink("Back", "ManageTeamMemberChecks", "Verification", new { CheckStatusId = checkStatusid }, new { @class = "btn btn-default VerEmailDetails" })

                                        if (checkStatusid == "20" || checkStatusid == "21" || checkStatusid == "38" || checkStatusid == "56" || checkStatusid == "111")
                                        {
                                            <input type="submit" value="Submit" style="width:15rem!important; padding:2% 0 2% 0; border-radius:.90rem; font-size:1.6rem!important;" />


                                            @Html.ActionLink("Capture Action", "CaptureActionHistoryByVerTM", "Verification", new { CandCheckRowid = CandCheckRowid, cid = clientRowId, scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateStatus cboxElement callbacks btn btn-default", @id = "VerificationActionHistostry" })

                                            @Html.ActionLink("Closer Details", "VerificationCloserDetails", "Verification", new { PersonalRowID = PersonalRowid, SubcheckRowID = SubCheckId, ClientRowID = clientRowId, Aging = "" }, new { @class = "btn btn-default VerEmailDetails", @id = "VerificationCloserDetails", @disabled = "disabled" })
                                            @Html.ActionLink("Attachment", "UplodAddressCheckDocsAndComplete", "Verification", new { scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @id = "UplodVerificationDocs" })
                                        }
                                    }
                                }
                                if (clientRowId == "990" && checkStatusid == "103")
                                {
                                    @Html.ActionLink("Capture Action", "CaptureActionHistoryByVerTM", "Verification", new { CandCheckRowid = CandCheckRowid, cid = clientRowId, scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateStatus cboxElement callbacks btn btn-default", @id = "VerificationActionHistostry" })

                                    @Html.ActionLink("Closer Details", "VerificationCloserDetails", "Verification", new { PersonalRowID = PersonalRowid, SubcheckRowID = SubCheckId, ClientRowID = clientRowId, Aging = "" }, new { @class = "btn btn-default VerEmailDetails", @id = "VerificationCloserDetails", @disabled = "disabled" })
                                    @Html.ActionLink("Attachment", "UplodAddressCheckDocsAndComplete", "Verification", new { scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @id = "UplodVerificationDocs" })

                                }
                                if (Designation.StartsWith("Manager"))
                                {
                                    @Html.ActionLink("Back", "DepartmentManagerAllocation", "Verification", new { CheckStatusId = checkStatusid }, new { @class = "btn btn-default VerEmailDetails" })
                                }
                                if (Designation == "Manager-Add" && checkStatusid == "20")
                                {

                                    <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" />
                                   <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Reject" />

                                }
                                if (clientRowId == "990" && checkStatusid == "103")
                                {
                                    <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" />
                                    <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Reject" />
                                }
                            }
                        }
                    </div>
                    <br />
                    <br />

                </div>
            }
        </div>
    </div>
</div>
