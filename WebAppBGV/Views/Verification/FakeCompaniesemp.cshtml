@{
    ViewBag.Title = "Suspect Companies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    string faIconExportExcel = "<i class='fa fa-file-excel me-1'></i> Export Excel";
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportSuspectedDatabase", "Verification", new { type = "Companies" }, new { @class = "btn btn-success btn-sm shadow-sm" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.Replace("linkTitle", faIconExportExcel));
}

@section NavigationButton{
    @Html.Partial("_NavigationButton")
}

@section DisplayErrorMessage{
    @Html.Partial("_DisplayErrorMessage")
}

<div class="container-fluid px-3 px-md-4 py-3">
    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            @section DisplayTitle{
                @Html.Partial("_DisplayTitle")
            }
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-white py-3 px-3 px-md-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 border-bottom">
            <h5 class="card-title text-dark fw-bold mb-0 fs-5">
                <i class="fa fa-building text-primary me-2"></i>Suspected Companies List
            </h5>
            <div>
                @Html.Raw(ViewBag.NavigationBtnExportExcel)
            </div>
        </div>

        <div class="card-body p-3 p-md-4">
            <!-- Custom Search Box (Guarantees Backspace & Delete work perfectly) -->
            <div class="row mb-3">
                <div class="col-md-4 col-sm-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="fa fa-search"></i></span>
                        <input type="text" id="customSearchInput" class="form-control" placeholder="Search company, address, remark..." autocomplete="off">
                    </div>
                </div>
            </div>

            @if (Model != null && Model.FakeComp != null)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100" id="suspectTable">
                        <thead class="table-light text-uppercase text-secondary">
                            <tr>
                                <th class="py-3 px-3 col-company">Company Name</th>
                                <th class="py-3 px-3 col-address">Address</th>
                                <th class="py-3 px-3 col-remark">Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.FakeComp)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark px-3 py-3 col-company">@a.CompanyName</td>
                                    <td class="text-secondary px-3 py-3 col-address">@a.Address</td>
                                    <td class="text-dark px-3 py-3 col-remark">@a.Remark</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <p class="mb-0">No suspect companies found.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- DataTables CSS CDN -->
<link href="~/assets/plugins/datatable/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* Fixed Column Widths & Layout Control to Prevent Grid Overflow */
    #suspectTable {
        table-layout: fixed;
        width: 100% !important;
    }

    /* Assign explicit proportions to columns */
    .col-company {
        width: 25%;
    }

    .col-address {
        width: 45%;
    }

    .col-remark {
        width: 30%;
    }

    /* Strict Text Wrapping and Break Rules */
    #suspectTable th,
    #suspectTable td {
        word-wrap: break-word;
        word-break: break-word;
        overflow-wrap: break-word;
        white-space: normal !important;
        vertical-align: top;
    }

    /* General Table & Polish Enhancements */
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    #suspectTable thead th {
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        font-weight: 600;
    }
</style>

<!-- DataTables JS CDN & Initialization -->
<script src="~/assets/NewScript/jquery-3.5.1.min.js"></script>
<script src="~/assets/plugins/datatable/js/jquery.dataTables.min.js"></script>
<script src="~/assets/plugins/datatable/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        if (!$.fn.DataTable.isDataTable('#suspectTable')) {
            var table = $('#suspectTable').DataTable({
                "pageLength": 10,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                "dom": '<"top">rt<"bottom"ip><"clear">', // Hides default DataTables search box to use our custom one
                "columnDefs": [
                    { "width": "25%", "targets": 0 },
                    { "width": "45%", "targets": 1 },
                    { "width": "30%", "targets": 2 }
                ],
                "autoWidth": false
            });

            // Connect custom search input securely to prevent focus loss and backspace block
            $('#customSearchInput').on('keyup input', function () {
                table.search(this.value).draw();
            });
        }
    });
</script>