@model ViewModels.ProvidedInfoViewModel.EmploymentEmailVerificationViewModel
@{
    Layout = null;
}

@{ 
    int clientRowID = 0;
    clientRowID = ViewBag.clientRowID;
}


<table align="center" border="0" cellpadding="0" cellspacing="0" width="600" style="background:#f4f4f4;">
    <tr>
        <td valign="top" style="font-family:arial; font-size:12px; padding: 0 0 5px 0; text-align:justify;">
            <table width="100%" id="tblCopy" border="0" cellpadding="0" cellspacing="0" style="padding:0 20px;">
                <tr>
                    <td>
                        <p style="font-family:arial; font-size:13px; font-weight:bold; padding:12px 0 27px 0;">Dear Sir/Mam,</p>
                        <p>Greetings from Securitas India!!! <br /><br /></p>
                    </td>
                </tr>
                <tr>
                    <td>We are one of the leading Background Verification Company, helping organizations secure their business by checking the antecedents of their employees. Securitas India (Walsons Services), is an Empaneled Background Verifier with NSR (National Skills Registry), extending expertise in pre and post-Employment Verification to our clients.<br /><br />Please find below the employment details of <b>@Model.CandidateName</b> while he was working with <b>@Model.CompanyName</b>.<br /><br />We request your support to take forward this initiative by verifying the provided information at earliest.<br /><br /></td>
                </tr>
                <tr>
                    <td>
                        <table width="100%" align="center" border="1" cellpadding="5" cellspacing="3">
                            <tr style="background:#e0e0e0; color:#000; font-size:12px;">
                                <td width="37%"><b>Details</b></td>
                                <td width="33%"><b>Candidate's Input</b></td>
                                <td width="30%"><b>HR Comments</b></td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:justify; font-weight:bold;">Company Name & Address</td>
                                <td style="font-size:10px; text-align:left;">@Model.CompanyNameAddress</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:justify; font-weight:bold;">Employee Code</td>
                                <td style="font-size:10px; text-align:left;">@Model.EmployeeCode</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:justify; font-weight:bold;">Period of Employment</td>
                                <td style="font-size:10px; text-align:left;">@Model.PeriodOfEmployment</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:justify; font-weight:bold;">Designation</td>
                                <td style="font-size:10px; text-align:left;">@Model.Designation</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:justify; font-weight:bold;">Remuneration</td>
                                <td style="font-size:10px; text-align:left;">@Model.Remuneration</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:left; font-weight:bold;">Supervisor Name & Designation</td>
                                <td style="font-size:10px; text-align:left;">@Model.SupervisorNameDesignation</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:justify; font-weight:bold;">Reason for leaving</td>
                                <td style="font-size:10px; text-align:left;">@Model.Reasonforleaving</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:justify; font-weight:bold;">Eligible for rehire</td>
                                <td style="font-size:10px; text-align:left;">Yes/ No (Please specify the reason)</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:left; font-weight:bold;">Is Exit Formalities Completed</td>
                                <td style="font-size:10px; text-align:left;">Yes/ No (Please specify the reason)</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            @if (clientRowID == 268)
                            {
                                <tr>
                                    <td style="font-size:10px; text-align:left; font-weight:bold;">Document Authenticated (Yes / No)</td>
                                    <td style="font-size:10px; text-align:left;"></td>
                                    <td style="font-size:10px; text-align:left;">&nbsp;</td>
                                </tr>
                            }
                            <tr>
                                <td style="font-size:10px; text-align:left; font-weight:bold;">Duties & responsibilities handled</td>
                                <td style="font-size:10px; text-align:left;">@Model.DutiesResponsibilitiesHandled</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:left; font-weight:bold;">Any Integrity/ Disciplinary Issue</td>
                                <td style="font-size:10px; text-align:left;">@Model.AnyIntegrityDisciplinaryIssue</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:left; font-weight:bold;">Performance at Work</td>
                                <td style="font-size:10px; text-align:left;">@Model.PerformanceAtWork</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="font-size:10px; text-align:left; font-weight:bold;">Additional Comments</td>
                                <td style="font-size:10px; text-align:left;">@Model.AdditionalComments</td>
                                <td style="font-size:10px; text-align:left;">&nbsp;</td>
                            </tr>
                        </table><br /><br />
                    </td>
                </tr>
                <tr>
                    <td style="color:#000; font-size:12px;"><b>Verified From:</b> <br /><br /></td>
                </tr>
                <tr>
                    <td>
                        <table width="100%" align="center" border="1" cellpadding="5" cellspacing="3">
                            <tr style="color:#000; font-size:10px;">
                                <td width="19%"><b>Name</b></td>
                                <td width="33%">&nbsp;</td>
                            </tr>
                            <tr style="color:#000; font-size:10px;">
                                <td><b></b>Designation</td>
                                <td>&nbsp;</td>
                            </tr>
                            <tr style="color:#000; font-size:10px;">
                                <td><b>Contact Number</b></td>
                                <td>&nbsp;</td>
                            </tr>
                            <tr style="color:#000; font-size:10px;">
                                <td><b>Official Email-id</b></td>
                                <td>&nbsp;</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td height="35px;">&nbsp;</td>
                </tr>

            </table>
        </td>
    </tr>

</table>

