
@model ViewModels.VerificationViewModel.WiproUANCheckViewModel
@{
    ViewBag.Title = "DrugTest";
    Layout = null;

}

@{





}

<link href="~/Content/bootstrap.min.css" rel="stylesheet" />

@using (Html.BeginForm("WiproUANValidation", "Verification", FormMethod.Post))
{
    @*<input type="hidden" name="personalrowid" value="@personalrowid" />*@

<div class="container">
    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">Employment</lable>
        </div>
        <div class="col-md-4">
            @*<select name="ddlTest1" class="form-control">
                    <option>Employment 1</option>
                    <option>Employment 2</option>
                    <option>Employment 3</option>
                    <option>Employment 4</option>
                    <option>Employment 5</option>
                    <option>Employment 6</option>
                </select>*@

            @Html.DropDownListFor(model => model.WiproUANCheck.Employment,
             new List<SelectListItem> {
                  new SelectListItem { Value = "Employment 1" , Text = "Employment 1" },
                  new SelectListItem { Value = "Employment 2" , Text = "Employment 2" },
                  new SelectListItem { Value = "Employment 3" , Text = "Employment 3" },
                  new SelectListItem { Value = "Employment 4" , Text = "Employment 4" },
                  new SelectListItem { Value = "Employment 5" , Text = "Employment 5" },
                  new SelectListItem { Value = "Employment 6" , Text = "Employment 6" },
                  new SelectListItem { Value = "Employment 7" , Text = "Employment 7" },
                  new SelectListItem { Value = "Employment 8" , Text = "Employment 8" },
                  new SelectListItem { Value = "Employment 9" , Text = "Employment 9" }
               },
             new { @class="myselect"})
        </div>





    </div>

    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">Company Name</lable>
        </div>
        <div class="col-md-4">

            @Html.TextBoxFor(T => T.WiproUANCheck.CompanyName)
            
        </div>


    </div>
    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">UAN DOJ</lable>
        </div>
        <div class="col-md-4">

            @Html.TextBoxFor(T => T.WiproUANCheck.UAN_DOJ)
            @Html.HiddenFor(T => T.WiproUANCheck.PersonalrowId)
        </div>


    </div>
    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">UAN LWD</lable>
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(T => T.WiproUANCheck.UAN_LWD)
        </div>


    </div>
    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">HR DOJ</lable>
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(T => T.WiproUANCheck.HR_DOJ)
        </div>


    </div>

    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">HR LWD</lable>
        </div>
        <div class="col-md-4">
            @Html.TextBoxFor(T => T.WiproUANCheck.HR_LWD)
        </div>
    </div>

    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">IVerify DOJ</lable>
        </div>
        <div class="col-md-4">
            @Html.TextBoxFor(T => T.WiproUANCheck.IVerify_DOJ)
        </div>
    </div>

    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">IVerify LWD</lable>
        </div>
        <div class="col-md-4">
            @Html.TextBoxFor(T => T.WiproUANCheck.IVerify_LWD)
        </div>
    </div>

    <div class="row">
        <div class="col-md-2">
            <lable class="form-control-label">iVerify Y/N</lable>
        </div>
        <div class="col-md-4">
            @Html.TextBoxFor(T => T.WiproUANCheck.iVerify_Y_N)
        </div>
    </div>



    <div class="row">

        <div class="col-md-4">

            <br />
            <div>

                <input class="btn bun-bg btn-default" type="submit" value="Check Action" name="MoveCheck" />
            </div>
        </div>
    </div>
</div>

    if (Model != null && Model.WiproUANChecklist != null)
    {
        <div class="row">
            <div class="col-md-12">
                @{

                    WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                    grid.Bind(Model.WiproUANChecklist, autoSortAndPage: false, rowCount: Model.TotalRecords);
                }
                @grid.GetHtml(
                        htmlAttributes: new { id = "grid", @class = "table" },
                        headerStyle: "thead-inverse",
                        rowStyle: "ordertxt",
                        footerStyle: "custpaging",
                        mode: WebGridPagerModes.All,
                        columns: new[]
                        {



                    //          public string PersonalrowId { get; set; }
                    //public string Employment { get; set; }
                    //public string UAN_DOJ { get; set; }
                    //public string UAN_LWD { get; set; }
                    //public string HR_DOJ { get; set; }
                    //public string HR_LWD { get; set; }
                    //public string IVerify_DOJ { get; set; }
                    //public string IVerify_LWD { get; set; }
                    //public string iVerify_Y_N { get; set; }


                    grid.Column(columnName: "Employment", header: "Employment type", canSort: false, style:"col-md-2"),
                      grid.Column(columnName: "CompanyName", header: "CompanyName", canSort: false, style:"col-md-2"),
                                                            grid.Column(columnName: "UAN_DOJ", header: "UAN DOJ", canSort: false, style:"col-md-2"),
                                                            grid.Column(columnName: "UAN_LWD", header: "UAN LWD", canSort: false, style:"col-md-2"),
                                                            grid.Column(columnName: "HR_DOJ", header: "HR DOJ", canSort: false, style:"col-md-2"),
                                                             grid.Column(columnName: "HR_LWD", header: "HR LWD", canSort: false, style:"col-md-2"),

                                                              grid.Column(columnName: "IVerify_DOJ", header: "IVerify DOJ", canSort: false, style:"col-md-2"),
                                                             grid.Column(columnName: "IVerify_LWD", header: "IVerify LWD", canSort: false, style:"col-md-2"),
                                                              grid.Column(columnName: "iVerify_Y_N", header: "iVerify_Y_N", canSort: false, style:"col-md-2"),


                                                         }
                                                  )
                <div class="total-record">Total Records: @Model.TotalRecords</div>
            </div>
        </div>
    }

}