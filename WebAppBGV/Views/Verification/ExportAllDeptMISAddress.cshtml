
@{
    ViewBag.Title = "Manager Case Allocation To TeamLeader";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@{

    string tatdays1 = "";
    string CheckStatus1 = "";
    string AllocatedToTL1 = "";
    string CompletedFromDate = "";
    string CompletedToDate = "";
    if (Request.QueryString["tatdays"] != null)
    {
        tatdays1 = Request.QueryString["tatdays"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CheckStatus"] != null)
    {
        CheckStatus1 = @Request.QueryString["CheckStatus"].ToString();
    }
    if (Request.QueryString["CompletedFromDate"] != null)
    {
        CompletedFromDate = @Request.QueryString["CompletedFromDate"].ToString();
    }
    if (Request.QueryString["CompletedToDate"] != null)
    {
        CompletedToDate = @Request.QueryString["CompletedToDate"].ToString();
    }



}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ExportAllDeptMISAddress", "Verification", FormMethod.Get))
                        {
                            <div class="form-horizontal">



                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Case Created date From :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "dd-mm-yyyy" })
                                    </div>
                                    <label class="col-md-2 control-label">Case Created date To :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "dd-mm-yyyy" })
                                    </div>
                                </div>

                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />

                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>*@

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            // 1st replace first column header text with checkbox
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });

            var cID = 0;
            cID = $('#ClientRowID').val();
            $("#btnAllocation").attr("disabled", true);
            $("#AllocateTL").attr("disabled", true);
            if (cID > 0) {
                $("#btnAllocation").attr("disabled", false);
                $("#AllocateTL").attr("disabled", false);
                $.getJSON('/Verification/GetTLMemberForAllocate/' + $('#ClientRowID').val(), function (data) {
                    var items = '<option value="0" >-- Select Member --</option>';
                    $.each(data, function (i, DETM) {
                        items += "<option value='" + DETM.Value + "'>" + DETM.Text + "</option>";
                    });
                    $('#AllocateTL').html(items);
                });
            }
            //2nd click event for header checkbox for select /deselect all
            $('#select_all').change(function () {
                $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                var VerificationIds = '';
                var OCVerIDs = '';
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';
                        OCVerIDs += this.value + ',';

                    }
                });
                if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                    OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
                } else {
                    VerificationIds = '';
                    OCVerIDs = '';
                }
                $('#VerificationIds').val(VerificationIds.trim());
                $('#OCVerIDs').val(OCVerIDs.trim());
            });

            $('#ClientRowID').change(function () {
                $("#btnAllocation").attr("disabled", true);
                $("#AllocateTL").attr("disabled", true);
            });

            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });

        function AllocatebtnShow() {
            $("#btnAllocation").attr("disabled", false);
            $("#AllocateTL").attr("disabled", false);
        }

        //3rd click event for checkbox of each row
        $(document).on('change', 'input[class="verificationId"]', function (e) {// on change of state
            var VerificationIds = '';
            var OCVerIDs = '';
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) {
                    var id = this.value.split('_');
                    VerificationIds += id[0] + ',';
                    OCVerIDs += this.value + ',';
                }
            });

            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("#select_all").prop('checked', false); //change "select all" checked status to false
            }
            //check "select all" if all checkbox items are checked
            if ($('.verificationId:checked').length == $('.verificationId').length) {
                $("#select_all").prop('checked', true);
            }

            if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
            } else {
                VerificationIds = '';
                OCVerIDs = '';
            }
            $('#VerificationIds').val(VerificationIds.trim());
            $('#OCVerIDs').val(OCVerIDs.trim());
        })

        function validateForm() {
            if ($("#AllocateTL").val() == 0) {
                alert("Select Team Leader For Allocate.");
                return false;
            }

            var count = 0;
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one case.");
                return false;
            }
            return true;
        }

    </script>
}