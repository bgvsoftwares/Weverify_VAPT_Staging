@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
        <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
        <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
        <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
        <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
        <link href="~/Content/colorbox.css" rel="stylesheet" />
        <script src="~/Scripts/jquery.colorbox-min.js"></script>*@
    <script>

        $('#ChkExportExcel').change(function () {
            if (this.checked) {
                document.getElementById("btnExportExcel").style.display = "block";
            }
            else {
                document.getElementById("btnExportExcel").style.display = "None";
            }
        });

        $(document).ready(function () {
            $('#ChkExportExcel').val() = false;
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            // 1st replace first column header text with checkbox
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });

            var cID = 0;
            cID = $('#ClientRowID').val();
            $("#btnAllocation").attr("disabled", true);
            $("#AllocateTL").attr("disabled", true);
            if (cID > 0) {
                $("#btnAllocation").attr("disabled", false);
                $("#AllocateTL").attr("disabled", false);
                $.getJSON('/Verification/GetTLMemberForAllocate/' + $('#ClientRowID').val(), function (data) {
                    var items = '<option value="0" >-- Select Member --</option>';
                    $.each(data, function (i, DETM) {
                        items += "<option value='" + DETM.Value + "'>" + DETM.Text + "</option>";
                    });
                    $('#AllocateTL').html(items);
                });
            }
            //2nd click event for header checkbox for select /deselect all
            $('#select_all').change(function () {
                $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                var VerificationIds = '';
                var OCVerIDs = '';
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';
                        OCVerIDs += this.value + ',';

                    }
                });
                if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                    OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
                } else {
                    VerificationIds = '';
                    OCVerIDs = '';
                }
                $('#VerificationIds').val(VerificationIds.trim());
                $('#OCVerIDs').val(OCVerIDs.trim());
            });

            $('#ClientRowID').change(function () {
                $("#btnAllocation").attr("disabled", true);
                $("#AllocateTL").attr("disabled", true);
            });

            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });

        function AllocatebtnShow() {
            $("#btnAllocation").attr("disabled", false);
            $("#AllocateTL").attr("disabled", false);
        }

        //3rd click event for checkbox of each row
        $(document).on('change', 'input[class="verificationId"]', function (e) {// on change of state

            debugger;
            var VerificationIds = '';
            var OCVerIDs = '';


            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) {
                    var id = this.value.split('_');
                    VerificationIds += id[0] + ',';
                    OCVerIDs += this.value + ',';
                }
            });



            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("#select_all").prop('checked', false); //change "select all" checked status to false
            }
            //check "select all" if all checkbox items are checked
            if ($('.verificationId:checked').length == $('.verificationId').length) {
                $("#select_all").prop('checked', true);
            }

            if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
            } else {
                VerificationIds = '';
                OCVerIDs = '';
            }


            $('#VerificationIds').val(VerificationIds.trim());
            $('#OCVerIDs').val(OCVerIDs.trim());
        })

        function validateForm() {
            if ($("#AllocateTL").val() == 0) {
                alert("Select Team Leader For Allocate.");
                return false;
            }

            var count = 0;
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one case.");
                return false;
            }
            return true;
        }


        function create_custom_dropdowns() {
            $('select').each(function (i, select) {
                if (!$(this).next().hasClass('dropdown-select')) {
                    $(this).after('<div class="dropdown-select wide ' + ($(this).attr('class') || '') + '" tabindex="0"><span class="current"></span><div class="list"><ul></ul></div></div>');
                    var dropdown = $(this).next();
                    var options = $(select).find('option');
                    var selected = $(this).find('option:selected');
                    dropdown.find('.current').html(selected.data('display-text') || selected.text());
                    options.each(function (j, o) {
                        var display = $(o).data('display-text') || '';
                        dropdown.find('ul').append('<li class="option ' + ($(o).is(':selected') ? 'selected' : '') + '" data-value="' + $(o).val() + '" data-display-text="' + display + '">' + $(o).text() + '</li>');
                    });
                }
            });

            $('.dropdown-select ul').before('<div class="dd-search"><input id="txtSearchValue" autocomplete="off" onkeyup="filter()" class="dd-searchbox" type="text"></div>');
        }

        // Event listeners

        // Open/close
        $(document).on('click', '.dropdown-select', function (event) {
            if ($(event.target).hasClass('dd-searchbox')) {
                return;
            }
            $('.dropdown-select').not($(this)).removeClass('open');
            $(this).toggleClass('open');
            if ($(this).hasClass('open')) {
                $(this).find('.option').attr('tabindex', 0);
                $(this).find('.selected').focus();
            } else {
                $(this).find('.option').removeAttr('tabindex');
                $(this).focus();
            }
        });

        // Close when clicking outside
        $(document).on('click', function (event) {
            if ($(event.target).closest('.dropdown-select').length === 0) {
                $('.dropdown-select').removeClass('open');
                $('.dropdown-select .option').removeAttr('tabindex');
            }
            event.stopPropagation();
        });

        function filter() {
            var valThis = $('#txtSearchValue').val();
            $('.dropdown-select ul > li').each(function () {
                var text = $(this).text();
                (text.toLowerCase().indexOf(valThis.toLowerCase()) > -1) ? $(this).show() : $(this).hide();
            });
        };
        // Search

        // Option click
        $(document).on('click', '.dropdown-select .option', function (event) {
            $(this).closest('.list').find('.selected').removeClass('selected');
            $(this).addClass('selected');
            var text = $(this).data('display-text') || $(this).text();
            $(this).closest('.dropdown-select').find('.current').text(text);
            $(this).closest('.dropdown-select').prev('select').val($(this).data('value')).trigger('change');
        });

        // Keyboard events
        $(document).on('keydown', '.dropdown-select', function (event) {
            var focused_option = $($(this).find('.list .option:focus')[0] || $(this).find('.list .option.selected')[0]);
            // Space or Enter
            //if (event.keyCode == 32 || event.keyCode == 13) {
            if (event.keyCode == 13) {
                if ($(this).hasClass('open')) {
                    focused_option.trigger('click');
                } else {
                    $(this).trigger('click');
                }
                return false;
                // Down
            } else if (event.keyCode == 40) {
                if (!$(this).hasClass('open')) {
                    $(this).trigger('click');
                } else {
                    focused_option.next().focus();
                }
                return false;
                // Up
            } else if (event.keyCode == 38) {
                if (!$(this).hasClass('open')) {
                    $(this).trigger('click');
                } else {
                    var focused_option = $($(this).find('.list .option:focus')[0] || $(this).find('.list .option.selected')[0]);
                    focused_option.prev().focus();
                }
                return false;
                // Esc
            } else if (event.keyCode == 27) {
                if ($(this).hasClass('open')) {
                    $(this).trigger('click');
                }
                return false;
            }
        });

        $(document).ready(function () {
            create_custom_dropdowns();
        });


    </script>
}

