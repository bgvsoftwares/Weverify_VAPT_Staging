
@{
    ViewBag.Title = "Manage Team Member Checks Jobs";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}
@{

    string tatdays1 = "";
    string CheckStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatdays"] != null)
    {
        tatdays1 = Request.QueryString["tatdays"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CheckStatus"] != null)
    {
        CheckStatus1 = @Request.QueryString["CheckStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = "";
    if (Session["Designation"].ToString() == "Team Member-SPL" || Session["Designation"].ToString() == "Team Member-Cri")
    {
        hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportChecksReport", "Verification", new { CheckStatus = CheckStatus1, tatdays = tatdays1, AllocatedToTL = AllocatedToTL1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    }
    else
    {
        hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportChecksReport", "Verification", new { CheckStatus = CheckStatus1, tatdays = tatdays1, AllocatedToTL = AllocatedToTL1 }, new { @class = "btn bun-bg btn-default" }).ToString();

    }
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}


@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageManagerChecks", "Verification", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                                   new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                                   "-- Select Client -- ",
                                                   new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No,Company name..." })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">CheckStatus :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("DCheckStatus",
                                              new SelectList(ViewBag.CheckStatusOptionList, "Value", "Text"),
                                              "-- Select Check -- ",
                                              new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Case Status :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("CaseStatus",
                                                   new SelectList(ViewBag.CaseStatusOptionList, "Value", "Text"),
                                                   "-- Select Case -- ",
                                                   new { @class = "form-control" })
                                    </div>
                                </div>
                                @{ string Designation = Session["Designation"].ToString();
                                    if (!string.IsNullOrWhiteSpace(Designation) && Designation != "Team Member-Ref" && Designation != "Team Member-Ide")
                                    {

                                        if (Designation != null && Designation == "Team Member-Edu")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Institute Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                @{
                                    if (Request.QueryString["CheckStatus"] != null)
                                    {
                                        @Html.Hidden("CheckStatus", Request.QueryString["CheckStatus"].ToString())
                                    }

                                    if (Request.QueryString["tatdays"] != null)
                                    {
                                        @Html.Hidden("tatdays", Request.QueryString["tatdays"].ToString())
                                    }
                                }
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" onclick="SearchFunction()" value="Search" style="font-size:1.4rem!important;" />
                                    @if (Designation != null && Designation == "Team Member-Emp")
                                    {
                                        if (CheckStatus1 == "WIP")
                                        {
                                            <input class="btn bun-bg btn-default" id="btnGroupMail" type="submit" value="Create Group Mail" style="background-color:#11c9b7!important; font-size:1.4rem!important; cursor:pointer" />
                                        }
                                        @Html.Hidden("VEmploymentId");
                                    }
                                </div>

                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table table-striped">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @{
                                string Designation = Convert.ToString(Session["Designation"]);

                                if (Designation != null)
                                {
                                    @grid.GetHtml(
                                                       htmlAttributes: new { id = "grid", @class = "table" },
                                                       headerStyle: "thead-inverse",
                                                       rowStyle: "ordertxt",
                                                       footerStyle: "custpaging",
                                                       mode: WebGridPagerModes.All,
                                                       columns: new[]
                                                       {
                                                           grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                           grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),
                                                           grid.Column(header : "Securitas ID", format : (item) => {
                                                               string SecuritasID=item.CompanyRefNo;
                                                                if (item.CheckFamilyRowID==11 && item.CheckStatus != "Allocated-TL")
                                                               {
                                                                   var link = Html.ActionLink(SecuritasID, "AddEducationInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID, CheckStatus=CheckStatus1 }, new { @class="edit" });
                                                                   return link;
                                                               }
                                                               else
                                                               {
                                                                   return SecuritasID;
                                                               }                                                                                                                                                                    }, style:"td-1"),
                                                           grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"td-1"),
                                                           grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-2"),
                                                           grid.Column(columnName: "OfficialEmailId", header: "Email", canSort: false, style:"td-1"),
                                                           grid.Column(columnName: "UniversityName", header: "UniversityName", canSort: false, style:"td-1"),
                                                           grid.Column("Ageing", format: (item) => item.InternalOutDate != null ? (item.InternalOutDate - DateTime.Now).Days : "", canSort: false,style:""),
                                                           grid.Column("OutDate", "TAT", format: (item) => item.OutDate != null ? item.OutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                                           grid.Column(columnName: "SecuritasSPOC", header: "SPOC", canSort: false, style:"td-2"),
                                                           grid.Column("Check Status", canSort: false, format: (item)=> {
                                                               var link=@Html.ActionLink("Show", "ClientCheckStatus", "ClientServicing", new { CompanyRefNo=item.CompanyRefNo    }, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
                                                               return link;
                                                           }, style:"td-1" ),
                                                           grid.Column(header : "Action", format : (item) => {
                                                               var link = Html.ActionLink("History", "CheckActionHistory", "Verification", new { scid = item.SubCheckRowID, pe = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement callbacks" });
                                                               return link;
                                                           }, style:"edit td-1"),
                                                           grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:"td-1"),
                                                           grid.Column("Remarks", canSort: false, format: (item)=> {
                                                               if (item.CheckStatus=="Insufficent-QC" && !string.IsNullOrEmpty(item.CheckStatus))
                                                               {
                                                                   var link=@Html.ActionLink("Remarks", "InsuffRemarks", "Verification", new { PersonalRowID = item.PersonalRowID ,SubCheckRowID = item.SubCheckRowID,processName="L2-Insuff-TM" }, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
                                                                   return link;
                                                               }
                                                               return null;
                                                           }, style:"td-1" ),
                                                           grid.Column("Reminder", canSort: false, format: (item)=> {
                                                               if (item.CheckStatusid==20 || item.CheckStatusid==90)
                                                               {
                                                                   var link=@Html.ActionLink("open", "EducationReminderMail", "Verification", new { SubCheckRowID = item.SubCheckRowID,PersonalRowID=item.PersonalRowID,CheckStatusId=item.CheckStatusid,CandCheckRowID=item.CandCheckRowID,CandName=item.PersonalName,ToEmail=item.OfficialEmailId,OrgnName=item.UniversityName,CheckStatus=CheckStatus1},  new { @class = "Remindermail  callbacks"});
                                                                   return link;
                                                               }
                                                               return null;
                                                           }, style:"td-1" ),
                                                           grid.Column("Create", canSort: false, format: (item)=> {
                                                               if ((item.ClientRowID==317 ||item.ClientRowID==327) && (item.CheckFamilyRowID==11 ||  item.CheckFamilyRowID==12))
                                                               {
                                                                   var link=@Html.ActionLink("Comprehensive", "ComprehensiveCheckCreate", "Verification", new {id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID, CheckStatus=CheckStatus1 }, new {@class = "Remindermail  callbacks"});
                                                                   return link;
                                                               }
                                                               return null;
                                                           }, style:"td-1" ),

                                                       }

                                                   )
                                }
                            }

                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                            <br />
                            <br />
                        </div>
                    </div>
                }

            </div>s
        </div>
    </div>
</div>



@section Scripts{


    <script type="text/javascript">


        $(document).ready(function () {

            $('input[class="verificationId"]').css('display', 'none');

            $('#btnGroupMail').attr('disabled', 'disabled');
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".iframemap").colorbox({ iframe: true, width: "90%", height: "90%" });
            $(".Remindermail").colorbox({ iframe: true, width: "80%", height: "100%" });
            $(".Sendgroup").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".iframeUpdateAddressDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

            $('#select_all').change(function () {
                $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                var VerificationIds = '';
                var Organization_Name = '';
                var myarray = [];
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';

                        if (jQuery.inArray(id[1], myarray) == -1 && myarray.length>0)
                        {
                            alert("please select same company");
                            $('input[class="verificationId"]').prop('checked', false);
                            $('#select_all').prop('checked', false);
                            VerificationIds = '';
                            $('#btnGroupMail').attr('disabled', 'disabled');
                        }
                        myarray.push(id[1]);

                    }
                });
                if (VerificationIds.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                    $('#btnGroupMail').removeAttr('disabled');
                } else {
                    VerificationIds = '';
                    $('#btnGroupMail').attr('disabled', 'disabled');
                }
                $('#VEmploymentId').val(VerificationIds.trim());
            });


            $(document).on('change', 'input[class="verificationId"]', function (e) {
                var VerificationIds = '';
                var Organization_Name = '';
                var myarray = [];
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';
                        $("#VEmploymentId").val(VerificationIds);
                        alert($("#VEmploymentId").val());

                        //alert(id[1]);
                        if (jQuery.inArray(id[1], myarray) == -1 && myarray.length > 0) {
                            alert("please select same company");
                            $('input[class="verificationId"]').prop('checked', false);
                            $('#select_all').prop('checked', false);
                            $('#VEmploymentId').val("");
                            VerificationIds = '';
                            $('#btnGroupMail').attr('disabled', 'disabled');
                        }
                        myarray.push(id[1]);
                    }
                });

                if (false == $(this).prop("checked")) {
                    $("#select_all").prop('checked', false);
                }

                if ($('.verificationId:checked').length == $('.verificationId').length) {
                    $("#select_all").prop('checked', true);
                }
                if (VerificationIds.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                    $("#VEmploymentId").val(VerificationIds);
                    $('#btnGroupMail').removeAttr('disabled');
                    alert($("#VEmploymentId").val());

                } else {
                    VerificationIds = '';
                    $('#btnGroupMail').attr('disabled', 'disabled');
                }
                $('#VEmploymentId').val(VerificationIds.trim());
            })




        });

        function SearchFunction() {
            $('#VEmploymentId').val("");
        }
        $('#RecievingToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#RecievingFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });





    </script>
}
