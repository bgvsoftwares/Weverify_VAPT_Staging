@model ViewModels.ProvidedInfoViewModel.VerifiedUploadAddressDocViewModel
@{
    ViewBag.Title = "Upload Address Check Ver Docs";
    Layout = null;
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<div class="row">
    <div class="col-md-12">
        @if (ViewBag.SuccessMsg != null)
        {
            <div class="successmsg">@ViewBag.SuccessMsg.ToString()</div>
        }

        @if (ViewBag.ErrorMsg != null)
        {
            <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="all-button-bg">
            <strong> Upload Address Check Ver Docs </strong>
        </div>
        @using (Html.BeginForm("UplodAddressCheckDocsAndComplete", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.SubCheckRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.CheckStatus)
        <div class="form-horizontal">
            <div class="form-group branch">
                @Html.LabelFor(model => model.UploadSignatureDoc, htmlAttributes: new { @class = "col-md-2 control-label" })
                <div class="col-md-3">
                    @Html.TextBoxFor(model => model.UploadSignatureDoc, new { @accept = "image/gif, image/jpeg, image/png, image/jpg, application/pdf", type = "file", multiple = "multiple" })
                </div>
            </div>
            <div class="form-group branch">
                @Html.LabelFor(model => model.UploadIDProofDoc, htmlAttributes: new { @class = "col-md-2 control-label" })
                <div class="col-md-3">
                    @Html.TextBoxFor(model => model.UploadIDProofDoc, new { @accept = "image/gif, image/jpeg, image/png, image/jpg, application/pdf", type = "file", multiple = "multiple" })
                </div>
            </div>
            <div class="form-group branch">
                @Html.LabelFor(model => model.UploadHousephotoDoc, htmlAttributes: new { @class = "col-md-2 control-label" })
                <div class="col-md-3">
                    @Html.TextBoxFor(model => model.UploadHousephotoDoc, new { @accept = "image/gif, image/jpeg, image/png, image/jpg, application/pdf", type = "file", multiple = "multiple" })
                </div>
            </div>
            <div class="form-group branch">
                @Html.LabelFor(model => model.UploadLandmarkPhotoDoc, htmlAttributes: new { @class = "col-md-2 control-label" })
                <div class="col-md-3">
                    @Html.TextBoxFor(model => model.UploadLandmarkPhotoDoc, new { @accept = "image/gif, image/jpeg, image/png, image/jpg, application/pdf", type = "file", multiple = "multiple" })
                </div>
            </div>
            <div class="form-group branch">
                @Html.LabelFor(model => model.UploadLocation, htmlAttributes: new { @class = "col-md-2 control-label" })
                <div class="col-md-3">
                    @Html.TextBoxFor(model => model.UploadLocation, new { @accept = "image/gif, image/jpeg, image/png, image/jpg, application/pdf", type = "file", multiple = "multiple" })
                </div>
            </div>
            <div class="all-button-bg">
                <input class="btn bun-bg btn-default" type="submit" value="Submit" />
            </div>
        </div>
        }

    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
}


