@model ViewModels.ProvidedInfoViewModel.VerifiedUploadDocViewModel
@{
    ViewBag.Title = "UplodNationalIdentityVerDocs";
    Layout = null;
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<div class="row">
    <div class="col-md-12">
        @if (ViewBag.SuccessMsg != null)
        {
            <div class="successmsg">@ViewBag.SuccessMsg.ToString()</div>
        }

        @if (ViewBag.ErrorMsg != null)
        {
            <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-12">

        @using (Html.BeginForm("UplodNationalIdentityVerDocs", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.SubCheckRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.CheckStatus)
            @Html.HiddenFor(model => model.ClientRowId)

            if (Model.ClientRowId==75 && Model.SubCheckRowID== 136)
            {
                <div class="form-horizontal">
                    @*<div class="form-group branch">
                            <p style="color:red; font-size:16px; text-align:center "><br />  UNA documnet is mandatory for current Employment.</p>
                            @Html.LabelFor(model => model.DocumentType, htmlAttributes: new { @class = "col-md-2 control-label" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.DocumentType, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.DocumentType, "", new { @class = "text-danger" })
                            </div>
                        </div>*@

                    <div class="form-group branch">
                        <p style="color:red; font-size:16px; text-align:center "><br />  UNA documnet is mandatory for Previous Employment.</p>
                        @Html.LabelFor(model => model.DocumentType, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-3">
                            @Html.DropDownListFor(model => model.DocumentType, new List<SelectListItem> {
                                new SelectListItem { Text = "-- Select DocumentType -- ", Value = "" },
                                new SelectListItem { Text = "Verification Artifact", Value = "Verification Artifact" },
                                new SelectListItem { Text = "Provided Document",Value="Provided Document"},
                                new SelectListItem { Text = "Others if any",Value="Others if any"},
                            }, new { @id = "DocumentTypeDDL75", @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.DocumentType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group branch" id="OtherDocumentTypeDiv75" style="display:none;">
                        @Html.Label("OtherDocumentType", "Specify Other", htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(model => model.OtherDocumentType, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-group branch">
                        @Html.LabelFor(model => model.UploadDoc, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(model => model.UploadDoc, new { @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file", multiple = "multiple" })
                            @Html.ValidationMessageFor(model => model.UploadDoc, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group branch">
                        @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "2" })
                            @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="all-button-bg">
                        @*@Html.ActionLink("Back", "AddNationalIdentityInfoByTeamMember", "Verification", new { id = Model.CheckfiledRowID, ClientRowId = Model.ClientRowID, ChFamilRowId = Model.ChFamilRowId, subCheckId = Model.SubCheckRowID, PersonalRowID = Model.PersonalRowID }, new { @class = "btn bun-bg btn-default" })*@

                        <input class="btn bun-bg btn-default" type="submit" value="Submit" />
                    </div>
                </div>
            }
            else
            {
                <div class="form-horizontal">
                    @*<div class="form-group branch">
                            @Html.LabelFor(model => model.DocumentType, htmlAttributes: new { @class = "col-md-2 control-label" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.DocumentType, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.DocumentType, "", new { @class = "text-danger" })
                            </div>
                        </div>*@

                    <div class="form-group branch">
                        @Html.LabelFor(model => model.DocumentType, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-3">
                            @Html.DropDownListFor(model => model.DocumentType, new List<SelectListItem> {
                                new SelectListItem { Text = "-- Select DocumentType -- ", Value = "" },
                                new SelectListItem { Text = "Verification Artifact", Value = "Verification Artifact" },
                                new SelectListItem { Text = "Provided Document",Value="Provided Document"},
                                new SelectListItem { Text = "Others if any",Value="Others if any"},
                            }, new { @id = "DocumentTypeDDL", @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.DocumentType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group branch" id="OtherDocumentTypeDiv" style="display:none;">
                        @Html.Label("OtherDocumentType", "Specify Other", htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(model => model.OtherDocumentType, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-group branch">
                        @Html.LabelFor(model => model.UploadDoc, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(model => model.UploadDoc, new { @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file", multiple = "multiple" })
                            @Html.ValidationMessageFor(model => model.UploadDoc, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group branch">
                        @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "2" })
                            @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="all-button-bg">
                        @*@Html.ActionLink("Back", "AddNationalIdentityInfoByTeamMember", "Verification", new { id = Model.CheckfiledRowID, ClientRowId = Model.ClientRowID, ChFamilRowId = Model.ChFamilRowId, subCheckId = Model.SubCheckRowID, PersonalRowID = Model.PersonalRowID }, new { @class = "btn bun-bg btn-default" })*@

                        <input class="btn bun-bg btn-default" type="submit" value="Submit" />
                    </div>
                </div>
            }

        }

    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
}

<script>
    $(document).ready(function () {
        function fnToggleOtherBox(ddlId, otherDivId) {
            var selected = $(ddlId).val();
            if (selected === "Others if any") {
                $(otherDivId).show();
            } else {
                $(otherDivId).hide();
                $(otherDivId + ' input').val("");
            }
        }

        function setRemarksBasedOnDDL(ddlId) {
            var selected = $(ddlId).val();
            var remarks = "";

            // Only autofill if not 'Others if any' and not empty
            if (selected && selected !== "Others if any") {
                remarks = selected;
            }

            $('#Remarks').val(remarks);
        }
                    // on load (returns to form)
        fnToggleOtherBox('#DocumentTypeDDL75', '#OtherDocumentTypeDiv75');
        fnToggleOtherBox('#DocumentTypeDDL', '#OtherDocumentTypeDiv');

        setRemarksBasedOnDDL('#DocumentTypeDDL75');
        setRemarksBasedOnDDL('#DocumentTypeDDL');
        // DDL changes event for 'if' section
        $('#DocumentTypeDDL75').change(function () {
            fnToggleOtherBox('#DocumentTypeDDL75', '#OtherDocumentTypeDiv75');
            setRemarksBasedOnDDL('#DocumentTypeDDL75');
        });
        $('#DocumentTypeDDL').change(function () {
            fnToggleOtherBox('#DocumentTypeDDL', '#OtherDocumentTypeDiv');
            setRemarksBasedOnDDL('#DocumentTypeDDL');
        });
    });
</script>
