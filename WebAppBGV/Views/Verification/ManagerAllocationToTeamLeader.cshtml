        <link href="~/Content/colorbox.css" rel="stylesheet" />
        <script src="~/Scripts/jquery.colorbox-min.js"></script>*@
    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "400px", height: "80%" });
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "70%", height: "80%" });
           

           
        });

        function SearchFunction() {
            $('#VerificationIds').val("");
        }

        //2nd click event for header checkbox for select /deselect all
        $(document).on('change', '#select_all', function () {
            $('input.verificationId').prop('checked', $(this).prop('checked'));

            var VerificationIds = '';
            $('input.verificationId:checked').each(function () {
                var id = this.value.split('_');
                VerificationIds += id[0] + ',';
            });

            if (VerificationIds.length > 0) {
                VerificationIds = VerificationIds.slice(0, -1);
            }
            $('#VerificationIds').val(VerificationIds.trim());
        })

        //3rd click event for checkbox of each row
        $(document).on('change', 'input.verificationId', function () {
            var VerificationIds = '';
            $('input.verificationId:checked').each(function () {
                var id = this.value.split('_');
                VerificationIds += id[0] + ',';
            });

            if (!$(this).prop("checked")) {
                $("#select_all").prop('checked', false);
            }
            if ($('.verificationId:checked').length === $('.verificationId').length) {
                $("#select_all").prop('checked', true);
            }

            if (VerificationIds.length > 0) {
                VerificationIds = VerificationIds.slice(0, -1);
            }
            $('#VerificationIds').val(VerificationIds.trim());
        })

        

        function validateForm() {
            if ($("#AllocateTL").val() == 0) {
                alert("Select Team Leader For Allocate.");
                return false;
            }

            var count = 0;
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one case.");
                return false;
            }
            return true;
        }
    </script>

    <script type="text/javascript">
        function addHeaderCheckbox() {
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                }
            });
        }

        $(document).ready(function () {
            addHeaderCheckbox(); // first load
        });

        // re-run after ajax sorting/paging
        $(document).on('ajaxComplete', function () {
            addHeaderCheckbox();
        });

    </script>
    <style>

        input {
            width: 7rem !important;
            font-family: italic;
            font-size: 1.4rem !important;
        }
    </style>
