

<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />

<link href="~/Content/admin.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />
@*<script src="~/scripts/jquery-2.2.3.min.js"></script>*@
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<link href="~/Content/colorbox.css" rel="stylesheet" />
<script src="~/Scripts/jquery.colorbox-min.js"></script>

<table width="100% ">
    <tr>
        <td class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> Check Education History :</td>
    </tr>
    <tr>
        <td height="2"></td>
    </tr>
    <tr>
        <td valign="top">
            @if (ViewBag.GetEducationVerificationHistories != null)
            {
                <table class="table check-table-edit">
                    <thead class="thead-inverse">
                        <tr>
                            <th class="top-head">College Name</th>
                            <th class="top-head">Concern Person Name/Designation</th>
                            <th class="top-head">Course/Degree/Qualification</th>
                            @*<th class="top-head">Desig Concern Person</th>*@
                            <th class="top-head">Official Email Id</th>
                            <th class="top-head">Official Landline No.</th>
                            <th class="top-head">Creation Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.GetEducationVerificationHistories)
                        {
                            <tr>
                                <td class="name">@item.CollegeName</td>
                                <td class="name">@item.ConcernPersonName</td>
                                <td class="name">@item.CourseNameDegreeQualificationName</td>
                                @*<td class="name">@item.DesigConcernPerson</td>*@
                                <td class="name">@item.OfficialEmailId</td>
                                <td class="name">@item.OfficialLandlineNo</td>
                                <td class="name">@item.CreationDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </td>
    </tr>
</table>
<style>
    .check-table-edit > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        word-break: break-word;
        white-space: normal;
        width: 10px;
    }
</style>
