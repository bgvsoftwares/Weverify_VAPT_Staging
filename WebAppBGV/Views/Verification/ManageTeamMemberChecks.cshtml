
@{
    ViewBag.Title = "Manage Team Member Checks Jobs";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}
@{
    //@ViewBag.NavigationBtnExportExcel
    string tatdays1 = "";
    string CheckStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatdays"] != null)
    {
        tatdays1 = Request.QueryString["tatdays"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CheckStatus"] != null)
    {
        CheckStatus1 = @Request.QueryString["CheckStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = "";
    if (Session["Designation"].ToString() == "Team Member-SPL" || Session["Designation"].ToString() == "Team Member-Cri")
    {
        hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportChecksReport", "Verification", new { CheckStatus = CheckStatus1, tatdays = tatdays1, AllocatedToTL = AllocatedToTL1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    }
    else
    {
        hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportChecksReport", "Verification", new { CheckStatus = CheckStatus1, tatdays = tatdays1, AllocatedToTL = AllocatedToTL1 }, new { @class = "btn bun-bg btn-default" }).ToString();

    }
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageTeamMemberChecks", "Verification", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                @if (CheckStatus1 == "TMReview"&& Session["Designation"].ToString() == "Team Member-Cri")
                                {
                                    <div class="form-group branch row search-frame">
                                        <div class="col-md-10" style="text-align: center;">
                                            <button id="btnDownloadCRC" type="button" class="btn btn-primary">
                                                <span id="spinnerIcon" class="spinner" style="display:none;"></span>
                                                <span id="btnText">Bulk Download CRC Report</span>
                                            </button>
                                        </div>
                                    </div>

                                }

                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                                   new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                                   "-- Select Client -- ",
                                                   new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    @{ if (Session["CheckStatus"].ToString() == "WIP")
                                        {
                                            <div class="col-md-2 mg-t-5 mg-md-t-0">
                                                @Html.DropDownList("SearchType", new List<SelectListItem> {
                                               new SelectListItem { Text = "Securitas ID", Value = "SecuritasID" },
                                               new SelectListItem { Text="Unique Check ID",Value="CheckID"},

                                           }, new { @class = "form-control", style = "height:33px;" })
                                            </div>
                                        }
                                    }
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No,Company name..." })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">  Fetch Senior Profile:</label>



                                    <div class="col-md-8">
                                        @*@Html.Hidden("fetchDataCheckbox", "false")
                <input type="checkbox" name="fetchDataCheckbox" value="true" id="fetchDataCheckbox" />*@
                                        <input type="checkbox" id="fetchDataCheckbox" />
                                        <input type="hidden" name="fetchDataCheckbox" id="fetchDataCheckboxHidden" value="false" />
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">CheckStatus :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("DCheckStatus",
                                              new SelectList(ViewBag.CheckStatusOptionList, "Value", "Text"),
                                              "-- Select Check -- ",
                                              new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Case Status :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("CaseStatus",
                                                   new SelectList(ViewBag.CaseStatusOptionList, "Value", "Text"),
                                                   "-- Select Case -- ",
                                                   new { @class = "form-control" })
                                    </div>
                                </div>
                                @{ string Designation = Session["Designation"].ToString();
                                    if (!string.IsNullOrWhiteSpace(Designation) && Designation != "Team Member-Ref" && Designation != "Team Member-Ide")
                                    {
                                        if (Designation != null && Designation == "Team Member-Add")
                                        {
                                            if (Request.QueryString["CheckStatus"] == "SpocReview")
                                            {
                                                <div class="form-group branch row search-frame">
                                                    <label class="col-md-2 control-label">Select State :</label>



                                                    <div class="col-md-8">
                                                        @Html.DropDownList("StateRowID",
    new SelectList(ViewBag.StateList, "StateRowID", "StateName"),
    "-- Select State -- ",
    new { @class = "form-control" })
                                                        <input type="hidden" id="hidStateName" name="hidStateName" />
                                                        @Html.Hidden("hidStateName")
                                                    </div>
                                                </div>

                                                <div class="form-group branch row search-frame">
                                                    <label class="col-md-2 control-label">Select Partner :</label>



                                                    <div class="col-md-8">
                                                        @Html.DropDownList("AllocatePTR", new SelectList(ViewBag.VendorList, "VendorRowID", "VendorName"), "-- Select Member -- ", new { @class = "form-control" })
                                                        @Html.Hidden("VerificationIds", null)
                                                    </div>
                                                </div>



                                                <div class="form-group branch row search-frame">
                                                    <label class="col-md-2 control-label">is Message send : </label>



                                                    <div class="col-md-8">
                                                        @Html.CheckBox("isMessageSend", true, new { @Class = "form-control", id = "whatsAppId", @placeholder = "Ex. Enter Candidate name, Ref No..." })
                                                    </div>
                                                </div>

                                            }
                                            else
                                            {
                                                <div class="form-group branch row search-frame">
                                                    <label class="col-md-2 control-label">State :</label>
                                                    <div class="col-md-3">
                                                    </div>
                                                    <label class="col-md-2 control-label">City :</label>
                                                    <div class="col-md-3">
                                                    </div>
                                                </div>
                                                <div class="form-group branch row search-frame">
                                                    <label class="col-md-2 control-label">Partner :</label>
                                                    <div class="col-md-3">
                                                    </div>
                                                </div>
                                            }

                                        }
                                        if (Designation != null && Designation == "Team Member-Emp")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Employer Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }
                                        if (Designation != null && Designation == "Team Member-Edu")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Institute Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }

                                    }
                                }
                                @{
                                    if (Request.QueryString["CheckStatus"] != null)
                                    {
                                        @Html.Hidden("CheckStatus", Request.QueryString["CheckStatus"].ToString())
                                    }

                                    if (Request.QueryString["tatdays"] != null)
                                    {
                                        @Html.Hidden("tatdays", Request.QueryString["tatdays"].ToString())
                                    }
                                }
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" onclick="SearchFunction()" value="Search" style="font-size:1.4rem!important;" />

                                    @if (Designation != null && Designation == "Team Member-SPL")
                                    {
                                        <input class="btn bun-bg btn-default ml-3" type="submit" onclick="CompleteFunction()" name="CompleteFunction" value="Complete by Data entry QC" style="font-size:1.4rem!important;" />
                                        if (Request.QueryString["CheckStatus"] == "DBCheckAPIFailed")
                                        {
                                            <input class="btn bun-bg btn-default" id="BulkDBCheckAPIFailedProcess" type="button" onclick="SearchFunction()" value="Bulk DB Check Failed Case Process" style="font-size:1.4rem!important;" />
                                        }
                                        else if (Request.QueryString["CheckStatus"] == "TMReview")
                                        {
                                            <input class="btn bun-bg btn-default" id="BulkWorldCheckCaseProcess" type="button" onclick="SearchFunction()" value="Bulk World Check Case Process" style="font-size:1.4rem!important;" />
                                        }
                                    }
                                    @if (Designation != null && Designation == "Team Member-Ide")
                                    {
                                        if (CheckStatus1 == "APIChecks")
                                        {
                                            // <input class="btn bun-bg btn-default ml-3" type="submit" onclick="CompleteFunction()" name="CompleteFunction" value="Face match complete checks" style="font-size:1.4rem!important;" />
                                            <input class="btn bun-bg btn-default ml-3" type="submit" onclick="CompleteFunction()" name="CompleteFunction" value="DT To RWQC Instant Check MIS" style="font-size:1.4rem!important;" />

                                        }
                                        else if (CheckStatus1 == "WIP")
                                        {
                                            <input class="btn bun-bg btn-default ml-3" type="submit" onclick="CompleteFunction()" name="CompleteFunction" value="Bulk Process ID Check" style="font-size:1.4rem!important;" />
                                        }
                                    }
                                    @if (Designation != null && Designation == "Team Member-Add")
                                    {
                                        if (CheckStatus1 == "SpocReview")
                                        {
                                            <input class="btn bun-bg btn-default" type="submit" id="btnAllocation" onclick="return validateForm()" value="Allocate" />

                                        }
                                    }
                                    @if (Designation != null && Designation == "Team Member-Emp")
                                    {
                                        if (CheckStatus1 == "WIP")
                                        {

                                            <input class="btn bun-bg btn-default" id="btnGroupMail" type="submit" value="Create Group Mail" style="background-color:#11c9b7!important; font-size:1.4rem!important; cursor:pointer" />
                                        }
                                        @Html.Hidden("VEmploymentId");


                                    }

                                </div>

                                <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered" role="document">
                                        <div class="modal-content" style=" background-color: transparent !important;">

                                            <div class="modal-body">
                                                <div class="d-flex justify-content-center">
                                                    <div class="spinner-border" role="status">
                                                        <span class="sr-only">Loading...</span>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div id="overlay1" class="overlay1">
                                    <!-- Pop-up content -->
                                    <div class="popup">
                                        <div class="d-flex justify-content-center">
                                            <div class="spinner-border" role="status">
                                                <span class="sr-only">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>



                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table table-striped">
                            @{
                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @{
                                string Designation = Convert.ToString(Session["Designation"]);
                                if (Designation != null && Designation == "Team Member-Add" || Designation == "Team Member-Cri")
