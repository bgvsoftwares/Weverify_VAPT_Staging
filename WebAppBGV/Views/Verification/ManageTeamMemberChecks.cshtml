<div id="popupModal" class="modal fade" tabindex="-1" role="dialog" style="background: rgba(0, 0, 0, 0.6);">
    <div class="modal-dialog modal-lg" role="document" style="max-width: 650px; transform: translateY(10%); transition: all 0.3s ease-in-out;">
        <div class="modal-content" style="border-radius: 12px; box-shadow: 0px 6px 20px rgba(0,0,0,0.3); overflow: hidden;">

            <!-- Header -->
            <div class="modal-header" style="background: linear-gradient(45deg, #007bff, #0056b3); color: #fff; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                <h5 class="modal-title" style="font-weight: bold;">🎓 University Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                        style="color: #fff; font-size: 22px; background: none; border: none;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body" style="padding: 30px; font-size: 16px; background: #f9f9f9;">

                <!-- Hidden Fields -->
                <input type="hidden" id="securitasID">
                <input type="hidden" id="uniqueCheckID">
                <input type="hidden" id="id">

                <!-- University Name -->
                <div style="margin-bottom: 20px;">
                    <label style="font-weight: bold; font-size: 16px; color: #333;">🏛️ University Name:</label>
                    <p id="universityName" style="color: #333; font-size: 20px; margin-bottom: 5px; font-weight: bold;"></p>
                </div>

                <!-- Address 1 -->
                <div style="margin-bottom: 20px;">
                    <label style="font-weight: bold; font-size: 16px; color: #333;">📍 Address 1:</label>
                    @*<input type="text" id="address1" class="form-control" placeholder="Enter Address 1"
                           style="width: 100%; max-width: 600px; padding: 15px; font-size: 16px; height: 50px; border-radius: 8px; border: 1px solid #ccc; background: #fff;">*@
                    <textarea id="address1" class="form-control" rows="4" placeholder="Enter Address 1"
                              style="width: 100%; max-width: 600px; padding: 15px; font-size: 16px; height: 50px; border-radius: 8px; border: 1px solid #ccc; background: #fff;"></textarea>
                </div>

                <!-- Address 2 -->
                <div style="margin-bottom: 20px;">
                    <label style="font-weight: bold; font-size: 16px; color: #333;">📍 Address 2:</label>
                    @*<input type="text" id="address2" class="form-control" placeholder="Enter Address 2"
                           style="width: 100%; max-width: 600px; padding: 15px; font-size: 16px; height: 50px; border-radius: 8px; border: 1px solid #ccc; background: #fff;">*@
                    <textarea  id="address2" class="form-control" rows="4" placeholder="Enter Address 2"
                           style="width: 100%; max-width: 600px; padding: 15px; font-size: 16px; height: 50px; border-radius: 8px; border: 1px solid #ccc; background: #fff;"></textarea>
                </div>

                <!-- Remarks -->
                <div style="margin-bottom: 20px;">
                    <label style="font-weight: bold; font-size: 16px; color: #333;">📝 Remarks:</label>
                    <textarea id="remarks" class="form-control" rows="4" placeholder="Enter remarks..."
                              style="width: 100%; max-width: 600px; padding: 15px; font-size: 16px; border-radius: 8px; border: 1px solid #ccc; background: #fff;"></textarea>
                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer" style="background: #fff; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; padding: 20px;">
