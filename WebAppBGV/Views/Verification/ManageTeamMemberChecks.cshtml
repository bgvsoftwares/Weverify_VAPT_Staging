      grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),
         grid.Column(columnName: "IsSeniorCase", header: "IsSeniorCase", canSort: false, style:"td-3"),
      grid.Column(header : "Securitas ID", format : (item) => {
          string SecuritasID=item.CompanyRefNo;
          if (item.CheckFamilyRowID==2)
          {
              var link = Html.ActionLink(SecuritasID, "AddAddressInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID  }, new { @class="edit" });
              return link;
          }
          else if (item.CheckFamilyRowID==5)
          {
              var link = Html.ActionLink(SecuritasID, "AddCriminalInfoByTeamMember", "Verification", new { id = item.VerificationRowID,Aging=item.aging,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID,CheckStatus=CheckStatus1}, new { @class="edit" });
              return link;
          }
          else
          {
              return SecuritasID;
          }
