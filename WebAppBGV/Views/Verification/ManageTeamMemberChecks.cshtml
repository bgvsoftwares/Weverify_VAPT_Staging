 <script>
     document.getElementById('btnDownloadCRC').addEventListener('click', async function () {
         const btn = this;
         const spinner = document.getElementById('spinnerIcon');
         const btnText = document.getElementById('btnText');

         // Configuration: Disable button and show spinner
         btn.disabled = true;
         spinner.style.display = 'inline-block';
         btnText.innerText = 'Processing...';

         try {
             let response = await fetch('/Verification/BulkDownloadCRCReport', {
                 method: 'GET',
                 headers: {
                     'Content-Type': 'application/json'
                 }
             });

             let result = await response.json();

             if (result.Success) {
                 alert(result.Message);
             } else {
                 alert("Operation failed.");
             }
         } catch (error) {
             console.error('Error:', error);
             alert("An error occurred while processing the request.");
         } finally {
             // Configuration: Re-enable button and hide spinner
             btn.disabled = false;
             spinner.style.display = 'none';
             btnText.innerText = 'Bulk Download CRC Report';
         }
     });
 </script>
