@model ViewModels.VerificationViewModel.UpdateAddressTMViewModel

@{
    ViewBag.Title = "Update AddressInfo By PTR Manager";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("AddAddressInfoByPTRTeamMember1", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(model => model.PQAddressVarPtrRowId)
            @Html.HiddenFor(model => model.AddressRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.SubCheckRowId)

            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <div class="form-group branch">
                    @Html.LabelFor(model => model.Address, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.Address, new { @class = "form-control ", @rows = "1" })
                        @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.Landmark, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Landmark, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Landmark, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.IsAddressChanged, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.RadioButtonFor(model => model.IsAddressChanged, "Yes", new { @class = "rdoAddrssChngd", @id = "rdoAddrssChngd" }) Yes
                        <span class="client_radiobtncr">
                            @Html.RadioButtonFor(model => model.IsAddressChanged, "No", new { @class = "rdoAddrssChngd", @id = "rdoAddrssChngd", @checked = "checked" }) No
                        </span>
                    </div>
                    @Html.LabelFor(model => model.DurationOfStay, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.DurationOfStay, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.DurationOfStay, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.AccomodationType, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.AccomodationType, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AccomodationType, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.RespName, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.RespName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RespName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.RespIdDetails, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.RespIdDetails, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RespIdDetails, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.RespRelation, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.RespRelation, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RespRelation, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.RespContactDetails, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.RespContactDetails, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RespContactDetails, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.NeighbourNameAndNos, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.NeighbourNameAndNos, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.NeighbourNameAndNos, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.AnyOtherComments, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.AnyOtherComments, new { @class = "form-control ", @rows = "1" })
                        @Html.ValidationMessageFor(model => model.AnyOtherComments, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch">
                    @Html.LabelFor(model => model.MobileCheckStatus, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.MobileCheckStatus, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.MobileCheckStatus, "", new { @class = "text-danger" })
                    </div>

                    @Html.LabelFor(model => model.CheckStatus, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.DropDownListFor(model => model.CheckStatus, new List<SelectListItem>
                               { new SelectListItem{Text="Completed", Value="Completed"},
                                 new SelectListItem{Text="Re-Visit", Value="Re-Visit"}},
                                 "-- Select --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.CheckStatus, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="form-horizontal">
                <div class="form-group branch"></div>
                <div class="all-button-bg">
                    @Html.ActionLink("Back", "ManageTeamMemberChecks", "Verification", null, new { @class = "btn bun-bg btn-default" })
                    <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                    @Html.ActionLink("Attachment", "UplodAddressCheckDocsAndComplete", "Verification", new { scid = Model.SubCheckRowId, pe = Model.PersonalRowID, cstatus = Model.CheckStatus }, new { @class = "iframeUpdateAddressDoc cboxElement callbacks btn btn-default"})
                </div>
            </div>
        }
    </div>
</div>


@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeUpdateAddressDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });


            if ($('#hdnAV_Country').val() != null) {
                $.getJSON('/Master/BindState/' + $('#hdnAV_Country').val(), function (data) {
                    var items = '<option value="">-- Select State --</option>';
                    $.each(data, function (i, States) {
                        items += "<option value='" + States.Value + "'>" + States.Text + "</option>";
                    });
                    $('#AV_State').html(items);
                    $('#AV_State').val($('#hdnAV_State').val());
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');
                });
            }

            //Bind District base on StateRowID
            if ($('#hdnAV_State').val() != null) {
                $.getJSON('/Master/BindDistrict/' + $('#hdnAV_State').val(), function (data) {
                    var items = '<option value="">-- Select District --</option>';
                    $.each(data, function (i, Districts) {
                        items += "<option value='" + Districts.Value + "'>" + Districts.Text + "</option>";
                    });
                    $('#AV_District').html(items);
                    $('#AV_District').val($('#hdnAV_District').val());
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');
                });
            }

            //Bind Location base on DistrictRowID
            if ($('#hdnAV_District').val() != null) {

                $.getJSON('/Master/BindLocation/' + $('#hdnAV_District').val(), function (data) {
                    var items = '<option value="">-- Select City --</option>';
                    $.each(data, function (i, Cities) {
                        items += "<option value='" + Cities.Value + "'>" + Cities.Text + "</option>";
                    });
                    $('#AV_City').html(items);
                    $('#AV_City').val($('#hdnAV_City').val());
                    //$('#AV_Pincode').val('');
                });
            }

            //PinCode Bind
            if ($("#hdnAV_City").val() == null) {
                var url = "/Master/GetPinCodeByLocationId/" + $("#hdnAV_City").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (pinCode) {
                        $('#AV_Pincode').val(pinCode);

                    }
                });
            }
            // Button Enable
            var AddressVerVal = $('#AddressVerRowID').val()
            if (AddressVerVal > 0) {
                $('#UplodVerificationDocs').removeAttr("disabled", "disabled");
                $('#VerificationCloserDetails').removeAttr("disabled", "disabled");

            }
            else {
                $('#UplodVerificationDocs,#VerificationCloserDetails').click(function (e) {
                    return false;
                });
            }
        });
        $(function () {
            //Bind State base on CountryRowID
            $('#AV_Country').change(function () {
                $.getJSON('/Master/BindState/' + $('#AV_Country').val(), function (data) {
                    var items = '<option value="">-- Select State --</option>';
                    $.each(data, function (i, States) {
                        items += "<option value='" + States.Value + "'>" + States.Text + "</option>";
                    });
                    $('#AV_State').html(items);
                    $('#AV_District').val('');
                    $('#AV_City').val('');
                    $('#AV_Pincode').val('');
                });
            });

            //Bind District base on StateRowID
            $('#AV_State').change(function () {
                $.getJSON('/Master/BindDistrict/' + $('#AV_State').val(), function (data) {
                    var items = '<option value="">-- Select District --</option>';
                    $.each(data, function (i, Districts) {
                        items += "<option value='" + Districts.Value + "'>" + Districts.Text + "</option>";
                    });
                    $('#AV_District').html(items);
                    $('#AV_City').val('');
                    $('#AV_Pincode').val('');
                });
            });

            //Bind Location base on DistrictRowID
            $('#AV_District').change(function () {
                $.getJSON('/Master/BindLocation/' + $('#AV_District').val(), function (data) {
                    var items = '<option value="">-- Select City --</option>';
                    $.each(data, function (i, Cities) {
                        items += "<option value='" + Cities.Value + "'>" + Cities.Text + "</option>";
                    });
                    $('#AV_City').html(items);
                    $('#AV_Pincode').val('');
                });
            });

            //PinCode Bind
            $('#AV_City').change(function () {
                var url = "/Master/GetPinCodeByLocationId/" + $("#AV_City").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (pinCode) {
                        $('#AV_Pincode').val(pinCode);
                    }
                });
            });


        });
        function validateForm() {
            //ExtraExpenses

        }
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+10",
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });
        });
    </script>
}
