@model dynamic


@{
    ViewBag.Title = "Add National Info (" + Convert.ToString(Session["CandidateName"]) + ")";


    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string checkStatusid = "";
    string CheckStatus = "";
    string CandCheckRowid = "";


    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    checkStatusid = @ViewBag.checkStatusid;
    CandCheckRowid = @ViewBag.CandCheckRowID;
    CheckStatus = @ViewBag.CheckStatus;
     string ReportComments = Convert.ToString(ViewBag.ReportComments);
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_CaseDocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentList")</td>
        </tr>

    </table>


    @if (ViewBag.SpocActionRemark != null)
    {
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td colspan="2">
                    <div class=" col-12 personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>  Spoc Remark :</div>
                </td>
            </tr>
            <tr>
                @foreach (var item in ViewBag.SpocActionRemark)
                {
                    if (item.PriorityType == "High")
                    {
                        <td style="font-weight: bold; background-color: #ff0000; color: white; width: 5%; ">High</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color:azure;"> @item.SpocRemark </p>
                        </td>
                    }
                    else
                    {
                        <td style="font-weight: bold; background-color: #02fd58; width: 5%; ">Low</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color: azure; "> @item.SpocRemark </p>
                        </td>
                    }
                }
            </tr>
        </table>
    }
<div class="col-md-12">
    @using (Html.BeginForm("AddNationalIdentityInfoByTeamMember", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
        @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SubCheckId>
        @Html.Hidden("SubCheckId", SubCheckId.ToString())

        <input id="clientRowId" type="hidden" value=@clientRowId>
        @Html.Hidden("clientRowId", clientRowId.ToString())

        <input id="checkStatusid" type="hidden" value=@checkStatusid>
        @Html.Hidden("checkStatusid", checkStatusid.ToString())

        <input id="CheckStatus" type="hidden" value=@CheckStatus>
        @Html.Hidden("CheckStatus", CheckStatus.ToString())

        @Html.ValidationSummary()

        foreach (var category in Model)
        {
            <div class="row" style="margin-bottom:10px;">
                @{
                    string[] nm = category.Key.Split('_');
                    string[] temp = category.Value.Split('_');


                    if (@nm[2] == "textbox")
                    {
                        <div class="col-md-4 class_anti">
                            @{
                                if (nm[4] != "")
                                {
                                    <p style="margin-top:30px!important;">
                                        @if (@nm[3] == "mandatory")
                                        {
                                            <span style="color:red!important;">*</span>
                                        }
                                        else
                                        {
                                            <span style="color:red!important;">&nbsp;</span>
                                        }


                                        @nm[1]
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        @if (@nm[3] == "mandatory")
                                        {
                                            <span style="color:red!important;">*</span>
                                        }
                                        else
                                        {
                                            <span style="color:red!important;">&nbsp;</span>
                                        }


                                        @nm[1]
                                    </p>
                                }
                            }
                        </div>
                        if (@nm[0] != "98")
                        {
                            if (nm[4] != "")
                            {
                                <div class="col-md-4">
                                    <p style="margin-top: 30px;">@temp[0]</p>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-4">
                                    <p>@temp[0]</p>
                                </div>
                            }
                        }



                        if (temp.Count() > 1 && @temp[1] != "")
                        {
                            if (@nm[0] == "98")
                            {
                                <div class="col-md-8">
                                    <textarea name="98" id="98">@temp[1]</textarea>
                                </div>

                            }
                            else
                            {
                                <div class="col-md-4">
                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                </div>

                            }

                        }
                        else
                        {
                            if (@nm[0] == "98")
                            {
                                <div class="col-md-8">
                                    <textarea name="98" id="98">@temp[0]</textarea>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-4">
                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off" maxlength="@nm[5]">
                                </div>

                            }

                        }


                    }
                    if (@nm[2] == "dropdown")
                    {
                        <div class="col-md-4">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7>*</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-4">
                            @if (temp.Count() > 1)
                            {
                                <p>@temp[0]</p>
                            }
                        </div>
                        <div class="col-md-4">
                            @nm[4]
                            @{
                                int lastindex = nm.Length;
                                string[] nmOption = nm[lastindex - 1].Split(',');
                                string Fvalue = nm[lastindex - 2].ToString();
                                if (Fvalue == "")
                                {
                                    Fvalue = nm[lastindex - 3].ToString();
                                }
                            }
                            <select name=@nm[0] id='@nm[0]' autocomplete="off" class="form-control ">
                                @for (int i = 0; i < nmOption.Length; i++)
                                {
                                    if (@nmOption[i].Trim() == Fvalue)
                                    {
                                        <option selected>@nmOption[i]</option>
                                    }
                                    else
                                    {
                                        <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                    }

                                }
                            </select>

                        </div>


                    }
                    if (@nm[2] == "checkbox")
                    {
                        <div class="col-sm-4" style="padding-top:10px!important;">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7>*</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-sm-2" style="padding-top:10px!important; text-align:left;">

                            @{
                                if (@nm[6] == "TRUE")
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                }
                                else
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                }
                            }

                        </div>
                        <div class="col-sm-4">
                            @nm[4]
                        </div>

                    }
                    if (@nm[2] == "fileUpload")
                    {
                        <div class="col-sm-4">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7>*</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-sm-4">
                            <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                        </div>
                        <div class="col-sm-4">
                            @nm[4]
                        </div>

                    }
                }

            </div>

        }
        <div class="row">
            <div class="col-sm-12 cytoscape-parent">
                <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
            </div>
        </div>


        if (ReportComments != "")
        {
            <div class="row">
                <div class="col-md-4">
                    Action Remarks :
                </div>
                <div class="col-md-8">
                    <textarea name="Remarks" id="Remarks" rows="5" cols="8">@ReportComments</textarea>
                </div>
            </div>
        }


        <div class="row" style=" margin-bottom:25px;">
            <div class="col-sm-2" style="margin-left:15%; margin-bottom:3rem;">
                <input type="submit" value="Submit" style="width:15rem!important; padding:2% 0 2% 0; border-radius:.90rem; font-size:1.6rem!important;" />
            </div>

            @Html.ActionLink("Attachment", "UplodNationalIdentityVerDocs", "Verification", new { scid = SubCheckId, pe = PersonalRowid, ClientRowID = clientRowId }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @id = "UplodVerificationDocs" })

            @Html.ActionLink("Capture Action", "CaptureActionHistoryByVerTM", "Verification", new { CandCheckRowid = CandCheckRowid, cid = clientRowId, scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateStatus cboxElement callbacks btn btn-default", @id = "VerificationActionHistostry" })



            @Html.ActionLink("Closer Details", "NationalIdentityVerCloserDetails", "Verification", new { PersonalRowID = PersonalRowid, SubcheckRowID = SubCheckId, ClientRowID = clientRowId, CheckStatusId= checkStatusid, Aging = "" }, new { @class = "btn btn-default", @id = "VerificationCloserDetails", @disabled = "disabled" })
            <div class="col-sm-6" style="margin-left:15%;">

                @Html.ActionLink("Back", "ManageTeamMemberChecks", "Verification", new { PersonalRowID = PersonalRowid, SubcheckRowID = SubCheckId, CheckStatusId = checkStatusid, ClientRowID = clientRowId, CheckStatus = CheckStatus, Aging = "" }, new { @class = "btn btn-default" })

            </div>
        </div>
    }
</div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/tinymceNew.min.js"></script>
    <script src="~/Scripts/tinymce-jquery.min.js"></script>

    <script>
        $('textarea').tinymce({
            height: 200,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | removeformat | help'
        });
        // Prevent jQuery UI dialog from blocking focusin
        $(document).on('focusin', function (e) {
            if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                e.stopImmediatePropagation();
            }
        });
    </script>
    <style>
        .tox-tinymce {
            margin-top: 10px !important;
        }

        .tox-editor-header {
            box-shadow: none !important;
            z-index: 0 !important;
            border-bottom: 0.5px solid #000 !important;
        }

        .tox-statusbar__branding {
            display: none !important;
        }
    </style>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <style>
        .ui-widget.ui-widget-content {
            width: 20%;
        }

        img {
            width: 50px;
            height: 25px;
        }
    </style>
    <script>
        $(document).ready(function () {
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                //onOpen: function () { alert('onOpen: colorbox is about to open'); },
                //onLoad: function () { alert('onLoad: colorbox has started to load the targeted content'); },
                //onComplete: function () { alert('onComplete: colorbox has displayed the loaded content'); },
                //onCleanup: function () { alert('onCleanup: colorbox has begun the close process'); },
                onClosed: function () {
                    //alert('onClosed: colorbox has completely closed');
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "60%", height: "75%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

            //$(".iframeEmailStatus").colorbox({ iframe: true, width: "80%", height: "90%" });

            //$(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <style>
        img {
            width: 50px;
            height: 25px;
        }
    </style>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#157').datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+0",
            });
            var dNow = new Date();
            var localdate = (dNow.getFullYear() + '-' + (dNow.getMonth() + 1) + '-' + dNow.getDate());
            $('#OrderDate').val(localdate);
            $('#goBack').click(function () {
                parent.history.back();
                return false;
            });
        });
        //$('#172').bind('copy paste cut', function (e) {
        //    e.preventDefault();
        //    alert('cut,copy & paste options are disabled !!');
        //});
        $("#157").keypress(function (e) {
            return false;
        });
        $("#157").keydown(function (e) {
            return false;
        });
        $('#625').attr('readonly', true);

    </script>

}