
@{
    ViewBag.Title = "Aging Checks Detail";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
}
@{

}
@{

    string tatdays1 = "";
    string CheckStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatdays"] != null)
    {
        tatdays1 = Request.QueryString["tatdays"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CheckStatus"] != null)
    {
        CheckStatus1 = @Request.QueryString["CheckStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportAgingChecks", "Verification", new { Department = "", CheckStatus = CheckStatus1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));


}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AgingChecksDetail", "Verification", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-2 mg-t-5 mg-md-t-0">
                                        @Html.DropDownList("SearchType", new List<SelectListItem>
                    {
                                       new SelectListItem{Text="Securitas ID", Value="SecuritasID"},
                                       new SelectListItem{Value="CheckID", Text="Unique Check ID" }
                    },
                    new { @class = "form-control", style = "height:33px;" })
                                    </div>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
                                    </div>
                                </div>
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 table table-striped">
                    @{

                        WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                        grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                    }

                    @if (Session["CheckStatus"].ToString() == "totalWIP")
                    {
                        @grid.GetHtml(
                        htmlAttributes: new { id = "grid", @class = "table" },
                        headerStyle: "thead-inverse",
                        rowStyle: "ordertxt",
                        footerStyle: "custpaging",
                        mode: WebGridPagerModes.All,
                        columns: new[]
                        {
                                grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                grid.Column(columnName: "checkFackEdu", header: "checkFackEdu", canSort: false, style:"td-1"),

                               grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),
                               grid.Column(header : "Securitas ID", format : (item) => {

                                    string SecuritasID=Convert.ToString(item.CompanyRefNo);
                                    if (item.CheckFamilyRowID==2 && item.CheckStatus != "Allocated-Mgr")
                                    {
                                    var link = Html.ActionLink(SecuritasID, "AddAddressInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                    return link;
                                    }
                                    else if (item.CheckFamilyRowID==5 && item.CheckStatus != "Allocated-Mgr")
                                    {
                                    var link = Html.ActionLink(SecuritasID, "AddCriminalInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                    return link;
                                    }
                                    else if (item.CheckFamilyRowID==11 && item.CheckStatus != "Allocated-Mgr")
                                    {
                                       if(SecuritasID!="")
                                       {
                                           var link = Html.ActionLink(SecuritasID, "AddEducationInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=Convert.ToString(item.ClientRowID) }, new { @class="edit" });
                                    return link;
                                       }
                                       else
                                       {
                                           return "";
                                       }

                                    }
                                    else if (item.CheckFamilyRowID==12 && item.CheckStatus != "Allocated-Mgr")
                                    {
                                    var link = Html.ActionLink(SecuritasID, "AddEmploymentInfoByTeamMember", "Verification", new { id = item.VerificationRowID }, new { @class="edit" });
                                    return link;
                                    }
                                    else if (item.CheckFamilyRowID==26 && item.CheckStatus != "Allocated-Mgr")
                                    {
                                    var link = Html.ActionLink(SecuritasID, "AddNationalIdentityInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                    return link;
                                    }
                                    else if (item.CheckFamilyRowID==30 && item.CheckStatus != "Allocated-Mgr")
                                    {
                                    var link = Html.ActionLink(SecuritasID, "AddReferenceInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                    return link;
                                    }
                                     else if (item.CheckFamilyRowID==40 && item.CheckStatus != "Allocated-Mgr")
                                    {
                                    var link = Html.ActionLink(SecuritasID, "AddSpecialCheckInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                    return link;
                                    }
                                    else
                                    {
                                    return SecuritasID;
                                    }
                                    }, style:"td-1"),

                                grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"td-1"),
                                grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-1"),
                                grid.Column(columnName: "UniqueComponentID", header: "Unique Check ID", canSort: false, style:"td-1"),
                                grid.Column(columnName: "collegeName", header: "College Name", canSort: false, style:"td-1"),
                                grid.Column(columnName: "UniversityName", header: "University Name", canSort: false, style:"td-1"),
                                grid.Column(
                                    header: "URL",
                                    style: "td-2",
                                    format: item =>
                                    {
                                        if (string.IsNullOrWhiteSpace(item.Link))
                                        {
                                            return new HtmlString("");
                                        }
                                        else
                                        {
                                            return new HtmlString(string.Format("<a href='{0}' class='link-primary' target='_blank'>View Link</a>", item.Link));
                                        }
                                    }
                                ),
                                grid.Column(columnName: "Coursename", header: "Course Name", canSort: false, style:"td-1"),

                                ////----------------------------------------
                               // grid.Column(columnName: ("CreatedDate"), header: "Created Date", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd/MM/yyyy") : "", canSort: false, style: "td-1"),
                               // grid.Column(columnName: ("TLAllocationDate"), header: "TLAllocationDate", canSort: false, style: "td-1"),
                                //grid.Column(columnName: ("TMAllocationDate"), header: "TMAllocationDate", canSort: false, style: "td-1"),

                                //////------------------------------------------
                    //grid.Column("Ageing", format: (item) => item.InternalOutDate != null ? (item.InternalOutDate - DateTime.Now).Days : "", canSort: false,style:""),
                    //grid.Column("OutDate", "TAT", format: (item) => item.OutDate != DateTime.MinValue ? item.OutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                    // grid.Column(columnName: "SecuritasSPOC", header: "SPOC", canSort: false, style:"td-1"),
                                grid.Column(columnName: "AllocatedTLName", header: "AllocatedTL", canSort: false, style:"td-1"),
                                grid.Column(columnName: "AllocatedTMName", header: "AllocatedTM", canSort: false, style:"td-1"),

                                grid.Column(columnName: "DateInitiation", header: "InitiationDate", canSort: false, style: "td-1"),
                                grid.Column(columnName: "DateTLAllocation", header: "TLAllocationDate", canSort: false, style:"td-1"),
                                grid.Column(columnName: "DateTMAllocation", header: "TMAllocationDate", canSort: false, style:"td-1"),
                                grid.Column(columnName: "TMCompletionDate", header: "TMCompletionDate", canSort: false, style: "td-1"),
                                grid.Column(columnName: "TypeOfBusinesses", header: "Type Of Business", canSort: true, style: "td-1"),
                                grid.Column(header: "Action", format: (item) =>
                                {
                                    var link = Html.ActionLink("History", "CheckActionHistory", "Verification", new { scid = item.SubCheckRowID, pe = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement callbacks" });
                                    return link;
                                }, style: "edit "),
                                grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style: "td-1")
              }
)
                    }

                    else
                    {
                        {

                            @grid.GetHtml(
                                        htmlAttributes: new { id = "grid", @class = "table" },
                                        headerStyle: "thead-inverse",
                                        rowStyle: "ordertxt",
                                        footerStyle: "custpaging",
                                        mode: WebGridPagerModes.All,
                                        columns: new[]
                                        {
                                            grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                            grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),
                                           grid.Column(header : "Securitas ID", format : (item) => {

                                                string SecuritasID=Convert.ToString(item.CompanyRefNo);
                                                if (item.CheckFamilyRowID==2 && item.CheckStatus != "Allocated-Mgr")
                                                {
                                                var link = Html.ActionLink(SecuritasID, "AddAddressInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                                return link;
                                                }
                                                else if (item.CheckFamilyRowID==5 && item.CheckStatus != "Allocated-Mgr")
                                                {
                                                var link = Html.ActionLink(SecuritasID, "AddCriminalInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                                return link;
                                                }
                                                else if (item.CheckFamilyRowID==11 && item.CheckStatus != "Allocated-Mgr")
                                                {
                                                   if(SecuritasID!="")
                                                   {
                                                       var link = Html.ActionLink(SecuritasID, "AddEducationInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=Convert.ToString(item.ClientRowID) }, new { @class="edit" });
                                                return link;
                                                   }
                                                   else
                                                   {
                                                       return "";
                                                   }

                                                }
                                                else if (item.CheckFamilyRowID==12 && item.CheckStatus != "Allocated-Mgr")
                                                {
                                                var link = Html.ActionLink(SecuritasID, "AddEmploymentInfoByTeamMember", "Verification", new { id = item.VerificationRowID }, new { @class="edit" });
                                                return link;
                                                }
                                                else if (item.CheckFamilyRowID==26 && item.CheckStatus != "Allocated-Mgr")
                                                {
                                                var link = Html.ActionLink(SecuritasID, "AddNationalIdentityInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                                return link;
                                                }
                                                else if (item.CheckFamilyRowID==30 && item.CheckStatus != "Allocated-Mgr")
                                                {
                                                var link = Html.ActionLink(SecuritasID, "AddReferenceInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                                return link;
                                                }
                                                 else if (item.CheckFamilyRowID==40 && item.CheckStatus != "Allocated-Mgr")
                                                {
                                                var link = Html.ActionLink(SecuritasID, "AddSpecialCheckInfoByTeamMember", "Verification", new { id = item.VerificationRowID,PersonalRowID=item.PersonalRowID,subCheckId=item.SubCheckRowID,ClientRowId=item.ClientRowID }, new { @class="edit" });
                                                return link;
                                                }
                                                else
                                                {
                                                return SecuritasID;
                                                }
                                                }, style:"td-1"),

                                            grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "UniqueComponentID", header: "Unique Check ID", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "collegeName", header: "College Name", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "UniversityName", header: "University Name", canSort: false, style:"td-1"),
                                            grid.Column(
                                                header: "URL",
                                                style: "td-2",
                                                format: item =>
                                                {
                                                    if (string.IsNullOrEmpty(item.Link))
                                                    {
                                                        return new HtmlString("");
                                                    }
                                                    else
                                                    {
                                                        return new HtmlString(string.Format("<a href='{0}' class='link-primary' target='_blank'>View Link</a>", item.Link));
                                                    }
                                                }
                                            ),

                                            grid.Column(columnName: "Coursename", header: "Course Name", canSort: false, style:"td-1"),

                                            ////----------------------------------------

                                            //////------------------------------------------
                                //grid.Column("Ageing", format: (item) => item.InternalOutDate != null ? (item.InternalOutDate - DateTime.Now).Days : "", canSort: false,style:""),
                                //grid.Column("OutDate", "TAT", format: (item) => item.OutDate != DateTime.MinValue ? item.OutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                grid.Column(columnName: "SecuritasSPOC", header: "SPOC", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "AllocatedTLName", header: "AllocatedTL", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "AllocatedTMName", header: "AllocatedTM", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "AllocatedQCName", header: "AllocatedQC", canSort: false, style: "td-1"),
                                            grid.Column(columnName: "DateInitiation", header: "InitiationDate", canSort: false, style: "td-1"),
                                            grid.Column(columnName: "DateTLAllocation", header: "TLAllocationDate", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "DateTMAllocation", header: "TMAllocationDate", canSort: false, style:"td-1"),
                                            grid.Column(columnName: "TMCompletionDate", header: "TMCompletionDate", canSort: false, style: "td-1"),                                            
                                            grid.Column(header: "Action", format: (item) =>
                                            {
                                                var link = Html.ActionLink("History", "CheckActionHistory", "Verification", new { scid = item.SubCheckRowID, pe = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement callbacks" });
                                                return link;
                                            }, style: "edit "),
                                            grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style: "td-1")
                                        }
                                        )
                        }
                    }


                    <div class="total-record" style="margin-bottom:30px!important;">Total Records: @Model.TotalRecords</div>

                </div>
                @*</div>*@

            </div>
        </div>
    </div>
</div>

@section Scripts{


    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script>
        $("#grid > thead > tr").each(function () {
            $(this).find('th:nth-child(2)').css("display", "none");
        });
        $("#grid > tbody > tr").each(function () {
            $(this).find('td:nth-child(2)').css("display", "none");
        });
    </script>
    <script>
        $('#grid > tbody > tr').each(function () {
            var sixthTdValue = $(this).find('td:nth-child(2)').text();
            var columnIndex = $("table thead th").filter(function () {
                return $(this).text().trim() === "Client Name";
            }).index() + 1;
            var client = $(this).find("td:nth-child(" + columnIndex + ")").text();

            if (sixthTdValue == "fake") {
                if (client == "LTIMindtree Limited") {
                    $(this).css('background-color', '#7179bf');
                } else {
                    $(this).css('background-color', '#FFFF00');
                }
            }
            else if (sixthTdValue == "Capgeminivendorsupp")
            {
                $(this).css('background-color', '#34eb9b');
            }
            else {
                //$(this).css('background-color', '#f2f2f2');
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>

}

