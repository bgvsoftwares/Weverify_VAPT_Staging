@section Scripts{

    <script>
        $("#grid > thead > tr").each(function () {
            $(this).find('th:nth-child(2)').css("display", "none");
        });
        $("#grid > tbody > tr").each(function () {
            $(this).find('td:nth-child(2)').css("display", "none");
        });
    </script>
    <script>
        $('#grid > tbody > tr').each(function () {
            var sixthTdValue = $(this).find('td:nth-child(2)').text();
            if (sixthTdValue == "fake") {
                $(this).css('background-color', '#FFFF00');
            }
            else {
                $(this).css('background-color', '#f2f2f2');
            }
        });
    </script>
    <script>
        $(document).ready(function () {
            $('.link-open-popup').click(function () {
                // Get data attributes
                var verificationId = $(this).data('verification-id');
                var personalId = $(this).data('personal-id');
                var subCheckId = $(this).data('subcheck-id');
                var clientId = $(this).data('client-id');
                var checkstatusid = $(this).data('checkstatus-id');

                $('#modalVerificationRowID').val(verificationId);
                $('#modalPersonalRowID').val(personalId);
                $('#modalSubCheckRowID').val(subCheckId);
                $('#modalClientRowID').val(clientId);
                $('#modalCheckStatusdID').val(checkstatusid);


                $.ajax({
                    url: '/verification/GetUANEmpCheckData',
                    type: 'GET',
                    data: {
                        verification_id: verificationId,
                        personal_id: personalId,
                        subcheck_id: subCheckId,
                        client_id: clientId,
                        checkstatus_id: checkstatusid
                    },
                    success: function (response) {

                        $('#CandidateName').val(response.CandidateName);
                        $('#OrganisationName').val(response.OrganisationName);
                        $('#EmployeeCode').val(response.EmployeeCode);
                        $('#UANNumber').val(response.UANNumber);
                        $('#DOJ').val(response.DOJ);
                        $('#DOL').val(response.DOL);
                        $('#ModeOfVerification').val(response.ModeOfVerification);
                        $('#DateOfVerification').val(response.DateOfVerification);


                        $('#employmentInfoModal').modal('show');
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX Error:', status, error);

                        alert('Failed to load data: ' + error);
                    }
                });


                //// Show the modal
                //$('#employmentInfoModal').modal('show');
            });


            $('#employmentInfoForm').submit(function (e) {
                e.preventDefault();


                var formData = $(this).serialize();
                $.ajax({
                    url: '/Verification/AddEmploymentUANInfo',
                    type: 'POST',
                    data: formData,
                    success: function (response) {


                        Swal.fire({
                            title: 'Success!',
                            text: 'Employment information added successfully!',
                            icon: 'success',
                            confirmButtonText: 'Ok'
                        }).then(() => {

                            location.reload();
                        });;


                        $('#employmentInfoModal').modal('hide');


                        window.reload();
                    },
                    error: function (xhr, status, error) {
                        // Handle error response
                        alert('Error occurred: ' + error);
                    }
                });

            });
        });
    </script>
    <script type="text/javascript">


        $(document).ready(function () {

            $('input[class="verificationId"]').css('display', 'none');

            $('#btnGroupMail').attr('disabled', 'disabled');
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".iframemap").colorbox({ iframe: true, width: "90%", height: "90%" });
            $(".Remindermail").colorbox({ iframe: true, width: "80%", height: "100%" });
            $(".Sendgroup").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".iframeUpdateAddressDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });

            $('#select_all').change(function () {
                $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                var VerificationIds = '';
                var Organization_Name = '';
                var myarray = [];
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';

                        //alert(id[1]);
                        if (jQuery.inArray(id[1], myarray) == -1 && myarray.length > 0) {
                            alert("please select same company");
                            $('input[class="verificationId"]').prop('checked', false);
                            $('#select_all').prop('checked', false);
                            VerificationIds = '';
                            $('#btnGroupMail').attr('disabled', 'disabled');
                        }
                        myarray.push(id[1]);

                    }
                });

                if (VerificationIds.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                    $('#btnGroupMail').removeAttr('disabled');
                } else {
                    VerificationIds = '';
                    $('#btnGroupMail').attr('disabled', 'disabled');
                }
                $('#VEmploymentId').val(VerificationIds.trim());
            });


            //3rd click event for checkbox of each row
            $(document).on('change', 'input[class="verificationId"]', function (e) {// on change of state
                var VerificationIds = '';
                var Organization_Name = '';
                var myarray = [];
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';
                        $("#VEmploymentId").val(VerificationIds);
                        alert($("#VEmploymentId").val());

                        //alert(id[1]);
                        if (jQuery.inArray(id[1], myarray) == -1 && myarray.length > 0) {
                            alert("please select same company");
                            $('input[class="verificationId"]').prop('checked', false);
                            $('#select_all').prop('checked', false);
                            $('#VEmploymentId').val("");
                            VerificationIds = '';
                            $('#btnGroupMail').attr('disabled', 'disabled');
                        }
                        myarray.push(id[1]);
                    }
                });

                if (false == $(this).prop("checked")) { //if this item is unchecked
                    $("#select_all").prop('checked', false); //change "select all" checked status to false
                }
                //check "select all" if all checkbox items are checked
                if ($('.verificationId:checked').length == $('.verificationId').length) {
                    $("#select_all").prop('checked', true);
                }

                //if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                if (VerificationIds.length > 0) {
