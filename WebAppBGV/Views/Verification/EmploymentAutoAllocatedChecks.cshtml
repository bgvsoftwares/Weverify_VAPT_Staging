        <!-- Increased modal size -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="employmentInfoModalLabel">Add Employment Info</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="employmentInfoForm">
                    <input type="hidden" name="VerificationRowID" id="modalVerificationRowID" />
                    <input type="hidden" name="PersonalRowID" id="modalPersonalRowID" />
                    <input type="hidden" name="SubCheckRowID" id="modalSubCheckRowID" />
                    <input type="hidden" name="ClientRowID" id="modalClientRowID" />
                    <input type="hidden" name="CheckStatusdID" id="modalCheckStatusdID" />

                    <div class="form-group row">
                        <div class="col-md-6">
                            <label for="CandidateName">Candidate Name</label>
                            <input type="text" class="form-control" id="CandidateName" name="CandidateName" required />
                        </div>
                        <div class="col-md-6">
                            <label for="OrganisationName">Organisation Name</label>
                            <input type="text" class="form-control" id="OrganisationName" name="OrganisationName" required />
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-6">
                            <label for="EmployeeCode">Employee Code</label>
                            <input type="text" class="form-control" id="EmployeeCode" name="EmployeeCode" required />
                        </div>
                        <div class="col-md-6">
                            <label for="UANNumber">UAN Number</label>
                            <input type="text" class="form-control" id="UANNumber" name="UANNumber" required />
                        </div>
                    </div>

                    <div class="form-group row">
