@{
    ViewBag.Title = "Suspected List";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row"><div class="col-md-12">&nbsp;</div></div>
<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group branch search-frame text-center">
                        @if (ViewBag.Message != null)
                        {
                            <center>@ViewBag.Message</center>
                        }
                        <center><b>Date of Verification will be like e.g 30-Dec-2024 in Excel </b></center>
                        <form id="uploadForm" action="@Url.Action("UpdateSuspectedList", "verification")" method="post" enctype="multipart/form-data">
                            <input type="file" name="fileUpload" accept=".xls,.xlsx" class="form-control" />
                            <input type="text" name="check" value="@ViewBag.checkname" class="form-control" hidden />
                            <div style="margin-top:10px;">
                                <input type="submit" value="Upload Excel File" class="btn btn-primary" />
                                <a href="@Url.Action("UpdateSuspectedListDummy", "verification")" class="btn bun-bg btn-default">Download Dummy Excel File</a>
                            </div>

                        </form>

                        <!-- Download Link -->
                        <!-- Other Button -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



