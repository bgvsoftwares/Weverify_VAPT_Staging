@model dynamic
@{
    ViewBag.Title = "Send Whats App Message for Digital Verification";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("DigitalVerification", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
        <div class="container">
            <div class="row" style="margin-top:20px">

                <div class="col-sm-4">
                    Verification Status
                </div>
                <div class="col-sm-4">
                    <select id="VerStatus" name="VerStatus" class="form-control">
                        <option value="0">--Select--</option>
                        <option value="1">Pre-message-Digital</option>
                        <option value="2">Digital to physical mode</option>
                    </select>
                </div>
            </div>
            <div class="row" style="margin-top:20px">
                <div class="col-sm-4">
                    Execl Sheet
                </div>
                <div class="col-sm-4">
                    <input type="file" id="DigitalVer" name="DigitalVer" accept=".xlsx,.xls">
                </div>
                <div class="col-md-4">
                    <a class="ManageClientCompany" target="_blank" href='@Url.Action("DigitalVerificationTemplateDownload", "Verification",new {templateName="DigitalVerification" })' style="padding: 0.35rem 0.8rem 0.35rem 0.8rem!important;"><i class="fa fa-file-excel me-2"></i>Excel Template</a>
                </div>
            </div>
            <div class="row" style="margin-top:20px">                              
                <input class="btn bun-bg btn-default" type="submit" name="action"  value="Send Whats App Message" />             
            </div>
        </div>
        }
    </div>
</div>
<style>
  

    select {
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
    }

        select:focus {
            outline: none;
        }
</style>

    
