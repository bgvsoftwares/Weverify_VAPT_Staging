@model ViewModels.ProvidedInfoViewModel.ViewSpecialCheckViewModel

@{
    ViewBag.Title = "View Special Check Verification Info";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "ManageReviewRequestedChecksForDepartmentTL", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td>@Html.Partial("_PersonalDetails")</td>
            </tr>
            <tr>
                <td>@Html.Partial("_DocumentList")</td>
            </tr>
            <tr>
                <td>
                    <table>
                        <tr>
                            <td valign="top">
                                <table>
                                    <tr class="personal-details-head">
                                        <td width="33%" class="head_lft">Antecedents :</td>
                                        <td width="33%">Check Details Information :</td>
                                        <td width="33%">Information Verified :</td>
                                        <td width="1%">&nbsp;</td>
                                    </tr>
                                    @{
                                        if (ViewBag.ListSpecialCheckVer != null)
                                        {
                                            foreach (var item in ViewBag.ListSpecialCheckVer)
                                            {
                                                if (item.FieldName == "SC_Father_Name")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Father_Name</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Father_Name
                                                        </td>
                                                    </tr>
                                                }
                                                if (item.FieldName == "SC_SecuritasID")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_SecuritasID</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_SecuritasID
                                                        </td>
                                                    </tr>
                                                }
                                                if (item.FieldName == "SC_DOB")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_DOB</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_DOB
                                                        </td>
                                                    </tr>
                                                }
                                                if (item.FieldName == "SC_Mode_Verify")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Mode_Verify</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Mode_Verify
                                                        </td>
                                                    </tr>
                                                }

                                                if (item.FieldName == "SC_Mode_VerOther")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Mode_VerOther</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Mode_VerOther
                                                        </td>
                                                    </tr>
                                                }

                                                if (item.FieldName == "SC_Date_Verify")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Date_Verify</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Date_Verify
                                                        </td>
                                                    </tr>
                                                }
                                                if (item.FieldName == "SC_Others1")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Others1</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Others1
                                                        </td>
                                                    </tr>
                                                }

                                                if (item.FieldName == "SC_Others2")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Others2</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Others2
                                                        </td>
                                                    </tr>
                                                }
                                                if (item.FieldName == "SC_Others3")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Others3</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Others3
                                                        </td>
                                                    </tr>
                                                }
                                                if (item.FieldName == "SC_Others4")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Others4</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Others4
                                                        </td>
                                                    </tr>
                                                }

                                                if (item.FieldName == "SC_Others5")
                                                {
                                                    <tr class="personal_heading btmborder">
                                                        <td>@item.AntecedentName :</td>
                                                        <td>@ViewBag.modelBind.SC_Others5</td>
                                                        <td>
                                                            @ViewBag.VerifyInfo.SC_Others5
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                    <tr class="personal_heading btmborder">
                                        <td>Report Comment :</td>
                                        <td>&nbsp;</td>
                                        <td>
                                            @ViewBag.VerifyInfo.SC_AnyOtherComments
                                        </td>
                                    </tr>
                                    <tr class="personal_heading btmborder">
                                        <td width="10%">Severity :</td>
                                        <td>&nbsp;</td>
                                        <td>
                                            @ViewBag.VerifyInfo.Severity
                                        </td>
                                    </tr>
                                    <tr class="personal_heading btmborder">
                                        <td>Color :</td>
                                        <td>&nbsp;</td>
                                        <td>
                                            @ViewBag.VerifyInfo.ColorName
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td>
                    @using (Html.BeginForm())
                    {
                        @Html.HiddenFor(model => model.SpecialCheckRowId)
                        @Html.HiddenFor(model => model.ClientRowID)
                        @Html.HiddenFor(model => model.CheckFamilyRowID)
                        @Html.HiddenFor(model => model.SubCheckRowID)
                        @Html.HiddenFor(model => model.PersonalRowID)
                        @Html.HiddenFor(model => model.CheckStatus)
                        <table>
                            <tr class="personal_heading btmborder">
                                <td width="20%">Action Remarks :</td>
                                <td colspan="2">
                                    @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control ", @id = "selected", @rows = "4" })
                                    @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
                                </td>
                                <td width="1%">&nbsp;</td>
                            </tr>
                            <tr class="personal_heading btmborder">
                                <td colspan="4" class="personal-details-head" align="center">
                                    @{
                                        @Html.ActionLink("Back", "ManageReviewRequestedChecksForDepartmentTL", "Insuff", null, new { @class = "btn btn-default VerEmailDetails" })
                                        <input class="btn bun-bg btn-default" type="submit" value="Submit" />
                                    }
                                </td>
                            </tr>
                        </table>
                                        }
                </td>
            </tr>
        </table>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script>
        $(document).ready(function () {
             $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
}