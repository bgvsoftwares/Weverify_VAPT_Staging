@model IEnumerable<ViewModels.ProvidedInfoViewModel.MISExport>
@{
    ViewBag.Title = "MIS Data";
    WebGrid grid = new WebGrid(Model, rowsPerPage: 500);
}

@{
    ////@ViewBag.NavigationBtnExportExcel
    //string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "GetExportExcel", "Verification", null, new { @class = "btn bun-bg btn-default" }).ToString();
    //ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));
}
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
@if (ViewBag.UnAllocated == null)
{
    ViewBag.UnAllocated = "";
}
@{


    string Total_WIP = @ViewBag.Total_WIP.ToString();
    string Todays_Closure = @ViewBag.Todays_Closure.ToString();
    string Assigned_Today = @ViewBag.Assigned_Today.ToString();
    string Old_Assigned = @ViewBag.Old_Assigned.ToString();
}
<div class="row">
    <div class="col-md-12" style="margin-bottom:30px;">
        @if (Session["Designation"].ToString() == "Manager-Edu")
        {
            <table class="table js-serial">
                <thead>
                    <tr>
                        <th style="text-align:left;">TM First Name</th>
                        <th>Total WIP</th>
                        <th>Today's Closure</th>
                        <th>Assigned Today</th>
                        <th>Old Assigned</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align:left;">@item.TMFirstName</td>
                                <td>@item.Total_WIP</td>
                                <td>@item.Todays_Closure</td>
                                <td>@item.Assigned_Today</td>
                                <td>@item.Old_Assigned</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td style="font-weight:bold; text-align:left;">  </td>
                        <td style="font-weight:bold;">@Html.ActionLink(Total_WIP, "GetMISTATInfoEDUQC", "Verification", routeValues: new { Type = "Total_WIP" }, htmlAttributes: null) </td>
                        <td style="font-weight:bold;">@Html.ActionLink(Todays_Closure, "GetMISTATInfoEDUQC", "Verification", routeValues: new { Type = "Todays_Closure" }, htmlAttributes: null) </td>
                        <td style="font-weight:bold;">@Html.ActionLink(Assigned_Today, "GetMISTATInfoEDUQC", "Verification", routeValues: new { Type = "Assigned_Today" }, htmlAttributes: null) </td>
                        <td style="font-weight:bold;">@Html.ActionLink(Old_Assigned, "GetMISTATInfoEDUQC", "Verification", routeValues: new { Type = "Old_Assigned" }, htmlAttributes: null) </td>

                    </tr>
                </tfoot>
            </table>
        }

        <div class="total-record">Total Records: @ViewBag.record</div>
    </div>
</div>




@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeShow").colorbox({ iframe: true, width: "70%", height: "80%" });
        });
    </script>
    <script>
        function addRowCount(tableAttr) {
            $(tableAttr).each(function () {
                $('th:first-child, thead td:first-child', this).each(function () {
                    var tag = $(this).prop('tagName');
                    $(this).before('<' + tag + '>S.No</' + tag + '>');
                });
                $('td:first-child', this).each(function (i) {
                    $(this).before('<td>' + (i + 1) + '</td>');
                });
            });
        }

        // Call the function with table attr on which you want automatic serial number
        addRowCount('.js-serial');
    </script>
}
<style>
    table, tr, th, td {
        text-align: center;
    }

    thead {
        background-color: #9c9595;
        color: #FFF;
    }

    th {
        padding: 5px !important;
    }
</style>

