

@{
    ViewBag.Title = "Manage Team Member Checks Jobs";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@{   
    string tatdays1 = "";
    string CheckStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatdays"] != null)
    {
        tatdays1 = Request.QueryString["tatdays"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CheckStatus"] != null)
    {
        CheckStatus1 = @Request.QueryString["CheckStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportChecksReport", "Verification", new { CheckStatus = CheckStatus1, tatdays = tatdays1, AllocatedToTL = AllocatedToTL1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));
        
}

@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("DepartmentTeamMemberPVQCChecks", "Verification", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                              new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                              "-- Select Client -- ",
                                              new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No,Company name..." })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">CheckStatus :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("DCheckStatus",
                                              new SelectList(ViewBag.CheckStatusOptionList, "Value", "Text"),
                                              "-- Select Check -- ",
                                              new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Case Status :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("CaseStatus",
                                                  new SelectList(ViewBag.CaseStatusOptionList, "Value", "Text"),
                                                  "-- Select Case -- ",
                                                  new { @class = "form-control" })
                                    </div>
                                </div>
                                @{ string Designation = Convert.ToString(Session["Designation"]);
                                    if (!string.IsNullOrWhiteSpace(Designation) && Designation != "Team Member-Ref-QC" && Designation != "Team Member-Ide-QC")
                                    { 
                                        if (Designation != "" && Designation == "Team Member-Emp-QC")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Employer Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }
                                        if (Designation != "" && Designation == "Team Member-Edu-QC")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Institute Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }
                                        if (Designation != "" && Designation == "Team Member-Cri-QC")
                                        {
                                            <div class="form-group branch row search-frame">
                                                <label class="col-md-2 control-label">Criminal Name :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("EmployerName", null, new { @class = "form-control", placeholder = "Ex. Enter name ..." })
                                                </div>
                                                <label class="col-md-2 control-label">Allocated to :</label>
                                                <div class="col-md-3">
                                                    @Html.TextBox("Allocatedto", null, new { @class = "form-control", placeholder = "Ex. Enter Allocated to..." })
                                                </div>
                                            </div>
                                        }
                                    }
                                }

                                @{
                                    if (Request.QueryString["CheckStatus"] != null)
                                    {
                                        @Html.Hidden("CheckStatus", Request.QueryString["CheckStatus"].ToString())
                                    }

                                    if (Request.QueryString["tatdays"] != null)
                                    {
                                        @Html.Hidden("tatdays", Request.QueryString["tatdays"].ToString())
                                    }
                                }
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @{
                                string Designation = Session["Designation"].ToString();

                                if (Designation != null && Designation == "Team Member-Add-QC" || Designation == "Team Member-Cri-QC")
                                {
                                    @grid.GetHtml(
                                         htmlAttributes: new { id = "grid", @class = "table" },
                                         headerStyle: "thead-inverse",
                                         rowStyle: "ordertxt",
                                         footerStyle: "custpaging",
                                         mode: WebGridPagerModes.All,
                                         columns: new[]
                                         {
                                                    grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),
                                                    //grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"td-1"),
                                                     grid.Column(header : "Securitas Id", format : (item) => {
                                                        string SecuritasID=item.CompanyRefNo;

                                                     if (item.CheckFamilyRowID==2)
                                                        {
                                                          return SecuritasID;
                                                        }
                                                        else if (item.CheckFamilyRowID==5)
                                                        {
                                                            var link = Html.ActionLink(SecuritasID, "UpdateCriminalInfoByTMQC", "Verification", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusid,Aging=item.aging, PersonalRowID = item.PersonalRowID,  subCheckId = item.SubCheckRowID,  ClientRowId = item.ClientRowID }, null);
                                                        return link;
                                                        }
                                                    else
                                                    {
                                                    return SecuritasID;
                                                    }
                                                    }, style:"td-1"),
                                                    grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"td-1"),
                                                    grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-1"),
                                                    grid.Column("Ageing", format: (item) => item.InternalOutDate != null ? (item.InternalOutDate - DateTime.Now).Days : "", canSort: false,style:""),
                                                    grid.Column("OutDate", "TAT", format: (item) => item.OutDate != null ? item.OutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                                    grid.Column(columnName: "SecuritasSPOC", header: "SPOC", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "AllocatedTMName", header: "AllocatedTM", canSort: false, style:"td-1"),
                                                    grid.Column(columnName: "Partner", header: "Partner", canSort: false, style: "td-1"),
                                                    grid.Column(columnName: "Location", header: "Location", canSort: false, style: "td-1"),
                                                    grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style: ""),
                                                     grid.Column("Remarks", canSort: false, format: (item)=> {
                                            if ((item.CheckStatus=="Insufficent" && !string.IsNullOrEmpty(item.CheckStatus))|| (item.CheckStatusid==53))
                                            {


                                                var link=@Html.ActionLink("Remarks", "InsuffRemarks", "Verification", new { PersonalRowID = item.PersonalRowID ,SubCheckRowID = item.SubCheckRowID ,processName="L2-Insuff-QC_Approval"}, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
                                                return link;
                                            }
                                            return null;
                                        }, style:"td-1" ),
                                         }
                                       )
                                }
                                else
                                {
                                    @grid.GetHtml(
                                              htmlAttributes: new { id = "grid", @class = "table" },
                                              headerStyle: "thead-inverse",
                                              rowStyle: "ordertxt",
                                              footerStyle: "custpaging",
                                              mode: WebGridPagerModes.All,
                                              columns: new[]
                                              {

                                                    grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),
                                                         grid.Column(header : "Securitas Id", format : (item) => {
                                                        string SecuritasID=item.CompanyRefNo;

                                                   if (item.CheckFamilyRowID > 0)
                                                    {
                                                                
                                                        if (item.CheckFamilyRowID==11)
                                                        {
                                                            var link = Html.ActionLink(SecuritasID, "UpdateEducationInfoByPVQC", "Verification", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusid,Aging=item.aging, PersonalRowID = item.PersonalRowID,  subCheckId = item.SubCheckRowID,  ClientRowId = item.ClientRowID }, null);
                                                        return link;
                                                        }
                                                        else if (item.CheckFamilyRowID==12)
                                                        {
                                                            var link = Html.ActionLink(SecuritasID, "UpdateEmploymentInfoByPVQC", "Verification", new { id = item.VerificationRowID,CheckStatusId=item.CheckStatusid,Aging=item.aging, PersonalRowID = item.PersonalRowID,  subCheckId = item.SubCheckRowID,  ClientRowId = item.ClientRowID }, null);
                                                        return link;
                                                        }                                                       
                                                        else
                                                        {
                                                            return SecuritasID;
                                                        }
                                                    }
                                                   else
                                                    {
                                                        return SecuritasID;
                                                    }
                                                    }, style:"edit td-1"),
                                                    //grid.Column(columnName: "CompanyRefNo", header: "Securitas Id ", canSort: false, style:"td-1"),
                                                    grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"td-1"),
                                                    grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "Organization_Name", header: "Company Name", canSort: false, style:"td-1"),
                                                      grid.Column("Ageing", format: (item) => item.InternalOutDate != null ? (item.InternalOutDate - DateTime.Now).Days : "", canSort: false,style:""),
                                                    grid.Column("OutDate", "TAT", format: (item) => item.OutDate != null ? item.OutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                                     grid.Column(columnName: "SecuritasSPOC", header: "SPOC", canSort: false, style:"td-1"),
                                                     //grid.Column("InternalOutDate", "Internal TAT", format: (item) => item.InternalOutDate != DateTime.MinValue ? item.InternalOutDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                                      grid.Column(columnName: "AllocatedTMName", header: "AllocatedTM", canSort: false, style:"td-1"),
                                                    grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:""),

                                        grid.Column("Remarks", canSort: false, format: (item)=> {
                                            if ((item.CheckStatus=="Insufficent" && !string.IsNullOrEmpty(item.CheckStatus))|| (item.CheckStatusid==53))
                                            {


                                                var link=@Html.ActionLink("Remarks", "InsuffRemarks", "Verification", new { PersonalRowID = item.PersonalRowID ,SubCheckRowID = item.SubCheckRowID ,processName="L2-Insuff-QC_Approval"}, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
                                                return link;
                                            }
                                            else if( item.CheckStatusID==58)
                                            {
                                                 var link=@Html.ActionLink("Remarks", "FundsPendindRemark", "Verification", new { PersonalRowID = item.PersonalRowID ,SubCheckRowID = item.SubCheckRowID ,checkstatusid=item.CheckStatusID,CheckRowid=item.CheckFamilyRowID ,processName="Funds-Pending-QC_Approval"}, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
                                                return link;
                                            }
                                            return null;
                                        }, style:"td-1" ),


                          }
                   )
                                }


                            }
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script>

        $(document).ready(function () {           
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });            
            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });

        });
    </script>
}