                                                            @Html.ListBoxFor(model => model.CloserViewModel.CDispositionRowId,
                                                               (MultiSelectList)ViewBag.Disposition,
                                                               new { multiple = "true", @Style = "width:100%;height: 200px;", @id = "selection" })
                                                            @Html.ValidationMessageFor(model => model.CloserViewModel.Disposition, "", new { @class = "text-danger", @id = "selection" })
                                                        </td>
                                                        @Html.HiddenFor(model => model.CloserViewModel.DispositionID, new { @id = "hdnDispositionID" })
                                                    </tr>
                                                    <tr class="personal_heading">
                                                        <td>Report Comment :</td>
                                                        <td>
                                                            @Html.TextAreaFor(model => model.CloserViewModel.Remarks, new { @class = "form-control ", @id = "selected", @rows = "4" })
                                                            @Html.ValidationMessageFor(model => model.CloserViewModel.Remarks, "", new { @class = "text-danger" })

                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <table>
                                                    <tr class="personal_heading">
                                                        <td width="10%">Severity :</td>
                                                        <td>
                                                            @Html.EditorFor(model => model.CloserViewModel.Severity, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                                            @Html.HiddenFor(model => model.CloserViewModel.Severity, new { @id = "hdnSeverity" })
                                                            @Html.ValidationMessageFor(model => model.CloserViewModel.Severity, "", new { @class = "text-danger" })
                                                        </td>
                                                        <td align="right">Color :</td>
                                                        <td>
                                                            @Html.EditorFor(model => model.CloserViewModel.ColorName, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                                            @Html.HiddenFor(model => model.CloserViewModel.ColorName, new { @id = "hdnColorName" })
                                                            @Html.ValidationMessageFor(model => model.CloserViewModel.ColorName, "", new { @class = "text-danger" })
                                                        </td>
                                                    </tr>
                                                    <tr class="personal_heading">
                                                        <td width="10%">&nbsp;</td>
                                                        <td>&nbsp;                                                          </td>
                                                        <td align="right">Action History Remarks :</td>
                                                        <td>
                                                            @Html.TextAreaFor(model => model.CloserViewModel.ActionHistory, new { @class = "form-control ", @rows = "4" })
                                                            @Html.ValidationMessageFor(model => model.CloserViewModel.ActionHistory, "", new { @class = "text-danger" })
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td class="personal-details-head" align="center">
                                    @{
                                        if (Session["Designation"] != null)
                                        {
                                            string Designation = Session["Designation"].ToString();

                                            if (Designation == "Team Member-Add-QC" || Designation == "Team Member-Rpt-QC")
                                            {
                                                @Html.ActionLink("Back", "DepartmentTeamMemberQCChecks", "Verification", new { CheckStatusId = Model.CheckStatusId, Aging = Model.Aging }, new { @class = "btn btn-default VerEmailDetails" })
                                                //if (Model.CheckStatus != "Allocated-TM")
                                                if (Model.CheckStatus.Equals("Insufficent") || Model.CheckStatus.Equals("Completed-TM") || Model.CheckStatus.Equals("Rejected-RWQC") || Model.CheckStatus.Equals("Funds Pending") || Model.CheckStatusId == 24 || Model.CheckStatusId == 71 || Model.CheckStatusId == 25 || Model.CheckStatusId == 53 || Model.CheckStatusId == 36)
                                                {
                                                    <input class="btn bun-bg btn-default" onclick="return validateFormApprove()" type="submit" value="Approve" />
                                                    <input class="btn bun-bg btn-default" onclick="return validateFormReject()" type="submit" value="Reject" />
                                                }
                                            }
                                        }
                                    }
                                </td>
                            </tr>
                        </table>
                    }
                </td>
            </tr>
        </table>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
