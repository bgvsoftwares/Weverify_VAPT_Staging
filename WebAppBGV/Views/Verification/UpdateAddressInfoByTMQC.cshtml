                    $.each(data, function (i, Cities) {
                        items += "<option value='" + Cities.Value + "'>" + Cities.Text + "</option>";
                    });
                    $('#AV_City').html(items);
                    $('#AV_City').val($('#hdnAV_City').val());
                    //$('#AV_Pincode').val('');
                });
            }

            //PinCode Bind
            if ($("#hdnAV_City").val() == null) {
                var url = "/Master/GetPinCodeByLocationId/" + $("#hdnAV_City").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (pinCode) {
                        $('#AV_Pincode').val(pinCode);

                    }
                });
            }


            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            //For Clouse details
            $("#selection option:selected").each(function () {
                var $this = $(this);

                if ($this.length) {
                    var selText = $this.text();
                    var SelectDispositionID = $this.val();
                    $('#hdnDispositionID').append(SelectDispositionID + ',');
                    SelectDispositionID += $this.val() + ',';
                    //console.log(selText);
                    if ($('#selected').val() == '') {
                        $('#selected').append(selText + '\n');
                    }
                }
            });
            $("#selection").change(function () {
                $('#selected').html(' ');
                var SelectDispositionID = '';
                $("#selection option:selected").each(function () {
                    var $this = $(this);
                    if ($this.length) {
                        var selText = $this.text();
                        SelectDispositionID += $this.val() + ',';
                        //console.log(selText);
                        $('#selected').append(selText + '\n');
                    }
                });
                if (SelectDispositionID.length > 0) {
                    SelectDispositionID = SelectDispositionID.substring(0, SelectDispositionID.length - 1);
                } else { SelectDispositionID = ''; }
                $('#hdnDispositionID').val(SelectDispositionID);
            });

            // add calender for valuemomentum
            var id = $("#clientRowId").val();
            if (id == 1680) {
                $("#619").attr("placeholder", "DD-MM-YYYY");
                $("#619").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });
                $("#618").attr("placeholder", "DD-MM-YYYY");
                $("#618").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });

                function updateDurationStay() {
                    var fromVal = $("#619").val();
                    var toVal = $("#618").val();

                    if (fromVal && toVal) {
                        $("#36").val(fromVal + " to " + toVal);
                    }
                }
            }

            if (id == 446) {
                $("#282").attr("placeholder", "MM-YYYY");
                $("#282").datepicker({
                    dateFormat: 'M-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true
                });

                $("#36").attr("placeholder", "MM-YYYY");
                $("#36").datepicker({
                    dateFormat: 'M-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true
                });
            }

            $(function () {
                $('#selection').change(function () {
                    var url = "/Verification/GetSeverityColor?ClientRowId=" + $("#ClientRowID").val() + "&Dispositions=" + $("#hdnDispositionID").val();
                    $.ajax({
                        url: url,
                        type: 'GET',
                        async: false,
                        dataType: 'json',
                        success: function (colors) {
                            $('#CloserViewModel_Severity').val(colors.SeverityName);
                            $('#CloserViewModel_ColorName').val(colors.ColorName);
                        }
                    });
                });
            });
        });

        $(document).ready(function () {
            function updateFormattedDate() {
                var toDate = $("#618").val();
                var fromDate = $("#619").val();

                var formattedToDate = formatIfValid(toDate);
                var formattedFromDate = formatIfValid(fromDate);

                if (fromDate && toDate) {
                    $("#36").val(formattedFromDate + " To " + formattedToDate);
                } else {
                    $("#36").val("");
                }
            }

            function formatIfValid(date) {
                if (/^\d{2}-\d{2}-\d{4}$/.test(date)) {
                    var parts = date.split("-");
                    var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    var monthIndex = parseInt(parts[1], 10) - 1; // Convert month to zero-based index
                    return parts[0] + "-" + monthNames[monthIndex] + "-" + parts[2];
                }
                return date;
            }

            $("#618").on("input", updateFormattedDate);

            updateFormattedDate();
        });

        $(function () {
            //Bind State base on CountryRowID
            $('#AV_Country').change(function () {
                $.getJSON('/Master/BindState/' + $('#AV_Country').val(), function (data) {
                    var items = '<option value="">-- Select State --</option>';
