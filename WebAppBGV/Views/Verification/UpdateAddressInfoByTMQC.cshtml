        function validateFormApprove() {
            $('#hdnSeverity').val($('#CloserViewModel_Severity').val());
            $('#hdnColorName').val($('#CloserViewModel_ColorName').val());
            if ($('#CloserViewModel_ColorName').val() == '') {
                alert("Please Select Disposition");
                $('#CloserViewModel_ColorName').focus();
                return false;
            }

            var CheckStatus = $('#CheckStatus').val();
            if (CheckStatus == 'Insufficent' && $('#CloserViewModel_ActionHistory').val() == '') {
                alert("Please mention the reason!");
