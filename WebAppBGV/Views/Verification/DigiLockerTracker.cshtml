@model dynamic
@{
    ViewBag.Title = "DigiLocker Tracker";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("DigiLockerTracker", "Verification", FormMethod.Post))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">CompanyRefNo :</label>
                                    <div class="col-md-3">
                                        <input type="text" id='companyRefNo' name='companyRefNo' class="form-control" placeholder="Company Ref No" Value="@ViewBag.companyRefNo" autocomplete="off">
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Candidate Status :</label>
                                    <div class="col-md-3">
                                        <select class="form-control" name="CandidateStatus" id="CandidateStatus">
                                            <option value="">Please candidate status</option>
                                            <option value="1">Done</option>
                                            <option value="0">Pending</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                    @Html.ActionLink("Export to Excel", "ExportDigilockerchecks", "Verification", new { @class = "btn bun-bg btn-default", id = "btnExportCaseStatus" })
                                </div>
                                <br />
                                <div class="row row-sm mt-3" style="justify-content: center;">
                                    <h4 class="card-title text-center fw-bold" style="color:#8D5FFF;">@ViewBag.msg</h4>
                                </div>
                            </div>
                            if (Model != null && Model.DigiLockerDataDetails != null)
                            {
                                <div class="row">
                                    <div class="col-md-12 table">
                                        @{

                                            WebGrid grid = new WebGrid(ajaxUpdateContainerId: "grid");
                                            grid.Bind(Model.DigiLockerDataDetails, autoSortAndPage: false, rowCount: Model.TotalRecords);
                                        }
                                        @{
                                            @grid.GetHtml(
                                                 htmlAttributes: new { id = "grid", @class = "table" },
                                                 headerStyle: "thead-inverse",
                                                 rowStyle: "ordertxt",
                                                 footerStyle: "custpaging",
                                                 mode: WebGridPagerModes.All,
                                                 columns: new[]
                                                 {
                                                     grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                     grid.Column(columnName: "CompanyRefNo", header: "Company Ref No", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "CheckUniqueID", header: "CheckUniqueID", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "UserName", header: "UserName", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "TypeOfEducation", header: "Type Of Education", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "UniversityName", header: "University Name", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "CourseName", header: "Course Name", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "CheckStatus", header: "CheckStatus", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "CandidateStatus", header: "Candidate Status", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "RequestRaiseDate", header: "Request Raised Date", canSort: false, style:"td-1"),
                                                     grid.Column(columnName: "RequestClosedDate", header: "Request Closed Date", canSort: false, style:"td-1"),
                                                     grid.Column("Personalrowid", "Document list", format: @<text>@Html.ActionLink("Document list", "GetDigiLockerDocumentlist", "Verification", new { PersonalRowID = item.Personalrowid }, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "Personalrowid" })</text>),
                                                     grid.Column("CandidateStatus", "Candidate Status", format: (item) =>
                                                     {
                                                         if (item.CandidateStatus == "Done")
                                                         {
                                                             return Html.ActionLink("Mark Pending", "UpdateCandidateStatus", "Verification", new { id = item.Personalrowid }, new { @class = "btn btn-warning btn-sm" });
                                                         }
                                                         else
                                                         {
                                                             return new HtmlString(item.CandidateStatus);
                                                         }
                                                     })
                                                 })
                                        }

                                        <div class="total-record">Total Records: @Model.TotalRecords</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

