                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (colors) {
                        $('#ColorName').val(colors);
                        $('#hdnSeverity').val($("#Severity").val());
                        $('#SeverityRowID').val($("#Severity").val());
                        $("#ColorsName").val(colors);
                        $("#ColorsName").text = colors;
                    }
                });
            });

            $("#CDispositionRowId").change(function () {
    var id = $(this).val();
