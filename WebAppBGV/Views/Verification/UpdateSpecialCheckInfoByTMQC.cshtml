@model dynamic


@{
    string Designation = "";
    if (Session["Designation"] != null)
    {
        Designation = Session["Designation"].ToString();

    }

    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CheckStatusid = "";
    string ReportComments = "";
    string CandCheckRowid = "";
    string Package = "";

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CheckStatusid = @ViewBag.CheckStatusid;
    string CDispositionName = ViewBag.CDispositionName;
    CandCheckRowid = @ViewBag.CandCheckRowID;

    int SeverityRowID = 0;
    string ColorCode = "";
    string SeverityGrid = "";
    string CandidateName = "";
    string CompanyRefNo = "";
    string SubReferenceID = "";


    ReportComments = @ViewBag.ReportComments;
    SeverityRowID = ViewBag.SeverityRowID;
    ColorCode = ViewBag.ColorCode;
    SeverityGrid = ViewBag.SeverityGrid;
    CandidateName = ViewBag.CandidateName;
    CompanyRefNo = ViewBag.CompanyRefNo;
    SubReferenceID = ViewBag.SubReferenceID;

}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <table class="main-tableframe personal-details-frame" border="0">
        <tr>
            <td>@Html.Partial("_PersonalDetails")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_CaseDocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("_DocumentList")</td>
        </tr>
        <tr>
            <td>@Html.Partial("MailList")</td>
        </tr>
    </table>
    @if (ViewBag.SpocActionRemark != null)
    {
        <table class="main-tableframe personal-details-frame" border="0">
            <tr>
                <td colspan="2">
                    <div class="col-12 personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>  Spoc Remark :</div>
                </td>
            </tr>
            <tr>
                @foreach (var item in ViewBag.SpocActionRemark)
                {
                    if (item.PriorityType == "High")
                    {
                        <td style="font-weight: bold; background-color: #ff0000; color: white; width: 5%; ">High</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color:azure;"> @item.SpocRemark </p>
                        </td>
                    }
                    else
                    {
                        <td style="font-weight: bold; background-color: #02fd58; width: 5%; ">Low</td>
                        <td style="width:95%;">
                            <p style="font-size: medium; background-color: azure; "> @item.SpocRemark </p>
                        </td>
                    }
                }
            </tr>
        </table>
    }
    @if (ViewBag.ErrorMsg != null)
    {
        <h4 style="color:red;">@ViewBag.ErrorMsg</h4>
    }
    @if (clientRowId == "1470" && ViewBag.PersonalBind.PackageCheckDetails != null)
    {
        Package = ViewBag.PersonalBind.PackageCheckDetails.ToString().Replace("Package-", "");
    }
    @*@if (clientRowId == "1470" && Package == "CAPCO_Package BNP Paribas (3EDU_6EMP_ID_IDB_GDB_1CER_ DIN_6CRC_UAN_1FPA_1CV)")
        {
            <div style="text-align: center;">
                <a href='@Url.Action("AddCVValidation", "Verification", new { PersonalRowID = PersonalRowid, ClientRowId = clientRowId, SubCheckRowID = SubCheckId})' class="btn bun-bg btn-default iframeCompanyRefNo" style="padding: 5px 10px 5px 10px; font-weight: bold;" id="clip">Update CV Validation</a>
            </div>

        }*@
        <div class="container">
            @using (Html.BeginForm("UpdateSpecialCheckInfoByTMQC", "Verification", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
                @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

                <input id="SubCheckId" type="hidden" value=@SubCheckId>
                @Html.Hidden("SubCheckId", SubCheckId.ToString())

                <input id="clientRowId" type="hidden" value=@clientRowId>
                @Html.Hidden("clientRowId", clientRowId.ToString())

                <input id="CheckStatusid" type="hidden" value=@CheckStatusid>
                @Html.Hidden("CheckStatusid", CheckStatusid.ToString())

                <input id="CandidateName" type="hidden" value=@CandidateName>
                @Html.Hidden("CandidateName", CandidateName.ToString())

                <input id="CompanyRefNo" type="hidden" value=@CompanyRefNo>
                @Html.Hidden("CompanyRefNo", CompanyRefNo.ToString())


                <input id="SubReferenceID" type="hidden" value=@SubReferenceID>
                @Html.Hidden("SubReferenceID", SubReferenceID.ToString())

                <input id="package" type="hidden" value=@Package>
                @Html.Hidden("package", Package.ToString())

                <input id="hdnDispositionID" type="hidden" name="hdnDispositionID">
                <input id="hdnSeverity" type="hidden" name="hdnSeverity" value="0">
                <input id="ColorsName" type="hidden" name="ColorsName" value="@ColorCode">
                <input id="SeverityRowID" type="hidden" name="SeverityRowID" value=@SeverityRowID>



                @Html.ValidationSummary()

                foreach (var category in Model)
                {
                    <div class="row" style="margin-bottom:10px; margin-top:10px;">
                        @{
                            string[] nm = category.Key.Split('_');
                            string[] temp = category.Value.Split('_');

                            if (@nm[2] == "textbox")
                            {

                                <div class="col-md-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                if (nm[0].ToString() != "114")
                                {
                                    <div class="col-md-4">
                                        <p> @temp[0]</p>
                                    </div>
                                }

                                if (nm[0].ToString() == "114")
                                {
                                    <div class="col-md-8">
                                        @if (temp.Count() > 1)
                                        {
                                            <div class="row">
                                                <div class="col-md-12 ">
                                                    <div class="d-flex gap-4">
                                                        <textarea name="114" id="114" rows="5" cols="8" maxlength="@nm[5]">@temp[1]</textarea>
                                                        @if (temp.Count() > 1)
                                                        {
                                                            if (@temp[0] == @temp[1])
                                                            {
                                                                <i class="fa fa-check-circle" style="font-size: 20px; color: green; margin-left: 3px;"></i>
                                                            }
                                                            else
                                                            {
                                                                <i style="font-size:20px;color:green; margin-left:19px;"></i>
                                                            }

                                                        }

                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row">
                                                <div class="col-md-12 ">
                                                    <div class="d-flex gap-4">
                                                        <textarea name="114" id="114" rows="5" cols="8" maxlength="@nm[5]">@temp[0]</textarea>
                                                        @if (temp.Count() > 1)
                                                        {
                                                            if (@temp[0] == @temp[1])
                                                            {
                                                                <i class="fa fa-check-circle" style="font-size: 20px; color: green; margin-left: 3px;"></i>
                                                            }
                                                            else
                                                            {
                                                                <i style="font-size:20px;color:green; margin-left:19px;"></i>
                                                            }

                                                        }

                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-4">
                                        @if (temp.Count() > 1)
                                        {
                                            <div class="row">
                                                <div class="col-md-12 ">
                                                    <div class="d-flex gap-4">
                                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' maxlength="@nm[5]" data-ref="@temp[0]" oninput="checkMatch(this)">
                                                        @if (temp.Count() > 1)
                                                        {
                                                            if (@temp[0].Trim() == @temp[1].Trim())
                                                            {
                                                                <i id="iconx-@nm[0]" class="fa fa-times-circle" style="display:none; font-size:20px;color:red;"></i>
                                                                <i id="icon-@nm[0]" class="fa fa-check-circle" style="font-size:20px;color:green;margin-left:3px;"></i>
                                                                @*<p id="mes" style="color: forestgreen; font-weight: bolder;">Matched</p>*@
                                                            }
                                                            else
                                                            {
                                                                @*<i style="font-size:20px;color:green; margin-left:19px;"></i>*@
                                                                <i id="icon-@nm[0]" class="fa fa-check-circle" style="display:none; font-size:20px;color:green;margin-left:3px;"></i>
                                                                <i id="iconx-@nm[0]" class="fa fa-times-circle" style="font-size:20px;color:red; "></i>
                                                            }
                                                        }


                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row">
                                                <div class="col-md-12 ">
                                                    <div class="d-flex gap-4">
                                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' maxlength="@nm[5]" data-ref="@temp[0]" oninput="checkMatch(this)">
                                                        @if (temp.Count() > 1)
                                                        {
                                                            if (@temp[0] == @temp[1])
                                                            {
                                                                <i id="iconx-@nm[0]" class="fa fa-times-circle" style="display:none; font-size:20px;color:red;"></i>
                                                                <i id="icon-@nm[0]" class="fa fa-check-circle" style="font-size:20px;color:green;margin-left:3px;"></i>
                                                                @*<p id="mes" style="color: forestgreen; font-weight: bolder;">Matched</p>*@
                                                            }
                                                            else
                                                            {
                                                                @*<i style="font-size:20px;color:green; margin-left:19px;"></i>*@
                                                                <i id="icon-@nm[0]" class="fa fa-check-circle" style="display:none; font-size:20px;color:green;margin-left:3px;"></i>
                                                                <i id="iconx-@nm[0]" class="fa fa-times-circle" style="font-size:20px;color:red; "></i>
                                                            }
                                                        }


                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }


                            }
                            if (@nm[2] == "dropdown")
                            {

                                <div class="col-md-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-md-4">
                                    @nm[4]
                                </div>
                                <div class="col-md-4">
                                    @{
                                        int lastindex = nm.Length;
                                        string[] nmOption = nm[lastindex - 1].Split(',');
                                        string Fvalue = nm[7].ToString();
                                    }
                                    <div class="row">
                                        <div class="col-md-12 ">
                                            <div class="d-flex gap-4">
                                                <select name=@nm[0] id='@nm[0]' autocomplete="off" class="form-control" data-ref="@temp[0]" onchange="checkMatch(this)">
                                                    @for (int i = 0; i < nmOption.Length; i++)
                                                    {
                                                        if (@nmOption[i].Trim() == Fvalue)
                                                        {
                                                            <option selected>@nmOption[i]</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                                        }

                                                    }
                                                </select>
                                                @if (@temp[0] == Fvalue)
                                                {
                                                    @*<i class="fa fa-check-circle" style="font-size:20px;color:green; margin-left:3px;"></i>*@
                                                    <i id="iconx-@nm[0]" class="fa fa-times-circle" style="display:none; font-size:20px;color:red;"></i>
                                                    <i id="icon-@nm[0]" class="fa fa-check-circle" style="font-size:20px;color:green;margin-left:3px;"></i>
                                                }
                                                else
                                                {
                                                    @*<i style="font-size:20px;color:green; margin-left:19px;"></i>*@
                                                    <i id="icon-@nm[0]" class="fa fa-check-circle" style="display:none; font-size:20px;color:green;margin-left:3px;"></i>
                                                    <i id="iconx-@nm[0]" class="fa fa-times-circle" style="font-size:20px;color:red; "></i>
                                                }

                                            </div>
                                        </div>
                                    </div>
                                </div>

                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="row">
                                    <div class="col-sm-4" style="padding-top:10px!important;">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-sm-2" style="padding-top:10px!important; text-align:left;">

                                        @{
                                            if (@nm[6] == "TRUE")
                                            {
                                                <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                            }
                                            else
                                            {
                                                <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                            }
                                        }

                                    </div>
                                    <div class="col-sm-4">
                                        @nm[4]
                                    </div>
                                </div>
                            }
                            if (@nm[2] == "fileUpload")
                            {
                                <div class="row">
                                    <div class="col-sm-4">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-sm-4">
                                        <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                    </div>
                                    <div class="col-sm-4">
                                        @nm[4]
                                    </div>
                                </div>

                            }
                        }

                    </div>

                }
                <div class="row">
                    <div class="col-sm-12 cytoscape-parent">
                        <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                    </div>
                </div>


                if (Designation != "Team Member-PV-QC")
                {

                    <div class="row">
                        <div class="col-md-4">
                            Report Comment :
                        </div>
                        <div class="col-md-8">
                            <textarea name="ReportComments" id="ReportComments" rows="5" cols="8">@ReportComments</textarea>

                        </div>
                    </div>

                    if (CheckStatusid.ToString() == "107")
                    {
                        <div class="row">
                            <div class="col-md-1">
                                Severity :
                            </div>
                            <div class="col-md-3">

                                @Html.DropDownList("Severity",
                                 new SelectList(ViewBag.SeverityGrids, "SeverityGridRowId", "SeverityGridName"),
                                 "-- Select -- ",
                                 new { @class = "form-control" })

                            </div>
                            <div class="col-md-1">
                                Color :
                            </div>
                            <div class="col-md-3">
                                @Html.Editor("ColorName", new { htmlAttributes = new { @class = "form-control", @disabled = "disabled", @name = "ColorName" } })


                            </div>
                        </div>
                    }
                    else if (CheckStatusid.ToString() == "58")
                    {
                        <div class="row" style="margin-top:10px;">
                            <div class="col-md-2">Select Disposition :</div>
                            <div class="col-md-3">
                                @Html.DropDownList("CDispositionRowId",
                                    new SelectList(ViewBag.Disposition, "DispositionRowId", "Disposition"),
                                    "-- Select --",
                                    new { @class = "form-control", @id = "CDispositionRowId" })
                            </div>
                            <div class="col-md-1">Severity :</div>
                            <div class="col-md-2">
                                @Html.DropDownList("Severity",
                                    new SelectList(ViewBag.SeverityGrids, "SeverityGridRowId", "SeverityGridName"),
                                    "-- Select --",
                                    new { @class = "form-control", @id = "Severity" })
                            </div>
                            <div class="col-md-1">Color :</div>
                            <div class="col-md-2">
                                <input type="text" id="ColorName" name="ColorName"
                                       class="form-control" value="@ColorCode" />
                            </div>
                        </div>
                    }
                    else
                    {

                        <div class="row" style="margin-top:10px;">
                            <div class="col-md-3">
                                Severity :
                            </div>
                            <div class="col-md-3">
                                <input autocomplete="off" class="form-control" id="Severity" type="text" width="300" name="Severity" disabled="disabled" value=@SeverityGrid>
                            </div>
                            <div class="col-md-3">
                                Color :
                            </div>
                            <div class="col-md-3">
                                <input autocomplete="off" class="form-control" id="ColorName" type="text" name="ColorName" disabled="disabled" value="@ColorCode">
                            </div>
                        </div>
                    }


                }

                if (clientRowId == "1470" && Package == "CAPCO_Package BNP Paribas (3EDU_6EMP_ID_IDB_GDB_1CER_ DIN_6CRC_UAN_1FPA_1CV)")
                {
                    <div class="row mt-3">
                        <div class="col-md-12">

                            <h4 style="text-align:center; background:#11c9b7; color:white; padding:10px;">
                                CV Validation
                            </h4>

                            @Html.Action(
                                "GetCVValidationPartial",
                                "Verification",
                                new
                                {
                                    PersonalRowID = PersonalRowid,
                                    ClientRowId = clientRowId,
                                    SubCheckRowID = SubCheckId
                                })

                        </div>
                    </div>
                }


                <div class="row" style="margin-bottom:40px !important ;margin-top:30px">

                    @if (Designation == "Team Member-SPL-QC")
                    {
                        @Html.ActionLink("Back", "DepartmentTeamMemberQCChecks", "Verification", new { CheckStatusId = CheckStatusid }, new { @class = "btn btn-default VerEmailDetails" })

                        if (CheckStatusid == "70" || CheckStatusid == "71" || CheckStatusid == "24" || CheckStatusid == "25" || CheckStatusid == "74" || CheckStatusid == "107" || CheckStatusid == "58")
                        {
                            <input class="btn bun-bg btn-default" style="margin-right:10px;" onclick="return validateFormApprove()" type="submit" value="Approve" name="action" />
                            <input class="btn bun-bg btn-default" style="margin-right:10px;" type="submit" value="Rejected" name="action" />
                        }
                        if (CheckStatusid == "53")
                        {
                            <input class="btn bun-bg btn-default" type="submit" value="Approve" name="action" />
                            <input class="btn bun-bg btn-default" type="submit" value="Rejected" name="action" />
                        }

                        if (CheckStatusid == "107")
                        {
                            @Html.ActionLink("Attachment", "UplodSpecialCheckVerDocs", "Verification", new { scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @style = "margin-left:10px;", @id = "UplodVerificationDocs" })
                            @Html.ActionLink("Capture Action", "CaptureActionHistoryByVerTM", "Verification", new { CandCheckRowid = CandCheckRowid, cid = clientRowId, scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateStatus cboxElement callbacks btn btn-default", @style = "margin-left:10px;", @id = "VerificationActionHistostry" })


                            if (clientRowId == "1718")
                            {
                                @Html.ActionLink("UAN Validation Log", "UANValidationCheckList", "Verification", new { Sid = SubCheckId, Pid = PersonalRowid }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @style = "margin-left:10px;", @id = "UplodVerificationDocs" })

                            }
                        }
                    }

                </div>



            }
        </div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/tinymceNew.min.js"></script>
    <script src="~/Scripts/tinymce-jquery.min.js"></script>

    <script>
        $('textarea').tinymce({
            height: 200,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | removeformat | help'
        });
        // Prevent jQuery UI dialog from blocking focusin
        $(document).on('focusin', function (e) {
            if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                e.stopImmediatePropagation();
            }
        });
    </script>
    <style>
        .tox-tinymce {
            margin-top: 10px !important;
        }

        .tox-editor-header {
            box-shadow: none !important;
            z-index: 0 !important;
            border-bottom: 0.5px solid #000 !important;
        }

        .tox-statusbar__branding {
            display: none !important;
        }
    </style>
    <script>
        $(document).ready(function () {
             var dispid = '@ViewBag.CDispositionName';
            var Severityid = '@ViewBag.Severityid';
            var ColorName = '@ViewBag.ColorName';
            var Remarks = '@ViewBag.ReportComments';
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
            });


            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            //For Clouse details
            $("#selection option:selected").each(function () {
                var $this = $(this);

                if ($this.length) {
                    var selText = $this.text();
                    var SelectDispositionID = $this.val();
                    $('#hdnDispositionID').append(SelectDispositionID + ',');
                    SelectDispositionID += $this.val() + ',';
                    //console.log(selText);
                    if ($('#selected').val() == '') {
                        $('#selected').append(selText + '\n');
                    }

                    alert($('#hdnDispositionID').val());
                }
            });
            $("#selection").change(function () {
                $('#selected').html(' ');
                alert('hdnDispositionID Change');
                var SelectDispositionID = '';
                $("#selection option:selected").each(function () {
                    var $this = $(this);
                    if ($this.length) {
                        var selText = $this.text();
                        SelectDispositionID += $this.val() + ',';
                        //console.log(selText);
                        $('#selected').append(selText + '\n');
                    }
                });
                if (SelectDispositionID.length > 0) {
                    SelectDispositionID = SelectDispositionID.substring(0, SelectDispositionID.length - 1);
                } else { SelectDispositionID = ''; }
                $('#hdnDispositionID').val(SelectDispositionID);
                alert($('#hdnDispositionID').val());
            });

            $(function () {
                $('#selection').change(function () {

                    var url = "/Verification/GetSeverityColor?ClientRowId=" + $("#clientRowId").val() + "&Dispositions=" + $("#hdnDispositionID").val();
                    $.ajax({
                        url: url,
                        type: 'GET',
                        async: false,
                        dataType: 'json',
                        success: function (colors) {
                            $('#Severity').val(colors.SeverityName);
                            $('#ColorName').val(colors.ColorName);
