    <script>
        function checkMatch(inputEl) {
            debugger;
            const refValue = inputEl.getAttribute("data-ref").trim();
            const inputValue = inputEl.value.trim();

            const checkIcon = document.getElementById("icon-" + inputEl.id);
            const crossIcon = document.getElementById("iconx-" + inputEl.id);


            if (!checkIcon || !crossIcon) return;


            if (inputValue === refValue) {
                checkIcon.style.display = "inline-block";
                crossIcon.style.display = "none";
            } else {
                checkIcon.style.display = "none";
                crossIcon.style.display = "inline-block";
            }
        }


        document.addEventListener("DOMContentLoaded", function () {
            const inputs = document.querySelectorAll(".match-input");
            inputs.forEach(el => checkMatch(el));
        });
    </script>

