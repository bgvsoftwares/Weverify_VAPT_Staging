@{
    ViewBag.Title = "Manager Case Allocation To TeamLeader";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    string Designation = "";

    Designation = ViewBag.Designation;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>RevertDetail</title>
    <style>
        .name {
            width: 10px;
        }
    </style>

</head>
<body>
    <div>
        @if (Model != null && Model.AutoRevertViewModeldetail != null)
        {
            <div class="col-md-12 table">
                @{

                    WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                    grid.Bind(Model.AutoRevertViewModeldetail, autoSortAndPage: false, rowCount: Model.TotalRecords);
                }

                @{



                    @grid.GetHtml(
                     htmlAttributes: new { id = "grid", @class = "table" },
                     headerStyle: "thead-inverse",
                     rowStyle: "ordertxt",
                     footerStyle: "custpaging",
                     mode: WebGridPagerModes.All,
                     columns: new[]
                     {
            grid.Column(header: "No.", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
            //grid.Column(columnName: "id", header: "Auto Id", canSort: false, style:"col-md-1"),

            grid.Column(columnName: "Subject", header: "Subject", canSort: false, style:"td-1"),
            //grid.Column(columnName: "Status", header: "Status", canSort: false, style:"td-1"),
            grid.Column(columnName: "CreationDate", header: "Date", canSort: false, style:"td-1"),
            grid.Column(columnName: "AttachmentPath", header: "AttachmentPath", canSort: false, style:"td-1"),

            grid.Column(header : "Report", format : (item) => {


                                                        return  Html.ActionLink("Download", "GetSubNotMatchMail", new { ImageName = item.AttachmentPath});







                                            }, style:"delete td-1"),
            grid.Column("Action", canSort: false, format: (item)=> {
                                        //if (item.CheckStatusid==21 || item.CheckStatusid==20)
                                        //{//UplodAddressCheckDocsAndComplete(short scid = 0, int pe = 0, string cstatus = "")
                                         //scid = Model.SubCheckRowId, pe = Model.PersonalRowID, cstatus = Model.CheckStatus
                                         if(item.Status==1)
                {
                var link=@Html.ActionLink("Proceed", "AutoRevertProceed", "Verification", new { AutoId = item.id },  new { target = "_blank"});
                                            return link;
                }
                                         else
                {
                    return "";
                }

                                        //}
                                        //return null;
                                    }, style:"td-1" )



                     }
                     )


                }
                <div class="total-record">Total Records: @Model.TotalRecords</div>
            </div>
        }

    </div>
    @section Scripts{
        <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
        <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
        <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
        <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
        <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
        <link href="~/Content/colorbox.css" rel="stylesheet" />
        <script src="~/Scripts/jquery.colorbox-min.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {

                $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
                $(".Remindermail").colorbox({ iframe: true, width: "80%", height: "100%" });
                $(".iframeUpdateAddressDoc").colorbox({ iframe: true, width: "75%", height: "500px" });
                $(".callbacks").colorbox({
                    onClosed: function () {
                        window.location.reload(true);
                    }
                });
            });
            //$('#RecievingToDate').datepicker({
            //    dateFormat: "yy-mm-dd",
            //    changeMonth: true,
            //    changeYear: true,
            //    yearRange: "-66:+0",
            //});
            //$('#RecievingFromDate').datepicker({
            //    dateFormat: "yy-mm-dd",
            //    changeMonth: true,
            //    changeYear: true,
            //    yearRange: "-66:+0",
            //});
            //$('#CompletedToDate').datepicker({
            //    dateFormat: "yy-mm-dd",
