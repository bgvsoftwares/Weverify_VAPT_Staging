@model ViewModels.ProvidedInfoViewModel.EducationEmailVerificationViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Securitas India</title>
</head>
<body style="margin:0px; background:#fff;">
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="600" style="background:#f4f4f4;">
        <tr>
            <td style="font-family:arial; font-size:40px; color:#000; height:60px; background:#fff; padding-left:20px;">BGV</td>
        </tr>
        <tr>
            <td style="background:#0088c3; color:#fff; padding:0px; height:35px;">&nbsp;</td>
        </tr>
        <tr>
            <td valign="top" style="font-family:arial; font-size:12px; padding: 0 0 5px 0; text-align:justify;">
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="padding:0 20px;">
                    <tr>
                        <td>
                            <p style="font-family:arial; font-size:13px; font-weight:bold; padding:12px 0 27px 0;">Dear Sir/Mam,</p>
                            <p>Greeting from Securitas India!!! <br /><br /></p>
                        </td>
                    </tr>
                    <tr>
                        <td>We are one of the leading Background Verification Company, helping organizations to secure their business by checking the antecedents of their employees. Securitas India (Walsons Services) is Empaneled Background Verifier with NSR (National Skills Registry), extending expertise in pre and post-Employment Verification to our clients.<br /><br />Please find below the education details provided by <b>@Model.CandidateName</b> about the course he completed from <b>@Model.UniversityName</b>.<br /><br />We request your support to take forward this initiative by verifying the provided information at earliest.<br /><br /></td>
                    </tr>
                    <tr>
                        <td>
                            <table width="100%" align="center" border="1" cellpadding="5" cellspacing="3">
                                <tr style="background:#e0e0e0; color:#000; font-size:12px;">
                                    <td width="37%"><b>Details</b></td>
                                    <td width="33%"><b>Candidate's Input</b></td>
                                    <td width="30%"><b>HR Comments</b></td>
                                </tr>
                                <tr>
                                    <td style="font-size:10px; text-align:justify; font-weight:bold;">University Name</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">@Model.UniversityName</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="font-size:10px; text-align:justify; font-weight:bold;">Institute/ College/ School Name</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">@Model.InstituteCollegeSchoolName</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="font-size:10px; text-align:justify; font-weight:bold;">Course Name</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">@Model.CourseName</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="font-size:10px; text-align:justify; font-weight:bold;">Roll No/ Registration No/ Seat No</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">@Model.RollNoRegistrationNoSeatNo</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="font-size:10px; text-align:justify; font-weight:bold;">Year Of Passing</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">@Model.YearOfPassing</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="font-size:10px; text-align:left; font-weight:bold;">Any other Comments</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">@Model.Comments</td>
                                    <td style="font-size:10px; text-align:justify; font-weight:normal;">&nbsp;</td>
                                </tr>
                            </table><br /><br />
                        </td>
                    </tr>
                    <tr>
                        <td style="color:#000; font-size:12px;"><b>Verified From:</b> <br /><br /></td>
                    </tr>
                    <tr>
                        <td>
                            <table width="100%" align="center" border="1" cellpadding="5" cellspacing="3">
                                <tr style="color:#000; font-size:10px;">
                                    <td width="50%"><b>Name</b></td>
                                    <td width="50%">&nbsp;</td>
                                </tr>
                                <tr style="color:#000; font-size:10px;">
                                    <td><b>Designation</b></td>
                                    <td>&nbsp;</td>
                                </tr>
                                <tr style="color:#000; font-size:10px;">
                                    <td><b>Contact Number</b></td>
                                    <td>&nbsp;</td>
                                </tr>
                                <tr style="color:#000; font-size:10px;">
                                    <td><b>Official Email-id</b></td>
                                    <td>&nbsp;</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td height="35px;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td height="35px;">We hereby assure that the details received from your end shall remain confidential and not used for any other purpose.</td>
                    </tr>
                    <tr>
                        <td height="35px;">&nbsp;</td>
                    </tr>
                   
                </table>
            </td>
        </tr>
        <tr>
            <td style="background:#656465; height:35px; padding:0px;">&nbsp;</td>
        </tr>
    </table>
</body>
</html>
