
@{
    Layout = null;
}


@{
    string TeamMemberRowID = "";
    ViewBag.Title = "Welcome To LOG Tracker";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    //Layout = "~/Areas/ClientArea/Views/Shared/_LayoutWoutNav.cshtml";


}



@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
@*<link href="~/MultiSelection/docs/css/bootstrap332.css" rel="stylesheet" />*@
<link href="~/Content/MultiselectcNew.css" rel="stylesheet" type="text/css" />
<link href="~/MultiSelection/docs/css/bootstrapexample.css" rel="stylesheet" />
<link href="~/MultiSelection/docs/css/prettify.css" rel="stylesheet" />
<link rel="stylesheet" href="~/MultiSelection/dist/css/bootstrap-multiselect.css" type="text/css">
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="form-horizontal">


            </div>
            <div class="form-group branch">
                @Html.Label("Select MIS Type :", htmlAttributes: new { @class = "col-md-4 control-label" })
                <div class="col-md-4">
                    <select class="form-control" id="SentType" name="SentType">
                        <option>Select</option>
                        <option value="SmartPing">mobile no</option>
                        <option value="Email">Email id</option>




                    </select>
                </div>
            </div>



            <div class="form-group branch">
                @Html.Label("Date From :", htmlAttributes: new { @class = "col-md-4 control-label" })
                <div class="col-md-4">
                    @Html.TextBox("DateFrom", null, new { @class = "form-control", @id = "DateFrom", @placeholder = "dd-MMM-yyyy" })
                </div>
            </div>
            <div class="form-group branch">
                @Html.Label("Date To :", htmlAttributes: new { @class = "col-md-4 control-label" })
                <div class="col-md-4">
                    @Html.TextBox("DateTo", null, new { @class = "form-control", @id = "DateTo", @placeholder = "dd-MMM-yyyy" })
                </div>
            </div>
            <div class="form-group row branch">
                <div class="col-md-4"></div>
                <div class="col-md-4">
                    <input type="button" id="btnMIS" style="width:100px" value="MIS" class="btn bun-bg btn-default" />
                </div>
                <div class="col-md-4"></div>
            </div>
        </div>
    </div>
</div>


</div>
<style>
    .branch > label {
        color: black;
        font-size: 13px;
        font-weight: 100;
    }
</style>
