<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>


<script>
    $(document).ready(function () {

        //alert('i');
    });
    $('#btnSearch').click(function () {

        $("#latitude").val("0,0");
        var add = $.trim($("[id*=address]").val());


        var url = "/Verification/getlatlong?add=" + add;
        $.ajax({
            url: url,
            dataType: 'json',
            type: 'GET',
            async: false,
            //data: { pass: pass },
            success: function (result) {
                $("#latitude").val((JSON.stringify(result.pass.Latitude)) + ',' + (JSON.stringify(result.pass.Longitude)));
            },
            error: function (result) {

            }
        });
    })



</script>



