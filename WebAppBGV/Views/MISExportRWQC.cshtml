@model IEnumerable<ViewModels.ProvidedInfoViewModel.MISExport>

@{
    ViewBag.Title = "MISExportRWQC";
    WebGrid grid = new WebGrid(Model, rowsPerPage: 500);
}

@{
    //@ViewBag.NavigationBtnExportExcel
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excels");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "GetExportExcelRWQC", "ReportQC", null, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));
}
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
@if (ViewBag.UnAllocated == null)
{
    ViewBag.UnAllocated = "";
}
@{



    string Rejection = @ViewBag.Rejection.ToString();
    string RevertReceived = @ViewBag.Re_Verification.ToString();
    string Re_Verification = @ViewBag.Re_Verification.ToString();
    string YTR = @ViewBag.YTR.ToString();
    string TotalWIP = @ViewBag.Total_WIP.ToString();
    string TodaysClosure = @ViewBag.Todays_Closure.ToString();
    string AssignedToday = @ViewBag.Assigned_Today.ToString();
    string Old_Assigned = @ViewBag.Old_Assigned.ToString();
    string Interim_Report = @ViewBag.Interim_Report.ToString();
}

<div class="row">
    <div class="col-md-12" style="margin-bottom:30px;">
        @if (Session["Designation"].ToString() == "Manager Quality Check")
        {
            @grid.GetHtml(
                                                         htmlAttributes: new { id = "grid", @class = "table" },
                                                         headerStyle: "thead-inverse",

                                                         columns: new[]

                                                         {
                                                grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                grid.Column(columnName: "TMFirstName", header: "TM First Name", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Rejection", header: "Rejection", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Re_Verification", header: "ReVerification", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "YTR", header: "YTR", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Total_WIP", header: "Total WIP", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Todays_Closure", header: "Today's Closure", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Assigned_Today", header: "Assigned Today", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Old_Assigned", header: "Old_Assigned", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Interim_Report", header: "Interim_Report", canSort: false, style:"td-2"),
                     }
                     )
            <table class="table">
                <tbody>
                    <tr>
                        <td style="padding-left:10px;font-weight:bold;">Total Count</td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(Rejection, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "Rejection" }, htmlAttributes: null) </td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(Re_Verification, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "Re_Verification" }, htmlAttributes: null) </td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(YTR, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "YTR" }, htmlAttributes: null) </td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(TotalWIP, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "Total_WIP" }, htmlAttributes: null) </td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(TodaysClosure, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "Todays_Closure" }, htmlAttributes: null) </td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(AssignedToday, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "Assigned_Today" }, htmlAttributes: null) </td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(Old_Assigned, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "Old_Assigned" }, htmlAttributes: null) </td>
                        <td style="padding-left:10px;font-weight:bold;">@Html.ActionLink(Interim_Report, "GetMISTATInfoRwqc", "ReportQC", routeValues: new { Type = "Interim_Report" }, htmlAttributes: null) </td>
                    </tr>
                </tbody>
            </table>
        }

        <div class="total-record">Total Records: @ViewBag.record</div>
    </div>
</div>



