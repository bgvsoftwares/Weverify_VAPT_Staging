                    dataType: 'json',
                    success: function (data) {
                        $('#52').val(data.Address);
                        $('#60').val(data.DurationOfStay);
                        $('#58').val(data.Country);
                    }
                });
            }
        });

    </script>
    <script>
        $('#CheckStatus').change(function () {
            debugger
            $("#datalist").empty();
