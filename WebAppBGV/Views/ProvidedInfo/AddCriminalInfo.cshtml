                                        if (ViewBag.SubCheckId.ToString() == "2" || ViewBag.SubCheckId.ToString() == "4" || ViewBag.SubCheckId.ToString() == "5" || ViewBag.SubCheckId.ToString() == "6" || ViewBag.SubCheckId.ToString() == "7" || ViewBag.SubCheckId.ToString() == "13" || ViewBag.SubCheckId.ToString() == "23" || ViewBag.SubCheckId.ToString() == "24" || ViewBag.SubCheckId.ToString() == "25" || ViewBag.SubCheckId.ToString() == "26" || ViewBag.SubCheckId.ToString() == "27" || ViewBag.SubCheckId.ToString() == "30" || ViewBag.SubCheckId.ToString() == "315" || ViewBag.SubCheckId.ToString() == "373" || ViewBag.SubCheckId.ToString() == "374" || ViewBag.SubCheckId.ToString() == "399")
