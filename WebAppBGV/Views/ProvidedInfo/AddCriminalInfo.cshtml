        function validateForm() {
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected") {
                if ($("#INFRemarks").val().trim() == '') {
                    alert("Please mention the reason!");
                    $('#INFRemarks').focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    const infRemarks = $("#INFRemarks").val().trim();
                    if (infRemarks.length < 15) {
                        alert("Please provide a reason that is at least 15 characters long!");
                        $('#INFRemarks').focus();
                        event.preventDefault();
                        return false;
                    }
                    return true;
                }
            }


            function normalizeDate(dateStr) {
                if (!dateStr) return '';

                if (/^\d{2}-\d{2}-\d{4}$/.test(dateStr)) {
                    var parts = dateStr.split('-');
                    return parts[2] + '-' + parts[1] + '-' + parts[0];
                }

                return dateStr;
            }

            var dob = normalizeDate($('#100').val());
            var doj = new Date().toISOString().split('T')[0];

            if (dob != '') {
                debugger
                var dateOfBirth = new Date(dob);
                var dateOfJoin = new Date(doj);

                var age = dateOfJoin.getFullYear() - dateOfBirth.getFullYear();
                var monthDiff = dateOfJoin.getMonth() - dateOfBirth.getMonth();

                if (monthDiff < 0 || (monthDiff === 0 &&  .getDate() < dateOfBirth.getDate())) {
                    age--;
                }

                if (age < 18) {
                    alert("Age should be more than 18 years. from date of joining!");
                    event.preventDefault();
                    return false;
                }
            }

            return true;
        }

    </script>


