    @*<div style="font-size: 14px;text-align: center;font-weight: 600;">@ViewBag.checkDetail</div>*@
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 style="text-align: center;padding: 1%;font-size: 20px!important;color: #fff;">@ViewBag.checkDetail</h2>
        </div>
        <div class="panel-body">
            <div class="col-md-12">
                @if (ViewBag.data != null)
                {
                    <div style="text-align: center;color: #fff;background: #808181;padding: 0%;font-size: 15px;">
                        Detail 1
                    </div>
                    foreach (var SummaryList in ViewBag.data)
                    {
                        <div class="row">
                            <div class="col-md-3 text-right" style="font-weight:bold">@SummaryList.Key:</div>
                            @if (ViewBag.checkDetail == "DocumentDetails" && SummaryList.Key == "DocumentUrl")
                            {
                                if (ViewBag.ForUrl == 1)
                                {
                                    <div class="col-md-9">
                                        <a href=@ViewBag.url target="_blank">download</a>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-9">
                                        <a href=@ViewBag.url>download</a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-md-9"> @SummaryList.Value</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
