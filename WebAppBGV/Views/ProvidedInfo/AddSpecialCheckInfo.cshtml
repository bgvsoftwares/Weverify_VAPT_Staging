            <script>
                function CopyPasteText() {
                    var CopyPaste_Text = $('#CopyPaste_Text').val().replace(/[\n\r]+/g, "•");;
                    if (CopyPaste_Text != '') {
                        var url = "/ProvidedInfo/GetCopyPasteText?Copytext=" + CopyPaste_Text + "&CheckId=FasisCheck";
                        $.ajax({
                            type: 'GET',
                            url: url,
                            async: false,
                            dataType: 'json',
                            success: function (data) {
                                if (data.CountryName != null) {
                                    $('#456').empty();
                                    $('#456').append("<option value='" + data.CountryRowID + "'>" + data.CountryName + "</option>");
                                }
                                if (data.CandidateName != "") {
                                    // $('#116').val(data.CandidateName);
                                    $('#241').val(data.CandidateName);

                                }
                                if (data.FatherName != "") {
                                    $('#117').val(data.FatherName);

                                }
                                if (data.DOB != "") {
                                    $('#178').val(data.DOB);

                                }
                                if (data.AddressLine != "") {
                                    $('#115').val(data.AddressLine);

                                }
                                if (data.Gender != null) {
                                    $('#118').empty();
                                    $('#118').append("<option value='" + data.Gender + "'>" + data.Gender + "</option>");
                                }

                            },
                            error: function (xhr, status, error) {
                                //console.error(xhr, status, error);
                            }
                        });
                    }
                }
            </script>
            <script>
                $('#datalist').change(function () {
                    if ($('#datalist').val() == 'Other') {
                        $('#INFRemarks').val('')
                        document.getElementById("INFRemarks").placeholder = "Write Other Remarks...";
                    }
                    else { $('#INFRemarks').val($('#datalist').val()); }
