            </script>

            <script>
                $(document).ready(function () {
                    $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
                });
            </script>
            <script type="text/javascript">
                $(document).ready(function () {
                    if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested" || $("#CheckStatus").val() == "Recruiter Insufficent") {
                        $("#INFRemarks").prop("disabled", false);
                    }
                    else {
                        $("#INFRemarks").prop("disabled", true);
                    }

                    if ($("#CheckStatus").val() == "Completed") {
                        $("#SubmitWithQC").prop("disabled", false);

                    } else {
                        $("#SubmitWithQC").prop("disabled", true);
                    }
                });
                $(function () {
                    $("#CheckStatus").change(function () {
                        if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested" || $("#CheckStatus").val() == "Recruiter Insufficent") {
                            $("#INFRemarks").prop("disabled", false);
                            $('#INFRemarks').focus();
                        }
                        else {
                            $("#INFRemarks").prop("disabled", true);
                        }

                        if ($("#CheckStatus").val() == "Completed") {
                            $("#SubmitWithQC").prop("disabled", false);

                        } else {
                            $("#SubmitWithQC").prop("disabled", true);
                        }
                    });
                });

                function validateForm() {
                    if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Recruiter Insufficent") {
                        if ($("#INFRemarks").val().trim() == '') {
                            alert("Please mention the reason!");
                            $('#INFRemarks').focus();
                            event.preventDefault();
                            return false;
                        }
                        else {
                            const infRemarks = $("#INFRemarks").val().trim();
                            if (infRemarks.length < 15) {
                                alert("Please provide a reason that is at least 15 characters long!");
                                $('#INFRemarks').focus();
                                event.preventDefault();
                                return false;
                            }
                            return true;
                        }
                    }
                    function normalizeDate(dateStr) {
                        if (!dateStr) return '';

                        if (/^\d{2}-\d{2}-\d{4}$/.test(dateStr)) {
                            var parts = dateStr.split('-');
                            return parts[2] + '-' + parts[1] + '-' + parts[0];
                        }

                        return dateStr;
                    }

                    var dob = normalizeDate($('#178').val());
                    var doj = new Date().toISOString().split('T')[0];

                    if (dob != '' && (cRowId != 1808 || cRowId != 1692)) {
                        debugger
                        var dateOfBirth = new Date(dob);
                        var dateOfJoin = new Date(doj);

                        var age = dateOfJoin.getFullYear() - dateOfBirth.getFullYear();
                        var monthDiff = dateOfJoin.getMonth() - dateOfBirth.getMonth();

                        if (monthDiff < 0 || (monthDiff === 0 && dateOfJoin.getDate() < dateOfBirth.getDate())) {
                            age--;
                        }

                        if (age < 18) {
                            alert("Age should be more than 18 years. from date of joining!");
                            event.preventDefault();
                            return false;
                        }
                    }

                    return true;
                }


                function validateFormWithQc() {
                    $('#WithQcval').val('SubmitWithQCApprove')
                    return true;
                }

            </script>
