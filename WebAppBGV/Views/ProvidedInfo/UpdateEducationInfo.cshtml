
@model dynamic
@{
    ViewBag.Title = "Update Education Info (" + Convert.ToString(ViewBag.Name) + ")";
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    //string hyperLink = Html.ActionLink("linkTitle", "ManageDataEntryJob", "ProvidedInfo", new { id = Model.PersonalRowID, CheckstatusId = Model.CheckStatusId }, new { @class = "headerbacklink" }).ToString();
    //ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string degreeid = "";
    string RejectReason = "";
    //string degreeName = @ViewBag.degreeName;


    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;


}
@if (ViewBag.CheckComments != "")
{
    RejectReason = @ViewBag.CheckComments;
}
@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
@*<link href="~/assets/css/icons.css" rel="stylesheet">
<div class="submit-progress hidden">
    <i class="fa fa-2x fa-spinner fa-spin"></i>
</div>*@
<div class="container">
    @using (Html.BeginForm("UpdateEducationInfo", "ProvidedInfo", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
        @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SubCheckId>
        @Html.Hidden("SubCheckId", SubCheckId.ToString())

        <input id="clientRowId" type="hidden" value=@clientRowId>
        @Html.Hidden("clientRowId", clientRowId.ToString())

        <input type="hidden" id="CollegeId" name="CollegeId" value=@ViewBag.CollgegIdn />
        <input type="hidden" id="CollegeNameTemp" name="CollegeNameTemp" />
        @Html.ValidationSummary()

        @Html.Partial("_PersonalDetails")
        @Html.Partial("_UploadedDocumentList")
        @Html.Partial("_CaseDocumentList")
        foreach (var category in Model)
        {
            <div class="row mt-3">
                @{
                    string[] nm = category.Key.Split('_');

                    if (@nm[2] == "textbox")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value.Replace("_","")' maxlength=@nm[5]>
                        </div>

                    }
                    if (@nm[2] == "dropdown")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            @{
                                int lastindex = nm.Length;
                                string[] nmOption = nm[lastindex - 1].Split(',');
                                string Fvalue = nm[lastindex - 3].ToString();
                            }
                            <select name=@nm[0] id=@nm[0]>
                                @for (int i = 0; i < nmOption.Length; i++)
                                {



                                    if (@nmOption[i].Trim() == Fvalue)
                                    {
                                        <option selected>@nmOption[i]</option>

                                    }
                                    else
                                    {

                                        <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                    }

                                }
                            </select>
                        </div>
                    }
                    if (@nm[2] == "checkbox")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            @{
                                if (@nm[6] == "TRUE")
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                }
                                else
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                }
                            }
                        </div>
                    }
                    if (@nm[2] == "fileUpload")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                        </div>
                    }
                }

            </div>

        }
        <div class="row mt-3">
            <div class="col-sm">
                @Html.Label("Comments", htmlAttributes: new { @class = "col-md-4 control-label" })
            </div>
            <div class="col-sm">
                @Html.TextArea("RejectionReason", RejectReason, new { @class = "form-control", @rows = "2" })
            </div>
        </div>

        if (ViewBag.checkstatusid != "113")
        {
            <div class="row m-5">
                <div class="col-md-6 text-center">
                    <input class="btn bun-bg btn-default" type="submit" onclick="return validateRejectionForm(this, 'Reject')" value="Reject" name="action" />
                </div>
                <div class="col-md-6">
                    <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm(this, 'Approve')" value="Approve" name="action" />
                </div>
            </div>

        }

    }
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () {
            if ('@TempData["Message"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Success',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["Message"].ToString()</div>'
                });
            }
            if ('@TempData["MessageRejection"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Rejection Reason',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["MessageRejection"].ToString()</div>'
                });
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
           // var a = '@(ViewBag.degreeName)';


            var text1 = $("#HfdegreeName").val().trim();



        //if ($('#72').val() != null) {

            $.getJSON('/Master/GetDegreeList/', function (data) {
                var items = '<option value="">-- Select Degree --</option>';
                $.each(data, function (i, degree) {
                    items += "<option value='" + degree.Value + "'>" + degree.Text + "</option>";
                });
                $('#72').html(items);
                $("#72 option").filter(function () {
                    return this.text == text1;
                }).attr('selected', true);



            });
               //}


            if ($("#EV_Colg_Schl_Inst_Name").val() != null) {
                var url = "/ProvidedInfo/AffiliatedCollege/" + $("#EV_Colg_Schl_Inst_Name").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (AfflCollage) {
                        $('#strEV_Affl_University_Name').val(AfflCollage);
                    }
                });
            }
        });

        function validateRejectionForm() {
            if ($("#RejectionReason").val() == '') {
                alert("Please mention the reason!");
                $('#RejectionReason').focus();
                return false;
            }
            else {
                $("#CheckStatus").val("Rejected");
                return true;
            }
        }

        function validateForm() {
            $("#CheckStatus").val("Approve");
            return true;
        }

        $(function () {
            $('#72').change(function () {

                $('#HfdegreeName').val($('#72 option:selected').text());

            });
        });

    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+10",
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });
        });
    </script>
    <script>
        $("#72").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Master/getAutoDegreelistDE",
                    type: "POST",
                    dataType: "json",
                    data: { DegreeName: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.DegreeName, value: item.DegreeRowID };
                        }))
                    }
                })
            },
            minLength: 3,
            select: function (event, ui) {
                event.preventDefault();
            },
            focus: function (event, ui) {
                event.preventDefault();
                $("#72").val(ui.item.label);
            }
        });
    </script>
}
    <style>
        .btn {
            padding: 10px 40px 10px 40px !important;
        }

