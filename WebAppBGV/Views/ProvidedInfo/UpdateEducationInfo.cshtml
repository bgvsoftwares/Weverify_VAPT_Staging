            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
        }
            .submit-progress i {
                margin-right: 0.5em;
                color: black
            }
        .hidden {
            display: none;
        }

        .fa-2x {
            font-size: 4em;
        }
</style>

<script type="text/javascript">
        $(document).ready(function () {
            var text1 = '@(ViewBag.degreeName)';           

            $("#69").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Master/getAutoCollegelistforDE",
                        type: "POST",
                        dataType: "json",
                        data: { CollegeName: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.CollegeName, value: item.CollegeId };
                            }))
                        }
                    })
                },
                minLength: 3,
                select: function (event, ui) {
                    event.preventDefault();
                },
                focus: function (event, ui) {
                    event.preventDefault();
                    $("#69").val(ui.item.label);
                    $("#CollegeNameTemp").val(ui.item.label);
                    $('#CollegeId').val(ui.item.value);

                }
            });
        })

        $("#69").blur(function () {
            if ($("#69").val().trim() != $("#CollegeNameTemp").val().trim()) {
                $("#69").val("");
                $('#CollegeId').val("0");
                $('#CollegeAddress').val("");
            }
        });

        $(function () {
            $('#69').change(function () {
                var CurOrg = $("#69").val();
                var url = "/ProvidedInfo/CollegeAddress_New/" + $("#CollegeId").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (result) {

                        $('#186').val(result.Address);
                        $('#67').val(result.UniversityName);
                        $('#77').val("");
                    }
                });
            });

            //$('#72').change(function () {

            //    $('#HfdegreeName').val($('#72 option:selected').text());

            //});
        });

</script>