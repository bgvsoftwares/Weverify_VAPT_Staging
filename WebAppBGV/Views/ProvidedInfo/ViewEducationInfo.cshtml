@using ViewModels.ProvidedInfoViewModel;
@model ViewModels.ProvidedInfoViewModel.ViewEducationViewModel
@{
    ViewBag.Title = "View Education Info (" + ViewBag.EducationDetails.EV_Cand_Name + ")";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = string.Empty;
    if (Session["Designation"].ToString() == "Team Leader-DE")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageReviewRequestedChecksForDETL", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    }
    if (Session["Designation"].ToString() == "Team Member-DE-QC")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageRejectedChecksByDepTMForDEQC", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    }
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">

        @if (ViewBag.ListEducation != null)
            {              
            <div class="form-horizontal">
                @Html.Partial("_UploadedDocumentList", Model)
                @Html.Partial("_ClientSpecialInstruction", Model)

                @foreach (var item in ViewBag.ListEducation)
                {
                    if (item.FieldName == "EV_Cand_Name")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Cand_Name
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Cand_Name_Supp_Edu_Doc")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Cand_Name_Supp_Edu_Doc
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Colg_Schl_Inst_Name")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Colg_Schl_Inst_Name
                            </div>
                        </div>
                            <div class="form-group row viewborder">
                                <div class="col-md-5 col-md-offset-1">
                                    <label>OtherInstitute</label>
                                    </div>
                                    <div class="col-md-6 branch">
                                            @ViewBag.EducationDetails.OtherInstitute
                                    </div>
                                </div>
                         
                    }
                    if (item.FieldName == "EV_Colg_Schl_Inst_Add_ConDet")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Colg_Schl_Inst_Add_ConDet
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Affl_University_Name")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.strEV_Affl_University_Name
                            </div>                           
                        </div>
                    }
                    if (item.FieldName == "EV_Degree_Name")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Degree_Name
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Mode_Of_Edu")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Mode_Of_Edu
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Enroll_RollNo")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Enroll_RollNo
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_RegNo_RegCode")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_RegNo_RegCode
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Dur_Course")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Dur_Course
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Course_Status")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Course_Status
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Specialization")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Specialization
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Period_Course")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Period_Course
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Yr_Passing")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Yr_Passing
                            </div>
                        </div>
                    }
                    if (item.FieldName == "EV_Division_CGPA")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.EV_Division_CGPA
                            </div>
                        </div>
                    }
                    if (item.FieldName == "ATA_CID_No")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-5 col-md-offset-1">
                                    @ViewBag.EducationDetails.ATA_CID_No
                            </div>
                        </div>
                    }
                    if (item.FieldName == "ATA_Cmpny_Addr")
                    {
                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                    @ViewBag.EducationDetails.ATA_Cmpny_Addr
                            </div>
                        </div>
                    }
                }
                <div class="form-group row viewborder">
                    @Html.LabelFor(model => model.CheckStatus, htmlAttributes: new { @class = "col-md-5 col-md-offset-1" })
                    <div class="col-md-6 branch">
                            @ViewBag.EducationDetails.CheckStatus
                    </div>
                </div>
            </div>
        }

        @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ClientRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.CheckFamilyRowID)
            @Html.HiddenFor(model => model.SubCheckRowID)
            @Html.HiddenFor(model => model.EducationRowID)
            <div class="form-group row">
                @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-5 col-md-offset-1 control-label" })
                <div class="col-md-6 branch">
                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control ", @rows = "2" })
                        @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-horizontal">
                <div class="form-group row viewborder"></div>
                <div class="all-button-bg">
                    @{
                        if (Session["Designation"].ToString() == "Team Leader-DE")
                        {
                            @Html.ActionLink("Back", "ManageReviewRequestedChecksForDETL", "Insuff", null, new { @class = "btn bun-bg btn-default" })

                            <button class="btn bun-bg btn-default" type="submit" name="Rejected" onclick="return validateForm()" value="false">Submit</button>

                        }
                        if (Session["Designation"].ToString() == "Team Member-DE-QC")
                        {
                            @Html.ActionLink("Back", "ManageRejectedChecksByDepTMForDEQC", "Insuff", null, new { @class = "btn bun-bg btn-default" })

                            <button class="btn bun-bg btn-default" type="submit" name="Approved" onclick="return validateForm()" value="true">Approved</button>
                            <input type="hidden" name="Approved" value="false" />
                            <button class="btn bun-bg btn-default" type="submit" name="Rejected" onclick="return validateForm()" >Rejected</button>
                        }
                    }                    
                    
                   

                    @*<input class="btn bun-bg btn-default" type="submit" id="submit" onclick="return validateForm()" name="Approved" value="true" >Approved</Input>
                    <input class="btn bun-bg btn-default" type="submit" id="Ressjected" onclick="return validateForm()" name="Rejected" value="true">Rejected </ Input >*@


</div>


</div>
        }
    </div>
</div>
@section Scripts{
<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
<script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
<script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });  

            $("#submit").click(function () {
                $("form").attr("action", "/ProvidedInfo/ViewEducationInfo");
            });

            $("#Rejected").click(function () {
                $("form").attr("action", "/ProvidedInfo/ViewEducationInfo");
            });
        });
    </script>
}
