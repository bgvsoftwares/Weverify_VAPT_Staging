                                        //        var link = Html.ActionLink(ComponentID, "UploadCandidateDocument", "ProvidedInfo", new {  PersonalRowID = item.PersonalRowID, subCheckId = item.SubCheckRowID,ChFamilRowId=item.CheckFamilyRowID, SecuritasRefID=item.CompanyRefNo ,window="TLDE"}, new { @class="edit" });
                                        //    return link;
