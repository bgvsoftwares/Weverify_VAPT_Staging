@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            $(".iframeRptArtifactDoc").colorbox({ iframe: true, width: "80%", height: "70%" });
        });

        $(".Complete").on("click", function () {
            var str = $(this).attr("id");
            var Subcheckid = $(this).attr("Subcheckid");


            var flag = confirm('Are you sure to delete the check?');
            if (str != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteCheck", "ReportQC")',
                    data: { "id": str, "Subcheckid": Subcheckid },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Check delete Successfully!");
                           // "ManageCandidateChecksForReportQCTM", new { PersonalRowID = id });
                            setTimeout(function () { window.location.replace("ManageCandidateChecksForReportQCTM?PersonalRowID=" + str); }, 500);
                            //setTimeout(function () { window.location.replace("ManageClientLogin"); }, 500);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });
    </script>
}


