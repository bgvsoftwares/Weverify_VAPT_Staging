@using ViewModels.ProvidedInfoViewModel;
@model  ViewModels.ProvidedInfoViewModel.ViewNationalIdentityViewModel
@{
    ViewBag.Title = "View National Identity Info (" + ViewBag.NIdentityDetails.NIC_Cand_Name + ")";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = string.Empty;
    if (Session["Designation"].ToString() == "Team Leader-DE")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageReviewRequestedChecksForDETL", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    }
    if (Session["Designation"].ToString() == "Team Member-DE-QC")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageRejectedChecksByDepTMForDEQC", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    }
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

