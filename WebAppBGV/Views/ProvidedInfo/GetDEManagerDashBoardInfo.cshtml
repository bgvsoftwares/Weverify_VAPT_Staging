@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Manage Candidate List";
}
@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    string version = "";
    if (ViewBag.tatHours != null)
    {
        tatHours1 = ViewBag.tatHours.ToString();
    }
    if (ViewBag.CaseStatus != null)
    {
        CaseStatus1 = ViewBag.CaseStatus.ToString();
    }
    version = ViewBag.version;

    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExcelExportDE", "ProvidedInfo", new { CaseStatus =clsCommonMethods.PEncrypt(CaseStatus1), tatHours = clsCommonMethods.PEncrypt(tatHours1) }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));


}
@section NavigationButton{ @Html.Partial("_NavigationButton") }

@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/1.14.1/css/jquery.dataTables.min.css" />
<link href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.dataTables.min.css" />

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("GetDEManagerDashBoardInfo", "ProvidedInfo", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                <div class="form-group branch row row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                        new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                        "-- Select Client -- ",
                                        new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Securitas Id...", @autocomplete = "off", @maxLength = "100" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(CaseStatus1))
                                {
                                    @Html.Hidden("CaseStatus", CaseStatus1)
                                }
                                @if (!string.IsNullOrEmpty(tatHours1))
                                {
                                    @Html.Hidden("tatHours", tatHours1)
                                }
                                @if (!string.IsNullOrEmpty(version))
                                {
                                    @Html.Hidden("version", version)
                                }
                                <div class="form-group branch row search-frame">
                                    <div class="col-md-12" style="text-align:center;">
                                        <input class="btn bun-bg btn-default" type="submit" value="Search" id="btnSearch" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <br />
                @if (Model != null && Model.DashboardDetailsDE != null)
                {
                    <div class="card-body">
                        @{

                            WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                            grid.Bind(Model.DashboardDetailsDE, autoSortAndPage: false, rowCount: Model.TotalRecords);
                        }
                        @grid.GetHtml(
                                htmlAttributes: new { id = "grid", @class = "table table-striped table-bordered nowrap" },
                                headerStyle: "thead-inverse",
                                rowStyle: "ordertxt",
                                footerStyle: "custpaging",
                                mode: WebGridPagerModes.All,
                                columns: new[]
                                {
                                grid.Column(header: "S.No", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-1"),
                                grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"td-1"),
                                grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"td-1"),
                                grid.Column("CreatedDate", "Created-Date", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                grid.Column(columnName: "CaseStatus", header: "Status", canSort: false, style:"td-1"),
                                 grid.Column("Check Status", canSort: false, format: (item)=> {

                                 var link=@Html.ActionLink("Show", "ClientCheckStatus", "ClientServicing", new { CompanyRefNo=item.CompanyRefNo    }, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });

                                                return link;
                                                               //}

                                                            }, style:"td-1" ),
                                grid.Column(header : "Action", format : (item) => {
                                    var link = Html.ActionLink("History", "CaseActionHistories", "ReportQC", new { pid = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement" });
                                    return link;
                                }, style:"edit td-1"),
                            }
                         )
                        <div class="total-record">Total Records: @Model.TotalRecords</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script src="~/Scripts/normalizePlugin.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}

<script>
    $(document).ready(function () {
        var table = $('#grid').DataTable({
            responsive: true,
            dom: 'Bfrtip',
        });

        new $.fn.dataTable.FixedHeader(table);
    });
</script>
<script>
    $("#btnSearch").click(function () {
        var obj = $('form input[type="text"]').NormalizedString();
        if (obj == false) {
            return false;
        }
    });
    $("#Search").SearchString();
</script>
<style>
    #select_all {
        width: 30px !important;
    }

    .personalId {
        width: 30px !important;
    }

    @@media screen and (max-width: 1450px) and (min-width: 600px) {
        #grid {
            font-size: .90rem;
            width: 100%;
        }

        .table td, .table th {
            padding: .60rem !important;
        }

        .thead-inverse {
            font-size: .90rem !important;
        }

        .table, td, .edit {
            font-size: .95rem !important;
        }
    }
</style>
