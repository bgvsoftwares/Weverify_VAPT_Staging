@model ViewModels.TempViewModel.APICandidateSummaryDetailListPagedModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    string UniqueRefId = "";
    if (Request.QueryString["UniqueReferenceID"] != null)
    {
        UniqueRefId = Request.QueryString["UniqueReferenceID"].ToString();
    }
    string personalRowID = "";
    if (Request.QueryString["PersonalRowID"] != null)
    {
        personalRowID = Request.QueryString["PersonalRowID"].ToString();
    }

}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>CandidateSummaryDetail</title>
</head>
<body>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <div class="col-md-12">
        @Html.ActionLink("Document Details", "CandidateCheckDetail", "ProvidedInfo", new { UniqueReferenceID = UniqueRefId, Types = "DocumentDetails", PersonalRowID = personalRowID }, new { @class = "Remindermail  callbacks" }) &nbsp;

        <div id="repo" class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="text-center" style="text-align: center;padding: 1%;font-size: 20px!important;color: #fff;">Personal Detail</h2>
            </div>
            <div class="panel-body">
                @if (Model.APICandidateSummaryDetail != null)
                {

                    foreach (var SummaryList in Model.APICandidateSummaryDetail)
                    {
                        <div class="row row-sm">
                            <div class="col-md-6 text-right" style="font-weight:bold">@SummaryList.Antecedent:</div>
                            @{
                                int let = (SummaryList.AntecedentValue).Length;
                                if (let > 100)
                                {
                                    if (SummaryList.Antecedent == "patterndetails" && (SummaryList.ClientID == "317" || SummaryList.ClientID == "327"))
                                    {
                                        <div class="col-md-6" style="font-weight:bold">
                                            @Html.ActionLink("Click Here", "PatternDetailsCheck", "ProvidedInfo", new { UniqueReferenceID = SummaryList.APIAutoID, Types = SummaryList.Antecedent, LoginType = "", PersonalRowID = personalRowID }, new { @class = "Remindermail  callbacks", @style = "color:blue" })
                                        </div>
                                    }
                                    else if (SummaryList.Antecedent == "Check List Details" && (SummaryList.ClientID == "317" || SummaryList.ClientID == "327"))
                                    {
                                        <div class="col-md-6" style="font-weight:bold">
                                            @Html.ActionLink("Click Here", "CheckListDetailsAPI", "ProvidedInfo", new { UniqueReferenceID = UniqueRefId, Types = SummaryList.Antecedent, PersonalRowID = personalRowID }, new { @class = "Remindermail  callbacks", @style = "color:blue" })
                                        </div>
                                    }
                                    else
                                                    {
                                        <div class="col-md-6" style="font-weight:bold">
                                            @Html.ActionLink("Click Here", "CandidateCheckDetail", "ProvidedInfo", new { UniqueReferenceID = SummaryList.APIAutoID, Types = SummaryList.Antecedent, PersonalRowID = personalRowID }, new { @class = "Remindermail  callbacks", @style = "color:blue" })
                                        </div>
                                    }

                                }
                                else
                                {
                                    <div class="col-md-6"> @SummaryList.AntecedentValue</div>
                                }
                            }
                        </div>
                    }
                    @*<div class="col-md-8">
                            .
                        </div>
                        <div class="col-md-8">
                            .
                        </div>*@
                }
            </div>
        </div>
        <div class="panel-footer" style="float:right;">
            <input type="button" class="btn bun-bg btn-success" style="padding: 5px 10px 5px 10px;font-weight: bold;" value="Save / Upload As PDF" onclick="fnGenAutoSaveAsPDF()" />
            <br />
            <input type="button" class="btn bun-bg btn-default" style="padding: 5px 10px 5px 10px;font-weight: bold; visibility:hidden;" value="Download PDF" onclick="fnDownloadAsPDF()" />
        </div>

    </div>
    <div class="col-md-12">
        @if (ViewBag.InsuffCheckCount > 0)
        {
            @Html.ActionLink("Document Details", "CandidateCheckInsuffDetail", "ProvidedInfo", new { UniqueReferenceID = UniqueRefId, Types = "DocumentDetails" }, new { @class = "Remindermail  callbacks" })
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="text-center" style="text-align: center;padding: 1%;font-size: 20px!important;color: #fff;">Insuff Detail</h2>
                </div>
                <div class="panel-body">
                    @if (ViewBag.InsuffCheck != null)
                    {

                        foreach (var SummaryList in ViewBag.InsuffCheck)
                        {
                            <div class="row row-sm">
                                <div class="col-md-6 text-right" style="font-weight:bold">@SummaryList.Antecedent:</div>
                                @{
                                    int let = (SummaryList.AntecedentValue).Length;
                                    if (let > 100)
                                    {
                                        <div class="col-md-6" style="font-weight:bold">
                                            @Html.ActionLink("Click Here", "CandidateCheckInsuffDetail", "ProvidedInfo", new { UniqueReferenceID = SummaryList.APIAutoID, Types = SummaryList.Antecedent }, new { @class = "Remindermail  callbacks", @style = "color:blue" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-6"> @SummaryList.AntecedentValue</div>
                                    }
                                }
                            </div>
                        }
                        @*<div class="col-md-8">
                                .
                            </div>
                            <div class="col-md-8">
                                .
                            </div>*@
                    }
                </div>
            </div>
        }

    </div>
    <div class="col-md-12">
        @if (ViewBag.ReverificationCheckCount > 0)
        {
            @Html.ActionLink("Document Details", "CandidateCheckReverificationDetail", "ProvidedInfo", new { UniqueReferenceID = UniqueRefId, Types = "DocumentDetails" }, new { @class = "Remindermail  callbacks" })
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="text-center" style="text-align: center;padding: 1%;font-size: 20px!important;color: #fff;">Re-Initiate Detail</h2>
                </div>
                <div class="panel-body">
                    @if (ViewBag.ReverificationCheck != null)
                    {

                        foreach (var SummaryList in ViewBag.ReverificationCheck)
                        {
                            <div class="row row-sm">
                                <div class="col-md-6 text-right" style="font-weight:bold">@SummaryList.Antecedent:</div>
                                @{
                                    int let = (SummaryList.AntecedentValue).Length;
                                    if (let > 100)
                                    {
                                        <div class="col-md-6" style="font-weight:bold">
                                            @Html.ActionLink("Click Here", "CandidateCheckReverificationDetail", "ProvidedInfo", new { UniqueReferenceID = SummaryList.APIAutoID, Types = SummaryList.Antecedent }, new { @class = "Remindermail  callbacks", @style = "color:blue" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-6"> @SummaryList.AntecedentValue</div>
                                    }
                                }
                            </div>
                        }
                        @*<div class="col-md-8">
                                .
                            </div>
                            <div class="col-md-8">
                                .
                            </div>*@
                    }
                </div>
            </div>
        }

    </div>
</body>
</html>
