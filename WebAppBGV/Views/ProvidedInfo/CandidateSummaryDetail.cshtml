    <script>
        async function fnDownloadAsPDF() {
            const { jsPDF } = window.jspdf;

            // div content
            const content = document.getElementById("repo");
            const checkName = "PersonalDetail";
            var PUniqueId = '@UniqueRefId';
            // PDF File Name
            const strFileName = `${PUniqueId}_${checkName}.pdf`;

            // Use html2canvas to render the content
            await html2canvas(content, {
                scale: 2, // improves quality
                useCORS: true // enables loading external styles/images
            }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('p', 'mm', 'a4');

                const imgProps = pdf.getImageProperties(imgData);
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
                // Trigger local download
                pdf.save(strFileName);

            });
        }
    </script>
        
    <script>
        async function fnGenAutoSaveAsPDF() {

            const content = document.getElementById("repo");
            const checkName = "PersonalDetail";
            const PUniqueId = '@UniqueRefId';
            // PDF File Name
            const strFileName = `${PUniqueId}_${checkName}.pdf`;

            // render HTML to the canvas
            const canvas = await html2canvas(content, { scale: 1.2, useCORS: true });
            const imgData = canvas.toDataURL("image/jpeg", 0.65);

            // Create PDF
            const pdf = new jspdf.jsPDF("p", "mm", "a4");
            const pdfWidth = pdf.internal.pageSize.getWidth();
            const pdfHeight = pdf.internal.pageSize.getHeight();

            const imgWidth = pdfWidth;
            const imgHeight = (canvas.height * pdfWidth) / canvas.width;

            let heightLeft = imgHeight;
            let position = 0;

            pdf.addImage(imgData, "JPEG", 0, 0, imgWidth, imgHeight);
            heightLeft -= pdfHeight;

            // Add Multiple Page
            while (heightLeft > 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, "JPEG", 0, position, imgWidth, imgHeight);
                heightLeft -= pdfHeight;
            }

            // Create Blob
            const pdfBlob = pdf.output("blob");

            // Trigger file download
            pdf.save(strFileName);

            const formData = new FormData();
            formData.append("PersonalRowID", '@personalRowID');
            formData.append("DocumentType", "BGV Page");
            formData.append("uploadDoc", pdfBlob, strFileName);

            try {
                const response = await fetch("/ProvidedInfo/fnUploadAPIDocumentBGVPage", {
                    method: "POST",
                    body: formData
                });

                if (response.ok) {
                    alert("Document uploaded successfully!");
                } else {
                    alert("Upload failed.");
                }
            } catch (error) {
                alert("Error while uploading PDF.");
            }
        }
    </script>


}
