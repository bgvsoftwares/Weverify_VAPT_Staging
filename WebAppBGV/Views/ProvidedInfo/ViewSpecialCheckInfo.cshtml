@using ViewModels.ProvidedInfoViewModel;
@model ViewModels.ProvidedInfoViewModel.ViewSpecialCheckViewModel
@{
    ViewBag.Title = "View Special Check Info (" + ViewBag.SpecialCheckdetails.SC_Cand_Name + ")";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = string.Empty;
    if ( Convert.ToString(Session["Designation"]) == "Team Leader-DE")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageReviewRequestedChecksForDETL", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    }
    if (Session["Designation"].ToString() == "Team Member-DE-QC")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageRejectedChecksByDepTMForDEQC", "Insuff", null, new { @class = "headerbacklink" }).ToString();
    }
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">

        @if (ViewBag.ListSpecialCheck != null)
        {
            IEnumerable<PQAntecedentList> fields = ViewBag.ListSpecialCheck;
            int totalFields = fields.Count();
            <div class="form-horizontal">

                @Html.Partial("_UploadedDocumentList", Model)

                @foreach (var item in ViewBag.ListSpecialCheck)
                {
                    if (item.FieldName == "SC_Cand_Name")
                    {
                        <div class="form-group branch">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_Cand_Name
                            </div>
                        </div>
                    }
                    if (item.FieldName == "SC_Father_Name")
                    {
                        <div class="form-group viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_Father_Name
                            </div>
                        </div>
                    }
                    if (item.FieldName == "SC_DOB")
                    {
                        <div class="form-group viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_DOB
                            </div>
                        </div>
                    }                   
                    if (item.FieldName == "SC_Others1")
                    {
                        <div class="form-group viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_Others1
                            </div>
                        </div>
                    }
                    if (item.FieldName == "SC_Others2")
                    {
                        <div class="form-group viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_Others2
                            </div>
                        </div>
                    }
                    if (item.FieldName == "SC_Others3")
                    {
                        <div class="form-group viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_Others3
                            </div>
                        </div>
                    }
                    if (item.FieldName == "SC_Others4")
                    {
                        <div class="form-group viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_Others4
                            </div>
                        </div>
                    }
                    if (item.FieldName == "SC_Others5")
                    {
                        <div class="form-group viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">
                                @ViewBag.SpecialCheckdetails.SC_Others5
                            </div>
                        </div>
                    }
                }
                <div class="form-group viewborder">

                    @Html.LabelFor(model => model.CheckStatus, htmlAttributes: new { @class = "col-md-5 col-md-offset-1" })

                    <div class="col-md-6 branch">
                        @ViewBag.SpecialCheckdetails.CheckStatus
                    </div>
                </div>
            </div>
        }
        @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.SpecialCheckRowId)
            @Html.HiddenFor(model => model.ClientRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.CheckFamilyRowID)
            @Html.HiddenFor(model => model.SubCheckRowID)
            <div class="form-group">
                <div class="col-md-5 col-md-offset-1">
                    <label>Remarks</label>
                </div>
                <div class="col-md-6 branch">
                    @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control ", @rows = "2" })
                    @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-horizontal">
                <div class="form-group viewborder"></div>
                <div class="all-button-bg">
                    @{
                        if (Session["Designation"].ToString() == "Team Leader-DE")
                        {
                            @Html.ActionLink("Back", "ManageReviewRequestedChecksForDETL", "Insuff", null, new { @class = "btn bun-bg btn-default" })
                            <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                        }
                        if (Session["Designation"].ToString() == "Team Member-DE-QC")
                        {
                            @Html.ActionLink("Back", "ManageRejectedChecksByDepTMForDEQC", "Insuff", null, new { @class = "btn bun-bg btn-default" })
                            <button class="btn bun-bg btn-default" type="submit" name="Approved" onclick="return validateForm()" value="true">Approved</button>
                                <input type="hidden" name="Approved" value="false" />
                                <button class="btn bun-bg btn-default" type="submit" name="Rejected" onclick="return validateForm()" value="false">Rejected</button>

                        }
                    }
                </div>
            </div>
                        }

    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
}