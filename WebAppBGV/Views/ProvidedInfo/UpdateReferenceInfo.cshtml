@model dynamic
@{
    ViewBag.Title = "Update Reference Info (" + Convert.ToString(ViewBag.Name) + ")";


    string PRowid = "";
    string SId = "";
    string cId = "";
    string RejectReason = "";

    PRowid = @ViewBag.PersonalRowid;
    SId = @ViewBag.SubCheckId;
    cId = @ViewBag.clientRowId;
}
@if (ViewBag.CheckComments != "")
{
    RejectReason = @ViewBag.CheckComments;
}
@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
@*<link href="~/assets/css/icons.css" rel="stylesheet">
<div class="submit-progress hidden">
    <i class="fa fa-2x fa-spinner fa-spin"></i>
</div>*@

<div class="container">
    @using (Html.BeginForm("UpdateReferenceInfo", "ProvidedInfo", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PRowid>
        @Html.Hidden("PersonalRowid", PRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SId>
        @Html.Hidden("SubCheckId", SId.ToString())

        <input id="clientRowId" type="hidden" value=@cId>
        @Html.Hidden("clientRowId", cId.ToString())

        @Html.ValidationSummary()
        @Html.Partial("_PersonalDetails")
        @Html.Partial("_UploadedDocumentList")
        @Html.Partial("_CaseDocumentList")
        foreach (var category in Model)
        {
            <div class="row">
                @{
                    string[] nm = category.Key.Split('_');
                    if (@nm[2] == "textbox")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value.Replace("_","")' maxlength="@nm[5]">
                        </div>
                    }
                    if (@nm[2] == "dropdown")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            @{
                                string[] nmOption = nm[7].Split(',');
                            }
                            <select name=@nm[0] id=@nm[0]>
                                @for (int i = 0; i < nmOption.Length; i++)
                                {
                                    if (@nmOption[i].Trim() == @nm[6])
                                    {
                                        <option value=@nmOption[i] selected>@nmOption[i]</option>
                                    }
                                    if (@nmOption[i].Trim() != @nm[6])
                                    {
                                        <option value=@nmOption[i]>@nmOption[i]</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    if (@nm[2] == "checkbox")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            @{
                                if (@nm[6] == "TRUE")
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                }
                                else
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                }
                            }
                        </div>
                    }
                    if (@nm[2] == "fileUpload")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                        </div>
                    }
                }
            </div>
        }
        <div class="row mt-3">
            <div class="col-md-6">
                @Html.Label("Check Status", htmlAttributes: new { @class = "form-label text-right" })
            </div>
            <div class="col-md-6">
                @Html.DropDownList("CheckStatus", new List<SelectListItem>
                               { new SelectListItem{Text="Completed", Value="Completed"},
                                 new SelectListItem{Text="Insufficent", Value="Insufficent"},
                                 new SelectListItem{Text="Rejected", Value="Rejected"},
                                 new SelectListItem{Text="Review Requested", Value="Review Requested"},
                                 new SelectListItem { Text = "WIP-Pending", Value = "WIP-Pending" },
                                 new SelectListItem { Text = "Not Applicable", Value = "Not Applicable" }},
                             new { @class = "form-control", @id = "CheckStatus" })
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                @Html.Label("Comments", htmlAttributes: new { @class = "form-label" })
            </div>
            <div class="col-md-6">
                @Html.TextArea("RejectionReason", RejectReason, new { @class = "form-control", @rows = "2" })
            </div>
        </div>

        <div class="row m-5">
            <div class="col-md-6 text-center">
                <input class="btn bun-bg btn-default" type="submit" name="action" onclick="return validateRejectionForm()" value="Reject" />
            </div>
            <div class="col-md-6">
                <input class="btn bun-bg btn-default" type="submit" name="action" onclick="return validateForm()" value="Approve" />
            </div>
        </div>
    }
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () {
            if ('@TempData["Message"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Success',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["Message"].ToString()</div>'
                });
            }
            if ('@TempData["MessageRejection"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Rejection Reason',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["MessageRejection"].ToString()</div>'
                });
            }
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#NIC_Type_Id_Card').rules('add', {
                required: true,
                messages: {
                    required: "Required ID Type"

                }
            });
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <script type="text/javascript">
        function validateRejectionForm() {
            if ($("#RejectionReason").val() == '') {
                alert("Please mention the reason!");
                $('#RejectionReason').focus();
                return false;
            }
            else
            {
                $("#CheckStatus").val("Rejected");
                return true;
            }
        }

        function validateForm() {
            $("#CheckStatus").val("Approve");
            return true;
        }
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+10",

            });
        });
    </script>
}

<style>
    .btn {
        padding: 10px 40px 10px 40px !important;
    }

    .form-control {
        width: 100%;
        padding: 22px;
        border: 1px solid #ccc;
        border-radius: 0px;
        resize: vertical;
    }

    input[type=text], textarea {
        width: 100%;
        padding: 15px;
        border: 1px solid #ccc;
        border-radius: 0px;
        resize: vertical;
    }

    select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 0px;
        resize: vertical;
    }

    label {
        padding: 12px 12px 12px 0;
        display: inline-block;
    }

    input[type=submit] {
        background-color: #04AA6D;
        color: white;
        padding: 12px 20px;
        border: 1px solid #04AA6D;
        border-radius: 0px;
        cursor: pointer;
        transition: 0.3s ease-in-out;
    }

        input[type=submit]:hover {
            background: #FFF;
            color: #04AA6D;
        }

    .container {
        border-radius: 5px;
        /*background-color: #f2f2f2;*/
        padding: 8px;
        font-size: 1.2rem !important;
    }
    .submit-progress-bg {
        background-color: lightgray;
        opacity: .5;
    }

    .submit-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        z-index: 1;
        margin: auto;
        color: white;
        border-radius: 0.4em;
        box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -webkit-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .submit-progress i {
            margin-right: 0.5em;
            color: black
        }

    .hidden {
        display: none;
    }

    .fa-2x {
        font-size: 4em;
    }
</style>