

@if (@ViewBag.SpecialInstructions != null)
{
    <div class="row">
        <div class="doclist-head">
            <i class="fa fa-star" aria-hidden="true"></i>
            Special Instrucation :
        </div>
        <div class="form-group branch">
            <span class="special_instrucation">@Html.Raw( ViewBag.SpecialInstructions)</span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <hr class="docBreak" />
        </div>
    </div>
}
else if (ViewBag.PersonalBind != null)
{
    <div class="row">
        <div class="doclist-head">
            <i class="fa fa-star" aria-hidden="true"></i>
            Special Instrucation :
        </div>
        <div class="form-group branch">
            <span class="special_instrucation">@Html.Raw(ViewBag.PersonalBind.SpecialInstructions)</span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <hr class="docBreak" />
        </div>
    </div>
}

