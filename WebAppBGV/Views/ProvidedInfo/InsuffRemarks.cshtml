<script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
<script>
    function ValidateForm() {
        if ($("#CheckStatus").val() == "Funds Pending") {
            var flag = false;
            if ($("#ClientRowID").val() > 0) {
                var url = "/Verification/GetClientExtraExpensesAllowed/" + $("#ClientRowID").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (allowed) {
                        if (allowed.ExtraExpenses == 1) {
                            alert("Extra Expenses Already Accepted By Client. Please Select Another Option!");
                            flag = false;
                        }
                        else {
                            flag = true;
                        }
                    }
                });
            }
            else {
                alert("ClientId is missing please close the popup!");
                return false;
            }
            return flag;
        }
    }
</script>


