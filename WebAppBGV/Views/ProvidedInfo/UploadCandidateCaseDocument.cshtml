@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <script>
        $('#SubCheckRowID').change(function () {
            var url1 = "/ProvidedInfo/GetDocumentTypeListBySubCheckID/" + $("#SubCheckRowID").val();
            $.ajax({
                url: url1,
                type: 'GET',
                async: false,
                dataType: 'json',
                success: function (allData) {
                    if (allData != null && allData != "") {
                        $('#dvChksPcks').show();
                        var items = '';
                        jQuery.each(allData, function (index, allData) {

                            items += "<div  class='col-md-8'><label class='col-md-3 branch row name control-label'>" + allData.Text + " :</label><input type='checkbox' name='chkPkgChks'  value=" + allData.Value + " class='col-md-1'/><div class='col-md-2'><input data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + "  id=" + allData.Value + " onchange='return fileValidation(this)' accept='.png, .jpg, .jpeg, .pdf, .doc, .zip, .msg' > </div></div>";
                            });
                        $('#dvUplodDoc').html(items);
                    }
                    else {
                        $('#dvChksPcks').hide();
                        alert("No Doc Selected");
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert("some error");
                }
            });
        });

        $(document).on('change', 'input[class="chkPkgChks"]', function (e) {// on change of state
            var chkPkgChkss = '';
            $('input[class="chkPkgChks"]').each(function (index, value) {
                if (this.checked) {
                    chkPkgChkss += this.value + ',';
                    $("#" + this.value + "").removeAttr("disabled");
                }
                else {
                    $("#" + this.value + "").attr("disabled", "disabled");
                }
            });

            if (chkPkgChkss.length > 0) {
                chkPkgChkss = chkPkgChkss.substring(0, chkPkgChkss.length - 1);
            } else { chkPkgChkss = ''; }
            $('#UploadHid').val(chkPkgChkss.trim());
        });

        function fileValidation(fileInput) {
            var filePath = fileInput.value;
            var allowedExtensions = /(\.gif|\.GIF\.doc|\.docx|\.xls|\.xlsx|\.pdf|\.rtf|\.txt|\.jpeg|\.jpg|\.png|\.eml|\.email|\.msg|\.DOC|\.DOCX|\.XLS|\.XLSX|\.PDF|\.RTF|\.TXT|\.JPEG|\.JPG|\.PNG|\.EML|\.EMAIL|\.MSG|\.zip|\.ZIP|\.rar|\.RAR|\.WEBP|\.webp)$/i;
            if (!allowedExtensions.exec(filePath)) {
                alert('Please upload file having extensions .doc/.gif/.GIF/.docx/.xls/.xlsx/.pdf/.rtf/.txt/.jpeg/.jpg/.png/.eml/.email/.msg/.DOC/.DOCX/.XLS/.XLSX/.PDF/.RTF/.TXT/.JPEG/.JPG/.PNG/.EML/.EMAIL/.MSG/.ZIP/.zip/.WEBP/.webp only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }


        //=================================
        $(".delete").on("click", function () {
       debugger;
       // alert($('#hdnTeamMemberRowID').val());
        var str = $(this).attr("id").split("_");
        //console.log(str)
       var id = str[1];
       debugger;
     SubCheckRowID = 0;
       var flag = confirm('Do you want to Delete the Record ?');
       if (id != "" && flag) {
           $.ajax({
               type: "GET",
               contentType: "application/json; charset=utf-8",
               url: '@Url.Action("DeleteCandidateUploadedDocs", "ProvidedInfo")',
               data: { "id1": id, "SubCheckRowID": SubCheckRowID},
               dataType: "json",
               beforeSend: function () { },
               success: function (result) {
                   if (result == true) {
                       alert("Record Deleted Successfully!!");
                        window.location.reload();
                   }
                   else {
                       alert('There is some error');
                   }
               }
           });
       }
   });

        //====================================

    </script>
