@model List<ViewModels.ProvidedInfoViewModel.VerificationDetailModel>

@{
    ViewBag.Title = "AddCVValidation";
    Layout = null;
}

<div id="exampleModal" class="modal fade" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel" style="text-align: center; margin: auto;">
                    Add CV validation
                </h1>
            </div>

            <div class="modal-body">

                <table id="verification-table" class="table table-striped table-hover" style="text-align: center; margin: auto;">

                    @{
                        string[] dataFields =
                        {
                            "Qualification",
                            "Current Organisation Name",
                            "Tenure",
                            "Current Organisation (Previous-1)",
                            "Tenure1",
                            "Current Organisation (Previous-2)",
                            "Tenure2",
                            "Address",
                            "Check Closed Date",
                            "Mode of verification"
                        };
                    }

                    <thead>
                        <tr>
                            <th>Data Fields</th>
                            <th>Applicant Submitted Details</th>
                            <th>Resume/CV Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < dataFields.Length; i++)
                        {
                            <tr>
                                <td class="datafield">
                                    @dataFields[i]
                                </td>

                                <td class="input-col">
                                    @Html.TextBoxFor(
                                        m => m[i].ApplicantSubmittedDetails,
                                        new
                                        {
                                            @class = "form-control-custom applicant-details"
                                        })
                                </td>

                                <td class="input-col-1">
                                    @Html.TextBoxFor(
                                        m => m[i].ResumeCVDetails,
                                        new
                                        {
                                            @class = "form-control-custom resume-details"
                                        })
                                </td>

                                <td>
                                    <input type="hidden" class="personal-rowid" name="InsertCheck[@i].PersonalRowID" value="@Model[i].PersonalRowID" />
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

                <br />

                <div class="row">
                    <button type="button" id="updateAllBtn" class="btn btn-primary btn-sm" style="margin-left:496px;">
                        Add
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/Scripts/sweetalert2.all.min.js"></script>

<script>

    $(document).on("click", "#updateAllBtn", function () {

        var allData = [];

        $("#verification-table tbody tr").each(function () {

            var row = $(this);

            var rowData = {
                DataField: row.find(".datafield").text().trim(),
                ApplicantSubmittedDetails: row.find(".applicant-details").val(),
                ResumeCVDetails: row.find(".resume-details").val(),
                PersonalRowID: row.find(".personal-rowid").val(),
                ClentRowID: row.find(".Client-rowid").val(),
                SubCheckRowID: row.find(".SubCheck-rowid").val()
            };

            allData.push(rowData);
        });

        console.log(allData);

        $.ajax({
            url: '@Url.Action("InsertCVValidationCheck", "ProvidedInfo")',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(allData),

            success: function (response) {

                if (response != "500") {

                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: 'All records updated successfully.',
                        confirmButtonText: 'OK'
                    });

                } else {

                    Swal.fire({
                        icon: 'error',
                        title: 'Update Failed',
                        text: 'CV Insert failed !!!!.'
                    });
                }
            },

            error: function (xhr, status, error) {

                console.log(xhr.responseText);

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error
                });
            }
        });
    });

</script>

<style>

    #verification-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #999;
        font-family: "Times New Roman", serif;
    }

        #verification-table th,
        #verification-table td {
            border: 1px solid #999;
            padding: 4px;
            vertical-align: top;
        }

        #verification-table th {
            background-color: #f5f5f5;
            text-align: left;
            font-weight: bold;
        }

    .datafield {
        width: 15%;
        font-weight: bold;
        background-color: #f5f5f5;
    }

    .input-col {
        width: 60%;
    }

    .input-col-1 {
        width: 25%;
    }

    .form-control-custom {
        width: 100%;
        min-height: 35px;
        border: 1px solid #999;
        padding: 4px;
        box-sizing: border-box;
    }

    .modal-content {
        border-radius: 10px;
    }
</style>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            







































































































































































































































