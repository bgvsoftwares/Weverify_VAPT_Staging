                        <div class="form-group row viewborder">
                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">                                
                                    @ViewBag.AddressDetails.AV_Cand_Name                                
                            </div>
                        </div>
                    }
                    if (dispState == false)
                    {
                        if (item.FieldName == "AV_State" || item.FieldName == "AV_District" || item.FieldName == "AV_City" || item.FieldName == "AV_Pincode")
