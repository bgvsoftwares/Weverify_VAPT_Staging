                            <div class="col-md-5 col-md-offset-1">
                                <label>@item.AntecedentName</label>
                            </div>
                            <div class="col-md-6 branch">                                
                                    @ViewBag.AddressDetails.AV_OtherDetails10                                
                            </div>
                        </div>
                    }
                }                
                    <div class="form-group row viewborder">

                        @Html.LabelFor(model => model.CheckStatus, htmlAttributes: new { @class = "col-md-5 col-md-offset-1" })
                        <div class="col-md-6 branch">                            
                                @ViewBag.AddressDetails.CheckStatus                            
                        </div>
                    </div>            
              
            </div>
        }
        @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ClientRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.CheckFamilyRowID)
            @Html.HiddenFor(model => model.SubCheckRowID)
            @Html.HiddenFor(model => model.AddressRowID)
            <div class="form-group row">
                @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-5 col-md-offset-1" })
                <div class="col-md-6 branch">
                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control ", @rows = "2" })
                        @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-horizontal">
                <div class="form-group row branch"></div>
                <div class="all-button-bg">
                    @{
                        if (Session["Designation"].ToString() == "Team Leader-DE")
                        {
                            @Html.ActionLink("Back", "ManageReviewRequestedChecksForDETL", "Insuff", null, new { @class = "btn bun-bg btn-default" })
                            <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                        }
                        if (Session["Designation"].ToString() == "Team Member-DE-QC")
                        {
                            @Html.ActionLink("Back", "ManageRejectedChecksByDepTMForDEQC", "Insuff", null, new { @class = "btn bun-bg btn-default" })
                            <button class="btn bun-bg btn-default" type="submit" name="Approved" onclick="return validateForm()" value="true">Approved</button>
                            <input type="hidden" name="Approved" value="false" />

                            <button class="btn bun-bg btn-default" type="submit" name="Rejected" onclick="return validateForm()" value="false">Rejected</button>
                        }
                    }                    

                </div>
            </div>
        }
    </div>
</div>
@section Scripts{
<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
<script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
<script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });            
        });
    </script>
}
