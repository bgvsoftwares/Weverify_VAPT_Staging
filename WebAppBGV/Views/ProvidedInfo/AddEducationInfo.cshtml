    <script>
    function CopyPasteText() {
        var CopyPaste_Text = $('#CopyPaste_Text').val().replace(/[\n\r]+/g, "•");;
        if (CopyPaste_Text != '') {
            var url = "/ProvidedInfo/GetCopyPasteText?Copytext=" + CopyPaste_Text + "&CheckId=Education";
            $.ajax({
                type: 'GET',
                url: url,
                async: false,
                dataType: 'json',
                success: function (data) {
                    if (data.NameOfInstituteCollege != null) {
                        $('#CollegeName').val(data.NameOfInstituteCollege); 


                        //=========================================================================
                        var Pid = $('#PersonalRowid').val();
                        var Sid = $('#SubCheckId').val();
                        var clid = $('#clientRowId').val();
                        debugger;
                        $.ajax({
                            type: 'POST',
                            url: '/ProvidedInfo/SaveIVerifyData',
                            data: JSON.stringify({
                                PersonalRowId: Pid,
                                SubCheckRowId: Sid,
                                ClientRowId: clid,
