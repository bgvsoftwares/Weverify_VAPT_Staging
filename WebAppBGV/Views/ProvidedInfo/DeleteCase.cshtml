
@{
    ViewBag.Title = "Delete Case";
}



@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("DeleteCase", "ProvidedInfo"))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">CompanyRefNo :</label>
                                    <div class="col-md-4">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex Enter CompanyRefNo..." })
                                    </div>
                                    <label class="col-md-2 control-label">Action Remarks :</label>

                                    <div class="col-md-4">




                                        @Html.TextBox("Remarks", null, new { TextBoxMode = "MultiLine", @class = "form-control", Columns = "100px", Rows = "10px", placeholder = "Ex Enter Remarks..." })



                                    </div>

                                </div>
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" value="DeleteCase" name="SaveWork" onclick="myFunction()"/>

                                </div>

                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.ClientServiceChecks != null)

                {
                    <div class="row">
                        <div class="col-md-12">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.ClientServiceChecks, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                                    htmlAttributes: new { id = "grid", @class = "table" },
                                                    headerStyle: "thead-inverse",
                                                    rowStyle: "ordertxt",
                                                    footerStyle: "custpaging",
                                                    mode: WebGridPagerModes.All,
                                                    columns: new[]
                                                    {
                                                                                        grid.Column(header: "No.", style:"col-md-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                                                        grid.Column(columnName: "SecuritasID", header: "Company Ref No", canSort: false, style:"col-md-3"),
                                                                                        grid.Column(columnName: "CheckName", header: "Check Name", canSort: false, style:"col-md-2"),
                                                                                        grid.Column(columnName: "CheckStatus", header: "Check Status", canSort: false, style:"col-md-2"),
                                                                                        grid.Column(columnName: "orderDate", header: "Order Date", canSort: false, style:"col-md-2"),
                                                                                        grid.Column(columnName: "outDate", header: "Out Date", canSort: false, style:"col-md-2"),
                                                                                        grid.Column(columnName: "ColorName", header: "ColorName", canSort: false, style:"col-md-2"),
                                                                                        grid.Column(columnName: "Name", header: "Name", canSort: false, style:"col-md-2"),


                                                        //grid.Column("orderDate", "order Date", format: (item) => item.orderDate != DateTime.MinValue ? item.orderDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"col-md-2"),
                                                        // grid.Column(columnName: "CaseStatus", header: "Status", canSort: false, style:"col-md-1"),
                                                        //grid.Column("Remarks", canSort: false, format: (item)=> {


                                                    }
                                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <script>
        function myFunction() {
            confirm("Do you want to delete!");
        }
    </script>
}


