

@if (Model != null && Model.CaseActionHistories != null)
{
    <div class="row">
        <div class="doclist-head">
            <i class="fa fa-file-text-o" aria-hidden="true"></i>
            Case Action Histories :
        </div>
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-12">
                    @{
                        WebGrid grid = new WebGrid(rowsPerPage: 30, ajaxUpdateContainerId: "grid");
                        grid.Bind(Model.CaseActionHistories, autoSortAndPage: false, rowCount: Model.CaseActionHistories.Count);
                    }
                    @grid.GetHtml(
                                htmlAttributes: new { id = "grid", @class = "table" },
                                headerStyle: "thead-inverse",
                                rowStyle: "ordertxt",
                                footerStyle: "custpaging",
                                mode: WebGridPagerModes.All,
                                columns: new[]
                                {
                                grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                grid.Column(columnName: "CaseStatus", header: "Case Status", canSort: false, style:"col-md-2"),
                                grid.Column(columnName: "UpdatedByNameDesig", header: "UpdatedBy Name Desig", canSort: false, style:"col-md-3"),
                                grid.Column(columnName: "Remarks", header: "Remarks", canSort: false, style:"col-md-4"),
                                grid.Column("UpdatedDate", "Upload-Date", format: (item) => item.UpdatedDate != DateTime.MinValue ? item.UpdatedDate.ToString("dd/MM/yyyy hh:mm:ss tt") : "", canSort: false,style:"col-md-2"),

                                //grid.Column("Download", canSort: false, format: (item)=> {
                                //            string FldPathDoc = System.Configuration.ConfigurationManager.AppSettings["provideddocuments"].ToString();
                                //            string DownloadLink = string.Format("<a href=\"{0}\" target=\"_blank\">Download</a>",Url.Content(FldPathDoc + item.FileName));
                                //        return new HtmlString(DownloadLink);
                                //    }, style:"delete col-md-1"),
                               }
                         )
                    @*<div class="total-record">Total Records: @Model.CheckActionHistories.Count</div>*@
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <hr class="docBreak" />
        </div>
    </div>
                        }
