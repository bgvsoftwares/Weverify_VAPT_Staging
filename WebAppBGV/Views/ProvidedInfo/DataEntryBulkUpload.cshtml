
@{
    ViewBag.Title = "Data Entry Bulk Upload";
}
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("DataEntryBulkUpload", "ProvidedInfo", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                        new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                        "-- Select Client -- ",
                                        new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. UploadedBy Name.., Enter Doc and Excel Name...", @autocomplete = "off", @maxLength = "100" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Uploaded From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("UploadfromDate", null, new { @class = "form-control", @id = "UploadFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                    <label class="col-md-2 control-label">Uploaded To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("UploadToDate", null, new { @class = "form-control", @id = "UploadToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Is Initiation</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("Initiation", new SelectList(ViewBag.InitiationList, "Value", "Text"), "-- Select Initiation -- ", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <div style="text-align:center;" class="col-md-12">
                                        <input class="btn bun-bg btn-default" type="submit" value="Search" Id="btnSearch" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQClientCompany != null)
                {
                    <div class="row">
                        <div class="col-md-12 table table-striped">
                            @{
                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQClientCompany, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-2"),
                                    grid.Column("ExcelFileName", canSort: false, format: (item)=> {
                                            string FldPathDoc = System.Configuration.ConfigurationManager.AppSettings["ClientAndCompanydoc"].ToString();
                                            string DownloadLink = string.Format("<a href=\"{0}\" target=\"_blank\">{1}</a>", Url.Content(FldPathDoc + item.ExcelFileName), item.ExcelFileName);
                                              return new HtmlString(DownloadLink);
                                    }, style:"delete td-2"),
                                                  grid.Column("AttachDocName", canSort: false, format: (item)=> {
                                            string FldPathDoc = System.Configuration.ConfigurationManager.AppSettings["ClientAndCompanydoc"].ToString();
                                            string DownloadLink = string.Format("<a href=\"{0}\" target=\"_blank\">{1}</a>", Url.Content(FldPathDoc + item.AttachDocName), item.AttachDocName);
                                        return new HtmlString(DownloadLink);
                                    }, style:"delete td-2"),
                                    grid.Column(columnName: "UploadedBy", header: "Uploaded By", canSort: false, style:"td-1"),
                                    grid.Column(columnName: "IsInitiated", header: "Initiation/Non Initiation", canSort: false, style:"td-1"),
                                    grid.Column("UploadedDate", "Uploaded Date", format: (item) => item.UploadedDate != null ? item.UploadedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-2"),
                                    grid.Column(columnName: "IsInitiated",header:"Move to Initiation", canSort: false, format: (item)=> {

                                           string InitiationLink = string.Format("<a href=\"#\" id=\"MoveToInitiation_{0}\" moveTo=\"{1}\" class=\"MoveToInitiation\" >{1}</a>", item.ClientBulkUploadRowID, item.MoveTo);
                                                return new HtmlString(InitiationLink);
                                    }, style:"delete td-2"),
                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                            <div>
                                <br />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<script src="~/Scripts/sweetalert2.all.min.js"></script>
<script src="~/Scripts/normalizePlugin.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#UploadToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#UploadFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
    });
</script>

<script>
    $(document).ready(function () {
        $("#Search").val('@Model.ItemSearch.Search');
        $("#ClientRowID").val('@Model.ItemSearch.ClientRowId');
        $("#UploadfromDate").val('@Model.ItemSearch.UploadfromDate');
        $("#UploadToDate").val('@Model.ItemSearch.UploadToDate');
        $("#Initiation").val('@Model.ItemSearch.Initiation');
    });
</script>
<script>
    $("#btnSearch").click(function () {
        var obj = $('form input[type="text"]').NormalizedString();
        if (obj == false) {
            return false;
        }
    });
    $("#Search").SearchString();
</script>
<script type="text/javascript">

        $(".MoveToInitiation").on("click", function () {
            var str = $(this).attr("id").split("_");
            var MoveT = $(this).attr("moveTo");
            var id = str[1];
           // var MoveT = str1[1];

            var flag = confirm('Are you sure want to MoveToInitiation this case?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("MoveToInitiation", "ProvidedInfo")',
                    data: { "id": id, "MoveTo": MoveT},
                    dataType: "json",
                    //beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Stop Successfully!!");

                            setTimeout(function () { window.location.replace("DataEntryBulkUpload?ClientRowID=" + ClientRowID ); }, 300);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });


</script>

