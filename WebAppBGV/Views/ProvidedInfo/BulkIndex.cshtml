@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Welcome To " + ViewBag.DEDashboard;
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
}
<link href="~/Content/New_Dashboard.css" rel="stylesheet" type="text/css" />
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12 padremove">
        @{
            if (ViewBag.DEScanTeamMemberDashboard != null)
            {
                ViewModels.ProvidedInfoViewModel.DashboardDETeamMemberDEScanViewModel item = ViewBag.DEScanTeamMemberDashboard;
                <div class="row"><div class="col-md-12">&nbsp;</div></div>
                <div class="row"><div class="col-md-12">&nbsp;</div></div>

                @*<div class="right_col" role="main">*@
                <div class="row">
                    <div class="col-md-12">



                        <div class="x_panel" style="background-color:#eeeeee;color:#283747;">
                            <div class="x_content">
                                <div class="row tile_count" style="background-color:#fbfcfc">
                                    <div class="x_title col-md-12" style="text-align:center;background-color:rgba(17,201,183,0.5)">
                                        <h4><b>Case Wise | Status</b></h4>

                                        <div class="clearfix"></div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                        <a href='@Url.Action("AllocatedDEScannerBulkJob", "ProvidedInfo",new { CaseStatus=clsCommonMethods.PEncrypt("Pending"),version=clsCommonMethods.PEncrypt("New")})'>
                                            <div class="tile-stats">
                                                <div class="icon"><i class="fa fa-file-text"></i></div>
                                                <div class="count">@item.DashboardInnerNew.totPending1</div>
                                                <h4 style="padding:5px;">Pending</h4>
                                            </div>
                                        </a>
                                    </div>
                                   
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            }
        }
    </div>
</div>
