</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            $("#ddlCheckStatus").hide();
            $("#ddlCheckDetail").hide();


            //$("#Approval").hide();

            //$('#btnMoveCheck').prop('disabled', false);
            $("#ddlBillable").change(function () {

                var status = $("#ddlBillable").val();
                var RefNo = $("#SecuritasID").val();
                //var obj = {};
                //obj.Billable = status;
                //obj.companyRefNo = RefNo;
                //alert(status);
                $.ajax({
                    url: "/ClientServicing/BillableStatus",
                    //data: JSON.stringify(obj),
                    data: { Billable: status, companyRefNo: RefNo },
                    dataType: 'json',
                    //url: 'ClientServicing/BillableStatus?clientRowId=' + clientRowId,
                    method: "GET",
                    success: function (data) {
                        //alert(data.PersonalRowId);
                        $('#HfPersonalRowID').val(data.PersonalRowId);
                        $('#HfClientRowId').val(data.ClientRowId);
                        if (data.billingstatus != '') {
                            //$('#btnMoveCheck').prop('disabled', true);
                            var txt;
                            var r = confirm(data.billingstatus);
                            if (r == true) {
                                //$('#btnMoveCheck').prop('disabled', true);
                                // $("#Approval").show();
                                txt = "You pressed OK!";
                                $('#HfapproveStatus').val(true);

                            } else {
                                //$('#btnMoveCheck').prop('disabled', false);
                                //$("#Approval").hide();
                                $('#HfapproveStatus').val(false);
                                $('#ddlBillable').prop('selectedIndex', 0);
                                txt = "You pressed Cancel!";
                            }
                        }
                        else {
                            //$('#btnMoveCheck').prop('disabled', false);
                            // $("#Approval").hide();
                        }



                    },
                    error: function (data) {
                        //console.log(data);
                    }
                })
            });

            $('#Search').click(function () {
                $('#ddlAction').prop('selectedIndex', 0);
                $('#ddlBillable').prop('selectedIndex', 0);

            });


            $(function () {
                $("#ddlAction").change(function () {
                    var check = $("#ddlAction").val();
                    //alert(check);
                    if (check == 'Add Check') {

                        $("#ddlCheckStatus").show();
                        $("#ddlCheckDetail").hide();
                    }
                    else {
                        $("#ddlCheckDetail").show();
                        $("#ddlCheckStatus").hide();
                    }



                });
            });
        });
    </script>



}



