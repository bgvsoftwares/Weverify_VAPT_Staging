@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Welcome To Check Case Information For (" + Convert.ToString(Session["CandidateName"]) + ")";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "AllocatedQualityCheckJob", "ProvidedInfo", new { CaseStatus = clsCommonMethods.PEncrypt(Session["CaseStatus"].ToString()), version = clsCommonMethods.PEncrypt(Session["version"].ToString()) }, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12 padremove">
        <div class="row">
            @Html.Partial("_CaseDocumentList")
        </div>
        <div class="row">
            <div class="col-md-12">
                @Html.Partial("_CaseActionHistories")
            </div>
        </div>
        @*<div class="detail-change"><a href="#">Welcome to Case Approval Module By Quality Check Job!</a></div>*@
    </div>
</div>

@section Scripts{
    <script type="text/javascript">

    </script>
}
