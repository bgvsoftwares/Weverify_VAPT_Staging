@model dynamic

@{
    ViewBag.Title = "Edit Candidate";
    //Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Home", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    string PRowid = "";
    string SubCheckId = "";
    string cRowId = "";


    PRowid = @ViewBag.PersonalRowid;

    cRowId = @ViewBag.clientRowId;
    string CaseStatus2 = "";

    CaseStatus2 = Session["CaseStatus"].ToString();
}

@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@*@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }*@
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<div class="container">
    <div class="row">
        <div class="col-lg-2 col-md-2 col-sm-12">
            <label>Upload BGC File</label>
        </div>
        <div class="col-lg-4 col-md-4 col-sm-12">
            <input type="file" id=OCRfile name=OCRfile accept=".pdf">
        </div>
        <div class="col-lg-4 col-md-4 col-sm-12">
            <select class="form-select" id="BGCFormType">
                <option>--Select--</option>
                <option value="TCS APPLICATION FORM AND BGC FORM">TCS APPLICATION FORM AND BGC FORM</option>
                <option value="TCS BACKGROUND CHECK FORM">TCS BACKGROUND CHECK FORM</option>
                <option value="TCS EMPLOYMENT APPLICATION FORM">TCS EMPLOYMENT APPLICATION FORM</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-2 col-sm-12">
            <input type="button" class="btn" value="OCR" id="btnOCR" onclick="OCRText()" style="border:1px solid #11c9b7; color: #FFF; background: #11c9b7;" />
        </div>
    </div>

    <div id="OCRspinner" class="overlay1">
        <!-- Pop-up content -->
        <div class="popup">
            <div class="d-flex justify-content-center">
                <div class="spinner-border" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">


    @if (ViewBag.ErrorMsg != null)
    {
        <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
    }
    @using (Html.BeginForm("UpdateCandidateDetails", "ProvidedInfo", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("PersonalRowid", @PRowid)
        var cid = cRowId;
        @Html.Hidden("clientRowId", cid)
        foreach (var category in Model)
        {
            <div class="row mt-3">
                @{
                    string[] nm = category.Key.Split('_');


                    if (@nm[2] == "textbox")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                        </div>
                    }
                    else if (@nm[2] == "dropdown")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            @*<span style="color:#ff0000;"> @nm[4] </span>*@
                            @{
                                string[] nmOption = nm[7].Split(',');
                            }
                            <select name=@nm[0] id=@nm[0]>
                                @for (int i = 0; i < nmOption.Length; i++)
                                {
                                    if (@nmOption[i].Trim() == @nm[6])
                                    {
                                        <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                    }
                                    if (@nmOption[i].Trim() != @nm[6])
                                    {
                                        <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    else if (@nm[2] == "checkbox")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            @{
                                if (@nm[6] == "TRUE")
                                {
                                    <span style="color:#ff0000;"> @nm[4]</span>
                                    <input type="checkbox" id=@nm[0] name=@nm[0] value="checked" checked>
                                }
                                else
                                {
                                    <input type="checkbox" id=@nm[0] name=@nm[0] value=@nm[0]>
                                }
                            }
                        </div>
                    }
                    else if (@nm[2] == "fileUpload")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4]</span>
                            <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                        </div>
                    }
                }
            </div>
        }
        <div class="row m-5">
            <div class="col-sm-12" style="text-align:center;">
                @if (CaseStatus2 != "Closed")
                {
                    <input type="submit" class="btn" value="Submit" id="submitBtn" style="width:15rem!important;  border-radius:.90rem; font-size:1.6rem!important;" />
                }
            </div>
        </div>
    }

</div>

@section Scripts{
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () {
            if ('@TempData["Message"]' != '') {
                Swal.fire({
