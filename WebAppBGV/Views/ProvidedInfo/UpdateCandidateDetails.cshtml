    <script>
    function OCRText() {
        if ($('#OCRfile').val()) {
            const OCRspinner = document.getElementById('OCRspinner');
            OCRspinner.style.display = 'block';
            var formData = new FormData();
            formData.append("file", $('#OCRfile')[0].files[0]);
            formData.append("Pid", $('#PersonalRowid').val());
            formData.append("Cid", $('#clientRowId').val());
            formData.append("bgcF", $('#BGCFormType').val());
            $.ajax({
                url: '@Url.Action("GetDetailsfromPDF_OCR", "ProvidedInfo")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (data, textStatus, XMLHttpRequest) {
                    OCRspinner.style.display = 'none';
                    location.reload();
                    if (data.success == 1) {
                        Swal.fire({
                            title: "Success",
                            text: "Records Update Successfully",
                            icon: "success"
                        });
                    }
                    else {
                        Swal.fire({
                            title: "Success",
                            text: "Records not Update",
                            icon: "warning"
                        });
                    }

                },
                error: function (xhr, status, error) {
                    pencardspinner.style.display = 'none';
                    alert('Error uploading file: ' + error);
                }
            });            }
        else {
            pencardspinner.style.display = 'none';
            Swal.fire({
                title: "Warning",
                text: "Please upload file",
                icon: "warning"
            });
        }
    }

    </script>
