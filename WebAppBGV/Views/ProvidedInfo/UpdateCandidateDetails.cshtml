    <style>
        .spinner-border {
            width: 12rem !important;
            height: 12rem !important;
            border: .25em solid rgb(251 252 255) !important;
            border-right-color: transparent !important;
        }

        .modal-header {
            border-bottom: unset !important;
        }

        .modal-content {
            background-color: none !important;
        }


