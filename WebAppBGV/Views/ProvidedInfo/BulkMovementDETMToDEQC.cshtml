

@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Bulk Case Movements DE TM to DEQC";
}
@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string version2 = "";
    if (Request.QueryString["tatHours"] != null)
    {
        tatHours1 = Request.QueryString["tatHours"].ToString();
    }

    if (ViewBag.version != null)
    {
        version2 = ViewBag.version;
    }
    if (ViewBag.CaseStatus != null)
    {
        CaseStatus1 = ViewBag.CaseStatus;
    }
}
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("BulkMovementDETMToDEQC", "ProvidedInfo", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                             new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                             "-- Select Client -- ",
                                             new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Securitas Id...", @autocomplete = "off", @maxLength = "100" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                </div>
                                @Html.Hidden("PersonalIds", null)
                                @Html.Hidden("version", version2)
                                @Html.Hidden("CaseStatus", CaseStatus1)
                                <div class="form-group branch row search-frame">
                                    <div style="text-align:right;" class="col-md-6">
                                        <input class="btn bun-bg btn-default" type="submit" onclick="SearchFunction()" value="Search" Id="btnSearch" name="action" autofocus />
                                    </div>
                                    <div style="text-align:left;" class="col-md-6">
                                        <input class="btn bun-bg btn-default" type="submit" id="btnAllocation" onclick="return validateForm()" value="Data Entry To Data Entry QC" name="action" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.DashboardDetailsDE != null)
                {
                    <div class="row">
                        <div class="col-md-12 table table-striped">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.DashboardDetailsDE, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                           htmlAttributes: new { id = "grid", @class = "table" },
                           headerStyle: "thead-inverse",
                           rowStyle: "ordertxt",
                           footerStyle: "custpaging",
                           mode: WebGridPagerModes.All,
                           columns: new[]
                           {
                               grid.Column(header: "{checkall}",format: @<text> <input type="checkbox" value="@item.PersonalRowID" name="personalId" class="personalId" /> </text>,style:"td"),
grid.Column(header: "No.", style:"td", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td"),
grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"td"),
grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"td"),
grid.Column("CreatedDate", "Created-Date", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"col-md-2"),
grid.Column(columnName: "CaseStatus", header: "Status", canSort: false, style:"td"),
grid.Column("Check Status", canSort: false, format: (item)=> {
var link=@Html.ActionLink("Show", "ClientCheckStatus", "ClientServicing", new { CompanyRefNo=item.CompanyRefNo    }, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
return link;}, style:"td-1" ),
})
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script src="~/Scripts/normalizePlugin.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {
            $('#Search').val('@Model.ItemSearch.Search');
            $('#ClientRowID').val('@Model.ItemSearch.ClientRowId');
            $('#RecievingFromDate').val('@Model.ItemSearch.RecievingToDate');
            $('#RecievingToDate').val('@Model.ItemSearch.RecievingFromDate');
            $('#AllocateQCID').val('@Model.ItemSearch.QualityCheckId');
            $('#AllocateDEID').val('@Model.ItemSearch.DataEntryId');
            $('#AllocateDEScan').val('@Model.ItemSearch.DataEntryScannerId');
        });
        $(document).ready(function () {
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            // 1st replace first column header text with checkbox
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });
            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            //2nd click event for header checkbox for select /deselect all
            $('#select_all').change(function () {
                $('input[class="personalId"]').prop('checked', $(this).prop('checked'));
                var personalIds = '';
                $('input[class="personalId"]').each(function (index, value) {
                    if (this.checked) { personalIds += this.value + ','; }
                });
                if (personalIds.length > 0) {
                    personalIds = personalIds.substring(0, personalIds.length - 1);
                } else { personalIds = ''; }
                $('#PersonalIds').val(personalIds.trim());
            });
        });

        function SearchFunction() {
            $('#PersonalIds').val("");
        }

        //3rd click event for checkbox of each row
        $(document).on('change', 'input[class="personalId"]', function (e) {// on change of state
            var personalIds = '';
            $('input[class="personalId"]').each(function (index, value) {
                if (this.checked) { personalIds += this.value + ','; }
            });

            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("#select_all").prop('checked', false); //change "select all" checked status to false
            }
            //check "select all" if all checkbox items are checked
            if ($('.personalId:checked').length == $('.personalId').length) {
                $("#select_all").prop('checked', true);
            }

            if (personalIds.length > 0) {
                personalIds = personalIds.substring(0, personalIds.length - 1);
            } else { personalIds = ''; }
            $('#PersonalIds').val(personalIds.trim());
        })

        function validateForm() {
            if ($("#AllocateDEID").val() == 0) {
                alert("Select Data Entry Member.");
                return false;
            }

            if ($("#AllocateQCID").val() == 0) {
                alert("Select Quality Check Member.");
                return false;
            }

            if ($("#AllocateDEScan").val() == 0) {
                alert("Select DE-Scanner Member.");
                return false;
            }

            var count = 0;
            $('input[class="personalId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one Candidate.");
                return false;
            }
            return true;
        }
    </script>
    <script>
        $("#btnSearch").click(function () {
            var obj = $('form input[type="text"]').NormalizedString();
            if (obj == false) {
                return false;
            }
        });
        $("#Search").SearchString();
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#RecievingDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                //showButtonPanel: true,
                yearRange: "-66:+0",
            });
            $('#CompletedDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}

