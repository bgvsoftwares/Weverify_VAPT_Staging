    <script>
        $(document).ready(function () {
            if ('@TempData["Message"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Success',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["Message"].ToString()</div>'
                });
            }
            if ('@TempData["MessageRejection"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Rejection Reason',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["MessageRejection"].ToString()</div>'
                });
            }
        });

        $(document).ready(function () {
            function updateFormattedDate() {
                var toDate = $("#618").val();
                var fromDate = $("#619").val();

                var formattedToDate = formatIfValid(toDate);
                var formattedFromDate = formatIfValid(fromDate);

                if (fromDate && toDate) {
                    $("#36").val(formattedFromDate + " To " + formattedToDate);
                } //else {
                //    $("#36").val("");
                //}
            }

            function formatIfValid(date) {
                if (/^\d{2}-\d{2}-\d{4}$/.test(date)) {
                    var parts = date.split("-");
                    var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    var monthIndex = parseInt(parts[1], 10) - 1; // Convert month to zero-based index
                    return parts[0] + "-" + monthNames[monthIndex] + "-" + parts[2];
                }
                return date;
            }

            $("#618").on("input", updateFormattedDate);

            updateFormattedDate();
        });
    </script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            var CountryName = '@(ViewBag.CountryName)';
            var StateName = '@(ViewBag.StateName)';
            var CityName = '@(ViewBag.CityName)';

            var Countryid = '@(ViewBag.countryid)';
            var Stateid = '@(ViewBag.StateId)';
            var Cityid = '@(ViewBag.CityId)';

            if ($('#34').val() != null) {

                $.getJSON('/Master/BindCountry/', function (data) {
                    var items = '<option value="">-- Select Country --</option>';
                    $.each(data, function (i, countries) {
                        items += "<option value='" + countries.Value + "'>" + countries.Text + "</option>";
                    });
                    $('#34').html(items);
                    $("#34 option").filter(function () {
                        return this.text == CountryName;
                    }).attr('selected', true);
                    //$('#34').val($('#hdnAV_State').val());
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');

                });
            }

            if (StateName != null) {
                $.getJSON('/Master/BindState/' + Countryid, function (data) {
                    var items = '<option value="">-- Select State --</option>';
                    $.each(data, function (i, States) {
                        items += "<option value='" + States.Value + "'>" + States.Text + "</option>";
                    });
                    $('#44').html(items);
                    //$('#44').val($('#HfStateId').val());
                    $("#44 option").filter(function () {
                        return this.text == StateName;
                    }).attr('selected', true);
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');
                });
            }

            if (CityName != null) {
                $.getJSON('/Master/BindDistrict/' + Stateid, function (data) {
                    var items = '<option value="">-- Select District --</option>';
                    $.each(data, function (i, Districts) {
                        items += "<option value='" + Districts.Value + "'>" + Districts.Text + "</option>";
                    });
                    $('#32').html(items);
                    //$('#32').val($('#HfCityId').val());
                    $("#32 option").filter(function () {
                        return this.text == CityName;
                    }).attr('selected', true);
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');
                });
            }
            if ($('#hdnAV_Country').val() != null) {
                $.getJSON('/Master/BindState/' + $('#hdnAV_Country').val(), function (data) {
                    var items = '<option value="">-- Select State --</option>';
                    $.each(data, function (i, States) {
                        items += "<option value='" + States.Value + "'>" + States.Text + "</option>";
                    });
                    $('#AV_State').html(items);
                    $('#AV_State').val($('#hdnAV_State').val());
                    //$('#AV_District').val('');
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');
                });
            }
            //Bind District base on StateRowID
            if ($('#hdnAV_State').val() != null) {
                $.getJSON('/Master/BindDistrict/' + $('#hdnAV_State').val(), function (data) {
                    var items = '<option value="">-- Select District --</option>';
                    $.each(data, function (i, Districts) {
                        items += "<option value='" + Districts.Value + "'>" + Districts.Text + "</option>";
                    });
                    $('#AV_District').html(items);
                    $('#AV_District').val($('#hdnAV_District').val());
                    //$('#AV_City').val('');
                    //$('#AV_Pincode').val('');
                });
            }
            //Bind Location base on DistrictRowID
            if ($('#hdnAV_District').val() != null) {
                $.getJSON('/Master/BindLocation/' + $('#hdnAV_District').val(), function (data) {
                    var items = '<option value="">-- Select City --</option>';
                    $.each(data, function (i, Cities) {
                        items += "<option value='" + Cities.Value + "'>" + Cities.Text + "</option>";
                    });
                    $('#AV_City').html(items);
                    $('#AV_City').val($('#hdnAV_City').val());
                    //$('#AV_Pincode').val('');
                });
            }

            //PinCode Bind
            if ($("#hdnAV_City").val() == null) {
                var url = "/Master/GetPinCodeByLocationId/" + $("#hdnAV_City").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (pinCode) {
                        $('#AV_Pincode').val(pinCode);
                        //$('#AV_Pincode').val($('#hdnAV_Pincode').val());
                    }
                });
            }

            // add calender for valuemomentum
            var id = $("#clientRowId").val();
            if (id == 1680) {
                $("#619").attr("placeholder", "DD-MM-YYYY");
                $("#619").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });
                $("#618").attr("placeholder", "DD-MM-YYYY");
                $("#618").datepicker({
                    dateFormat: 'MM-yy',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: 'c-100:c+100',
                    startDate: new Date(),
                    maxDate: 0,
                    autoclose: true,
                    onSelect: function () {
                        updateDurationStay();
                    }
                });

                function updateDurationStay() {
                    var fromVal = $("#619").val();
                    var toVal = $("#618").val();

                    if (fromVal && toVal) {
                        $("#36").val(fromVal + " to " + toVal);
                    }
                }
            }
