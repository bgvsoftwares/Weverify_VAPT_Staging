
@{
    ViewBag.Title = "Update CompanyRefNo for Securitas BGV Sample Client";
    Layout = null;
}
<!DOCTYPE html>

<html>
<head>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
</head>
<body>
    <div class="branch-office row ">
        <div class="col-12">

            <h2 style="text-align:center">Update CompanyRefNo For Securitas BGV Sample Client</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-6 py-3">

            <form method="post" action="/ProvidedInfo/UpdateCompanyRefNo">
                @if (ViewBag.msg != "Updated Successfully.")
                {
                    <!-- ViewBag Field Display -->
                    <label class="form-label"><b>&nbspCompanyRefNo</b></label>
                    <input type="text" value="@ViewBag.CompanyRefNo" name="CompanyRefNo" readonly /><br /><br />

                    <!-- Text Input Field -->
                    <label class="form-label"><b>&nbspClient Name &nbsp;&nbsp;&nbsp;&nbsp;</b></label>
                    <input type="text" name="Clientname" placeholder="Please enter Client Name" maxlength="10" required /><br /> <br />

                    <input type="submit" value="Submit" style="margin-left:90px;" />
                }
                else
                {
                    <label class="form-label"><b>&nbspCompanyRefNo</b></label>
                    <input type="text" value="@ViewBag.CompanyRefNo" name="CompanyRefNo" readonly /><br /><br />
                    <b style="color: green; font-size: large; margin-left: 80px;"> @ViewBag.msg </b>
                    <br />
                }
            </form>
        </div>
    </div>
</body>
</html>

<script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

