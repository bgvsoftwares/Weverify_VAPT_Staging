@model List<ViewModels.TempViewModel.PatternDetailCheckModel>


@{
    string personalRowID = "";
    if (Request.QueryString["PersonalRowID"] != null)
    {
        personalRowID = Request.QueryString["PersonalRowID"].ToString();
    }

}


@if (ViewBag.checkDetail == "gapList" || ViewBag.checkDetail == "gaplist")
{
    if (ViewBag.data != null)
    {
        var data = ViewBag.data as List<ViewModels.TempViewModel.GapListModel>;
        int count = 1;
        <div class="panel-heading" style="background-color: #2e6da4;">
            <h2 style="text-align: center;padding: 1%;font-size: 20px!important;color: #fff;"> Gap List</h2>
        </div>
        <table class="table table-bordered border border-dark">
            <thead style="background-color: gainsboro;">
                <tr>
                    <th class="border border-dark">Gap From</th>
                    <th class="border border-dark">Gap To</th>
                    <th class="border border-dark">Remarks</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in data)
                {
                    <tr>
                        <td class="border border-dark">@item.GAPFROM <br />  (@item.GAPFROMDATE)</td>
                        <td class="border border-dark">@item.GAPTO <br /> (@item.GAPTODATE)</td>
                        <td class="border border-dark">@item.REMARKS</td>

                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="panel-heading" style="background-color: #2e6da4;">
            <h2 style="text-align: center;padding: 1%;font-size: 20px!important;color: #fff;"> Gap List</h2>
        </div>

        <div style="text-align:center; margin-top:20px">
            <h3>No Gap Record Found!</h3>
        </div>
    }
}
else
{
    <div id="repo">
        <input type="hidden" id="hdCheckName" value="@ViewBag.checkDetail" />
        <input type="hidden" id="hdPUniqueReferenceID" value="@ViewBag.PUniqueReferenceID" />
        <div class="panel-heading" style="background-color: #2e6da4;">
            <h2 style="text-align: center;padding: 1%;font-size: 20px!important;color: #fff;">Pattern Details</h2>
        </div>
        <table class="table table-bordered border border-dark">
            <thead style="background-color: gainsboro;">
                <tr>
                    <th class="border border-dark">BGV Checks</th>
                    <th class="border border-dark">Number of years</th>
                    <th class="border border-dark">Number of entities</th>
                    <th class="border border-dark">Additional Info</th>
                    <th class="border border-dark">Documents Required</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="border border-dark">@item.DISPLAYNAME</td>
                        <td class="border border-dark">@item.NOOFYEARS</td>
                        <td class="border border-dark">@item.NOOFENTITIES</td>
                        <td class="border border-dark">@item.ADDITIONALINFO</td>
                        <td class="border border-dark">@item.DOCSREQ</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="panel-footer mt-2s" style="float:right;">
            <input type="button" class="btn bun-bg btn-default" style="padding: 5px 10px 5px 10px;font-weight: bold;" value="Print" onclick="CallPrint('repo')" />
            <br />
            <input type="button" class="btn bun-bg btn-default mt-2" style="padding: 5px 10px 5px 10px;font-weight: bold;" value="Download/Upload PDF" onclick="fnUploadDocumentCheckWise()" />

        </div>
    </div>
}
