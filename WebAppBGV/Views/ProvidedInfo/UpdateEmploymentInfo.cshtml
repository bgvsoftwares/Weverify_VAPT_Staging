@model dynamic


@{
    ViewBag.Title = "Update Employment Info (" + Convert.ToString(ViewBag.Name) + ")";


    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string RejectReason = "";

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
}
@if (ViewBag.CheckComments != "")
{
    RejectReason = @ViewBag.CheckComments;
}
@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
@*<link href="~/assets/css/icons.css" rel="stylesheet">
<div class="submit-progress hidden">
    <i class="fa fa-2x fa-spinner fa-spin"></i>
</div>*@
<div class="container">
    @using (Html.BeginForm("UpdateEmploymentInfo", "ProvidedInfo", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
        @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SubCheckId>
        @Html.Hidden("SubCheckId", SubCheckId.ToString())

        <input id="clientRowId" type="hidden" value=@clientRowId>
        @Html.Hidden("clientRowId", clientRowId.ToString())
        <input type="hidden" id="OrganizationNameTemp" name="OrganizationNameTemp" />
        @Html.ValidationSummary()
        @Html.Partial("_PersonalDetails")
        @Html.Partial("_UploadedDocumentList")
        @Html.Partial("_CaseDocumentList")
        @Html.Partial("_ClientSpecialInstruction")
        foreach (var category in Model)
        {
            <div class="row mt-3">
                @{
                    string[] nm = category.Key.Split('_');

                    if (@nm[2] == "textbox")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            @if (nm[0] == "89")
                            {
                                <div>
                                    <div class="row">
                                        <div class="col-4"><span>Month</span></div>
                                        <div class="col-4"><span>Days</span></div>
                                        <div class="col-4"><span>Year</span></div>
                                    </div>
                                    <select id="month" style="width: 32.7%;">Month</select>
                                    <select id="day" style="width: 32.7%;">Days</select>
                                    <select id="year" style="width: 32.7%;">Year</select>
                                </div>
                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value.Replace("_","")' readonly="readonly" maxlength=@nm[5]>
                            }
                            else if (nm[0] == "88")
                            {
                                if (clientRowId.ToString() == "679")
                                {
                                    <div>
                                        <div class="row">
                                            <div class="col-4"><span>Month</span></div>
                                            <div class="col-4"><span>Days</span></div>
                                            <div class="col-4"><span>Year</span></div>
                                        </div>
                                        <select id="month88" style="width: 32.7%;">Month</select>
                                        <select id="day88" style="width: 32.7%;">Days</select>
                                        <select id="year88" style="width: 32.7%;">Year</select>
                                    </div>
                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value.Replace("_","")' readonly="readonly" maxlength="@nm[5]">
                                }
                                else
                                {
                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value.Replace("_","")' maxlength="@nm[5]">
                                }

                            }
                            else
                            {
                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value.Replace("_","")' maxlength=@nm[5]>
                                if (nm[0] == "92")
                                {
                                    <input type="hidden" id="OrganizationId" name="OrganizationId" value=@ViewBag.OrgId>
                                }
                            }
                        </div>

                    }
                    if (@nm[2] == "dropdown")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            @{
                                int lastindex = nm.Length;
                                string[] nmOption = nm[lastindex - 1].Split(',');
                                string Fvalue = nm[lastindex - 3].ToString();
                            }
                            <select name=@nm[0] id=@nm[0]>
                                @for (int i = 0; i < nmOption.Length; i++)
                                {
                                    if (@nmOption[i].Trim() == Fvalue)
                                    {
                                        <option selected>@nmOption[i]</option>
                                    }
                                    else
                                    {
                                        <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                    }

                                }
                            </select>
                        </div>
                    }
                    if (@nm[2] == "checkbox")
                    {
                        <div class="col-sm-6" style="padding-top:10px!important;">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-sm-2" style="padding-top:10px!important; text-align:left;">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            @{
                                if (@nm[6] == "TRUE")
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                }
                                else
                                {
                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                }
                            }
                        </div>
                    }
                    if (@nm[2] == "fileUpload")
                    {
                        <div class="col-md-6">
                            @{
                                if (@nm[3] == "mandatory")
                                {
                                    <h7 style="color:#ff0000;">*</h7>
                                }
                                else
                                {
                                    <h7>&nbsp;</h7>
                                }
                            }
                            @nm[1]
                        </div>
                        <div class="col-md-6">
                            <span style="color:#ff0000;"> @nm[4] </span>
                            <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                        </div>
                    }
                }
            </div>
        }

        <div class="row mt-3">
            <div class="col-md-6">
                @Html.Label("Comments", htmlAttributes: new { @class = "form-label" })
            </div>
            <div class="col-md-6">
                @Html.TextArea("RejectionReason", RejectReason, new { @class = "form-control", @rows = "2" })
            </div>
        </div>

        <div class="row m-5">
            <div class="col-md-6 text-center">
                <input class="btn bun-bg btn-default" type="submit" onclick="return validateRejectionForm()" value="Reject" name="action" />
            </div>
            <div class="col-md-6">
                <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Approve" name="action" />
            </div>
            @*<div class="col-md-6">
                    @Html.ActionLink("Back", "ManageQualityCheckJob", "ProvidedInfo", new { id = PersonalRowid }, new { @class = "btn bun-bg btn-default" })
                </div>*@
        </div>
    }
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () {
            if ('@TempData["Message"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Success',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["Message"].ToString()</div>'
                });
            }
            if ('@TempData["MessageRejection"]' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Rejection Reason',
                    html: '<div class="errormsg" style="text-align:center;">@TempData["MessageRejection"].ToString()</div>'
                });
            }
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });

        function validateRejectionForm() {
            if ($("#RejectionReason").val() == '') {
                alert("Please mention the reason!");
                $('#RejectionReason').focus();
                return false;
            }
            $("#CheckStatus").val("Rejected");
            return true;
        }

        function validateForm() {
            $("#CheckStatus").val("Approve");
            return true;
        }
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+10",

            });
        });
    </script>
    <script>

        $(document).ready(function () {
            const monthNames = ["", "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"];
            let qntYears = 40;
            let selectYear = $("#year");
            let selectMonth = $("#month");
            let selectDay = $("#day");
            let currentYear = new Date().getFullYear();
            var J = 0;
            for (var y = 0; y < qntYears; y++) {
                if (J == 0) {
                    let yearElem1 = document.createElement("option");
                    yearElem1.value = "";
                    yearElem1.textContent = "";
                    selectYear.append(yearElem1);

                    let yearElem2 = document.createElement("option");
                    yearElem2.value = "NA";
                    yearElem2.textContent = "NA";
                    selectYear.append(yearElem2);

                    let yearElem3 = document.createElement("option");
                    yearElem3.value = "Till Date";
                    yearElem3.textContent = "Till Date";
                    selectYear.append(yearElem3);

                    let yearElem4 = document.createElement("option");
                    yearElem4.value = "Not Provided";
                    yearElem4.textContent = "Not Provided";
                    selectYear.append(yearElem4);
                }
                let date = new Date(currentYear);
                let yearElem = document.createElement("option");
                yearElem.value = currentYear.toString();
                yearElem.textContent = currentYear.toString();
                selectYear.append(yearElem);
                currentYear--;

                J = J + 1;
            }

            for (var m = 0; m < 13; m++) {
                let month = monthNames[m];
                let monthElem = document.createElement("option");
                monthElem.value = month.toString();
                monthElem.textContent = month.toString();
                selectMonth.append(monthElem);
            }

            var d = new Date();
            var month = d.getMonth();
            var year = d.getFullYear();
            var day = d.getDate();

            //selectYear.val('');
            selectYear.on("change", AddDOL);
            //selectMonth.val('');
            selectMonth.on("change", AdjustDays);

            AdjustDays();
            selectDay.val('')

            function AdjustDays() {

                selectDay.empty();
                var yr = 2020;
                var Mnth = $("#month").val().toString();
                var date1 = 31;
                if (Mnth != "") {
                    //date1 = Date(parseInt(yr), parseInt(Mnth) + 1, 0).getDate()
                    var d = new Date(parseInt(yr), parseInt(Mnth), 0);
                    date1 = d.getDate();
                }
                for (var d = 0; d <= date1; d++) {
                    if (d == 0) {
                        var dayElem = document.createElement("option");
                        dayElem.value = "";
                        dayElem.textContent = "";
                        selectDay.append(dayElem);
                    }
                    else if (d <= 9) {
                        var dayElem2 = document.createElement("option");
                        dayElem2.value = '0' + d.toString();
                        dayElem2.textContent = '0' + d.toString();
                        selectDay.append(dayElem2);

                    }
                    else {
                        var dayElem1 = document.createElement("option");
                        dayElem1.value = d.toString();
                        dayElem1.textContent = d.toString();
                        selectDay.append(dayElem1);
                    }
                }
            }

            function AddDOL() {
                var Days = $("#day").val().toString();
                var Year = $("#year").val().toString();
                var Month = $("#month").val().toString();
                var DOLDate = "";
                if (Year != '') {
                    if (Year.toString() == "NA") {
                        DOLDate = Year.toString();
                    }
                    else if (Year.toString() == "Till Date") {
                        DOLDate = Year.toString();
                    }
                    else if (Year.toString() == "Not Provided") {
                        DOLDate = Year.toString();
                    }
                    else {
                        if (Month.toString() != "") {
                            if (Days.toString() != "") {
                                DOLDate = Days.toString() + '-' + Month.toString() + '-' + Year.toString();
                            }
                            else {
                                DOLDate = Month.toString() + '-' + Year.toString();
                            }

                        }
                    }
                }
                else {
                    DOLDate = Year.toString();
                }


                $("#89").val(DOLDate.toString());

            }
        });



