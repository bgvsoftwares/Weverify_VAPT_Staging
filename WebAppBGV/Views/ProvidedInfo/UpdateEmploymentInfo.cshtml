    <script type="text/javascript">
        $(document).ready(function () {
            $("#92").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Candidate/Home/getEmployerlistDE",
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term },
                        success: function (data) {
                            debugger;
                            response($.map(data, function (item) {
                                return { label: item.CompanyName, value: item.CompanyRowID };
                            }))
                        }
                    })
                },
                minLength: 3,
                select: function (event, ui) {
                    event.preventDefault();
                },
                focus: function (event, ui) {
                    event.preventDefault();
                    var OrgName = ui.item.label;
                    $("#92").val(OrgName);
                    $("#OrganizationNameTemp").val(OrgName);
                    $('#OrganizationId').val(ui.item.value);
                }
            });
        })

        $("#92").blur(function () {
            if ($("#92").val().trim() != $("#OrganizationNameTemp").val().trim()) {

                $("#OrganizationName").val("");
                $('#Addressofthecompany').val("");
                $('#OrganizationId').val("0");
            }
        });

        $(function () {
            $('#OrganizationName').change(function () {
                var CurOrg = $("#OrganizationName").val();
                var url = "/ProvidedInfo/EmploymentAddress/" + $("#OrganizationId").val();

                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (Address) {
                        $('#Addressofthecompany').val(Address);
                    }
                });
            });
        });

    </script>
}

<style>
    .btn {
        padding: 10px 40px 10px 40px !important;
    }

    .form-control {
        width: 100%;
        padding: 22px;
        border: 1px solid #ccc;
        border-radius: 0px;
        resize: vertical;
    }

    input[type=text], textarea {
        width: 100%;
        padding: 15px;
        border: 1px solid #ccc;
        border-radius: 0px;
        resize: vertical;
    }

    select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 0px;
        resize: vertical;
    }

    label {
        padding: 12px 12px 12px 0;
        display: inline-block;
    }

    input[type=submit] {
        background-color: #04AA6D;
        color: white;
        padding: 12px 20px;
        border: 1px solid #04AA6D;
        border-radius: 0px;
        cursor: pointer;
        transition: 0.3s ease-in-out;
    }

        input[type=submit]:hover {
            background: #FFF;
            color: #04AA6D;
        }

    .container {
        border-radius: 5px;
        /*background-color: #f2f2f2;*/
        padding: 8px;
        font-size: 1.2rem !important;
    }

    .submit-progress-bg {
        background-color: lightgray;
        opacity: .5;
    }

    .submit-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        z-index: 1;
        margin: auto;
        color: white;
        border-radius: 0.4em;
        box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -webkit-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .submit-progress i {
            margin-right: 0.5em;
            color: black
        }

    .hidden {
        display: none;
    }

    .fa-2x {
        font-size: 4em;
    }
</style>