@model dynamic
@{
    ViewBag.Title = "Add Reference Info (" + Convert.ToString(Session["CandidateName"]) + ")";
    string Department = Convert.ToString(Session["Department"]);
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = string.Empty;
    if (Request.QueryString["window"] == "TLDE")
    {
        hyperLink = Html.ActionLink("linkTitle", "ManageCandidateChecksForReportQCTM", "ProvidedInfo", new { PersonalRowID = @ViewBag.PersonalRowid, dispFor = "TeamMember" }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
    //string hyperLink = Html.ActionLink("linkTitle", "ManageDataEntryJob", "ProvidedInfo", new { id = Model.PersonalRowID, CheckstatusId = Model.CheckStatusId }, new { @class = "headerbacklink" }).ToString();
    //ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string checkstatusid = "";
    string CaseStatus2 = "";

    CaseStatus2 = Session["CaseStatus"].ToString();

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    checkstatusid = @ViewBag.checkstatusid;

}
@section LeftNavigation{ @Html.Partial("_NavLeftDataEntryProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
@if (ViewBag.ErrorMsg != null)
{
    <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
}

<div class="container">
    @using (Html.BeginForm("AddReferenceInfo", "ProvidedInfo", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
        @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SubCheckId>
        @Html.Hidden("SubCheckId", SubCheckId.ToString())

        <input id="clientRowId" type="hidden" value=@clientRowId>
        @Html.Hidden("clientRowId", clientRowId.ToString())

        @Html.ValidationSummary()
        @Html.Partial("_PersonalDetails")
        @Html.Partial("_UploadedDocumentList")
        @Html.Partial("_CaseDocumentList")
        @Html.Partial("_ClientSpecialInstructionsDE")
        <div class="container">
            <div class="row">
                <div class="col-lg-2 col-md-2 col-sm-12">
                    <label>Copy Paste Text</label>
                </div>
                <div class="col-lg-7 col-md-7 col-sm-12">
                    <textarea class="form-control" id="CopyPaste_Text"></textarea>
                </div>
                <div class="col-lg-2 col-md-2 col-sm-12">
                    <input type="button" class="btn" value="Paste" id="btnCopyPaste" onclick="CopyPasteText()" style="border:1px solid #11c9b7; color: #FFF; background: #11c9b7;" />
                </div>
            </div>
        </div>
        //
        //if (clientRowId != "1255")
        //{
            <div class="row row-sm p-2 mt-2 ms-5" id="NADiv" style="background:#11c9b7; margin:5px 20px 5px 20px;padding: 3px 0px;">
                <div class="col-md-12 d-flex pr-0">
                    @Html.CheckBox("Notraised", false, new { onchange = "NotRaised(this)", @class = "form-check-input", @style = "height: 20px;width:20px;margin: 0px 5px;" })<b style="color:white;padding-left:30px;font-size:1.3rem;">Not Applicable</b>
                </div>
            </div>
      //  }

        //
        <div class="container" id="container">
            <div class="container-fluid mb-2 p-0" id="top_div">
                @foreach (var category in Model)
                {
                    <div class="row row-sm mt-3">
                        @{
                            string[] nm = category.Key.Split('_');

                            if (@nm[2] == "textbox")
                            {
                                <div class="col-md-6 col-sm-6">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <p>@nm[4]</p>
                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                </div>
                            }
                            if (@nm[2] == "dropdown")
                            {
                                <div class="col-md-6 col-sm-6">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <span> @nm[4]</span>
                                    @{
                                        string[] nmOption = nm[7].Split(',');
                                    }
                                    <select name=@nm[0] id=@nm[0]>
                                        @for (int i = 0; i < nmOption.Length; i++)
                                        {
                                            if (@nmOption[i].Trim() == @nm[6])
                                            {
                                                <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                            }
                                            if (@nmOption[i].Trim() != @nm[6])
                                            {
                                                <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                            }
                                        }
                                    </select>
                                </div>
                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="col-md-6 col-sm-6">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <span>@nm[4]</span>
                                    @{
                                        if (@nm[6] == "TRUE")
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                        }
                                        else
                                        {
                                            <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                        }
                                    }
                                </div>
                            }
                            if (@nm[2] == "fileUpload")
                            {
                                <div class="col-md-6 col-sm-6">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <span>@nm[4]</span>
                                    <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                </div>
                            }
                        }
                    </div>

                }
                @if ((clientRowId == "321" || clientRowId == "553" || clientRowId == "974" || clientRowId == "324" && checkstatusid == "8") && (checkstatusid != "69"))
                {
                    <div class="row row-sm mt-3">
                        <div class="col-md-6 col-sm-6">
                            @Html.Label("Check Status", htmlAttributes: new { @class = "control-label text-right" })
                        </div>
                        <div class="col-md-6 col-sm-6">
                            @Html.DropDownList("CheckStatus", new List<SelectListItem>
                   {
                     new SelectListItem { Text = "YTR", Value = "YTR" }},
                     new { @class = "form-control", @id = "CheckStatus" })
                        </div>
                    </div>
                }
                else
                {
                    <div class="row row-sm mt-3">
                        <div class="col-md-6 col-sm-6">
                            @Html.Label("Check Status", htmlAttributes: new { @class = "control-label text-right" })
                        </div>
                        @if (@ViewBag.clientRowId == "990")
                        {
                            <div class="col-md-6 col-sm-6">
                                @Html.DropDownList("CheckStatus", new List<SelectListItem>
                       { new SelectListItem{Text="Completed", Value="Completed"},
                         new SelectListItem{Text="Insufficent", Value="Insufficent"},
                         new SelectListItem{Text="Rejected", Value="Rejected"},
                         new SelectListItem{Text="Review Requested", Value="Review Requested"},
                         new SelectListItem { Text = "WIP-Pending", Value = "WIP-Pending" },
                         new SelectListItem { Text = "YTR", Value = "YTR" }},
                           new { @class = "checkStatus", @id = "CheckStatus" })
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6 col-sm-6">
                                @Html.DropDownList("CheckStatus", new List<SelectListItem>
                   { new SelectListItem{Text="Completed", Value="Completed"},
                     new SelectListItem{Text="Insufficent", Value="Insufficent"},
                     new SelectListItem{Text="Rejected", Value="Rejected"},
                     new SelectListItem{Text="Review Requested", Value="Review Requested"},
                     new SelectListItem { Text = "WIP-Pending", Value = "WIP-Pending" },
                     new SelectListItem { Text = "YTR", Value = "YTR" },
                     new SelectListItem { Text = "Not Applicable", Value = "Not Applicable" }},
                     new { @class = "checkStatus", @id = "CheckStatus" })
                            </div>
                        }
                    </div>
                }
                <div class="row row-sm mt-3">
                    <div class="col-md-6 col-sm-6">Check Remark</div>
                    <div class="col-md-6 col-sm-6">
                        <select name="CheckRemarks" id="datalist"></select>
                    </div>
                </div>
                <div class="row row-sm mt-3">
                    <div class="col-md-6 col-sm-6">@Html.Label("INFRemarks", htmlAttributes: new { @class = "control-label" })</div>
                    <div class="col-md-6 col-sm-6">
                        @Html.TextArea("INFRemarks", new { @class = "form-control ", @rows = "2", @disabled = "disabled" })
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-12" style="text-align:center; justify-content:center;display:flex; margin-top:10px;">
                        @if (CaseStatus2 != "Closed" && checkstatusid != "1")
                        {
                            <input id="WithQcval" name="WithQcval" value="" hidden />
                            <input type="submit" value="Submit" style="width:15rem!important; border-radius:.90rem; font-size:1.6rem!important;" onclick="validateForm()" />
                            <div class="w-100 d-flex justify-content-end">
                                <input class="btn" type="submit" id="SubmitWithQC" style="width: 19rem !important; margin-left: 15PX; border-radius: .90rem; font-size: 1.6rem !important" value="SubmitWithQC" onclick="validateFormWithQc()" disabled />
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="container-fluid mt-2 p-0" id="bottom_div">
                <div class="row h-100">
                    <div class="col-md-12">
                        <img id="bigpic" src="" style="display:none;height:100%; width:100%;" />
                        <iframe id="bigpdf" src="" style="display: none; height: 100%; width: 100%;"></iframe>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

    <script>

        function showPicture(url) {
            var sourceOfPicture = url + '?embedded = true';
            var exe = getExtension(url);
            //var url1 = Url.Content(url);
            if (exe = 'pdf') {
                var img = document.getElementById('bigpdf');
                img.src = sourceOfPicture.replace('90x90', '225x225');
                img.style.display = "block";
            }
            else {
                var img = document.getElementById('bigpic')
                img.src = sourceOfPicture.replace('90x90', '225x225');
                img.style.display = "block";
            }

        }
        function getExtension(path) {
            var basename = path.split(/[\\/]/).pop(),  // extract file name from full path ...
                // (supports `\\` and `/` separators)
                pos = basename.lastIndexOf(".");       // get last position of `.`

            if (basename === "" || pos < 1)            // if file name is empty or ...
                return "";                             //  `.` not found (-1) or comes first (0)

            return basename.slice(pos + 1);            // extract extension ignoring `.`
        }


    </script>

    <script>
        $('#CheckStatus').change(function () {
            debugger
            $("#datalist").empty();
            var Curlist = $("#CheckStatus").val();

            if (Curlist == "Insufficent") {
                $('#vs').css('display', 'flex');
                var url = "/ProvidedInfo/GetCandidatesRemarks/"
                $.ajax({
                    type: 'GET',
                    url: url,
                    data: {
                        clientRowId: $("#clientRowId").val(),
                        subCheckId: $("#SubCheckId").val()
                    },
                    //dataType: 'json',
                    success: function (data) {
                        //$('#vs').css('display', 'flex');
                        var items = '<option>--Select Remarks--</option>';
                        $.each(data, function (Remarks, val) {
                            items += "<option value='" + val.Remarks + "'>" + val.Remarks + "</option>";
                        });
                        if ($("#clientRowId").val() != "576") {
                            items += '<option>Other</option>';
                        }                        
                        $("#datalist").append(items);
                        if ($("#clientRowId").val() == "576" && data.length == 1) {

                            $("#datalist").val(data[0].Remarks);

                            // Fire the existing change event
                            $("#datalist").trigger("change");
                        }
                    }
                });

            }
            else {
                $('#vs').css('display', 'none');
            }
        });
    </script>
    <script>
        $('#datalist').change(function () {
            if ($('#datalist').val() == 'Other') {
                $('#INFRemarks').val('')
                document.getElementById("INFRemarks").placeholder = "Write Other Remarks...";
            }
            else { $('#INFRemarks').val($('#datalist').val()); }
        });
    </script>


    <script>
        function CopyPasteText() {
            var CopyPaste_Text = $('#CopyPaste_Text').val().replace(/[\n\r]+/g, "•");;
            if (CopyPaste_Text != '') {
                var url = "/ProvidedInfo/GetCopyPasteText?Copytext=" + CopyPaste_Text + "&CheckId=reference";
                $.ajax({
                    type: 'GET',
                    url: url,
                    async: false,
                    dataType: 'json',
                    success: function (data) {
                        if (data.RelationshipType != "") {
                            $('#160').val(data.RelationshipType);

                        }
                        if (data.NameofOrganisation != "") {
                            $('#107').val(data.NameofOrganisation);

                        }
                        if (data.ReferenceEmailID != "") {
                            $('#111').val(data.ReferenceEmailID);

                        }
                        if (data.ReferenceContactNumber != "") {
                            $('#177').val(data.ReferenceContactNumber);

                        }
                        if (data.ReferenceName != "") {
                            $('#109').val(data.ReferenceName);

                        }
                    },
                    error: function (xhr, status, error) {
                        //console.error(xhr, status, error);
                    }
                });
            }
        }
    </script>


    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
                $("#INFRemarks").prop("disabled", false);
            }
            else {
                $("#INFRemarks").prop("disabled", true);
            }
            if ($("#CheckStatus").val() == "Completed") {
                $("#SubmitWithQC").prop("disabled", false);

            } else {
                $("#SubmitWithQC").prop("disabled", true);
            }
        });
        $(function () {
            $("#CheckStatus").change(function () {
                if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
                    $("#INFRemarks").prop("disabled", false);
                    $('#INFRemarks').focus();
                }
                else {
                    $("#INFRemarks").prop("disabled", true);
                }
                if ($("#CheckStatus").val() == "Completed") {
                    $("#SubmitWithQC").prop("disabled", false);

                } else {
                    $("#SubmitWithQC").prop("disabled", true);
                }
            });
        });

        function validateForm() {
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected") {
                if ($("#INFRemarks").val().trim() == '') {
                    alert("Please mention the reason!");
                    $('#INFRemarks').focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    const infRemarks = $("#INFRemarks").val().trim();
                    if (infRemarks.length < 15) {
                        alert("Please provide a reason that is at least 15 characters long!");
                        $('#INFRemarks').focus();
                        event.preventDefault();
                        return false;
                    }
                    return true;
                }
            }
        }
        function validateFormWithQc() {
            $('#WithQcval').val('SubmitWithQCApprove')
            return true;
        }


    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+10",
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });
        });
    </script>

    <script>
        function NotRaised(element) {
            if ($('#Notraised').is(':checked')) {
                $("#382").attr('checked', true);
                $("#109").val('Not Applicable');
                $("#107").val('Not Applicable');
                $("#177").val('Not Applicable');
                $("#111").val('Not Applicable');
                $("#189").val('Not Applicable');
                $("#CheckStatus").val('Not Applicable');
            }
            else {
                $("#382").attr('checked', false);
                $("#178").val('');
                $("#117").val('');

                $("#CheckStatus").val('');

            }

        }
    </script>
    <script>
        $(".docShow").click(function () {
            $("#top_div").addClass("topdiv");
            $("#bottom_div").addClass("bottomdiv");
        });
    </script>
}
