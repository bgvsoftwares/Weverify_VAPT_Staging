    <script type="text/javascript">
        $(document).ready(function () {
            $("#OrganizationName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Candidate/Home/getEmployerlistDE",
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.CompanyName, value: item.CompanyRowID };
                            }))
                        }
                    })
                },
                minLength: 3,
                select: function (event, ui) {
                    event.preventDefault();
                },
                focus: function (event, ui) {
                    event.preventDefault();
                    var OrgName = ui.item.label;
                    $("#OrganizationName").val(OrgName);
                    $("#OrganizationNameTemp").val(OrgName);
                    $('#OrganizationId').val(ui.item.value);
                }
            });
        })

        $("#OrganizationName").blur(function () {
            if ($("#OrganizationName").val().trim() != $("#OrganizationNameTemp").val().trim()) {

                $("#OrganizationName").val("");
                $('#Addressofthecompany').val("");
                $('#OrganizationId').val("0");
            }
        });

        $(function () {
            $('#OrganizationName').change(function () {
                var CurOrg = $("#OrganizationName").val();
                var url = "/ProvidedInfo/EmploymentAddress/" + $("#OrganizationId").val();

                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (Address) {
                        $('#Addressofthecompany').val(Address);
                    }
                });
            });
        });

    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            if (($("#89").val().toString() == "Till Date") && (CaseStatus2 == "Received")) {
                $("#CheckStatus").prop("disabled", true);
                $("#CheckStatus").val("YTR");  
            }
            else {}
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
                $("#INFRemarks").prop("disabled", false);
            }
            else {
                $("#INFRemarks").prop("disabled", true);
            }


            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
