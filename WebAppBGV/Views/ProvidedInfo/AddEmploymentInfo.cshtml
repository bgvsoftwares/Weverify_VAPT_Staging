        $(function () {



            $("#CheckStatus").change(function () {
                if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
                    $("#INFRemarks").prop("disabled", false);
                    $('#INFRemarks').focus();
                }
                else {
                    $("#INFRemarks").prop("disabled", true);
                }

                if ($("#CheckStatus").val() == "Completed") {
                    $("#SubmitWithQC").prop("disabled", false);
                 
                } else {
                    $("#SubmitWithQC").prop("disabled", true);
                }
            });
        });

        function validateForm() {
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
                if ($("#INFRemarks").val().trim() == '') {
                    alert("Please mention the reason!");
                    $('#INFRemarks').focus();
                    return false;
                }
            }
            return true;
        }

        function validateFormWithQc() {
            $('#WithQcval').val('SubmitWithQCApprove')
            return true;
        }

        function validateForm() {
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected") {
                if ($("#INFRemarks").val().trim() == '') {
                    alert("Please mention the reason!");
                    $('#INFRemarks').focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    const infRemarks = $("#INFRemarks").val().trim();
                    if (infRemarks.length < 15) {
                        alert("Please provide a reason that is at least 15 characters long!");
                        $('#INFRemarks').focus();
                        event.preventDefault();
                        return false;
                    }
                    return true;
                }
            }
        }

        function validateApproveForm() {
            if ($("#CheckStatus").val() == "Insufficent" || $("#CheckStatus").val() == "Rejected" || $("#CheckStatus").val() == "Review Requested") {
                if ($("#INFRemarks").val().trim() == '') {
                    alert("Please mention the reason!");
                    $('#INFRemarks').focus();
                    return false;
                }
            }
            else {
                $("#CheckStatus").val("Approve");
                return true;
            }
            return true;
        }
    </script>
