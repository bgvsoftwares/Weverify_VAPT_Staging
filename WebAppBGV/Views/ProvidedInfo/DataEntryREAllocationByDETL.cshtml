@{
    ViewBag.Title = "Candidate Allocation To Data Entry And Quality Check";
}
@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatHours"] != null)
    {
        tatHours1 = Request.QueryString["tatHours"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CaseStatus"] != null)
    {
        CaseStatus1 = @Request.QueryString["CaseStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExcelExportREAllocationByDETL", "ProvidedInfo", new { CaseStatus = "REAllocationByDETL" }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

   
}
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("DataEntryREAllocationByDETL", "ProvidedInfo", FormMethod.Post))
                        {@Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                        new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                        "-- Select Client -- ",
                                        new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Search By :</label>
                                    <div class="col-md-2">
                                        @Html.RadioButton("SearchType", "Keyword", true, new { @class = "Keyword" }) Candidate
                                    </div>
                                    <div class="col-md-2">
                                        @Html.RadioButton("SearchType", "TeamMember", new { @class = "TeamMember" }) Team Member
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Securitas Id..." })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Data Entry Scanner :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("AllocateDEScan",
                                        new SelectList(ViewBag.DEScanTeamMembers, "TeamMemberRowID", "TeamMemberName"),
                                        "-- Select Member -- ",
                                        new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Data Entry :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("AllocateDEID",
                                        new SelectList(ViewBag.DETeamMembers, "TeamMemberRowID", "TeamMemberName"),
                                        "-- Select Member -- ",
                                        new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Quality Check :</label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("AllocateQCID",
                                        new SelectList(ViewBag.DEQCTeamMembers, "TeamMemberRowID", "TeamMemberName"),
                                        "-- Select Member -- ",
                                        new { @class = "form-control" })
                                    </div>
                                    <label class="col-md-2 control-label">Module Name: </label>
                                    <div class="col-md-3">
                                        @Html.DropDownList("EntityType", new SelectList(ViewBag.EntityTypeList, "Value", "Text"), "-- Select EntityType -- ", new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                @Html.Hidden("PersonalIds", null)
                                <div class="form-group branch row search-frame">
                                    <div style="text-align:center;" class="col-md-12">
                                        <input class="btn bun-bg btn-default" type="submit" onclick="SearchFunction()" value="Search" />
                                        <input class="btn bun-bg btn-default" type="submit" id="btnAllocation" onclick="return validateForm()" value="Allocate" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQPersonalInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12  table table-responsive table-striped">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQPersonalInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "{checkall}",format: @<text> <input type="checkbox" value="@item.PersonalRowID" name="personalId" class="personalId" /> </text>,style:"col-md-"),
                                    grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "Name", header: "Candidate Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "AllocatedToDEScanName", header: "Allocated Scanner", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "AllocatedToDEName", header: "Allocated DE", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "AllocatedToDEQCName", header: "Allocated DEQC", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "ModuleType", header: "Entity Type", canSort: false, style:"col-md-2"),
                                    grid.Column("CreatedDate", "Created-Date", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"col-md-1"),
                                    grid.Column(header : "Action", format : (item) => {
                                        var link = Html.ActionLink("History", "CaseActionHistories", "ReportQC", new { pid = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement" });
                                        return link;
                                    }, style:"edit col-md-1"),
                                }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>*@

    <script type="text/javascript">

         $(document).ready(function () {
            $('#Search').val('@Model.ItemSearch.Search');
            $('#ClientRowID').val('@Model.ItemSearch.ClientRowId');
            $('#RecievingFromDate').val('@Model.ItemSearch.RecievingToDate');           
             $('#RecievingToDate').val('@Model.ItemSearch.RecievingFromDate');           
            $('#AllocateQCID').val('@Model.ItemSearch.QualityCheckId');
            $('#AllocateDEID').val('@Model.ItemSearch.DataEntryId');
            $('#AllocateDEScan').val('@Model.ItemSearch.DataEntryScannerId');
        });


        $(document).ready(function () {

            $('input[class="Keyword"]').on('change', function () {
                var search1 = $('input[id=Keyword]:checked').val()
                if (search1 == Keyword) {
                    $('#TeamMember').prop("checked", false);
                    $('#Keyword').prop("checked", true);
                }
                else {
                    $('#TeamMember').prop("checked", true);
                    $('#Keyword').prop("checked", false);
                }

            });
            // 1st replace first column header text with checkbox
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });

            //2nd click event for header checkbox for select /deselect all
            $('#select_all').change(function () {
                $('input[class="personalId"]').prop('checked', $(this).prop('checked'));
                var personalIds = '';
                $('input[class="personalId"]').each(function (index, value) {
                    if (this.checked) { personalIds += this.value + ','; }
                });
                if (personalIds.length > 0) {
                    personalIds = personalIds.substring(0, personalIds.length - 1);
                } else { personalIds = ''; }
                $('#PersonalIds').val(personalIds.trim());
            });
        });

        function SearchFunction() {
            $('#PersonalIds').val("");
        }

        //3rd click event for checkbox of each row
        $(document).on('change', 'input[class="personalId"]', function (e) {// on change of state
            var personalIds = '';
            $('input[class="personalId"]').each(function (index, value) {
                if (this.checked) { personalIds += this.value + ','; }
            });

            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("#select_all").prop('checked', false); //change "select all" checked status to false
            }
            //check "select all" if all checkbox items are checked
            if ($('.personalId:checked').length == $('.personalId').length) {
                $("#select_all").prop('checked', true);
            }

            if (personalIds.length > 0) {
                personalIds = personalIds.substring(0, personalIds.length - 1);
            } else { personalIds = ''; }
            $('#PersonalIds').val(personalIds.trim());
        })

        function validateForm() {
            var selectedTeam = false;
            if ($("#AllocateDEID").val() > 0) {
                selectedTeam = true;
            }

            if ($("#AllocateQCID").val() > 0) {
                selectedTeam = true;
            }

            if ($("#AllocateDEScan").val() > 0) {
                selectedTeam = true;
            }

            if (selectedTeam == false) {
                alert("Select atleast one member.");
                return false;
            }

            var count = 0;
            $('input[class="personalId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one Candidate.");
                return false;
            }
            return true;
        }
    </script>

    <script type="text/javascript">
        $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });

        $(document).ready(function () {
            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}

