@{
    ViewBag.Title = "Allocated Quality Check Job";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
}
@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    string version = "";
    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    CaseStatus1 = ViewBag.CaseStatus;
    tatHours1 = ViewBag.tatHours;
    version = ViewBag.version;
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExcelExportDEQC", "ProvidedInfo", new { CaseStatus = CaseStatus1, tatHours = tatHours1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AllocatedQualityCheckJob", "ProvidedInfo", FormMethod.Post))
                        {@Html.AntiForgeryToken()
                        <div class="form-horizontal">
                            <div class="form-group branch row search-frame">
                                <label class="col-md-2 control-label">Client Name :</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("ClientRowID",
                                    new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                    "-- Select Client -- ",
                                    new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="form-group branch row search-frame">
                                <label class="col-md-2 control-label">Search By :</label>
                                <div class="col-md-2">
                                    @Html.RadioButton("SearchType", "Keyword", true, new { @class = "Keyword" }) Candidate
                                </div>
                                <div class="col-md-2">
                                    @Html.RadioButton("SearchType", "TeamMember", new { @class = "TeamMember" }) Team Member
                                </div>
                            </div>
                            <div class="form-group branch row search-frame">
                                <label class="col-md-2 control-label">Keyword :</label>
                                <div class="col-md-8">
                                    @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No...", @autocomplete = "off", @maxLength = "100" })
                                </div>
                            </div>
                            <div class="form-group branch row search-frame">
                                <label class="col-md-2 control-label">Recieving From Date :</label>
                                <div class="col-md-3">
                                    @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                </div>
                                <label class="col-md-2 control-label">Recieving To Date :</label>
                                <div class="col-md-3">
                                    @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                </div>
                            </div>
                            <div class="form-group branch row search-frame">
                                <label class="col-md-2 control-label">Completed From Date :</label>
                                <div class="col-md-3">
                                    @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                </div>
                                <label class="col-md-2 control-label">Completed To Date :</label>
                                <div class="col-md-3">
                                    @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                </div>
                            </div>

                            <div class="form-group branch row search-frame">
                                <label class="col-md-2 control-label">  Fetch Senior Profile:</label>

                                <div class="col-md-8">
                                    @*@Html.Hidden("fetchDataCheckbox", "false")
                                        <input type="checkbox" name="fetchDataCheckbox" value="true" id="fetchDataCheckbox" />*@
                                    <input type="checkbox" id="fetchDataCheckbox" />
                                    <input type="hidden" name="fetchDataCheckbox" id="fetchDataCheckboxHidden" value="false" />
                                </div>
                            </div>
                            <div class="form-group branch row search-frame">
                                <div style="text-align:center;" class="col-md-12">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" id="btnSearch" />
                                </div>
                            </div>
                        </div>
                        if (ViewBag.CaseStatus != null)
                        {
                            @Html.Hidden("CaseStatus", CaseStatus1.ToString())
                        }
                        if (ViewBag.tatHours != null)
                        {
                            @Html.Hidden("tatHours", tatHours1)
                        }
                        if (ViewBag.version != null)
                        {
                            @Html.Hidden("version", version)
                        }
                    }
                    </div>
                </div>
                @if (Model != null && Model.PQPersonalInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table">
                            @{
                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQPersonalInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                            htmlAttributes: new { id = "grid", @class = "table" },
                            headerStyle: "thead-inverse",
                            rowStyle: "ordertxt",
                            footerStyle: "custpaging",
                            mode: WebGridPagerModes.All,
                            columns: new[]
                            {
                            grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                            grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-2"),
                              grid.Column(columnName: "IsSeniorCase", header: "IsSeniorCase", canSort: false, style:"td-3"),
                            grid.Column(columnName: "CompanyRefNo", header: "Company Ref No", canSort: false, style:"td-1"),
                            grid.Column(columnName: "Name", header: "Candidate Name", canSort: false, style:"td-2"),
                            grid.Column(columnName: "AllocatedToDEScanName", header: "DE-Scanner", canSort: false, style:"td-1"),
                            grid.Column(columnName: "AllocatedToDEName", header: "DE-TM", canSort: false, style:"td-1"),
                            grid.Column(columnName: "CaseStatus", header: "Status", canSort: false, style:"td-1"),
                            grid.Column("Remarks", canSort: false, format: (item)=> {
                            if ((item.CaseStatus=="Insuff" && !string.IsNullOrEmpty(item.CaseStatus))||(item.CheckStatusId=="42"))
                            {


                            var link=@Html.ActionLink("Remarks", "InsuffRemarks", "ProvidedInfo", new { PersonalRowID = item.PersonalRowID ,SubCheckRowID = item.SubCheckRowID,processName="L1-Insuff-QC_Approval" }, new { @class = "iframeUpdateStatus cboxElement callbacks ", @id = "VerificationActionHistostry" });
                            return link;
                            }
                            return null;
                            }, style:"td-1" ),
                            grid.Column(header : "", format : (item) => {
                            if((item.DEQCCaseStatus!="Completed-QC" ||item.CheckStatusId==68) &&  item.CheckStatusId!="0" )
                            {
                            var link = Html.ActionLink("QC Data", "ManageQualityCheckJob", "ProvidedInfo", new { id = item.EPersonalRowID,CheckStatusId = item.ECheckStatusId,ClientRowid=item.EClientRowID }, null);
                            return link;
                            }
                            else
                            {
                            return "";
                            }
                            }, style:"edit td-1"),

                            grid.Column("", canSort: false, format: (item)=> {
                            if(item.DEQCCaseStatus=="Completed-DE" && item.DEQCCaseStatus!="Completed-QC")
                            {
                            string DeleteLink = string.Format("<a href=\"#\" id=\"Complete_{0}\" class=\"Complete\">{1}</a>", item.PersonalRowID, "Complete");
                            return new HtmlString(DeleteLink);
                            }
                            else
                            {
                            return "";
                            }
                            }, style:"td-1")

                            }
                            )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script src="~/Scripts/normalizePlugin.js"></script>
}


<script>
    document.getElementById("fetchDataCheckbox").addEventListener("change", function () {
        document.getElementById("fetchDataCheckboxHidden").value = this.checked;
    });
</script>
<script type="text/javascript">

     $(document).ready(function () {
            $('#Search').val('@Model.ItemSearch.Search');
            $('#ClientRowID').val('@Model.ItemSearch.ClientRowId');
            $('#RecievingFromDate').val('@Model.ItemSearch.RecievingToDate');
            $('#CompletedFromDate ').val('@Model.ItemSearch.CompletedToDate' );
            $('#RecievingToDate').val('@Model.ItemSearch.RecievingFromDate');
            $('#CompletedToDate').val('@Model.ItemSearch.CompletedFromDate');
        });


        $(".Complete").on("click", function () {
            var str = $(this).attr("id").split("_");
            id = str[1];

            var flag = confirm('Are you sure to complete this case?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("CompletedDEQualityCheckJobs", "ProvidedInfo")',
                    data: { "id": id },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("This case has been completed successfully!!");
                            setTimeout(function () { window.location.replace("AllocatedQualityCheckJob"); }, 500);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });
</script>
<script type="text/javascript">
    $(document).ready(function () {
        $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
        //Incentive Instruction
        $('input[class="Keyword"]').on('change', function () {
            var search1 = $('input[id=Keyword]:checked').val()
            if (search1 == Keyword) {
                $('#TeamMember').prop("checked", false);
                $('#Keyword').prop("checked", true);
            }
            else {
                $('#TeamMember').prop("checked", true);
                $('#Keyword').prop("checked", false);
            }

        });

        $('#RecievingToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#RecievingFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
    });
</script>

<script>
    $("#btnSearch").click(function () {
        var obj = $('form input[type="text"]').NormalizedString();
        if (obj == false) {
            return false;
        }
    });
    $("#Search").SearchString();
</script>
<script>
    $("#grid > thead > tr").each(function () {
        $(this).find('th').each(function (index) {
            // Check if the header text is "checkFackEdu"
            if ($(this).text().trim() === "IsSeniorCase") {
                // Hide the corresponding column header
                $(this).css("display", "none");

                // Now hide the corresponding cells (td) in the body for that column
                $("#grid > tbody > tr").each(function () {
                    $(this).find('td').eq(index).css("display", "none");
                });
            }
        });
    });
</script>
<script>
    $('#grid > tbody > tr').each(function () {
        var sixthTdValue = $(this).find('td:nth-child(3)').text();
        if (sixthTdValue == "1") {
            $(this).css('background-color', '#ffbf80');
        }
        else {
            //$(this).css('background-color', '#f2f2f2');
        }
    });
</script>





