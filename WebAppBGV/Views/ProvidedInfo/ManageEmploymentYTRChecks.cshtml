@{
    ViewBag.Title = "Manage Employment YTR Checks";
}
@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatHours"] != null)
    {
        tatHours1 = Request.QueryString["tatHours"].ToString();
    }

    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CaseStatus"] != null)
    {
        CaseStatus1 = @Request.QueryString["CaseStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExcelExportYTRDE", "ProvidedInfo", new { CaseStatus = CaseStatus1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageEmploymentYTRChecks", "ProvidedInfo", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                                        new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                        "-- Select Client -- ",
                                        new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, SecuritasID..." })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <label class="col-md-2 control-label">YTR Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("YTRDate", null, new { @class = "form-control", @id = "YTRDate", @placeholder = "yyyy-mm-dd" })
                                    </div>
                                </div>
                                <div class="form-group branch row search-frame">
                                    <div style="text-align:center;" class="col-md-12">
                                        <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQEmployments != null)
                {
                    <div class="row">
                        <div class="col-md-12 table table-striped">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQEmployments, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "CompanyRefNo", header: "SecuritasID", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-2"),
                                    grid.Column("YTR Date", "CreatedDate", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),

                                    grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:"td-1"),
                                    grid.Column("", canSort: false, format: (item)=> {
                                        string CompleteLink = string.Format("<a href=\"#\" id=\"Complete_{0}\" class=\"Complete\" >{1}</a>", item.EmploymentRowID, "YTR Clear");
                                        return new HtmlString(CompleteLink);
                                    }, style:"td-1")

                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
        <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
        <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
        <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>*@
    <script type="text/javascript">
         $(document).ready(function () {
            $('#Search').val('@Model.ItemSearch.Search');
            $('#ClientRowID').val('@Model.ItemSearch.ClientRowId');
            $('#RecievingFromDate').val('@Model.ItemSearch.RecievingToDate');
            $('#CompletedFromDate ').val('@Model.ItemSearch.CompletedToDate' );
            $('#RecievingToDate').val('@Model.ItemSearch.RecievingFromDate');
            $('#CompletedToDate').val('@Model.ItemSearch.CompletedFromDate');

        });
    </script>

    <script type="text/javascript">
        $(".Complete").on("click", function () {
            var str = $(this).attr("id").split("_");
            id = str[1];

            var flag = confirm('Are you sure Clear Check YTR successfully?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("EmploymentYTRCheckClear", "ProvidedInfo")',
                    data: { "id": id },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("YTR Clear Successfully!");
                            setTimeout(function () { window.location.replace("ManageEmploymentYTRChecks"); }, 300);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });

        $('#RecievingToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#RecievingFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedToDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#CompletedFromDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $('#YTRDate').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
    </script>
}

