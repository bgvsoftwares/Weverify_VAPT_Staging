    <script>
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', 'Report', 'left=0,top=0,width=800,height=600,toolbar=0,scrollbars=yes,status=0');
            WinPrint.document.open();
            WinPrint.document.write(
                '<html>\n<head>' +
                '<link href="/Images/report.css" rel="stylesheet" type="text/css" />' +
                '\n</head>' +
                '<body>' +
                '<div> \n' + prtContent.innerHTML + ' \n</div> ' +
                '</body>' +
                '\n</html>'
            );

            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            //WinPrint.close();
        }
    </script>
    <script>
        async function fnDownloadAsPDF() {

            // div content
            const content = document.getElementById("repo");
            const checkName = document.getElementById("hdCheckName").value;
            const PUniqueId = document.getElementById("hdPUniqueReferenceID").value;
            // PDF File Name
            const strFileName = `${PUniqueId}_${checkName}.pdf`;

            const opt = {
                msrgin: 10,
                filename: strFileName,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 1 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'p' }

            };

            html2pdf().from(content).set(opt).save();

        }
    </script>
   
    <script>
        async function fnUploadDocumentCheckWise() {

            // div content
            const content = document.getElementById("repo");
            const checkName = document.getElementById("hdCheckName").value;
            const PUniqueId = document.getElementById("hdPUniqueReferenceID").value;
            // PDF File Name
            const strFileName = `${PUniqueId}_${checkName}.pdf`;

            try
            {
                // render HTML to the canvas
                const canvas = await html2canvas(content, { scale: 1.2, useCORS: true });
                const imgData = canvas.toDataURL("image/jpeg", 0.65);

                // Create PDF
                const pdf = new jspdf.jsPDF("p", "mm", "a4");
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = pdf.internal.pageSize.getHeight();

                const imgWidth = pdfWidth;
                const imgHeight = (canvas.height * pdfWidth) / canvas.width;

                let heightLeft = imgHeight;
                let position = 0;

                pdf.addImage(imgData, "JPEG", 0, 0, imgWidth, imgHeight);
                heightLeft -= pdfHeight;

                // Add Multiple Page
                while (heightLeft > 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, "JPEG", 0, position, imgWidth, imgHeight);
                    heightLeft -= pdfHeight;
                }

                // Create Blob
                const pdfBlob = pdf.output("blob");

                // Trigger file download
                pdf.save(strFileName);
                
                // Prepare form data for upload
                const formData = new FormData();
                formData.append("PersonalRowID", '@personalRowID');
                formData.append("DocumentType", checkName);
                formData.append("uploadDoc", pdfBlob, strFileName);

                // Send to Server
                const response = await fetch("/ProvidedInfo/fnUploadAPIDocumentCheckWise", {
                    method: "POST",
                    body: formData
                });

                if (response.ok) {
                    alert("Document uploaded successfully!");
                } else {
                    alert("Upload failed.");
                }

            } catch (error) {
                alert("Error while uploading PDF.");
            }
        }
    </script>
    
    <script>
        async function fnDownloadAsPDFMultiPage() {
            const { jsPDF } = window.jspdf;

            // div content
            const content = document.getElementById("repo");
            const checkName = document.getElementById("hdCheckName").value;
            const PUniqueId = document.getElementById("hdPUniqueReferenceID").value;
            // PDF File Name
            const strFileName = `${PUniqueId}_${checkName}.pdf`;

            content.style.background = '#fff';

            const canvas = await html2canvas(content, {
                scale: 2, // better quality
                useCORS: true, // allow external images/css
                allowTaint: true,
                logging: false,
                scrollX: 0,
                scrollY: -window.scrollY,
                windowWidth: document.documentElement.offsetWidth,
                windowHeight: document.documentElement.scrollHeight
            });

            const imgData = canvas.toDataURL('image/png');
            const pdf = new jsPDF('p', 'mm', 'a4');

            const pdfWidth = pdf.internal.pageSize.getWidth();
            const pdfHeight = pdf.internal.pageSize.getHeight();
            const imgWidth = pdfWidth;
            const imgHeight = (canvas.height * pdfWidth) / canvas.width;

            let heightLeft = imgHeight;
            let position = 0;

            // Add first page
            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pdfHeight;

            // Add remaining pages if content overflows
            while (heightLeft > 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pdfHeight;
            }

            // Save the PDF
            pdf.save(strFileName);

        }
    </script>

    
</body>
