    <script>
        $('#100').attr('placeholder', 'yyyy-mm-dd');
        $('#100').datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true,
            yearRange: "-66:+0",
        });
        $("#104").keypress(function (e) {
            var a = $('#154').val();
            if (a == "Aadhaar") {
                //alert('good');
                var length = jQuery(this).val().length;
                if (length > 11) {
                    return false;
                }
                else if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                    return false;
                }
                else if ((length == 0) && (e.which == 48)) {
                    return false;
                }
            }
            else if (a == "PAN Card") {
                if ($("#104").val().length >= 10) {
                    return false;
                }
            }
            //else if (a == "Driving License") {
            //    if ($("#104").val().length >= 16) {
            //        return false;
            //    }
            //}
            //else if (a == "Passport") {
            //    if ($("#104").val().length >= 8) {
            //        return false;
            //    }
            //}
            else if (a == "Voter ID") {
                if ($("#104").val().length >= 15) {
                    return false;
                }
            }
        });

        $("#154").change(function (e) {
            $('#104').val('');
        });

        $("#btn-validate").click(function (e) {
            var a = $('#154').val();
            var l = $('#104').val().length;
            if (a == "PAN Card" && l != 10) {
                alert("Pan Card No can not be more then or less than 10 digit");
                $('#104').val('');
            }

            ///////////////////////////////////////////////////////////

            else if (a == "Aadhaar" && l != 12) {
                alert("Aadhaar No can not be more than or less than 12 digit");
                $('#104').val('');
            }

            else if (a == "Aadhaar" && l == 12) {
                var regex = /^([0-9]{4}[0-9]{4}[0-9]{4}$)|([0-9]{4}\s[0-9]{4}\s[0-9]{4}$)|([0-9]{4}-[0-9]{4}-[0-9]{4}$)/;
                if (regex.test($("#104").val())) {
                    $("#lblError").css("visibility", "hidden");
                } else {
                    $('#104').val('');
                }
            }
            /////////////////////////////////////////////////////
            //else if (a == "Driving License" && l != 16) {
            //    alert("Driving License No can not be more than or less than 16 digit");
            //    $('#104').val('');
            //}
            //else if (a == "Passport" && l != 8) {
            //    alert("Passport No can not be more than or less than 8 digit");
            //    $('#104').val('');
            //}
            else if (a == "Voter ID" && l >= 15) {
                alert("Voter ID No can not be more than or less than 15 digit");
                $('#104').val('');
            }
        });

        $("#104").on({
            keydown: function (e) {
                if (e.which === 32)
                    return false;
            },
            change: function () {
                this.value = this.value.replace(/\s/g, "");
            }
        });


        $("#CheckStatus").change(function (e) {
            var a = $('#154').val();
            var l = $('#104').val().length;
            if (a == "PAN Card" && $('#104').val().length < 10) {
                return false;
            }

        });

