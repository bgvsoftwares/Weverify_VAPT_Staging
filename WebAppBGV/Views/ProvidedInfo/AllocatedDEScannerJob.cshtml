@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Allocated Candidate List To Data Entry Document Scanner";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
}
@{
    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    string version = "";
    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    CaseStatus1 = ViewBag.CaseStatus;
    tatHours1 = ViewBag.tatHours;
    version = ViewBag.version;
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExcelExportDEScanner", "ProvidedInfo", new { CaseStatus = CaseStatus1, tatHours = tatHours1 }, new { @class = "btn bun-bg btn-default" }).ToString();
    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

}

@section NavigationButton{ @Html.Partial("_NavigationButton") }
@*@section LeftNavigation{ @Html.Partial("_NavLeftProvidedInfo") }*@
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AllocatedDEScannerJob", "ProvidedInfo", FormMethod.Post))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">Client Name :</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ClientRowID",
                          new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                          "-- Select Client -- ",
                          new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">Keyword :</label>
                                    <div class="col-md-8">
                                        @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No...", @autocomplete = "off", @maxLength = "100" })
                                    </div>
                                </div>
                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">Recieving From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                    <label class="col-md-2 control-label">Recieving To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                </div>
                                <div class="form-group branch row  search-frame">
                                    <label class="col-md-2 control-label">Completed From Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                    <label class="col-md-2 control-label">Completed To Date :</label>
                                    <div class="col-md-3">
                                        @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxLength = "11" })
                                    </div>
                                </div>
                                <div class="form-group branch row  search-frame">
                                    <div style="text-align:center;" class="col-md-12">
                                        <input class="btn bun-bg btn-default" type="submit" value="Search" id="btnSearch" />
                                    </div>
                                </div>
                            </div>
                            if (ViewBag.CaseStatus != null)
                            {
                                @Html.Hidden("CaseStatus", CaseStatus1.ToString())
                            }

                            if (ViewBag.tatHours != null)
                            {
                                @Html.Hidden("tatHours", tatHours1)
                            }
                            if (ViewBag.version != null)
                            {
                                @Html.Hidden("version", version)
                            }
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQPersonalInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table">
                            @{
                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQPersonalInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-2"),
                                       grid.Column(columnName: "IsSeniorCase", header: "IsSeniorCase", canSort: false, style:"td-3"),
                                    grid.Column(columnName: "CompanyRefNo", header: "Securitas ID", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "Name", header: "Candidate Name", canSort: false, style:"td-2"),
                                    grid.Column(columnName: "EmployeeID", header: "EmployeeID", canSort: false, style:"td-2"),
                                    grid.Column("AllocatedToDEScanDate", "Allocated On", format: (item) => item.AllocatedToDEScanDate != null ? item.AllocatedToDEScanDate.ToString() : "", canSort: false,style:"td-2"),
                                    grid.Column(header : "Uploaded By Client", format : (item) =>{
                                        if (item.OtherDetails != null && item.OtherDetails != "")
                                        {
                                            return  Html.ActionLink("Download", "GetClientDoc", new { ImageName = clsCommonMethods.PEncrypt(item.OtherDetails),CompanyRefNo=clsCommonMethods.PEncrypt(item.CompanyRefNo),Casestatus=CaseStatus1 });
                                        }else
                                        {
                                            return "";
                                        }}, style:"delete td-4"),

                                    grid.Column(header : "Document", format : (item) => {
                                        if(item.DEScanCaseStatus!="Completed" || item.CaseStatusId=="3" || item.CaseStatusId=="4")
                                          {
                                            if (CaseStatus1 != null)
                                            {
                                                return Html.ActionLink("Upload", "ManageUploadDocmentList", "ProvidedInfo", new { pid = clsCommonMethods.PEncrypt(item.PersonalRowID.ToString()), Casestatus=CaseStatus1,version=version }, null);
                                            }
                                            else if (tatHours1 != null)
                                            {
                                                return Html.ActionLink("Upload", "ManageUploadDocmentList", "ProvidedInfo", new { pid = clsCommonMethods.PEncrypt(item.PersonalRowID.ToString()), tatHours=tatHours1,version=version }, null);
                                            }
                                            else
                                            {
                                                return Html.ActionLink("Upload", "ManageUploadDocmentList", "ProvidedInfo", new { pid = clsCommonMethods.PEncrypt(item.PersonalRowID.ToString()),version=version }, null);
                                            }
                                          }
                                          else
                                            {
                                                     return "";
                                            }
                                    }, style:"edit td-1"),

                                      grid.Column("Scanner-Job", canSort: false, format: (item)=> {
                                          if(item.DEScanCaseStatus!="Completed"|| item.CaseStatusId=="3"|| item.CaseStatusId=="4")
                                          {
                                                string DeleteLink = string.Format("<a href=\"#\" id=\"Complete_{0}\"CheckStatusId=\"{1}\"SubCheckId=\"{2}\"CaseStatus=\"{3}\" class=\"Complete\" >{4}</a>", item.PersonalRowID,item.checkStatusId,item.SubCheckRowID,CaseStatus1, "Complete");
                                                return new HtmlString(DeleteLink);
                                          }
                                          else
                                            {
                                                     return "";
                                            }
                                    }, style:"td-1"),

                                         grid.Column("Hold Case", canSort: false, format: (item)=> {

                                             if(item.Status==1 && item.CheckStatusId=="2" && item.CaseStatusId=="3")
                                          {
                                                string HoldLink = string.Format("<a href=\"#\" id=\"Hold_{0}\"CaseStatus=\"{1}\" class=\"Hold\" >{2}</a>", item.PersonalRowID,CaseStatus1 ,"Hold");
                                                return new HtmlString(HoldLink);

                                          }
                                             else if (item.Status==1 && item.CheckStatusId=="2" && item.CaseStatusId=="109")
                                             {
                                                  string HoldLink = string.Format("<a href=\"#\" id=\"Release_{0}\"CaseStatus=\"{1}\" class=\"Release\" >{2}</a>", item.PersonalRowID, CaseStatus1,"Release");
                                                return new HtmlString(HoldLink);
                                             }
                                          else
                                            {
                                                 return "";
                                            }
                                              }, style:"td-5")
                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script src="~/Scripts/normalizePlugin.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#Search').val('@Model.ItemSearch.Search');
            $('#ClientRowID').val('@Model.ItemSearch.ClientRowId');
            $('#RecievingFromDate').val('@Model.ItemSearch.RecievingToDate');
            $('#CompletedFromDate ').val('@Model.ItemSearch.CompletedToDate' );
            $('#RecievingToDate').val('@Model.ItemSearch.RecievingFromDate');
            $('#CompletedToDate').val('@Model.ItemSearch.CompletedFromDate');

        });
        $(".Hold").on("click", function () {
            var str = $(this).attr("id").split("_");
            var id = str[1];
            var CaseStatus = $(this).attr("CaseStatus");
            var version1 = $('#version').val();
            var flag = confirm('Are you sure want to Hold this case?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("AllocatedDEHold", "ProvidedInfo")',
                    data: { "id": id },
                    dataType: "json",
                    //beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Stop Successfully!!");

                            setTimeout(function () { window.location.replace("AllocatedDEScannerJob?CaseStatus=" + CaseStatus + "&version=" + version1); }, 300);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });


        $(".Release").on("click", function () {
            var str = $(this).attr("id").split("_");
            var id = str[1];
            var CaseStatus = $(this).attr("CaseStatus");
            var version1 = $('#version').val();
            var flag = confirm('Are you sure want to Release this case?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("AllocatedDERelease", "ProvidedInfo")',
                    data: { "id": id },
                    dataType: "json",
                    //beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Stop Successfully!!");

                            setTimeout(function () { window.location.replace("AllocatedDEScannerJob?CaseStatus=" + CaseStatus + "&version=" + version1); }, 300);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });
    </script>


    <script type="text/javascript">
        $(".Complete").on("click", function () {
            var str = $(this).attr("id").split("_");
            var CheckStatusId = $(this).attr("CheckStatusId");
            var SubCheckId = $(this).attr("SubCheckId");
            var CaseStatus = $(this).attr("CaseStatus");
            var version1 = $('#version').val();
            id = str[1];

            var flag = confirm('Are you sure to complete the job?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("CompletedDEScannerJobs", "ProvidedInfo")',
                    data: { "id": id, "CheckStatusId": CheckStatusId, "SubCheckId": SubCheckId },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("Scanner job Completed Successfully!!");
                            setTimeout(function () { window.location.replace("AllocatedDEScannerJob?CaseStatus=" + CaseStatus + "&version=" + version1 ); }, 500);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });
    </script>
    <script>
        $("#btnSearch").click(function () {
            var obj = $('form input[type="text"]').NormalizedString();
            if (obj == false) {
                return false;
            }
        });
        $("#Search").SearchString();
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
    <script>
        $("#grid > thead > tr").each(function () {
            $(this).find('th').each(function (index) {
                // Check if the header text is "checkFackEdu"
                if ($(this).text().trim() === "IsSeniorCase") {
                    // Hide the corresponding column header
                    $(this).css("display", "none");

                    // Now hide the corresponding cells (td) in the body for that column
                    $("#grid > tbody > tr").each(function () {
                        $(this).find('td').eq(index).css("display", "none");
                    });
                }
            });
        });
    </script>
    <script>
        $('#grid > tbody > tr').each(function () {
            var sixthTdValue = $(this).find('td:nth-child(3)').text();
            if (sixthTdValue == "1") {
                $(this).css('background-color', '#ffbf80');
            }
            else {
                //$(this).css('background-color', '#f2f2f2');
            }
        });
    </script>
}

