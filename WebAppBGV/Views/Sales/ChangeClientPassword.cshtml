@using WebAppBGV.CommonMethods;
@model ViewModels.ClientViewModel.ChangeClientPassword
@{
    ViewBag.Title = "ChangeClientPassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string msg = "";
    if (ViewBag.ErrorMsg != null)
    {
        msg = ViewBag.ErrorMsg.ToString();
    }
}

<h2>Change Client Password</h2>

<div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="row row-sm">
            <div class="col-md-12 text-center">
                @{
                    if (msg != "")
                    {
                        <h3 class="text-danger">@msg.ToString()</h3>
                    }
                }

            </div>
        </div>
        <div class="form-horizontal">
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                <div class="col-md-2" style="margin-top:26px;">
                    @Html.LabelFor(model => model.ClientName, htmlAttributes: new { @class = "control-label required" })
                </div>
                <div class="col-md-4" style="margin-top:26px;">
                    @Html.DropDownListFor(model=>model.ClientRowID, new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"), "-- Select Client -- ",
                      new {@value=@Model.Value, @class = "form-control", @id = "ClientRowID"})
                    @Html.ValidationMessageFor(model => model.ClientRowID, "", new { @class = "text-danger" })

                    <input type="hidden" id="ClientName" name="ClientName" value="">
                </div>
            </div>
        </div>

        <table id="Details" class="table table-bordered">
            <thead>
                <tr class="thead-inverse">
                    <td>User Name</td>
                    <td>Password</td>
                    <td>Status</td>
                    <td>Modified Date</td>
                    <td>Action</td>
                </tr>
            </thead>
            <tbody id="body"></tbody>
        </table>

    }
</div>

<style>
    .required::after {
        content: "*";
        font-weight: bold;
        color: red;
    }

    .form-group {
        margin-bottom: 75px;
    }

    .table {
        margin-bottom: 13px;
    }
</style>

<script type="text/javascript">
    $(
        function () {
            $('#ClientRowID').change(function () {
                var CId = $("#ClientRowID").val();
                debugger;
                var CName = $("#ClientRowID option:selected").text();

                $("#ClientName").val
                    (CName);

                $.getJSON('/ClientServicing/GetClient/' + $('#ClientRowID').val(),

                    function (data) {
                        var output = data;
                        var row = "<tr>";
                        debugger;

                        $('#body').empty();

                        output.forEach(function (e) {
                            row +=
                                "<td>" + e.LoginID + "</td>" +
                                "<td>" + e.Password + "</td>" +
                                "<td>" + e.Status + "</td>" +
                                "<td>" + e.ModifiedDate + "</td>" +
                                "<td>" + "<a href='/ClientServicing/ChangePasswordClient?LoginID=" + e.LoginID + "&&CUserID=" + e.ID + "'>" + "Change Password" + "</a>" + "</td>" +
                                "</tr>";

                        });
                        $('#body').append(row);

                    });
            });
            //$("#btn").on("click", function () {
            //    alert('Created Successfully');
            //});
        });
</script>

