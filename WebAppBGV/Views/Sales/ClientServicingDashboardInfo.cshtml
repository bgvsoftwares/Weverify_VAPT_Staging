                                                    grid.Column("ReportUploadedDate", "ReportUploadedDate", format: (item) => item.ReportUploadedDate != null ? item.ReportUploadedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),
                                                       grid.Column(header : "YTR", format : (item) => {
                                        if (item.CaseStatus=="YTR" )
                                                        {
                                                            var link = Html.ActionLink("Clear", "EmploymentYTRChecksClearByClient", "ClientServicing",
                                                         new { id = clsCommonMethods.PEncrypt(item.EmploymentRowID.ToString()),SubCheckRowID= clsCommonMethods.PEncrypt(item.SubCheckRowID.ToString()),CheckFamilyRowID= clsCommonMethods.PEncrypt(item.CheckFamilyRowID.ToString()),PersonalRowid = clsCommonMethods.PEncrypt(item.PersonalRowID.ToString())}, null);
                                                                        return link;
                                                        }
                                                        return "";
                                                    }, style: "td-1"),
                                grid.Column(header : "Report Edit", format : (item) => {

                                    if(item.CaseStatusId != "30")
                                    {
                                        if (item.CaseStatus!="Completed")
                                        {
                                            var link = Html.ActionLink("Edit/Update", "UpdateAllChecksDetails", "ReportQC", new { id = item.PersonalRowID,CaseStatus = CaseStatus1,version="New"}, new { @class="edit" });
                                            return link;
                                        }
                                        return "";
                                    }
                                    else
                                    {
                                        return "";
                                    }
                                 }),

                            grid.Column(header : "Report Historys", format : (item) =>
                            {
                            var link = Html.ActionLink("History", "CaseReportHistories", "ReportQC", new { pid = item.PersonalRowID }, new { @class = "iframeActionHistories cboxElement" });
                            return link;
                            }),

                            grid.Column(header : "Scop Edit", format : (item) => {
                            if(item.CaseStatusId!="30")
                            {
                            if (item.CaseStatus!="Completed")
                            {
                            var link = Html.ActionLink("Update", "UpdateScopOfVerificationDetails", "ReportQC", new { id = item.PersonalRowID,CaseStatus = CaseStatus1,version="New"}, new { @class="edit" });
                            return link;
                            }
                            return "";
                            }
                            else
                            {
                            return "";
                            }
                            })  ,
                            grid.Column(header: "Senior Profile", format: (item) => {
                            string checkboxId = "seniorProfile_" + item.PersonalRowID;
                            bool isChecked = item.IsSeniorCase.ToLower() == "1";

                            var checkbox = string.Format(
                            "<input type='checkbox' id='{0}' {1} onchange='toggleSeniorProfile({2}, this.checked)' />",
                            checkboxId,
                            isChecked ? "checked" : "",
                            item.PersonalRowID
                            );
                            return new HtmlString(checkbox);
                            }, style: "td-1")
                            }
                            )

                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
        <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
        <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
        <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
        <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
        <link href="~/Content/colorbox.css" rel="stylesheet" />
        <script src="~/Scripts/jquery.colorbox-min.js"></script>*@

    <script type="text/javascript">
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "60%", height: "80%" });
            $(".Remindermail").colorbox({ iframe: true, width: "40%", height: "50%" });
            $('#RecievingDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                //showButtonPanel: true,
                yearRange: "-66:+0",
            });
            $('#CompletedDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>

    <script>
        $("#grid > thead > tr").each(function () {
            $(this).find('th').each(function (index) {
                // Check if the header text is "checkFackEdu"
                if ($(this).text().trim() === "IsSeniorCase") {
                    // Hide the corresponding column header
                    $(this).css("display", "none");

                    // Now hide the corresponding cells (td) in the body for that column
                    $("#grid > tbody > tr").each(function () {
                        $(this).find('td').eq(index).css("display", "none");
                    });
                }
            });
        });
    </script>
    <script>
        $('#grid > tbody > tr').each(function () {
            var sixthTdValue = $(this).find('td:nth-child(3)').text();
            if (sixthTdValue == "1") {
                $(this).css('background-color', '#ffbf80');
            }
            else {
                //$(this).css('background-color', '#f2f2f2');
            }
        });
    </script>

    <script type="text/javascript">
        function toggleSeniorProfile(personalRowID, isChecked) {
            debugger;

            var url = "/ClientServicing/ToggleSeniorProfileCase?personalRowID=" + personalRowID + "&isSenior=" + isChecked;
            $.ajax({
                url: url,
                dataType: 'json',
                type: 'POST',
                async: false,
                //data: { pass: pass },
                success: function (result) {
                    debugger;
                    console.log(result.message || "Updated successfully.");
                    window.location.reload();
                },
                error: function (result) {
                    alert("Error updating senior profile status.");
                }
            });
        }
    </script>
    <script>
        document.getElementById("fetchDataCheckbox").addEventListener("change", function () {
            document.getElementById("fetchDataCheckboxHidden").value = this.checked;
        });
    </script>
}
