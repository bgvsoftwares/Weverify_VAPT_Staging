
@model ViewModels.VerificationViewModel.PQEducationVerViewModel
@{
    ViewBag.Title = "Add Education Info By PV TeamMember";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    if (Session["Designation"] != null)
    {

        string Designation = Session["Designation"].ToString();
        if (Designation == "Manager-PV")
        {
            string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
            string hyperLink = Html.ActionLink("linkTitle", "EducationManagerPVAllocated", "PVerification", null, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
        else if (Designation == "Team Leader-PV")
        {
            string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
            string hyperLink = Html.ActionLink("linkTitle", "EducationManagerPVAllocated", "PVerification", new { dtm = 1 }, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
        else if (Designation == "Team Member-PV")
        {
            string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
            string hyperLink = Html.ActionLink("linkTitle", "EducationPVTMDashboardInfo", "PVerification", null, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
        else if (Designation == "Team Member-PV-QC")
        {
            string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
            string hyperLink = Html.ActionLink("linkTitle", "EducationPVTMDashboardInfo", "PVerification", null, new { @class = "headerbacklink" }).ToString();
            ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
        }
    }
    else
    {
        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "Index", "Verification", null, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    }
}

