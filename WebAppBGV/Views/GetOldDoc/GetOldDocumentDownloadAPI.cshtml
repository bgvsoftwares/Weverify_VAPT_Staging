@{
    ViewBag.Title = "Moved archival document on live server";
}
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Moved archival document on live server</title>
</head>
<body>
    <div class="container-fluid">
        <div class="card shadow mb-5 bg-body rounded pt-0 mt-4 rounded-0 w-75 m-auto">

            <div class="card-body p-4">
                @using (Html.BeginForm("GetOldDocumentDownloadAPI", "GetOldDoc", FormMethod.Post))
                {<div class="row row-sm justify-content-center">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">CompanyRefNo :</label>
                        </div>
                        <div class="col-md-4">
                            @Html.Editor("CompanyRefNo", new { @class = "form-control" })
                            @if (ViewBag.Error != null && ViewBag.Error == "Please fill mandatory fields")
                            {
                                <p class="text-danger p-2">@ViewBag.Error</p>
                            }
                            <br />
                        </div>
                    </div>
                    <div class="row row-sm mt-4">
                        <div class="col-md-12 text-center">
                            <input type="submit" class="btn" value="Submit" />
                        </div>

                    </div>
                    if (ViewBag.Error != null && ViewBag.Error == "Please fill mandatory fields")
                    {
                    }
                    else
                    {
                        if (ViewBag.Error != null)
                        {
                            <div class="row row-sm mt-3">
                                <div class="col-md-12 text-center">
                                    <label style="color:green;">@ViewBag.Error</label>
                                </div>
                            </div>

                        }
                    }
                }
            </div>
        </div>
    </div>

    <style>
        body {
            font-family: 'Securitas Pro';
        }

        .navbar-brand-img {
            width: 95px;
        }

        .bg-light {
            background: #031F30 !important;
        }

        .btn {
            background: #8D5FFF;
            border-radius: 0px;
            border: 1px solid #8D5FFF;
            color: #fff;
            font-family: 'Securitas Pro';
            font-size: 1rem;
            transition: .3s ease-in-out;
        }

            .btn:hover {
                background: #fff;
                color: #031f30;
                border: 1px solid #8D5FFF;
            }

        .card-header {
            background: #031f30;
            color: #FFF;
        }

        .text-box {
            display: block;
            width: 100%;
            padding: .375rem .75rem;
            font-size: 1rem;
            font-weight: 400;
            line-height: 1.5;
            color: #212529;
            background-color: #fff;
            background-clip: padding-box;
            border: 1px solid #ced4da;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            border-radius: 0rem;
            transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out;
        }

            .text-box:focus {
                color: #212529;
                background-color: #fff;
                border-color: #86b7fe;
                outline: 0;
                box-shadow: 0 0 0 0.25rem rgb(13 110 253 / 25%);
            }

        .text-danger {
            font-size: .80rem;
        }

        thead {
            font-size: .90rem;
            background: #031F30;
            color: #FFF;
        }
    </style>
</body>
</html>
