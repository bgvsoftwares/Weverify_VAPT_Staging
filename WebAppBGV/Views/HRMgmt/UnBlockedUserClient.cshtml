        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("UnBlockedUserClient", "HRMgmt", FormMethod.Get))
    {
            <div class="form-horizontal">
                @*<div class="form-group branch row  search-frame">
        <label class="col-md-3 control-label">Client Name :</label>
        <div class="col-md-6">*@
                @*@Html.DropDownList("ClientName",
        new SelectList(ViewBag.Client, "ClientRowID", "ClientRowID"),
        "-- Select Client --",
        new { @class = "form-control" })*@

                @*@Html.DropDownListFor(ClientRowID,
        new SelectList(ViewBag.Client, "ClientRowID", "ClientRowID"),
        "-- Select Client -- ",
        new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ClientRowID, "", new { @class = "text-danger" })*@



