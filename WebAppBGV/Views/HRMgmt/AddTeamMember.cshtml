                        @Html.ValidationMessageFor(model => model.CategoryRowID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch row ">
                    @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "col-md-2 control-label colonsymbl required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.EmployeeID, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.BORowID, htmlAttributes: new { @class = "col-md-2 control-label required" })
                    <div class="col-md-3">
                        @Html.DropDownListFor(model => model.BORowID,
                           new SelectList(ViewBag.branchOfficeList, "BORowID", "BOName"),
                           "-- Select branch Office --",
                           new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.BORowID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch row ">
                    @Html.LabelFor(model => model.EmailID, htmlAttributes: new { @class = "col-md-2 control-label colonsymbl" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.EmailID, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.EmailID, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.MobileNo, htmlAttributes: new { @class = "col-md-2 control-label colonsymbl" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.MobileNo, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.MobileNo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch row ">
                    @Html.LabelFor(model => model.ResidancePhoneNo, htmlAttributes: new { @class = "col-md-2 control-label colonsymbl" })
                    <div class="col-md-1">
                        @Html.EditorFor(model => model.STD, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    <div class="col-md-2">
                        @Html.EditorFor(model => model.ResidancePhoneNo, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ResidancePhoneNo, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.DirectTelNo, htmlAttributes: new { @class = "col-md-2 control-label colonsymbl" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.DirectTelNo, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.DirectTelNo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch row ">
                    @Html.LabelFor(model => model.PresentAddress, htmlAttributes: new { @class = "col-md-2 control-label colonsymbl" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.PresentAddress, new { @class = "form-control", @rows = "2" })
                        @Html.ValidationMessageFor(model => model.PresentAddress, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch row ">
                    @Html.LabelFor(model => model.PermanentAddress, htmlAttributes: new { @class = "col-md-2 control-label colonsymbl" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.PermanentAddress, new { @class = "form-control", @rows = "2" })
                        @Html.ValidationMessageFor(model => model.PermanentAddress, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="all-button-bg">
                    @Html.ActionLink("Back", "ManageTeamMembers", "HRMgmt", null, new { @class = "btn bun-bg btn-default" })
                    <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>


    <script type="text/jscript">
        
        $(document).ready(function () {
            var start = new Date();
            start.setFullYear(start.getFullYear() - 60);
            var end = new Date();
            end.setFullYear(end.getFullYear() - 18);

            $('#DOB').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                minDate: start,
                maxDate: end,
                //yearRange: "-66:-10",
                yearRange: start.getFullYear() + ':' + end.getFullYear(),
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });

            $('#DOJ').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,              
                yearRange: "-10:+5",
               
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });
        });
        function validateForm() {
            var dob = $('#DOB').val();
            var doj = $('#DOJ').val();
          
            if (dob != '') {
                var str = dob.split('-');

                var firstdate = new Date(str[0], str[1], str[2]);
                var dojday1 = str[2];
                var dojmonth1 = str[1];
                var dojyear1 = str[0];

                var dateOfBorth = new Date(dojyear1, dojmonth1 - 1, dojday1);

                var str1 = doj.split('-');
                var firstdate1 = new Date(str1[0], str1[1], str1[2]);

                var day = str1[2];
                var month = str1[1];
                var year = str1[0];

                var DateOfJoin = new Date(year, month - 1, day)

                var timeDiff = DateOfJoin - dateOfBorth;

                var diffDays = timeDiff / (1000 * 3600 * 24 * 365);
                var age = parseInt(diffDays);

                if (age < 18) {
                    alert("Age should be more than 18 years. from date of joining!");
                    return false;
                }
            }
            return true;
        };
        $(function () {
            //Bind State base on CountryRowID
            $('#CountryRowID').change(function () {
                $.getJSON('/HRMgmt/BindState/' + $('#CountryRowID').val(), function (data) {
                    var items = '<option value="">-- Select State --</option>';
                    $.each(data, function (i, States) {
                        items += "<option value='" + States.Value + "'>" + States.Text + "</option>";
                    });
                    $('#StateRowID').html(items);
                    $('#DistrictRowID').val();
                    $('#LocationRowID').val();
                });
            });

            //Bind District base on StateRowID
            $('#StateRowID').change(function () {
                $.getJSON('/HRMgmt/BindDistrict/' + $('#StateRowID').val(), function (data) {
                    var items = '<option value="">-- Select District --</option>';
                    $.each(data, function (i, Districts) {
                        items += "<option value='" + Districts.Value + "'>" + Districts.Text + "</option>";
                    });
                    $('#DistrictRowID').html(items);
                });
            });

            //Bind State base on DistrictRowID
            $('#DistrictRowID').change(function () {
                $.getJSON('/HRMgmt/BindLocation/' + $('#DistrictRowID').val(), function (data) {
                    var items = '<option value="">-- Select Location --</option>';
                    $.each(data, function (i, Locations) {
                        items += "<option value='" + Locations.Value + "'>" + Locations.Text + "</option>";
                    });
                    $('#LocationRowID').html(items);
                    $('#LocationRowID').val();
                });
            });

            //PinCode Bind
            $('#LocationRowID').change(function () {
                var url = "/HRMgmt/GetPinCodeByLocationId/" + $("#LocationRowID").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (pinCode) {
                        $('#PinCode').val(pinCode);
                        $('#hdnPinCode').val(pinCode);
                    }
                });
            });

            $('#DepartmentRowID').change(function () {
                $.getJSON('/HRMgmt/BindDesignation/' + $('#DepartmentRowID').val(), function (data) {
                    var items = '<option value="">-- Select Designation --</option>';
                    $.each(data, function (i, Designations) {
                        items += "<option value='" + Designations.Value + "'>" + Designations.Text + "</option>";
                    });
                    $('#DesignationRowID').html(items);
                });
            });
        });
    </script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    
    <style>
        .ui-datepicker-buttonpane {
            display: none;
        }
    </style>

}
