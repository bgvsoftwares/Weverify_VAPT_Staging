                    <div class="col-md-3">
                        @Html.EditorFor(model => model.SpouseLastName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.SpouseLastName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group branch row ">
                    @Html.LabelFor(model => model.DOB, htmlAttributes: new { @class = "col-md-2 control-label DateOfBirth colonsymbl required" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.DOB, new { htmlAttributes = new { @class = "date-picker form-control", @placeholder = "yyyy-mm-dd" } })
