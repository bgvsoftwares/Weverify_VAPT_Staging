@model ViewModels.HRViewModels.AddTeamDepartmentViewModel

@{
    ViewBag.Title = "Add Department And Designation For " + Session["TMName"].ToString();

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "ManageDepartDesignation", "HRMgmt", new { tmid=Model.TeamMemberRowID }, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section LeftNavigation{ @Html.Partial("_NavLeftHRMgmt") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("AddTeamDepartDesignation", "HRMgmt", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">

                <div class="table-frame-top">&nbsp;</div>
                @Html.HiddenFor(model => model.TeamMemberRowID)
                @Html.HiddenFor(model => model.DepartmentRowIds)
                @Html.HiddenFor(model => model.DesignationRowIds)
                <div class="navbar-collapse collapse thead-inverse">
                    <ul class="nav navbar-nav" style="width:100%">
                        <li class="top-head" style="width:4%;">No.</li>
                        <li class="top-head" style="width:19%;">Department</li>
                        <li class="top-head" style="width:15%;">Designation</li>
                    </ul>
                </div>
                <!-- NAVBAR CODE END -->
                <div class="fancy-collapse-panel">
                    <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                        <div id="dvPartialView">
                            @{Html.RenderPartial("_DepartmentAndDesignationList");}
                        </div>
                    </div>
                </div>
                <div class="all-button-bg">
                    @Html.ActionLink("Back", "ManageDepartDesignation", "HRMgmt", new { tmid = Model.TeamMemberRowID }, new { @class = "btn bun-bg btn-default" })
                    <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" value="Submit" />
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>

    <script type="text/jscript">
        $(document).ready(function () {
            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+10",
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });
        });
        $(function () {
            $('input[name=department]').click(function () {
                var chkdata = this.value;
                var CheckFamily = '';
                //$('input[class="checkbox"]').not(this).prop('checked', false);
                if (false == $(this).prop("checked")) {
                    $('input[name="' + chkdata + '"]').each(function (index, value) {
                        this.checked = false;
                    });
                }
                else {
                    var count = 0;
                    $('input[name="' + chkdata + '"]').each(function (index, value) {
                        if (count==0) {
                            this.checked = true;
                        }
                        else {
                            this.checked = false;
                        }
                        count++;
                    });
                }
                $('input.Designation:checkbox').each(function (index, value) {
                    var data = this.value.split('_');
                    if (this.checked) {
                        CheckFamily += this.value + ',';
                    }
                });
                if (CheckFamily.length > 0) {
                    CheckFamily = CheckFamily.substring(0, CheckFamily.length - 1);
                } else { CheckFamily = ''; }
                $('#DesignationRowIds').val(CheckFamily.trim());
            });

            $('.slectOne').on('change', function () {
                $('.slectOne').not(this).prop('checked', false);
                $('#result').html($(this).data("id"));
                if ($(this).is(":checked"))
                    $('#result').html($(this).data("id"));
                else
                    $('#result').html('Empty...!');
            });

            $('input.Designation:checkbox').click(function () {
                var chkdata = this.value.split('_');
                $('input[name="' + chkdata[0] + '"]').not(this).prop('checked', false);
                var CheckFamily = '';
                if (false==$(this).prop("checked") && $('input[class="' + chkdata[0] + '"]').prop('checked') == true) {
                   $('input[class="' + chkdata[0] + '"]').prop('checked', false);
                }
                $('input.Designation:checkbox').each(function (index, value) {
                    var data = this.value.split('_');
                    if (this.checked) {
                        CheckFamily += this.value + ',';
                        $('input[class="' + data[0] + '"]').prop('checked', true);
                    }
                });
                if (CheckFamily.length > 0) {
                    CheckFamily = CheckFamily.substring(0, CheckFamily.length - 1);
                } else { CheckFamily = ''; }
                $('#DesignationRowIds').val(CheckFamily.trim());
            });


            //Selected Subcheck Family
            //$('input.Designation:radio').click(function () {
            //    var CheckFamily = '';
            //    var chkdata = this.value.split('_');

            //    if ( $('input[class="' + chkdata[0] + '"]').prop('checked') == true) {
            //        $(this).prop("checked", false);
            //        $('input[class="' + chkdata[0] + '"]').prop('checked', false);
            //    }
            //    $('input.Designation:radio').each(function (index, value) {
            //        var data = this.value.split('_');
            //        if (this.checked) {
            //            CheckFamily += this.value + ',';
            //            $('input[class="' + data[0] + '"]').prop('checked', true);
            //        }
            //    });
            //    if (CheckFamily.length > 0) {
            //        CheckFamily = CheckFamily.substring(0, CheckFamily.length - 1);
            //    } else { CheckFamily = ''; }
            //    $('#DesignationRowIds').val(CheckFamily.trim());
            //});

        });
    </script>
    <style>
        .ui-datepicker-buttonpane {
            display: none;
        }
    </style>

}
