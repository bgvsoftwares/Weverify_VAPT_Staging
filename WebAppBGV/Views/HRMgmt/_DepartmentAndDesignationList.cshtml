
@{int count = 0; }
@foreach (var item in ViewBag.Departments)
{
    count++;
    <div class="card">
        <div class="card-header dvPnlHeading" id="headingOne">
            <div class="dvChkFmlySrNo">@count.</div>&nbsp;&nbsp;&nbsp;&nbsp;
            <input type="checkbox" name="department" class="@item.DepartmentRowID" value="@item.DepartmentRowID" />
            <a>
                @item.DepartmentName
            </a>
        </div>
        <div id="@item.DepartmentRowID" class="panel-collapse collapse show" role="tabpanel" aria-labelledby="headingOne">
            <div class="panel-body">
                <div class="col-md-11 col-md-offset-1 dvpnlChild" >
                    @foreach (var designation in ViewBag.Designations)
                    {
                        if (item.DepartmentRowID == designation.DepartmentRowID)
                        {
                            <div class="col-md-3">
                                <input type="checkbox" class="Designation"  name="@item.DepartmentRowID" value="@(item.DepartmentRowID)_@(designation.DesignationRowID)" />
                                @designation.DesignationName
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}
