                            <td width="199" style="padding: 12px!important; -webkit-print-color-adjust:exact; background:#e36c0a;">@Model.FinalColor</td>
                        }
                        else
                        {
                            if (@Model.FinalColorCode == "#000")
                            {
                                <td width="199" style="padding: 12px; -webkit-print-color-adjust:exact;">@Model.FinalColor</td>

                            }
                            else {
                            <td width="199" style="padding: 12px; color-adjust:exact; background: @Model.FinalColorCode;">@Model.FinalColor</td>
                            }
                        }

