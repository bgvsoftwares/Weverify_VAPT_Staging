                            @if (!string.IsNullOrEmpty(Model.EmploymentId) && !string.IsNullOrEmpty(Model.Designation))
                            {
                                if (Model.EmploymentId == "-" || Model.EmploymentId == "Not provide")
                                {
                                    <p> @Model.Designation</p>
                                }
                                else
                                {
                                    <p>@Model.EmploymentId &, @Model.Designation</p>
                                }



                            }
                            else if (!string.IsNullOrEmpty(Model.EmploymentId) && string.IsNullOrEmpty(Model.Designation))
                            {
                                <p>@Model.EmploymentId </p>
                            }
                            else if (string.IsNullOrEmpty(Model.EmploymentId) && !string.IsNullOrEmpty(Model.Designation))
                            {
                                <p>@Model.Designation </p>
                            }
                            else
                            {
                                <p>NA</p>
                            }
                        </td>
                        <td width="133" style="background: #ccc; -webkit-print-color-adjust:exact;
    padding: 12px!important;">
