
<table style="border:2px solid #CCC; margin: auto; width: 100%; font-family: 'Calibri',sans-serif;">
    <tr>
        <td>
            <table style="width:100%;">
                <tr>
                    <td style="text-align:right">
                        <img src="https://bgv.securitas-india.com/Images/Securitas-logo.png"
                             style="width:70px; padding: .60rem;">
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table style="width:90%; margin: auto; border-collapse: collapse;" border="1">
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Name Of Applicant
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; padding: .30rem;">
                        @Model.PersonalName
                    </td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Applicant ID
                    </td>
                    <td style="width: 20%; text-align: left; color: #000; font-family: 'Calibri',sans-serif; font-size: 12px; padding: .30rem;">
                        @Model.ClientRefID
                    </td>
                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Employee ID
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                        @Model.EmploymentId
                    </td>
                    @if (Model.ClientRowID == 446)
                    {
                        <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                            Date Of Joining
                        </td>
                        <td colspan="3"
                            style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">


                            @try
                            {
                                if (!string.IsNullOrEmpty(Model.DOJ))
                                {
                                    <p>
                                        @Convert.ToDateTime(Model.DOJ).ToString("dd-MMM-yyyy")
                                    </p>
                                }
                                else
                                {
                                    @Model.DOJ
                                }

                            }
                            catch
                            {
                                <p>
                                    @Model.DOJ
                                </p>
                            }
                        </td>
                    }
                    else
                    {
                        <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                            Date of Birth
                        </td>
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                            @try
                            {
                                if (!string.IsNullOrEmpty(Model.DOB.ToString()))
                                {
                                    <p>
                                        @Convert.ToDateTime(Model.DOB).ToString("dd-MMM-yyyy")
                                    </p>
                                }
                                else
                                {
                                    @Model.DOB
                                }
                            }
                            catch
                            {
                                <p>
                                    @Model.DOB
                                </p>
                            }

                        </td>
                    }

                </tr>
                @if (Model.ClientRowID != 446)
                {
                    <tr>
                        <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                            Date Of Joining
                        </td>
                        <td colspan="3"
                            style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">


                            @try
                            {
                                if (!string.IsNullOrEmpty(Model.DOJ))
                                {
                                    <p>
                                        @Convert.ToDateTime(Model.DOJ).ToString("dd-MMM-yyyy")
                                    </p>
                                }
                                else
                                {
                                    @Model.DOJ
                                }

                            }
                            catch
                            {
                                <p>
                                    @Model.DOJ
                                </p>
                            }
                        </td>
                    </tr>
                }

            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table style="width:90%; margin: auto; border-collapse: collapse;" border="1">
                <tr>
                    <td colspan="4"
                        style="width:20%; text-align: center; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Case Details
                    </td>
                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Date of Initiation
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">@Model.OrderDate.ToString("dd-MMM-yyyy")</td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Case Reference Number/URN No.
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">@Model.CompanyRefNo</td>
                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Fresher/Lateral
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">@Model.EmploymentType</td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Client /Scope
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">@Model.ProcessName</td>
                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Interim Report Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.FirstIntrimReportDate.ToString()))
                            {
                                @Convert.ToDateTime(Model.FirstIntrimReportDate).ToString("dd-MMM-yyyy")
                            }

                            else
                            {
                                <p>-</p>
                            }

                        }
                        catch
                        {
                            if (Model.FirstIntrimReportDate == null)
                            {
                                <p>-</p>
                            }
                            else
                            {
                                @Model.FirstIntrimReportDate
                            }

                        }
                    </td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Interim Report SLA (No of Days)
                    </td>
                    @if (Model.FirstInterimReportSLA == 0)
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                            -
                        </td>
                    }
                    else
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                            @Model.FirstInterimReportSLA
                        </td>
                    }

                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Second Interim Report Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.IntrimReportDate.ToString()))
                            {
                                @Convert.ToDateTime(Model.IntrimReportDate).ToString("dd-MMM-yyyy")
                            }

                            else
                            {
                                <p>-</p>
                            }

                        }
                        catch
                        {
                            if (Model.IntrimReportDate == null)
                            {
                                <p>-</p>
                            }
                            else
                            {
                                @Model.IntrimReportDate
                            }

                        }
                    </td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Second Interim Report SLA (No of Days)
                    </td>
                    @if (Model.InterimReportSLA == 0)
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                            -
                        </td>
                    }
                    else
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                            @Model.InterimReportSLA
                        </td>
                    }

                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        CEA Initiation Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.YTRClearDate))
                            {
                                @Convert.ToDateTime(Model.YTRClearDate).ToString("dd-MMM-yyyy")
                            }
                            else
                            {
                                <p>-</p>
                            }

                        }
                        catch
                        {
                            @Model.YTRClearDate
                        }


                    </td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        CE Insufficiency Clearance Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                        <p>-</p>
                    </td>
                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Final Report Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">


                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.FinalReportDate))
                            {
                                @Convert.ToDateTime(Model.FinalReportDate).ToString("dd-MMM-yyyy")
                            }

                        }
                        catch
                        {
                            @Model.FinalReportDate
                        }


                    </td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Final Report SLA (No of Days)
                    </td>
                    @if (Model.finalReportSLA == 0 && Model.FinalReportDate == null)
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                            -
                        </td>
                    }
                    else
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                            @Model.finalReportSLA
                        </td>
                    }

                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Re-initiation Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.ReverificationDate))
                            {
                                @Convert.ToDateTime(Model.ReverificationDate).ToString("dd-MMM-yyyy")
                            }
                            else
                            {
                                <p>-</p>
                            }

                        }
                        catch
                        {
                            @Model.ReverificationDate
                        }
                    </td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Supplementary Report Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.FirstSupplimentryDate))
                            {
                                @Convert.ToDateTime(Model.FirstSupplimentryDate).ToString("dd-MMM-yyyy")
                            }
                            else
                            {
                                <p>-</p>
                            }
                        }
                        catch
                        {
                            @Model.FirstSupplimentryDate
                        }
                    </td>


                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Supplementary Report SLA(No of Days)
                    </td>
                    @if (Model.SuppleReportSLA == 0 && Model.FirstSupplimentryDate == null)
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">- </td>
                    }
                    else
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">@Model.SuppleReportSLA </td>
                    }

                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Second Re-initiation Date
                    </td>
                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">

                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.SecondReverificationDate))
                            {
                                @Convert.ToDateTime(Model.SecondReverificationDate).ToString("dd-MMM-yyyy")
                            }
                            else
                            {
                                <p>-</p>
                            }
                        }
                        catch
                        {
                            @Model.SecondReverificationDate
                        }
                    </td>
                </tr>
                <tr>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Second Supplementary Report Date
                    </td>

                    <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">
                        @try
                        {
                            if (!string.IsNullOrEmpty(Model.SecondSupplimentryDate))
                            {
                                @Convert.ToDateTime(Model.SecondSupplimentryDate).ToString("dd-MMM-yyyy")
                            }
                            else
                            {
                                <p>-</p>
                            }
                        }
                        catch
                        {
                            @Model.SecondSupplimentryDate
                        }
                    </td>
                    <td style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Second Supplementary Report SLA(No of Days)
                    </td>
                    @if (Model.SecondSuppleReportSLA == 0 && Model.FirstSupplimentryDate == null)
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">- </td>
                    }
                    else
                    {
                        <td style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px;padding: .30rem;">@Model.SecondSuppleReportSLA </td>
                    }

                </tr>
                <tr>
                    <td colspan="2" style="background-color:#DDD; width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; font-size:12px; font-weight:bold;padding: .30rem;">
                        Colour Code(Red/Amber/Green/IRCEP/Stop Case)
                    </td>
                    <td colspan="2" style="width:20%; text-align: left; color:#000; font-family:'Calibri',sans-serif; background:@Model.FinalColorCode; font-size:12px;padding: .30rem; text-align:center;">@Model.FinalColor</td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table style="width:90%; margin: auto; border-collapse: collapse;" border="1">
                <tr>
                    <td style="width:20%; text-align: center; font-family:'Calibri',sans-serif; font-size:12px;">
                        <div class="box" style="background: red; width: 20px;margin: auto; border: 1px solid #000;">
                            &nbsp;
                        </div>
                        <p>Major Discrepancy(RED)</p>
                    </td>
                    <td style="width:20%; text-align: center; font-family:'Calibri',sans-serif; font-size:12px;">
                        <div class="box"
                             style="background:orange; width: 20px;margin: auto; margin-top: 10px;border: 1px solid #000;">
                            &nbsp;
                        </div>
                        <p>
                            Inaccessible for verification / Unable to verify / Inputs required/ Minor
                            Discrepancy(AMBER)
                        </p>
                    </td>
                    <td style="width:20%; text-align: center; font-family:'Calibri',sans-serif; font-size:12px;">
                        <div class="box"
                             style="background: Green; width: 20px;margin: auto;border: 1px solid #000;">
                            &nbsp;
                        </div>
                        <p>Verified Report(GREEN)</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table style="width:90%; margin: auto; border-collapse: collapse; background:#DDDDDD; font-family:'Calibri', sans-serif; font-size:14px; font-weight: bold; text-align: center;"
                   border="1">
                <tr>
                    <td style="padding: .40rem;">

                        @if (Model.Report_Type == "1")
                        {
                            <p> BACKGROUND VERIFICATION REPORT – INTERIM REPORT </p>
                        }
                        else if (Model.Report_Type == "0")
                        {
                            <p>
                                BACKGROUND VERIFICATION REPORT –  FINAL REPORT
                            </p>
                        }
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table style="width:90%; margin: auto; border-collapse: collapse; font-family:'Calibri', sans-serif; font-size:14px; font-weight: bold; text-align: center;"
                   border="0">
                <tr>
                    <td style="padding:.40rem;">
                        Executive Summary
                    </td>
                </tr>
            </table>
        </td>
    </tr>


    <!--Employment table start from here-->
    <tr>
        <td>
            <table style="width:90%; margin: auto; border-collapse: collapse; font-family:'Calibri', sans-serif; font-size:14px; text-align: center;"
                   border="1">


                @{
                    string checkName = string.Empty;
                    int Emp = 0;
                    int Edu = 0;
                    int cri = 0;
                    int refe = 0;
                    int gap = 0;
                    int frerefe = 0;
                    int add = 0;
                    int global = 0;
                    int nat = 0;
                    int drug = 0;

                    foreach (var item in Model.PersonalChecksBriefDetails)
                    {

                        if (item.CheckFamilyRowID == 11)
                        {

                            if (Edu == 0)
                            {
                                <thead>
                                    <tr>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 20%;">Education verification</th>
                                        <th colspan="2" style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 30%;">University/ College Name</th>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 20%;">YOP</th>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 20%;">Status</th>
                                    </tr>
                                </thead>
                            }
                            <tbody>
                                <tr>
                                    <td style="font-family:'Calibri',sans-serif; font-size: 12px;"> <a href="#@item.subCheckId">@item.SubCheckDetail</a></td>
                                    <td colspan="2" style="font-family:'Calibri',sans-serif; font-size: 12px;">@item.detail1</td>
                                    <td style="font-family:'Calibri',sans-serif; font-size: 12px;">@item.detail2</td>
                                    <td style="font-family:'Calibri',sans-serif; background:@item.ColorCode; font-size: 12px;">@item.ColorName</td>
                                </tr>

                            </tbody>
                            Edu++;
                        }

                        if (item.CheckFamilyRowID == 12)
                        {
                            if (Emp == 0)
                            {
                                <thead>
                                    <tr>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 20%;">Employment Verification</th>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 30%;">Tenure(From)</th>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 20%;">Tenure(To Period)</th>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 20%;">Period Verified in Months</th>
                                        <th style="background: #DDDDDD;font-family:'Calibri',sans-serif; font-size: 12px; width: 20%;">Status </th>
                                    </tr>
                                </thead>
                            }

                            <tr>
                                <td style="font-family:'Calibri',sans-serif; font-size: 12px;"><a href="#@item.subCheckId">@item.SubCheckDetail</a></td>
                                <td style="font-family:'Calibri',sans-serif; font-size: 12px;">
                                    @if (item.detail1 != "")
                                    {
                                        try
                                        {
                                            <p>@Convert.ToDateTime(item.detail1).ToString("dd-MMM-yyyy")</p>

                                        }
                                        catch
                                        {
                                            <p>
                                                @item.detail1
                                            </p>
                                        }
                                        //Convert.ToDateTime(item.detail1).ToString("dd-MMM-yyyy");
                                    }
                                    else
                                    {
                                        <p>
                                            @item.detail1
                                        </p>
                                    }


                                </td>
                                <td style="font-family:'Calibri',sans-serif; font-size: 12px;">

                                    @if (item.detail2 != "")
                                    {
                                        try
                                        {
                                            <p>
                                                @Convert.ToDateTime(item.detail2).ToString("dd-MMM-yyyy")
                                            </p>
                                        }
                                        catch
                                        {
                                            <p>
                                                @item.detail2
                                            </p>
                                        }

                                    }
                                    else
                                    {
                                        <p>
                                            @item.detail2
                                        </p>
                                    }


                                </td>
                                <td style="font-family:'Calibri',sans-serif; font-size: 12px;">@item.EmpTenureMonth</td>
                                <td style="font-family:'Calibri',sans-serif; background:@item.ColorCode; font-size: 12px;">@item.ColorName</td>
                            </tr>



                            if (item.CheckFamilyRowID == 12 && Model.EmploymentCount - 1 == Emp)
