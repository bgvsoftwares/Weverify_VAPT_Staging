
@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    /**/

    /**/

    //var list = Model.EmploymentInfoModel.Where(x => x.CheckColorName.ToLower().Contains("draft"))

    //                           .ToList();

    var TestResult = Model.WiproUANCheckList
                 .ToList();


}


@if ( TestResult.Count>0)
{
    <page id="PrintSrc" size="A4">
        <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999;border-collapse:collapse; page-break-after:always!important; width:100%;">
            <tr style="height:65rem!important;">
                <td valign="top">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width: 94%; margin: auto;">
                        <tr>
                            <td valign="top">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td>
                                            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                                <tr>
                                                    <td style="font-size: 20px!important; border: none!important; font-family: Calibri; -webkit-print-color-adjust: exact;" colspan="4" align="right" height="20"><span style="font-family: Calibri, sans-serif;"><strong><img src='@Url.Content("~/Images/Securitas-logo.png")' style="width:75px; margin-top:10px; margin-right: 20px;"></strong></span></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="30">&nbsp;</td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; font-size:20px;font-family:Calibri">Section   :  UAN Validation</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-top:10px;" valign="top" align="center">
                                            <table width="100%" border="1" cellspacing="5" cellpadding="2" style="border-collapse:collapse;border-collapse:collapse;font-family:Calibri;font-size:17px">

                                                <tr>
                                                    <td colspan="2" align="center" rowspan="2">Employment</td>
                                                    <td colspan="2" align="center">UAN</td>
                                                    <td colspan="2" align="center">HR</td>
                                                    <td colspan="2" align="center">iVerify</td>
                                                    <td colspan="2" align="center" rowspan="2">Employment mentioned in iVerify Y/N</td>

                                                </tr>

                                                <tr>

                                                    <td align="center">DoJ</td>
                                                    <td align="center">LWD</td>
                                                    <td align="center">DoJ</td>
                                                    <td align="center">LWD</td>
                                                    <td align="center">DoJ</td>
                                                    <td align="center">LWD</td>


                                                </tr>
                                                @foreach (var p in TestResult)
                                                {
                                                    if (!string.IsNullOrEmpty(p.Employment))
                                                    {

                                                        <tr>
                                                            <td colspan="2">@p.Employment</td>
                                                            <td align="center">@p.UAN_DOJ</td>
                                                            <td align="center">@p.UAN_LWD</td>
                                                            <td align="center">@p.HR_DOJ</td>
                                                            <td align="center">@p.HR_LWD</td>
                                                            <td align="center">@p.IVerify_DOJ</td>
                                                            <td align="center">@p.IVerify_LWD</td>
                                                            <td align="center">@p.iVerify_Y_N</td>
                                                        </tr>

                                                    }
                                                }





                                            </table>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>


        </table>

    </page>
}







