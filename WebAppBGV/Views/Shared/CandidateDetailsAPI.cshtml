@{
    Layout = null;

    var candidateData = ViewBag.CandidateData as Dictionary<string, object>;
}

<style>
    .candidate-container {
        padding: 20px;
        background: #fff;
    }

    .candidate-header {
        font-size: 24px;
        color: #555;
        padding-bottom: 15px;
        border-bottom: 1px solid #e6d78a;
        margin-bottom: 20px;
    }

    .detail-row {
        padding: 20px 0;
        border-bottom: 1px solid #f1f1f1;
    }

    .field-title {
        color: #8c8c8c;
        font-size: 14px;
        margin-bottom: 5px;
    }

    .field-value {
        color: #444;
        font-size: 18px;
        line-height: 1.4;
        word-break: break-word;
    }

    .download-icon {
        font-size: 18px;
    }

    .print-footer {
        width: 100%;
        margin-top: 30px;
        text-align: right;
        padding-right: 20px;
    }

    .candidate-print-btn {
        background: #11C9B7 !important;
        color: #fff !important;
        border: none !important;
        border-radius: 25px !important;
        padding: 10px 25px !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(13,110,253,.3);
        transition: all .3s ease;
    }

        .candidate-print-btn:hover {
            background: #11C9B7 !important;
            transform: translateY(-2px);
        }

        .candidate-print-btn:focus {
            outline: none;
        }
</style>

<div id="repo" class="candidate-container">

    <div class="candidate-header">
        Candidate details
        <span class="download-icon">&#128196;</span>
    </div>


    @if (candidateData != null && candidateData.Count > 0)
    {
        var items = candidateData.ToList();

        for (int i = 0; i < items.Count; i += 4)
        {
            <div class="row detail-row">
                @for (int j = i; j < Math.Min(i + 4, items.Count); j++)
                {
                    <div class="col-md-3">
                        <div class="field-title">@items[j].Key</div>
                        <div class="field-value">
                            @(string.IsNullOrWhiteSpace(Convert.ToString(items[j].Value))
                                ? "NA"
                                : Convert.ToString(items[j].Value))
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="text-center">
            <b>No Candidate Details Found.</b>
        </div>
    }

</div>
@if (candidateData != null && candidateData.Count > 0)
{
    <div class="print-footer">
        <button type="button" class="candidate-print-btn" onclick="CallPrint('repo')">
            Print
        </button>
    </div>
}

<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />
<script src="~/Scripts/multiemail.js"></script>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>


<script>
    function CallPrint(strid) {

        var content = document.getElementById(strid);

        var printWindow = window.open('', '_blank', 'width=1200,height=800');

        printWindow.document.write(`
        <html>
        <head>
            <title>Candidate Details</title>

            <style>
                body{
                    font-family: Arial, sans-serif;
                    padding:20px;
                    margin:0;
                }

                .candidate-header{
                    font-size:24px;
                    color:#555;
                    padding-bottom:15px;
                    border-bottom:1px solid #e6d78a;
                    margin-bottom:20px;
                }

                .detail-row{
                    display:flex;
                    flex-wrap:nowrap;
                    border-bottom:1px solid #f1f1f1;
                    padding:20px 0;
                }

                .detail-row > div{
                    width:25%;
                    padding-right:15px;
                    box-sizing:border-box;
                }

                .field-title{
                    color:#8c8c8c;
                    font-size:14px;
                    margin-bottom:5px;
                }

                .field-value{
                    color:#444;
                    font-size:18px;
                    line-height:1.4;
                    word-break:break-word;
                }
            </style>
        </head>
        <body>
            ${content.innerHTML}
        </body>
        </html>
    `);

        printWindow.document.close();

        setTimeout(function () {
            printWindow.focus();
            printWindow.print();
        }, 1000);
    }
</script>
