
@model ViewModels.ReportQCViewModel.ReportViewModel
@{

    if (Model.PersonalName != null)
    {
        <page id="PrintSrc" size="A4">
            <div style="page-break-after:always ;"></div>
            <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; height:74rem!important; width:100%;">
                <tr>
                    <td width="2%" align="left" valign="bottom">&nbsp;</td>
                    <td valign="top">
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td>
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td width="88%" align="center" style="font-size:25px;"><u><b>SECURITAS INDIA</b> </u></td>
                                            <td width="6%" valign="top"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem;margin: 10px 10px 0px 10px;"></td>
                                        </tr>
                                        <tr><td colspan="2">&nbsp;</td></tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td valign="top">&nbsp;</td>
                            </tr>
                            <tr>
                                @if (Model.TypeofDocument.ToUpper() == "FORM 16")
                                {
                                    <td valign="top" align="center">
                                        <table border="1" cellspacing="5" cellpadding="2" width="793">
                                            <tr style=" background-color:lightgray;">
                                                <td style="font-size:18px; width:66%;  font-family:Calibri;" colspan="2"><b>Details in Application Form</b></td>
                                                <td style="font-size:18px; width:22%;font-family:Calibri;" ><b>Remarks by Verifier</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Type of Document</b></td>
                                                <td class="td2"><b>FORM 16</b></td>
                                                <td class="td1"><b>@Model.TypeofDocumentStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Name of Company</b></td>
                                                <td class="td2"><b>@Model.OrganizationName</b></td>
                                                <td class="td1"><b>@Model.CompanyNameStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>TDS Certificate Number</b></td>
                                                <td class="td2"><b>@Model.PFNo_TDSCertificateNumber</b></td>
                                                <td class="td1"><b>@Model.PFNo_TDSCertificateNumberStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>PAN number of Company</b></td>
                                                <td class="td2"><b>@Model.PANnumberofCompany</b></td>
                                                <td class="td1"><b>@Model.PANnumberofCompanyStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>TAN number of Company</b></td>
                                                <td class="td2"><b>@Model.TANnumberofCompany</b></td>
                                                <td class="td1"><b>@Model.TANnumberofCompanyStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>PAN number of Employee</b></td>
                                                <td class="td2"><b>@Model.PANnumberofEmployee </b></td>
                                                <td class="td1"><b>@Model.PANnumberofEmployeeStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Assessment Year</b></td>
                                                <td class="td2"><b>@Model.AssessmentYear</b></td>
                                                <td class="td1"><b>@Model.AssessmentYearStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Undertaking</b></td>
                                                <td class="td2"><b>@Model.Undertaking</b></td>
                                                <td class="td1"><b>@Model.UndertakingStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Seal and Signature / Digital Signature</b></td>
                                                <td class="td2"><b>@Model.SealandSignature</b></td>
                                                <td class="td1"><b>@Model.SealandSignatureStatus</b></td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Additional Comments</b></td>
                                                <td style="font-size:15px; width:40%;font-family:Calibri;" colspan="2"><b> @Html.Raw(Model.AdditionalComments)</b></td>
                                            </tr>
                                        </table>
                                    </td>
                                }
                                else
                                {
                                    <td valign="top" align="center">
                                        <table border="1" cellspacing="5" cellpadding="2" width="793">
                                            <tr style=" background-color:lightgray;">
                                                <td style="font-size:15px; width:66%;  font-family:Calibri;"colspan="2"><b>Details in Application Form</b></td>
                                                <td style="font-size:15px; width:22%;font-family:Calibri;" >Remarks by Verifier</td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Type of Document</b></td>
                                                <td class="td2"><b>PF Passbook</b></td>
                                                <td class="td1">@Model.TypeofDocumentStatus</td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Name of Company</b></td>
                                                <td class="td2"><b>@Model.OrganizationName</b></td>
                                                <td class="td1">@Model.CompanyNameStatus</td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>PF No.</b></td>
                                                <td class="td2"><b>@Model.PFNo_TDSCertificateNumber</b></td>
                                                <td class="td1">@Model.PFNo_TDSCertificateNumberStatus</td>
                                            </tr>
                                            <tr>
                                                <td class="td1"><b>Additional Comments</b></td>
                                                <td class="td1"><b> @Model.AdditionalComments</b></td>
                                                <td class="td1"><b>@Model.AdditionalCommentsStatus</b></td>
                                            </tr>

                                        </table>
                                    </td>
                                }

                            </tr>
                            <tr><td height="100">&nbsp;</td></tr>
                            <tr><td valign="top" height="200">&nbsp;</td></tr>
                            <tr><td valign="top">&nbsp;</td></tr>
                            <tr><td valign="top">&nbsp;</td></tr>
                        </table>
                    </td>
                    <td align="left" valign="top">&nbsp;</td>
                </tr>
                <!--- Report Footer with Address Include -->
                @Html.Partial("_ReportFooterAddress")
            </table>

        </page>
    }
}
<style>
    .td1 {
        font-size: 15px;
        width: 30%;
        font-family: Calibri;
    }
    .td2 {
        font-size: 15px;
        width: 45%;
        font-family: Calibri;
    }
</style>



