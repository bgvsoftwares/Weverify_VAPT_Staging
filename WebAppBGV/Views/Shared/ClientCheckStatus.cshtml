@using WebAppBGV.CommonMethods;
@model  ViewModels.ClientViewModel.ClientServiceListViewModel
@{
    ViewBag.Title = "Candidate Check Details Info";
    Layout = null;
}


<!DOCTYPE html>

<html>
<head>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/modernizr-2.8.3.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
</head>
<body>
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-12">
                    <div class="row">                       
                    </div>
                    @if (Model != null && Model.ClientServiceChecks != null)
                    {
                        <div class="row">
                            <div class="col-md-12 table">
                                @{

                                    WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                    grid.Bind(Model.ClientServiceChecks, autoSortAndPage: false, rowCount: Model.TotalRecords);
                                }
                                @grid.GetHtml(
                                                  htmlAttributes: new { id = "grid", @class = "table" },
                                                  headerStyle: "thead-inverse",
                                                  rowStyle: "ordertxt",
                                                  footerStyle: "custpaging",
                                                  mode: WebGridPagerModes.All,
                                                  columns: new[]
                                                  {
                                                                grid.Column(header: "No.", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                                grid.Column(columnName: "SecuritasID", header: "Company Ref No", canSort: false, style:"td-3"),
                                                                grid.Column(columnName: "CheckName", header: "Check Name", canSort: false, style:"td-2"),
                                                                grid.Column(columnName: "CheckStatus", header: "Check Status", canSort: false, style:"td-2"),
                                                                grid.Column(columnName: "orderDate", header: "Order Date", canSort: false, style:"td-2"),
                                                                grid.Column(columnName: "outDate", header: "Out Date", canSort: false, style:"td-2"),
                                                                grid.Column(columnName: "ColorName", header: "ColorName", canSort: false, style:"td-2"),                                                      

                                                  }
                                           )
                                <div class="total-record">Total Records: @Model.TotalRecords</div>
                                <br />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
