<div class="row">
    <div class="col-md-4">
        <div class="logo_inner">BGV</div>
    </div>
    @if (Session["CRPUserName"] != null)
    {
        <div class="col-md-6">
            @if (Session["Designation"] != null)
            {
                <div class="user-top" style="font-size: 18px;color: #111!important;">@Session["TeamMemberName"].ToString() - (@Session["Designation"])</div>
            }
            else
            {
                <div class="user-top" style="font-size: 18px;color: #828282;">@Session["TeamMemberName"].ToString()</div>
            }
                <div class="text-right" style="font-size:13px;color:#bbbdbf;"><span style="font-size:1.1rem!important; color:#000;"><b>(Last Login- @Session["LastLoginTime"] )</b></span></div>
        </div>
        <div class="col-md-1 col-sm-1 col-xs-1 col-lg-1 col-xl-1 col-1" style="margin-left:10px;">
            <button class="logout-btn" type="button">
                @Html.ActionLink("LogOut", "Logout", "Account", new { area = "" }, new { @class = "" })<i class="fa fa-sign-out" aria-hidden="true"></i>
            </button>
        </div>
    }
    else
    {
        <div class="col-md-6">
            <div class="user-top">&nbsp;</div>
        </div>
        <div class="col-md-1">
            <div class="logoff">&nbsp;</div>
        </div>
    }
</div>


<style>
    .user-top {
        font-size: 14px !important;
        color: #fff !important;
        text-align: right !important;
        margin-top: 13px !important;
        font-weight: 700 !important;
    }

    .logo_inner {
        font-size: 30px !important;
        color: #231f20 !important;
        margin-left: 0px !important;
        margin-top: 7px !important;
    }

    .logout-btn {
        font-family: Hack, monospace;
        background: transparent;
        color: #111 !important;
        cursor: pointer;
        font-size: 1.6rem;
        border: 0;
        transition: all 0.5s;
        border-radius: 10px;
        width: auto;
        position: relative;
        min-width: 100px;
        border: .01rem solid #dddddd;
        margin-top: 12px !important;
        border-radius: 3px !important;
    }

        .logout-btn a {
            color: #111 !important;
        }

            .logout-btn a:hover {
                color: #fff !important;
            }

        .logout-btn .fa-sign-out {
            content: "\f2f5";
            /*font-family: "Font Awesome 5 Pro";*/
            font-weight: 400;
            position: absolute;
            left: 80%;
            top: 54%;
            right: 0;
            bottom: 0;
            opacity: 0;
            transform: translate(-50%, -50%);
        }

        .logout-btn:hover {
            background: #2b2bff;
            transition: all 0.5s;
            border-radius: 10px;
            box-shadow: 0px 6px 15px #0000ff61;
            padding: .40rem 3rem .40rem .40rem;
            color: #fff !important;
        }

        .logout-btn .fa-sign-out {
            opacity: 1;
            transition: all 0.5s;
            color: #fff !important;
        }
</style>