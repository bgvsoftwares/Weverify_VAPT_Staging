<style>
    body {
        font-size: 14px !important;
    }
    .counter{
        font-size:20px!important;
    }
    .tile-stats,.count {
        top: 5px!important;
        font-size:30px!important;
    }
    .count_top {
        text-align: center;
        padding: 5px;
        font-size: 12px !important;
    }
    .tile-stats1 {
        box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
        transition: 0.3s;
        height: 75px;
        border-radius: 5px;
        background: #eaeaea;
        color:#000;
        font-size:12px!important;
        width:150px!important;
    }

        .tile-stats1:hover {
            box-shadow: 20px 25px 24px 15px rgba(0,0,0,0.2);
        }
    
    .x_title {
        text-align: center;
        box-shadow: 0px 1px 9px #ccc;
        background: #808184;
        color: #fff;
    }
    .tile-stats {
        position: relative;
        display: block;
        margin-bottom: 11%;
        margin-top: -1px;
        overflow: hidden;
        padding-bottom: 9%;
        -webkit-background-clip: padding-box;
        -moz-border-radius: 0px;
        -moz-background-clip: padding;
        border-radius: 0;
        background: #eaeaea;
        transition: all .3s ease-in-out;
        z-index: 0;
        border-radius: 10px !important;
        box-shadow: 30px 30px 30px #1b1c1b, !important;
        transition: 0.3s;
        box-shadow: 0 8px 12px 0 rgba(0,0,0,0.2);
        cursor: pointer;
        width:260px!important;
    }
        .tile-stats > h4{
            color:#000;
        }

        .tile-stats .icon {
            color: #11c9b7;
        }

    .tile_count {
        background: none !important;
        padding: 0px !important;
        border-radius: 5px;
    }

    .count {
        color: #000 !important;
        text-align:center;
        margin:0px!important;
    }
        
        .tile-stats:hover {
            box-shadow: 20px 25px 24px 15px rgba(0,0,0,0.2);
        }
        
 
    .tile-stats .icon {
        width: 20px !important;
        height: 20px !important;
        color: #0375b3b0 !important;
        position: absolute !important;
        left: 12px !important;
        top: 10px !important;
        z-index: 1 !important;
    }

    .tile-stats > h4 {
        margin: 10px 0 0 3% !important;
        font-weight: 500 !important;
    }
    .tile_stats_count{
        margin-right:70px;
       
    }
    @@media only screen and (max-width: 760px) {
        .tile-stats {
            width: 25rem;
        }
    }

    @@media only screen and (max-width: 573px) {
        .tile-stats {
            width: 40rem !important;
        }
    }
</style>