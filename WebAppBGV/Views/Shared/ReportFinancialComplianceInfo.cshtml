@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    var list = Model.SpecialInfoModel.Where(x => x.SubcheckRowID == 365 || x.SubcheckRowID == 1005 || x.SubcheckRowID == 1092)
        .GroupBy(x => x.SubcheckRowID).Select(g => g.First()).ToList();

}

@if (Model.CandidateDocList != null)
{
    int j = 1;
    foreach (var a in list)
    {
        int K = 1;
        foreach (var Doc in Model.CandidateDocList.Where(w => w.SubCheckRowID == a.SubcheckRowID))
        {
            if (Doc.SubCheckRowID == a.SubcheckRowID)
            {
                FileInfo fin = new FileInfo(Server.MapPath(Model.DocPath + Doc.DocFile));
                if (fin.Exists && (fin.Extension.ToLower().Contains(".jpg") || fin.Extension.ToLower().Contains(".jpeg") || fin.Extension.ToLower().Contains(".png")))
                {
                    <page id="PrintSrc" size="A4">
                        <div style="page-break-after:always ;"></div>
                        <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;">
                            <tr>
                                <td valign="top" style="height:50rem;">
                                    <table cellpadding="2" cellspacing="5" id="tblDemo" style="width:100%;">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    @if (j == 1)
                                                    {
                                                        <p style="color: #8D5FFF; font-size: 32px; font-weight: bold; padding-left: 35px !important; padding-top: 35px !important;"> Level 3 – Financial Compliance </p>

                                                        j++;
                                                    }
                                                    @if (K == 1)
                                                    {
                                                        <ul style="padding-left: 55px !important; padding-top: 10px;">
                                                            <li style="color: #55419E; font-size: 24px; font-weight: bold;">@a.SubCheckName</li>
                                                        </ul>

                                                        K++;
                                                    }

                                                    @if (K == Doc.Count || Doc.Count == 0)
                                                    {
                                                        K = 0;
                                                    }

                                                    <table width="793" cellspacing="0" height="700" cellpadding="0" align="center" style="align-content:center">
                                                        <tr style="text-align:center">
                                                            <td valign="top" style="padding-top: 34px;">
                                                                @{
                                                                    FileStream fs = new FileStream(Server.MapPath(Model.DocPath + Doc.DocFile), FileMode.Open, FileAccess.Read);
                                                                    System.Drawing.Image image = System.Drawing.Image.FromStream(fs);


                                                                    <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" width="730" height="550" />

                                                                }
                                                            </td>
                                                        </tr>
                                                    </table>

                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </page>
                }
            }
        }
    }
}
