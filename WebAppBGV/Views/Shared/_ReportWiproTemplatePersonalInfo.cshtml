
<table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;border-collapse:collapse; border-spacing: 0">
    <tr>
        <td valign="top" align="center" style="height:60rem;">
            <table border="0" cellpadding="2" cellspacing="0" id="tblDemo" style="width:100%; font-family:Arial;font-size:13px;">
                <tr>
                    <td valign="top" style="width:100%; text-align:end;"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem; margin-top:10px; margin-right:10px;"></td>
                </tr>
            </table>

            <table border="0" cellpadding="2" cellspacing="0" id="tblDemo" style="width:95%; font-family:Calibri;font-size:13px;border-collapse:collapse;">
                <tbody>
                    <tr>
                        <td style="font-weight:bolder!important; font-size:18pt!important; border: none!important; font-family: Calibri; -webkit-print-color-adjust: exact;" colspan="4" align="center" height="20">Background Verification Report</td>
                    </tr>

                    <tr>
                        @if ((Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS") && (Model.Report_Type != "Final"))
                        {
                            <td style="font-size:10pt!important; font-family:'Calibri',sans-serif; -webkit-print-color-adjust: exact; font-weight:bolder!important;" colspan="4" align="center" height="20">(Interim)</td>
                        }
                        else
                        {
                            if (Model.Report_Type != "1")
                            {

                                if (Model.BGV1ColorName.ToUpper().Contains("DRAFT") || Model.BGV2ColorName.ToUpper().Contains("DRAFT"))
                                {
                                    <td style="font-size:10pt!important; font-family:'Calibri',sans-serif; -webkit-print-color-adjust: exact; font-weight:bolder!important;" colspan="4" align="center" height="20">(DRAFT)</td>

                                }
                                else
                                {
                                    <td style="font-size:10pt!important; font-family:'Calibri',sans-serif; -webkit-print-color-adjust: exact; font-weight:bolder!important;" colspan="4" align="center" height="20">(Final)</td>

                                }

                            }
                            else
                            {
                                if (Model.BGV1ColorName.ToUpper().Contains("DRAFT") || Model.BGV2ColorName.ToUpper().Contains("DRAFT"))
                                {
                                    <td style="font-weight:bolder!important; font-size:10pt!important; font-family:'Calibri',sans-serif; -webkit-print-color-adjust: exact;" colspan="4" align="center" height="20">(DRAFT)</td>

                                }
                                else
                                {
                                    <td style="font-weight:bolder!important; font-size:10pt!important; font-family:'Calibri',sans-serif; -webkit-print-color-adjust: exact;" colspan="4" align="center" height="20">(Final)</td>

                                }

                            }
                        }
                    </tr>
                    <tr>
                        <td style="margin-top: 1em; font-size:12pt!important; font-weight: bolder; font-family:'Calibri',sans-serif;" colspan="3" align="left">Section 1: Case Detail</td>
                    </tr>
                    <tr>
                        <td>
                            &nbsp;
                        </td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 35%; border: 1px solid #000;font-size:10pt!important;font-family:'Calibri',sans-serif;">Candidate Name/Employee Name as per iverify</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2" width="50%">@Model.PersonalName</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">Client Name</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.EntityName</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">Country</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">India</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">Account Name</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.ClientRefID</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">BGV Pattern Name</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.ProcessName</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">BGV Assigned Date</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.OrderDate.ToString("dd-MMM-yyyy")</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">BGV Report Date</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">

                            @if (Model.ReportDate != null)
                            {<span>@Model.ReportDate.ToString("dd-MMM-yyyy")</span> }
                        else
                        { <span>N/A</span>}

                        </td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">Vendor Reference ID</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.CompanyRefNo</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">Wipro Reference ID</td>
                        <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.EmploymentId</td>
                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;">BGV1 Color Code</td>
                        @if (Model.ReportStatus == "Final" && Model.EntityName.Contains("Internal"))
                        {
                            <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000; color:@Model.FinalColorCode; -webkit-print-color-adjust: exact; font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.FinalColor.ToUpper()</td>


                        }
                        else
                        {
                            if (Model.BGV1ColorCode != "")
                            {
                                if (Model.BGV1ColorName.ToUpper().Contains("DRAFT"))
                                {
                                    <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;-webkit-print-color-adjust: exact;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.BGV1ColorName.ToUpper()</td>

                                }
                                else
                                {
                                    <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000; color:@Model.BGV1ColorCode; -webkit-print-color-adjust: exact; font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.BGV1ColorName.ToUpper()</td>

                                }

                            }
                            else
                            {
                                <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;" colspan="2">NA</td>

                            }
                        }

                    </tr>
                    <tr>
                        <td style="padding-left: 5px; width: 49.9121%; border: 1px solid #000000;"><span style="font-size: 17px!important; font-family: Calibri, sans-serif;font-size:10pt!important;font-family:'Calibri',sans-serif;">BGV2 Color Code</span></td>
                        @if (Model.BGV2ColorCode != "" && !Model.EntityName.Contains("Internal"))
                        {
                            if (Model.BGV2ColorName.ToUpper().Contains("DRAFT"))
                            {
                                <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;-webkit-print-color-adjust: exact;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.BGV2ColorName.ToUpper()</td>

                            }
                            else
                            {
                                <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000; color:@Model.BGV2ColorCode;  -webkit-print-color-adjust: exact;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">@Model.BGV2ColorName.ToUpper()</td>

                            }

                        }
                        else
                        {
                            <td style="padding-left: 5px; width: 49.9122%; border: 1px solid #000000;font-size:10pt!important;font-family:'Calibri',sans-serif;" colspan="2">NA</td>

                        }
                    </tr>
                </tbody>
            </table>
            <table border="1" cellpadding="2" cellspacing="5" id="tblDemo" style="width: 95%; margin-top: 1rem !important; margin: auto; border-collapse: collapse; font-family: 'Calibri',sans-serif; font-size: 10pt">
                <tr>
                    <td width="30%" style="-webkit-print-color-adjust:exact;  background-color:red" align="center">RED</td>
                    <td width="35%" style=" -webkit-print-color-adjust:exact;" align="center">DRAFT</td>
                    <td width="30%" style="-webkit-print-color-adjust:exact; background-color:green" align="center">GREEN</td>
                </tr>
                <tr>
                    <td height="30px" valign="top" align="center">Fail</td>
                    <td align="center" valign="top">Discrepancy/Unable to Verify/Additional Information Required</td>
                    <td align="center" valign="top">Clear</td>
                </tr>
            </table>
        </td>
    <tr>
    <tr>
        <td valign="bottom" style="height:0px!important;">
            <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                <tbody>
                    <tr>
                        <td style="border-top:2px solid rgb(190, 190, 190);" colspan="3">
                            &nbsp;
                        </td>
                    </tr>
                    <tr>
                        <td width="20%"><br><br><br><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                        <td width="1%">&nbsp;</td>
                        <td width="79%">
                            <p style="font-size:16px; font-family: Calibri, sans-serif; color:#000080; font-weight:500; text-align:center; margin:0px 0px 0px 0px;"><img src="~/Images/StampSignatureUpdated.jpg" width="60" height="60"></p>
                            <p style="font-size:16px; font-family: Calibri, sans-serif; color:#000080; font-weight:700; text-align:center; margin:0px 0px 0px 0px;">SECURITAS INDIA</p>
                            <p style="font-size:16px;font-family: Calibri, sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp; &nbsp;Tel: + 91 124 4718888</p>
                            <p style="font-size:16px; font-family: Calibri, sans-serif; color:#3a00ff; text-align:center; margin:5px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a> <span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </td>
    </tr>
</table>
<style>
    @@media print {
        #PrintSrc {
            font-family: 'Calibri', sans-serif;
        }
    }
</style>