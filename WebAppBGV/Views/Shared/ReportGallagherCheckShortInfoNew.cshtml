<page id="PrintSrc" size="A4">
    <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; height:75rem;page-break-after:always!important;">
        <tr>
            <td valign="top">
                <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                    <tr>
                        <td>
                            <table border="0" cellspacing="0" cellpadding="0" style="width:100%;">
                                <tr>
                                    <td>
                                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td valign="top" style="width:100%; text-align:end;"><img src='~/Content/Securitas_AB_logo.svg.png' style="width:5rem; margin-top:10px; padding: 10px;"></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        &nbsp;
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <table style="width:100%;">
                                            <tr>
                                                <td style="margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:18px;font-family:'Calibri',sans-serif;color:darkblue;text-align:center; font-weight: bolder; text-decoration: underline;">Background Verification Report – Executive Summary</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <table style="border: none; width:98%; border-collapse:collapse; margin: auto;">
                                            <tbody>
                                                @{
                                                    string checkName = string.Empty;
                                                    foreach (var item in Model.PersonalChecksBriefDetails)
                                                    {

                                                        if (checkName != item.CheckFName)
                                                        {

                                                            <tr>
                                                                <td colspan="3" style="width:562.0pt;border:solid windowtext 1.0pt;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                    <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><strong><span style="font-family: Calibri, sans-serif; font-size: 16px;">@item.CheckFName</span></strong></p>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="width:205.3pt;border:solid windowtext 1.0pt;border-top:  none;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                    <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Type of Check</strong></span></p>
                                                                </td>
                                                                <td style="width:226.7pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                    <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Brief Details</strong></span></p>
                                                                </td>
                                                                <td style="width:130.0pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                    <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Status (Color)</strong></span></p>
                                                                </td>
                                                            </tr>
                                                            checkName = item.CheckFName;
                                                        }
                                                        <tr>
                                                            <td style="width:205.3pt;border:solid windowtext 1.0pt;border-top:  none;padding:0cm 5.4pt 0cm 5.4pt;height:31.5pt;">
                                                                <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong></strong><a href="#@item.subCheckId">@item.SubCheckFName.TrimEnd(' ') </a></span></p>
                                                            </td>
                                                            <td style="width: 226.7pt;border-color: currentcolor windowtext windowtext currentcolor;border-style: none solid solid none;border-width: medium 1pt 1pt medium;padding: 0cm 5.4pt;height: 31.5pt;vertical-align:central;">
                                                                <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>@item.SubCheckDetail</strong></span></p>
                                                            </td>

                                                            @if (@item.Status == "Not Applicable")
                                                            {
                                                                <td style="width:130.0pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:@item.ColorCode;padding:0cm 5.4pt 0cm 5.4pt;height:31.5pt;">
                                                                    <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Not Applicable</strong></span></p>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td style="width:130.0pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:@item.ColorCode;padding:0cm 5.4pt 0cm 5.4pt;height:31.5pt;">
                                                                    <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>@item.ColorName</strong></span></p>
                                                                </td>
                                                            }

                                                        </tr>
                                                    }
                                                }

                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <!--- Report Footer with Address Include aa -->
        <tr>
            <td @*colspan="2"*@ height="100">
                <table border="0" cellspacing="0" cellpadding="0" style="width:100%;" id="tblDemo2">
                    <tr>
                        <td colspan="3" style="border-top:3px solid #c0c0c0;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td valign="bottom" width="20%"><img src="~/Images/Walsons-Report-footer.png" style="width:7rem; margin-left: 15px; margin-bottom: 15px;"></td>
                        <td width="1%">&nbsp;</td>
                        <td width="79%">
                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>
                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin: 0px 0px 5px 0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</page>