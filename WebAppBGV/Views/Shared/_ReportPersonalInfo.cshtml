
@if (Model != null)
{
<page id="PrintSrc" size="A4">
    @if (Model.ReportTemplate == 12)
    {
        <div style="page-break-before:avoid;"></div>
    }
    @if (Model.ClientRowID == 268 || Model.ClientRowID == 3 || Model.ClientRowID == 336 || Model.ClientRowID == 1534 || Model.ClientRowID == 1487 || Model.ClientRowID == 871 || Model.ClientRowID == 939 || Model.ClientRowID == 943 ||
         Model.ClientRowID == 951 || Model.ClientRowID == 1202 || Model.ClientRowID == 1306 || Model.ClientRowID == 1381 || Model.ClientRowID == 1655 || Model.ClientRowID == 1722 || Model.ClientRowID == 1706
         || Model.ClientRowID == 1557 || Model.ClientRowID == 1717 || Model.ClientRowID == 1688 || Model.ClientRowID == 1762 || Model.ClientRowID == 1776 || Model.ClientRowID == 926 || Model.ClientRowID == 1656
         || Model.ClientRowID == 1741 || Model.ClientRowID == 1738 || Model.ClientRowID == 1465 || Model.ClientRowID == 1756 || Model.ClientRowID == 1757 || Model.ClientRowID == 1584 || Model.ClientRowID == 1754
         || Model.ClientRowID == 1707 || Model.ClientRowID == 1279 || Model.ClientRowID == 1391 || Model.ClientRowID == 1396 || Model.ClientRowID == 1402 || Model.ClientRowID == 1459 || Model.ClientRowID == 881 ||
         Model.ClientRowID == 1460 || Model.ClientRowID == 1480 || Model.ClientRowID == 1507 || Model.ClientRowID == 1509 || Model.ClientRowID == 1628
         || Model.ClientRowID == 1565 || Model.ClientRowID == 1572 || Model.ClientRowID == 1565 || Model.ClientRowID == 1619 || Model.ClientRowID == 1620 || Model.ClientRowID == 1609 || Model.ClientRowID == 1613 || Model.ClientRowID == 717)
    {
        <table cellspacing="0" cellpadding="0" align="center" style="width:100%; height:72rem;">
            <!--- Report Header Include -->
            @Html.Partial("_ReportHeader")
            <!--- Report Header Include -->
            <tr>
                @if (Model.ClientRowID == 268 || Model.ClientRowID == 3 || Model.ClientRowID == 336 || Model.ClientRowID == 1534 || Model.ClientRowID == 1487 || Model.ClientRowID == 871 || Model.ClientRowID == 939 || Model.ClientRowID == 943 ||
                     Model.ClientRowID == 951 || Model.ClientRowID == 1202 || Model.ClientRowID == 1306 || Model.ClientRowID == 1381 || Model.ClientRowID == 1655 || Model.ClientRowID == 1722 || Model.ClientRowID == 1706
                     || Model.ClientRowID == 1557 || Model.ClientRowID == 1717 || Model.ClientRowID == 1688 || Model.ClientRowID == 1762 || Model.ClientRowID == 1776 || Model.ClientRowID == 926 || Model.ClientRowID == 1656
                     || Model.ClientRowID == 1741 || Model.ClientRowID == 1738 || Model.ClientRowID == 1465 || Model.ClientRowID == 1756 || Model.ClientRowID == 1757 || Model.ClientRowID == 1584 || Model.ClientRowID == 1754
                     || Model.ClientRowID == 1707 || Model.ClientRowID == 1279 || Model.ClientRowID == 1391 || Model.ClientRowID == 1396 || Model.ClientRowID == 1402 || Model.ClientRowID == 1459 || Model.ClientRowID == 881 ||
                     Model.ClientRowID == 1460 || Model.ClientRowID == 1480 || Model.ClientRowID == 1507 || Model.ClientRowID == 1509 || Model.ClientRowID == 1628
                     || Model.ClientRowID == 1565 || Model.ClientRowID == 1572 || Model.ClientRowID == 1565 || Model.ClientRowID == 1619 || Model.ClientRowID == 1620 || Model.ClientRowID == 1609 || Model.ClientRowID == 1613 || Model.ClientRowID == 717)
                {
                    <td valign="top" width="100%">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0">                            
                                @Html.Partial("TCSFUllInfo")
                        </table>
                    </td>
                }
                else
                {
                    <td width="2%" align="left" valign="bottom">&nbsp;</td>
                    <td valign="top">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0">

                            @if (Model.ClientRowID == 762 && Model.ReportPart == "OFAC")
                            {
                                @Html.Partial("OFACPersonalInfo")
                            }
                            else if (Model.ClientRowID == 446 || Model.ClientRowID == 990)//Tech Mahindra Limited (446)
                            {
                                @Html.Partial("_ReportTemplatePersonalInfoTechM9")
                            }
                            else if (Model.ClientRowID == 1219)
                            {
                                @Html.Partial("ReportPersonalInfo_Tiger")
                            }
                            else if (Model.ClientRowID == 1436 || Model.ClientRowID == 1440 || Model.ClientRowID == 1441 || Model.ClientRowID == 1442 || Model.ClientRowID == 1443)
                            {
                                @Html.Partial("ReportPersonalInfo_Datamatics")

                            }
                            else if (Model.ClientRowID == 1428)
                            {
                                @Html.Partial("ReportPersonalInfoGen_EUR")
                            }
                            else
                            {
                                @Html.Partial("ReportPersonalInfo")
                            }
                        </table>
                    </td>
                    <td align="left" valign="top">&nbsp;</td>
                }

            </tr>
            <!--- Report Footer with Address Include aa -->
            @if (Model.ClientRowID == 446 || Model.ClientRowID == 990)
            {
                @Html.Partial("_ReportFooterAddress")
            }
        </table>
    }
    else
    {
        if (Model.ClientRowID == 7 || Model.ClientRowID == 296 || Model.ClientRowID == 305 || Model.ClientRowID == 306 || Model.ClientRowID == 987 || Model.ClientRowID == 761 || Model.ClientRowID == 1590)
        {
            <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;">
                <tr>
                    <td valign="top">
                        <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                            <tr>
                                <td valign="top" style="display:block;margin-bottom:30rem;">
                                    @Html.Partial("ReportPersonalInfo")
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        }
        else
        {
            <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; height:72rem;">
                <tr>
                    <td valign="top">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0">

                            @if (Model.ClientRowID == 762 && Model.ReportPart == "OFAC")
                            {
                                @Html.Partial("OFACPersonalInfo")
                            }
                            else if (Model.ClientRowID == 446 || Model.ClientRowID == 990)//Tech Mahindra Limited (446)
                            {
                                @Html.Partial("_ReportTemplatePersonalInfoTechM9")
                            }
                            else if (Model.ClientRowID == 1219)
                            {
                                @Html.Partial("ReportPersonalInfo_Tiger")
                            }
                            else if (Model.ClientRowID == 1436 || Model.ClientRowID == 1440 || Model.ClientRowID == 1441 || Model.ClientRowID == 1442 || Model.ClientRowID == 1443)
                            {
                                @Html.Partial("ReportPersonalInfo_Datamatics")

                            }
                            else if (Model.ClientRowID == 1428)
                            {
                                @Html.Partial("ReportPersonalInfoGen_EUR")
                            }
                            else
                            {
                                if (Model.ClientRowID == 1470)
                                {
                                    @Html.Partial("CapcoPersonalInfo")
                                }
                                else if (Model.ClientRowID == 1803)
                                {
                                    @Html.Partial("ReportPersonalEXLInfo")
                                }
                                else if (Model.ClientRowID == 707)
                                {
                                    @Html.Partial("ReportPersonalInfoMore")
                                }
                                else
                                {
                                    @Html.Partial("ReportPersonalInfo")
                                }
                            }
                        </table>
                    </td>
                </tr>
                <!--- Report Footer with Address Include aa -->
                @if (Model.ClientRowID == 446 || Model.ClientRowID == 990)
                {
                    @Html.Partial("_ReportFooterAddress")
                }
            </table>
        }

    }


</page> 
    if (Model.ClientRowID != 446 && Model.ClientRowID != 559 && Model.ClientRowID != 1481)
    {
        if (Model.CandidateCaseDocList != null)
        {
            foreach (var Doc in Model.CandidateCaseDocList)
            {
                FileInfo fin = new FileInfo(Server.MapPath(Model.DocPath + Doc.DocFile));
                if ((fin.Exists && (fin.Extension.ToLower().Contains(".jpg") || fin.Extension.ToLower().Contains(".jpeg") || fin.Extension.ToLower().Contains(".png"))) && Doc.DocumentType != "Candidate Photo")
                {
                    <page id="PrintSrc" size="A4">
                        <div style="page-break-after:always ;"></div>
                        <table width="793" @*border="0"*@ cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999;">
                            <!--- Report Header Include -->
                            @Html.Partial("_ReportHeader")
                            <!--- Report Header Include -->
                            <tr>
                                <td width="2%" align="left" valign="bottom" @*style="border-left:2px solid #999999;"*@>&nbsp;</td>
                                <td valign="top">
                                    <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td valign="top">
                                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                    <tr>
                                                        <td>
                                                            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                                <tr>
                                                                    <td width="88%"><p style="font-size:16px;  color:#000000; text-align:center; font-weight:bold; text-decoration:underline; text-transform:none; margin:0px;">@Doc.DocumentType</p></td>
                                                                    <td width="6%" valign="top"><img src='@Url.Content("~/Images/logo.jpg")' width="71" height="40"></td>
                                                                </tr>
                                                                <tr><td colspan="2">&nbsp;</td></tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="top">&nbsp;</td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="top">
                                                            @{
                                                                FileStream fs = new FileStream(Server.MapPath(Model.DocPath + Doc.DocFile), FileMode.Open, FileAccess.Read);
                                                                System.Drawing.Image image = System.Drawing.Image.FromStream(fs);

                                                                if (image.Height > 850)
                                                                {
                                                                    <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" width="644" style="height:850px;" />
                                                                }
                                                                else
                                                                {
                                                                    <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" width="644" />
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                </table>
                                        </tr>
                                    </table>
                                </td>
                                <td @*style="border-right:2px solid #999999;"*@ align="left" valign="top">&nbsp;</td>
                            </tr>
                            <!--- Report Footer with Address Include -->
                            @Html.Partial("_ReportFooterAddress")
                            <!--- Report Footer with Address Include -->
                            <!--- Report Footer Include -->
                            @Html.Partial("_ReportFooter")
                            <!--- Report Footer Include -->
                        </table>
                    </page>
                }
            }
        }
    }


}