<div class="row">
    <div class="col-md-12">
        <div class="top_buton_bg" id="url-none">
            @ViewBag.NavigationBtnBack
            @ViewBag.NavigationBtnAddNew
            @ViewBag.NavigationBtnExportExcel
            @ViewBag.NavigationBtnExportExcel1
            @ViewBag.NavigationBtnExportWord
            @ViewBag.NavigationBtnBackExportPDF
        </div>
    </div>
</div>
<script>window.onload = function () {
          const targetUrl = "ClientServicing/AnnexureInvoicing";
          const currentUrl = window.location.href;
                  if (currentUrl.includes(targetUrl)) {
              const element = document.getElementById("url-none");
              if (element) {
                  element.classList.add("move-excel");
              }
          }
};
</script>
<style>
    .move-excel {
        text-align: start !important;
        padding: 10px;
    }
</style>