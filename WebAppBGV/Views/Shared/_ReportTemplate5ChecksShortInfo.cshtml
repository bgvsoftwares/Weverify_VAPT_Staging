<tr>
    <td valign="top">
        <table width="100%" border="0" cellspacing="0" cellpadding="0">
            @*<tr><td width="6%" align="right"><img src='@Url.Content("/Images/footer-logo.jpg")' width="100" height="60"></td></tr>*@
            <tr>
                <td>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>                            
                            <td width="94%"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">BACKGROUND  CHECK REPORT - SUMMARY</p></td>
                            
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td valign="top">
                    <table width="100%" border="1" cellpadding="2" cellspacing="5">
                        @{
                            string checkName = string.Empty;
                            <tr>
                                <td width="20%" style="font-size:12px; font-family:Calibri; color-adjust:exact;  padding-left:5px;"><strong>TYPE OF CHECK</strong></td>
                                <td width="50%" style="font-size:12px; font-family:Calibri; color-adjust:exact;; text-align:center;"><strong>VERIFICATION STATUS (VERIFIED / NOT APPLICABLE)</strong></td>
                                <td width="17%" style="font-size:12px; font-family:Calibri; color-adjust:exact;  text-align:center;"><strong>BGC STATUS</strong></td>
                            </tr>
                            foreach (var item in Model.PersonalChecksBriefDetails)
                            {
                                if (checkName != item.CheckFName)
                                {


                                    <tr>
                                        <td colspan="4" bgcolor="#c0c0c0" style="font-size:12px; font-family:Calibri; color-adjust:exact; background:#c0c0c0; padding:5px; text-align:left;"> <strong> @item.CheckFName</strong></td>
                                    </tr>
                                    checkName = item.CheckFName;
                                }
                                <tr style=" font-size:12px; font-weight:bold; padding:5px;">
                                    <td style="padding-left:5px; font-size:12px; font-family:Calibri;">@item.SubCheckFName</td>
                                    <td align="center" style="font-size:12px; font-family:Calibri;">@item.SubCheckDetail</td>
                                    @if (@item.Status == "Not Applicable")
                                    {
                                        <td style="color-adjust:exact; font-size:12px; font-family:Calibri; background:@item.ColorCode;" align="center">Not Applicable</td>
                                    }
                                    else
                                    {
                                        <td style="color-adjust:exact; font-size:12px; font-family:Calibri; background:@item.ColorCode;" align="center">@item.ColorName</td>
                                    }
                                    @*<td style="color-adjust:exact; font-size:12px; font-family:Calibri; background:@item.ColorCode;" align="center">@item.ColorName</td>*@
                                </tr>
                            }
                        }
                        <tr>
                            <td colspan="3"><img src='@Url.Content("~/Images/Signature.JPG")' width="100%"></td>
                        </tr>

                    </table>
                </td>
            </tr> 
        </table>
    </td>
</tr>

