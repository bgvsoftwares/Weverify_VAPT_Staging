@{Layout = null; }

<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

@*<script src="~/Scripts/jquery-3.7.1.min.js"></script>*@
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>


@{
    ViewBag.Title = "MIS";
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section DisplayTitle{ @Html.Partial("_DisplayTitleWoutNav") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row"><div class="col-md-12">&nbsp;</div></div>
<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            <div class="row">
                <div class="col-md-12">



                    <div class="form-group branch search-frame">
                        <label class="col-md-2 control-label">Case Created date From :</label>
                        <div class="col-md-3">
                            @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "dd-mm-yyyy" })
                        </div>
                        <label class="col-md-2 control-label">Case Created date To :</label>
                        <div class="col-md-3">
                            @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "dd-mm-yyyy" })
                        </div>
                    </div>
                    <div class="form-group branch search-frame text-center">
                        @*@Html.ActionLink("Export to Excel", "ExportCaseStatus", "ClientServicing", new { @class = "btn bun-bg btn-default", id = "btnExportCaseStatus" })*@


                        <input type="submit" id="btnE2EMIS" value="MIS" class="btn bun-bg btn-default" />

                    </div>

                </div>
            </div>



        </div>
    </div>
</div>



@section Scripts{
    @*<script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>*@
    <script type="text/javascript">

        $(document).ready(function () {
            $('#ClientRowID').val($('#hdnClientRowID').val());

            $('#CompletedToDate').datepicker({
                dateFormat: "mm-dd-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "mm-dd-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });

            $('#btnE2EMIS').click(function () {
                var client = $('#ClientRowID').val();
                var fromdate = $('#CompletedFromDate').val();
                var Todate = $('#CompletedToDate').val();
                if ($('#ClientRowID').val() != '') {


                    window.location.href = "@Url.Action("ExportAllDeptMISDateFilter", "Verification")?ClientRowId="
                        + client + "&fromdate=" + fromdate + " &Todate=" + Todate+"";

                }

            });
        });


    </script>
}

