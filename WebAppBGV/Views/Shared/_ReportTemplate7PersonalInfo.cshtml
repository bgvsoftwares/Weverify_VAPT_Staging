<tr>
    <td valign="top">
        <table width="100%" border="0" cellspacing="0" cellpadding="0">
            <tr>
                <td>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td colspan="2" width="94%"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Background Verification Report – Executive Summary</p></td>

                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td valign="top">
                    <table width="100%" border="1" cellpadding="2" cellspacing="5">
                        @{
                            <tr>
                                <td width="20%" style="font-size:12px; font-family:Calibri; color-adjust:exact; background:#c0c0c0; padding-left:5px;"><strong>Verified Data</strong></td>
                                <td width="50%" style="font-size:12px; font-family:Calibri; color-adjust:exact; background:#c0c0c0; text-align:center;"><strong>Particulars</strong></td>
                                <td width="17%" style="font-size:12px; font-family:Calibri; color-adjust:exact; background:#c0c0c0; text-align:center;"><strong>Status (Color)</strong></td>
                            </tr>
                            string checkName = string.Empty;
                            foreach (var item in Model.PersonalChecksBriefDetails)
                            {
                                if (checkName != item.CheckFName)
                                {
                                    @*<tr>
                                            <td colspan="4" bgcolor="#c0c0c0" style="font-size:12px; font-family:Calibri; color-adjust:exact; background:#c0c0c0; padding:5px; text-align:center;"> <strong> @item.CheckFName</strong></td>
                                        </tr>*@

                                    checkName = item.CheckFName;
                                }
                                <tr style=" font-size:12px; font-weight:bold; padding:5px;">
                                    <td style="padding-left:5px; font-size:10px; font-family:Calibri;">@item.SubCheckFName</td>
                                    <td align="center" style="font-size:10px; font-family:Calibri;">@item.SubCheckDetail</td>
                                    @if (@item.Status == "Not Applicable")
                                    {
                                        <td style="color-adjust:exact; font-size:10px; font-family:Calibri; background:@item.ColorCode;" align="center">Not Applicable</td>
                                    }
                                    else
                                    {
                                        <td style="color-adjust:exact; font-size:10px; font-family:Calibri; background:@item.ColorCode;" align="center">@item.ColorName</td>
                                    }
                                    @*<td style="color-adjust:exact; font-size:10px; font-family:Calibri; background:@item.ColorCode;" align="center">@item.ColorName</td>*@
                                </tr>
                            }

                            <tr>

                                <td width="20%" style="font-size:12px; font-family:Calibri; vertical-align:text-top; color-adjust:exact;  padding-left:5px;"><strong>FINAL STATUS</strong></td>
                                @*<td width="50%" colspan="2" style="font-size:12px;  font-family:Calibri; color-adjust:exact;  text-align:center;"><strong>@Model.FinalColor</strong></td>*@
                                <td width="50%" colspan="2" style=" padding-left:5px;  font-family:Calibri; color-adjust:exact; background:@Model.FinalColorCode;" align="center"><label for="">@Model.FinalColor</label></td>

                            </tr>


                            <tr>
                                <td width="20%" style="font-size:12px; font-family:Calibri; vertical-align:text-top; color-adjust:exact;  padding-left:5px;"><strong>SOW</strong></td>
                                <td height="70px" width="50%" colspan="2" style="font-size:12px;  font-family:Calibri; color-adjust:exact;  text-align:center;"><label for="">@Model.SOW</label><strong></strong></td>
                            </tr>
                        }
                    </table>
                </td>
            </tr>
        </table>
    </td>
</tr>
