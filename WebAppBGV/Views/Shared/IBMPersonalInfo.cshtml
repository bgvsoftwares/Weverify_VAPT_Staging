<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body style="font-family:'calibri';">
    <table style="width:100%; margin:auto; border: 3px solid #ccc; page-break-after:always;">
        <tr valign="top">
            <td style="height:0px;">
                <table style="width:100%;">
                    <tr valign="top">
                        <td style="text-align:left;height: 0px; width:25%;">
                            <img src="~/Content/images/Securitas-logo.png" style="width:40%;padding-right: 15px; padding: 5px 10px 0px 5px;">
                        </td>
                        <td colspan="3" style="width:50%;">
                            <p style="text-align: center;color: #808080;text-transform: uppercase;padding: 5px;font-weight: bolder;letter-spacing: 0.5px;font-size:24px; padding: 10px; font-family: 'Calibri',sans-serif;margin-bottom:10px!important;"><u sstyle="color:#808080;">Securitas India</u></p>
                        </td>
                        <td style="text-align:right;height: 0px;">
                            @if (Model.FinalColor.ToUpper() == "GREEN")
                            {
                                <img src="~/Images/IBMGreen.png" style="width: 60%;padding: 0px 10px 0px 0px;">
                            }
                            else if (Model.FinalColor.ToUpper() == "YELLOW")
                            {
                                <img src="~/Images/IBMYellow.png" style="width: 60%;padding: 0px 10px 0px 0px;">
                            }
                            else if (Model.FinalColor.ToUpper() == "RED")
                            {
                                <img src="~/Images/IBMRed.png" style="width: 60%;padding: 0px 10px 0px 0px;">
                            }

                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="width:100%;height:1px!important;" valign="top">
                <table style="width:100%;">
                    <tr>
                        @if (Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS")
                        {
                            <td colspan="3">
                                <p style="text-align: center;margin-left: 280px !important;border:2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;width:26%;font-weight: bolder;letter-spacing: 0.5px;font-size:16px; padding: 10px; font-family: 'Calibri',sans-serif;margin-bottom:10px!important;">REPORT TYPE INTERIM</p>
                            </td>
                        }
                        else if (Model.Report_Type != "1")
                        {
                            <td colspan="3">
                                <p style="text-align: center;margin-left: 280px !important;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;width:26%;font-weight: bolder;letter-spacing: 0.5px;font-size:16px; padding: 10px; font-family: 'Calibri',sans-serif;margin-bottom:10px!important;">REPORT TYPE FINAL</p>
                            </td>
                        }
                    </tr>
                </table>
            </td>
        </tr>
        <tr valign="top">
            <td style="height:0px;">
                <table style="width:100%; height:60rem;">
                    <tr>
                        <td style="height:3%; text-align: center; text-decoration: underline; font-weight: bolder;font-size: 16px; font-family: 'calibri';">EXECUTIVE SUMMARY</td>
                    </tr>
                    <tr valign="top">
                        <td style="height:1%;">&nbsp;</td>
                    </tr>
                    <tr valign="top">
                        <td style="height: 5%;">
                            <table style="margin-top:30px;border: none;border-collapse:collapse; margin: auto; width: 95%;">
                                <tbody>
                                    <tr>
                                        <td colspan="2" style="width:499.1pt;border:solid black 1.0pt;background:silver;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 14px;font-family:"calibri";text-align:center;'><strong><span style='font-size:14px;font-family:"calibri";color:black;'>Background Profile</span></strong></p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Employee Name</span></p>
                                        </td>
                                        <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:black;'>&nbsp;</span>@Model.PersonalName</p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Employee Number</span></p>
                                        </td>
                                        <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:black;'>&nbsp;</span>@Model.EmploymentId</p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Date of Birth</span></p>
                                        </td>
                                        <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            @try
                                            {
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";'>&nbsp;</span>@Model.DOB.ToString("dd-MMM-yyyy")</p>

                                            }
                                            catch
                                            {
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";'>&nbsp;</span>@Model.DOB</p>

                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'>
                                                <span style='font-size:12px;font-family:"calibri";'>Date case Initiated</span>

                                            </p>
                                        </td>
                                        <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'>
                                                <span style='font-size:12px;font-family:"calibri";'>&nbsp;</span>
                                                @if (Model.OrderDate != null)
                                                {@Model.OrderDate.ToString("dd-MMM-yyyy") }
                                            else
                                            { <span>N/A</span>}

                                            </p>
                                        </td>
                                    </tr>

                                    @if (Model.ClientRowID == 1199)
                                    {
                                        <tr>
                                            <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Start Date ( Per IBM Log)</span></p>
                                            </td>
                                            <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span>@DateTime.Now.Date.ToString("dd-MMM-yyyy")</p>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Date Report Due </span></p>
                                            </td>
                                            <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;"> 
                                                
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'>
                                                    <span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span>

                                                    @if(!string.IsNullOrEmpty(Model.TANnumberofCompany) )
                                                    {
                                                        Convert.ToDateTime(@Model.TANnumberofCompany).ToString("dd-MMM-yyyy");
                                                    }
                                                </p>
                                            </td>
                                        </tr>
                                    }
                                    <tr>
                                        <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Date Report Sent On</span></p>
                                        </td>
                                        <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span>@DateTime.Now.Date.ToString("dd-MMM-yyyy")</p>
                                        </td>
                                    </tr>

                                    @if (Model.ClientRowID == 1199)
                                    {
                                        <tr>
                                            <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>With SLA or over SLA </span></p>
                                            </td>
                                            <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span>@Model.TechLocation</p>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>If Over SLA -Justification  </span></p>
                                            </td>
                                            <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span>NA</p>
                                            </td>
                                        </tr>
                                    }
                                    <tr>
                                        <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Final Colour Code</span></p>
                                        </td>
                                        <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span> @Model.FinalColor</p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Internal/Vendor Ref Number (if applicable)</span></p>
                                        </td>
                                        <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span>@Model.CompanyRefNo</p>
                                        </td>
                                    </tr>

                                    @if (Model.ClientRowID == 1199)
                                    {
                                        <tr>
                                            <td style="width:250.2pt;border-top:none;border-left:solid black 1.0pt;border-bottom:solid black 1.0pt;border-right:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style='font-size:12px;font-family:"calibri";'>Name of the Account</span></p>
                                            </td>
                                            <td style="width:248.9pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;height:15.0pt;">
                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style='font-size:12px;font-family:"calibri";color:green;'>&nbsp;</span>@Model.ProcessName </p >
</td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr valign="top">
                        <td style="height:1%;">&nbsp;</td>
                    </tr>
                    <tr valign="top">
                        <td>
                            <table style="border-collapse:collapse;border:none; margin: auto;width: 95%;">
                                <tbody>
                                    <tr>
                                        <td colspan="2" style="width:499.1pt;border:solid black 1.0pt;background:silver;padding:2.75pt 2.75pt 2.75pt 2.75pt;">
                                            <p style='margin:0cm;font-size: 14px;font-family:"calibri";text-align:center;'><strong><span style="font-size: 14px; font-family: Calibri, sans-serif; color: black;">Report Summary</span></strong></p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:250.2pt;border:solid black 1.0pt;border-top:none;background:silver;padding:2.75pt 2.75pt 2.75pt 2.75pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style="font-family: Calibri, sans-serif;"><strong><span style="font-size: 12px; color: black;">Component</span></strong></span></p>
                                        </td>
                                        <td style="width:248.9pt;border-top:none;border-left:none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;background:silver;padding:2.75pt 2.75pt 2.75pt 2.75pt;">
                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style="font-family: Calibri, sans-serif;"><strong><span style="font-size: 12px; color: black;">Colour Status</span></strong></span></p>
                                        </td>
                                    </tr>

                                    @{
                                        int i = 0;
                                        foreach (var item in Model.PersonalChecksBriefDetails)
                                        {
                                            if (Model.ReportPart == "")

                                            {
                                                if (@item.CheckFamilyRowID == 11)
                                                {
                                                    if (Model.EducationCount == 1)
                                                    {
                                                        <tr>
                                                            <td style="width:250.2pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;">
                                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style="font-size: 12px; font-family: Calibri, sans-serif;">Education</span></p>
                                                            </td>

                                                            <td style="width:248.9pt;border-top:none;border-left:none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:2.75pt 2.75pt 2.75pt 2.75pt;">
                                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style="font-size: 12px; font-family: Calibri, sans-serif; color: black;">&nbsp;</span>@item.ColorName</p>
                                                            </td>
                                                        </tr>
                                                    }

                                                    if (Model.EducationCount > 1)
                                                    {
                                                        if (@item.subCheckId == 56)
                                                        {
                                                            <tr>
                                                                <td style="width:250.2pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;">


                                                                    <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style="font-size: 12px; font-family: Calibri, sans-serif;"> Education 1 </span></p>


                                                                </td>


                                                                <td style="width:248.9pt;border-top:none;border-left:none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:2.75pt 2.75pt 2.75pt 2.75pt;">


                                                                    <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style="font-size: 12px; font-family: Calibri, sans-serif; color: black;"> &nbsp;</span>@item.ColorName</p>


                                                                </td>


                                                            </tr>
                                                        }

                                                    }

                                                }

                                                else if (@item.CheckFamilyRowID == 12)
                                                {



                                                    if (Model.EmpCheckCount > 1)
                                                    {
                                                        if (@item.subCheckId == 68)
                                                        {
                                                            <tr>
                                                                <td style="width:250.2pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;">



                                                                    <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style="font-size: 12px; font-family: Calibri, sans-serif;"> Employment 1 </span></p>



                                                                </td>



                                                                <td style="width:248.9pt;border-top:none;border-left:none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:2.75pt 2.75pt 2.75pt 2.75pt;">



                                                                    <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style="font-size: 12px; font-family: Calibri, sans-serif; color: black;"> &nbsp;</span>@item.ColorName</p>



                                                                </td>



                                                            </tr>
                                                        }
                                                    }

                                                    else if (Model.EmpCheckCount == 1)
                                                    {
                                                        <tr>
                                                            <td style="width:250.2pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;">
                                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style="font-size: 12px; font-family: Calibri, sans-serif;">Employment</span></p>
                                                            </td>
                                                            <td style="width:248.9pt;border-top:none;border-left:none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:2.75pt 2.75pt 2.75pt 2.75pt;">
                                                                <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style="font-size: 12px; font-family: Calibri, sans-serif; color: black;">&nbsp;</span>@item.ColorName</p>
                                                            </td>
                                                        </tr>
                                                    }
                                                }

                                            }

                                            else if (Model.ReportPart == "CRC")
                                            {

                                                if (@item.CheckFamilyRowID == 5)
                                                {



                                                    //if (Model.CriminalCount > 1)
                                                    //{
                                                    //if (item.subCheckId == 68)
                                                    //{
                                                    <tr>
                                                        <td style="width:250.2pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;">

                                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";'><span style="font-size: 12px; font-family: Calibri, sans-serif;">  @item.SubCheckFName </span></p>

                                                        </td>

                                                        <td style="width:248.9pt;border-top:none;border-left:none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:2.75pt 2.75pt 2.75pt 2.75pt;">

                                                            <p style='margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style="font-size: 12px; font-family: Calibri, sans-serif; color: black;"> &nbsp;</span> @item.ColorName </p>

                                                        </td>
                                                    </tr>
                                                    //}
                                                    //}

                                                    @*else if (Model.CriminalCount == 1)
                                                    {
                                                    <tr>
                                                        <td style = "width:250.2pt;border:solid black 1.0pt;border-top:none;padding:2.75pt 2.75pt 2.75pt 2.75pt;">


                                                             <p style = 'margin:0cm;font-size: 12px;font-family:"calibri";'><span style = "font-size: 12px; font-family: Calibri, sans-serif;" > @item.SubCheckFName </span ></p>


                                                              </td>


                                                              <td style = "width:248.9pt;border-top:none;border-left:none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:2.75pt 2.75pt 2.75pt 2.75pt;">


                                                                   <p style = 'margin:0cm;font-size: 12px;font-family:"calibri";text-align:center;'><span style = "font-size: 12px; font-family: Calibri, sans-serif; color: black;"></span> @item.ColorName </p>


                                                                        </td>


                                                                    </tr>
                                                                                }*@
                                                }

                                            }






                                        }

                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>