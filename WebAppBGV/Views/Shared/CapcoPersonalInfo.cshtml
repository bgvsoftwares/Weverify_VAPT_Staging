<table border="0" cellspacing="0" cellpadding="0" style="width: 100%; margin-top: 5px; font-family: Calibri, sans-serif;">
    <tr>
        <td>
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                    @if ((Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS"))
                    {
                        <td width="88%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size: 12px;">REPORT TYPE INTERIM</p></td>

                    }
                    else
                    {
                        if (Model.Report_Type != "1" || Model.ReportPart == "CRC")
                        {
                            <td width="80%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size: 12px;">REPORT TYPE FINAL</p></td>
                        }
                        else
                        {
                            <td width="80%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size: 12px;">REPORT TYPE INTERIM</p></td>
                        }
                    }
                    <td valign="top" style="width:20%; text-align:end;"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem; margin-top:10px;"></td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table width="100%" border="1" cellpadding="2" cellspacing="5" style="border-collapse:collapse;">
                <tr>
                    <td height="20" colspan="4" align="center" style="font-size:12px;font-family:Calibri; -webkit-print-color-adjust:exact; background:#c0c0c0;"><strong>BACKGROUND SCREENING REPORT</strong></td>
                </tr>
                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;" width="30%">Applicant Name</td>
                    <td style="font-size: 12px; font-family:Calibri; padding-left:5px;"><label for="">@Model.PersonalName</label></td>
                </tr>
                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of Birth</td>
                    <td style="font-size: 12px; font-family:Calibri; padding-left:5px;">
                        @if (Model.ClientRowID == 1219)
                        {
                            <label for="">
                                <span>xxxxxxxxxx</span>
                            </label>
                        }
                        else
                        {
                            <label for="">
                                @if (Model.DOB != null)
                                {
                                    <span>@Model.DOB.ToString("dd-MM-yyyy")</span>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </label>
                        }

                    </td>

                </tr>
                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Client Name & Location</td>
                    <td style="font-size: 12px; font-family:Calibri; padding-left:5px;"><label for="">@Model.ClientName </label></td>
                </tr>
                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Employee Id</td>
                    @if (@Model.EmploymentId == "")
                    {
                        <td style="font-size: 12px; font-family:Calibri;padding-left:5px;"><label for="">NA</label></td>
                    }
                    else
                    {
                        <td style="font-size: 12px; font-family:Calibri;padding-left:5px;"><label for="">@Model.EmploymentId</label></td>
                    }

                </tr>
                @if (Model.ClientRowID == 1470)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of Joining</td>
                        <td style="font-size: 12px; font-family:Calibri; padding-left:5px;">

                            <label for="">
                                @if (Model.DOJ != null)
                                {
                                    <span>@Model.DOJ</span>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </label>

                        </td>

                    </tr>
                }
                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Securitas reference id</td>
                    <td style="font-size: 12px; font-family:Calibri; padding-left:5px;"><label for="">@Model.CompanyRefNo</label></td>
                </tr>
                @if (Model.CaseStatusId == 11  && Model.FinalColor.ToUpper()!="RED")
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Report Color</td>

                        <td width="50%" colspan="2" style="text-align: center; font-size: 10px; font-family: Calibri; -webkit-print-color-adjust: exact; background-color: #FFA500; ">Orange</td>

                    </tr>
                }
                else
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Report Color</td>
                        <td width="50%" colspan="2" style="text-align: center; font-size: 12px; font-family: Calibri; -webkit-print-color-adjust: exact; background: @Model.FinalColorCode;">@Model.FinalColor</td>
                    </tr>
                }
                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of Report</td>
                    <td style="font-size: 12px; font-family:Calibri; padding-left:5px;">
                        <label for="">
                            @if (Model.ReportDate != null)
                            {
                                <span>@Model.ReportDate.ToString("dd-MM-yyyy")</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </label>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table width="100%" border="1" cellpadding="5" cellspacing="5" style="border-collapse:collapse; margin-top: 20px; background-color: #f8f8f8;">
                <tr>
                    <td style="font-size: 12px;  -webkit-print-color-adjust:exact; font-weight:bold; background-color:#339933; color:white; text-align:center;" width="20%">Green</td>
                    <td style="font-size: 12px;  -webkit-print-color-adjust:exact; font-weight:bold; background-color:#FFFF00; color:#000; text-align:center;" width="20%">Yellow</td>
                    <td style="font-size: 12px;  -webkit-print-color-adjust:exact; font-weight:bold; background-color:#0000FF; color:white; text-align:center;" width="20%">Blue</td>
                    <td style="font-size: 12px;  -webkit-print-color-adjust:exact; font-weight:bold; background-color:#FF0000; color:white; text-align:center;" width="20%">Red</td>
                    <td style="font-size: 12px;  -webkit-print-color-adjust:exact; font-weight:bold; background-color:#FFA500; color:white; text-align:center;" width="20%">Orange</td>
                </tr>
                <tr>
                    <td style="font-size:12px; font-weight:bold; text-align:center;" width="20%">Verified</td>
                    <td style="font-size:12px; font-weight:bold; text-align:center;" width="20%">Minor Discrepancy</td>
                    <td style="font-size:12px; font-weight:bold; text-align:left;" width="20%">Inaccessible for verification / Unable to verify / Inputs required</td>
                    <td style="font-size:12px; font-weight:bold; text-align:center;" width="20%">Major Discrepancy</td>
                    <td style="font-size:12px; font-weight:bold; text-align:center;" width="20%">Current Employment Pending</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<tr>
    <td colspan="2" height="100">
        <table border="0" cellspacing="0" cellpadding="0" style="width:100%;">
            <tr>
                <td colspan="3" style="border-top:3px solid #c0c0c0;">&nbsp;</td>
            </tr>
            <tr>
                <td valign="bottom" width="20%"><img src="~/Images/Walsons-Report-footer.png" style="width:7rem; margin-left: 15px; margin-bottom: 15px;"></td>
                <td width="1%">&nbsp;</td>
                <td width="79%">
                    <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>
                    <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                    <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                    <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin: 0px 0px 5px 0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                </td>
            </tr>
        </table>
    </td>
</tr>
