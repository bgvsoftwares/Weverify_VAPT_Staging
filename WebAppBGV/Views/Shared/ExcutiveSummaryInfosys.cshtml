

<page id="print" size="A4">
    <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;page-break-after:always!important;">
        <tr>
            <td style="height:70rem!important;" valign="top">
                <table cellspacing="0" cellpadding="0" align="center">
                    <tr>
                        <td style="width:100%; height:1px!important;" valign="top">
                            <table style="width:100%;">
                                <tr>
                                    <td style="text-align:center; text-align:right;width:64%;font-size:24px; color:#777777; text-decoration:underline;font-weight:bold;"><p>SECURITAS INDIA</p></td>
                                    <td style="text-align:right;"><img src='~/Content/Securitas_AB_logo.svg.png' style="width: 70px;padding: 5px 5px 0px 0px;"></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="width:100%;height:1px!important;" valign="top">
                            <table style="width:100%;">
                                <tr>
                                    @if (Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS")
                                    {
                                        <td colspan="3">
                                            <p style="text-align: center;margin-left: 280px !important;border:2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width:26%;font-weight: bolder;letter-spacing: 0.5px;font-size:16px; padding: 10px; font-family: 'Calibri',sans-serif;margin-bottom:10px!important;">REPORT TYPE INTERIM</p>
                                        </td>
                                    }
                                    else if (Model.Report_Type != "1")
                                    {
                                        <td colspan="3">
                                            <p style="text-align: center;margin-left: 280px !important;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width:26%;font-weight: bolder;letter-spacing: 0.5px;font-size:16px; padding: 10px; font-family: 'Calibri',sans-serif;margin-bottom:10px!important;">REPORT TYPE FINAL</p>
                                        </td>
                                    }
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" style="height:1px!important;">
                            <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                                <tr>
                                    <td>
                                        <table border="1" style="width:98%; margin: auto; border-collapse: collapse;">
                                            <tr>
                                                <td colspan="4" style="background: rgb(191, 191, 191); text-align: center; font-size: 16px; font-family:'Calibri', sans-serif; font-weight: bolder;">Background Screening Report</td>
                                            </tr>
                                            <tr>
                                                <td style="background: rgb(191, 191, 191); width: 211px; padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Name of the Candidate</td>
                                                <td colspan="4" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.PersonalName</td>
                                            </tr>

                                          
                                                <tr>
                                                    <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Client Name</td>
                                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">Infosys BPM Limited</td>

                                                    <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Process Name</td>
                                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;"> @Model.ProcessName </td>


                                                </tr>
                                           
                                            <tr>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Employee ID</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.EmploymentId</td>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Date of Joining</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                                    @if (Model.DOJ != null)
                                                    {
                                                        try
                                                        {
                                                            <span>@Convert.ToDateTime(Model.DOJ).ToString("dd-MMM-yyyy")</span>
                                                        }
                                                        catch
                                                        {
                                                            <span>@Model.DOJ</span>
                                                        }

                                                    }
                                                    else
                                                    { <span>N/A</span>}

                                                </td>

                                            </tr>
                                            <tr>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Level (Fresher/Experienced)</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                                    @if (!string.IsNullOrEmpty(Model.EntityName))
                                                    {
                                                        @Model.EntityName
                                                    }
                                                    else
                                                    {
                                                       <p> NA</p>
                                                                                            }

                                                </td>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Securitas Reference ID</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.CompanyRefNo</td>

                                            </tr>

                                            <tr>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Insuff Raised Date</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">

                                                    
                                                        @if (!string.IsNullOrEmpty(Model.InsuffRaisedDate))
                                                        {
                                                            try
                                                            {
                                                                <span>@Model.InsuffRaisedDate.ToString("dd-MMM-yyyy")</span>
                                                            }
                                                            catch
                                                            {
                                                                <span>@Model.InsuffRaisedDate</span>
                                                            }

                                                        }
                                                        else
                                                        { <span>NA</span>}


                                                    </td>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Insuff Cleared Date</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">

                                                    @if ( !string.IsNullOrEmpty(Model.InsuffClearDate))
                                                    {
                                                        try
                                                        {
                                                            <span>@Model.InsuffClearDate.ToString("dd-MMM-yyyy")</span>
                                                        }
                                                        catch
                                                        {
                                                            <span>@Model.InsuffClearDate</span>
                                                        }

                                                    }
                                                    else
                                                    { <span>NA</span>}

                                                </td>

                                            </tr>

                                            <tr>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Date Initiated</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">

                                                    @if (Model.OrderDate != null)
                                                    {<span>@Model.OrderDate.ToString("dd-MMM-yyyy")</span> }
                                                else
                                                { <span>N/A</span>}

                                                </td>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Final Case Closed Date</td>

                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; ">
                                                    @if (Model.ReportDate != null)
                                                    {<span>@Model.ReportDate.ToString("dd-MMM-yyyy")</span> }
                                                else
                                                { <span>N/A</span>}

                                                </td>


                                            </tr>



                                            <tr>
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Report Color Code</td>
                                                @if (Model.Report_Type != "1")
                                                {
                                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; background:@Model.FinalColorCode;" align="center"><label for=""> @Model.FinalColor</label></td>
                                                }
                                                else
                                                {
                                                    if (@Model.FinalColor == "IR CEP")
                                                    {
                                                        <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; color-adjust:exact; " align="center"><label for=""> @Model.FinalColor</label></td>

                                                    }
                                                    else
                                                    {
                                                        <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; color-adjust:exact; background:@Model.FinalColorCode;" align="center"><label for=""> @Model.FinalColor</label></td>
                                                    }
                                                }
                                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Supplementary Case Closed Date</td>
                                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                                    @if (Model.ReverificationDate != "")
                                                    {<span>@Model.ReportDate.ToString("dd-MMM-yyyy")</span> }
                                                else
                                                { <span>NA</span>}

                                                </td>

                                            </tr>

                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <table style="width:100%;">
                                            <tr>
                                                <td colspan="4" style="text-align: center;"><img src="~/Content/images/infosysLegen_image.png" style="width:48rem; margin-top:2rem;" /></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top">
                            <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                                <tr>
                                    <td>
                                        <table border="0" cellspacing="0" cellpadding="0" style="width:100%;">
                                            <tr>
                                                <td>
                                                    <table style="width:100%;">
                                                        <tr>
                                                            <td style="margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:18px;font-family:'Calibri',sans-serif;color:darkblue;text-align:center; font-weight: bolder; text-decoration: underline;">Background Verification Report – Executive Summary</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <table style="border: none; width:98%; border-collapse:collapse; margin: auto;">
                                                        <tbody>
                                                            @{
                                                                string checkName = string.Empty;
                                                                <tr>
                                                                    <td style="width:205.3pt;border:solid windowtext 1.0pt;border-top:  none;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                        <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Type of Check</strong></span></p>
                                                                    </td>
                                                                    <td style="width:226.7pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                        <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Brief Details</strong></span></p>
                                                                    </td>
                                                                    <td style="width:226.7pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                        <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Discrepancy Status</strong></span></p>
                                                                    </td>
                                                                    <td style="width:130.0pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:#BFBFBF;padding:0cm 5.4pt 0cm 5.4pt;height:15.75pt;">
                                                                        <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Status (Color)</strong></span></p>
                                                                    </td>
                                                                </tr>
                                                                foreach (var item in Model.PersonalChecksBriefDetails)
                                                                {

                                                                    <tr>
                                                                        <td style="width:205.3pt;border:solid windowtext 1.0pt;border-top:  none;padding:0cm 5.4pt 0cm 5.4pt;height:31.5pt;">
                                                                            <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;'><span style="font-family: Calibri, sans-serif; font-size: 16px; font-weight:bolder;"><strong></strong><a>@item.SubCheckFName.TrimEnd(' ') </a></span></p>
                                                                        </td>
                                                                        <td style="width: 226.7pt;border-color: currentcolor windowtext windowtext currentcolor;border-style: none solid solid none;border-width: medium 1pt 1pt medium;padding: 0cm 5.4pt;height: 31.5pt;vertical-align:central;">
                                                                            <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>@item.SubCheckDetail</strong></span></p>
                                                                        </td>

                                                                        <td style="width: 226.7pt;border-color: currentcolor windowtext windowtext currentcolor;border-style: none solid solid none;border-width: medium 1pt 1pt medium;padding: 0cm 5.4pt;height: 31.5pt;vertical-align:central;">
                                                                            <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;font-weight:bolder;'><span style="font-family: Calibri, sans-serif; font-size: 16px;font-weight:bolder;"><strong></strong>@item.Particilars</span></p>
                                                                        </td>

                                                                        @if (@item.Status == "Not Applicable")
                                                                        {
                                                                            <td style="width:130.0pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:@item.ColorCode;padding:0cm 5.4pt 0cm 5.4pt;height:31.5pt;">
                                                                                <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>Not Applicable</strong></span></p>
                                                                            </td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td style="width:130.0pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:@item.ColorCode;padding:0cm 5.4pt 0cm 5.4pt;height:31.5pt;">
                                                                                <p style='margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:0cm;line-height:normal;font-size:16px;font-family:"Calibri",sans-serif;color:black;text-align:center;'><span style="font-family: Calibri, sans-serif; font-size: 16px;"><strong>@item.ColorName</strong></span></p>
                                                                            </td>
                                                                        }

                                                                    </tr>


                                                                }
                                                            }

                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</page>