<page id="PrintSrc" size="A4">
    <div style="page-break-after:always ;"></div>
    <table>
        <tr>
            <td valign="top">
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td>
                            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    @if (Session["Type"].ToString() == "ReprtToPDF")
                                    {
                                        <td width="94%"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;"><h1 style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;"><a name="Background Verification Report - Executive Summary">Background Verification Report - Executive Summary</a></h1></p></td>
                                    }
                                    else
                                    {
                                        <td width="94%"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Background Verification Report – Executive Summary</p></td>
                                    }
                                    <td width="6%" align="right"><img src='@Url.Content("~/Images/logo.jpg")' width="71" height="40"></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td valign="top">
                            <table width="793" @*border="0"*@ cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999;">
                                <tr>
                                    <td width="25%" style="font-size:12px;font-family:Calibri; color-adjust:exact; background:#c0c0c0; "><strong>Verified Data</strong></td>
                                    <td width="60%" style="text-align:center; font-family:Calibri;font-size:12px; color-adjust:exact; background:#c0c0c0;"><strong>Particulars</strong></td>
                                    @*<td width="10%" style="text-align:center; font-size:16px; "><strong>Status</strong></td>*@
                                    <td width="15%" style="text-align:center;font-family:Calibri; font-size:12px; color-adjust:exact; background:#c0c0c0;"><strong>Status (Color)</strong></td>
                                </tr>
                                @{

                                    <tr style="font-size:12px; font-weight:bold; padding:5px;">
                                        @if (Session["Type"].ToString() == "ReprtToPDF")
                {
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;"><a href="#OFAC" style="font-size:12px; font-family:Calibri; padding-left:5px;">OFAC</a></td>
}
else
{
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;">OFAC</td>
}

                                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;">@Model.CandTitle @Model.PersonalName @Model.MiddleName @Model.LastName </td>


                                        <td style="font-size:12px; font-family:Calibri; color-adjust:exact;background-color:#339933 " align="center">GREEN</td>

                                        @*<td align="center">@item.Status</td>*@

                                    </tr>

                                }
                                <tr>
                                    @if (Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS")
            {
                        <td width="25%" style="font-size:12px;font-family:Calibri; text-align:center">INTERIM REPORT</td>
}
else
{
if (Model.Report_Type != "1")
{
                        <td width="25%" style="font-size:12px;font-family:Calibri; text-align:center">FINAL REPORT</td>
}
else
{
                        <td width="25%" style="font-size:12px;font-family:Calibri; text-align:center">INTERIM REPORT</td>
}
}
                                    <td width="50%" colspan="2" style="text-align:center; font-size:10px; font-family:Calibri;color-adjust:exact; background-color:#339933;">GREEN</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    @if (Model.ClientRowID == 576)
                    {
                        <tr>
                            <td height="30"><b>@Model.EmpNoteRemark<b /></td>
                        </tr>
                        <tr>
                            <td height="30"><b>@Model.AddressNoteRemark<b /></td>
                        </tr>
                    }

                    <tr>
                        <td height="30">&nbsp;</td>
                    </tr>
                    <tr>

                        <td align="center">
                            <img src='@Url.Content("~/Images/fivecolor.jpg")' />
                        </td>


                    </tr>
                    @*<tr>
                        <td width="20%"><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                    </tr>*@
                    <tr>
                        <td width="90%">
                            <table>
                                <tr>
                                    <td width="10%"> <img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                                    <td width="30%">
                                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>

                                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                                    </td>
                                </tr>

                            </table>







                        </td>
                    </tr>


                    @*<tr>
                        <td>@Html.Partial("_ReportFooterAddress")</td>
                    </tr>*@
                </table>

            </td>


        </tr>
    </table>
    </page>


