<page id="PrintSrc" size="A4" style="width:100%; margin:0; padding:0;">
    <div style="page-break-after:always ;"></div>

    <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; border-collapse:collapse;">
        <tr>
            <td valign="top" align="center" style="height:50rem;">
                <table border="1" cellpadding="2" cellspacing="5" id="tblDemo" style="width:100%; border:none!important; margin-top: 10px;">
                    <tr>
                        <td style="text-align: center; background: #ccc; height:30px;font-family:Arial;font-size:17px;">
                            <strong><b>@Model.ReportStatus BACKGROUND REPORT</b></strong>
                        </td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td valign="top">
                            <table border="1" cellpadding="2" cellspacing="5" id="tblDemo" style="width: 100%; font-family:Arial;font-size:17px; border:none!important;">
                                <tr>
                                    <td valign="top">
                                        <table width="100%" border="1" cellpadding="2" cellspacing="5" style="font-family:Arial;font-size:17px;">
                                            <tr>
                                                <td style="text-align: center; border:groove;background: #ccc; -webkit-print-color-adjust:exact;height:30px;font-family:Arial;font-size:17px; ">
                                                    <strong><b>Executive Summary</b></strong>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td valign="top">
                            <table border="1" cellpadding="2" cellspacing="5" id="tblDemo" style="width: 100%;font-family:Arial;font-size:17px; border:none!important;">
                                <tr>
                                    <td valign="top">
                                        <table width="100%" border="1" cellpadding="2" cellspacing="5" style="font-family:Arial;font-size:17px;">
                                            @{
                                                string checkName = string.Empty;

                                                int i = 0;
                                                foreach (var item in Model.PersonalChecksBriefDetails)
                                                {
                                                    if (checkName != item.CheckFName)
                                                    {

                                                        if (i > 0)
                                                        {
                                                            <tr border="0">
                                                                <td colspan="3" border="0" style="padding:10px;border-right:hidden;border-left:hidden"></td>
                                                            </tr>
                                                        }

                                                        <tr>
                                                            @if (item.CheckFamilyRowID == 40 && item.subCheckId == 416)
                                                            {
                                                                <td colspan="3" bgcolor="#c0c0c0" style="font-size:12px; font-family:Calibri; -webkit-print-color-adjust:exact; background:#c0c0c0; padding:5px; text-align:center; font-family:Arial;font-size:17px;"> <strong>UAN Verification</strong></td>

                                                            }
                                                            else
                                                            {
                                                                <td colspan="3" bgcolor="#c0c0c0" style="font-size:12px; font-family:Calibri; -webkit-print-color-adjust:exact; background:#c0c0c0; padding:5px; text-align:center; font-family:Arial;font-size:17px;"> <strong> @item.CheckFName</strong></td>
                                                            }

                                                        </tr>
                                                        <tr>
                                                            <td style="text-align:center;-webkit-print-color-adjust:exact; background:#c0c0c0; font-weight:bold" width="33%; ">Type of Check</td>
                                                            <td style="text-align:center;-webkit-print-color-adjust:exact; background:#c0c0c0; font-weight:bold" width="33%; ">Brief Details</td>
                                                            <td style="text-align:center;-webkit-print-color-adjust:exact; background:#c0c0c0; font-weight:bold" width="33%; ">Status</td>
                                                        </tr>
                                                        checkName = item.CheckFName;
                                                    }
                                                    <tr style=" font-family:Arial;font-size:17px; font-weight:bold; padding:5px;">
                                                        @if (@item.CheckFamilyRowID == 12 || @item.CheckFamilyRowID == 11)
                                                        {



                                                            <td style="text-align:center;-webkit-print-color-adjust:exact; font-family:Arial;font-size:17px;background:#c0c0c0;"><a href="#@item.subCheckId+" 1"">@item.SubCheckDetail.TrimEnd(' ').Replace("Pvt.", "Private").Replace("Ltd", "Limited").Replace("Pvt.", "Private").Replace("ltd", "Limited").ToString()</a></td>

                                                            <td style="padding-left:5px; font-family:Arial;font-size:17px; text-align:center; width:50%">@item.checkStatus</td>
                                                        }
                                                        else
                                                        {
                                                            @*<td style="text-align:center;-webkit-print-color-adjust:exact; font-family:Arial;font-size:17px;background:#c0c0c0;">@item.SubCheckFName</td>*@
                                                            <td style="text-align:center;-webkit-print-color-adjust:exact; font-family:Arial;font-size:17px;background:#c0c0c0;"><a href="#@item.subCheckId+" 1"">@item.SubCheckFName.TrimEnd(' ')</a></td>

                                                            <td style="padding-left:5px; font-family:Arial;font-size:17px;text-align:center; width:50%">@item.checkStatus</td>
                                                        }
                                                        @if (@item.CheckFamilyRowID == 2)
                                                        {

                                                            <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;text-align:center;  color:@item.ColorCode; -webkit-print-color-adjust:exact; "> @item.ColorName</td>
                                                        }
                                                        else if (@item.CheckFamilyRowID == 11)
                                                        {
                                                            if (@item.ColorName.ToUpper() == "AMBER")
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;color:#e36c0a; -webkit-print-color-adjust:exact;"> @item.ColorName</td>
                                                            }
                                                            else
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;color:@item.ColorCode; -webkit-print-color-adjust:exact;"> @item.ColorName</td>
                                                            }
                                                        }
                                                        else if (@item.CheckFamilyRowID == 5)
                                                        {
                                                            if (@item.ColorName.ToUpper() == "AMBER")
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;color:#e36c0a; -webkit-print-color-adjust:exact;"> @item.ColorName </td>
                                                            }
                                                            else
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;color:@item.ColorCode; -webkit-print-color-adjust:exact;"> @item.ColorName </td>
                                                            }

                                                        }
                                                        else if (@item.CheckFamilyRowID == 40)
                                                        {
                                                            if (@item.ColorName.ToUpper() == "AMBER")
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;color:#e36c0a; -webkit-print-color-adjust:exact;"> @item.ColorName </td>
                                                            }
                                                            else
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;color:@item.ColorCode; -webkit-print-color-adjust:exact;"> @item.ColorName </td>
                                                            }
                                                        }
                                                        else if (@item.CheckFamilyRowID == 12)
                                                        {
                                                            if (@item.ColorName.ToUpper() == "AMBER")
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;color:#e36c0a; -webkit-print-color-adjust:exact;"> @item.ColorName </td>
                                                            }

                                                            else if (@item.ColorName.ToLower() == "no color-stop")
                                                            {
                                                                <td align="center" style="-webkit-print-color-adjust:exact;font-family:Arial;font-size:17px; color:#000; -webkit-print-color-adjust:exact;"> @item.ColorName </td>
                                                            }
                                                            else
                                                            {
                                                                <td align="center" style=" -webkit-print-color-adjust:exact;font-family:Arial;font-size:17px;  color:@item.ColorCode; -webkit-print-color-adjust:exact;"> @item.ColorName </td>


                                                            }
                                                        }

                                                    </tr>
                                                    i++;
                                                }

                                            }


                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td height="30">&nbsp;</td>
                    </tr>

                </table>
            </td>
        </tr>
        <tr>
            <td>
                <hr style="border:0; border-top:3px solid #c0c0c0; margin:10px 0;" />
            </td>
        </tr>

        <tr>
            <td valign="bottom" height="120">
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td valign="top">&nbsp;</td>
                    </tr>

                    <tr style="background-image: url('@Url.Content("~/Images/Footer-image-confident.jpg")'); background-repeat: no-repeat; background-size: cover;" >
                        <td width="20%"><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                        <td width="1%">&nbsp;</td>
                        <td width="79%">


                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>

                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                        </td>
                    </tr>
                </table>
            </td>

        </tr>
    </table>
</page>



