<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TCS</title>
</head>
<body>
<table style="width:100%;">
<tbody>
<tr>
<td>
<table style="width:100%; margin: auto; margin-bottom: 10px;">
<tr>
<td style="text-align: end;padding: 5px;"><img src="~/Images/Walsons_logo.jpg" style="width: 150px;"></td>
</tr>
</table>
<table style="width:100%; margin: auto;">
<tr>
<td style="text-align: center; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">TATA CONSULTANCY SERVICES</td>
</tr>
</table>
<table style="width:100%; margin: auto; border:2px solid #000; border-collapse: collapse; margin-top: 10px;">
    <tr>
        <td colspan="4" style="text-align: center; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">BACKGROUND CHECK REPORT - SUMMARY</td>
        </tr>
    <tr>
    <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">TCS APPLICANT ID/UNIQUE ID</td>
    <td style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;">@Model.EmploymentId</td>
    <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">VENDOR RF-ID</td>
    <td style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;">@Model.CompanyRefNo</td>
    </tr>
    <tr>
        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">RECRUITMENT BRANCH</td>
        <td style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;">@Model.Location</td>
        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">NSR IT_PIN</td>
        <td style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;">NIL</td>
        </tr>
        <tr>
            <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">NAME OF CANDIDATE</td>
            <td colspan="3" style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;">@Model.PersonalName</td>
        </tr>
        <tr>
            <td rowspan="2" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">CATEGORY (CAMPUS/DT/EP/EP FromCAMPUS)</td>
            <td rowspan="2" style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;">@Model.EmploymentType</td>
            <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">FINAL BGC STATUS (RED/GREEN)</td>
            <td style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;color:green;">@Model.FinalColor.ToUpper()</td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">
            <div style="width: 100%; display: flex;">
            <div style="background: red; width: 10px; height: 10px; border: 1px solid #000; margin-right:5px;"></div>
            <span style="font-size:14px;">RED (DISCREPENCY)</span>
            <div style="background: green; width: 10px; height: 10px; border: 1px solid #000; margin-right:5px; margin-left:5px;"></div><span style="font-size:14px;">GREEN (POSITIVE)</span>  
            <div style="background: white; width: 10px; height: 10px; border: 1px solid #000; margin-right:5px; margin-left:5px;"></div><span style="font-size:14px;">STOP CASE</span>
            </div>
            </td>
        </tr>
        <tr>
            <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;background: #B3B3B3; border: 2px solid #000; font-size: 14px;padding: 5px;">BGC COMPLETED DATE</td>
            <td colspan="3" style="padding:5px; font-size: 14px; font-family: 'Times New Roman', Times, serif;font-weight: bolder;border: 2px solid #000;">@DateTime.Now.Date.ToString("dd/MM/yyyy")</td>
        </tr>
</table>
<table style="width:100%; margin: auto; border:2px solid #000; border-collapse: collapse; margin-top: 10px;">
    <thead>
        <tr>
            <th style="text-align: center; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">TYPE OF CHECK</th>
            <th style="text-align: center; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">VERIFICATION STATUS (VERIFIED / NOT APPLICABLE)</th>
            <th style="text-align: center; font-family: 'Times New Roman', Times, serif; font-weight: bolder; border: 2px solid #000; font-size: 14px;padding: 5px;">BGC STATUS</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.PersonalChecksBriefDetails != null)
        {
            int AddressCount = 0;
            int CriminalCount = 0;
            int NationalCount = 0;
            int EmploymentCount = 0;
            int EducationCount = 0;
            int SpecialCount = 0;
            int ReferenceCount = 0;

            foreach (var item in Model.PersonalChecksBriefDetails)
            {
                if (item.CheckFamilyRowID == 2)
                {
                    if (AddressCount == 0)
                    {
                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; background:#d6d6d67a;;">ADDRESS CHECK</td>
                        </tr>
                    }

                        <tr>
                            <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">@item.SubCheckFName.ToUpper()</td>

                            @if ((item.subCheckId == 2 && Model.Address_currentPermanantSame.ToLower() == "yes") || (item.subCheckId == 2 && item.ColorName.ToLower() == "not applicable"))
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">Same as permanent</td>
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; ">NA</td>

                            }
                            else if ((item.subCheckId == 13 && Model.Address_currentPermanantSame.ToLower() == "yes") || (item.subCheckId == 13 && item.ColorName.ToLower() == "not applicable"))
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">Same as present</td>
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; ">NA</td>

                            }
                            else if (item.ColorName.ToUpper()== "NO COLOR")
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">Verified</td>
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color:black ">@item.ColorName.ToUpper()</td>

                            }
                            else
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">Verified</td>
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color:@item.ColorCode ">@item.ColorName.ToUpper()</td>

                            }



                            @*@if (Model.AddressCount == 1)
        {
            <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color: green;">@item.ColorName</td>
        }
        else
        {

        }*@


                        </tr>
                    AddressCount++;
                }


                if (item.CheckFamilyRowID == 5)
                {
                    if (CriminalCount == 0)
                    {
                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif;  font-size: 14px;padding: 5px;padding-top:15px; border-left:hidden; border-right:hidden"></td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; background:#d6d6d67a;;">CRIMINAL CHECK</td>
                        </tr>
                    }

                        <tr>
                            @if (item.subCheckId == 24)
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">
                                    eCOURT RECORD – PRESENT
                                    ADDRESS
                                </td>
                            }
                            else if (item.subCheckId == 28)
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">
                                    eCOURT RECORD –LONGEST
                                    7 YEAR OF STAY
                                </td>
                            }

                            else if (item.subCheckId == 245)
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">
                                    eCOURT RECORD – NEW PRESENT
                                    ADDRESS
                                </td>
                            }
                            else
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">@item.SubCheckFName</td>

                            }
                            @if ((item.subCheckId == 24 && Model.Address_currentPermanantSame.ToLower() == "yes") || (item.subCheckId == 24 && item.ColorName.ToLower() == "not applicable"))
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">Same as permanent</td>
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; ">NA</td>

                            }
                            else if ((item.subCheckId == 23 && Model.Address_currentPermanantSame.ToLower() == "yes") || (item.subCheckId == 23 && item.ColorName.ToLower() == "not applicable"))
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">Same as present</td>
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; ">NA</td>

                            }
                            else
                            {
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">Verified</td>
                                <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color:@item.ColorCode ">@item.ColorName.ToUpper()</td>

                            }



                            @*@if (Model.AddressCount == 1)
        {
            <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color: green;">@item.ColorName</td>
        }
        else
        {

        }*@


                        </tr>
                    CriminalCount++;
                }







                if (item.CheckFamilyRowID == 12)
                {
                    if (EmploymentCount == 0)
                    {

                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif;  font-size: 14px;padding: 5px;padding-top:15px; border-left:hidden; border-right:hidden"></td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; background:#d6d6d67a;">EMPLOYMENT CHECK</td>
                        </tr>
                    }

                    <tr>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">@item.SubCheckFName</td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">
                            @if (!string.IsNullOrEmpty(item.ColorName))
                            {
                                <p>Verified</p>
                            }
                            else
                            {
                                <p></p>
                            }

                        </td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color:@item.ColorCode">@item.ColorName.ToUpper()</td>
                    </tr>
                    EmploymentCount++;
                }

                if (item.CheckFamilyRowID == 11)
                {
                    if (EducationCount == 0)
                    {

                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif;  font-size: 14px;padding: 5px;padding-top:15px; border-left:hidden; border-right:hidden"></td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; background:#d6d6d67a;">EDUCATION CHECK</td>
                        </tr>
                    }

                    <tr>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">@item.SubCheckFName.ToUpper()</td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">
                            @if (!string.IsNullOrEmpty(item.ColorName))
                            {
                                <p>Verified</p>
                            }
                            else
                            {
                                <p></p>
                            }

                        </td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color:@item.ColorCode">@item.ColorName.ToUpper()</td>
                    </tr>
                    EducationCount++;
                }


                if (item.CheckFamilyRowID == 40)
                {
                    if (SpecialCount == 0)
                    {

                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif;  font-size: 14px;padding: 5px;padding-top:15px; border-left:hidden; border-right:hidden"></td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; background:#d6d6d67a;">SPECIAL CHECK</td>
                        </tr>
                    }

                    <tr>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">@item.SubCheckFName</td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">
                            @if (!string.IsNullOrEmpty(item.ColorName))
                            {
                                <p>Verified</p>
                            }
                            else
                            {
                                <p></p>
                            }

                        </td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color: green;">@item.ColorName.ToUpper()</td>
                    </tr>
                    SpecialCount++;
                }

                if (item.CheckFamilyRowID == 30)
                {
                    if (ReferenceCount == 0)
                    {

                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif;  font-size: 14px;padding: 5px;padding-top:15px; border-left:hidden; border-right:hidden"></td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; background:#d6d6d67a;">REFERENCE CHECK</td>
                        </tr>
                    }

                    <tr>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px;">@item.SubCheckFName</td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; border: 2px solid #000; font-size: 14px;padding: 5px;">
                            @if (!string.IsNullOrEmpty(item.ColorName))
                            {
                                <p>Verified</p>
                            }
                            else
                            {
                                <p></p>
                            }

                        </td>
                        <td style="text-align: left; font-family: 'Times New Roman', Times, serif; font-weight: bolder;border: 2px solid #000; font-size: 14px;padding: 5px; color: green;">@item.ColorName.ToUpper()</td>
                    </tr>
                    ReferenceCount++;

                }

            }
        }


    </tbody>
</table>
<table style="width:100%; margin: auto;">
<tr>
<td style="font-size:14px; font-weight: bolder; font-family: 'Times New Roman', Times, serif; padding:5px; text-align: left;">STAMP / SEAL OF BGC AGENCY </td>
<td style="font-size:14px; font-weight: bolder; font-family: 'Times New Roman', Times, serif; padding:5px; text-align: left;width: 30%;">NAME & SIGNATURE OF BRANCH MANAGER / TEAM LEAD: Subhash Priyadarshi. </td>
</tr>
<tr>
<td style="text-align: left;"><img style="width: 100px;" src="~/Images/BGCAGENCY.png"></td>
<td style="text-align: left;"><img style="width: 100px;" src="~/Images/SIGNATUREBRANCHMANAGER.jpg"></td>
</tr>
<tr>
    <td colspan="3" style="font-size:14px; font-weight: bolder; font-family: 'Times New Roman', Times, serif; padding:5px; text-align: left;">Date: @DateTime.Now.Date.ToString("dd MMMM yyyy")</td>
</tr>
</table>
</td>
</tr>
</tbody>
</table> 
</body>
</html>