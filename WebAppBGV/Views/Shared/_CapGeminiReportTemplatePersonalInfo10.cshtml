
<table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;border-collapse:collapse;">
    <tr>
        <td valign="top" align="center" style="height:40rem;">
            <p style="text-align:center;font-family:Arial; font-size:33px;"><strong>Walsons Services </strong></p>

            <table border="1" cellpadding="0" cellspacing="0" align="center" style="text-align:center; width:100%; font-family:Arial;font-size:13px;">
                <tbody>
                    <tr>
                        <td width="121" style="padding:10px!important;">
                            <strong>Vendor Ref Id</strong>
                        </td>
                        <td width="254" style="padding:10px!important;">
                            <strong>Candidate Name</strong>
                        </td>
                        <td width="128" style="padding:10px!important;">
                            <strong>Entity</strong>
                        </td>
                    </tr>
                    <tr>
                        <td width="121" style="padding:10px!important;">
                            @Model.CompanyRefNo
                        </td>
                        <td width="254" style="padding:10px!important;">
                            @Model.PersonalName
                        </td>
                        <td width="128" style="padding:10px!important;">
                            @Model.BusinessName
                        </td>

                    </tr>
                </tbody>
            </table>
            <div style=" width: 100%; margin-top: 1%; margin-bottom: 1%; text-align: center; border: groove; background: #ccc; -webkit-print-color-adjust: exact !important; height: 25px; font-family: Arial; font-size: 17px; ">
                <strong><b>BACKGROUND CHECK REPORT – SUMMARY</b></strong>
            </div>
            <table border="1" cellpadding="0" cellspacing="0" id="tblDemo" style="width:100%; font-family:Arial;font-size:13px;">
                <tbody>

                    <tr style="border: 1px solid black;  border-collapse: collapse;">
                        <td width="123" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact; padding: 0 1%;">
                            <strong>Name of Candidate</strong>
                        </td>
                        <td colspan="3" width="197" style="padding: 10px!important;">
                            @Model.PersonalName
                        </td>

                    </tr>
                    <tr>
                        <td width="133" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Vendor Reference</strong>
                        </td>
                        <td width="199" style="padding: 10px!important;">
                            @Model.CompanyRefNo
                        </td>
                        <td width="123" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Date Initiated</strong>
                        </td>
                        <td width="197" style="padding: 10px!important;">
                            @if (Model.OrderDate != null)
                            {
                                @Model.OrderDate.ToString("dd MMMM yyyy")
                            }
                            else
                            {
                                <p></p>
                            }

                        </td>

                    </tr>
                    <tr>
                        <td width="133" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Entity</strong>
                        </td>
                        <td width="199" style="padding: 10px!important;">
                            @Model.BusinessName
                        </td>
                        <td width="123" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Date of Interim Report</strong>
                        </td>
                        <td width="197" style="padding: 10px!important;">
                            @if (Model.InterimReportDate != "")
                            {
                                @Convert.ToDateTime(@Model.InterimReportDate).ToString("dd MMMM yyyy")
                            }
                            else
                            {
                                @:NA
                            }
                        </td>
                    </tr>

                    <tr>
                        <td width="123" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Date of Final Report</strong>
                        </td>
                        <td width="197" style="padding: 10px!important;">
                            @if (Model.FinalReportDate != "")
                            {
                                @Model.FinalReportDate
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>

                        <td width="133" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
            padding: 0 1%;">
                            <strong>Re-verification date</strong>
                        </td>
                        <td colspan="3" style="padding: 0 1%;">
                            @if (string.IsNullOrEmpty(Model.ReverificationDate))
                            {
                                @:NA
                            }
                            else
                            {
                                @Convert.ToDateTime(Model.ReverificationDate).ToString("dd MMMM yyyy")
                            }

                        </td>
                    </tr>

                    <tr>
                        <td width="123" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Applicant id</strong>
                        </td>
                        <td width="197" style="padding: 10px!important;">
                            @Model.ClientRefID
                        </td>
                        <td width="133" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Insufficiency Clear date</strong>
                        </td>
                        <td width="199" style="padding: 10px!important;">
                            @if (Model.InsuffClearDate != "")
                            {
                                @Convert.ToDateTime(Model.InsuffClearDate).ToString("dd MMMM yyyy")
                            }
                            else
                            {
                                @:NA
                            }
                        </td>
                    </tr>

                    <tr>
                        <td width="133" style="background: #ccc; -webkit-print-color-adjust:exact;
    padding: 12px!important;">
                            <strong>Employee ID &amp; Grade</strong>
                        </td>
                        <td width="199" style="padding: 12px!important;">
                            @if (!string.IsNullOrEmpty(Model.EmploymentId) && !string.IsNullOrEmpty(Model.Designation))
                            {
                                if (Model.EmploymentId == "-" || Model.EmploymentId == "Not provide")
                                {
                                    @Model.Designation
                                }
                                else
                                {
                                    @Model.EmploymentId @:&, @Model.Designation
                                }



                            }
                            else if (!string.IsNullOrEmpty(Model.EmploymentId) && string.IsNullOrEmpty(Model.Designation))
                            {
                                @Model.EmploymentId 
                            }
                            else if (string.IsNullOrEmpty(Model.EmploymentId) && !string.IsNullOrEmpty(Model.Designation))
                            {
                                @Model.Designation 
                            }
                            else
                            {
                                @:NA
                            }
                        </td>
                        <td width="123" style="background: #ccc; -webkit-print-color-adjust:exact;
    padding: 12px!important;">
                            <strong>Colour code</strong>
                        </td>
                        @if (@Model.FinalColor.ToUpper() == "AMBER")
                        {
                            <td width="197" style="padding: 12px!important; -webkit-print-color-adjust:exact; background:#e36c0a;">@Model.FinalColor</td>
                        }
                        else
                        {
                            if (@Model.FinalColorCode == "#000")
                            {
                                <td width="197" style="padding: 12px; -webkit-print-color-adjust:exact;">@Model.FinalColor</td>

                            }
                            else
                            {
                                <td width="197" style="padding: 12px; color-adjust:exact; background: @Model.FinalColorCode;">@Model.FinalColor</td>
                            }
                        }

                    </tr>

                    <tr>
                        <td width="123" style="background: #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>Type of Employee</strong>
                        </td>
                        <td width="197" style="padding: 10px!important;">@Model.EmploymentType</td>
                        <td width="133" style="background:  #ccc; padding: 10px!important; -webkit-print-color-adjust:exact;
    padding: 0 1%;">
                            <strong>TAT (Excluding insufficiency period)</strong>
                        </td>
                        <td width="199" style="padding: 10px!important;">@Model.TANnumberofCompany</td>
                    </tr>
                </tbody>
            </table>

            <p>&nbsp;</p>
            <table border="1" cellpadding="2" cellspacing="5" id="tblDemo" style="width:100%; font-family:Arial;font-size:13px;">
                <tbody>
                    <tr>
                        <td style="text-align:center; padding-left:60px;">
                            <img src='@Url.Content("~/Images/CapGeminiLegents.JPG")' width="650" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <hr style="border:0; border-top:3px solid #c0c0c0; margin:10px 0;" />
        </td>
    </tr>

    <tr>
        <td valign="bottom" height="120">
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td valign="top">&nbsp;</td>
                </tr>

                <tr>
                    <td width="20%"><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                    <td width="1%">&nbsp;</td>
                    <td width="79%">


                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>

                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                    </td>
                </tr>
            </table>
        </td>

    </tr>
</table>