
<div style="width:100%">
    @if (ViewBag.SpecialInstructionDEScan != null)
    {
            
        <div>
            <div class="personal-details-head" ><i class="fa fa-file-text-o" aria-hidden="true"></i> Special Instruction :</div>
        </div>
        if (ViewBag.SpecialInstructionDEScan != null)
        {

            foreach (var item in ViewBag.SpecialInstructionDEScan)
            {
                <div>
                    @if (item.Priority == 1)
                    {
                    <div class="special_instrucation" style=" background-color: pink;">@Html.Raw(item.Instructions)</div>
                    }
                    @if (item.Priority == 2)
                    {
                    <div class="special_instrucation" style=" background-color: yellow;">@Html.Raw(item.Instructions)</div>
                    }
                    @if (item.Priority == 3)
                    {
                    <div class="special_instrucation" style=" background-color: mediumpurple;">@Html.Raw(item.Instructions)</div>
                    }
                    @if (item.Priority == 4)
                    {
                    <div class="special_instrucation">@Html.Raw(item.Instructions)</div>
                    }
                </div>
            }

        }

    }
</div>
