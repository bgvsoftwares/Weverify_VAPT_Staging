
<table border="0" cellspacing="0" cellpadding="0" style="width:100%;">
    <tr>
        <td>
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                    @if ((Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS"))
                    {
                        <td width="88%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE INTERIM</p></td>

                    }
                    else
                    {
                        @*if (Model.ClientRowID == 1219 && Model.ReportPart == "Tiger-ADDC" && Model.PersonalChecksBriefDetails_AddCheck.Count > 0)
                        {
                            <td width="80%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size:14px;">Client BGV Report</p></td>

                        }
                        else
                        {*@
                            if (Model.Report_Type != "1" || Model.ReportPart == "CRC")
                            {
                                <td width="80%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE FINAL</p></td>
                            }
                            else
                            {
                                <td width="80%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE INTERIM</p></td>
                            }
                        @*}*@

                    }
                    @if (Model.ClientRowID == 231 || Model.ClientRowID == 838 || Model.ClientRowID == 824 || Model.ClientRowID == 832 || Model.ClientRowID == 835 || Model.ClientRowID == 827 || Model.ClientRowID == 1118 || Model.ClientRowID == 859)
                    {
                        <td valign="top" style="width:20%; text-align:end; padding:50px;"><img src='@Url.Content("~/Documents/CandidateDocuments/ProvidedDocuments/" + Model.CandidatePhoto)' style="width:5rem;"></td>
                    }
                    <td valign="top" style="width:20%; text-align:end;"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem; margin-top:10px;"></td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <table width="100%" border="1" cellpadding="2" cellspacing="5" style="border-collapse:collapse;">
                <tr>
                    <td height="20" colspan="4" align="center" style="font-size:12px;font-family:Calibri; -webkit-print-color-adjust:exact; background:#c0c0c0;"><strong>BACKGROUND SCREENING REPORT</strong></td>
                </tr>
                <tr>
                    @if (Model.ClientRowID == 1063)
                    {
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;" width="30%">Company Name</td>
                    }
                    else
                    {
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;" width="30%">Applicant Name</td>
                    }

                    <td style="font-size:10px; font-family:Calibri; padding-left:5px;"><label for="">@Model.PersonalName</label></td>
                </tr>
                @if (Model.ClientRowID != 576 && Model.ClientRowID != 1063)
                {
                    
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of Birth</td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            @if (Model.ClientRowID == 1219)
                            {
                                <label for="">
                                    <span>xxxxxxxxxx</span>

                                </label>
                            }
                            else
                            {
                                <label for="">
                                    @if (Model.DOB != null)
                                    {<span>@Model.DOB.ToString("dd-MM-yyyy")</span> }
                                else
                                { <span>N/A</span>}
                                </label>
                            }

                        </td>

                    </tr>
                }
                
               
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Client Name & Location</td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;"><label for="">Genpact Europe </label></td>
                    </tr>

                

                @*<tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Employee Id</td>

                    <td style="font-size:10px; font-family:Calibri;padding-left:5px;"><label for="">@Model.EmploymentId</label></td>

                </tr>*@
                @if (Model.ClientRowID == 479)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Client reference Id</td>
                        <td style="font-size:10px; font-family:Calibri;padding-left:5px;"><label for="">@Model.ClientRefID</label></td>
                    </tr>
                }
                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Securitas Reference Id</td>
                    <td style="font-size:10px; font-family:Calibri; padding-left:5px;"><label for="">@Model.CompanyRefNo.ToUpper()</label></td>
                </tr>

                <tr>
                    <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Report Color</td>

                    <td width="50%" colspan="2" style="text-align:center; font-size:10px; font-family:Calibri;color-adjust:exact; background:@Model.FinalColorCode;">@Model.FinalColor</td>

                </tr>
                @if (Model.ClientRowID == 310 || Model.ClientRowID == 532 || Model.ClientRowID == 568 || Model.ClientRowID == 559 || Model.ClientRowID == 762)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of Report</td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (Model.Checkclosedate != null)
                                {
                                    try
                                    {
                                        <span>@Convert.ToDateTime( Model.Checkclosedate).ToString("dd-MM-yyyy")</span>
                                    }
                                    catch
                                    {
                                        <span>@Model.Checkclosedate</span>
                                    }

                                }
                                else
                                {
                                    <span>N/A</span>}
                            </label>
                        </td>
                    </tr>
                }
                else if (Model.ClientRowID == 858)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Final Report Date</td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (Model.FinalReportDate != null)
                                {
                                    <span>@Model.FinalReportDate</span>
                                }
                                else
                                {
                                    <span>N/A</span>}
                            </label>
                        </td>
                    </tr>

                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Supplementary Report Date</td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (Model.SupplementaryReportDate != null)
                                {
                                    <span>@Model.SupplementaryReportDate</span>
                                }
                                else
                                {
                                    <span>N/A</span>}
                            </label>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of Report</td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (Model.ClientRowID == 1219 && Model.ReportPart == "Tiger-ADDC" && Model.PersonalChecksBriefDetails_AddCheck.Count > 0 && Model.FinalReportDate!=null)
                                {
                                    <span>@Convert.ToDateTime(@Model.FinalReportDate).ToString("dd-MM-yyyy")</span>
                                }
                                else
                                {
                                    if (Model.ReportDate != null)
                                    {
                                        <span>@Model.ReportDate.ToString("dd-MM-yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>N/A</span>}
                                }

                            </label>
                        </td>
                    </tr>
                }

                @if (Model.ClientRowID == 310 || Model.ClientRowID == 532 || Model.ClientRowID == 568 )
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of initiation </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (Model.OrderDate != null)
                                {<span>@Model.OrderDate.ToString("dd-MMM-yyyy")</span> }
                            else
                            { <span>N/A</span>}
                            </label>
                        </td>
                    </tr>
                }
                @if (Model.ClientRowID == 559 || Model.ClientRowID == 762 || Model.ClientRowID == 992 || Model.ClientRowID == 993 || Model.ClientRowID == 994 || Model.ClientRowID == 679 || Model.ClientRowID ==1174 || Model.ClientRowID == 1101)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Date of initiation </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (Model.OrderDate != null)
                                {<span>@Model.OrderDate.ToString("dd-MM-yyyy")</span> }
                            else
                            { <span>N/A</span>}
                            </label>
                        </td>
                    </tr>
                }
                @if (Model.ClientRowID == 576)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Process </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                <span>@Model.Location</span>
                            </label>
                        </td>
                    </tr>
                }

                @if (Model.ClientRowID == 812 || Model.ClientRowID == 810 || Model.ClientRowID == 811)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Location </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                <span>@Model.TechLocation</span>
                            </label>
                        </td>
                    </tr>
                }

                @if (Model.ClientRowID == 679)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Interim Report date </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (Model.InterimReportDate != null)
                                {
                                    <span>@Model.InterimReportDate</span>
                                }

                            </label>
                        </td>
                    </tr>
                }

                @if (Model.ClientRowID == 559)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Interim Report date </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                @if (!string.IsNullOrEmpty(Model.InterimReportDate))
                                {
                                    <span>@Convert.ToDateTime(Model.InterimReportDate).ToString("dd-MM-yyyy")</span>
                                }

                            </label>
                        </td>
                    </tr>
                }

                @if (Model.ClientRowID == 778)
                {
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Mobile No </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                <span>@Model.MobileNo</span>
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Location </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                <span>@Model.TechLocation</span>
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:12px; font-family:Calibri; padding-left:5px;font-weight:bold;">Email </td>
                        <td style="font-size:10px; font-family:Calibri; padding-left:5px;">
                            <label for="">
                                <span>@Model.EmailID</span>
                            </label>
                        </td>
                    </tr>
                }
            </table>
        </td>
    </tr>
</table>
<tr>
    <td colspan="2" height="100">
        <table border="0" cellspacing="0" cellpadding="0" style="width:100%;">
            <tr>
                <td colspan="3" style="border-top:3px solid #c0c0c0;">&nbsp;</td>
            </tr>
            <tr>
                <td valign="bottom" width="20%"><img src="~/Images/Walsons-Report-footer.png" style="width:7rem; margin-left: 15px; margin-bottom: 15px;"></td>
