
@model ViewModels.ReportQCViewModel.ReportViewModel
@{

    if (Model.PersonalName != null)
    {
        <page id="PrintSrc" size="A4">
            <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; height:74rem!important; width:100%;">
                <tr>
                    <td width="2%" align="left" valign="bottom">&nbsp;</td>
                    <td valign="top">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td valign="top">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td>
                                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                    <tr>
                                                        <td width="88%" align="center" style="font-size:25px;"><u><b>SECURITAS INDIA</b> </u></td>
                                                        <td width="6%" valign="top"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem;margin: 10px 10px 0px 10px;"></td>
                                                    </tr>
                                                    <tr><td colspan="2">&nbsp;</td></tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td height="30">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="font-size:15px; width:100%; height: 40px; background-color:gray; font-family:Calibri;"><b>BACKGROUND SCREENING REPORT</b></td>
                                        </tr>
                                        <tr>
                                            <td valign="top" align="center">
                                                <table border="1" cellspacing="5" cellpadding="2" width="793">

                                                    <tr>
                                                        <td style="font-size:15px; width:33%;  font-family:Calibri;"><b>Name of subject</b></td>
                                                        <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.PersonalName </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size:15px; width:33%;  font-family:Calibri;"><b>Client</b></td>
                                                        <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.ClientName</td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Vendor Reference No.</b></td>
                                                        <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.CompanyRefNo</td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Level of Check</b></td>
                                                        <td style="font-size:15px; width:66%;font-family:Calibri;">Additional</td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Client Reference Number / SAP ID</b></td>
                                                        <td style="font-size:15px; width:66%;font-family:Calibri; ">@Model.ClientRefID</td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Date of Report</b></td>
                                                        <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.Current_DateandTime</td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Report Tagging</b></td>
                                                        @if (Model.Current_Status.Contains("Clear"))
                                                        {
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; color:lightgreen"><b>@Model.Current_Status</b></td>
                                                        }
                                                        else if (Model.Current_Status.Contains("Attention requeird"))
                                                        {
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; color:orange"><b>@Model.Current_Status</b></td>
                                                        }
                                                        else
                                                        {
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; color:red"><b>@Model.Current_Status</b></td>
                                                        }
                                                    </tr>

                                                </table>
                                            </td>
                                        </tr>

                                        <tr><td height="20">&nbsp;</td></tr>
                                        <tr>
                                            <td valign="top" align="center" height="30">
                                                <table border="1" cellspacing="5" cellpadding="2" width="793">
                                                    <tr>
                                                        <td align="center" style="font-size:16px; background-color:lightgray;"><b>COURT VERIFICATION REPORT</b></td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr><td valign="top">&nbsp;</td></tr>
                                        <tr><td valign="top" height="10" align="center" style="font-size:16px; width:33%;"><b>EXECUTIVE SUMMARY</b></td></tr>
                                        <tr><td valign="top">&nbsp;</td></tr>
                                        <tr><td valign="top">&nbsp;</td></tr>
                                        <tr>
                                            <td valign="top" align="center" height="20">
                                                <table border="1" cellspacing="5" cellpadding="2" width="793">
                                                    <tr>
                                                        <td style="font-size:15px; width:33%;"><b>Court Verification</b></td>
                                                        @if (Model.Current_Status.Contains("Clear"))
                                                        {
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; color:lightgreen"><b>@Model.Current_Status</b></td>
                                                        }
                                                        else if (Model.Current_Status.Contains("Attention requeird"))
                                                        {
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; color:orange"><b>@Model.Current_Status</b></td>
                                                        }
                                                        else
                                                        {
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; color:red"><b>@Model.Current_Status</b></td>
                                                        }
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr><td valign="top">&nbsp;</td></tr>
                                        <tr><td valign="top">&nbsp;</td></tr>
                                        <tr><td valign="top">&nbsp;</td></tr>
                                        <tr><td valign="top">&nbsp;</td></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td align="left" valign="top">&nbsp;</td>
                </tr>
                <!--- Report Footer with Address Include -->
                @Html.Partial("_ReportFooterAddress")
            </table>

        </page>
    }
}



