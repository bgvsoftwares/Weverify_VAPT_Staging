@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    /**/

    /**/

    //var list = Model.EmploymentInfoModel.Where(x => x.CheckColorName.ToLower().Contains("draft"))

    //                           .ToList();

    //var TestResult = Model.WiproGAPCheckList.Where(T => T.GapFrom.Trim() != "")
    //             .ToList();


    var list = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 304 || T.SubcheckRowID == 463 || T.SubcheckRowID == 464 || T.SubcheckRowID == 481 || T.SubcheckRowID == 542 || T.SubcheckRowID == 543 || T.SubcheckRowID == 544).GroupBy(x => x.SubcheckRowID)
                              .Select(g => g.First())
                              .ToList();

    var GapFrom = "";
    var GapTo = "";
    var GapReason = "";

    var GapFrom1 = "";
    var GapTo1 = "";
    var GapReason1 = "";

    var GapFrom2 = "";
    var GapTo2 = "";
    var GapReason2 = "";

    var GapFrom3 = "";
    var GapTo3 = "";
    var GapReason3 = "";


    var GapFrom4 = "";
    var GapTo4 = "";
    var GapReason4 = "";


    var GapFrom5 = "";
    var GapTo5 = "";
    var GapReason5 = "";




    if (Model.SpecialInfoModel.Any(T => T.SubcheckRowID == 304))
    {
        GapFrom = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 304 && T.AntecedentRowID == "191").FirstOrDefault().OpsValue.ToString();
        GapTo = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 304 && T.AntecedentRowID == "426").FirstOrDefault().OpsValue.ToString();
        GapReason = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 304 && T.AntecedentRowID == "422").FirstOrDefault().OpsValue.ToString();

    }

    if (Model.SpecialInfoModel.Any(T => T.SubcheckRowID == 463))
    {
        GapFrom1 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 463 && T.AntecedentRowID == "191").FirstOrDefault().OpsValue.ToString();
        GapTo1 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 463 && T.AntecedentRowID == "426").FirstOrDefault().OpsValue.ToString();
        GapReason1 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 463 && T.AntecedentRowID == "422").FirstOrDefault().OpsValue.ToString();

    }


    if (Model.SpecialInfoModel.Any(T => T.SubcheckRowID == 464))
    {
        GapFrom2 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 464 && T.AntecedentRowID == "191").FirstOrDefault().OpsValue.ToString();
        GapTo2 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 464 && T.AntecedentRowID == "426").FirstOrDefault().OpsValue.ToString();
        GapReason2 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 464 && T.AntecedentRowID == "422").FirstOrDefault().OpsValue.ToString();
    }


    if (Model.SpecialInfoModel.Any(T => T.SubcheckRowID == 542))
    {
        GapFrom3 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 542 && T.AntecedentRowID == "191").FirstOrDefault().OpsValue.ToString();
        GapTo3 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 542 && T.AntecedentRowID == "426").FirstOrDefault().OpsValue.ToString();
        GapReason3 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 542 && T.AntecedentRowID == "422").FirstOrDefault().OpsValue.ToString();
    }


    if (Model.SpecialInfoModel.Any(T => T.SubcheckRowID == 543))
    {
        GapFrom4 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 543 && T.AntecedentRowID == "191").FirstOrDefault().OpsValue.ToString();
        GapTo4 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 543 && T.AntecedentRowID == "426").FirstOrDefault().OpsValue.ToString();
        GapReason4 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 543 && T.AntecedentRowID == "422").FirstOrDefault().OpsValue.ToString();

    }


    if (Model.SpecialInfoModel.Any(T => T.SubcheckRowID == 544))
    {
        GapFrom5 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 544 && T.AntecedentRowID == "191").FirstOrDefault().OpsValue.ToString();
        GapTo5 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 544 && T.AntecedentRowID == "426").FirstOrDefault().OpsValue.ToString();
        GapReason5 = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 544 && T.AntecedentRowID == "422").FirstOrDefault().OpsValue.ToString();

    }





}


@if (list.Count > 0)
{
    <page id="PrintSrc" size="A4">
        <div style="page-break-after:always ;"></div>
        <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999;border-collapse:collapse; width:100%;">
            <tr style="height:65rem!important;">
                <td valign="top">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width: 94%; margin: auto;">
                        <tr>
                            <td valign="top">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td>
                                            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                                <tr>
                                                    <td style="font-size: 20px!important; border: none!important; font-family: Calibri; -webkit-print-color-adjust: exact;" colspan="4" align="right" height="20"><span style="font-family: Calibri, sans-serif;"><strong><img src='@Url.Content("~/Images/Securitas-logo.png")' style="width:75px; margin-top:10px; margin-right: 20px;"></strong></span></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="30">&nbsp;</td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; text-align:center; font-size:20px;font-family:Calibri"> GAP Validation</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-top:10px;" valign="top" align="center">
                                            <table width="100%" border="1" cellspacing="5" cellpadding="2" style="border-collapse:collapse;border-collapse:collapse;font-family:Calibri;font-size:17px">

                                                <tr>
                                                    <td align="center">Gap from</td>
                                                    <td align="center">Gap to</td>
                                                    <td align="center">Remarks</td>


                                                </tr>



                                                @if (!string.IsNullOrEmpty(GapFrom.Trim()))
                                                {

                                                    <tr>

                                                        <td align="center">@GapFrom</td>
                                                        <td align="center">@GapTo</td>
                                                        <td align="center">@GapReason</td>
                                                    </tr>

                                                }

                                                @if (!string.IsNullOrEmpty(GapFrom1.Trim()))
                                                {

                                                    <tr>

                                                        <td align="center">@GapFrom1</td>
                                                        <td align="center">@GapTo1</td>
                                                        <td align="center">@GapReason1</td>
                                                    </tr>

                                                }

                                                @if (!string.IsNullOrEmpty(GapFrom2.Trim()))
                                                {

                                                    <tr>

                                                        <td align="center">@GapFrom2</td>
                                                        <td align="center">@GapTo2</td>
                                                        <td align="center">@GapReason2</td>
                                                    </tr>

                                                }


                                                @if (!string.IsNullOrEmpty(GapFrom3.Trim()))
                                                {

                                                    <tr>

                                                        <td align="center">@GapFrom3</td>
                                                        <td align="center">@GapTo3</td>
                                                        <td align="center">@GapReason3</td>
                                                    </tr>

                                                }

                                                @if (!string.IsNullOrEmpty(GapFrom4.Trim()))
                                                {

                                                    <tr>

                                                        <td align="center">@GapFrom4</td>
                                                        <td align="center">@GapTo4</td>
                                                        <td align="center">@GapReason4</td>
                                                    </tr>

                                                }




                                                @if (!string.IsNullOrEmpty(GapFrom5.Trim()))
                                                {

                                                    <tr>

                                                        <td align="center">@GapFrom5</td>
                                                        <td align="center">@GapTo5</td>
                                                        <td align="center">@GapReason5</td>
                                                    </tr>

                                                }






                                            </table>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>


        </table>

    </page>


    if (Model.CandidateDocList != null)
    {

        foreach (var Doc in Model.CandidateDocList.Where(w => w.SubCheckRowID == 304 || w.SubCheckRowID == 463 || w.SubCheckRowID == 464 || w.SubCheckRowID == 542 || w.SubCheckRowID == 543 || w.SubCheckRowID == 544))
        {
            if (Doc.SubCheckRowID == 304 || Doc.SubCheckRowID == 463 || Doc.SubCheckRowID == 464 || Doc.SubCheckRowID == 542 || Doc.SubCheckRowID == 543 || Doc.SubCheckRowID == 544)
            {
                FileInfo fin = new FileInfo(Server.MapPath(Model.DocPath + Doc.DocFile));
                if (fin.Exists && (fin.Extension.ToLower().Contains(".jpg") || fin.Extension.ToLower().Contains(".jpeg") || fin.Extension.ToLower().Contains(".png")))
                {
                    <page id="PrintSrc" size="A4">
                        <div style="page-break-after:always ;"></div>
                        <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; align-content:center; width:100%;">
                            <tr style="height:65rem;">
                                <td valign="top" colspan="2" align="center">
                                    <table style="width:100%;" border="0" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td valign="top">
                                                <table style="width:100%;" border="0" cellspacing="0" cellpadding="0">
                                                    <tr>
                                                        <td style="font-size:10px; font-family:Calibri;">
                                                            <table style="width:100%;" border="0" cellspacing="0" cellpadding="0">
                                                                <tr>
                                                                    <td style="font-size: 20px!important; border: none!important; font-family: Calibri; -webkit-print-color-adjust: exact;" colspan="4" align="right" height="20"><span style="font-family: Calibri, sans-serif;"><strong><img src='@Url.Content("~/Images/Securitas-logo.png")' style="width:75px; margin-top:10px; margin-right: 20px;"></strong></span></td>
                                                                </tr>
                                                                <tr>
                                                                    <td width="100%"><p style="font-size:16px;  color:#000000; text-align:center; font-weight:bold; text-decoration:underline; text-transform:none; margin:0px; text-align:center;"> (@Doc.DocumentType)</p></td>
                                                                </tr>
                                                                <tr><td colspan="2">&nbsp;</td></tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                    <tr style="text-align:center">
                                                        <td valign="top">
                                                            @{
                                                                FileStream fs = new FileStream(Server.MapPath(Model.DocPath + Doc.DocFile), FileMode.Open, FileAccess.Read);
                                                                System.Drawing.Image image = System.Drawing.Image.FromStream(fs);

                                                                if (image.Height > 600)
                                                                {
                                                                    <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" style="width:100%; height:60rem;" />
                                                                }
                                                                else
                                                                {
                                                                    <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" style="width:100%; height:60rem;" />
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td valign="bottom">
                                    <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                                        <tbody>
                                            <tr>
                                                <td style="border-top:2px solid rgb(190, 190, 190);" colspan="3">
                                                    &nbsp;
                                                </td>
                                            </tr>
                                            <tr>
                                                <td width="20%"><br><br><br><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                                                <td width="1%">&nbsp;</td>
                                                <td width="79%">
                                                    <p style="font-size: 16px!important; font-family: Calibri, sans-serif; color:#000080; font-weight:500; text-align:center; margin:0px 0px 0px 0px;"><img src="~/Images/StampSignatureUpdated.jpg" width="60" height="60"></p>
                                                    <p style="font-size: 16px!important; font-family: Calibri, sans-serif; color:#000080; font-weight:700; text-align:center; margin:0px 0px 0px 0px;">SECURITAS INDIA</p>
                                                    <p style="font-size: 15px;font-family: Calibri, sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp; &nbsp;Tel: + 91 124 4718888</p>
                                                    <p style="font-size: 15px; font-family: Calibri, sans-serif; color:#3a00ff; text-align:center; margin:5px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a> <span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </page>
                }
            }
        }
    }

}