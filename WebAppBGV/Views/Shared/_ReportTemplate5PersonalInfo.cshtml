                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td valign="top">
                                <table width="100%" cellpadding="2" cellspacing="5" id="table5Personal">
                                    @{
                                        string checkName = string.Empty;
                                        <tr>
                                            <td width="20%" style="font-size:12px; font-family:Calibri; color-adjust:exact;  padding-left:5px; border:1px solid #000;border-collapse:collapse;"><strong>TYPE OF CHECK</strong></td>
                                            <td width="50%" style="font-size:12px; font-family:Calibri; color-adjust:exact; text-align:center; border:1px solid #000;border-collapse:collapse;"><strong>VERIFICATION STATUS (VERIFIED / NOT APPLICABLE)</strong></td>
                                            <td width="30%" style="font-size:12px; font-family:Calibri; color-adjust:exact;  text-align:center; border:1px solid #000;border-collapse:collapse;"><strong>BGC STATUS</strong></td>
                                        </tr>

                                        foreach (var item in Model.PersonalChecksBriefDetails)
                                        {
                                            if (checkName != item.CheckFName)
                                            {
                                                if (checkName != "")
                                                {
                                                    <tr style="border:0;">
                                                        <td colspan="3" style="border:0;">
                                                            <br />
                                                        </td>
                                                    </tr>

                                                }

                                                <tr>
                                                    <td colspan="4" bgcolor="#c0c0c0" style="font-size:12px;border:1px solid #000;border-collapse:collapse; font-family:Calibri; color-adjust:exact; background:#c0c0c0; padding:5px; text-align:left;"> <strong> @item.CheckFName</strong></td>
                                                </tr>


                                                checkName = item.CheckFName;
                                            }
                                                <tr style=" font-size:12px; font-weight:bold; padding:5px;">
                                                    <td style="padding-left:5px; border:1px solid #000;border-collapse:collapse; font-size:12px; font-family:Calibri;">@item.SubCheckFName</td>
                                                    <td align="left" style="font-size:12px; border:1px solid #000;border-collapse:collapse; font-family:Calibri;">@item.SubCheckDetail</td>
                                                    @if (@item.Status == "Not Applicable")
                                                    {
                                                        <td border="1" style="color-adjust:exact; border:1px solid #000;border-collapse:collapse; font-size:12px; font-family:Calibri; background:@item.ColorCode;" align="center">Not Applicable</td>
                                                    }
                                                    else if (@item.Status == "On Hold")
                                                    {
                                                        <td border="1" style="color-adjust:exact; border:1px solid #000;border-collapse:collapse; font-size:12px; font-family:Calibri; background:@item.ColorCode;" align="center">On Hold</td>

                                                    }
                                                    else if (@item.Status == "WIP")
                                                    {
                                                        <td border="1" style="color-adjust:exact; border:1px solid #000;border-collapse:collapse; font-size:12px; font-family:Calibri; background:@item.ColorCode;" align="center">WIP</td>

                                                    }
                                                    else if (@item.ColorName == "NA")
                                                    {
                                                        <td border="1" style="color-adjust:exact; border:1px solid #000;border-collapse:collapse; font-size:12px; font-family:Calibri; " align="center">NA</td>

                                                    }
                                                    else
                                                    {
                                                        <td border="1" style="color-adjust:exact; border:1px solid #000;border-collapse:collapse; font-size:12px; font-family:Calibri; color:@item.ColorCode" align="center">@item.ColorName</td>
                                                    }
                                                    @*<td style="color-adjust:exact; font-size:12px; font-family:Calibri; background:@item.ColorCode;" align="center">@item.ColorName</td>*@
                                                </tr>

                                        }
                                    }
                                            <tr>
                                                <td colspan="4" style=" border:0; text-align:left"><img src='@Url.Content("~/Images/Signature.JPG")'></td>
                                            </tr>
                                    <tr>
                                        <td colspan="4" style="padding-left:25px; font-size:12px; font-family:Calibri; border:hidden">
