                                                Date:
                                                @if (Model.ReportDate != null)
                                                {<span>@Model.ReportDate.ToString("dd-MMM-yyyy")</span> }
                                            else
                                            { <span>N/A</span>}
                                            </label>
                                        </td>
                                    </tr>

                                </table>
                            </td>
