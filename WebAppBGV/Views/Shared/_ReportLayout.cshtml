            '</body>' +
            '\n</html>'
        );

        WinPrint.document.close();
        WinPrint.focus();
        WinPrint.print();
        //WinPrint.close();
    }

    function CallPrintLatest(strid) {
        // 1. उस Div का HTML निकालें जिसे PDF बनाना है
        var prtContent = document.getElementById(strid).innerHTML;

        // 2. पूरा HTML ढांचा तैयार करें (जैसे आपके पुराने कोड में था)
        var fullHtml = '<html><head>' +
            '<link href="/Images/report.css" rel="stylesheet" type="text/css" />' +
            '</head><body>' +
            '<div>' + prtContent + '</div>' +
            '</body></html>';

        // 3. इस HTML को बैकएंड MVC कंट्रोलर पर POST करें
        fetch('/ReportQc/GeneratePDFFromHtml', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ htmlContent: fullHtml })
        })
            .then(response => {
                if (!response.ok) throw new Error("PDF generation failed");
                return response.blob();
            })
            .then(blob => {
                // 4. बैकएंड से आई PDF फाइल को डाउनलोड करवाएं
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = "Report_" + new Date().getTime() + ".pdf";
                document.body.appendChild(a);
                a.click();
                a.remove();
            })
            .catch(error => alert("Error: " + error.message));
    }


