            var newDiv9 = `<td style="text-align: center; font-weight: bolder; border: 1px solid #000; border-bottom: 1px solid #000; font-size: 14px; padding: 5px; "> NA </td>`;


            var targetSpan10 = `<td width="50%" style="font-size: 14px; text-align:center;">Same As Present</td>`;
            var newDiv10 = `<td width="50%" style="font-size: 14px; text-align:center; border-bottom: 1px solid #000;">Same As Present</td>`;

            completeHTML = completeHTML.split(targetSpan).join(newDiv);
