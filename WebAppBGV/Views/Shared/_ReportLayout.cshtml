            var targetSpan4 = '<td colspan="2" style="padding: 8px; font-size: 14px; font-weight: bolder; border-left: 1px solid #000;">';
            var newDiv4 = '<td colspan="2" style="padding: 8px; font-size: 14px; font-weight: bolder; border-left: 1px solid #000; border-right: 1px solid #000;border-bottom: 1px solid #000;">';

            var targetSpan5 = `<span style="font-size:14px;font-family:&quot;Calibri&quot;;color:#948A54;">`;
