<script>
    function GenerateWordReportSA1(strid) {

        const prtContent = document.getElementById(strid);

        let htmlContent = prtContent.innerHTML;

        // Remove invalid tags like <page>
        htmlContent = htmlContent.replace(/<page[^>]*>/gi, '');
        htmlContent = htmlContent.replace(/<\/page>/gi, '');

        // Fix multiple borders issue
        htmlContent = htmlContent.replace(/border="0"/gi, '');
        htmlContent = htmlContent.replace(/cellspacing="0"/gi, '');
        htmlContent = htmlContent.replace(/cellpadding="0"/gi, '');

        // Wrap clean HTML
        htmlContent = `
    <html>
    <head>
        <meta charset="utf-8">
        <style>
            body { font-family: Calibri; }

            table {
                border-collapse: collapse;
                width: 100%;
            }

            td, th {
                border: 1px solid black;
                padding: 5px;
                vertical-align: top;
            }
        </style>
    </head>
    <body>
        ${htmlContent}
    </body>
    </html>`;

