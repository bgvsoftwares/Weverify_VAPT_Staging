            completeHTML = completeHTML.split(targetSpan2).join(newDiv2);
            completeHTML = completeHTML.split(targetSpan3).join(newDiv3);
            completeHTML = completeHTML.split(targetSpan4).join(newDiv4);
            completeHTML = completeHTML.split(targetSpan5).join(newDiv5);
            completeHTML = completeHTML.split(targetSpan6).join(newDiv6);
            completeHTML = completeHTML.split(targetSpan7).join(newDiv7);
            completeHTML = completeHTML.split(targetSpan8).join(newDiv8);
            completeHTML = completeHTML.split(targetSpan9).join(newDiv9);
            completeHTML = completeHTML.split(targetSpan10).join(newDiv10);




            $("input[name='userhtml']").val(completeHTML);
            console.log(completeHTML);
        }
