<page id="PrintSrc" size="A4">
    <div style="page-break-after:always ;"></div>
    <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;">
        <tr>
            <td valign="top" style="height:50rem;">
                <table cellpadding="2" cellspacing="5" id="tblDemo" style="width:100%;">
                    <tr>
                        <td style="padding: 35px; padding-bottom: 10px;" colspan="3">
                            <p style="color: #55419E; font-size: 32px; font-weight: bold;">3. Consolidated Risk Overview </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding-left: 35px; padding-right: 35px;" valign="top" align="center">
                            <table border="1" cellspacing="5" cellpadding="2" style="width:98%;">

                                @if (Model.RiskMatrixConsolidateInfoModel != null)
                                {
                                    foreach (var item in Model.RiskMatrixConsolidateInfoModel)
                                    {
                                        <tr>
                                            <td style="text-align: left; font-size: 16px; font-family: Calibri; height: 40px !important; width: 26%">@item.Level</td>
                                            <td style="text-align: left; font-size: 16px; font-family: Calibri; height: 40px !important; width: 10%">@item.Status</td>
                                            <td style="text-align: left; font-size: 16px; font-family: Calibri; height: 40px !important; width: 64%">@item.Remarks</td>
                                        </tr>
                                    }
                                }

                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 35px; padding-bottom: 10px;" colspan="3">
                            <p style="color: #55419E; font-size: 32px; font-weight: bold;">4. Risk Matrix (Likelihood × Impact) </p>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" style="padding-left: 35px; padding-right: 35px;" align="center">
                            <table border="1" cellspacing="5" cellpadding="2" style="width:98%;">
                                <tr>
                                    <td width="20%" style="font-family:Calibri; -webkit-print-color-adjust:exact;background:#c0c0c0;text-align:center; font-size:14px;  font-weight:700;">Risk Factor</td>
                                    <td width="20%" style="font-family:Calibri; -webkit-print-color-adjust:exact;background:#c0c0c0;text-align:center; font-size:14px;  font-weight:700;">Likelihood (1–5)</td>
                                    <td width="20%" style="font-family:Calibri; -webkit-print-color-adjust:exact;background:#c0c0c0;text-align:center; font-size:14px;  font-weight:700;">Impact (1–5)</td>
                                    <td width="20%" style="font-family:Calibri; -webkit-print-color-adjust:exact;background:#c0c0c0;text-align:center; font-size:14px;  font-weight:700;">Risk Score</td>
                                    <td width="20%" style="font-family:Calibri; -webkit-print-color-adjust:exact;background:#c0c0c0;text-align:center; font-size:14px;  font-weight:700;">Category</td>
                                </tr>
                                @if (Model.RiskFactorInfoModel != null)
                                {
                                    foreach (var item in Model.RiskFactorInfoModel)
                                    {
                                        if (item.RiskType == "Risk Factor")
                                        {
                                            <tr>
                                                <td style="text-align:center; font-size: 16px; font-family:Calibri; height:40px !important;">@item.RiskFactor</td>
                                                @if (item.Likelihood == 0)
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">NA</td>
                                                }
                                                else
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">@item.Likelihood</td>
                                                }
                                                @if (item.Impact == 0)
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">NA</td>
                                                }
                                                else
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">@item.Impact</td>
                                                }
                                                @if (item.RiskScore == 0)
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">NA</td>
                                                }
                                                else
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">@item.RiskScore</td>
                                                }
                                                @if (item.RiskScore == 0)
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">NA</td>
                                                }
                                                else
                                                {
                                                    <td style="text-align:center; font-size:16px; font-family:Calibri; height:40px!important;">@item.Category</td>
                                                }
                                            </tr>
                                        }

                                    }
                                }
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 35px; padding-bottom: 10px;" colspan="3">
                            <p style="color: #55419E; font-size: 32px; font-weight: bold;">5. Overall Risk Rating </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding-left: 35px; padding-bottom: 10px;" colspan="3">
                            <p style="font-size: 16px;">
                                Final Risk Score: @Model.TotalRiskScore/100 –
                                @if (Model.TotalRiskScore >= 1 && Model.TotalRiskScore <= 25)
                                {
                                    <span>Low Risk</span>
                                }
                                else if (Model.TotalRiskScore >= 26 && Model.TotalRiskScore <= 50)
                                {
                                    <span>Moderate Risk</span>
                                }
                                else
                                {
                                    <span>High Risk</span>
                                }
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</page>

