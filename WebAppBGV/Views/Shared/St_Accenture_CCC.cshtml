

@model ViewModels.ReportQCViewModel.ReportViewModel
@{

    if (Model.PersonalName != null)
    {
        <page id="PrintSrc" size="A4">

            <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; height:74rem!important; width:100%;">
                <tr>
                    <td width="2%" align="left" valign="bottom">&nbsp;</td>
                    <td valign="top">
                        <table width="100%" border="0"  cellpadding="0" cellspacing="0">
                            <tr>
                                <td valign="top">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td>
                                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                    <tr>
                                                        <td width="88%" align="center" style="font-size:25px;"><u><b>SECURITAS INDIA</b> </u></td>
                                                        <td width="6%" valign="top"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem;margin: 10px 10px 0px 10px;"></td>
                                                    </tr>
                                                    <tr><td colspan="2">&nbsp;</td></tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td valign="top" style="font-size:14px; font-style:unset " align="left"><u>Current Address</u></td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>

                                        <tr>
                                            <td valign="top" align="center">
                                                <b style=" font-size:18px;">TO WHOMSOEVER IT MAY CONCERN</b>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td height="30">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td height="30" style="font-size:14px;">This information is given with regards to the search conducted for:</td>
                                        </tr>
                                        <tr>
                                            <td valign="top" align="center">
                                                <table border="1" cellspacing="5" cellpadding="2" width="793">
                                                    <tr>
                                                        <td class="td1">Name of Subject </td>
                                                        <td class="td2"> @Model.PersonalName </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td1">Father’s Name </td>
                                                        <td class="td2"> @Model.FatherName </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td1">CID</td>
                                                        <td class="td2"> @Model.ClientRefID </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td1"> Date of Birth</td>
                                                        <td class="td2"> @Model.DOB </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td1">Address</td>
                                                        <td class="td2"> @Model.Address_currentPermanantSame </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td1">Date of Verification</td>
                                                        <td class="td2"> @Model.FinalReportDate </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td1">Value Pitch Search ID</td>
                                                        <td class="td2"> @Model.ValuePitchSearchID </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td valign="top" align="center" style="font-size:18px;"><u><b>Results</b> </u></td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td height="30" style="font-size:14px;">
                                                Criminal Proceedings: Criminal Petitions / Criminal Appeal / Sessions Case / Criminal Miscellaneous Petition /
                                                Criminal Revision Appeal
                                            </td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td valign="top" align="center">
                                                <table border="1" cellspacing="5" cellpadding="2" width="793">
                                                    <tr>
                                                        <td class="td1">Court</td>
                                                        <td class="td1">Court Name</td>
                                                        <td class="td1">Result</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td3">Magistrate Court   </td>
                                                        <td class="td3">All Magistrate Courts  </td>
                                                        <td class="td3">@Model.MagistrateCourt </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td3">Sessions Court</td>
                                                        <td class="td3">All Sessions Courts</td>
                                                        <td class="td3">@Model.SessionsCourt</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td3">High Court</td>
                                                        <td class="td3">All High Courts</td>
                                                        <td class="td3">@Model.HighCourt</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="td3"> Supreme Court </td>
                                                        <td class="td3">Supreme Court of India</td>
                                                        <td class="td3">@Model.SupremeCourt</td>
                                                    </tr>

                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td height="30" style="font-size:14px; margin-top:20px">
                                                Conclusion:
                                            </td>
                                        </tr>
                                        <tr>
                                            <td height="30" style="font-size:14px;">
                                                In conclusion, as on date of this search, there appears to be no Criminal Case instituted against the subject
                                                at the given address.
                                            </td>
                                        </tr>
                                        <tr>
                                            <td height="130" style="font-size:14px;"></td>
                                        </tr>

                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td align="left" valign="top">&nbsp;</td>
                </tr>
                <!--- Report Footer with Address Include -->
                @Html.Partial("_ReportFooterAddress")
            </table>

        </page>
    }
}
<style>
    .td1 {
        font-size: 14px;
        width: 33%;
        font-weight: bold;
        font-family: Calibri;
    }

    .td2 {
        font-size: 14px;
        width: 67%;
        font-family: Calibri;
    }

    .td3 {
        font-size: 14px;
        width: 33%;
        font-family: Calibri;
    }
</style>


