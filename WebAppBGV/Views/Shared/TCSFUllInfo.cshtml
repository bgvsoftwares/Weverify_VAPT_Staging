
@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    if (HttpContext.Current.Items["PageNumber"] == null)
    {
        HttpContext.Current.Items["PageNumber"] = 1;
    }

    int pageNumber = (int)HttpContext.Current.Items["PageNumber"];

    bool isAddressSwapped = false;
    bool isCriminalSwapped = false;
    var EducationVerificationStatus = "";
    var Address1VerificationStatus = "";
    var Address2VerificationStatus = "";
    var Criminal1VerificationStatus = "";
    var Criminal2VerificationStatus = "";
    var Employment1VerificationStatus = "";
    var Employment2VerificationStatus = "";
    var Employment3VerificationStatus = "";
    var Employment4VerificationStatus = "";
    var VerificationStatus = "";

    if ((Model.ClientRowID == 268 || Model.ClientRowID == 3) && Model.PersonalChecksBriefDetails != null)
    {
        var mainList = Model.PersonalChecksBriefDetails.ToList();

        var currentAddress = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 2 && x.subCheckId == 2);

        var permanentAddress = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 2 && x.subCheckId == 13);

        var currentCriminal = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 5 && x.subCheckId == 24);

        var permanentCriminal = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 5 && x.subCheckId == 28);

        if (currentAddress != null && currentAddress.VerificationStatus != null &&
            currentAddress.VerificationStatus.ToLower() == "same as permanent")
        {
            int i = mainList.IndexOf(currentAddress);
            int j = mainList.IndexOf(permanentAddress);

            var temp = mainList[i];
            mainList[i] = mainList[j];
            mainList[j] = temp;

            isAddressSwapped = true;
        }

        if (currentCriminal != null && currentCriminal.VerificationStatus != null &&
            currentCriminal.VerificationStatus.ToLower() == "same as permanent")
        {
            int i = mainList.IndexOf(currentCriminal);
            int j = mainList.IndexOf(permanentCriminal);

            var temp = mainList[i];
            mainList[i] = mainList[j];
            mainList[j] = temp;

            isCriminalSwapped = true;
        }

        Model.PersonalChecksBriefDetails = mainList;

        var currentAddressStatus = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 2 && x.subCheckId == 2);

        if (currentAddressStatus != null)
        {
            Address1VerificationStatus = currentAddressStatus.VerificationStatus;
        }

        var PermanentAddressStatus = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 2 && x.subCheckId == 13);

        if (PermanentAddressStatus != null)
        {
            Address2VerificationStatus = PermanentAddressStatus.VerificationStatus;
        }

        var CurrentCriminal = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 5 && x.subCheckId == 24);

        if (CurrentCriminal != null)
        {
            Criminal1VerificationStatus = CurrentCriminal.VerificationStatus;
        }

        var PermanentCriminal = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 5 && x.subCheckId == 28);

        if (PermanentCriminal != null)
        {
            Criminal2VerificationStatus = PermanentCriminal.VerificationStatus;
        }

        var currentEducation = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 11 && x.subCheckId == 56);
        if (currentEducation != null)
        {
            EducationVerificationStatus = currentEducation.VerificationStatus;
        }


        if (Model.EmploymentType == "Experience Professional")
        {
            var currentEmployment = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 12 && x.subCheckId == 68);

            if (currentEmployment != null)
            {
                VerificationStatus = currentEmployment.VerificationStatus;
            }

            var PreviousEmployment1 = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 12 && x.subCheckId == 69);

            if (PreviousEmployment1 != null)
            {
                Employment1VerificationStatus = PreviousEmployment1.VerificationStatus;
            }

            var PreviousEmployment2 = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 12 && x.subCheckId == 70);

            if (PreviousEmployment2 != null)
            {
                Employment2VerificationStatus = PreviousEmployment2.VerificationStatus;
            }

            var PreviousEmployment3 = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 12 && x.subCheckId == 71);

            if (PreviousEmployment3 != null)
            {
                Employment3VerificationStatus = PreviousEmployment3.VerificationStatus;
            }

            var PreviousEmployment4 = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 12 && x.subCheckId == 72);

            if (PreviousEmployment4 != null)
            {
                Employment4VerificationStatus = PreviousEmployment4.VerificationStatus;
            }

        }

    }

    var PP = Model.PersonalChecksBriefDetails.Take(6).ToList();

    var notExcluded = Model.PersonalChecksBriefDetails.Except(PP).ToList();


}




