                                                        <td style="font-size: 14px; font-weight: bold; text-align: left;">
                                                            Date: @DateTime.Now.ToString("dd MMMM yyyy")
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>

                                            <td style="width: 53%; vertical-align: top;">
                                                <table style="width: 100%;">
                                                    <tr>
                                                        <td style="font-size: 14px; font-weight: bold; padding-left: 120px">
                                                            NAME & SIGNATURE OF BRANCH MANAGER / <br />TEAM LEAD: Subhash Priyadarshi
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align:left;">
                                                            <img style="width: 30%; padding-left:197px;" src="~/Images/UpdatedSignature.png" alt="Branch Manager Signature">
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            @if (Model.ClientRowID == 268 || Model.ClientRowID == 3)
                                            {
                                                <td style="text-align: left; font-style: italic; font-size: 14px; padding: 5px;">TCS Confidential</td>
                                            }
                                            <td style="text-align: right; font-style: italic; font-size: 14px; padding: 5px;">Page No. @pageNumber -</td>
                                        </tr>
                                    </table>
                                    {
                                        pageNumber++;
                                        HttpContext.Current.Items["PageNumber"] = pageNumber;
                                    }
                                }

                            </page>
                        }

                    }
                }
            }


            i++;
        }
    }
}


