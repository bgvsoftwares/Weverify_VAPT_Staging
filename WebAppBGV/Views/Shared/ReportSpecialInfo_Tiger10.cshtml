                        <div style="page-break-after:always ;"></div>
                        @Html.Partial("REportSpecialKeyword")

                    </page>
                }

                if ((a.SubcheckRowID == 200) && Model.ReportPart != "CRC")    // Indian Database Check
                {

                    <page id="PrintSrc" size="A4">
                        <div style="page-break-after:always ;"></div>
                        @Html.Partial("IndianDataBaseKeyword")

                    </page>
                }
            }




        }
    }

}





