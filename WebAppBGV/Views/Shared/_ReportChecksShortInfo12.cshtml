
@if (Model != null && Model.PersonalChecksBriefDetails != null && Model.PersonalChecksBriefDetails.Count > 0)
{
    <page id="PrintSrc" size="A4">
        @if (Model.ReportTemplate != 5)
        {
            <div style="page-break-after:always ;"></div>
        }
        <table width="793" height="1150" @*border="0"*@ cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; ">
            <!--- Report Header Include -->
            @*@Html.Partial("_ReportHeader")*@
            <!--- Report Header Include -->
            <tr>
                <td width="2%" align="left" valign="bottom" @*style="border-left:2px solid #999999;"*@>&nbsp;</td>
                <td valign="top">
                    <table width="100%" border="0" cellpadding="0" cellspacing="0">
                        @if (Model.ReportTemplate == 1)
                        {
                            @Html.Partial("_ReportTemplate1ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 2 && Model.ClientRowID != 787)
                        {
                            @Html.Partial("_ReportTemplate2ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 3)
                        {
                            @Html.Partial("_ReportTemplate3ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 4)
                        {
                            @Html.Partial("_ReportTemplate4ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 5)
                        {
                            // @Html.Partial("_ReportTemplate5ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 6)
                        {
                            @Html.Partial("_ReportTemplate6ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 8)
                        {
                            @Html.Partial("_ReportTemplate8ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 9)//Tech Mahindra Limited(446)
                        {
                            @Html.Partial("_ReportTemplateChecksShortInfoTechM")
                        }
                        else if (Model.ReportTemplate == 11)
                        {
                            @Html.Partial("_ReportTemplate11ChecksShortInfo")
                        }
                        else if (Model.ReportTemplate == 12)
        {
            @Html.Partial("_ReportTemplate12ChecksShortInfo")
        }
                        else if (Model.ClientRowID == 787)// CapGemini
                        {
                            @Html.Partial("_CapGeminiReportTemplateChecksShortInfo")
                        }



                    </table>
                </td>
                <td @*style="border-right:2px solid #999999;"*@ align="left" valign="top">&nbsp;</td>
            </tr>
            <!--- Report Footer with Address Include -->
            @if (Model.ReportTemplate != 5)
            {
                @Html.Partial("_ReportFooterAddress")
            }

            <!--- Report Footer with Address Include -->
            <!--- Report Footer Include -->
            @*@Html.Partial("_ReportFooter")*@
            <!--- Report Footer Include -->
        </table>
    </page>
}
