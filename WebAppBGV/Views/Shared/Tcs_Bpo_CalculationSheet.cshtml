@model ViewModels.ReportQCViewModel.InterimReportGenerateViewModel

        <page id="PrintSrc" size="A4">
            <div style="page-break-after:always ;"></div>
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td>
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td colspan="2" align="right"><img src='@Url.Content("~/Images/logo.jpg")' width="71"></td>
                            </tr>
                            <tr><td></td></tr>
                            <tr>
                                <td width="94%"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Calculation Sheet</p></td>
                                @*<td width="6%" align="right"><img src='@Url.Content("~/Images/logo.jpg")' width="71" height="40"></td>*@
                            </tr>

                        </table>
                    </td>
                </tr>
                <tr>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <td valign="top">
                        <table width="100%" border="1" cellpadding="4" cellspacing="1" style="border:groove; border-color:gainsboro; border-spacing:4px; margin-top:30px; font-size:10px; font-weight:bold">

                            <tr style="background:#c0c0c0;">
                                <td colspan="4"   style="font-size:12px; font-family:Calibri; color-adjust:exact;background:#c0c0c0; font-weight:bold; text-align:center">Walsons Service Private Limited</td>

                            </tr>

                            <tr style="margin-top:20px;">
                                <td colspan="4" style="font-size:12px; font-family:Calibri; color-adjust:exact;background:#c0c0c0; font-weight:bold; text-align:center">BGC Charges</td>

                            </tr>




                        </table>
                        <table width="100%" border="1" cellpadding="4" cellspacing="1" style="border:groove; border-color:gainsboro; margin-top:10px; border-spacing:4px; font-size:10px; font-weight:bold">
                            <tr style="margin-top:10px; ">
                                <td style="color-adjust:exact; background:#c0c0c0;" width="25%">Unique Id</td>
                               
                                @if (Model.EmploymentId != "")
                                {
                                <td>@Model.EmploymentId</td>
                                
                                }
                                else
                                {
                                <td></td>
                                }
                                <td style="color-adjust:exact; background:#c0c0c0;">Vendor RF-ID</td>
                                <td>@Model.CompanyRefNo</td>

                            </tr>
                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;">NAME OF CANDIDATE</td>
                                <td colspan="3">@Model.PersonalName</td>

                            </tr>
                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;">RECRUITMENT LOCATION</td>
                                @*<td colspan="3">@Model.CalsheetLocation</td>*@
                                
                                <td colspan="3">@Model.LocationTCS</td>

                            </tr>
                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;">DATE OF BIRTH</td>
                                @*<td>@Model.DOB</td>*@
                                @if (@Model.DOB != null)
    {
                            <td>@Model.DOB.Value.ToString("dd-MM-yyyy")</td>
}
else
{
                            <td></td>
}
                                <td style="color-adjust:exact; background:#c0c0c0;"> FINAL BGC STATUS</td>
                                @if (@Model.ReportTypeBYSystum == "Final")
    {
                            <td style="color:#035303;font-weight:bold;font-size: 14px;">@Model.FinalColor _SR</td>
}
                                @if (@Model.status ==3)
    {
                            <td style="color:#035303;font-weight:bold;font-size: 14px;">@Model.FinalColor _SC</td>
}
else
{
                            <td style="color:#035303;font-weight:bold;font-size: 14px;">Final_@Model.FinalColor</td>
}


                            </tr>
                            <tr>
                               
                                <td colspan="4" align="center" style="vertical-align:top" ><img src='@Url.Content("~/Images/twocolor-s.jpg")' width="500" /></td>

                            </tr>
                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;">ENTITY(BPS/TEIL)</td>
                                <td colspan="3">TCSL</td>

                            </tr>
                            <tr>
                                <td colspan="4"></td>

                            </tr>
                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;"> BGC Initiated Date(Date of receipt of case from TCS BPO)</td>
                                @if (@Model.OrderDate != null)
                                {
                                    <td colspan="3">@Model.OrderDate.Value.ToString("dd-MMM-yyyy")</td>
                                }
                                else
                                {
                                    <td colspan="3"></td>
                                }
                                @*<td colspan="3">28-Mar-2018</td>*@


                            </tr>
                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;"> Interim Status/ Report Shared date</td>
                              
                               @if (@Model.InterimReportDate != null)
        {
            <td colspan="3">@Model.InterimReportDate</td>
        }
        else
        {
            <td colspan="3"></td>
        }



                            </tr>

                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;"> Final Report Sent date</td>
                           
                                @if (@Model.ReportUploadedDate != null)
    {
                            <td >@Model.ReportUploadedDate</td>
}
else
{
                            <td ></td>
}



                            </tr>
                            <tr>
                                <td style="color-adjust:exact; background:#c0c0c0;"> Supplementary report sent date</td>
                                @if (@Model.Supplementaryreportsentdate != null)
                                {
                                <td>@Model.Supplementaryreportsentdate</td>
                                }
                                else
                                {
                                    <td colspan="3">NA</td>
                                }
                            </tr>
                            <tr style="font-size:15px;">
                                @if (@Model.ReportTypeBYSystum == "Final")
    {
                            <td colspan="4" align="center"> Report Type Supplementary  - BGC Charges-Final Report Charges Calculation Sheet</td>

}
                                @if (@Model.Report_Type != "1" && Model.ReportTypeBYSystum != "Final")
    {
                            <td colspan="4" align="center"> Report Type Final - BGC Charges-Final Report Charges Calculation Sheet</td>

}
                                @if(Model.Report_Type == "1")
                                {
                                <td colspan="4" align="center"> Report Type Interim - BGC Charges-Final Report Charges Calculation Sheet</td>

                                }


                            </tr>



                        </table>
                        <table width="100%" border="1" cellpadding="4" cellspacing="1" style="border:groove; border-color:gainsboro; margin-top:10px; border-spacing:4px; font-size:10px; font-weight:bold">
                            <tr style="background:#c0c0c0; text-decoration:underline;">
                                <td>Components to be checked</td>
                                <td>Charges</td>
                                <td>Type of Confirmation(verbal/written)</td>
                                <td>Check Status</td>
                                <td>Total Charges</td>
                            </tr>
                            @{
                                foreach (var item in Model.TCS_BPO_Cal_Sheet)
                                {
                                    
                            <tr>
                                <td style="font-size:10px; font-family:Calibri; color-adjust:exact;background:#c0c0c0; font-weight:bold;">@item.SubCheckName :</td>
                                <td style="font-size:10px; font-family:Calibri; ">@item.Charge</td>
                                <td style="font-size:10px; font-family:Calibri; ">@item.ModeOfVerification</td>
                                <td style="font-size:10px; font-family:Calibri; ">@item.CheckStatus</td>
                                <td style="font-size:10px; font-family:Calibri; ">@item.Charge</td>
                            </tr>
                                    
                                }
                            }
                            

                            <tr style="color-adjust:exact; background:#c0c0c0;">
                                <td colspan="4" align="right">Base Amount:</td>
                                <td>@Model.TCS_BaseAmount</td>


                            </tr>
                            <tr style="color-adjust:exact; background:#c0c0c0;">
                                <td colspan="4" align="right">Incentive Amount:</td>
                                <td>@Model.IncentiveAmount</td>


                            </tr>
                            <tr style="color-adjust:exact; background:#c0c0c0;">
                                <td colspan="4" align="right">Penalty Amount:</td>
                                <td>@Model.PenaltyAmount</td>


                            </tr>
                            <tr style="color-adjust:exact; background:#c0c0c0;">
                                <td colspan="4" align="right">Total Net amount payable On this BGC Report:</td>
                                <td>@Model.TCS_Total_Amount</td>


                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </page>
                               

