

@model ViewModels.ReportQCViewModel.ReportViewModel
@{

    if (Model.PersonalName != null)
    {

        <page id="PrintSrc" size="A4">
            @*<div style="page-break-after:always ;"></div>*@
            <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; height:74rem!important; width:100%;">
                <tr>
                    <td width="2%" align="left" valign="bottom"> &nbsp;</td>
                    <td valign="top">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td valign="top">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td>
                                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                    <tr>
                                                        <td width="88%" align="center" style="font-size:25px;"><u><b>SECURITAS INDIA</b> </u></td>
                                                        <td width="6%" valign="top"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem;margin: 10px 10px 0px 10px;"></td>
                                                    </tr>
                                                    <tr><td colspan="2">&nbsp;</td></tr>
                                                </table>
                                            </td>
                                        </tr>

                                        <tr>

                                            <td valign="top">&nbsp;</td>
                                        </tr>
                                        <tr>
                                            <td height="10">&nbsp;</td>
                                        </tr>
                                        @if (Model.currentAddressStatus)
                                        {


                                            <tr>
                                                <td style="font-size:17px; width:100%; height: 40px;font-family:Calibri;"><b>Court Verification [Current Address]</b></td>

                                            </tr>
                                            <tr>
                                                <td valign="top" align="center">
                                                    <table border="1" cellspacing="5" cellpadding="2" width="793">

                                                        <tr>
                                                            <td style="font-size:15px; width:33%;  font-family:Calibri;"><b>Current Address </b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.CurrentAddress </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%;  font-family:Calibri;"><b>Period of stay</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.Current_Periodofstay</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Status</b></td>
                                                            @if (Model.Current_Status.Contains("Clear"))
                                                            {
                                                                <td style="font-size:15px; width:66%;font-family:Calibri; color:lightgreen"><b>@Model.Current_Status</b></td>
                                                            }
                                                            else if (Model.Current_Status.Contains("Attention requeird"))
                                                            {
                                                                <td style="font-size:15px; width:66%;font-family:Calibri; color:orange"><b>@Model.Current_Status</b></td>
                                                            }
                                                            else
                                                            {
                                                                <td style="font-size:15px; width:66%;font-family:Calibri; color:red"><b>@Model.Current_Status</b></td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Mode of Verification</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.Current_ModeofVerification</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Date & Time</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; ">@Model.Current_DateandTime</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Additional Comments</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Html.Raw(Model.Current_Comments)</td>
                                                        </tr>

                                                    </table>
                                                </td>
                                            </tr>
                                        }

                                        @if (Model.PermanentAddressStatus)
                                        {
                                            <tr><td height="20">&nbsp;</td></tr>
                                            <tr><td style="font-size:17px; width:100%; height: 40px;font-family:Calibri;"><b>Court Verification [Permanent Address]</b></td></tr>
                                            <tr>
                                                <td>
                                                    <table border="1" cellspacing="5" cellpadding="2" width="793">

                                                        <tr>
                                                            <td style="font-size:15px; width:33%;  font-family:Calibri;"><b>Permanent Address </b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.PermanentAddress </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%;  font-family:Calibri;"><b>Period of stay</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.Permanent_Periodofstay</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Status</b></td>
                                                            @if (Model.Permanent_Status.Contains("Clear"))
                                                            {
                                                                <td style="font-size:15px; width:66%;font-family:Calibri; color:lightgreen"><b>@Model.Permanent_Status</b></td>
                                                            }
                                                            else if (Model.Permanent_Status.Contains("Attention requeird"))
                                                            {
                                                                <td style="font-size:15px; width:66%;font-family:Calibri; color:orange"><b>@Model.Permanent_Status</b></td>
                                                            }
                                                            else
                                                            {
                                                                <td style="font-size:15px; width:66%;font-family:Calibri; color:red"><b>@Model.Permanent_Status</b></td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Mode of Verification</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.Permanent_ModeofVerification</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Date & Time</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri; ">@Model.Permanent_DateandTime</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:15px; width:33%; font-family:Calibri;"><b>Additional Comments</b></td>
                                                            <td style="font-size:15px; width:66%;font-family:Calibri;">@Model.Permanent_Comments</td>
                                                        </tr>

                                                    </table>
                                                </td>
                                            </tr>
                                        }

                                        <tr><td valign="top">&nbsp;</td></tr>


                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td align="left" valign="top">&nbsp;</td>
                </tr>
                <!--- Report Footer with Address Include -->
                @Html.Partial("_ReportFooterAddress")
            </table>

        </page>
    }
}



