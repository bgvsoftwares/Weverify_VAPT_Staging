@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    var list = new List<ViewModels.ReportQCViewModel.PersonalInfo>();

    if (Model.ClientRowID == 1219)
    {
        list = Model.SpecialInfoModel.Where(x => x.SubcheckRowID == 416).GroupBy(x => x.SubcheckRowID)
                  .Select(g => g.First())
                  .ToList();
    }

}

<page id="PrintSrc" size="A4">

    <div style="page-break-after:always!important;"></div>
    <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;">
        <tr>
            <td valign="top" align="center" style="height:50rem;">
                <table cellpadding="2" cellspacing="5" id="tblDemo" width="98%" border="0">
                    <tr>
                        <td valign="top" style="width:100%; text-align:end;"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem; margin-top:10px; margin-right:10px;"></td>
                    </tr>
                </table>
                <table cellpadding="2" cellspacing="5" id="tblDemo" width="98%" border="0">
                    <tr>
                        <td style="width:100%;"><p style="font-size:20px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Background Verification Report – Executive Summary</p></td>
                    </tr>
                </table>
                <table border="1" cellpadding="2" cellspacing="5" id="tblDemoTiger" style="width:100%; border-collapse:collapse;">
                    @{
                        string checkName = string.Empty;
                        foreach (var item in Model.PersonalChecksBriefDetails)
                        {
                            if (checkName != item.CheckFName)
                            {
                                <tr>
                                    <td colspan="4" bgcolor="#c0c0c0" style="font-size:16px; font-family:Calibri; -webkit-print-color-adjust:exact; background:#c0c0c0; padding:5px; text-align:center;"> <strong> @item.CheckFName</strong></td>
                                </tr>
                                <tr>
                                    <td width="30%" style="font-size:16px; font-family:Calibri; -webkit-print-color-adjust:exact; background:#c0c0c0; padding-left:5px;"><strong>Type of Check</strong></td>
                                    <td width="50%" style="font-size:16px; font-family:Calibri; -webkit-print-color-adjust:exact; background:#c0c0c0; text-align:center;"><strong>Brief Details</strong></td>
                                    <td width="20%" style="font-size:16px; font-family:Calibri;-webkit-print-color-adjust:exact; background:#c0c0c0; text-align:center;"><strong>Status (Color)</strong></td>
                                </tr>
                                checkName = item.CheckFName;
                            }
                            <tr style="font-weight:bold; padding:5px;">
                                <td style="padding-left:5px; font-size:14px; font-family:Calibri;"><a> @item.SubCheckFName</a></td>
                                <td align="center" style="font-size:14px; font-family:Calibri;">@item.SubCheckDetail</td>
                                @if (@item.Status == "Not Applicable")
                                {
                                    <td style="color-adjust:exact; font-size:14px; font-family:Calibri; background:@item.ColorCode;" align="center">Not Applicable</td>
                                }
                                else
                                {
                                    <td style="color-adjust:exact; font-size:14px; font-family:Calibri; background:@item.ColorCode;" align="center">@item.ColorName</td>
                                }
                            </tr>

                        }

                        if (Model.ClientRowID == 576)
                        {
                            <tr>
                                <td height="30" colspan="3"><b>@Model.EmpNoteRemark </b></td>
                            </tr>
                            <tr>
                                <td height="30" colspan="3"><b>@Model.AddressNoteRemark </b></td>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align:center">
                                    <img width="80%" src="~/Images/Nagarrow_SixColor.png" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </td>
        </tr>


        <tr>
            <td>
                <hr style="border:0; border-top:3px solid #c0c0c0; margin:10px 0;" />
            </td>
        </tr>

        <tr>
            <td valign="bottom" height="120">
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td valign="top">&nbsp;</td>
                    </tr>

                    <tr style="background-image: url('@Url.Content("~/Images/Footer-image-confident.jpg")'); background-repeat: no-repeat; background-size: cover;" >
                        <td width="20%"><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                        <td width="1%">&nbsp;</td>
                        <td width="79%">


                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>

                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                        </td>
                    </tr>
                </table>
            </td>

        </tr>
    </table>
</page>


@if (Model != null && Model.SpecialInfoModel != null && Model.SpecialInfoModel.Count > 0)
