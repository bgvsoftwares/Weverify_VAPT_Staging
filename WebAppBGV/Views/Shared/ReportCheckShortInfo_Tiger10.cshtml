                                                                        System.Drawing.Image image = System.Drawing.Image.FromStream(fs);

                                                                        if (image.Height > 600)
                                                                        {
                                                                            <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" style="width: 100%;height:55rem;" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" style="width: 100%;height:55rem;" />
                                                                        }
                                                                    }
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" height="100">
                                            <table border="0" cellspacing="0" cellpadding="0" style="width:100%;" id="tblDemo2">
                                                <tr>
                                                    <td colspan="3" style="border-top:3px solid #c0c0c0;">&nbsp;</td>
                                                </tr>
                                                @if (Model.ClientRowID == 926 || Model.ClientRowID == 881 || Model.ClientRowID == 588 || Model.ClientRowID == 1509 || Model.ClientRowID == 1396 || Model.ClientRowID == 1460 || Model.ClientRowID == 1459 || Model.ClientRowID == 1507 || Model.ClientRowID == 1487 || Model.ClientRowID == 336 || Model.ClientRowID == 1381 || Model.ClientRowID == 1202 || Model.ClientRowID == 871 || Model.ClientRowID == 1480 || Model.ClientRowID == 1306 || Model.ClientRowID == 1391 || Model.ClientRowID == 1509 || Model.ClientRowID == 1396 || Model.ClientRowID == 1465 || Model.ClientRowID == 1565 || Model.ClientRowID == 754 || Model.ClientRowID == 1279 || Model.ClientRowID == 1572)
                                                {
                                                    <tr>
                                                        <td width="20%"><br><br><br><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                                                        <td width="1%">&nbsp;</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td width="20%"><br><br><br><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                                                        <td width="1%">&nbsp;</td>

                                                        <td width="79%">
                                                            <p style="font-size:16px; font-family: Calibri, sans-serif; color:#000080; font-weight:500; text-align:center; margin:0px 0px 0px 0px;"><img src="~/Images/StampSignatureUpdated.jpg" width="60" height="60"></p>
                                                            <p style="font-size:16px; font-family: Calibri, sans-serif; color:#000080; font-weight:700; text-align:center; margin:0px 0px 0px 0px;">SECURITAS INDIA</p>
                                                            <p style="font-size:16px;font-family: Calibri, sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp; &nbsp;Tel: + 91 124 4718888</p>
                                                            <p style="font-size:16px; font-family: Calibri, sans-serif; color:#3a00ff; text-align:center; margin:5px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a> <span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                                                        </td>

                                                    </tr>
                                                }
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </page>
                        }
                    }
                }
            }
            i++;
        }
    }

}

