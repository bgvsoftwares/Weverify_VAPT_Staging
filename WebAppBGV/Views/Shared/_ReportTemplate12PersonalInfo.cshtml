                                    @if (Model.InsuffRaisedDate != "")
                                    {
                                        <p>@Convert.ToDateTime(Model.InsuffRaisedDate).ToString("dd MMM yyyy")</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                                <td width="133" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Insuff Cleared Date</strong></p>
                                </td>
                                <td width="199" style="padding: 0 1%;">
                                    @if (Model.InsuffClearDate != "")
                                    {
                                        <p>@Convert.ToDateTime(Model.InsuffClearDate).ToString("dd MMMM yyyy")</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <td width="123" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Client</strong></p>
                                </td>
                                <td width="197" style="padding: 0 1%;">
                                    @if (Model.ClientName != null)
                                    {
                                        <p>@Model.ClientName</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                                <td width="133" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Date of Birth</strong></p>
                                </td>
                                <td width="199" style="padding: 0 1%;">

                                    @if (Model.DOB != null)
                                    {
                                        <p>@Model.DOB.ToString("dd MMMM yyyy")</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <td width="123" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Joining Date</strong></p>
                                </td>
                                <td width="197" style="padding: 0 1%;">
                                    @if (Model.DateOfJoin != null)
                                    {
                                        <p>@Model.DateOfJoin.Value.ToString("dd MMM yyyy")</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                                <td width="133" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Contact number of employee</strong></p>
                                </td>
                                <td width="199" style="padding: 0 1%;">
                                    @if (Model.MobileNo != null)
                                    {
                                        <p>@Model.MobileNo</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                            </tr>


                            <tr>
                                <td width="123" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Vendor Name ID</strong></p>
                                </td>
                                <td width="197" style="padding: 0 1%;">
                                    @if (Model.CompanyRefNo != null)
                                    {
                                        <p>@Model.CompanyRefNo</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                                <td width="133" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Client Reference Id</strong></p>
                                </td>
                                <td width="199" style="padding: 0 1%;">
                                    @if (Model.ClientRefID != null)
                                    {
                                        <p>@Model.ClientRefID</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <td width="123" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Grade of employee</strong></p>
                                </td>
                                <td width="197" style="padding: 0 1%;">
                                    @if (Model.SSNNo != null)
                                    {
                                        <p>@Model.SSNNo</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                                <td width="133" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Final Colour Code</strong></p>
                                </td>
                                <td width="199" style="padding: 0 1%; color:@Model.FinalColorCode;color-adjust:exact;">
                                    @if (Model.FinalColor != null)
                                    {
                                        <p>@Model.FinalColor.ToUpper()</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>


                            </tr>
                        </tbody>
                    </table>



