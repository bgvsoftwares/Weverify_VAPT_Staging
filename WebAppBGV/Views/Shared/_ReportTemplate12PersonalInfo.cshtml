<tr>
    <td valign="top">
        <div style="text-align: center; border:groove;background: #ccc; color-adjust:exact; height:30px">

            <strong><b>BACKGROUND VERIFICATION FINAL REPORT</b></strong>

        </div>
        <br />
        
                    <table width="793" @*border="0"*@ cellspacing="0" cellpadding="0" align="center" style="margin-top:5px">
