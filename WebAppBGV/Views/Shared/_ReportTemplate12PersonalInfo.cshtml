                            <tr>
                                <td width="123" style="background: #ccc;color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Name of Subject</strong></p>
                                </td>
                                <td colspan="3" width="197" style="padding: 0 1%;">
                                    <p>@Model.PersonalName</p>
                                </td>

                            </tr>
                            <tr>
                                <td width="123" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Date of Initiation</strong></p>
                                </td>
                                <td width="197" style="padding: 0 1%;">
                                    @if (Model.CreatedDate != null)
                                    {
                                        <p>@Model.CreatedDate.ToString("dd MMMM yyyy")</p>
                                    }
                                    else
                                    {
                                        <p></p>
                                    }

                                </td>
                                <td width="133" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>GENDER</strong></p>
                                </td>
                                <td width="199" style="padding: 0 1%;">
                                    <p>@Model.Gender</p>
                                </td>
                            </tr>
                            <tr>
                                <td width="123" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Interim Report Sent On</strong></p>
                                </td>
                                <td width="197" style="padding: 0 1%;" ">
                                    @if (Model.InterimReportDate != "")
                                    {
                                        <p>@Convert.ToDateTime(@Model.InterimReportDate).ToString("dd MMMM yyyy")</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }

                                </td>
                                <td width="133" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Final Report Sent On</strong></p>
                                </td>
                                <td width="199" style="padding: 0 1%;">
                                    @if (Model.FinalReportDate != "" && Model.FinalReportDate != "NA")
                                    {
                                        <p>@Convert.ToDateTime(@Model.FinalReportDate).ToString("dd MMMM yyyy")</p>
                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }


                                </td>
                            </tr>

                            <tr>
                                <td width="123" style="background: #ccc; color-adjust:exact;
    padding: 0 1%;">
                                    <p><strong>Insuff Raised Date</strong></p>
                                </td>
