<table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%;">
    <tr>
        <td valign="top" style="height:50rem;">
            <table cellpadding="2" cellspacing="5" id="tblDemo" style="width:100%;">
                <tr>
                    <td style="width: 100%;">
                        <img src="~/Content/images/SISCLOGO.png" alt="" style="width: 100%;">
                    </td>
                </tr>
                <tr>
                    <td style="width: 100%; height: 400px; text-align: center; padding: 0rem 3rem;">
                        <p style="font-size: 28px; font-weight: bold; font-family: Times New Roman;">AGENT VERIFICATION <br> REPORT</p>
                        <p style="font-size: 18px; font-weight: bold; font-family: Arial; ">
                            @Model.PersonalName (@Model.EmploymentId)
                            <br /> @Model.CompanyRefNo
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="width: 100%; height: 400px;   vertical-align: bottom;  padding: 0rem 3rem 0rem 7rem; ">
                        <strong style="color: #71a2e1; font-size: 16px;">Confidential Report</strong>
                        <p style="font-size: 16px;">The report is generated based on information provided by the people working closely with the candidate. We have tried to publish the report based on facts and figure collected through our sources.</p>
                    </td>
                </tr>
                <tr>
                    <td style="width: 100%; text-align: end;     padding: 2rem 3rem;"> <strong style="font-size: 18px;">Securitas</strong> </td>
                </tr>

            </table>
        </td>
    </tr>
</table>