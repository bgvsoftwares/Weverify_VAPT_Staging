@if (ViewBag.GetMailList != null && ViewBag.GetMailList.Count > 0)
{
    <table width="100%" id="displaydoc">
        <tr>
            <td>
                <div class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> AutoEmailer List :</div>
            </td>
        </tr>
        <tr>
            <td height="2"></td>
        </tr>
        <tr>
            <td valign="top">

                <table class="table">
                    <thead class="thead-inverse">
                        <tr>
                            <th class="top-head">Document Type</th>
                            <th class="top-head">File Name</th>
                            <th class="top-head">Upload From</th>
                            <th class="top-head">Remarks</th>
                            <th class="top-head">Upload Date</th>
                            <th class="top-head">PDF Upload</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.GetMailList)
                        {
                        <tr>
                            <td class="name">@item.DocumentType</td>
                            <td class="filename">
                                @*@item.FilePath + @item.FileName*@
                                <a href="@Url.Action("GetSubNotMatchMail", "Verification", new { ImageName = item.FileName })">@item.FileName</a>
                                <a href="@Url.Action("delete", "Home", new { personalRowId = @item.PersonalRowID, subCheckId = @item.SubCheckRowID,doctype=@item.DocumentType,fileName=@item.FileName,gtr=HttpContext.Current.Request.Url.ToString().ToLower()  })" onclick="return confirm('Are you sure you want to delete doc?')"><img id="btndelete" src='@Url.Content("~/Images/Delete-Icon-PNG-Graphic-Cave.png")' width="5%" height="5%" /></a>
                            </td>
                            <td class="name">@item.DocumentUploadFrom</td>
                            <td class="name">@item.Remarks</td>
                            <td class="name">@item.UploadDate</td>
                            <td class="name">
                                <a href="@Url.Action("GetConvertedPdfFromMsg", "Verification", new { ImageName = item.FileName, personalRowId = @item.PersonalRowID, subCheckId = @item.SubCheckRowID })">Upload PDF</a>
                            </td>
                        </tr>
                        }
                        <tr>
                            <td height="12" colspan="5"></td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
}
