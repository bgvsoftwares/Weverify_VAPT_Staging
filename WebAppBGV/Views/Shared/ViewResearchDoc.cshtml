<table width="100% ">
    <tr>
        <td class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> Document Details :</td>
    </tr>
   <tr>
       <td>@Html.Partial("_CaseDocumentList")</td>
   </tr>
    <tr>
        <td height="2"></td>
    </tr>
    <tr>
        <td valign="top">
          
                <table class="table">
                    <thead class="thead-inverse">
                        <tr>
                            <th class="top-head">Sub Check Name</th>
                            <th class="top-head">Doc Upload form</th>
                            <th class="top-head">Doc type</th>
                            <th class="top-head">File Name</th>
                            <th class="top-head">File Path</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(  ViewBag.UploadDocs!=null  )
                        {
                        foreach (var item in ViewBag.UploadDocs)
                        {
                            <tr>
                                <td class="name">@item.SubCheckName</td>
                                <td class="name">@item.DocumentUploadFrom</td>
                                <td class="name">@item.DocumentType</td>
                                <td class="name">@item.FileName</td>
                                @*<td class="filename"><a target="_blank" href='@Url.Content("~/Documents/CandidateDocuments/ProvidedDocuments/"+@item.FileName)'>@item.FileName</a></td>*@
                                <td>@Html.ActionLink("download", "downloadResearchDoc", "ProvidedInfo", new { FileName = item.FileName }, null)</td>

                            </tr>
                        }}

                    </tbody>
                </table>
          
        </td>
    </tr>
</table>
