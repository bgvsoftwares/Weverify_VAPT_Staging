<page id="PrintSrc" size="A4">
    <div style="page-break-after:always ;"></div>
    <table cellspacing="0" cellpadding="0" align="center" style="border: 3px solid #999999; margin-top: 5px; height: 72rem; width: 100%;">
        <tr>
            <td>
                <table border="0" cellspacing="0" cellpadding="0" style="width:100%;">
                    <tr>
                        <td valign="top" style="width:100%; text-align:end;"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem; margin-top:10px; margin-right:10px;"></td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="width:100%;"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Background Verification Report – Executive Summary</p></td>
        </tr>
        <tr>
            <td valign="top">&nbsp;</td>
        </tr>
        <tr>
            <td valign="top" align="center">
                <table border="1" cellpadding="2" cellspacing="5" id="tblDemo" style="width:98%; border-collapse:collapse;">
                    <tbody>

                        <tr>
                            <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; background:#c0c0c0; text-align: left;" width="20%">Verified Date</td>
                            <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; background:#c0c0c0; text-align: center;" width="20%">Particulars</td>
                            <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; background:#c0c0c0; text-align: center;" width="20%">Status(Color)</td>
                        </tr>
                        @foreach (var item in Model.PersonalChecksBriefDetails)
                        {
                            <tr>
                                @if (item.CheckFName.Equals("Criminal Record Verification", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">Criminal Verification through E-Court</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">@item.SubCheckDetail</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }

                                }

                                else if (item.CheckFName.Equals("Education Verification", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">Education Check</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">@item.SubCheckDetail</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }
                                }
                                else if (item.CheckFName.Equals("Employment Verification", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">Employment Check</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">@item.SubCheckDetail</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }
                                }
                                
                                else if (item.CheckFName.Equals("National Identity Check", StringComparison.OrdinalIgnoreCase) && item.SubCheckFName.Equals("ID Verification", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">ID Check</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">Pan Card</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }
                                }
                                else if (item.CheckFName.Equals("Special Checks", StringComparison.OrdinalIgnoreCase) && item.SubCheckFName.Equals("Directorship Check - DIN", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">@item.SubCheckFName</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">@item.SubCheckDetail</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }
                                }
                                else if (item.CheckFName.Equals("Special Checks", StringComparison.OrdinalIgnoreCase) && item.SubCheckFName.Equals("Indian Database Check", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">Database Check</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">@item.SubCheckDetail</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }
                                }
                                else if (item.CheckFName.Equals("Address Verification", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">Address Verification</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">@item.SubCheckDetail</td>
                                        <td style="-webkit-print-color-adjust: exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%; " align="center">@item.ColorName</td>
                                    }
                                }
                                else if (item.CheckFName.Equals("Special Checks", StringComparison.OrdinalIgnoreCase) && item.SubCheckFName.Equals("Gap Verification", StringComparison.OrdinalIgnoreCase)
                                    || item.SubCheckFName.Equals("Gap Verification 1", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">@item.SubCheckFName</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">-</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }
                                }
                                else
                                {
                                    if (@item.SubCheckDetail != "Not Applicable")
                                    {
                                        <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">@item.SubCheckFName</td>
                                        <td align="center" style="font-size: 12px; font-family: Calibri; width: 50%; text-align: left; max-width: 50%;">@item.SubCheckDetail</td>
                                        <td style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @item.ColorCode; width: 20%; max-width: 20%;" align="center">@item.ColorName</td>
                                    }
                                }
                            </tr>
                        }
                        <tr>
                            <td style="font-size: 14px; font-family: Calibri; padding-left: 5px; font-weight: bold; text-align: left;" width="30%">FINAL REPORT</td>

                            <td colspan="2" style="-webkit-print-color-adjust:exact; font-size: 12px; font-family: Calibri; background: @Model.FinalColorCode; width: 20%; max-width: 20%; text-align: left; text-align: left;" align="center">@Model.FinalColor</td>

                        </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="2" height="100">
                <table border="0" cellspacing="0" cellpadding="0" style="width:100%;" id="tblDemo2">
                    <tr>
                        <td colspan="3" style="border-top:3px solid #c0c0c0;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td valign="bottom" width="20%"><img src="~/Images/Walsons-Report-footer.png" style="width:7rem; margin-left: 15px; margin-bottom: 15px;"></td>
                        <td width="1%">&nbsp;</td>
                        <td width="79%">
                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>
                            <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                            <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin: 0px 0px 5px 0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</page>
