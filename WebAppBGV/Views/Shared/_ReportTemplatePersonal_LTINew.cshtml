
<table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; height:80rem;">
    <tr>
        <td valign="top">
            <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                <tr>
                    <td>
                        <table border="0" cellspacing="0" cellpadding="0" style="width:100%;">
                            <tr>
                                <td>
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td valign="top" width="80%"><p style="font-size:24px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p>
                                            <td valign="top" style="width:20%; text-align:end;"><img src='~/Content/Securitas_AB_logo.svg.png' style="width:5rem; margin-top:10px; padding: 10px;"></td>
                                        </tr>
                                        <tr>

                                            @if ((Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS") && (Model.Report_Type != "Final"))
                                            {
                                                <td colspan="3">
                                                    <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width:26%;font-weight: bolder; margin: 10px 0px 20px 183px; letter-spacing: 0.5px;font-size:16px; padding: 10px; font-family: 'Calibri',sans-serif;">REPORT TYPE INTERIM</p>
                                                </td>

                                            }
                                            else if (Model.Report_Type != "1")
                                            {
                                                <td colspan="3">
                                                    <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width:26%;font-weight: bolder; margin: 10px 0px 20px 183px; letter-spacing: 0.5px;font-size:16px; padding: 10px; font-family: 'Calibri',sans-serif;">REPORT TYPE FINAL</p>
                                                </td>
                                            }

                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table border="1" style="width:98%; margin: auto; border-collapse: collapse;">
                            <tr>
                                <td colspan="4" style="background: rgb(191, 191, 191); text-align: center; font-size: 16px; font-family:'Calibri', sans-serif; font-weight: bolder;">Background Screening Report</td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); width: 211px; padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Name of the Candidate</td>
                                <td colspan="3" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.PersonalName</td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Securitas Reference ID</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.CompanyRefNo</td>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Date Initiated</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">

                                    @if (Model.OrderDate != null)
                                    {<span>@Model.OrderDate.ToString("dd-MM-yyyy")</span> }
                                else
                                { <span>N/A</span>}

                                </td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Client Name</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.ClientName</td>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Date of Report</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                    @if (Model.ReportDate != null)
                                    {<span>@Model.ReportDate.ToString("dd-MM-yyyy")</span> }
                                else
                                { <span>N/A</span>}

                                </td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">P.S. Number</td>
                                @if (Model.CandidateCode != null && Model.CandidateCode != "")
                                {
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                        @Model.CandidateCode
                                    </td>
                                }
                                else
                                {
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                        Not Applicable
                                    </td>
                                }

                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Applicant ID</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.EmploymentId</td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Process Name</td>
                                @if (Model.ClientRowID == 990)
                                {
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                        <p>Not Applicable</p>
                                    </td>
                                }
                                else
                                {
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                        @if (string.IsNullOrEmpty(Model.ProcessName))
                                        {
                                            <p>Not Applicable</p>
                                        }
                                        else
                                        {
                                            <p>@Model.ProcessName</p>
                                        }


                                    </td>
                                }

                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Report Color Code</td>
                                @*<td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; background: orange;">Amber</td>*@
                                @if (Model.Report_Type != "1")
                                {
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; background:@Model.FinalColorCode;" align="center"><label for=""> @Model.FinalColor</label></td>
                                }
                                else
                                {
                                    if (@Model.FinalColor == "IR CEP")
                                    {
                                        <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; color-adjust:exact; " align="center"><label for=""> @Model.FinalColor</label></td>

                                    }
                                    else
                                    {
                                        <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; color-adjust:exact; background:@Model.FinalColorCode;" align="center"><label for=""> @Model.FinalColor</label></td>
                                    }
                                }
                            </tr>
                            @*<tr>
                                    <td style="background: rgb(191, 191, 191); width: 211px; padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;"></td>
                                    <td colspan="4" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;"></td>
                                </tr>*@
                        </table>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table style="width:100%;">
                            @if (Model.ClientRowID == 990 || Model.ClientRowID == 1744 || Model.ClientRowID == 1687)  //Tech Mahindra Limited(446)   INFOSYS	Infosys BPM Limited(944)
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center;"><img src="~/Content/images/LTI_Legend.jpg" style="width:40rem; margin-top:5rem;" /> </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center;"><img src="~/Content/images/Picture1.png" style="width:40rem; margin-top:5rem;" /> </td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td colspan="2" height="100">
            <table border="0" cellspacing="0" cellpadding="0" style="width:100%;" id="tblDemo2">
                <tr>
                    <td colspan="3" style="border-top:3px solid #c0c0c0;">&nbsp;</td>
                </tr>
                <tr>
                    <td valign="bottom" width="20%"><img src="~/Images/Walsons-Report-footer.png" style="width:7rem; margin-left: 15px; margin-bottom: 15px;"></td>
                    <td width="1%">&nbsp;</td>
                    <td width="79%">
                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>
                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin: 0px 0px 5px 0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!--- Report Footer with Address Include aa -->
</table>
