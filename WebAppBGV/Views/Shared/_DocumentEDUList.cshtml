
@if (ViewBag.GetEDUResearchDocumentList != null && ViewBag.GetEDUResearchDocumentList.Count > 0)
{
    <table width="100%" id="displaydoc">
        <tr>
            <td>
                <div class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i>EDU Research Document List :</div>
            </td>
        </tr>
        <tr>
            <td height="2"></td>
        </tr>
        <tr>
            <td valign="top">

                <table class="table">
                    <thead class="thead-inverse">
                        <tr>
                            <th class="top-head">Document Type</th>
                            <th class="top-head">Research Found(Y/N)</th>
                            <th class="top-head">File Name</th>
                            <th class="top-head">Upload From</th>
                            <th class="top-head">Upload Date</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in ViewBag.GetEDUResearchDocumentList)
                        {
                        <tr>
                            <td class="name">@item.DocumentType</td>
                            <td class="name" id="exist">@item.IsExist</td>
                            <td class="filename">
                                <a target="_blank" href='@Url.Content("~/Documents/MasterDocuments/College/" + @item.FileName)'>@item.FileName</a>

                                @*<a href="@Url.Action("delete", "Home", new { personalRowId = @item.PersonalRowID, subCheckId = @item.SubCheckRowID,doctype=@item.DocumentType,fileName=@item.FileName,gtr=HttpContext.Current.Request.Url.ToString().ToLower()  })" onclick="return confirm('Are you sure you want to delete doc?')"><img id="btndelete" src='@Url.Content("~/Images/Delete-Icon-PNG-Graphic-Cave.png")' style="width:50px; height:30px;" /></a>*@

                            </td>
                            <td class="name">@item.DocumentUploadFrom</td>
                            <td class="name">@item.UploadDate</td>
                        </tr>
                        }
                        <tr>
                            <td height="12" colspan="5"></td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
}
