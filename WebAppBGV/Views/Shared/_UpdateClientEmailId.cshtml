

<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />

<link href="~/Content/admin.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<table width="100% ">
    <tr>
        <td class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> Update Client Email ID :</td>
    </tr>
    <tr>
        <td height="2"></td>
    </tr>
    <tr>
        <td valign="top">
            <div class="row" style="margin-top:30px">
                <div class="container-fluid">
                    <input type="hidden" id="RowID" value="@ViewBag.ClientUserRowID" />
                    <div class="row">
                        <div class="col-3">Email ID</div>
                        <div class="col-12" style="margin-top:10px">
                            <input style="width:100%" class="form-text" type="text" value="@ViewBag.UpdateClientEmailId" id="Email_ID" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12" style="margin-top:20px">
                            <input class="btn bun-bg btn-default" type="button" id="btnUpdate" value="Update" />
                        </div>
                    </div>

                </div>
                @*@if ViewBag.UpdateClientEmailId != null*@

        </td>
    </tr>
</table>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script>

    $("#btnUpdate").click(function () {
    //alert("test")
        var id = $('#RowID').val();
        var email = $('#Email_ID').val();
        //console.log(email);
        if (id != "") {
            $.ajax({
                type: "GET",
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateEmailId", "ClientServicing")',
                data: { id: id, email: email },
                dataType: "json",
                beforeSend: function () { },
                success: function (data) {
                    if (data.result == true) {
                        alert("Record Update Successfully!!");                       
                    }
                    else {
                        alert('There is some error');
                    }
                }
            });
        }
    });
       

</script>