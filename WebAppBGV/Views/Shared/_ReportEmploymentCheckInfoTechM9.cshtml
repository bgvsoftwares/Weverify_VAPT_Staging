
@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    var list = Model.EmploymentInfoModel.GroupBy(x => x.SubcheckRowID)
                              .Select(g => g.First())
                              .ToList();

}


@if (Model != null && Model.EmploymentInfoModel != null && Model.EmploymentInfoModel.Count > 0)
{
    if (Model.EmploymentInfoModel != null)
    {
        int i = 0;
        foreach (var a in list)
        {
            var Anticident = Model.EmploymentInfoModel.Where(T => T.SubcheckRowID == a.SubcheckRowID);
            var Remarks = Model.TechMEmploymentRemarksList.Where(D => D.SubCheckRowID == a.SubcheckRowID);

            var ReportComment = a.ReportComment;
            <page id="PrintSrc" size="A4">
                <div style="page-break-after:always ;"></div>
                <table style="width:100%; border: 2px solid #DDDDDD; margin: auto; font-family:'Calibri', sans-serif; border-collapse: collapse;">
                    <tr>
                        <td>
                            <table style="width:100%;">
                                <tr>
                                    <td style="text-align:right">
                                        <img src="https://bgv.securitas-india.com/Images/Securitas-logo.png"
                                             style="width:70px; padding: .60rem;">
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top">
                            <table style="width:100%; border-collapse: collapse;">
                                <tr>
                                    <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 14px;"><a name="@a.SubcheckRowID">Employment Verification</a></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" style="height:60rem;">
                            <table style="width:95%; border-collapse: collapse; border:1px solid #000; margin: auto;" border="1">
                                <tr>
                                    <td colspan="2" style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width:50%;">Details as per Subject’s Application Form</td>
                                    <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC;">Verification Remarks</td>
                                </tr>


                                @if (a != null)
                                {
                                    foreach (var item in Anticident)
                                    {
                                        if (item.AntecedentRowID != "88")
                                        {
                                            if (item.AntecedentRowID == "91" || item.AntecedentRowID == "92" || item.AntecedentRowID == "97" || item.AntecedentRowID == "317" || item.AntecedentRowID == "87" || item.AntecedentRowID == "85" || item.AntecedentRowID == "95" || item.AntecedentRowID == "94")
                                            {
                                                <tr>
                                                    <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width: 25%;">@item.DisplayNameRep</td>
                                                    <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px; width: 25%;">@item.DataEntryValue</td>
                                                    <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;">@item.OpsValue</td>
                                                </tr>
                                            }
                                            else
                                            {

                                                if (item.AntecedentRowID == "398" || item.AntecedentRowID == "411")
                                                {
                                                    if (!string.IsNullOrEmpty(item.OpsValue))
                                                    {

                                                        <tr>
                                                            <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width: 25%;">@item.DisplayNameRep</td>

                                                            <td colspan="2" style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px; width: 25%;">
                                                                @try
                                                                {
                                                                    @Convert.ToDateTime(item.OpsValue).ToString("dd-MMM-yyyy")
                                                                }
                                                                catch
                                                                {
                                                                    @item.OpsValue
                                                                }



                                                            </td>



                                                        </tr>


                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width: 25%;">@item.DisplayNameRep</td>
                                                            <td colspan="2" style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px; width: 25%;">@item.OpsValue</td>
                                                        </tr>
                                                    }


                                                }
                                                else
                                                {
                                                    if (item.AntecedentRowID == "86")
                                                    {
                                                        <tr>
                                                            <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width: 25%;">@item.DisplayNameRep</td>
                                                            <td colspan="2" style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px; width: 25%;">Employment</td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width: 25%;">@item.DisplayNameRep</td>
                                                            <td colspan="2" style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px; width: 25%;">@item.OpsValue</td>
                                                        </tr>
                                                    }


                                                }

                                            }
                                        }



                                    }
                                }

                                <tr>
                                    <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width: 25%;">Remarks</td>
                                    <td colspan="2" style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px; width: 25%;"> @Html.Raw(a.ReportComment) </td>
                                </tr>
                                <tr>
                                    <td style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px;background: #CCC; width: 25%;">Annexure Details</td>

                                    <td colspan="2" style="text-align: center;font-family:'Calibri', sans-serif; font-size: 12px; width: 25%;"><a href="#P+@a.SubcheckRowID">Please refer Employment Annexure</a></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

            </page>

            if (Model.CandidateDocList != null)
            {
                int j = 0;
                foreach (var Doc in Model.CandidateDocList.Where(w => w.SubCheckRowID == a.SubcheckRowID))
                {
                    if (Doc.SubCheckRowID == a.SubcheckRowID)
                    {
                        FileInfo fin = new FileInfo(Server.MapPath(Model.DocPath + Doc.DocFile));
                        if (fin.Exists && (fin.Extension.ToLower().Contains(".jpg") || fin.Extension.ToLower().Contains(".jpeg") || fin.Extension.ToLower().Contains(".png")))
                        {
                            <page id="PrintSrc" size="A4">
                                <div style="page-break-after:always ;"></div>
                                <table width="793" cellspacing="0" height="1100" cellpadding="0" align="center" style="border:3px solid #999999; align-content:center">
                                    <!--- Report Header Include -->
                                    @*@Html.Partial("_ReportHeader")*@
                                    <!--- Report Header Include -->
                                    <tr>
                                        @*<td width="2%" align="left" valign="bottom" style="border-left:2px solid #999999;">&nbsp;</td>*@
                                        <td valign="top" colspan="2" align="center" valign="bottom">
                                            <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                                <tr>
                                                    <td valign="top">
                                                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                            <tr>
                                                                <td style="font-size:10px; font-family:Calibri;">
                                                                    <table style="width:100%;">
                                                                        <tr>
                                                                            @if (j == 0)
                                                                            {
                                                                                <td width="88%"><p style="font-size:16px;  color:#000000; text-align:center; font-weight:bold; text-decoration:underline; text-transform:none; margin:0px;"><a name="P+@a.SubcheckRowID"> </a></p></td>
                                                                                j++;

                                                                            }
                                                                        </tr>
                                                                        <tr>
                                                                            <td style="text-align:right">
                                                                                <img src="https://bgv.securitas-india.com/Images/Securitas-logo.png"
                                                                                     style="width:70px; padding: .60rem;">
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td valign="top">&nbsp;</td>
                                                            </tr>
                                                            <tr style="text-align:center">
                                                                <td valign="top">
                                                                    @{
                                                                        FileStream fs = new FileStream(Server.MapPath(Model.DocPath + Doc.DocFile), FileMode.Open, FileAccess.Read);
                                                                        System.Drawing.Image image = System.Drawing.Image.FromStream(fs);

                                                                        if (image.Height > 600)
                                                                        {
                                                                            <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" width="730" height="900" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" width="730" />
                                                                        }
                                                                    }
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>

                                    </tr>
                                    <!--- Report Footer with Address Include -->
                                    @*@Html.Partial("_ReportFooterAddress")*@

                                </table>
                            </page>
                        }
                    }
                }
            }

            i++;
        }
    }

}





