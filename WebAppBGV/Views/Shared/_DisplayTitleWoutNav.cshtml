<div class="row">
    <div class="col-md-12">

        @{
            string Department1 = Convert.ToString(Session["Department"]);
        }

        @if (Department1 == "Sales Department")
        {
            <div class="branch-office1" style="background: white;">
                <div class="col-md-12" style="text-align: center; color: black; background: white;"> @ViewBag.Title </div>
            </div>
         }
          else
          {
          <div class="branch-office">
              <div class="col-md-12" style="text-align:center;"> @ViewBag.Title </div>
          </div>
          }


            </div>
        </div>

<style>
    .branch-office1 {
        /* background: #009688 !important; */
        margin-bottom: 14px;
        font-weight: 600;
        color: #fff;
        text-align: left;
        height: 34px;
        margin-top: 1%;
        font-size: 22px;
    }
</style>
