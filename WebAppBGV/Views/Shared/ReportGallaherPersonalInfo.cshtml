
<table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; height:80rem;page-break-after:always!important;">
    <tr>
        <td valign="top">
            <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                <tr>
                    <td>
                        <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; margin-bottom: 9px;">
                            <tr>
                                <td>
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            @if ((Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS") && (Model.Report_Type != "Final"))
                                            {

                                                <td width="100%" style="display:grid;justify-content:center;">
                                                    <p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 15px 0px!important; font-weight:bold;">SECURITAS INDIA</p>
                                                    <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width:200px;font-weight: bolder;margin:auto;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE INTERIM</p>
                                                </td>


                                            }
                                            else
                                            {
                                                if (Model.Report_Type != "1" || Model.ReportPart == "CRC")
                                                {
                                                    <td width="100%" style="display:grid;justify-content:center;">
                                                        <p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 15px 0px!important; font-weight:bold;">SECURITAS INDIA</p>
                                                        <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width:200px;font-weight: bolder;margin:auto;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE FINAL</p>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td width="100%" style="display:grid;justify-content:center;">
                                                        <p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 15px 0px!important; font-weight:bold;">SECURITAS INDIA</p>
                                                        <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width:200px;font-weight: bolder;margin:auto;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE INTERIM</p>
                                                    </td>
                                                }

                                            }
                                            <td valign="top" style="width:20%; text-align:end;"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem; margin-top:10px;"></td>

                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table border="1" style="width:98%; margin: auto; border-collapse: collapse;">
                            <tr>
                                <td colspan="4" style="background: rgb(191, 191, 191); text-align: center; font-size: 16px; font-family:'Calibri', sans-serif; font-weight: bolder;">Background Screening Report</td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); width: 211px; padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Name of the Candidate</td>
                                <td colspan="4" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.PersonalName</td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); width: 211px; padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Securitas Reference ID</td>
                                <td colspan="4" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.CompanyRefNo</td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Client Name</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">@Model.ClientName</td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Initiation Date</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">

                                    @if (Model.OrderDate != null)
                                    {<span>@Model.OrderDate.ToString("dd-MM-yyyy")</span> }
                                else
                                { <span>N/A</span>}

                                </td>
                            </tr>
                            @{
                                bool showGallagherNewDates = true;
                                //try
                                //{
                                //    if (Model.ClientRowID == 1071)
                                //    {
                                //        object fmt = (object)Model.GallagherSep2026Format;
                                //        if (fmt != null && fmt != DBNull.Value)
                                //        {
                                //            showGallagherNewDates = Convert.ToBoolean(fmt);
                                //        }
                                //        else
                                //        {
                                //            object od = (object)Model.OrderDate;
                                //            if (od != null && od != DBNull.Value)
                                //            {
                                //                DateTime orderDt = Convert.ToDateTime(od);
                                //                showGallagherNewDates = orderDt >= new DateTime(2026, 9, 1);
                                //            }
                                //        }
                                //    }
                                //}
                                //catch (Exception)
                                //{
                                //    showGallagherNewDates = false;
                                //}
                            }

                            @if (showGallagherNewDates)
                            {
                                DateTime? interimDate = null;
                                DateTime? reinitiationDate = null;
                                DateTime? reinitiationReportDate = null;
                                bool reinitiationApplicable = true;

                                try
                                {
                                    object v1 = (object)Model.IntrimReportDate;
                                    if (v1 != null && v1 != DBNull.Value)
                                    {
                                        DateTime dt = Convert.ToDateTime(v1);
                                        if (dt.Year > 1900)
                                        {
                                            interimDate = dt;
                                        }
                                    }
                                }
                                catch (Exception)
                                {
                                    interimDate = null;
                                }

                                try
                                {
                                    object vApp = (object)Model.ReinitiationApplicable;
                                    if (vApp != null && vApp != DBNull.Value)
                                    {
                                        reinitiationApplicable = Convert.ToBoolean(vApp);
                                    }
                                }
                                catch (Exception)
                                {
                                    reinitiationApplicable = true;
                                }

                                try
                                {
                                    object v2 = (object)Model.ReverificationDate;
                                    if (v2 != null && v2 != DBNull.Value)
                                    {
                                        DateTime dt = Convert.ToDateTime(v2);
                                        if (dt.Year > 1900)
                                        {
                                            reinitiationDate = dt;
                                        }
                                    }
                                }
                                catch (Exception)
                                {
                                    reinitiationDate = null;
                                }

                                try
                                {
                                    object v3 = (object)Model.ReverificationCloseDate;
                                    if (v3 != null && v3 != DBNull.Value)
                                    {
                                        DateTime dt = Convert.ToDateTime(v3);
                                        if (dt.Year > 1900)
                                        {
                                            reinitiationReportDate = dt;
                                        }
                                    }
                                }
                                catch (Exception)
                                {
                                    reinitiationReportDate = null;
                                }

                                <tr>
                                    <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">First Interim Report</td>
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                        @if (!string.IsNullOrEmpty(Model.InterimReportDate) && Model.InterimReportDate != "NA")
                                        {
                                            <span>@Convert.ToDateTime(Model.InterimReportDate).ToString("dd-MM-yyyy")</span>
                                        }
                                        else
                                        {
                                            <span>NA</span>
                                        }

                                    </td>

                                </tr>
                                if (Model.Report_Type.ToLower() == "final")
                                {
                                    <tr>
                                        <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Second Interim Report</td>
                                        <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                            @if (!string.IsNullOrEmpty(Model.SecondSupplimentryDate) && Model.SecondSupplimentryDate != "NA")
                                            {
                                                <span>@Convert.ToDateTime(Model.SecondSupplimentryDate).ToString("dd-MM-yyyy")</span>
                                            }
                                            else
                                            {
                                                <span>NA</span>
                                            }

                                        </td>

                                    </tr>
                                }
                                <tr>
                                    <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Re-Initiation Date</td>
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                        @if (!string.IsNullOrEmpty(Model.ReverificationDate) && Model.ReverificationDate != "NA")
                                        {
                                            <span>@Convert.ToDateTime(Model.ReverificationDate).ToString("dd-MM-yyyy")</span>
                                        }
                                        else
                                        {
                                            <span>NA</span>
                                        }

                                    </td>

                                </tr>
                                <tr>
                                    <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Re-Initiation Report Date</td>
                                    <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                        @if (!string.IsNullOrEmpty(Model.ReverificationCloseDate) && Model.ReverificationCloseDate != "NA")
                                        {
                                            <span>@Convert.ToDateTime(Model.ReverificationCloseDate).ToString("dd-MM-yyyy")</span>
                                        }
                                        else
                                        {
                                            <span>NA</span>
                                        }

                                    </td>

                                </tr>
                                if (Model.Report_Type.ToLower() == "final")
                                {
                                    <tr>
                                        <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Final Report Date</td>
                                        <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                            @if (!string.IsNullOrEmpty(Model.FinalReportDate) && Model.FinalReportDate != "NA")
                                            {
                                                <span>@Convert.ToDateTime(Model.FinalReportDate).ToString("dd-MM-yyyy")</span>
                                            }
                                            else
                                            {
                                                <span>NA</span>
                                            }

                                        </td>

                                    </tr>
                                }
                                else if (Model.Report_Type.ToLower() == "interim")
                                {
                                    <tr>
                                        <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Second Interim Report</td>
                                        <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                            @if (!string.IsNullOrEmpty(Model.InterimReportDate) && Model.InterimReportDate != "NA")
                                            {
                                                <span>@DateTime.Now.ToString("dd-MM-yyyy")</span>
                                            }
                                            else
                                            {
                                                <span>NA</span>
                                            }

                                        </td>

                                    </tr>
                                }

                            }


                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Location</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">

                                    @*@Model.Can*@

                                    @Model.TechLocation
                                </td>
                            </tr>
                            <tr>
                                <td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Date of Birth</td>
                                <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                                    @if (Model.DOB != null)
                                    {
                                        <span>@Model.DOB.ToString("dd-MM-yyyy")</span>
                                    }
                                    else
                                    { <span>N/A</span>}

                                </td>
                            </tr>


                            <tr>
                                @*<td style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Package Name</td>

            <td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px;">
                <p>@Model.Location</p>
            </td>*@
                                <td colspan="1" style="background: rgb(191, 191, 191); padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; font-weight: bolder;">Report Color Code</td>
                                @*<td style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; background: orange;">Amber</td>*@
                                @if (Model.Report_Type != "1")
                                {
                                    <td colspan="3" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; background:@Model.FinalColorCode;" align="center"><label for=""> @Model.FinalColor</label></td>
                                }
                                else
                                {
                                    if (@Model.FinalColor == "IR CEP")
                                    {
                                        <td colspan="3" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; color-adjust:exact; " align="center"><label for=""> @Model.FinalColor</label></td>

                                    }
                                    else
                                    {
                                        <td colspan="3" style="padding: 3px; font-family:'Calibri', sans-serif; font-size: 16px; color-adjust:exact; background:@Model.FinalColorCode;" align="center"><label for=""> @Model.FinalColor</label></td>
                                    }
                                }
                            </tr>
                        </table>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
    <tr>
        <td colspan="2" height="100">
            <table border="0" cellspacing="0" cellpadding="0" style="width:100%;" id="tblDemo2">
                <tr>
                    <td colspan="3" style="border-top:3px solid #c0c0c0;">&nbsp;</td>
                </tr>
                <tr style="background-image: url('@Url.Content("~/Images/Footer-image-confident.jpg")'); background-repeat: no-repeat; background-size: cover;" >
                    <td valign="bottom" width="20%"><img src="~/Images/Walsons-Report-footer.png" style="width:7rem; margin-left: 15px; margin-bottom: 15px;"></td>
                    <td width="1%">&nbsp;</td>
                    <td width="79%">
                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:500; text-align:center; margin:10px 0px 0px 0px;"><img src='@Url.Content("~/Images/StampSignatureUpdated.jpg")' width="60" height="60"></p>
                        <p style="font-size:16px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#000080; font-weight:700; text-align:center; margin:15px 0px 0px 0px;">SECURITAS INDIA</p>
                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp;&nbsp; Tel: + 91 124 4718888</p>
                        <p style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin: 0px 0px 5px 0px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a>&nbsp;<span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!--- Report Footer with Address Include aa -->
</table>
