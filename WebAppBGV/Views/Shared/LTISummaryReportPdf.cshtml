@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    Layout = null;
}

@{

    if ((Model.ClientRowID == 990) && Model.Report_Type.ToLower() == "1" && Model.LTIUANReportDetaillist != null)
    {
        var list = Model.PersonalChecksBriefDetails.Where(T => T.subCheckId != 416).ToList();
        Model.PersonalChecksBriefDetails = list;
    }

}

<page id="PrintSrc" size="A4">
    <div style="page-break-after: always !important;"></div>
    <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; height:80rem;">
