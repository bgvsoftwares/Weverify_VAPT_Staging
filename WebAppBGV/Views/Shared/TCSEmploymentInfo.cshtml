
@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    if (HttpContext.Current.Items["PageNumber"] == null)
    {
        HttpContext.Current.Items["PageNumber"] = 1;
    }

    int pageNumber = (int)HttpContext.Current.Items["PageNumber"];

    var VerificationStatus = "";

    var mainList = Model.PersonalChecksBriefDetails.ToList();
    Model.PersonalChecksBriefDetails = mainList;

    if (Model.EmploymentType == "Experience Professional")
    {
        var currentEmployment = mainList.FirstOrDefault(x => x.CheckFamilyRowID == 12 && x.subCheckId == 68);

        VerificationStatus = currentEmployment.VerificationStatus;
    }
}

@Html.Partial("ReportEmploymentTCSYTR", Model)
@{
    pageNumber = (int)HttpContext.Current.Items["PageNumber"];
}



<page id="PrintSrc" size="A4">
    <div style="page-break-after:always ;"></div>
    <table border="0" cellspacing="0" cellpadding="0" align="center" style="height:60rem; width:100%;">
        <tbody>
            <tr>
                <td valign="top">
                    <table style="width: 100%; margin-top:20px;">
                        <tbody>
                            <tr>
                                <td style="text-align: end;padding: 5px;"><img src="~/Images/Walsons_logo.jpg" style="width: 150px;"></td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="margin:auto; width:100%;">
                        <tr>
                            <td>
                                <p style='margin-right: 0cm; margin-left: 0cm; font-size: 16px; font-family: Calibri; margin: 0cm; text-align: center;'><strong><span style='font-family:"Calibri",sans-serif;color:#948A54; text-decoration: underline;'>Disclaimer</span></strong></p>
                                <br>
                                <p style='margin-right: 5px; margin-left: 5px; font-size: 16px; font-family: Calibri; margin: 0cm; text-align: justify;'>
                                    <strong>
                                        <span style='font-size:14px;font-family:"Calibri";color:#948A54;'>
                                            Our reports and comments are confidential in nature and are meant only for the internal use of the client to make an assessment of the background of the applicant. They are not intended for publication or circulation to or sharing with any other person including the applicant nor are they to be reproduced or used for any other purpose, in whole or in part, without our prior written consent in each specific instance.
                                            We request you to recognize that we are not the source of the data gathered and our reports are based on the information made available to us; therefore, we cannot guarantee the accuracy of information collected. Should additional information or documentation become available to us, which impacts the facts mentioned in our report, we reserve the right to amend our report accordingly.
                                            .&nbsp;
                                        </span>
                                    </strong>
                                </p>
                                <br>
                                <br>
                                <p style='margin-right: 5px; margin-left: 5px; font-size: 14px; font-family: Calibri; margin: 0cm; text-align: justify;'><strong><span style='font-size:14px;font-family:"Calibri",sans-serif;color:#948A54;'>You will appreciate that due to factors beyond our control, it may be possible that we are unable to get all the necessary information. Because of the limitations mentioned above, the results of our work with respect to the background checks should be considered only as a guide. Our reports and comments should not be considered a definitive pronouncement on the individual. &nbsp;</span></strong></p>
                                <br>
                            </td>
                        </tr>
                    </table>

                </td>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="width: 47%; vertical-align: top;">
                <table style="width: 100%;">
                    <tr>
                        <td style="font-size: 14px; font-weight: bold; text-align: left;">
                            STAMP / SEAL OF BGC AGENCY
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: left;">
                            <img style="width: 30%;" src="~/Images/Stamp.png" alt="BGC Agency Stamp">
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size: 14px; font-weight: bold; text-align: left;">
                            Date: @DateTime.Now.ToString("dd MMMM yyyy")
                        </td>
                    </tr>
                </table>
            </td>

            <td style="width: 53%; vertical-align: top;">
                <table style="width: 100%;">
                    <tr>
                        <td style="font-size: 14px; font-weight: bold; padding-left: 120px">
                            NAME & SIGNATURE OF BRANCH MANAGER / <br />TEAM LEAD: Subhash Priyadarshi
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align:left;">
                            <img style="width: 30%; padding-left:197px;" src="~/Images/UpdatedSignature.png" alt="Branch Manager Signature">
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            @if (Model.ClientRowID == 268 || Model.ClientRowID == 3)
            {
                <td style="text-align: left; font-style: italic; font-size: 14px; padding: 5px;">TCS Confidential</td>
            }

            <td style="text-align: right; font-style: italic; font-size: 14px; padding: 5px;">Page No. @pageNumber -</td>
        </tr>
    </table>
</page>

