                            FileInfo fin = new FileInfo(Server.MapPath(Model.DocPath + Doc.DocFile));
                            if (fin.Exists && (fin.Extension.ToLower().Contains(".jpg") || fin.Extension.ToLower().Contains(".jpeg") || fin.Extension.ToLower().Contains(".png")))
                            {
                                <page id="PrintSrc" size="A4">
                                    <div style="page-break-after:always ;"></div>
                                    <table border="0" cellspacing="0" cellpadding="0" align="center" style="width:100%;">
                                        <tbody>
                                            <tr>
                                                <td valign="top">
                                                    <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                                        <tr>
                                                            <td style="text-align: end;padding: 5px;"><img src="~/Images/Walsons_logo.png" style="width: 150px;"></td>
                                                        </tr>
                                                    </table>
                                                    <h3 class="center" style="font-size:16px;  color:#000000; text-align:center; font-weight:bold; text-decoration:underline; text-transform:none;">@a.SubCheckName (@Doc.DocumentType)</h3>
                                                    <table width="793" cellspacing="0" height="700" cellpadding="0" align="center" style="border:3px solid #999999; align-content:center">
                                                        <tr style="text-align:center">
                                                            <td valign="top">
                                                                @{
                                                                    FileStream fs = new FileStream(Server.MapPath(Model.DocPath + Doc.DocFile), FileMode.Open, FileAccess.Read);
                                                                    System.Drawing.Image image = System.Drawing.Image.FromStream(fs);


                                                                    <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" width="770" height="730" />

                                                                }
                                                            </td>
                                                        </tr>
                                                    </table>

                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table style="width: 100%; margin-top: 80px; border-collapse: collapse;">
                                        <tr>
                                            <td style="width: 47%; vertical-align: top;">
                                                <table style="width: 100%;">
                                                    <tr>
                                                        <td style="font-size: 14px; font-weight: bold; text-align: left;">
                                                            STAMP / SEAL OF BGC AGENCY
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align: left;">
                                                            <img style="width: 30%;" src="~/Images/Stamp.png" alt="BGC Agency Stamp">
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="font-size: 14px; font-weight: bold; text-align: left;">
                                                            Date: @DateTime.Now.ToString("dd MMMM yyyy")
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>

                                            <td style="width: 53%; vertical-align: top;">
                                                <table style="width: 100%;">
                                                    <tr>
                                                        <td style="font-size: 14px; font-weight: bold; padding-left: 120px">
                                                            NAME & SIGNATURE OF BRANCH MANAGER / <br />TEAM LEAD: Subhash Priyadarshi
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align:left;">
                                                            <img style="width: 30%; padding-left: 197px;" src="~/Images/UpdatedSignature.png" alt="Branch Manager Signature">
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            @if (Model.ClientRowID == 268 || Model.ClientRowID == 3)
                                            {
                                                <td style="text-align: left; font-style: italic; font-size: 14px; padding: 5px;">TCS Confidential</td>
                                            }
                                            <td style="text-align: right; font-style: italic; font-size: 14px; padding: 5px;">Page No. @pageNumber -</td>
                                        </tr>
                                    </table>
                                    @{ pageNumber++;
                                        HttpContext.Current.Items["PageNumber"] = pageNumber; }
                                </page>
                            }
                        }
                    }
                }

                i++;

            }
        }
    }
}


