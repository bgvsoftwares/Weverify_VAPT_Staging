<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @*<title>BGV Candidate - @ViewBag.Title</title>*@
    <link href="~/Content/newcss/font-awesome.min.css" rel="stylesheet" />
    <link href='@Url.Content("~/Content/bootstrap.min.css")' rel="stylesheet" type="text/css" />
    <link href='@Url.Content("~/Content/bootstrap-theme.min.css")' rel="stylesheet" />
    <link href='@Url.Content("~/Content/Site.css")' rel="stylesheet" type="text/css" />
    <script src='@Url.Content("~/Scripts/modernizr-2.8.3.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery-3.7.1.min.js")'></script>
    <script src='@Url.Content("~/Scripts/DisableBackForwordBtn.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>  
    <script src="~/Scripts/Formvalidation.js"></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>

</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="header" style="padding:1% 0;">
                    @Html.Partial("_Header")                
                </div>
                <div class="master-middle">
                    <div class="row">
                        <div class="col-md-12">
                            <table width="100%" align="center">
                                <tr>                                   
                                    <td valign="top" class="right-frame">
                                        @RenderSection("DisplayTitle", required: false)
                                        @RenderSection("ClientTabs", required: false)
                                        @RenderSection("NavigationButton", required: false)
                                        @*@RenderSection("DisplayMandatory", required: false)*@
                                        @RenderSection("DisplayErrorMessage", required: false)
                                        @RenderBody()
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="footer">
                    @Html.Partial("_Footer")
                </div>
            </div>
        </div>
    </div>

    <script src='@Url.Content("~/Scripts/bootstrap.min.js")'></script>
    @RenderSection("Scripts", required: false)
</body>
</html>