                            || Model.ClientRowID == 1381 || Model.ClientRowID == 1202 || Model.ClientRowID == 871 || Model.ClientRowID == 1480 || Model.ClientRowID == 1306 || Model.ClientRowID == 1391 || Model.ClientRowID == 1509 || Model.ClientRowID == 1396
                            || Model.ClientRowID == 1465 || Model.ClientRowID == 1565 || Model.ClientRowID == 754 || Model.ClientRowID == 1279 || Model.ClientRowID == 1572 || Model.ClientRowID == 259)
                        {
                            <tr>
                                <td valign="top" style="width:100%; text-align:end;"><img src='@Url.Content("~/Content/images/walsons_Logo.png")' style="width:5rem; margin-top:10px; margin-right:10px;"></td>
                            </tr>

                        }
                        else
                        {
                            <tr>
                                <td valign="top" style="width:100%; text-align:end;"><img src='@Url.Content("~/Content/images/Securitas-logo.png")' style="width:5rem; margin-top:10px; margin-right:10px;"></td>
                            </tr>
                        }

                    </table>
                </td> 
            </tr>
            <tr>
                @if (Model.ClientRowID == 1671 || Model.ClientRowID == 1704)
                {
                    <td style="width:100%;"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Company Due Diligence Report</p></td>
                }
                else if (Model.ClientRowID == 279 || Model.ClientRowID == 1695 || Model.ClientRowID == 1708 || Model.ClientRowID == 1694 || Model.ClientRowID == 1696 || Model.ClientRowID == 1697 || Model.ClientRowID == 1740)
                {
                    <td style="width:100%;"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Due Diligence Report</p></td>
                }
                else
                {
                    <td style="width:100%;"><p style="font-size:19px;  color:#000080; text-align:center; font-weight:bold; text-decoration:underline; padding:10px 0px 10px 0px;">Background Verification Report – Executive Summary</p></td>
                }


            </tr>
