                                        {
                                            <td style="padding-left:5px; font-size:10px; font-family:Calibri;"><a> Sanction Checks ( USA, UK and European Countries)</a></td>
                                        }
                                        else
                                        {

                                            if (Model.ClientRowID == 1671 && item.subCheckId == 957)
                                            {
                                                <td style="padding-left:5px; font-size:10px; font-family:Calibri;"><a> @item.SubCheckFName</a></td>
                                            }

                                            else
                                            {                                               

                                                if (Model.ClientRowID == 1810)
                                                {
                                                    <td style="padding-left:5px;">
                                                        <a href="#@item.subCheckId" style="font-family:Calibri, sans-serif;font-size:12px;color:blue;text-decoration:underline;">
                                                            @item.SubCheckFName.TrimEnd(' ')
                                                        </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td style="padding-left:5px; font-size:10px; font-family:Calibri;">
                                                        <a>@item.SubCheckFName</a>
                                                    </td>
                                                }

                                            }

                                        }
                                        @if (Model.ClientRowID != 576)
                                        {
                                            if (Model.ClientRowID == 1006 && (item.CheckFName == "Address Verification" || item.CheckFName == "Criminal Record Verification" || item.CheckFName == "National Identity Check"))
