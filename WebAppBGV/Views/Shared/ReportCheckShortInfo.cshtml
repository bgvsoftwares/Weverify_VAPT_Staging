                                                <td align="center" style="font-size:10px; font-family:Calibri;">xxxxxxxxxxxxx</td>
                                            }
                                            else
                                            {
                                                <td align="center" style="font-size:10px; font-family:Calibri;">@item.SubCheckDetail</td>
                                            }
                                        }


                                        @if (Model.ClientRowID == 858 || Model.ClientRowID == 1069)
                                        {
                                            if (item.CheckCompleteDate != null)
                                            {
                                                <td align="center" style="font-size:10px; font-family:Calibri;">@item.CheckCompleteDate.ToString("dd-MM-yyyy")</td>
                                            }
                                            else
                                            {
                                                <td align="center" style="font-size:10px; font-family:Calibri;"></td>
                                            }
                                        }
