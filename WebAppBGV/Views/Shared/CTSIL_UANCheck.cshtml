@if (Model.CandidateDocList != null)
{
    foreach (var Doc in Model.CandidateDocList.Where(w => w.SubCheckRowID == list[0].SubcheckRowID))
    {
        if (Doc.SubCheckRowID == list[0].SubcheckRowID)
        {
            FileInfo fin = new FileInfo(Server.MapPath(Model.DocPath + Doc.DocFile));
            if (fin.Exists && (fin.Extension.ToLower().Contains(".jpg") ||
            fin.Extension.ToLower().Contains(".jpeg") || fin.Extension.ToLower().Contains(".png")))
            {
                <page id="PrintSrc" size="A4">
                    <div style="page-break-after:always ;"></div>
                    <table width="793" height="800" cellspacing="0" cellpadding="0" align="center"
                           style="border:3px solid #999999; align-content:center">
                        <!--- Report Header Include -->
                        @*@Html.Partial("_ReportHeader")*@
                        <!--- Report Header Include -->
                        <tr>
                            @*<td width="2%" align="left" valign="bottom"
                                style="border-left:2px solid #999999;">&nbsp;</td>*@
                            <td valign="top" colspan="2" align="center" valign="bottom">
                                <p style="text-align:center;font-family:Arial; font-size:33px;">
                                    <strong>
                                        Walsons
                                        Services
                                    </strong>
                                </p>
                               
                                <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td valign="top">
                                            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                <tr>
                                                    <td style="font-size:10px; font-family:Calibri;">
                                                        <table width="100%" border="0" cellspacing="0"
                                                               cellpadding="0">
                                                            <tr>
                                                                <td width="88%"></td>
                                                                @*<td width="6%" valign="top"><img
                                                                    src='@Url.Content("~/Images/logo.jpg")'
                                                                    width="71" height="40"></td>*@
                                                            </tr>
                                                            <tr>
                                                                <td colspan="2">&nbsp;</td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td valign="top">&nbsp;</td>
                                                </tr>
                                                <tr style="text-align:center">
                                                    <td valign="top">
                                                        @{
                                                            FileStream fs = new
                                                            FileStream(Server.MapPath(Model.DocPath + Doc.DocFile),
                                                            FileMode.Open, FileAccess.Read);
                                                            System.Drawing.Image image =
                                                            System.Drawing.Image.FromStream(fs);

                                                            if (image.Height > 600)
                                                            {
                                                                <img src="@Url.Content(Model.DocPath + Doc.DocFile)"
                                                                     alt="@Doc.DocumentType" width="730" height="550" />
                                                            }
                                                            else
                                                            {
                                                                <img src="@Url.Content(Model.DocPath + Doc.DocFile)"
                                                                     alt="@Doc.DocumentType" width="730" />
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            @*<td style="border-right:2px solid #999999;" align="left" valign="top">&nbsp;</td>
                            *@
                        </tr>
                        <!--- Report Footer with Address Include -->
                        @Html.Partial("_ReportFooterAddress")
                        <!--- Report Footer with Address Include -->
                        <!--- Report Footer Include -->
                        @*@Html.Partial("_ReportFooter")*@
                        <!--- Report Footer Include -->
                    </table>
                </page>
            }
        }
    }
}



