
@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    bool isAddressSwapped = false;
    bool isCriminalSwapped = false;

    if (Model.ClientRowID == 268 && Model.PersonalChecksBriefDetails != null)
    {
        var mainList = Model.PersonalChecksBriefDetails.ToList();

        var currentAddress = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 2 && x.subCheckId == 2);

        var permanentAddress = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 2 && x.subCheckId == 13);

        var currentCriminal = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 5 && x.subCheckId == 24);

        var permanentCriminal = mainList
            .FirstOrDefault(x => x.CheckFamilyRowID == 5 && x.subCheckId == 28);

        if (currentAddress != null && currentAddress.VerificationStatus != null &&
            currentAddress.VerificationStatus.ToLower() == "same as permanent")
        {
            int i = mainList.IndexOf(currentAddress);
            int j = mainList.IndexOf(permanentAddress);

            var temp = mainList[i];
            mainList[i] = mainList[j];
            mainList[j] = temp;

            isAddressSwapped = true;
        }

        if (currentCriminal != null && currentCriminal.VerificationStatus != null &&
            currentCriminal.VerificationStatus.ToLower() == "same as permanent")
        {
            int i = mainList.IndexOf(currentCriminal);
            int j = mainList.IndexOf(permanentCriminal);

            var temp = mainList[i];
            mainList[i] = mainList[j];
            mainList[j] = temp;

            isCriminalSwapped = true;
        }

        Model.PersonalChecksBriefDetails = mainList;
    }

    var addressList = Model.AddressInfoModel.Where(T => T.SubcheckRowID != 195).GroupBy(x => x.SubcheckRowID)
                      .Select(g => g.First())
                      .ToList();

    if (isAddressSwapped && Model.AddressInfoModel != null)
    {
        addressList = Model.AddressInfoModel
            .Where(x => x.SubcheckRowID != 195 &&
                       (x.SubcheckRowID == 2 || x.SubcheckRowID == 13))
            .GroupBy(x => x.SubcheckRowID)
            .Select(g => g.First())
            .ToList();

        if (addressList.Count == 2)
        {
            var current = addressList.FirstOrDefault(x => x.SubcheckRowID == 2);
            var permanent = addressList.FirstOrDefault(x => x.SubcheckRowID == 13);

            if (current != null && permanent != null)
            {
                int i = addressList.IndexOf(current);
                int j = addressList.IndexOf(permanent);

                var temp = addressList[i];
                addressList[i] = addressList[j];
                addressList[j] = temp;
            }
        }
    }

    var criminalList = Model.CriminalInfoModel.Where(T => T.SubcheckRowID != 195).GroupBy(x => x.SubcheckRowID)
        .Select(g => g.First()).ToList();

    if (isCriminalSwapped && Model.CriminalInfoModel != null)
    {
        criminalList = Model.CriminalInfoModel
    .Where(x => x.SubcheckRowID != 195 &&
               (x.SubcheckRowID == 24 || x.SubcheckRowID == 28))
    .GroupBy(x => x.SubcheckRowID)
    .Select(g => g.First())
    .ToList();

        if (criminalList.Count == 2)
        {
            var current = criminalList.FirstOrDefault(x => x.SubcheckRowID == 24);
            var permanent = criminalList.FirstOrDefault(x => x.SubcheckRowID == 28);

            if (current != null && permanent != null)
            {
                int i = criminalList.IndexOf(current);
                int j = criminalList.IndexOf(permanent);

                var temp = criminalList[i];
                criminalList[i] = criminalList[j];
                criminalList[j] = temp;
            }
        }
    }

    var educationList = Model.EducationInfoModel.Where(T => T.SubcheckRowID != 195).GroupBy(x => x.SubcheckRowID)
                          .Select(g => g.First())
                          .ToList();


    var list = Model.EmploymentInfoModel.Where(T => T.SubcheckRowID != 195).GroupBy(x => x.SubcheckRowID)
                          .Select(g => g.First())
                          .ToList();

    list = list.Where(x => x.Status == 1).ToList();

    var Nationallist = Model.NationalInfoModel.GroupBy(x => x.SubcheckRowID)
                          .Select(g => g.First())
                          .ToList();

    var Referencelist = Model.ReferenceInfoModel.GroupBy(x => x.SubcheckRowID)
                          .Select(g => g.First())
                          .ToList();

    var Speciallist = Model.SpecialInfoModel.Where(T => T.SubcheckRowID != 888).GroupBy(x => x.SubcheckRowID)
                          .Select(g => g.First())
                          .ToList();

    Speciallist = Speciallist.Where(x => x.SubcheckRowID != 908).ToList();
    Speciallist = Speciallist.Where(x => x.SubcheckRowID != 416).ToList();

    var databasecheck = Model.SpecialInfoModel.Where(T => T.SubcheckRowID == 888).GroupBy(x => x.SubcheckRowID)
              .Select(g => g.First())
              .ToList();

    var databasecheckdoclist = Model.CandidateDocList.Where(T => T.SubCheckRowID == 888).ToList().Take(1);

    var pageNumber = 1;

}

