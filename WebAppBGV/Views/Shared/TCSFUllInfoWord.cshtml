                                                    <th style=" text-align: center; padding-left: 20px; padding-right: 20px; background: #cccccc;">Results</th>
                                                </tr>
                                                <tr>
                                                    <th style="padding-left: .80rem;  background: #DADADA;  -webkit-print-color-adjust: exact; text-align: left;">High Court Records Check</th>
