<tr>
    <td valign="top">
        <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">            
            <tr>
                <td width="94%" style="padding-top: 4%;"><p style="font-size:32px; color:black; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;"></p> </td>
                @*<td width="6%" align="right"><img src='@Url.Content("~/Images/logo.jpg")' width="71" height="40"></td>*@
                <td  align="right"><img src='@Url.Content("~/Images/logo.jpg")' height="40" width="71" height="auto"></td>
            </tr>
            <tr>
                <td colspan="2">
                    <table width="110%" border="0" cellpadding="2" cellspacing="5" style="margin-top:40px;border-collapse:collapse;">
                        <tr>
                            <td height="20" colspan="4" align="center";   style="font-size:29.5px;font-family:Calibri; color-adjust:exact; font-weight:bold"><strong>Background Verification Report</strong></td>
                        </tr>
                        <tr>
                            @if (Session["Designation"].ToString() == "Manager-CS" || Session["Designation"].ToString() == "Team Leader-CS" || Session["Designation"].ToString() == "Team Member-CS")
                            {
                                @*<td width="94%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE INTERIM</p></td>*@
                                <td height="20" colspan="4" align="center" style="font-size:17px;font-family:Calibri; font-weight:bold; color-adjust:exact; "><strong>(Interim)</strong></td>


                            }
                            else
                            {
                                if (Model.Report_Type != "1")
                                {
                                    @*<td width="94%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE FINAL</p></td>*@
                                    <td height="20" colspan="4" align="center" style="font-size:17px;font-family:Calibri; color-adjust:exact; "><strong>(Final)</strong></td>

                                }
                                else
                                {
                                    @*<td width="94%"><p style="font-size:32px; color:#777777; text-decoration:underline; text-align:center; margin:0px 0px 0px 0px; font-weight:bold;">SECURITAS INDIA</p> <p style="text-align: center;border: 2px solid #808080;box-shadow: 0px 1px 2px 1px #c0c0c0;color: #808080;text-transform: uppercase;padding: 5px;width: 35%;font-weight: bolder;margin: 25px 0px 20px 183px;letter-spacing: 0.5px;font-size:14px;">REPORT TYPE INTERIM</p></td>*@
                                    <td height="20" colspan="4" align="center" style="font-size:17px;font-family:Calibri; color-adjust:exact; "><strong>(Final)</strong></td>

                                }
                            }
                        </tr>
                        <tr>
                            <td colspan="3" align="left" style="margin-top:1em;  font-size:20px; font-weight:bold;  font-family:Calibri; "><strong>Section 1:  Case Details</strong></td>

                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                 
                <td colspan="2" >
                    <table width="100%" border="1" cellpadding="2" cellspacing="5" style="margin-top:5px;border-collapse:collapse;font-family:Calibri;font-size:16px">

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;" width="50%">Candidate Name/Employee Name as per iverify</td>
                            <td width="50%" style="font-family:Calibri; padding-left:5px;" colspan="2"><label for="">@Model.PersonalName</label></td>
                        </tr>
                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;" width="50%">Client Name</td>
                            <td width="50%" style=" font-family:Calibri; padding-left:5px;" colspan="2"><label for="">@Model.SSNNo</label></td>
                        </tr>

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;" width="50%">Country</td>
                            <td width="50%" style=" font-family:Calibri; padding-left:5px;" colspan="2"><label for="">India</label></td>
                        </tr>

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">Account Name</td>
                            <td style=" font-family:Calibri; padding-left:5px;" colspan="2"><label for="">@Model.ClientRefID </label></td>
                        </tr>

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">BGV Pattern Name</td>
                            <td style=" font-family:Calibri; padding-left:5px;" colspan="2"><label for="">@Model.ProcessName </label></td>
                        </tr>

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">BGV Assigned Date</td>
                            <td style=" font-family:Calibri; padding-left:5px;" colspan="2"><label for="">@Model.CreatedDate.ToString("dd-MMM-yyyy") </label></td>
                        </tr>

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">BGV Report Date</td>
                            <td style=" font-family:Calibri; padding-left:5px;" colspan="2">
                                <label for="">
                                    <label for="">
                                        @if (Model.ReportDate != null)
                                        {<span>@Model.ReportDate.ToString("dd-MMM-yyyy")</span> }
                                    else
                                    { <span>N/A</span>}
                                    </label>
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">Vendor Reference ID</td>
                            <td style=" font-family:Calibri; padding-left:5px;" colspan="2"><label for="">@Model.CompanyRefNo</label></td>
                        </tr>

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">Wipro Reference ID</td>
                            <td style=" font-family:Calibri; padding-left:5px;" colspan="2"><label for="">@Model.EmploymentId </label></td>
                        </tr>

                        @*<tr>
            <td style=" font-family:Calibri; padding-left:5px;">Color Code</td>
            <td style=" font-family:Calibri; padding-left:5px;"  colspan="2"><label style="color:@Model.FinalColorCode; color-adjust:exact;" for="">@Model.FinalColor.ToUpper()</label></td>
        </tr>*@

                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">BGV1 Color Code</td>
                            @if(Model.BGV1ColorCode!="")
                            {
                            <td style=" font-family:Calibri; padding-left:5px;color:@Model.BGV1ColorCode; color-adjust:exact;" colspan="2"><label for="">@Model.BGV1ColorName.ToUpper() </label></td>
                            }
                            else
                            {
                            <td style=" font-family:Calibri; " colspan="2"><label for="">NA </label></td>

                            }
                        </tr>


                        <tr>
                            <td style=" font-family:Calibri; padding-left:5px;">BGV2 Color Code</td>
                            @if(Model.BGV2ColorCode!="")
                            {
                            <td style=" font-family:Calibri; padding-left:5px;color:@Model.BGV2ColorCode; color-adjust:exact;" colspan="2"><label for="">@Model.BGV2ColorName.ToUpper() </label></td>
                            }
                            else
                            {
                            <td style=" font-family:Calibri; " colspan="2"><label for="">NA </label></td>

                            }

                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </td>
</tr>
<tr>
    <td valign="top">
        <table style="margin-top: 1em;border-collapse:collapse; margin:auto;font-family:Calibri;font-size:16px" width="95%" border="1" cellspacing="0" cellpadding="0">
            <tr>
                <td width="30%" style="color-adjust:exact;  background-color:red" align="center">RED</td>
                <td width="35%" style="color-adjust:exact;" align="center">DRAFT</td>
                <td width="30%" style="color-adjust:exact; background-color:green" align="center">GREEN</td>
            </tr>
            <tr>
                <td height="30px" valign="top" align="center">Fail</td>
                <td align="center" valign="top">Discrepancy/Unable to Verify/Additional Information Required</td>
                <td align="center" valign="top">Clear</td>
            </tr>
        </table>

        @*<p>&nbsp;</p>*@
        @*<table width="100%" border="1" cellpadding="2" cellspacing="5">
            <tbody>
                <tr>
                    <td style="text-align:center; padding-left:60px;">
                        <img src='@Url.Content("~/Images/Wipro_Legents.JPG")' width="650" />
                    </td>
                </tr>
            </tbody>
        </table>*@
    </td>
</tr>
<tr>
    <td>&nbsp;</td>
</tr>


