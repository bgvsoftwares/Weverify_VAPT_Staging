
@model ViewModels.ReportQCViewModel.ReportViewModel
@{
    /**/

    /**/

    var list = Model.EducationInfoModel.Where(T => T.SubcheckRowID == 282).GroupBy(x => x.SubcheckRowID)
                              .Select(g => g.First())
                              .ToList();


}


@if (Model != null && Model.EducationInfoModel != null && Model.EducationInfoModel.Count > 0)
{
    if (Model.EducationInfoModel != null)
    {
        int i = 0;
        int j = 0;
        double annuxureno = Convert.ToDouble(Session["AnnexureNo"]);
        int k = Convert.ToInt32(annuxureno);
        foreach (var a in list)
        {
            var Anticident = Model.EducationInfoModel.Where(T => T.SubcheckRowID == a.SubcheckRowID);

            var ReportComment = a.ReportComment;
            if (j == 0)
            {
                annuxureno = k + 1;
            }
            else
            {
                annuxureno = annuxureno + .1;
            }
            j = 2;
            Session["AnnexureNo"] = annuxureno.ToString();

            <page id="PrintSrc" size="A4">
                <div style="page-break-after:always ;"></div>
                <<table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; border-collapse:collapse;">
                    <tr>
                        <td valign="top" align="center" style="height:60rem;">
                            <table border="0" cellpadding="2" cellspacing="5" id="tblDemo" style="border-collapse: collapse; font-family: Calibri;  width: 95%; margin: auto;">
                                <tbody>
                                    <tr>
                                        <td style="border: none!important;-webkit-print-color-adjust: exact;" colspan="4" align="right" height="20"><img src='@Url.Content("~/Images/Securitas-logo.jpg")' width="70" height="40"></td>
                                    </tr>
                                    <tr>
                                        <td style="margin-top: 1em; font-size: 12pt!important; font-weight: bolder; font-family:'Calibri',sans-serif;" colspan="3" align="left">Section  @annuxureno :  Professional License Credential Check</td>

                                    </tr>
                                    <tr>
                                        <td>
                                            &nbsp;
                                        </td>
                                    </tr>

                                    @foreach (var item in Anticident)
                                    {

                                        if (item.AntecedentRowID == "68" || item.AntecedentRowID == "235" || item.AntecedentRowID == "79")
                                        {

                                            <tr>
                                                <td style="padding-left: 5px; width: 26%; border: 1px solid #000000; font-family:Calibri,sans-serif; font-size:10pt;">@item.DisplayNameRep </td>
                                                <td style="padding-left: 5px; width: 20%; border: 1px solid #000000; font-family:Calibri,sans-serif; font-size:10pt;">@item.OpsValue </td>

                                                @if (item.OpsValue != null && (item.OpsValue.Trim().ToUpper() == "NA" || item.OpsValue.Trim().ToUpper() == "NOT APPLICABLE"))
                                                {
                                                    <td style="padding-left: 5px; width: 15%; border: 1px solid rgb(0, 0, 0); font-family:Calibri,sans-serif; font-size:10pt;">Not Verified</td>

                                                }
                                                else if (item.OpsValue != null && (item.OpsValue.ToUpper() != "NA" || item.OpsValue.Trim().ToUpper() != "NOT APPLICABLE"))
                                                {
                                                    <td style="padding-left: 5px; width: 15%; border: 1px solid rgb(0, 0, 0); font-family:Calibri,sans-serif; font-size:10pt;">Verified</td>


                                                }
                                                else
                                                {
                                                    <td width="25%"></td>
                                                }



                                                @if (item.comment == "")
                                                {

                                                    <td style="padding-left: 5px; width: 12%; border: 1px solid rgb(0, 0, 0);font-family:Calibri,sans-serif; font-size:10pt;">NA</td>
                                                }
                                                else
                                                {
                                                    <td style="padding-left: 5px; width: 35%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">@item.comment</td>

                                                }
                                            </tr>
                                        }
                                        else if (item.AntecedentRowID == "235")
                                        {

                                            <tr>
                                                <td style="padding-left: 5px; width: 26%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">@item.DisplayNameRep</td>
                                                <td style="padding-left: 5px; width: 20%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">@item.OpsValue</td>

                                                @if (item.comment.ToLower() == "")
                                                {
                                                    <td style="padding-left: 5px; width: 15%; border: 1px solid rgb(0, 0, 0);font-family:Calibri,sans-serif; font-size:10pt;"> Verified</td>

                                                }
                                                else if (item.comment.ToLower() == "na")
                                                {
                                                    <td style="padding-left: 5px; width: 15%; border: 1px solid rgb(0, 0, 0);font-family:Calibri,sans-serif; font-size:10pt;">Not Verified</td>


                                                }
                                                else
                                                {
                                                    <td width="25%" style="font-family:Calibri,sans-serif; font-size:10pt;"></td>
                                                }



                                                @if (item.comment == "")
                                                {

                                                    <td style="padding-left: 5px; width: 12%; border: 1px solid rgb(0, 0, 0); font-family:Calibri,sans-serif; font-size:10pt;">NA</td>
                                                }
                                                else
                                                {
                                                    <td style="padding-left: 5px; width: 35%; border: 1px solid #000000; font-family:Calibri,sans-serif; font-size:10pt;">@item.comment</td>

                                                }
                                            </tr>
                                        }

                                        else if (item.AntecedentRowID == "72")
                                        {

                                            <tr>
                                                <td style="padding-left: 5px; width: 26%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">@item.DisplayNameRep</td>
                                                <td style="padding-left: 5px; width: 20%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">@item.DataEntryValue</td>

                                                @if (item.OpsValue != null && (item.OpsValue.Trim().ToUpper() == "NA" || item.OpsValue.Trim().ToUpper() == "NOT APPLICABLE"))
                                                {
                                                    <td style="padding-left: 5px; width: 15%; border: 1px solid rgb(0, 0, 0);font-family:Calibri,sans-serif; font-size:10pt;">Not Verified</td>

                                                }
                                                else if (item.OpsValue != null && (item.OpsValue.ToUpper() != "NA" || item.OpsValue.Trim().ToUpper() != "NOT APPLICABLE"))
                                                {
                                                    <td style="padding-left: 5px; width: 15%; border: 1px solid rgb(0, 0, 0);font-family:Calibri,sans-serif; font-size:10pt;">Verified</td>


                                                }
                                                else
                                                {
                                                    <td width="25%" style="font-family:Calibri,sans-serif; font-size:10pt;"></td>
                                                }



                                                @if (item.comment == "")
                                                {

                                                    <td style="padding-left: 5px; width: 12%; border: 1px solid rgb(0, 0, 0);font-family:Calibri,sans-serif; font-size:10pt;">NA</td>
                                                }
                                                else
                                                {
                                                    <td style="padding-left: 5px; width: 35%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">@item.comment</td>

                                                }
                                            </tr>
                                        }

                                        else
                                        {
                                            <tr>
                                                <td style="padding-left: 5px; width: 26%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">@item.DisplayNameRep</td>
                                                <td style="padding-left: 5px; width: 35%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;" colspan="3">@item.OpsValue</td>
                                            </tr>
                                        }


                                    }

                                    <tr>
                                        <td style="padding-left: 5px; width: 26%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;">Additional Remarks</td>
                                        <td style="padding-left: 5px; width: 35%; border: 1px solid #000000;font-family:Calibri,sans-serif; font-size:10pt;" colspan="3">@Html.Raw(@ReportComment)</td>
                                    </tr>

                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top">
                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tbody>
                                    <tr>
                                        <td style="border-top:2px solid rgb(190, 190, 190);" colspan="3">
                                            &nbsp;
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="20%"><br><br><br><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                                        <td width="1%">&nbsp;</td>
                                        <td width="79%">
                                            <p style="font-size: 16px!important; font-family: Calibri, sans-serif; color:#000080; font-weight:500; text-align:center; margin:0px 0px 0px 0px;"><img src="~/Images/StampSignatureUpdated.jpg" width="60" height="60"></p>
                                            <p style="font-size: 16px!important; font-family: Calibri, sans-serif; color:#000080; font-weight:700; text-align:center; margin:0px 0px 0px 0px;">SECURITAS INDIA</p>
                                            <p style="font-size: 15px;font-family: Calibri, sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp; &nbsp;Tel: + 91 124 4718888</p>
                                            <p style="font-size: 15px; font-family: Calibri, sans-serif; color:#3a00ff; text-align:center; margin:5px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a> <span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>



            </page>

            if (Model.CandidateDocList != null)
            {
                foreach (var Doc in Model.CandidateDocList.Where(w => w.SubCheckRowID == a.SubcheckRowID))
                {
                    if (Doc.SubCheckRowID == a.SubcheckRowID)
                    {
                        FileInfo fin = new FileInfo(Server.MapPath(Model.DocPath + Doc.DocFile));
                        if (fin.Exists && (fin.Extension.ToLower().Contains(".jpg") || fin.Extension.ToLower().Contains(".jpeg") || fin.Extension.ToLower().Contains(".png")))
                        {
                            <page id="PrintSrc" size="A4">
                                <div style="page-break-after:always ;"></div>

                                <table cellspacing="0" cellpadding="0" align="center" style="border:3px solid #999999; width:100%; border-collapse:collapse;">
                                    <tr>
                                        @*<td width="2%" align="left" valign="bottom" style="border-left:2px solid #999999;">&nbsp;</td>*@
                                        <td valign="top" align="center" style="height:60rem;">
                                            <table width="100%" border="0" cellpadding="2" cellspacing="5" id="tblDemo">
                                                <tr>
                                                    <td style="font-size:10px; font-family:Calibri;">
                                                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                            <tr>
                                                                <td width="88%"><p style="font-size:16px;  color:#000000; text-align:center; font-weight:bold; text-decoration:underline; text-transform:none; margin:0px;">@a.SubCheckName (@Doc.DocumentType)</p></td>
                                                                <td width="6%" valign="top"><img src='@Url.Content("~/Images/logo.jpg")' width="71" height="40"></td>
                                                            </tr>
                                                            <tr><td colspan="2">&nbsp;</td></tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td valign="top">&nbsp;</td>
                                                </tr>
                                                <tr style="text-align:center">
                                                    <td valign="top">
                                                        @{
                                                            FileStream fs = new FileStream(Server.MapPath(Model.DocPath + Doc.DocFile), FileMode.Open, FileAccess.Read);
                                                            System.Drawing.Image image = System.Drawing.Image.FromStream(fs);

                                                            if (image.Height > 600)
                                                            {
                                                                <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" style="width:100%; height:55rem;" />
                                                            }
                                                            else
                                                            {
                                                                <img src="@Url.Content(Model.DocPath + Doc.DocFile)" alt="@Doc.DocumentType" style="width:100%; height:55rem;" />
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                        @*<td style="border-right:2px solid #999999;" align="left" valign="top">&nbsp;</td>*@
                                    </tr>
                                    <!--- Report Footer with Address Include -->
                                    <tr>
                                        <td valign="bottom">
                                            <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
                                                <tbody>
                                                    <tr>
                                                        <td style="border-top:2px solid rgb(190, 190, 190);" colspan="3">
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td width="20%"><br><br><br><img src='@Url.Content("~/Images/footer-logo.jpg")' width="120" height="50"></td>
                                                        <td width="1%">&nbsp;</td>
                                                        <td width="79%">
                                                            <p style="font-size: 16px!important; font-family: Calibri, sans-serif; color:#000080; font-weight:500; text-align:center; margin:0px 0px 0px 0px;"><img src="~/Images/StampSignatureUpdated.jpg" width="60" height="60"></p>
                                                            <p style="font-size: 16px!important; font-family: Calibri, sans-serif; color:#000080; font-weight:700; text-align:center; margin:0px 0px 0px 0px;">SECURITAS INDIA</p>
                                                            <p style="font-size: 15px;font-family: Calibri, sans-serif; color:#828484; text-align:center; margin:0px;">496, Udyog Vihar, Phase-3, Gurgaon-122016 &nbsp; &nbsp;Tel: + 91 124 4718888</p>
                                                            <p style="font-size: 15px; font-family: Calibri, sans-serif; color:#3a00ff; text-align:center; margin:5px;"><a href="http://www.securitas.in/" target="_blank">www.securitas.in</a> <span style="font-size:12px; font-family:'Open Sans',Arial,Helvetica,sans-serif; color:#3a00ff; text-align:center; margin:0px; padding-left:60px;"><a href="http://www.walsons.com/" target="_blank">www.walsons.com</a></span></p>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                    <!--- Report Footer with Address Include -->
                                </table>
                            </page>
                        }
                    }
                }
            }
            i++;
        }
    }
}
<br />