    function GenerateWordReport(strid) {
        const prtContent = document.getElementById(strid);
        const htmlContent = prtContent.innerHTML;

        const WinWord = window.open('', 'WordReport', 'left=0,top=0,width=800,height=600,toolbar=0,scrollbars=yes,status=0');

        // Escape backticks in content
        const safeHtmlContent = htmlContent.replace(/`/g, '\\`');

        WinWord.document.open();
        WinWord.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Document Preview</title>
        <link href="/Images/report.css" rel="stylesheet" type="text/css" />
        <style>
          body {
            font-family: Arial, sans-serif;
          }

          .download-container {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            text-align: center;
            padding: 10px 0;
            background: #f5f5f5;
            border-top: 1px solid #ddd;
          }

          .download-btn, .close-btn {
            padding: 8px 16px;
            font-size: 14px;
            border: none;
            cursor: pointer;
            border-radius: 4px;
            margin: 0 5px;
          }

          .download-btn {
            background: #4CAF50;
            color: white;
          }

          .close-btn {
            background: #f44336;
            color: white;
          }

          .loader-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            color: white;
            font-size: 18px;
          }

          .spinner {
            border: 6px solid #f3f3f3;
            border-top: 6px solid #ffffff;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin-bottom: 10px;
          }

          @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
          }
        </style>
      </head>
      <body>
        <div style="padding-bottom: 70px;" id="reportContent">${safeHtmlContent}</div>

        <div class="download-container">
          <button id="downloadBtn" class="download-btn">Download as Word</button>
          <button class="close-btn" onclick="window.close()">Close</button>
        </div>

        <div class="loader-overlay" id="loaderOverlay">
          <div class="spinner"></div>
          Please wait...
        </div>

        <script>
          document.getElementById("downloadBtn").addEventListener("click", function () {
            const loader = document.getElementById("loaderOverlay");
            loader.style.display = "flex";

            const contentToExport = document.getElementById("reportContent").innerHTML;

            fetch("/ReportQC/GenerateWordFromHtml", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({ htmlContent: contentToExport })
            })
            .then(response => {
              if (!response.ok) throw new Error("Error generating document");
              return response.blob();
            })
            .then(blob => {
              const url = window.URL.createObjectURL(blob);
              const a = document.createElement("a");
              a.href = url;
              a.download = "Report_" + new Date().toISOString().slice(0, 10) + ".docx";
              document.body.appendChild(a);
              a.click();
              setTimeout(() => {
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
                loader.style.display = "none";
              }, 100);
            })
            .catch(error => {
              loader.style.display = "none";
              alert("Error: " + error.message);
            });
          });
        <\/script>
      </body>
      </html>
    `);
        WinWord.document.close();
        WinWord.focus();
    }

</script>