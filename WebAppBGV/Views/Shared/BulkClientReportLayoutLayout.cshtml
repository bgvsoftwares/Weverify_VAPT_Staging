    }

    function CallWordDownload(strid) {
        var prtContent = document.getElementById(strid);
        var cssLink = '<link rel="stylesheet" href="/Images/report.css" type="text/css" />';

        var html = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office'
              xmlns:w='urn:schemas-microsoft-com:office:word'
              xmlns='http://www.w3.org/TR/REC-html40'>
        <head>
            <meta charset='utf-8'>
            <title>Export to Word</title>
            ${cssLink}
        </head>
        <body>
            ${prtContent.innerHTML}
        </body>
        </html>`;

        var blob = new Blob(['\ufeff', html], {
            type: 'application/msword'
        });

        var url = URL.createObjectURL(blob);
        var link = document.createElement("a");
        link.href = url;
        link.download = 'report.doc';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }
    function ExportToWord(strid) {
        var htmlContent = document.getElementById(strid).innerHTML;
        var formData = new FormData();
        formData.append("Html", htmlContent);

        fetch('/Export/ToWord', {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(msg => { throw new Error(msg); });
                }
                return response.blob();
            })
            .then(blob => {
                const blobUrl = window.URL.createObjectURL(blob);

                // Preview in a new tab
                window.open(blobUrl, '_blank');

                // Also trigger download
                const a = document.createElement('a');
                a.href = blobUrl;
                a.download = "Report.docx";
                a.click();

                setTimeout(() => window.URL.revokeObjectURL(blobUrl), 5000);
            })
            .catch(err => {
                alert("Error: " + err.message);
            });
    }




</script>
