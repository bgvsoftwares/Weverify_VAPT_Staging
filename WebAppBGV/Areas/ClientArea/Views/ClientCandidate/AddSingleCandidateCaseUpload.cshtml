        function checkDuplicate(callback) {
        	var mobile = $("#m_19").val();
        	var email = $("#8").val();

        	$.ajax({
        		url: '@Url.Action("CheckDuplicate", "ClientCandidate")',
        		type: 'POST',
        		data: {
        			MobileNo: mobile,
        			EmailId: email
        		},
        		success: function(res) {
                    if (res.isDuplicate) {
                        showDuplicatePopup(res);
                        callback(true);
                    }
                    else {
                        callback(false);
                    }
        		},
        		error: function() {
                    callback(false);
        		}
        	});
        }

        function showDuplicatePopup(res) {
        	Swal.fire({
        		icon: 'warning',
        		title: 'Duplicate Data Found',
        		html: '<b>Company Ref No:</b> ' + res.companyRefNo + '<br/>' +
        			'<b>Name:</b> ' + res.name,
        		showCancelButton: true,
        		confirmButtonText: 'Approve',
        		cancelButtonText: 'Not Approve'
        	}).then((result) => {
        		if (result.isConfirmed) {
        			setTimeout(function() {
                        $("form").submit();
        			}, 1);
        		} else if (result.dismiss === Swal.DismissReason.cancel) {
        			location.reload();
        		}
        	});
        }


