@model dynamic
@{


    ViewBag.Title = "Invite Single Candidate For BGV";
    Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "ManageClientCandidate", "ClientCandidate", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    string msg = "";
    if (Request.QueryString["ErrorMsg"] != null)
    {
        //hyperLink = Html.ActionLink("linkTitle", "AllocatedDataEntryJob", "ProvidedInfo", new { CaseStatus = Request.QueryString["Casestatus"].ToString() }, new { @class = "headerbacklink" }).ToString();
        msg = Request.QueryString["ErrorMsg"].ToString();
    }

    string clientRowId = "";



    clientRowId = @ViewBag.clientRowId;
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }

@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="submit-progress hidden">
    <i class="fa fa-2x fa-spinner fa-spin"></i>
    @*<label>Please wait...</label>*@
</div>

<div class="container-fluid form_container">
    <div class="row">
        <div class="col-lg-12 col-md-12 pt-3">
            @if (msg != "")
            {
                <div class="errormsglogin" style="font-size: 22px;">@msg.ToString()</div>
            }
            @if (Enumerable.Count(ViewBag.ClientList) > 0)
            {
            }
        <div class="">
            @using (Html.BeginForm("AddSingleCandidateCaseUpload", "ClientCandidate", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input id="Savebtn" name="Savebtn" type="hidden" value=''>
                if (clientRowId == "1209")
                {
                    <div class="row row-xs align-items-center mg-b-20 mt-4">
                        @{
                            if (Enumerable.Count(ViewBag.ClientList) > 0)
                            {
                                <div class="col-md-3">
                                    @Html.Label("Select Client", htmlAttributes: new { @class = "control-label required form-label mg-b-0 fw-bolder" })
                                </div>
                                <div class="col-md-7 mg-t-5 mg-md-t-0">
                                    @Html.DropDownList("ClientRowID", new SelectList(ViewBag.ClientList, "ClientRowID", "ClientName"),
                                          "-- Select Client -- ",
                                          new { @id = "ClientRowID", @class = "form-control" })
                                </div>
                            }
                        }
                    </div>

                }

                else
                {
                    <input id="ClientRowID" type="hidden" value=@clientRowId>
                    @Html.Hidden("ClientRowID", clientRowId.ToString())

                }

                @Html.ValidationSummary();

                foreach (var category in Model)
                {
                    <div class="row row-xs align-items-center mg-b-20">

                        @{
                            string[] nm = category.Key.Split('_');

                            if (@nm[2] == "textbox")
                            {
                                <div class="col-md-3">
                                    <label class="form-label mg-b-0 fw-bolder">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7 style="color:red;">*</h7>
                                            }
                                            else
                                            {
                                                <h7>&nbsp;</h7>
                                            }
                                        }
                                        @nm[1]
                                    </label>
                                </div>
                                <div class="col-md-7 mg-t-5 mg-md-t-0">
                                    <span style="color:red;"> @nm[4]</span>
                                    @if (Convert.ToInt32(nm[0]) == 19)
                                    {
                                        <input type="text" class="form-control" name=@nm[0] id="m_@nm[0].Trim()" value='@category.Value' maxlength="@nm[5]" autocomplete="off" onkeypress="return onlyNumericValue(event);" oninput="process(this)">
                                    }
                                    else
                                    {
                                        if (Convert.ToInt32(nm[0]) == 8)
                                        {
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' autocomplete="off" maxlength="@nm[5]" onChange="Validate()">
                                        }
                                        else if (Convert.ToInt32(nm[0]) == 208)
                                        {
                                            if (clientRowId == "684")
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' autocomplete="off" maxlength="@nm[5]">
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' autocomplete="off" maxlength="@nm[5]" disabled>
                                            }
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' autocomplete="off" maxlength="@nm[5]">
                                        }
                                    }

                                </div>
                            }
                            if (@nm[2] == "dropdown")
                            {
                                <div class="col-md-3">
                                    <label class="form-label mg-b-0 fw-bolder">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7 style="color:red;">*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </label>

                                </div>
                                if (nm[0] == "380")
                                {
                                    if (clientRowId == "1430")
                                    {
                                        <div class="col-md-7 mg-t-5 mg-md-t-0">
                                            @Html.DropDownList("380", new SelectList(ViewBag.BusinessUnitList, "BURowID", "BUName"),
                                                  "-- Select-- ",
                                                  new { @id = "380", @class = "form-control" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-7 mg-t-5 mg-md-t-0">
                                            <span style="color:red;"> @nm[4]</span>
                                            @{
                                                string[] nmOption = nm[7].Split(',');
                                            }
                                            <select name=@nm[0] id=@nm[0] class="form-control">
                                                @for (int i = 0; i < nmOption.Length; i++)
                                                {
                                                    if (@nmOption[i].Trim() == @nm[6])
                                                    {
                                                        <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                                    }
                                                    if (@nmOption[i].Trim() != @nm[6])
                                                    {
                                                        <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                                    }
                                                }
                                            </select>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-md-7 mg-t-5 mg-md-t-0">
                                        <span style="color:red;"> @nm[4]</span>
                                        @{
                                            string[] nmOption = nm[7].Split(',');
                                        }
                                        <select name=@nm[0] id=@nm[0] class="form-control">
                                            @for (int i = 0; i < nmOption.Length; i++)
                                            {
                                                if (@nmOption[i].Trim() == @nm[6])
                                                {
                                                    <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                                }
                                                if (@nmOption[i].Trim() != @nm[6])
                                                {
                                                    <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                                }
                                            }
                                        </select>

                                    </div>
                                }


                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="col-md-3">
                                    <label class="form-label mg-b-0 fw-bolder">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7 style="color:red;">*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </label>

                                </div>

                                <div class="col-md-7 mg-t-5 mg-md-t-0">

                                    <span style="color:red;"> @nm[4]</span>
                                    @{
                                        if (@nm[6] == "TRUE")
                                        {
                                            <input type="checkbox" id=@nm[0] name=@nm[0] value="checked" checked>
                                        }
                                        else
                                        {
                                            <input type="checkbox" id=@nm[0] name=@nm[0] value=@nm[0]>
                                        }
                                    }

                                </div>
                            }
                            if (@nm[2] == "fileUpload")
                            {
                                <div class="col-md-3">
                                    <label class="form-label mg-b-0 fw-bolder">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7 style="color:red;">*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </label>

                                </div>

                                <div class="col-md-7 mg-t-5 mg-md-t-0">

                                    <input class="form-control dropify" type="file" id=@nm[0] name=@nm[0] onchange="return fileValidation(this)" accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">

                                </div>
                            }
                        }
                    </div>
               
            }
            <div class="row row-xs align-items-center">
                <div class="col-md-3 mg-t-5 mg-md-t-0">
                    @if (clientRowId == "1470")
                    {
                        <label class="control-label fw-bolder text-right"><span style="color:red;">*</span>Package : </label>
                    }
                    else
                    {
                        <label class="control-label fw-bolder text-right"><span style="color:red;">*</span>Pricing Type : </label>
                    }
                </div>
                <div class="col-md-7 mg-t-5 mg-md-t-0">
                    @if (clientRowId == "1680")
                    {


                        @Html.DropDownList("PricingType", new List<SelectListItem>
{ new SelectListItem { Text = "-- Select --", Value = "0" },
new SelectListItem { Text = "Package", Value = "1" },
new SelectListItem { Text = "Check", Value = "2" },
new SelectListItem { Text = "Package & Check", Value = "4" }},
new { @class = "form-control" })
                    }
                    else
                    {
                        @Html.DropDownList("PricingType", new List<SelectListItem>
        { new SelectListItem { Text = "-- Select --", Value = "0" },
        new SelectListItem { Text = "Package", Value = "1" },
        new SelectListItem { Text = "Check", Value = "2" }},
    new { @class = "form-control" })
                    }

                    <div class="row row-xs align-items-center">
                        <div id="dvChksPcks" class="col-md-12" style="background:#fff;">
                            <label class="scheduler-border m-2"> Selected Checks And Package<em style="color:red;">*</em></label>
                            <div class="input-group mb-2">
                                <input type="text" class="form-control" placeholder="Search" onkeyup="myFunction()" id="myInput">
                                <span class="input-group-text" style="background: #FC273F;color: #fff;position: relative;right: 39px;height: 40px; transition:ease-in-out 0.5s;">
                                    <i class="bx bx-search-alt"></i>
                                </span>
                            </div>
                            <ul id="dvChecksPackages" style="list-style-type:none!important; height:300px!important; overflow:scroll!important;"></ul>
                        </div>
                    </div>
                </div>
            </div>


            @Html.Hidden("CandidateCheckOrPackage")

            <div class="row row-xs align-items-center mt-4 justify-content-center">
                @if (Convert.ToInt32(clientRowId) == 576 || Convert.ToInt32(clientRowId) == 570 || Convert.ToInt32(clientRowId) == 861 || Convert.ToInt32(clientRowId) == 130 || Convert.ToInt32(clientRowId) == 940)
                {
                    <div class="col-md-2">
                        <input class="submit-btn btn-block rounded-0" type="submit" onclick="return validateForm(this,'Force Submit')" id="btnFSubmit" name="btnSave" value="Force Submit" />
                    </div>
                }
                @if (Convert.ToInt32(clientRowId) == 1680)
                {
                    <div class="col-md-2">
                        <input class="submit-btn btn-block rounded-0" type="submit" onclick="return validatevalueForm(this,'Submit')" id="btnNSubmit" name="btnSave" value="Submit" />
                    </div>
                }
                else
                {
                    <div class="col-md-2">
                        <input class="submit-btn btn-block rounded-0" type="submit" onclick="return validateForm(this,'Submit')" id="btnNSubmit" name="btnSave" value="Submit" />
                    </div>
                }
            </div>
            }

        </div>
        </div>
    </div>
    <div class="row m-auto">
        <div class="col-xl-12 mt-5 mb-4 client-table-responsive">
            <table class="mb-0 client--table-responsive table-striped m-auto table" style="border:none; cursor:grab;">
                <thead>
                    <tr>
                        <th class="top-head">Candidate Name</th>
                        <th class="top-head">Mobile</th>
                        <th class="top-head">Email ID</th>
                        <th class="top-head">Creation Date</th>
                    </tr>
                </thead>
                <tbody class="tx-14 text-start">
                    @foreach (var item in ViewBag.LastFiveCases)

                    {
                        <tr>
                            <td class="name">@item.Name</td>
                            <td class="name">@item.MobileNo</td>
                            <td class="name">@item.EmailID</td>
                            <td class="name">@item.CreationDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/normalizePlugin.js"></script>
    <script>

        function Validate() {
            var email = document.getElementById('8');
              var filter = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
            if (!filter.test(email.value)) {
                //('Please provide a valid email address');
                Swal.fire({
                    icon: 'info',
                    title: '<p class="fs-12">Mandatory Fields</p>',
                    html: 'Please provide a valid email address',
                    showConfirmButton: false,
                    timer: 2000
                });
            }
        }

        function onlyNumericValue(event) {
            var charCode = (event.which) ? event.which : event.keyCode
            if (charCode > 31 && (charCode < 48 || charCode > 57))
                return false;

            return true;

        }

        function process(input) {
            let value = input.value;
            let numbers = value.replace(/[^0-9]/g, "");
            input.value = numbers;
        }

        var crid = $("#ClientRowID").val();
        if (crid == 576 || crid == 570) {
            if ('@Convert.ToInt32(TempData["Exists"])' != '0') {
                $("#btnFSubmit").prop('disabled', false);
                $("#btnNSubmit").prop('disabled', true);
            }
                  else {
               $("#btnFSubmit").prop('disabled', true);
                $("#btnNSubmit").prop('disabled', false);
                                        }
                                    }

        $("#121").AlphabetWithSpace();
        $("#8").EmailString();

    </script>
    <script type="text/javascript">

        $(document).ready(function () {
            var ClientRowID = $('#ClientRowID').val();
            if (ClientRowID == 249) {

                $("#ClientRefID").attr('maxlength', '9');
            }
            else if (ClientRowID == 1071)
            {
                $("#208").val('GCoE');
            }
            else {

                $("#ClientRefID").attr('maxlength', '50');
            }

            $('#ClientRowID').change(function () {
                $('#PricingType').val(0);
                $('#dvChksPcks').hide();
            })
            $('#dvChksPcks').hide();
            $('#PricingType').change(function () {
                var url1 = "/ClientArea/Home/GetChecksAndPackageByClientId?id=" + $("#ClientRowID").val() + "&pt=" + $("#PricingType").val() + "&Des=" + $("#7").val() + "&Entity=" + $("#208").val();
                $.ajax({
                    url: url1,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (allData) {
                        if (allData != null && allData != "") {
                            $('#dvChksPcks').show();
                            var items = '';
                            jQuery.each(allData, function (index, allData) {
                                if (allData.CheckFamilyRowID != 0) {
                                    if (allData.CheckFamilyRowID == 0903)
                                    {
                                        items += "<li  class='paackage_li' style='padding: .30rem; list-style-type: none;'><a><input type='checkbox' class='chkPkgChks' onClick='ckChange1(this)' value='" + allData.PackageorCheckRowid + "' /> " + allData.CheckOrPackageName + "</a></li>";

                                    }
                                    else
                                    {
                                        items += "<li class='paackage_li' style='padding: .30rem; list-style-type: none;'><a><input type='checkbox' class='chkPkgChks' value='Check-" + allData.ClientCheckRowID + "' /> " + allData.CheckOrPackageName + "</a></li>";

                                    }
                                }
                                else {
                                    items += "<li class='paackage_li' style='padding: .30rem; list-style-type: none;'><a><input type='checkbox' class='chkPkgChks' name='checkbox1' onClick='ckChange(this)' value='Package-" + allData.CheckOrPackageName + "' /> " + allData.CheckOrPackageName + "</a></li>";
                                }
                            });
                            $('#dvChecksPackages').html(items);
                        }
                        else {
                            $('#dvChksPcks').hide();
                            //alert("No Checks And Packages Selected");
                            Swal.fire({
                                icon: 'info',
                                html: 'No Checks And Packages Selected',
                                showConfirmButton: false,
                                timer: 2000
                            });
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        //alert("some error");
                        Swal.fire({
                            icon: 'warning',
                            html: 'Some error',
                            showConfirmButton: false,
                            timer: 2000
                        });
                    }
                });
            });
        });

        $(document).on('change', 'input[class="chkPkgChks"]', function (e) {
            var selectedIds = '';
            $('input[class="chkPkgChks"]').each(function (index, value) {
                if (this.checked) { selectedIds += this.value + ','; }
            });
            if (selectedIds.length > 0) {
                selectedIds = selectedIds.substring(0, selectedIds.length - 1);
            } else { selectedIds = ''; }

            $('#CandidateCheckOrPackage').val(selectedIds.trim());
        });
        $(function () {
            var crid = $("#ClientRowID").val();

            if (crid == 8) {
                $("#MobileNo").focusout(function () {
                    $("#ClientRefID").val($(this).val());
                });
            }
        })



