        function validatevalueForm(ctl, btn) {

        	var obj = $('form input[type="text"]').NormalizedString();
        	if (obj == false) {
        		return false;
        	}

        	var mnd = '@ViewBag.Mandatory';
        	if (mnd == 'mandatory') {
        		var mb = $("#m_19").val();
        		if (mb == '') {
        			Swal.fire({
        				icon: 'info',
        				title: 'Mandatory Fields.',
        				html: '<div class="errormsg" style="text-align:left;">Please enter Mobile Number</div>'
        			});
        			$("#m_19").focus();
        			return false;
        		} else {
        			if (mb.length < 10) {
        				Swal.fire({
        					icon: 'info',
        					title: 'Mandatory Fields.',
        					html: '<div class="errormsg" style="text-align:left;">Please enter 10-digit Mobile Number</div>'
        				});
        				$("#m_19").focus();
        				return false;
        			}
        		}
        	}
        	var chkCount = 0;
        	$('input.chkPkgChks:checkbox').each(function(index, value) {
        		if (this.checked) {
        			chkCount += 1;
        		}
        	});

        	if (chkCount == 0) {
        		Swal.fire({
        			icon: 'info',
        			title: 'Mandatory Fields.',
        			html: '<div class="errormsg" style="text-align:left;">Please select atleast one Check or Package.</div>'
        		});
        		return false;
        	}

        	if (chkCount == 2 && $('#PricingType').val() == 1) {
        		Swal.fire({
        			icon: 'info',
        			title: 'Mandatory Fields.',
        			html: '<div class="errormsg" style="text-align:left;">Please select  one  Package.</div>'
        		});
        		return false;
        	}
        	if ($("#UploadDoc").val() == "") {
        		alert("Upload Candidate ducument");
        		$('#UploadDoc').focus();
        		return false;
            }
                        
            $("#Savebtn").val(btn);
        	event.preventDefault();
        	// Turn off the "Save" button and change text
        	$(ctl).prop("disabled", true).val('Saving...');
        	// Gray out background on page
