        	$(".submit-progress").removeClass("hidden");
            //submit the form.
            checkDuplicate(function (isDuplicate) {
                if (!isDuplicate) {
                    $("form").submit();
                } else {
                    // Re-enable button if duplicate found
                    $(ctl).prop("disabled", false).val("Submit");
                    $("body").removeClass("submit-progress-bg");
                    $(".submit-progress").addClass("hidden");
                }
