@model ViewModels.ProvidedInfoViewModel.AddTempPQVerifiedUploadDocViewModel
@{
    ViewBag.Title = "Candidate Upload Doc";
}


@*@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
    @section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }*@

<div class="row">
    @if (ViewBag.SuccessMsg != null)
    {
        <div class="successmsg" style="text-align:center" id="divsucc">@ViewBag.SuccessMsg.ToString()</div>
    }

    @if (ViewBag.ErrorMsg != null)
    {
        <div class="errormsg" style="text-align:center">@ViewBag.ErrorMsg.ToString()</div>
    }
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("UploadHindCandidatedoc", "ClientCandidate", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                        <div class="form-horizontal">
                            <div class="form-group branch row search-frame">
                                @Html.HiddenFor(model => model.PersonalRowID, new { @id = "HfPersonalRowID" })
                                <label class="col-md-2 control-label">Education Proof :</label>
                                <div class="col-md-4">
                                    @Html.TextBoxFor(model => model.EducationProof, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>

                                <label class="col-md-2 control-label">Division :</label>
                                <div class="col-md-4">

                                    @Html.TextBoxFor(model => model.Division, new { @id = "Division" })


                                </div>
                            </div>

                            <div class="form-group branch row search-frame">

                                <label class="col-md-2 control-label">:Pan Card :</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.PanCard, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>
                            </div>

                            <div class="form-group branch row search-frame">

                                <label class="col-md-2 control-label">AAdhar Card :</label>
                                <div class="col-md-4">
                                    @Html.TextBoxFor(model => model.AAdharCard, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>
                                <label class="col-md-2 control-label">Aadhar No :</label>
                                <div class="col-md-4">

                                    @Html.TextBoxFor(model => model.AadharNo, new { @id = "Division" })


                                </div>
                            </div>

                            <div class="form-group branch row search-frame">

                                <label class="col-md-2 control-label">Bank account :</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.BankAccountProof, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>
                            </div>

                            <div class="form-group branch row search-frame">

                                <label class="col-md-2 control-label">Employment proof  :</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.Employmentproof, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>
                            </div>

                            <div class="form-group branch row search-frame">

                                <label class="col-md-2 control-label">DOB proof  :</label>
                                <div class="col-md-4">
                                    @Html.TextBoxFor(model => model.DOBproof, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>
                                <label class="col-md-2 control-label">DOB :</label>
                                <div class="col-md-4">

                                    @*@Html.TextBoxFor(model => model.DOB, new { @id = "DOB" })*@
                                    @Html.TextBoxFor(model => model.DOB, null, new {  @id = "DOB", @placeholder = "dd-mm-yyyy" })


                                </div>
                            </div>

                            <div class="form-group branch row search-frame">

                                <label class="col-md-2 control-label">Passport   :</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.Passport, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>
                            </div>

                            <div class="form-group branch row search-frame">

                                <label class="col-md-2 control-label">Passport  size photo  :</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.Passportsizephoto, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file" })


                                </div>
                            </div>

                            <div class="all-button-bg">


                                @*<input class="btn bun-bg btn-default" type="submit" value="CheckDelete" name="CheckDel" onclick="DeleteCheck()" />*@
                                @*<input class="btn bun-bg btn-default" type="submit" value="CheckMove" name="MoveCheck" onclick="DeleteCheck()" />*@

                                <div class="all-button-bg">
                                    @Html.ActionLink("Back", "ManageClientCandidate", "ClientCandidate", null, new { @class = "btn bun-bg btn-default" })
                                    <input class="btn bun-bg btn-default" type="submit" onclick="return validateForm()" name="Command" value="submit" id="btnMoveCheck" />
                                </div>
                                @*<button type="button" class="btn bun-bg btn-default" onclick="location.href='@Url.Action("DeleteCheck", "ClientServicing")'">DeleteCheck</button>*@





                            </div>

                        </div>
                        }
                    </div>


                </div>
