</style>
<style>
    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: #dddddd;
    }
</style>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#dvChksPcks').hide();
        });

        $(document).on('change', 'input[class="chkPkgChks"]', function (e) {
            var selectedIds = '';
            $('input[class="chkPkgChks"]').each(function (index, value) {
                if (this.checked) { selectedIds += this.value + ','; }
            });
            if (selectedIds.length > 0) {
                selectedIds = selectedIds.substring(0, selectedIds.length - 1);
            } else { selectedIds = ''; }

            $('#CandidateCheckOrPackage').val(selectedIds.trim());
        });

        $(function () {
            $('#ClientRowID').change(function () {
                $('#PricingType').val(0);
                $('#dvChksPcks').hide();
            });

            $('#PricingType').change(function () {
                if ($('#ClientRowID').val() > 0) {
                    var url1 = "/ProvidedInfo/GetChecksAndPackageByClientId?cid=" + $("#ClientRowID").val() + "&pt=" + $("#PricingType").val();
                    $.ajax({
                        url: url1,
                        type: 'GET',
                        async: false,
                        dataType: 'json',
                        success: function (allData) {
                            if (allData != null && allData != "") {
                                $('#dvChksPcks').show();
                                var items = '';
                                jQuery.each(allData, function (index, allData) {
                                    if (allData.CheckFamilyRowID != 0) {
                                        items += "<div  class='col-md-6'><input type='checkbox' class='chkPkgChks'' value='Check-" + allData.ClientCheckRowID + "' /> " + allData.CheckOrPackageName + "</div>";
                                    }
                                    else {
                                        items += "<div  class='col-md-6'><input type='checkbox' class='chkPkgChks' name='checkbox1' onClick='ckChange(this)' value='Package-" + allData.CheckOrPackageName + "' /> " + allData.CheckOrPackageName + "</div>";
                                    }
                                });
                                $('#dvChecksPackages').html(items);
                            }
                            else {
                                $('#dvChksPcks').hide();
                                alert("No Checks And Packages Selected");
                            }
                        },
                        error: function (XMLHttpRequest, textStatus, errorThrown) {
                            alert("some error");
                        }
                    });
                }
                else {
                    alert("Select a client first!");
                }
            });
        });

        function validateForm(ctl, msg) {
            if ($('#UploadDoc').val() == '') {
                alert("Upload Document");
                return false;
            }

            if ($('#PricingType').val() == 0) {
                alert("Select Pricing Type");
                $('#PricingType').focus();
                return false;
            }

            var chkCount = 0;
            $('input.chkPkgChks:checkbox').each(function (index, value) {
                if (this.checked) {
                    chkCount += 1;
                }
            });
            if (chkCount == 0) {
                alert("Please select atleast one Check or Package.");
                return false;
            }

            event.preventDefault();
            $(ctl).prop("disabled", true).val(msg);
            $("body").addClass("submit-progress-bg");
            $(".submit-progress").removeClass("hidden");
            setTimeout(function () {
                $("form").submit();
            }, 1);



            return true;
        }
        function ckChange(el) {
            var ckName = document.getElementsByName(el.name);
            for (var i = 0, c; c = ckName[i]; i++) {
                c.disabled = !(!el.checked || c === el);
            }
        }
    </script>


    <script>
        function file_XLS_Validation(fileInput) {
            var filePath = fileInput.value;
            var allowedExtensions = /(\.xls|\.xlsx|\.XLS|\.XLSX)$/i;
            if (!allowedExtensions.exec(filePath)) {
                swal.fire('Please upload file having extensions .xls/.xlsx only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }

        function file_Doc_Validation(fileInput) {
            var filePath = fileInput.value;
            var allowedExtensions = /(\.gif|\.GIF\.doc|\.docx|\.xls|\.xlsx|\.pdf|\.rtf|\.txt|\.jpeg|\.jpg|\.png|\.eml|\.email|\.msg|\.DOC|\.DOCX|\.XLS|\.XLSX|\.PDF|\.RTF|\.TXT|\.JPEG|\.JPG|\.PNG|\.EML|\.EMAIL|\.MSG|\.zip|\.ZIP|\.rar|\.RAR)$/i;
            if (!allowedExtensions.exec(filePath)) {
                swal.fire('Please upload file having extensions .doc/.gif/.GIF/.docx/.xls/.xlsx/.pdf/.rtf/.txt/.jpeg/.jpg/.png/.eml/.email/.msg/.DOC/.DOCX/.XLS/.XLSX/.PDF/.RTF/.TXT/.JPEG/.JPG/.PNG/.EML/.EMAIL/.MSG/.ZIP.zip only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }
    </script>

