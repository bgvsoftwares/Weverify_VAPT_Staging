    @RenderSection("scripts", required: false)

    <div id="divPopupTimeOut" style="display:none; text-align: left; margin-top:-430px; width:350px !important; position:fixed;  right:800px; z-index:9999; height:200px;" class="alert alert-warning">
        <div class="row" style="margin-top:10px; margin-left:10px; color:red; background-color:bisque">
            Your session is about to expire!
            <br />
            <span id="CountDownHolder"></span>
            <br />
            Click OK to continue your session.
        </div>
        <div class="row">
            <div class="text-center button-block" style="text-align:center; margin-top:22px;">
                <button type="button" class="btn btn-default btn-sm" onclick="SessionTimeout.sendKeepAlive();">OK</button>
                <button type="button" class="btn btn-default btn-sm" onclick="SessionTimeout.hidePopup();">Cancel</button>
            </div>
        </div>
    </div>

    @functions {
        public int PopupShowDelay
        {
            get
            {
                return 1000 * (((Session.Timeout) * 60) - 80);
                //return 1000 * (Convert.ToInt32(FormsAuthentication.Timeout.TotalSeconds) - 130);
                //return 1000 * (Convert.ToInt32(FormsAuthentication.Timeout.TotalSeconds) - 130);

            }



        }
    }
    <script type="text/javascript">
        var loginUrl = '';
        var ClientRowID = '@Session["ClientRowID"]';
                    var VendorLoginRowID = '@Session["VendorLoginRowID"]';
                    var CRPUserName = '@Session["CRPUserName"]';
        if (VendorLoginRowID != "") {
            //alert('Your session value is  ' + VendorLoginRowID.val())
            loginUrl = "/Account/VendorLogin/";
        }
        else if (ClientRowID != "") {
            ////alert('Your session value is  ' + ClientRowID.val())
            loginUrl = "/Account/ClientLogin/";
        }

        else if (CRPUserName != "") {
            //alert('Your session value is  ' + CRPUserName.val())
            loginUrl = "/Account/Index/";
        }


    @*var loginUrl='@Url.Action("Index", "Account")';*@
    var extendMethodUrl='@Url.Action("ExtendSession","Account")';
    $(document).ready(function(){
            SessionTimeout.schedulePopup();
        });

    window.SessionTimeout = (function() {
            var _timeLeft, _popupTimer, _countDownTimer;
            var stopTimers = function() {
                window.clearTimeout(_popupTimer);
                window.clearTimeout(_countDownTimer);
            };
        var updateCountDown = function () {

            //alert(_timeLeft);
                var min = Math.floor(_timeLeft / 60);
                var sec = _timeLeft % 60;
                if(sec < 10)
                    sec = "0" + sec;

                document.getElementById("CountDownHolder").innerHTML = min + ":" + sec;

                if(_timeLeft > 1) {
                    _timeLeft--;
                    _countDownTimer = window.setTimeout(updateCountDown, 1000);

                } else {
                    var loginUrl = '';
                    //var jsVariable = '<%=Session("VirtualNumber") %>';
                    var ClientRowID = '@Session["ClientRowID"]';
                    var VendorLoginRowID = '@Session["VendorLoginRowID"]';
                    var CRPUserName = '@Session["CRPUserName"]';

                    if (VendorLoginRowID != "") {
                        //alert('Your session value is  ' + VendorLoginRowID.val())
                        loginUrl = "/Account/VendorLogin/";
                    }
                    else if (ClientRowID != "") {
                        ////alert('Your session value is  ' + ClientRowID.val())
                        loginUrl = "/Account/ClientLogin/";
                    }
                    else if (CRPUserName != "") {
                        //alert('Your session value is  ' + CRPUserName.val())
                        loginUrl = "/Account/Index/";
                    }
                    document.location = loginUrl;
                }
            };
            var showPopup = function() {
                $("#divPopupTimeOut").show();
                _timeLeft = 60;  // in sec
                updateCountDown();

        };

        var schedulePopup = function () {


            $("#divPopupTimeOut").hide();
                stopTimers();
                _popupTimer = window.setTimeout(showPopup, @PopupShowDelay);
            };
            var hidePopup=function(){
                $("#divPopupTimeOut").hide();
                $.ajax({
                    type: "GET",
                   @*// url: '@Url.Action("closeSession", "Account")',*@
                    url: "/Account/closeSession/",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function successFunc(response) {
                        //alert(loginUrl);
                        document.location = loginUrl;
                    },
                    error: function () {

                    }
                });

            };
        var sendKeepAlive = function () {

                stopTimers();
                $("#divPopupTimeOut").hide();
                $.ajax({
                    type: "GET",
                    url: extendMethodUrl,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function successFunc(response) {

                        SessionTimeout.schedulePopup();
                    },
                    error:function(){
                    }
                });
            };
            return {
                schedulePopup: schedulePopup,
                sendKeepAlive: sendKeepAlive,
                hidePopup:hidePopup,
                stopTimers:stopTimers,
            };

        })();

    </script>

    <style>
