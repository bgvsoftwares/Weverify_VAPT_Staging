@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "Manage Education Insuff Cases";
    Layout = "~/Areas/ClientArea/Views/Shared/_LayoutWoutNav.cshtml";
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "DashboardClient", "Home", new { area = "ClientArea" }, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@*@section LeftNavigation{ @Html.Partial("_NavLeftClientInsuff") }*@
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }

<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageEducationInsuffForClient", "ClientInsuff", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-horizontal">
                                <div class="form-horizontal">
                                    <div class="form-group branch search-frame">
                                        <label class="col-md-2 control-label">Keyword :</label>
                                        <div class="col-md-8">
                                            @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, SecuritasID...", @autocomplete = "off", @maxlength = "100" })
                                        </div>
                                    </div>
                                    <div class="form-group branch search-frame">
                                        <label class="col-md-2 control-label">Recieving From Date :</label>
                                        <div class="col-md-3">
                                            @Html.TextBox("RecievingfromDate", null, new { @class = "form-control", @id = "RecievingToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxlength = "11" })
                                        </div>
                                        <label class="col-md-2 control-label">Recieving To Date :</label>
                                        <div class="col-md-3">
                                            @Html.TextBox("RecievingToDate", null, new { @class = "form-control", @id = "RecievingFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxlength = "11" })
                                        </div>
                                    </div>
                                    <div class="form-group branch search-frame">
                                        <label class="col-md-2 control-label">Completed From Date :</label>
                                        <div class="col-md-3">
                                            @Html.TextBox("CompletedFromDate", null, new { @class = "form-control", @id = "CompletedToDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxlength = "11" })
                                        </div>
                                        <label class="col-md-2 control-label">Completed To Date :</label>
                                        <div class="col-md-3">
                                            @Html.TextBox("CompletedToDate", null, new { @class = "form-control", @id = "CompletedFromDate", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @maxlength = "11" })
                                            @Html.Hidden("ClientUserRowId", (string)ViewBag.clientUserRowid)
                                            @Html.Hidden("ClientRowID", (string)ViewBag.ClientRowID)
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group branch search-frame">
                                    <div style="text-align:center;">
                                        <input class="btn bun-bg btn-default" type="submit" value="Search" id="btnSearch" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQAllInsuffEducations != null)
                {
                    <div class="row">
                        <div class="col-md-12 table">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQAllInsuffEducations, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                         htmlAttributes: new { id = "grid", @class = "table" },
                                         headerStyle: "thead-inverse",
                                         rowStyle: "ordertxt",
                                         footerStyle: "custpaging",
                                         mode: WebGridPagerModes.All,
                                         columns: new[]
                                         {
                                                grid.Column(header: "No.", style:"td-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                //grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "CollegeName", header: "College Name", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"td-2"),
                                                  grid.Column(columnName: "EntityName", header: "EntityName", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "ClientPackageName", header: "Package Name", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "CompanyRefNo", header: "SecuritasID", canSort: false, style:"td-1"),
                                                grid.Column(columnName: "CheckStatus", header: "Check Status", canSort: false, style:"td-2"),
                                                grid.Column(columnName: "Remarks", header: "Remark", canSort: false, style:"td-2"),
                                                grid.Column("CreatedDate", "CreatedDate", format: (item) => item.CreatedDate !=null ? item.CreatedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"td-1"),

                                                grid.Column(header : "", format : (item) => {
                                                    var link = Html.ActionLink("Insuff Clear", "InsufficiencyCheckClearByClient", "ClientInsuff", new { id =  clsCommonMethods.PEncrypt(item.EducationRowId.ToString()), ClientRowId = clsCommonMethods.PEncrypt(item.ClientRowID.ToString()), ChFamilRowId =  clsCommonMethods.PEncrypt(item.CheckFamilyRowID.ToString()), subCheckId =  clsCommonMethods.PEncrypt(item.SubCheckRowID.ToString()), PersonalRowID =  clsCommonMethods.PEncrypt(item.PersonalRowID.ToString()), CompanyRefNo = clsCommonMethods.PEncrypt(item.CompanyRefNo.ToString()), InfRemarks = item.INFRemarks}, null);
                                                    return link;
                                                }, style:"edit td-1"),

                                         }
                                  )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                            <br />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script src="~/Scripts/normalizePlugin.js"></script>
    <script type="text/javascript">
         $(document).ready(function () {
            $('#Search').val('@Model.ItemSearch.Search');         
            $('#RecievingFromDate').val('@Model.ItemSearch.RecievingToDate');
            $('#CompletedFromDate ').val('@Model.ItemSearch.CompletedToDate' );
            $('#RecievingToDate').val('@Model.ItemSearch.RecievingFromDate');
            $('#CompletedToDate').val('@Model.ItemSearch.CompletedFromDate');

        });

        $(document).ready(function () {
            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>

    <script>
        $("#btnSearch").click(function () {
            var obj = $('form input[type="text"]').NormalizedString();
            if (obj == false) {
                return false;
            }
        });
        $("#Search").SearchString();
    </script>

}
