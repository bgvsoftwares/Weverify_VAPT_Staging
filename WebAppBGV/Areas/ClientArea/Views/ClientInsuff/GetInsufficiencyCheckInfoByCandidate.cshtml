<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("GetInsufficiencyCheckInfoByCandidate", "ClientInsuff", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CheckRowID)
            @Html.HiddenFor(model => model.SubCheckName)
            @Html.HiddenFor(model => model.INFReason)
            <input type="hidden" value="@Model.ClientRowID" id="ClientRowID" name="ClientRowID" />
            <input type="hidden" value="@Model.ChFamilRowId" id="ChFamilRowId" name="ChFamilRowId" />
            <input type="hidden" value="@Model.SubCheckRowID" id="SubCheckRowID" name="SubCheckRowID" />
            <input type="hidden" value="@Model.PersonalRowID" id="PersonalRowID" name="PersonalRowID" />
            <input type="hidden" value="@Model.SecuritasID" id="SecuritasID" name="SecuritasID" />

            <div class="form-horizontal">
                <div class="form-group row branch">
                    @Html.LabelFor(model => model.SubCheckName, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-6" style="margin-top:7px;"> @Model.SubCheckName </div>
                </div>
                <div class="form-group row branch">
                    @Html.Label("Insuff Remark:", htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-6" style="margin-top:7px;color:red"> @Model.INFReason </div>
                </div>
                <div class="form-group row branch">
                    <div id="dvUplodDoc">
                    </div>
                </div>
                <div class="form-group row branch" style="display:none;">
                    @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-2">
                        @Html.TextAreaFor(model => model.EmployeeID, new { @class = "form-control", @rows = "2" })
                    </div>
                    <div class="col-md-2">
                        @Html.ActionLink("Download", "InsuffClientAddresspdf", "ClientInsuff", new { PersonalRowID = Model.PersonalRowID, SubCheckRowID = Model.SubCheckRowID }, new { @class = "btn btn-success btn-lg" })
                    </div>
                </div>


                @Html.Hidden("UploadHid", null)
                <div class="form-group row branch">
                    @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "2" })
                    </div>
                </div>

                <div class="all-button-bg">
                    @*@Html.ActionLink("Dashboard", "DashboardClient", "Home", new { area = "ClientArea" }, new { @class = "btn bun-bg btn-default" })*@
                    @*<input class="btn bun-bg btn-default" type="submit" value="Back" onclick="window.history.back()" />*@
                    <input class="btn bun-bg btn-default" type="submit" value="Submit" onclick="return validateForm();" />
                </div>

            </div>

        }

    </div>
</div>

@section Scripts{

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {
            var url1 = "/ClientInsuff/GetDocumentTypeListBySubCheckIDForInsuffCandidate/" + $("#SubCheckRowID").val();
            $.ajax({
                url: url1,
                type: 'GET',
                async: false,
                dataType: 'json',
                success: function (allData) {
                    if (allData != null && allData != "") {
                        $('#dvChksPcks').show();
                        var items = '';
                        jQuery.each(allData, function (index, allData) {

                            items += "<div class='container'><div class='row'><div class='col-md-4'><label class='control-label'> " + allData.Text + " :</label></div><div class='col-md-2'><input type='checkbox' name='chkDoc' value=" + allData.Value + " class='form-control' style='width:20px;' /></div><div class='col-md-4'><input data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + " id=" + allData.Value + "></div></div></div>"
                        });
                        $('#dvUplodDoc').html(items);
                    }
                    else {
                        $('#dvChksPcks').hide();
                        alert("No Doc Selected");
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert("some error");
                }
            });
        });

        $(document).on('change', 'input[name="chkDoc"]', function (e) {// on change of state
            var chkDocs = '';
            $('input[name="chkDoc"]').each(function (index, value) {
                if (this.checked) {
                    chkDocs += this.value + ',';
                    $("#" + this.value + "").removeAttr("disabled");
                }
                else {
                    $("#" + this.value + "").attr("disabled", "disabled");
                }
            });

            if (chkDocs.length > 0) {
                chkDocs = chkDocs.substring(0, chkDocs.length - 1);
            } else { chkDocs = ''; }
            $('#UploadHid').val(chkDocs.trim());
        });

        function validateForm() {
            var rmk = $("#Remarks").val();
            if (rmk == '') {
                $("#Remarks").focus();
                Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">Please Enter Remarks</div>'
                });

                return false;
            }
        }

    </script>
}

