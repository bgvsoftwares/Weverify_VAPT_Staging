
@model ViewModels.VerificationViewModel.CandidatePersonalInfoViewModel
@{Layout = null; }

<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<style>

    .title_bg {
        background: #42638C !important;
        border-radius: 0px !important;
        font-weight:600;
        font-size: 2rem;
        color: #fff;
        padding: 10px;
    }
</style>
<div width="100%" class="mb-0 text-md-nowrap fl-table table-responsive table">

    <h4 class="title_bg">Update Client Ref No</h4>
    @if (ViewBag.SuccessMsg != null)
    {
        <div class="successmsg">@ViewBag.SuccessMsg.ToString()</div>
    }

    @if (ViewBag.ErrorMsg != null)
    {
        <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
    }

    <div width="12%">&nbsp;</div>

    @if (Model != null)
    {
        using (Html.BeginForm("UpdateClientRefNo", "Home", new { area = "ClientArea" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            // @Html.HiddenFor(model => model.Personalrowid)
            <input type="hidden" name="Personalrowid" id="Personalrowid" value="@Model.Personalrowid" />
            <div class="container">
                <div class="row">
                    <div class="col-md-6 mb-3"><label style="font-size:13px !important;">CompanyRefNo: </label></div>
                    <div class="col-md-6 mb-3">@Model.CompanyRefNo</div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label style="font-size:13px !important;">Candidate Name : </label></div>
                    <div class="col-md-6 mb-3">@Model.CandidateName</div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label style="font-size:13px !important;">Client Ref No : </label></div>
                    <div class="col-md-6 mb-3">@Html.TextBoxFor(model => model.ClientRefNo, new { @class = "form-control " })</div>
                </div>
                @if (Model.Personalrowid > 0)
                {
                    <div class="row">

                        <div class="col-md-12 d-flex justify-content-center m-5" ><input type="submit" id="submit" value="Update" class="btn btn-default" /></div>
                    </div>
                }

            </div>
     
        }
    }

    <div width="12%">&nbsp;</div>

    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <script>
        $(document).ready(function () {

        });

    </script>

