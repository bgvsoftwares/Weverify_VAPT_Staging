@* --- Custom Styles --- *@
<style>
    /* Style for the select-like text in bootstrap-multiselect if it were active */
    .multiselect-selected-text {
        color: #000 !important;
    }

    /* CSS to make the checkbox list scrollable */
    .scrollable-checkbox-list {
        /* Set a fixed maximum height for the container */
        max-height: 200px; /* Adjust this value (e.g., 150px, 300px) as needed */
        /* Crucial: Enable vertical scrolling when content exceeds max-height */
        overflow-y: auto;
        /* Optional: Add a thin border to visually frame the scrollable area */
        border: 1px solid #ccc;
        /* Optional: Add some padding inside the container */
        padding: 5px;
        background-color: #f9f9f9; /* Light background for the scrollable area */
        border-radius: 4px; /* Slight rounding for container */
    }

        /* Optional: Ensure the last item isn't flush against the bottom border */
        .scrollable-checkbox-list .checkbox {
            margin-top: 0;
            margin-bottom: 5px;
        }

    /* General Form Styling Enhancements */
    .search-frame {
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

    .control-label {
        font-weight: 600; /* Make labels slightly bolder */
        text-align: right; /* Align labels to the right */
    }

    .bun-bg { /* Assuming this is a custom button style */
        background-color: #5cb85c; /* Example: Green color for primary action */
        color: white;
        border: 1px solid #4cae4c;
        transition: background-color 0.3s ease;
    }

        .bun-bg:hover {
            background-color: #449d44;
            color: white;
        }

    .all-button-bg {
        text-align: center;
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #eee;
    }
</style>
@* --- End Custom Styles --- *@
<div class="container-fluid">
    <h2 class="page-header">@ViewBag.Title</h2>

    @if (ViewBag.ErrorMsg != null)
    {
        <div class="alert alert-danger" role="alert">
            <strong><span class="glyphicon glyphicon-remove-sign"></span> Error:</strong> @ViewBag.ErrorMsg
        </div>
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Re-Invite Details</h3>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm("Reverification", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">

                    @* --- Search/ID Section --- *@
                    <div class="form-group branch row search-frame">
                        <label class="col-sm-2 control-label">CompanyRefNo :</label>
                        <div class="col-sm-3">
                            @Html.TextBoxFor(model => model.SecuritasID, null, new { @class = "form-control", placeholder = "Enter CompanyRefNo...", @autocomplete = "off", maxlength = "40" })
                        </div>
                        <div class="col-sm-2">
                            <input class="btn bun-bg btn-default" type="submit" name="Command" value="Search" id="Search" />
                        </div>

                        @* Hidden Fields *@
                        @Html.HiddenFor(model => model.PersonalRowID, new { @id = "HfPersonalRowID" })
                        @Html.HiddenFor(model => model.ClientRowId, new { @id = "HfClientRowId" })
                        @Html.HiddenFor(model => model.approveStatus, new { @id = "HfapproveStatus" })
                    </div>

                    @* --- Check Details Section (Custom Checkbox List) --- *@
                    <div class="form-group branch row search-frame">
                        <label class="col-sm-2 control-label">Check Details :</label>
                        <div class="col-sm-3">
                            <div id="dvCheckStatus" class="scrollable-checkbox-list">
                                @if (ViewBag.chek != null)
                                {
                                    foreach (var item in ViewBag.chek)
                                    {
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox"
                                                       name="aSubCheckRowID"
                                                       value="@item.SubCheckRowID"
                                                       class="check-status-checkbox"
                                                       id="chk_@item.SubCheckRowID" />
                                                @item.SubCheckName
                                            </label>
                                        </div>
                                    }
                                }
                                @* This hidden field will be populated by JavaScript with comma-separated IDs *@
                                @Html.HiddenFor(model => model.aSubCheckRowIDMultiple, new { @id = "aSubCheckRowIDMultiple" })
                            </div>
                        </div>
                        @* Empty column for alignment/spacing if needed: <div class="col-sm-7"></div> *@
                    </div>

                    @* --- Billing Status Section --- *@
                    <div class="form-group branch row search-frame">
                        <label class="col-sm-2 control-label">Billing Status :</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(model => model.BillingStatus, new List<SelectListItem>(){
                                new SelectListItem{Text="-- Select --", Value="-- Select --", Selected = true},
                                new SelectListItem{Text="Billable", Value="Billable"},
                                new SelectListItem{Text="Not Billable", Value="Not Billable"}
                            }, new { @class = "form-control", @id = "ddlBillable" })
                        </div>
                        <div class="col-sm-7">
                            @* Action button spot - currently empty in original, but space reserved by layout *@
                        </div>
                    </div>

                    @* --- Action Remarks Section --- *@
                    <div class="form-group branch row search-frame">
                        <label class="col-sm-2 control-label">Action Remarks :</label>
                        <div class="col-sm-8">
                            @Html.TextAreaFor(model => model.Remark, new
                            {
                                @class = "form-control",
                                @id = "TextBoxMode",
                                placeholder = "Enter Remarks...",
                                style = "height:80px; resize:vertical;", /* Increased height and allowed vertical resize */
                                @autocomplete = "off",
                                maxlength = "200"
                            })
                            @* Using TextAreaFor instead of TextBoxFor for multiline input, adjust height in style *
                                @* The original used TextBoxFor with height:60px, TextAreaFor is more semantic here *@
                        </div>
                    </div>

                    @* --- Attachment Section --- *@
                    <div class="form-group branch row search-frame">
                        <label class="col-sm-2 control-label">Attachment :</label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.UploadDoc, new
                            {
                                @id = "UploadAddressDoc",
                                @accept = "image/gif, image/jpeg, image/png, image/jpg, .doc, .docx, .xls, .xlsx, .pdf, .rtf, .txt, .eml, .email, .msg, .zip, .rar",
                                type = "file",
                                multiple = "multiple",
                                @class = "form-control",
                                onchange = "return fileValidation(this)"
                            })
                            <span class="help-block">Allowed extensions: .gif, .doc, .docx, .xls, .xlsx, .pdf, .rtf, .txt, .jpeg, .jpg, .png, .eml, .email, .msg, .zip, .rar</span>
                        </div>
                    </div>

                    @* --- Submit Button Section --- *@
                    <div class="form-group all-button-bg">
                        <div class="col-sm-offset-2 col-sm-10">
                            <input class="btn bun-bg btn-lg" type="submit" name="Command" value="Submit" id="btnSubmit" />
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</div>

