@using WebAppBGV.CommonMethods;
@{
    /**/
    Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";
    var ClientRowId = "0";
    var clid = "";
    if (Request.QueryString["ClientRowID"] != null)
    {
        ClientRowId = Request.QueryString["ClientRowID"].ToString();
    }
    clid = Session["ClientRowID"].ToString();
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "DashboardClient", "Home", new { area = "ClientArea" }, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

}
@{

    string tatHours1 = "";
    string CaseStatus1 = "";
    string AllocatedToTL1 = "";
    if (Request.QueryString["tatHours"] != null)
    {
        tatHours1 = Request.QueryString["tatHours"].ToString();
    }
    if (Request.QueryString["AllocatedToTL"] != null)
    {
        AllocatedToTL1 = Request.QueryString["AllocatedToTL"].ToString();
    }
    if (Request.QueryString["CaseStatus"] != null)
    {
        CaseStatus1 = @Request.QueryString["CaseStatus"].ToString();
    }
    string faIconExportExcel = string.Format("<i class='fa fa-file-excel-o' aria-hidden='true'></i> Export Excel");
    string hyperLinkExportExcel = "";
    if (CaseStatus1 == "ReportReceived")
    {
        if (ViewBag.FinalReportRights == true)
        {
            hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportCandidateArea", "Home", new { ClientRowID = ClientRowId }, new { @class = "export-btn_Candidatesearch edit-candidate-btn", style = "display:none;" }).ToString();

        }
        else
        {
            hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportCandidateArea", "Home", new { ClientRowID = ClientRowId }, new { @class = "export-btn_Candidatesearch edit-candidate-btn" }).ToString();

        }
    }
    else if (CaseStatus1 == "CRCReports")
    {
        hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportCandidateArea1", "Home", new { ClientRowID = ClientRowId }, new { @class = "export-btn_Candidatesearch edit-candidate-btn" }).ToString();
    }
    else if (CaseStatus1 == "Pendingcandidate")
    {
        hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportPendingcandidate", "Home", new { ClientRowID = ClientRowId }, new { @class = "export-btn_Candidatesearch edit-candidate-btn" }).ToString();

    }
    else if (CaseStatus1 == "Insufficiency")
    {
        hyperLinkExportExcel = Html.ActionLink("linkTitle", "ExportInsufficency", "Home", new { ClientRowID = ClientRowId }, new { @class = "export-btn_Candidatesearch edit-candidate-btn" }).ToString();

    }


    ViewBag.NavigationBtnExportExcel = new HtmlString(hyperLinkExportExcel.ToString().Replace("linkTitle", faIconExportExcel));

    if (CaseStatus1 == "ReportReceivedInterim")
    {
        ViewBag.Title = "Download Interim Report";
    }
    else if (CaseStatus1 == "AutoGallagherInterims")
    {
        ViewBag.Title = "4 checks Interim Report";
    }
    else if (CaseStatus1 == "GallagherSecondInterims")
    {
        ViewBag.Title = "2nd Interim Report";
    }
    else if (CaseStatus1 == "SupplymentryGallagher")
    {
        ViewBag.Title = "Supplementary/2nd Interim Reports";
    }
    else
    {
        ViewBag.Title = "Download Final Report";
    }
}

