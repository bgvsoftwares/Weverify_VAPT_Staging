        function fnUpdateActiveStatus(personalId, status) {
            $.ajax({
                url: '@Url.Action("UpdateActiveStatus", "Home", new { area = "ClientArea" })',
                type: 'POST',
                data: {
                    PersonalRowID: personalId,
                    Status: status
                },
                success: function (res) {
                    if (res.success) {
                        alert("Status updated successfully.");
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Request failed");
                }
            });
}
    </script>
    <script type="text/javascript">
        $(document).on('click', '.export-btn_Candidatesearch', function () {
            // select by NAME, because the ids of the From/To inputs are swapped in the markup
            var from = $('input[name="RecievingfromDate"]').val() || '';
            var to = $('input[name="RecievingToDate"]').val() || '';
            var url = new URL(this.href, window.location.origin);
            url.searchParams.set('RecievingfromDate', from);
            url.searchParams.set('RecievingToDate', to);
            this.href = url.toString();
        });
    </script>
