@{
    ViewBag.Title = "Manage Upload Documents For HR Approval";
    Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "ManageClientHrApprovalCases", "Home", new { area = "ClientArea" }, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@*@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }*@
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManageUploadDocForHRApproval", "Home", FormMethod.Get))
                        {

                                <div class="form-horizontal">
                                    <div class="form-group branch search-frame">
                                        <label class="col-md-2 control-label">Keyword :</label>
                                        <div class="col-md-8">
                                            @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name..." })
                                        </div>
                                    </div>
                                    <div class="form-group branch search-frame">
                                        <div style="text-align:center;">
                                            <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                        </div>
                                    </div>
                                </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.ClientUploadDocInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.ClientUploadDocInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"col-md-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(header: "Check Name", format: (item) =>string.IsNullOrEmpty(item.SubCheckName) ? "Case Document" : item.SubCheckName, canSort: false,style:"col-md-2"),
                                    grid.Column(columnName: "DocumentUploadFrom", header: "Upload-From", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "DocumentType", header: "Document Type", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "FileName", header: "File Name", canSort: false, style:"col-md-1"),
                                     grid.Column("Documents", canSort: false, format: (item) => {
                                        string FldPathDoc = System.Configuration.ConfigurationManager.AppSettings["provideddocuments"].ToString();
                                        string DownloadLink = string.Empty;
                                        if (item.FileName != null)
                                        {
                                            DownloadLink = string.Format("<a href=\"{0}\" target=\"_blank\">Download</a>", Url.Content(FldPathDoc + item.FileName));
                                        }
                                       return new HtmlString(DownloadLink);
                                    }, style: "delete col-md-2"),

                                    grid.Column(header : "Documents", format : (item) => {
                                        var link = Html.ActionLink("Upload", "UploadCandidateDocumentByHR", "Home", new { id = item.VerifiedUploadRowID, pid=item.PersonalRowID, SubCheckRowID=item.SubCheckRowID, FileName=item.FileName}, null);
                                        return link;
                                    }, style:"edit col-md-1"),



                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script>
        $(document).ready(function () {
            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "60%", height: "60%" });
            $(".callbacks").colorbox({
                //onOpen: function () { alert('onOpen: colorbox is about to open'); },
                //onLoad: function () { alert('onLoad: colorbox has started to load the targeted content'); },
                //onComplete: function () { alert('onComplete: colorbox has displayed the loaded content'); },
                //onCleanup: function () { alert('onCleanup: colorbox has begun the close process'); },
                onClosed: function () {
                    //alert('onClosed: colorbox has completely closed');
                    window.location.reload(false);
                }
            });

            $(".iframeActionHistories").colorbox({ iframe: true, width: "80%", height: "65%" });
            //$(".callbacks").colorbox({
            //    onClosed: function () {
            //        window.location.reload(false);
            //    }
            //});

            $('#RecievingToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#RecievingFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedToDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
            $('#CompletedFromDate').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                yearRange: "-66:+0",
            });
        });
    </script>
}


