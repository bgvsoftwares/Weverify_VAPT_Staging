

@{
    ViewBag.Title = "";
    Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid p-0">
    <div class="card-header white-text title_bg">
        <div class="d-flex">
            <div class="col-xl-6 col-lg-6 col-md-6 col-xm-12">
                <p class="text-white m-0">FAQ</p>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <div class="card overflow-hidden rounded-0 h-auto">
                <div class="card-header pb-0">
                    <h3 class="card-title">What is WeVerify ?</h3>
                    <p class="text-muted card-sub-title mb-0" style="color:#031F30!important;">
                        <span class="fw-bolder tx-16" style="color:#8D5FFF!important;">WeVerify</span> is an automated application, which supports the BGV process across the globe.It is a complete module for pre & post hire screening process. The application allows minimal paper work as well as minimal email communications for tracking the live status
                    </p>
                </div>
                <div class="card-body">
                    <div class="panel-group1" id="accordion11">
                        <div class="panel panel-default  mb-4">
                            <div class="panel-heading1 bg-primary ">
                                <h4 class="panel-title1">
                                    <a class="accordion-toggle collapsed" data-bs-toggle="collapse"
                                       data-bs-parent="#accordion11" href="#collapseFour1"
                                       aria-expanded="false">
                                        <i class="fe fe-arrow-right me-2"></i>Account & Log-in
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseFour1" class="panel-collapse collapse" role="tabpanel"
                                 aria-expanded="false">
                                <div class="panel-body border">
                                    <ol>
                                        <li>
                                            My Account is blocked. How do I unblock it?
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    Write to us at <a href="mailto:bgv.helpdesk@securitas-india.com;">bgv.helpdesk@securitas-india.com</a> to unblock your account.
                                                </li>
                                            </ul>
                                        </li>

                                        <li>
                                            Where do I get my PIN/Password in order to log in for the first time?
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    You'll receive your login details on your registered email.
                                                </li>
                                            </ul>
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>

                        <div class="panel panel-default mb-4">
                            <div class="panel-heading1  bg-primary">
                                <h4 class="panel-title1">
                                    <a class="accordion-toggle mb-0 collapsed" data-bs-toggle="collapse"
                                       data-bs-parent="#accordion11" href="#collapseFive2"
                                       aria-expanded="false">
                                        <i class="fe fe-arrow-right me-2"></i>System Configuration & Settings
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseFive2" class="panel-collapse collapse" role="tabpanel"
                                 aria-expanded="false">
                                <div class="panel-body border">
                                    <ol>
                                        <li>
                                            The link provided is not responding
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;"> Step 1: Check the network settings.</li>
                                                <li style="list-style-type:disc;"> Step 2: The application is on a secure platform with latest information security features, need to use</li>
                                            </ul>
                                        </li>

                                        <li>
                                            Mozilla Firefox & Google Chrome.
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    If same error still pertains, need to share screenshot to <a href="mailto:bgv.helpdesk@securitas-india.com;">bgv.helpdesk@securitas-india.com</a>, keeping client servicing SPOC in loop.
                                                </li>
                                            </ul>
                                        </li>

                                        <li>
                                            Application is accessible, however not responding while user is clicking on the dashboard links
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    User need to allow the pop-ups for all the functions of application to process smoothly. The links would direct user to applicable window/case count
                                                </li>
                                            </ul>
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>

                        <div class="panel panel-default mb-4">
                            <div class="panel-heading1  bg-primary">
                                <h4 class="panel-title1">
                                    <a class="accordion-toggle mb-0 collapsed" data-bs-toggle="collapse"
                                       data-bs-parent="#accordion11" href="#collapseFive3"
                                       aria-expanded="false">
                                        <i class="fe fe-arrow-right me-2"></i>Data Access & Security
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseFive3" class="panel-collapse collapse" role="tabpanel"
                                 aria-expanded="false">
                                <div class="panel-body border">
                                    <ol>
                                        <li>
                                            How is data security and access ensured?
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    WeVerify data is maintained across highly secure servers and access is provided to selected data. Access rights are enabled at each level to ensure complete security.
                                                </li>
                                            </ul>
                                        </li>

                                        <li>
                                            How do I add or change users in my account?
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">Step 1: Log in through your admin account</li>
                                                <li style="list-style-type:disc;">
                                                    Step 2: Click on Manager Users>>Add New User, enter branch details for identification along with User Id & Password.
                                                </li>
                                                <li style="list-style-type:disc;">For removing an existing user, click on radio button under header active</li>
                                                <li style="list-style-type:disc;">
                                                    If you need further help, write to us at <a href="mailto:bgv.helpdesk@securitas-india.com;">bgv.helpdesk@securitas-india.com</a>
                                                </li>
                                            </ul>
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>

                        <div class="panel panel-default mb-4">
                            <div class="panel-heading1  bg-primary">
                                <h4 class="panel-title1">
                                    <a class="accordion-toggle mb-0 collapsed" data-bs-toggle="collapse"
                                       data-bs-parent="#accordion11" href="#collapseFive4"
                                       aria-expanded="false">
                                        <i class="fe fe-arrow-right me-2"></i>  Size Limitation
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseFive4" class="panel-collapse collapse" role="tabpanel"
                                 aria-expanded="false">
                                <div class="panel-body border">
                                    <ol>
                                        <li>
                                            Are there any file/size limitations for documents being sent to Securitas?
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">Yes, our system does have some limitations.</li>
                                                <li style="list-style-type:disc;">
                                                    Securitas cannot accommodate files larger than “30MB”;
                                                </li>
                                                <li style="list-style-type:disc;">if documentation exceeds this size,the documents may need to be split into two or more transactions.</li>
                                            </ul>
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>


                        <div class="panel panel-default mb-4">
                            <div class="panel-heading1  bg-primary">
                                <h4 class="panel-title1">
                                    <a class="accordion-toggle mb-0 collapsed" data-bs-toggle="collapse"
                                       data-bs-parent="#accordion11" href="#collapseFive5"
                                       aria-expanded="false">
                                        <i class="fe fe-arrow-right me-2"></i>  New Case Registration
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseFive5" class="panel-collapse collapse" role="tabpanel"
                                 aria-expanded="false">
                                <div class="panel-body border">
                                    <ol>
                                        <li>
                                            How do I register a new case?
                                            <ol style="list-style-type:lower-roman;">
                                                <li>
                                                    There are three types of case initiation
                                                    <ul style="list-style-type:disc;" class="mb-2">
                                                        <li >Single Initiation.</li>
                                                        <li>Bulk Initiation.</li>
                                                        <li>Initiation by Candidate.</li>
                                                    </ul>
                                                </li>
                                                <li>For detailed step by step instructions, kindly refer the User Manual, Page Number 11.</li>
                                            </ol>
                                        </li>
                                        <li>
                                            I have the candidate's consent via a Letter of Authorization. Can I enter data on his/her behalf?
                                            <ul style="list-style-type:disc;" class="mb-2">
                                                <li>
                                                    Yes, as the authorized person from your organization, having LOA from the candidate, You can enter the candidate’s information on his/her behalf
                                                </li>
                                            </ul>
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>

                        <div class="panel panel-default mb-4">
                            <div class="panel-heading1  bg-primary">
                                <h4 class="panel-title1">
                                    <a class="accordion-toggle mb-0 collapsed" data-bs-toggle="collapse"
                                       data-bs-parent="#accordion11" href="#collapseFive6"
                                       aria-expanded="false">
                                        <i class="fe fe-arrow-right me-2"></i>    Dashboard
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseFive6" class="panel-collapse collapse" role="tabpanel"
                                 aria-expanded="false">
                                <div class="panel-body border">
                                    <ol>
                                        <li>
                                            <h5>
                                                The count of cases under “Report Received Final” bucket refers to which cases?
                                            </h5>
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    This bucket consists of list of cases whose verifications have been completed and report has been uploaded by Securitas for client’s reference.
                                                </li>
                                            </ul>
                                        </li>
                                        <li>
                                            <h5>
                                                The count of cases under “Total WIP” bucket refers to which cases?
                                            </h5>
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    It highlights the cases which are under process. Component wise status is available along with the color code if any of the check has been closed
                                                </li>
                                            </ul>
                                        </li>
                                        <li>
                                            <h5>
                                                What are the “Pending with candidate” cases?
                                            </h5>
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    Cases initiated under the category “Initiated by candidate” are reflected in the client’s bucket, where the candidate is yet to submit the details
                                                </li>
                                            </ul>
                                        </li>
                                        <li>
                                            <h5>
                                                What is difference between an Insufficiency, YTR & Funds approval?
                                            </h5>
                                            <ul class="mb-2">
                                                <li style="list-style-type:none;">
                                                    <h5>We have these as three different buckets for specific reasons</h5>
                                                </li>
                                                <li style="list-style-type:disc;">
                                                    The count of cases under Insufficiency are referred to those cases wherein any specific document or information is required.
                                                </li>
                                                <li style="list-style-type:disc;">
                                                    Further, cases tagged as YTR are for the candidates who are yet to be released from their current organisation or the DOL has been mentioned as till date, not mentioned or date mentioned by candidate is yet to come.
                                                </li>
                                                <li style="list-style-type:disc;">
                                                    For cases wherein extra amount is required by the verification source are notified under funds approval bucket.
                                                </li>
                                                <li style="list-style-type:disc;">
                                                    We are required to provide document/Information for Insufficient Cases, Go-ahead for YTR & Funds approval cases.
                                                </li>
                                            </ul>
                                        </li>
                                        <li>
                                            <h5>
                                                What is Case Approval?
                                            </h5>
                                            <ul class="mb-2">
                                                <li style="list-style-type:disc;">
                                                    Cases initiated by Client-User or under the category “Initiated by candidate” have been submitted by the candidate, we need to approve these from our log-in, so as to share the cases for verification to Securitas.
                                                </li>
                                            </ul>
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>


                        <div class="panel panel-default mb-4">
                            <div class="panel-heading1  bg-primary">
                                <h4 class="panel-title1">
                                    <a class="accordion-toggle mb-0 collapsed" data-bs-toggle="collapse"
                                       data-bs-parent="#accordion11" href="#collapseFive7"
                                       aria-expanded="false">
                                        <i class="fe fe-arrow-right me-2"></i>     Acronyms & Abbreviations
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseFive7" class="panel-collapse collapse" role="tabpanel"
                                 aria-expanded="false">
                                <div class="panel-body border">
                                    <table class="table mb-0 text-md-nowrap fl-table js-serial">
                                        <thead>
                                            <tr>
                                                <th>Abbreviation</th>
                                                <th>Meaning</th>
                                            </tr>
                                        </thead>
                                        <tbody border="1">
                                            <tr>
                                                <td>BGV</td>
                                                <td>Background Verification</td>
                                            </tr>
                                            <tr>
                                                <td>BVF</td>
                                                <td>Background Verifications Form</td>
                                            </tr>
                                            <tr>
                                                <td>INF</td>
                                                <td>Insufficiency</td>
                                            </tr>
                                            <tr>
                                                <td>RWQC</td>
                                                <td>Report Writing and quality Check</td>
                                            </tr>
                                            <tr>
                                                <td>SPOC</td>
                                                <td>Single point of Contact</td>
                                            </tr>
                                            <tr>
                                                <td>LOA</td>
                                                <td>Letter of Authorizations</td>
                                            </tr>
                                            <tr>
                                                <td>YTR</td>
                                                <td>Yet to Release</td>
                                            </tr>
                                            <tr>
                                                <td>PV</td>
                                                <td>Physical Visit</td>
                                            </tr>
                                            <tr>
                                                <td>DOJ/DOL</td>
                                                <td>Date of Joining / Leaving</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer pb-0 p-3">
                    <h6 class="card-title tx-15 tx-normal">If any query is unanswered or is not covered in the above FAQ, kindly click on the below mentioned link and submit. Team Securitas will revert you shortly</h6>
                </div>
            </div>
        </div>
    </div>
</div>
