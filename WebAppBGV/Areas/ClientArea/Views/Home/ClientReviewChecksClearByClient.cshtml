@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script src="~/Scripts/normalizePlugin.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#DOL').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+00",
            });
        });

        function fileValidation(fileInput) {
            debugger;
            //var fileInput = document.getElementById('file');
            var filePath = fileInput.value;
            var allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif|\.pdf\.JPG|\.JPEG|\.PNG|\.GIF|\.PDF)$/i;
            if (!allowedExtensions.exec(filePath)) {
                swal.fire('Please upload file having extensions .jpeg/.jpg/.png/.gif/.pdf only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }
        function validateForm() {
            var Remarks = $("#Remarks");
            if (Remarks.val() == "") {
                //If the "Please Select" option is selected display error.
                swal.fire("Please Fill Remarks !");
                return false;
            }
        }

        $("#EmployeeID").AlphaNumericWithMinus();
        $("#Remarks").RemarksString();

    </script>
