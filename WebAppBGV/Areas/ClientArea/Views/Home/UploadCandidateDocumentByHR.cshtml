@*@using ViewModels.ProvidedInfoViewModel;*@
@model ViewModels.TempViewModel.AddUploadDocByHRViewModel
    @{
        ViewBag.Title = "Upload New Document";
        Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";

        string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
        string hyperLink = Html.ActionLink("linkTitle", "ManageUploadDocmentList", "Home", new { area = "ClientArea", pid = Model.PersonalRowID }, new { @class = "headerbacklink" }).ToString();
        ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@*@section LeftNavigation{ @Html.Partial("_NavLeftCandidateCaseInfoProvided") }*@
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("UploadCandidateDocumentByHr", "Home", new {Ares= "ClientArea" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.SubCheckRowID)
            @Html.HiddenFor(model => model.VerifiedUploadRowID)
            @Html.HiddenFor(model => model.FileName)
            <div class="form-horizontal">
                @*<div class="form-group branch">
                    @Html.LabelFor(model => model.SubCheckRowID, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-4">
                        @Html.DropDownListFor(model => model.SubCheckRowID,
                       new SelectList(ViewBag.CheckList, "SubCheckRowID", "SubCheckName"),
                              "- Select Check -", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.SubCheckRowID, "", new { @class = "text-danger" })
                    </div>
                </div>*@
                <div class="form-group branch">
                    <div id="dvUplodDoc" class="">
                    </div>
                </div>
                @Html.Hidden("UploadHid", null)
                <div class="form-group branch">
                    @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "2" })
                    </div>
                </div>
                <div class="all-button-bg">
                    <input class="btn bun-bg btn-default" type="submit" value="Submit" />
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <script>

        $(document).ready(function () {
            var url1 = "/ProvidedInfo/GetDocumentTypeListBySubCheckID/" + $("#SubCheckRowID").val();
            $.ajax({
                url: url1,
                type: 'GET',
                async: false,
                dataType: 'json',
                success: function (allData) {
                    if (allData != null && allData != "") {
                        $('#dvChksPcks').show();
                        var items = '';
                        jQuery.each(allData, function (index, allData) {

                            items += "<div  class='col-md-8'><label class='col-md-3 branchname control-label'>" + allData.Text + " :</label><input type='checkbox' name='chkPkgChks'  value=" + allData.Value + " class='col-md-1'/><div class='col-md-2'><input data-val='true' name='UploadDoc' disabled='true' type='file' value=" + allData.Value + "  id=" + allData.Value + "> </div></div>";
                            });
                        $('#dvUplodDoc').html(items);
                    }
                    else {
                        $('#dvChksPcks').hide();
                        alert("No Doc Selected");
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert("some error");
                }
            });
        });

        $(document).on('change', 'input[name="chkPkgChks"]', function (e) {// on change of state
            var chkPkgChkss = '';
            $('input[name="chkPkgChks"]').each(function (index, value) {
                if (this.checked) {
                    chkPkgChkss += this.value + ',';
                    $("#" + this.value + "").removeAttr("disabled");
                }
                else {
                    $("#" + this.value + "").attr("disabled", "disabled");
                }
            });

            if (chkPkgChkss.length > 0) {
                chkPkgChkss = chkPkgChkss.substring(0, chkPkgChkss.length - 1);
            } else { chkPkgChkss = ''; }
            $('#UploadHid').val(chkPkgChkss.trim());
        });
    </script>
}
