@model dynamic
@{

    Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";
}



@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<link href="~/Content/MultiselectcNew.css" rel="stylesheet" type="text/css" />
<link href="~/MultiSelection/docs/css/prettify.css" rel="stylesheet" />
<link rel="stylesheet" href="~/MultiSelection/dist/css/bootstrap-multiselect.css" type="text/css">
<style>

    .btn-group {
        background-color: white;
    }

    @@media (min-width: 768px) {
        .checkselect-checkbox {
            max-width: 100%;
        }
    }

    .checkselect-checkbox {
        text-align: left !important;
    }

    #dvchkChecks {
        height: 250px !important;
        overflow-x: hidden !important;
        overflow-y: auto;
    }

    #SearchValue {
        /*height: 450px !important;*/
        border: 1px solid #000 !important;
    }

    #dvchkChecks::-webkit-scrollbar {
        width: 10px;
    }

    #dvchkChecks::-webkit-scrollbar-track {
        background: rgb(179, 177, 177);
        border-radius: 10px;
    }

    #dvchkChecks::-webkit-scrollbar-thumb {
        background: rgba(188,188,188,0.5);
        border-radius: 10px;
    }

        #dvchkChecks::-webkit-scrollbar-thumb:hover {
            background: rgb(100, 100, 100);
            border-radius: 10px;
        }

        #dvchkChecks::-webkit-scrollbar-thumb:active {
            background: rgb(68, 68, 68);
            border-radius: 10px;
        }
</style>

<div class="row">
    <div class="col-lg-12 col-md-12" style="background:#EAEAEA!important;">
        @using (Html.BeginForm("AddCandidateCheck", "Home", new { area = "ClientArea" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="card" style="height:auto!important;box-shadow: none; border-radius: 0px; background:#EAEAEA!important;">
                <div class="card-body">
                    <div class="main-content-label mg-b-5 d-flex mb-3" style="line-height:20px;">
                        <div class="me-1 fw-bolder">
                            <b>Note:</b>
                        </div>
                        <div class="fs-10">
                            <span class="fw-bolder">
                                Write the reference no in the below textbox and press submit after selected required check.
                            </span>
                        </div>
                    </div>
                    <div class="row row-xs align-items-center mg-b-20">
                        <div class="col-md-4">
                            <input class="form-control fldRefID" type="text" id="SearchValue" name="SearchValue" value="@ViewBag.CompanyRefNo" placeholder="Type Securitas ID..." />
                            <input type="hidden" id="CandidateCheck" name="CandidateCheck" value="" />
                        </div>
                        <div class="col-md-2">
                            <label class="control-label">select Checks</label>
                        </div>
                        <div class="col-md-6">
                            @Html.DropDownList("SubCheckRowID", new SelectList(ViewBag.SubCheckList, "SubCheckRowID", "SubCheckName"),
                                  new { @class = "form-control", @id = "SubCheckRowID", @multiple = "multiple", @size = "3" })
                        </div>

                    </div>
                    <div class="row row-xs align-items-center mg-b-20">
                        <div class="col-md-2">
                            <label class="control-label">Is send Invite to Candidate</label>
                        </div>
                        <div class="col-md-2">
                            @*@Html.CheckBox("sendInvite",true, new { @class = "form-Control " })*@
                            <input checked="checked" class="form-Control " id="sendInvite" name="sendInvite" type="checkbox" value="true">
                        </div>
                        <div class="col-md-2">
                            <label class="control-label">Candidate type</label>
                        </div>
                        <div class="col-md-5">
                            @Html.DropDownList("CandidateType", new SelectList(ViewBag.CandidateTypeList, "Value", "Text"),
                           "-- Select Type -- ", new { @class = "form-control" })
                        </div>

                    </div>


                    <div class="row row-xs align-items-center mg-b-20 justify-content-center">
                        <div class="col-md-2 mg-t-5 mg-md-t-0">
                            <input class="submit-btn btn-block rounded-0" type="submit" value="Search" id="btnSearch" name="Action" />
                        </div>
                        <div class="col-md-2 mg-t-5 mg-md-t-0">
                            <input class="submit-btn btn-block rounded-0" type="submit" value="Submit" id="btnSubmit" name="Action" />
                        </div>
                    </div>
                </div>

                <div>

                    <table class="table mb-0 js-serial table-striped m-auto" style="border:none; cursor:grab;">
                        <thead>
                            <tr>
                                <th class="top-head">Securitas ID </th>
                                <th class="top-head">Candidate Name</th>
                                <th class="top-head">Check Name</th>
                                <th class="top-head">Check Status</th>
                                <th class="top-head">Color Name</th>
                                <th class="top-head">Order Date</th>

                            </tr>
                        </thead>
                        @if (Model != null && Model.ClientServiceChecks != null)
                        {
                            <tbody class="text-start tx-12">
                                @foreach (var a in Model.ClientServiceChecks)
                                {
                                    <tr>
                                        <td class="name">@a.SecuritasID</td>
                                        <td class="name">@a.Name</td>
                                        <td class="name">@a.CheckName</td>
                                        <td class="name">@a.CheckStatus</td>
                                        <td class="name">@a.ColorName</td>
                                        <td class="name">@a.OrderDate</td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>

                </div>
            </div>

        }
    </div>
</div>



@section Scripts{
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    @*<script type="text/javascript" src="~/MultiSelection/docs/js/jquery-2.1.3.min.js"></script>*@
    <script type="text/javascript" src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/MultiSelection/dist/js/popper.min.js"></script>
    <script type="text/javascript" src="~/MultiSelection/docs/js/bootstrap-3.3.2.min.js"></script>
    <script type="text/javascript" src="~/MultiSelection/docs/js/prettify.min.js"></script>
    <script type="text/javascript" src="~/MultiSelection/dist/js/bootstrap-multiselect.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#SubCheckRowID').multiselect({
                enableFiltering: true,
                enableCaseInsensitiveFiltering: true,
                buttonWidth: '100%',
                maxHeight: 250,
                numberDisplayed: 1,

            });

            $("#SubCheckRowID").change(function () {
                var ptn = $("#SubCheckRowID").val() || "0";;
                if (ptn == "0") {
                    $(".multiselect-selected-text").html('None selected');
                }

            });

        });
    </script>
    <script type="text/javascript">



        if ('@ViewBag.ErrorMsg' != '') {
             Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">@ViewBag.ErrorMsg</div>'
                });
        }
    </script>
    <script type="text/javascript">
        $(document).ready(function () {

            if ('@ViewBag.Message' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Success',
                    html: '<div class="errormsg" style="text-align:center;">@ViewBag.Message</div>'
                });
            }
        });


        $(document).on('change', 'input[class="chkPkgChks"]', function (e) {
            var selectedIds = '';
            $('input[class="chkPkgChks"]').each(function (index, value) {
                if (this.checked) { selectedIds += this.value + ','; }
            });
            if (selectedIds.length > 0) {
                selectedIds = selectedIds.substring(0, selectedIds.length - 1);
            } else { selectedIds = ''; }

            $('#CandidateCheck').val(selectedIds.trim());
        });

        $(".fldRefID").on("input", function () {
            var regexp = /[^a-zA-Z0-9-\s]/g;
            if ($(this).val().match(regexp)) {
                $(this).val($(this).val().replace(regexp, ''));
            }
        });

        $("#btnSubmit").click(function () {
            var sv = $("#SearchValue").val();
            if (sv == '') {
                   Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">Please Type Securitas ID</div>'
                });
                return false;
            }
            var chk = $('#SubCheckRowID').val();
            if (chk.length <= 0) {
                Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">Please Select atleat one check</div>'
                });
                return false;
            }


        });

    </script>
    <script>
        function myFunction() {
            var input, filter, ul, li, a, i, txtValue;
            input = document.getElementById("myInput");
            filter = input.value.toUpperCase();
            ul = document.getElementById("dvchkChecks");
            li = ul.getElementsByTagName("li");
            for (i = 0; i < li.length; i++) {
                a = li[i].getElementsByTagName("a")[0];
                txtValue = a.textContent || a.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    li[i].style.display = "";
                } else {
                    li[i].style.display = "none";
                }
            }
        }
    </script>
}

