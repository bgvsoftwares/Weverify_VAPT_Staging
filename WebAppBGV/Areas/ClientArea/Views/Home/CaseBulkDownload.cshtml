
@{

    Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";
}
@{
    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "DashboardClient", "Home", new { area = "ClientArea" }, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@*@section DisplayTitle{ @Html.Partial("_DisplayTitle") }*@
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="card-header white-text title_bg" style=" background: #42638C !important;
        border-radius: 0px !important;
        margin: 0px !important;
        padding: 15px !important;
        font-weight: 600;
        font-size: 1rem;">
    <div class="d-flex">
        <div class="col-xl-6 col-lg-6 col-md-6 col-xm-12">
            <p class="text-white m-0">Bulk Upload</p>
        </div>
        <div class="col-xl-6 col-lg-6 col-md-6 col-xm-12 text-end">
            <p class="text-white m-0 text-white"> @ViewBag.TitleBackBtn</p>
        </div>
    </div>
</div>
<div class="container-fluid form_container">
    <div class="row">
        <div class="col-lg-12 col-md-12 ps-2">


            @using (Html.BeginForm("CaseBulkDownload", "Home", new { area = "ClientArea" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="main-content-label mg-b-5 d-flex" style="line-height:20px;">
                    <div class="fs-9 p-3">
                        <span class="fw-normal">
                            <b>Note:</b> write the reference no in the below textbox and press the relevant download button.
                        </span><br />
                        <span class="fw-normal" style="color:#8D5FFF!important;">`only 25 items can be downloaded in a single request`</span>
                    </div>
                </div>
                <div class="row row-xs align-items-center mg-b-20">
                    <div class="col-md-2" style="max-width: 14.667%!important;">
                        <label class="form-label mg-b-0 fw-bolder">Case Ref ID :</label>
                    </div>
                    <div class="col-md-8 mg-t-5 mg-md-t-0" style="padding: 15px 0px 0px 0px;">
                        @Html.TextArea("SearchValue", null, new { @class = "form-control", placeholder = "Type Securitas ID  ", @rows = "10" })
                    </div>
                </div>
                <div class="row row-xs align-items-center mg-b-20 justify-content-center">
                    <div class="col-md-2 mg-t-5 mg-md-t-0">
                        <input class="submit-btn btn-block rounded-0" type="submit" value="Bulk Download" id="btnSubmit" />
                    </div>
                    @if (Convert.ToInt16(Session["ClientRowID"]) == 1071)
                    {
                        <div class="col-md-2 mg-t-5 mg-md-t-0" style="margin-left: 10px;">
                            <input class="submit-btn btn-block rounded-0" type="submit" value="Bulk LOA Download"
                                   formaction="@Url.Action("BulkLOADownload", "Home", new { area = "ClientArea" })" />
                        </div>
                    }
                </div>
            }
