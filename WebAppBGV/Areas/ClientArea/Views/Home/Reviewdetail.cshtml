@model ViewModels.ClientViewModel.ClientDashBoardTableModel
@{
    int i = 0;
    int j = 0;
    int clid = ViewBag.clientrowid != null ? ViewBag.clientrowid : 0;
}

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="flex-grow-1">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-filter"></i> Filter Dashboard</h5>
                </div>


                @if (clid == 987)
                {
                    <div style="min-width: 150px;">
                        <select id="filterClientRowId" class="form-select">
                            <option value="">All Clients</option>
                            @if (ViewBag.ClientList != null)
                            {
                                foreach (var client in ViewBag.ClientList)
                                {
                                    <option value="@client.ClientRowID.ToString()" @(ViewBag.SelectedClient == client.ClientRowID.ToString() ? "selected" : "")>
                                        @client.ClientName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                }




                <!-- Month Dropdown -->
                <div style="min-width: 150px;">
                    <select id="filterMonth" class="form-select">
                        <option value="All Months" @(ViewBag.SelectedMonth == "All Months" ? "selected" : "")>
                            All Months
                        </option>
                        <option value="January" @(ViewBag.SelectedMonth == "January" ? "selected" : "")>January</option>
                        <option value="February" @(ViewBag.SelectedMonth == "February" ? "selected" : "")>February</option>
                        <option value="March" @(ViewBag.SelectedMonth == "March" ? "selected" : "")>March</option>
                        <option value="April" @(ViewBag.SelectedMonth == "April" ? "selected" : "")>April</option>
                        <option value="May" @(ViewBag.SelectedMonth == "May" ? "selected" : "")>May</option>
                        <option value="June" @(ViewBag.SelectedMonth == "June" ? "selected" : "")>June</option>
                        <option value="July" @(ViewBag.SelectedMonth == "July" ? "selected" : "")>July</option>
                        <option value="August" @(ViewBag.SelectedMonth == "August" ? "selected" : "")>August</option>
                        <option value="September" @(ViewBag.SelectedMonth == "September" ? "selected" : "")>September</option>
                        <option value="October" @(ViewBag.SelectedMonth == "October" ? "selected" : "")>October</option>
                        <option value="November" @(ViewBag.SelectedMonth == "November" ? "selected" : "")>November</option>
                        <option value="December" @(ViewBag.SelectedMonth == "December" ? "selected" : "")>December</option>
                    </select>
                </div>

                <!-- Year Dropdown -->
                <div style="min-width: 120px;">
                    <select id="filterYear" class="form-select">
                        <option value="All Years" @(ViewBag.SelectedYear == "All Years" ? "selected" : "")>
                            All Years
                        </option>
                        @for (int year = DateTime.Now.Year; year >= 2026; year--)
                        {
                            <option value="@year"
                                    @(ViewBag.SelectedYear == year.ToString() ? "selected" : "")>
                                @year
                            </option>
                        }
                    </select>
                </div>

                <button type="button" class="btn btn-primary px-4" id="btnFilter">
                    Apply Filter
                </button>

                @*<button class="btn btn-primary px-4" id="btnFilter">Apply Filter</button>*@
                @*<a href="@Url.Action("YourActionName", "YourControllerName")" class="btn btn-outline-secondary">Reset</a>*@
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-4 bg-light">
    <div class="row">

        @if (Model.ClientDashBoardTable != null)
        {
            <div class="container-fluid ps-0 mt-3 pb-3" style="margin-bottom:2rem;">
                <table class="table table-bordered  table-striped align-middle shadow-sm border border-dark">
                    <thead class="table-secondary text-center border-dark" style="font-size:13px">
                        <tr>
                            <th class="border border-dark">Client Status</th>
                            <th class="border border-dark">1-5 Days</th>
                            <th class="border border-dark">6-10 Days</th>
                            <th class="border border-dark">11-15 Days</th>
                            <th class="border border-dark">16-20 Days</th>
                            <th class="border border-dark">20+ Days</th>
                            <th class="border border-dark">Grand Total</th>
                        </tr>
                    </thead>

                    <tbody class="text-center">
                        @foreach (var item1 in Model.ClientDashBoardTable)
                        {

                            <tr>
                                <td class="border border-dark">@item1.ClientStatus</td>
                                <td class="border border-dark" style="text-align: center !important;">@item1.fiveDays</td>
                                <td class="border border-dark" style="text-align: center !important;">@item1.tenDays</td>
                                <td class="border border-dark" style="text-align: center !important;">@item1.fifteenDays</td>
                                <td class="border border-dark" style="text-align: center !important;">@item1.twentyDays</td>
                                <td class="border border-dark" style="text-align: center !important;">@item1.twentyplusDays</td>                        
                                <td class="border border-dark" style="text-align: center !important;">
                                    @{
                                        string caseStatus = "";
                                        switch (item1.ClientStatus)
                                        {
                                            case "Completed":
                                                caseStatus = "ReportReceivedCompleted";
                                                break;

                                            case "Interim Report":
                                                caseStatus = "ReportReceivedInterim";
                                                break;

                                            case "Stop":
                                                caseStatus = "Stop";
                                                break;

                                            case "WIP":
                                                caseStatus = "WIP";
                                                break;

                                            case "YTR Pending (Interim)":
                                                caseStatus = "YTR";
                                                break;

                                            case "1st Interim Report":
                                                caseStatus = "InterimReportCRC";
                                                break;

                                            case "Grand Total":
                                                caseStatus = "";
                                                break;

                                            default:
                                                caseStatus = item1.ClientStatus;
                                                break;
                                        }
                                    }

                                    @if (string.IsNullOrEmpty(caseStatus))
                                    {
                                        @item1.Total
                                    }

                                    else if (caseStatus == "YTR")
                                    {
                                        <a target="_blank"
                                           href="@Url.Action("ManageClientYTRCases","Home",
            new
            {
                area = "ClientArea",
                CheckStatus = "YTR",
                   ClientRowId = (clid == 987 && ViewBag.SelectedClient != null && Convert.ToString(ViewBag.SelectedClient) != "") 
           ? Convert.ToString(WebAppBGV.CommonMethods.clsCommonMethods.PEncrypt(ViewBag.SelectedClient)) 
           : ""
            })">
                                            @item1.Total
                                        </a>
                                    }
            else if (caseStatus == "WIP")
                                    {
                                        <a target="_blank"
                                           href="@Url.Content("~/ClientArea")">
                                            @item1.Total
                                        </a>
                                    }
                                    else
                                    {
             <a target="_blank"
             href="@Url.Action("GetClientCasesDashBoardInfo",
            "Home",new{area = "ClientArea",CaseStatus = caseStatus,
            
              ClientRowId = (clid == 987 && ViewBag.SelectedClient != null && Convert.ToString(ViewBag.SelectedClient) != "") 
                      ? Convert.ToString(WebAppBGV.CommonMethods.clsCommonMethods.PEncrypt(ViewBag.SelectedClient)) 
                      : ""
            
            
            })">
             @item1.Total  </a>   }
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="col-xl-8 col-lg-7 mb-4">
            @if (Model.DashBoardColorCodeCount != null)
            {
                <div class="container-fluid ps-0 mt-1 pb-4" >
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-bordered bg-white table-striped align-middle shadow-sm border border-dark">
                                <thead class="table-secondary text-center border-dark" style="font-size:13px">
                                    <tr>
                                        <th class="border border-dark">Sl.No.</th>
                                        <th class="border border-dark">Colour</th>
                                        <th class="border border-dark">Count</th>
                                     </tr>
                                </thead>
                                <tbody class="text-center">
                                    @foreach (var item3 in Model.DashBoardColorCodeCount)
                                    {
                                        <tr>
                                            <td class="border border-dark" style="text-align: center !important;">@Convert.ToString(++j)</td>
                                            <td class="border border-dark">@item3.CColorName</td>
                                            @*<td class="border border-dark" style="text-align: center !important;">@item3.CCount</td>*@
                                            <td class="border border-dark" style="text-align: center !important;">
                                                <a target="_blank"
