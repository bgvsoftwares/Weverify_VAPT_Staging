<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    // 1. DATA PARSING
    var chartData = @Html.Raw(ViewBag.ChartData ?? "[]");
    var rawFamilyData = @Html.Raw(ViewBag.ChartData1 ?? "[]");

    // Mapping for first 4 charts
    //const seriesValues = chartData.length >= 4 ? chartData.slice(0, 4).map(d => Number(d.Value)) : [30, 40, 35, 50];
    //const actionValues = chartData.length >= 8 ? chartData.slice(4, 8).map(d => Number(d.Value)) : [20, 15, 25, 10];

    const seriesValues = [
        Number(chartData[0] ?.Value || 0),
        Number(chartData[1] ?.Value || 0),
        Number(chartData[2] ?.Value || 0),
        Number(chartData[3] ?.Value || 0),
        Number(chartData[6] ?.Value || 0)
    ];
    const actionValues = [
        Number(chartData[4] ?.Value || 0),
        Number(chartData[5] ?.Value || 0),
        Number(chartData[7] ?.Value || 0)
    ];

    const statusLabels = ['Pending with Candidate', 'Case Approval Pending', 'WIP Status', 'Insufficiency', 'Fund Approval'];
    const actionLabels = ['Final Report', 'Interim Report', 'YTR'];

    // Mapping for Family Chart
    const familyLabels = rawFamilyData.flatMap(item => item.ChartData1.map(d => d.CheckFamilyName));
    const familyValues = rawFamilyData.flatMap(item => item.ChartData1.map(d => Number(d.CheckFamilyID) || 1));

    // Calculate percentages
    const total1 = seriesValues.reduce((a, b) => a + b, 0);
    const total = actionValues.reduce((a, b) => a + b, 0);
    const actionDataWithPercent = actionValues.map((val, i) => {
        const percent = total ? ((val / total) * 100).toFixed(1) : 0;
        return { x: actionLabels[i], y: val, dataLabels: `${val} (${percent}%)` };
    });

    // --- CHART 1: BAR ---
    //var barOptions = {
    //    series: [{ name: 'Total', data: seriesValues }],
    //    chart: { type: 'bar', height: 350, toolbar: { show: false } },
    //    grid: { show: false },
    //    plotOptions: { bar: { borderRadius: 6, distributed: true, columnWidth: '45%' } },
    //    xaxis: { categories: statusLabels },
    //    colors: ['#008FFB', '#00E396', '#FEB019', '#FF4560'],
    //    legend: { show: false }
    //};
    var barMax = Math.max(...seriesValues, 1);
    var barYAxisMax = Math.ceil(barMax * 1.30);

    var barOptions = {
        series: [{ name: 'Total', data: seriesValues }],
        chart: { type: 'bar', height: 350, toolbar: { show: false } },
        grid: { show: false },
        plotOptions: { bar: { borderRadius: 6, distributed: true, columnWidth: '45%', dataLabels: { position: 'top' } } },
        //xaxis: { categories: statusLabels },
        xaxis: {
            categories: statusLabels,

            labels: {
                rotate: 0,
                trim: false,
                hideOverlappingLabels: false,

                style: {
                    fontSize: '12px',
                    fontWeight: 400
                },

                formatter: function (value) {

                    switch (value) {

                        case 'Pending with Candidate':
                            return ['Pending with', 'Candidate'];

                        case 'Case Approval Pending':
                            return ['Case Approval', 'Pending'];

                        case 'WIP Status':
                            return ['WIP', 'Status'];

                        case 'Insufficiency':
                            return ['Insufficiency'];

                        case 'Fund Approval':
                            return ['Fund', 'Approval'];

                        default:
                            return [value];
                    }
                }
            }
        },
        yaxis: { min: 0, max: barYAxisMax },
        colors: ['#008FFB', '#00E396', '#FEB019', '#FF4560', '#775DD0'],
        legend: { show: false },
        //dataLabels: {
        //    enabled: true,
        //    useHTML: true, // Allow HTML for line breaks
        //    formatter: function (val) {
        //        const percent = total1 ? ((val / total1) * 100).toFixed(1) : 0;
        //        return val + "(" + percent + "%)";
        //    },
        //    style: { fontSize: '12px', colors: ['#000'] },
        //    offsetY: -10 // Adjust vertical position above bars
        //}
        dataLabels: {
            enabled: true,
            formatter: function (val) {
                const percent = total1 ? ((val / total1) * 100).toFixed(1) : 0;
                return [val, "(" + percent + "%)"];
            },
            offsetY: -50,
            style: {
                fontSize: '12px',
                colors: ['#000']
            },
            //offsetY: -10
        }
    };


    // --- CHART 2: DONUT ---
    var donutOptions = {
        series: seriesValues,
        labels: statusLabels,
        chart: { type: 'donut', height: 350 },
        colors: ['#008FFB', '#00E396', '#FEB019', '#FF4560'],
        legend: { position: 'bottom' }
    };

    // --- CHART 3: ACTION BAR ---
    //var actionOptions = {
    //    series: [{ name: 'Pending', data: actionValues }],
    //    chart: { type: 'bar', height: 350, toolbar: { show: false } },
    //    grid: { show: false },
    //    plotOptions: { bar: { borderRadius: 4, distributed: true, columnWidth: '45%' } },
    //    xaxis: { categories: actionLabels },
    //    colors: ['#775DD0', '#FF4560', '#FEB019', '#00E396'],
    //    legend: { show: false }
    //};

    var actionMax = Math.max(...actionValues, 1);
    var actionYAxisMax = Math.ceil(actionMax * 1.30);

    var actionOptions = {
        series: [{
            name: 'Pending',
            data: actionValues // you can also use actionDataWithPercent.map(d => d.y) if needed
        }],
        chart: { type: 'bar', height: 350, toolbar: { show: false } },
        grid: { show: false },
        plotOptions: {
            bar: { borderRadius: 4, distributed: true, columnWidth: '45%', dataLabels: { position: 'top' } }
        },
        xaxis: { categories: actionLabels },
        yaxis: { min: 0, max: actionYAxisMax },
        colors: ['#775DD0', '#FF4560', '#FEB019'],
        legend: { show: false },
        //dataLabels: {
        //    enabled: true,
        //    formatter: function (val, opts) {
        //        const percent = total ? ((val / total) * 100).toFixed(1) : 0;
        //        return val + "\n(" + percent + "%)";
        //    },
        //    style: { fontSize: '12px', colors: ['#000'] },
        //    offsetY: -10,
        //}
        dataLabels: {
            enabled: true,
            formatter: function (val) {
                const percent = total ? ((val / total) * 100).toFixed(1) : 0;
                return [val, "(" + percent + "%)"];
            },
            offsetY: -50,
            style: {
                fontSize: '12px',
                colors: ['#000']
            },
            //offsetY: -10
        }
    };

    // --- CHART 4: ACTION DONUT ---
    var actionDonutOptions = {
        series: actionValues,
        labels: actionLabels,
        chart: { type: 'donut', height: 350 },
        colors: ['#775DD0', '#FF4560', '#FEB019', '#00E396'],
        legend: { position: 'bottom' }
    };

    // --- CHART 5: FAMILY PERCENTAGE BAR ---
    var familyPercentageOptions = {
        series: [{ name: 'Percentage', data: familyValues }],
        chart: { type: 'bar', height: 400, toolbar: { show: false } },
        plotOptions: {
            bar: {
                borderRadius: 4,
                dataLabels: { position: 'top' },
            }
        },
        dataLabels: {
            enabled: true,
            formatter: function (val, opts) {
                // Calculate percentage relative to the total of this dataset
                let total = opts.w.globals.series[0].reduce((a, b) => a + b, 0);
                return ((val / total) * 100).toFixed(1) + "%";
            },
            offsetY: -20,
            style: { fontSize: '12px', colors: ["#304758"] }
        },
        xaxis: {
            categories: familyLabels,
            position: 'bottom',
            labels: { rotate: -45, style: { fontSize: '10px' } }
        },
        yaxis: { title: { text: 'Volume' } },
        title: {
            text: 'Volume by Family',
            align: 'center',
            style: { color: '#444' }
        }
    };

    // --- RENDER ---
    var barChart = new ApexCharts(document.querySelector("#panding-bar"), barOptions);
    //var donutChart = new ApexCharts(document.querySelector("#status-donut"), donutOptions);
    var actionChart = new ApexCharts(document.querySelector("#action-pending-bar"), actionOptions);    
    //var actionDonutChart = new ApexCharts(document.querySelector("#action-donut"), actionDonutOptions);
    var familyChart = new ApexCharts(document.querySelector("#family-percentage-chart"), familyPercentageOptions);

    barChart.render();
    //donutChart.render();
    actionChart.render();
    //actionDonutChart.render();
    familyChart.render();

    // RANDOMIZE
    document.querySelector("#randomize").addEventListener("click", function() {
        const rand = (n) => Array.from({length: n}, () => Math.floor(Math.random() * 50) + 10);

        const sData = rand(4);
        barChart.updateSeries([{ data: sData }]);
        donutChart.updateSeries(sData);

        const aData = rand(4);
        actionChart.updateSeries([{ data: aData }]);
        actionDonutChart.updateSeries(aData);

        familyChart.updateSeries([{ data: rand(familyLabels.length) }]);
    });
</script>


<script>

    // --- 1. DATA PARSING FOR COLOR CHART ---
// We map the C# Model data directly into JavaScript arrays
// 1. Get the data from the model
var colorLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DashBoardColorCodeCount.Select(x => x.CColorName)));
var colorCounts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DashBoardColorCodeCount.Select(x => x.CCount)));

// 2. Define a helper function to map names to actual Hex codes
function getHexColor(colorName) {
    const name = colorName.toLowerCase().trim();
    switch (name) {
        case 'red': return '#dc3545';
        case 'green': return '#28a745';
        case 'yellow': return '#ffc107';
        case 'blue': return '#007bff';
        case 'amber': return '#FFBF00';
        case 'orange': return '#fd7e14';
        case 'grey': case 'gray': return '#6c757d';
        case 'white': return '##FFFFFF';
        default: return '#008FFB'; // Default Apex Blue if name doesn't match
    }
}

// 3. Generate the colors array based on the labels we actually have
var chartColors = colorLabels.map(label => getHexColor(label));

var colorChartOptions = {
    series: colorCounts,
    labels: colorLabels,
    chart: {
        type: 'pie',
        height: 100
    },
    // Apply the mapped hex codes here
    colors: chartColors,
    legend: {
        position: 'bottom'
    },
    // Ensure the tooltip and data labels look clean
    dataLabels: {
        enabled: true,
        formatter: function (val, opts) {
            return opts.w.globals.series[opts.seriesIndex];
        }
    }
};

// --- 3. RENDER ---
var colorChart = new ApexCharts(document.querySelector("#color-code-chart"), colorChartOptions);
colorChart.render();
</script>

