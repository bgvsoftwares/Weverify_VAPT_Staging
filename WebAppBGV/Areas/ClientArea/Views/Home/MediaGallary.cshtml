@{
    ViewBag.Title = "Media Gallery";
    Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";


}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Media Gallery</title>
    <style>
        #vid {
            height: 450px;
            width: auto;
            position: relative;
            left: 0;
            right: 0;
            margin: auto;
        }
    </style>
</head>
<body>
    @section DisplayTitle{ @Html.Partial("_DisplayTitle") }
    <div class="row">
        <div class="col-lg-12 col-md-12" style="background:#EAEAEA!important;">
            <div class="card" style="height:auto!important;box-shadow: none; border-radius: 0px; background:#EAEAEA!important;">
                <div class="card-body">
                    <div class="">
                        <div class="row row-xs align-items-center mg-b-20">
                            <video width="100%" height="100%" controls autoplay loop muted id="vid">
                                <source src="https://bgv.securitas-india.com/MediaLibrary/Pre_and_post_employment_Video_13_20Sept_2019.mp4" type="video/mp4">
                                <source src="https://bgv.securitas-india.com/MediaLibrary/Pre_and_post_employment_Video_13_20Sept_2019.mp4" type="video/ogg">
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            document.getElementById('vid').play();
        });
    </script>
</body>
</html>