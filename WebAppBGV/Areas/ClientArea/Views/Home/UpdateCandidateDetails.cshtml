    <script type="text/javascript">
        $(document).ready(function () {
            $('input[type=datetime]').datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: "-66:+10",
                //onClose: function (dateText, inst) {
                //    $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay));
                //}
            });
            var dNow = new Date();
            var localdate = (dNow.getFullYear() + '-' + (dNow.getMonth() + 1) + '-' + dNow.getDate());
            $('#OrderDate').val(localdate);
        });


        $(function () {
            var value = $('#mydrpNationalIDProof').val();
            //alert(value);
            $('#AadhaarCardNo').hide();
            $('#DrivingLicenseNo').hide();
            $('#PassportNo').hide();
            $('#PanCardNo').hide();
            $('#VoterIDCardNo').hide();

            if (value == "Aadhaar Card") {
                $('#AadhaarCardNo').show();
            }
            else if (value == "Driving License") {
                $('#DrivingLicenseNo').show();
            }
            else if (value == "Passport") {

                $('#PassportNo').show();
            }
            else if (value == "Pan Card") {
                $('#PanCardNo').show();
            }
            else if (value == "Voter ID Card") {
                $('#VoterIDCardNo').show();
            }
            else {

            }
        });


        $(function () {
            $('#mydrpNationalIDProof').change(function () {
                var value = $(this).val();
                //alert(value);
                $('#AadhaarCardNo').hide();
                $('#DrivingLicenseNo').hide();
                $('#PassportNo').hide();
                $('#PanCardNo').hide();
                $('#VoterIDCardNo').hide();

                if (value == "Aadhaar Card") {
                    $('#AadhaarCardNo').show();
                }
                else if (value == "Driving License") {
                    $('#DrivingLicenseNo').show();
                }
                else if (value == "Passport") {

                    $('#PassportNo').show();
                }
                else if (value == "Pan Card") {
                    $('#PanCardNo').show();
                }
                else if (value == "Voter ID Card") {
                    $('#VoterIDCardNo').show();
                }
                else {

                }
            });
        });




        $(function () {
            $('#mydrpMaritalStatus').change(function () {
                var value = $(this).val();
                if (value == "Married") {
                    $('#dvMaritalStatus').show();
                    $('#dvlblMaritalStatus').show();
                }
                else {
                    $('#dvMaritalStatus').hide();
                    $('#dvlblMaritalStatus').hide();
                }
            });
        });

    </script>
 