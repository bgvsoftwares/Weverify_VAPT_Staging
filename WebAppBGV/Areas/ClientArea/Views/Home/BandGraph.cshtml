

@{
    ViewBag.Title = "Welcome To " + ViewBag.Dashboard;
    //Layout = "~/Views/Shared/_LayoutWoutNav.cshtml";
    Layout = "~/Areas/ClientArea/Views/Shared/_LayoutDepartmentNew.cshtml";
    string[] fruits = new string[] { ViewBag.Newmonths };


    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "DashboardClient", "Home", new { area = "ClientArea" }, new
    {
        @class = "headerbacklink"

    }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-2">
      
        <input type="hidden" id="Hftotalcases" value=@ViewBag.totalcases />
        <input type="hidden" id="HfActiveCases" value=@ViewBag.ActiveCases />
        <input type="hidden" id="HfStoped" value=@ViewBag.Stoped />
        <input type="hidden" id="Hfmonths" value=@ViewBag.Newmonths />

    </div>
    <div class="col-md-10" style="padding-left:2%;margin-top:1.5%;">
        <div class="tab-pane" id="revDashboard" role="tabpanel">
            <div class="content" style="padding:1% 2%;">
                <div class="row">
                    <style>
                        .thead {
                            background: #797979;
                            color: #fff;
                        }

                        th {
                            text-align: center;
                            padding: 5px;
                            font-size: 14px;
                        }

                        td {
                            padding: 5px;
                        }

                        .form-control {
                            color: #3c3c3c;
                        }
                    </style>

                    <div class="col-md-8">
                        <div class="card ">
                            @*<div class="card-header ">
                                    <h4 class="text-center"> Check Family Wise Report </h4>

                                </div>*@
                            <div style="width:30%; float:right;display:inline-flex;" class="text-right">
                                <span style="margin-top: 4%;"><b>Year:</b></span>&nbsp;  @Html.DropDownList("ddlColor", new List<SelectListItem>
{ new SelectListItem{Text="All", Value="", Selected = true,},

new SelectListItem{Text="2017", Value="2017"},
new SelectListItem{Text="2018", Value="2018" },
new SelectListItem{Text="2019", Value="2019" },
new SelectListItem{Text="2020", Value="2020" },
new SelectListItem{Text="2021", Value="2021" }
//new SelectListItem{Text="STOP", Value="STOP", Selected = true, }
                                              },
new { @class = "form-control" })
                            </div>
                            <div class="card-body ">
                                <h1 class="text-center text-info text-bold">Band Analysis</h1>
                                <br />
                                @*<div id="Barchart"></div>*@
                                @*<canvas id="myChart"></canvas>*@
                                @*<div id="columnchart_material" style="width: 800px; height: 500px;"></div>*@
                                <canvas id="CheckFamilycolorCanvas"></canvas>
                                <canvas id="hideChartDept"></canvas>
                                @*<canvas id=chartHours width="400" height="100"></canvas>*@
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div id="trendChecktable" class="pt-family-table">
                            <table border="1" width="100%" id="table">
                                <thead>
                                    <tr class="thead">

                                        <th align="center">Band</th>
                                        <th align="center">WIP</th>
                                        <th align="center">Completed</th>
                                        <th align="center">STOP</th>
                                        <th align="center">Total</th>

                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<script src='@Url.Content("~/Scripts/modernizr-2.8.3.js")'></script>

<script src='@Url.Content("~/Scripts/jquery-3.7.1.min.js")'></script>
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<script src='@Url.Content("~/Scripts/DisableBackForwordBtn.js")'></script>
<script src='@Url.Content("~/Scripts/DisableBackForwordBtn.js")'></script>
<script src='@Url.Content("~/Scripts/bootstrap.min.js")'></script>
<script src='@Url.Content("~/Content/newscripts/chartjs.js")'></script>

@*<script src='@Url.Content("~/Content/newscripts/demo.js")'></script>*@
<script src="~/Content/newscripts/propermin.js"></script>

<script>
    $(document).ready(function () {
        var color = '';
        $.ajax({
            url: '/ClientArea/Home/BandGraphs?Color=' + color,
            method: "GET",
            success: function (data) {
                // console.log(data);

                var WIP = [];
                var Completed = [];
                var Total = [];
                var Department = [];
                var STOP = [];
                for (var i in data) {
                    Department.push(data[i].Department);
                    WIP.push(data[i].WIP);
                    Completed.push(data[i].Completed);
                    STOP.push(data[i].STOP);
                    Total.push(data[i].Total);


                }

                var chartdata = {
                    labels: Department,
                    datasets: [
                        {
                            label: 'Wip',
                            backgroundColor: '#146EB4',
                            borderColor: '#146EB4',
                            hoverBackgroundColor: 'rgb(48, 219, 219)',
                            hoverBorderColor: 'rgb(48, 219, 219)',
                            data: WIP
                        },
                        {
                            label: 'Completed',
                            backgroundColor: '#008000',
                            borderColor: '#008000',
                            hoverBackgroundColor: 'rgb(129, 209, 154)',
                            hoverBorderColor: 'rgb(129, 209, 154) ',
                            data: Completed
                        },
                        {
                            label: 'Total',
                            backgroundColor: '#FFA500',
                            borderColor: '#FFA500',
                            hoverBackgroundColor: 'rgb(186, 201, 209)',
                            hoverBorderColor: 'rgb(186, 201, 209)',
                            data: Total
                        },

                        {
                            label: 'STOP',
                            backgroundColor: '#FF0000',
                            borderColor: '#FF0000',
                            hoverBackgroundColor: 'rgb(129, 209, 154)',
                            hoverBorderColor: 'rgb(129, 209, 154) ',
                            data: STOP
                        }

                    ]
                };
                var opt = {
                    events: false,
                    tooltips: {
                        enabled: false
                    },
                    hover: {
                        animationDuration: 0
                    },
                    scales: {
                        xAxes: [{
                            ticks: {
                                autoSkip: false,
                            }
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Value'
                            }
                        }]
                    },

                   
                };

                var ctx = $("#CheckFamilycolorCanvas");

                var barGraph = new Chart(ctx, {
                    type: 'bar',
                    data: chartdata,
                    options: opt
                });
            },
            error: function (data) {
               // console.log(data);
            }
        });

        $.ajax({
            url: '/ClientArea/Home/BandGraphs_table?Color=' + color,
            method: "GET",
            success: function (data) {
                // console.log(data);
                var WIP = [];
                var Completed = [];
                var Total = [];
                var Department = [];
                var STOP = [];
                for (var i in data) {
                    Department.push(data[i].Department);
                    WIP.push(data[i].WIP);
                    Completed.push(data[i].Completed);
                    STOP.push(data[i].STOP);
                    Total.push(data[i].Total);


                }
                //table code
                var tr;
                for (var j = 0; j < data.length; j++) {
                    tr = $('<tr/>');
                    tr.append("<td>" + Department[j] + "</td>");
                    tr.append("<td>" + WIP[j] + "</td>");
                    tr.append("<td>" + Completed[j] + "</td>");
                    tr.append("<td>" + STOP[j] + "</td>");
                    tr.append("<td>" + Total[j] + "</td>");

                   // alert(tr);
                    $('tbody').append(tr);
                }
                //tablecode ends

            },
            error: function (data) {
               // console.log(data);
            }
        });
        //change function starts
        $("#ddlColor").change(function () {
            var colors = $("#ddlColor").val();
            $('#CheckFamilycolorCanvas').hide();
            $.ajax({
                url: '/ClientArea/Home/BandGraphs_table?Color=' + colors,
                method: "GET",
                success: function (data) {
                    var WIP = [];
                    var Completed = [];
                    var Total = [];
                    var Department = [];
                    var STOP = [];
                    for (var i in data) {
                        Department.push(data[i].Department);
                        WIP.push(data[i].WIP);
                        Completed.push(data[i].Completed);
                        STOP.push(data[i].STOP);
                        Total.push(data[i].Total);


                    }
                    //table code
                    var tr;
                    $('tbody tr').empty();
                    for (var j = 0; j < data.length; j++) {
                        tr = $('<tr/>');
                        tr.append("<td>" + Department[j] + "</td>");
                        tr.append("<td>" + WIP[j] + "</td>");

                        tr.append("<td>" + Completed[j] + "</td>");
                        tr.append("<td>" + STOP[j] + "</td>");
                        tr.append("<td>" + Total[j] + "</td>");

                        // alert(tr);
                        $('tbody').append(tr);
                    }
                //tablecode ends
                },
                error: function (data) {
                   // console.log(data);
                }
            });

            //chart change starts

            $.ajax({
                url: '/ClientArea/Home/BandGraphs?Color=' + colors,
                method: "GET",
                success: function (data) {
                   // console.log(data);

                    var WIP = [];
                    var Completed = [];
                    var Total = [];
                    var Department = [];
                    var STOP = [];
                    for (var i in data) {
                        Department.push(data[i].Department);
                        WIP.push(data[i].WIP);
                        Completed.push(data[i].Completed);
                        STOP.push(data[i].STOP);
                        Total.push(data[i].Total);


                    }

                    var chartdata = {
                        labels: Department,
                        datasets: [
                            {
                                label: 'Wip',
                                backgroundColor: '#146EB4',
                                borderColor: '#146EB4',
                                hoverBackgroundColor: 'rgb(48, 219, 219)',
                                hoverBorderColor: 'rgb(48, 219, 219)',
                                data: WIP
                            },
                            {
                                label: 'Completed',
                                backgroundColor: '#008000',
                                borderColor: '#008000',
                                hoverBackgroundColor: 'rgb(129, 209, 154)',
                                hoverBorderColor: 'rgb(129, 209, 154) ',
                                data: Completed
                            },
                            {
                                label: 'Total',
                                backgroundColor: '#FFA500',
                                borderColor: '#FFA500',
                                hoverBackgroundColor: 'rgb(186, 201, 209)',
                                hoverBorderColor: 'rgb(186, 201, 209)',
                                data: Total
                            },

                            {
                                label: 'STOP',
                                backgroundColor: '#FF0000',
                                borderColor: '#FF0000',
                                hoverBackgroundColor: 'rgb(129, 209, 154)',
                                hoverBorderColor: 'rgb(129, 209, 154) ',
                                data: STOP
                            }

                        ]
                    };
                    var opt = {
                        events: false,
                        tooltips: {
                            enabled: false
                        },
                        hover: {
                            animationDuration: 0
                        },
                        scales: {
                            xAxes: [{
                                ticks: {
                                    autoSkip: false,
                                }
                            }],
                            yAxes: [{
                                display: true,
                                scaleLabel: {
                                    display: true,
                                    labelString: 'Value'
                                }
                            }]
                        },

                    };

                    var ctx = $("#hideChartDept");

                    var barGraph = new Chart(ctx, {
                        type: 'bar',
                        data: chartdata,
                        options: opt
                    });
                },
                error: function (data) {
                    // console.log(data);
                }
            });
        });

    });
</script>