@{
    ViewBag.Title = "Welcome Case Information Provided For  (" + Convert.ToString(Session["CandidateName"]) + ")";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");

    //Start Added 10-08-2017
    string hyperLink = string.Empty;
    if (Request.QueryString["CaseStatus"] != null)
    {
        hyperLink = Html.ActionLink("linkTitle", "AllocatedDataEntryJob", "ProvidedInfo", new { CaseStatus = Request.QueryString["Casestatus"].ToString() }, new { @class = "headerbacklink" }).ToString();
    }
    else if (Request.QueryString["tatHours"] != null)
    {
        hyperLink = Html.ActionLink("linkTitle", "AllocatedDataEntryJob", "ProvidedInfo", new { tatHours = Request.QueryString["tatHours"].ToString() }, new { @class = "headerbacklink" }).ToString();
    }
    else
    {
        hyperLink = Html.ActionLink("linkTitle", "AllocatedDataEntryJob", "ProvidedInfo", null, new { @class = "headerbacklink" }).ToString();
    }

    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
    //End Added 10-08-2017
}
@{string ClientRowID = "0";} 
@if (Request.QueryString["ClientRowId"] != null)
