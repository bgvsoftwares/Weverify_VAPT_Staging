        $(document).ready(function () {
            $(".iframeIDBCheck").colorbox({ iframe: true, width: "79%", height: "72%" });
        });
    </script>
    <script>
        function Validate() {
            var email = document.getElementById('8');
            // var filter = /^([a-zA-Z0-9!#$%&'*+\/=?^_`{|}~-]+(?:\.[a-zA-Z0-9!#$%&'*+\/=?^_`{|}~-]+)*@@(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)$/;
            var filter = /(?:[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)*|"(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21\x23-\x5b\x5d-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])*")@@(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?|\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-zA-Z0-9-]*[a-z0-9]:(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21-\x5a\x53-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])+)\])/;
            if (!filter.test(email.value)) {
                alert('Please provide a valid email address');
                // var filter =  /^([a-zA-Z0-9!#$%&'*+\/=?^_`{|}~-]+(?:\.[a-zA-Z0-9!#$%&'*+\/=?^_`{|}~-]+)*@@(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)$/;
            }
        }

        function onlyNumericValue(event) {
            var charCode = (event.which) ? event.which : event.keyCode
            if (charCode > 31 && (charCode < 48 || charCode > 57))
                return false;

            return true;

        }

        function process(input) {
            let value = input.value;
            let numbers = value.replace(/[^0-9]/g, "");
            input.value = numbers;
        }

        @if (clid != "1708")
        {
            <text>
	            $("#121").AlphabetWithSpace();
            </text>
        }

        $("#8").EmailString();
        //$("#4").AlphaNumericWithMinus();
    </script>

    <script>

        $(document).ready(function () {
            $('#BGCForm').on('change', function (event) {
                const file = event.target.files[0];
                if (file) {
                    var fileInput = $(this)[0];
                    var fileName = fileInput.files[0].name;
                    var fileExtension = fileName.split('.').pop().toLowerCase();

                    if (fileExtension === 'pdf' || fileExtension === 'PDF') {
                        //const loadingID = document.getElementById('loadingID');
                        //loadingID.style.display = 'flex';
                        var formData = new FormData();
                        formData.append("adharfile", $('#AadhaarCardFile')[0].files[0]);
                        formData.append("file", $('#BGCForm')[0].files[0]);
                        formData.append("bgcF", $('#BGCFormType').val());
                        $.ajax({
                            url: '@Url.Action("GetDatafromOCR", "Home", new { area = "ClientArea" })',
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (data) {
                                if (data.success.Status != 0) {
                                    //24 Title
                                    $('#24').val(data.success.Title);
                                    //121 candidateName
                                    $('#121').val(data.success.CandidateName);
                                    //19 MobileNo
                                    $('#m_19').val(data.success.MobileNo);
                                    //8 EmailId
                                    $('#8').val(data.success.EmailID);
                                    //16 Branch
                                   // $('#16').val(data.success.SeniorProfilecase);
                                    //9 EmaployeId
                                    $('#9').val(data.success.EmployeeID);
                                    //4 ClientRefId
                                    $('#4').val(data.success.ClientRefID);
                                    //IsSeniorProfile
                                    if (data.success.SeniorProfilecase == 'Fresher') {
                                        $('#IsSeniorProfile').prop('checked', false);
                                    }
                                    else {
                                        $('#IsSeniorProfile').prop('checked', true);
                                    }

                                }
                                else {
                                    alert('Ocr Not Working');
                                }
                            },
                            error: function (xhr, status, error) {
                                loadingID.style.display = 'none';
                                alert('Error uploading file: ' + error);
                            }
                        });

                    }
                    else {
                        Swal.fire({
                            title: 'Error!',
                            text: 'Invalid file type. Please upload a .PDF file.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }

                } else {
                    alert("Please select a file first.");
                }
            });
        });
    </script>



    <script type="text/javascript">
        $(document).ready(function () {
            $('#ClientRowID').change(function () {
                $('#PricingType').val(0);
                $('#dvChksPcks').hide();
            });
            $('#dvChksPcks').hide();
            $('#PricingType').change(function () {
                var des = $("#7").val();
                var url1 = "/ClientArea/Home/GetChecksAndPackageByClientId?id=" + $("#ClientRowID").val() + "&pt=" + $("#PricingType").val() + "&Des=" + $("#7").val() + "&Entity=" + $("#208").val();
                $.ajax({
                    url: url1,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (allData) {
                        if (allData != null && allData != "") {
                            $('#dvChksPcks').show();
                            var items = '';
                            jQuery.each(allData, function (index, allData) {
                                if (allData.CheckFamilyRowID != 0) {
                                    items += "<li  class='paackage_li' style='padding: .30rem; list-style-type: none;'><a><input type='checkbox' class='chkPkgChks' value='Check-" + allData.ClientCheckRowID + "' /> " + allData.CheckOrPackageName + "</a></li>";
                                }
                                else {
                                    items += "<li  class='paackage_li' style='padding: .30rem; list-style-type: none;'><a><input type='checkbox' class='chkPkgChks' name='checkbox1' onClick='ckChange(this)' value='Package-" + allData.CheckOrPackageName + "' /> " + allData.CheckOrPackageName + "</a></li>";
                                }
                            });
                            $('#dvChecksPackages').html(items);
                        }
                        else {
                            $('#dvChksPcks').hide();
                             Swal.fire({
                                icon: 'info',
                                title: 'Info',
                                html: '<div class="errormsg" style="text-align:center;">No Checks And Packages Selected</div>'
                            });
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Info',
                            html: '<div class="errormsg" style="text-align:center;">some error</div>'
                        });
                    }
                });
            });
        });

