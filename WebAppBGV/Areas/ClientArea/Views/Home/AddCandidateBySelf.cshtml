function checkDuplicate(callback) {
var mobile = $("#m_19").val();
var email = $("#8").val();

    $.ajax({
        url: '@Url.Action("CheckDuplicate", "Home")',
        type: 'POST',
        data: {
            MobileNo: mobile,
            EmailId: email
        },
        success: function (res) {
            if (res.isDuplicate) {
                showDuplicatePopup(res);
                callback(true);  // duplicate found
            } else {
                callback(false); // no duplicate
            }
        },
        error: function () {
            callback(false); // allow submit if error
        }
    });
}

function showDuplicatePopup(res) {
    Swal.fire({
        icon: 'warning',
        title: 'Duplicate Data Found',
        html:
            '<b>Company Ref No:</b> ' + res.companyRefNo + '<br/>' +
            '<b>Name:</b> ' + res.name,
        showCancelButton: true,
        confirmButtonText: 'Approve',
        cancelButtonText: 'Not Approve'
    }).then((result) => {
        if (result.isConfirmed) {
            // User clicked Approve → continue form submission
            setTimeout(function () {
                $("form").submit();
            }, 1);
        } else if (result.dismiss === Swal.DismissReason.cancel) {
            // User clicked Not Approve → refresh page
            location.reload();
        }
    });
}

