
@{

    Layout = "~/Areas/ClientArea/Views/Shared/_Layout.cshtml";
}



@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section NavigationButton{ @Html.Partial("_NavigationButton") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<style>
    @@media (min-width: 768px) {
        .checkselect-checkbox {
            max-width: 100%;
        }
    }

    .checkselect-checkbox {
        text-align: left !important;
    }

    #dvchkChecks {
        height: 405px !important;
        overflow-x: hidden !important;
        overflow-y: auto;
    }

    #SearchValue {
        height: 450px !important;
        border: 1px solid #000 !important;
    }

    #dvchkChecks::-webkit-scrollbar {
        width: 10px;
    }

    #dvchkChecks::-webkit-scrollbar-track {
        background: rgb(179, 177, 177);
        border-radius: 10px;
    }

    #dvchkChecks::-webkit-scrollbar-thumb {
        background: rgba(188,188,188,0.5);
        border-radius: 10px;
    }

        #dvchkChecks::-webkit-scrollbar-thumb:hover {
            background: rgb(100, 100, 100);
            border-radius: 10px;
        }

        #dvchkChecks::-webkit-scrollbar-thumb:active {
            background: rgb(68, 68, 68);
            border-radius: 10px;
        }
</style>

<div class="row">
    <div class="col-lg-12 col-md-12" style="background:#EAEAEA!important;">
        @using (Html.BeginForm("AddCheckFractal", "Home", new { area = "ClientArea" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="card" style="height:auto!important;box-shadow: none; border-radius: 0px; background:#EAEAEA!important;">
                <div class="card-body">
                    <div class="main-content-label mg-b-5 d-flex mb-3" style="line-height:20px;">
                        <div class="me-1 fw-bolder">
                            <b>Note:</b>
                        </div>
                        <div class="fs-10">
                            <span class="fw-bolder">
                                Write the reference no in the below textbox and press submit after selected required check.
                            </span>
                        </div>
                    </div>
                    <div class="row row-xs align-items-center mg-b-20">
                        <div class="col-md-6">
                            @Html.TextArea("SearchValue", null, new { @class = "form-control fldRefID", placeholder = "Type Securitas ID...", @rows = "10" })
                            <input type="hidden" id="CandidateCheck" name="CandidateCheck" value="" />
                        </div>
                        <div class="col-md-6 mg-t-5 mg-md-t-0">
                            <fieldset class="scheduler-border" style=" border: 1px solid #000 !important; margin:0px!important; padding:0px!important; height:450px; overflow:hidden!important;">
                                <legend class="scheduler-border" style="font-size:1rem!important;padding:10px!important;"> Select Checks<em style="color:#FC273F!important;">*</em></legend>
                                <div class="input-group p-2">
                                    <input type="text" class="form-control" placeholder="search by check name...." onkeyup="myFunction()" id="myInput">
                                </div>
                                <div class="form-group branch" style="margin:0px!important;">
                                    <div id="dvchkChecks" class="scroll down">
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                    <div class="row row-xs align-items-center mg-b-20 justify-content-center">
                        <div class="col-md-2 mg-t-5 mg-md-t-0">
                            <input class="submit-btn btn-block rounded-0" type="submit" value="Submit" id="btnSubmit" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>



@section Scripts{
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script type="text/javascript">
        if ('@ViewBag.ErrorMsg' != '') {
             Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">@ViewBag.ErrorMsg</div>'
                });
        }
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            bindClientCheck();
            if ('@ViewBag.Message' != '') {
                Swal.fire({
                    icon: 'info',
                    title: 'Success',
                    html: '<div class="errormsg" style="text-align:center;">@ViewBag.Message</div>'
                });
            }
        });
        function bindClientCheck() {
            var urls = "/ClientArea/Home/GetChecksClientId";
            $.ajax({
                url: urls,
                type: 'GET',
                async: false,
                dataType: 'json',
                success: function (allData) {
                    if (allData != null && allData != "") {
                       var items = '';
                        jQuery.each(allData, function (index, allData) {
                            items += "<li  class='paackage_li' style='padding: .30rem; list-style-type: none;'><a><input type='checkbox' class='chkPkgChks' value='" + allData.ClientCheckRowID + "' /> " + allData.SubCheckName + "</a></li>";
                        });
                        $('#dvchkChecks').html(items);
                    }
                    else {
                          alert("No Checks And Packages Selected");
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert("some error");
                }
            });
        }

        $(document).on('change', 'input[class="chkPkgChks"]', function (e) {
            var selectedIds = '';
            $('input[class="chkPkgChks"]').each(function (index, value) {
                if (this.checked) { selectedIds += this.value + ','; }
            });
            if (selectedIds.length > 0) {
                selectedIds = selectedIds.substring(0, selectedIds.length - 1);
            } else { selectedIds = ''; }

            $('#CandidateCheck').val(selectedIds.trim());
        });

        $(".fldRefID").on("input", function () {
            var regexp = /[^a-zA-Z0-9-\s]/g;
            if ($(this).val().match(regexp)) {
                $(this).val($(this).val().replace(regexp, ''));
            }
        });

        $("#btnSubmit").click(function () {
            var sv = $("#SearchValue").val();
            if (sv == '') {
                   Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">Please Type Securitas ID</div>'
                });
                return false;
            }
            var chk = $('#CandidateCheck').val();
            if (chk.length <= 0) {
                Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">Please Select atleat one check</div>'
                });
                return false;
            }


        });

    </script>
    <script>
        function myFunction() {
            var input, filter, ul, li, a, i, txtValue;
            input = document.getElementById("myInput");
            filter = input.value.toUpperCase();
            ul = document.getElementById("dvchkChecks");
            li = ul.getElementsByTagName("li");
            for (i = 0; i < li.length; i++) {
                a = li[i].getElementsByTagName("a")[0];
                txtValue = a.textContent || a.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    li[i].style.display = "";
                } else {
                    li[i].style.display = "none";
                }
            }
        }
    </script>
}

