<script>
    $(document).ready(function () {
        $.ajax({
            url: "/ClientArea/Home/CheckFamilyColorBarChart",
            method: "GET",
            success: function (data) {
                // console.log(data);
                var CheckFamilyName = [];
                var WIP = [];
                var Orange = [];
                var Green = [];
                var Red = [];
                var Nocolor = [];
                for (var i in data) {
                    CheckFamilyName.push(data[i].CheckFamilyName);
                    WIP.push(data[i].WIP);
                    Orange.push(data[i].Orange);
                    Green.push(data[i].Green);
                    Red.push(data[i].Red);
                    Nocolor.push(data[i].Nocolor);

                }
                ////table code
                //var tr;
                //for (var j = 0; j < data.length; j++) {
                //    tr = $('<tr/>');
                //    tr.append("<td>" + CheckFamilyName[j] + "</td>");
                //    tr.append("<td>" + WIP[j] + "</td>");
                //    tr.append("<td>" + Green[j] + "</td>");
                //    tr.append("<td>" + Orange[j] + "</td>");

                //    tr.append("<td>" + Red[j] + "</td>");
                //    //tr.append("<td>" + Nocolor[j] + "</td>");
                //    $('#table').append(tr);
                //}
                //tablecode ends

                var chartdata = {
                    labels: CheckFamilyName,
                    datasets: [
                        {
                            label: 'Wip',
                            backgroundColor: '#146EB4',
                            borderColor: '#146EB4',
                            hoverBackgroundColor: 'rgb(48, 219, 219)',
                            hoverBorderColor: 'rgb(48, 219, 219)',
                            data: WIP
                        },
                        {
                            label: 'Green',
                            backgroundColor: '#008000',
                            borderColor: '#008000',
                            hoverBackgroundColor: 'rgb(129, 209, 154)',
                            hoverBorderColor: 'rgb(129, 209, 154) ',
                            data: Green
                        },
                        {
                            label: 'Orange',
                            backgroundColor: '#FFA500',
                            borderColor: '#FFA500',
                            hoverBackgroundColor: 'rgb(186, 201, 209)',
                            hoverBorderColor: 'rgb(186, 201, 209)',
                            data: Orange
                        },

                        {
                            label: 'Red',
                            backgroundColor: '#FF0000',
                            borderColor: '#FF0000',
                            hoverBackgroundColor: 'rgb(129, 209, 154)',
                            hoverBorderColor: 'rgb(129, 209, 154) ',
                            data: Red
                        }

                    ]
                };

                var ctx = $("#CheckFamilycolorCanvas");
                var opt = {
                    events: false,
                    tooltips: {
                        enabled: false
                    },
                    hover: {
                        animationDuration: 0
                    },
                    scales: {
                        xAxes: [{
                            ticks: {
                                autoSkip: false,
                            }
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Value'
                            }
                        }]
                    },
                };
                var barGraph = new Chart(ctx, {
                    type: 'bar',
                    data: chartdata,
                    options: opt
                });
            },
            error: function (data) {
               // console.log(data);
            }
        });

        $.ajax({
            url: "/ClientArea/Home/CheckFamilWiseGraph_table",
            method: "GET",
            success: function (data) {
                // console.log(data);
                var CheckFamilyName = [];
                var WIP = [];
                var Orange = [];
                var Green = [];
                var Red = [];
                var Nocolor = [];
                var Total = [];
                var PercentageTotal = "";
                var PercentageWip = "";
                var PercentageOrange = "";
                var PercentageGreen = "";
                var PercentageRed = "";
                var PercentageNocolor = "";
                for (var i in data) {
                    if (data[i].CheckFamilyName == 'Percentage') {
                        PercentageTotal = data[i].Total + "%";
                        PercentageWip = data[i].WIP + "%";
                        PercentageOrange = data[i].Orange + "%";
                        PercentageGreen = data[i].Green + "%";
                        PercentageRed = data[i].Red + "%";
                        PercentageNocolor = data[i].Nocolor + "%";
                    }
                    CheckFamilyName.push(data[i].CheckFamilyName);
                    WIP.push(data[i].WIP);
                    Orange.push(data[i].Orange);
                    Green.push(data[i].Green);
                    Red.push(data[i].Red);
                    Nocolor.push(data[i].Nocolor);
                    Total.push(data[i].Total);

                }
                //table code
                //table code
                $("#totalPercentage").text(PercentageTotal);
                $("#wipPercentage").text(PercentageWip);
                $("#orangePercentage").text(PercentageOrange);
                $("#greenPercentage").text(PercentageGreen);
                $("#redPercentage").text(PercentageRed);
                $("#nocolorPercentage").text(PercentageNocolor);
                var tr;
                for (var j = 0; j < data.length; j++) {
                    tr = $('<tr/>');
                    tr.append("<td>" + CheckFamilyName[j] + "</td>");
                    tr.append("<td>" + Total[j] + "</td>");
                    tr.append("<td>" + WIP[j] + "</td>");
                    tr.append("<td>" + Green[j] + "</td>");
                    tr.append("<td>" + Orange[j] + "</td>");

                    tr.append("<td>" + Red[j] + "</td>");
                    tr.append("<td>" + Nocolor[j] + "</td>");
                    $('#table').append(tr);
                }
                //tablecode ends
                
            },
            error: function (data) {
               // console.log(data);
            }
        });

    })


</script>







