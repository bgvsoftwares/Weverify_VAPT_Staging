
@{
    ViewBag.Title = "Manage Criminal Insuff Cases";
    Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";
}

@section LeftNavigation{ @Html.Partial("_NavLeftCandidateInsuff") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
               
                @if (Model != null && Model.PQAllInsuffCriminals != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQAllInsuffCriminals, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"col-md-1", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-2"),
                                    //grid.Column(columnName: "CandidateName", header: "Candidate Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "CompanyRefNo", header: "SecuritasID", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "CheckStatus", header: "Check Status", canSort: false, style:"col-md-2"),
                                    grid.Column("CreatedDate", "CreatedDate", format: (item) => item.CreatedDate != DateTime.MinValue ? item.CreatedDate.ToString("dd/MM/yyyy") : "", canSort: false,style:"col-md-1"),

                                     grid.Column(header : "", format : (item) => {
                                        var link = Html.ActionLink("Insuff Clear", "InsufficiencyCheckClearByCandidate", "CandidateInsuff", new { id = item.CriminalRowId, ClientRowId = item.ClientRowID, ChFamilRowId = item.CheckFamilyRowID, subCheckId = item.SubCheckRowID, PersonalRowID = item.PersonalRowID, CompanyRefNo =item.CompanyRefNo, InfRemarks = item.INFRemarks}, null);
                                        return link;
                                    }, style:"edit col-md-1"),

                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>

}
