@if (ViewBag.GetDocumentListCandidate != null && ViewBag.GetDocumentListCandidate.Count > 0)
{
    <table width="100%">
        <tr>
            <td>
                <div class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> Document List :</div>
            </td>
        </tr>
        <tr>
            <td height="2"></td>
        </tr>
        <tr>
            <td valign="top">

                <table class="table">
                    <thead class="thead-inverse">
                        <tr>
                            <th class="top-head">Document Type</th>
                            <th class="top-head">File Name</th>
                            <th class="top-head">Remarks</th>
                            <th class="top-head">Upload Date</th>
                            <th class="top-head">  </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.GetDocumentListCandidate)

                        {
                            <tr>
                                <td class="name">@item.DocumentType</td>
                                <td class="filename"><a target="_blank" href='@Url.Content("~/Documents/CandidateDocuments/ProvidedDocuments/" + @item.FileName)'>@item.FileName</a></td>
                                <td class="name">@item.Remarks</td>
                                <td class="name">@item.UploadDate</td>
                                <td class="delete col-md-1">
                                    @Html.Raw(string.Format("<a href=\"#\" id=\"Delete_{0}_{1}\" class=\"delete\">Delete</a>", @item.VerifiedUploadRowID, @item.SubCheckRowID))
                                </td>
                            </tr>
                        }
                        <tr>
                            <td height="12" colspan="5"></td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>

}
@section Scripts{
    <script type="text/javascript">

        $(function () {
            $(".delete").on("click", function () {
                alert("Rahul");
            // alert($('#hdnTeamMemberRowID').val());
                alert("rahul");
            var str = $(this).attr("id").split("_");
          var id = str[1];
          SubCheckRowID = str[2];
            var flag = confirm('Do you want to Delete the Record ?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteCandidateUploadedTempDocs", "Home")',
                    data: { "id": id, "SubCheckRowID": SubCheckRowID},
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (result) {
                        if (result == true) {
                            alert("Record Deleted Successfully!!");
                             window.location.reload();
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });
    </script>
}