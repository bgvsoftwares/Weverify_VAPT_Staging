<div class="main-sidebar-header active">
    <a class="desktop-logo logo-light active" href="#"><img src="~/assets/Client_Page_images/Securitas_newlogo.png" class="main-logo" alt="logo"></a>
    <a class="desktop-logo logo-dark active" href="#"><img src="~/assets/Client_Page_images/Securitas_newlogo.png" class="main-logo dark-theme" alt="logo"></a>
    <a class="logo-icon mobile-logo icon-light active" href="#"><img src="~/assets/Client_Page_images/Securitas_newlogo.png" class="logo-icon" alt="logo"></a>
    <a class="logo-icon mobile-logo icon-dark active" href="#"><img src="~/assets/Client_Page_images/Securitas_newlogo.png" class="logo-icon dark-theme" alt="logo"></a>
</div>
<div class="main-sidemenu mg-lg-t-90" style="padding-bottom:90px;height:auto;">
    <div class="sidebar_top_logo">
        <a class="" href="#"><img src="~/assets/Client_Page_images/Securitas_newlogo.png" class="main-logo" alt="logo"></a>
    </div>
    <div class="app-sidebar__toggle d-flex justify-content-end" data-bs-toggle="sidebar">
        <a class="open-toggle open-toggle-icon" href="#" style="color:#031F30;"><i class="bx bx-pin mt-2 me-2" style="transform: rotate(38deg); color:#DDD; font-size:1.5rem;" data-bs-placement="right" data-bs-toggle="tooltip" title="pin menu"></i></a>
        <a class="close-toggle close-toggle-icon" href="#" style="color:#031F30;"><i class="bx bx-pin mt-2" style="transform: rotate(-38deg); color:#DDD; font-size:1.5rem;" data-bs-placement="right" data-bs-toggle="tooltip" title="unpin menu"></i></a>
    </div>
    <ul class="side-menu">
        @if (Session["NavCandidateInputDataMenuList"] != null)
        {
            @Html.Raw(Session["NavCandidateInputDataMenuList"].ToString());
        }
    </ul>

    @*<ul class="finalbtn">
        @if (Session["NavCandidateInputDataMenuListsubmit"] != null)
        {
            @Html.Raw(Session["NavCandidateInputDataMenuListsubmit"].ToString());
        }
    </ul>*@
</div>
<div class="main-sidebar-header-bottom active">
    @if (Session["NavCandidateInputDataMenuListsubmit"] != null)
    {
        @Html.Raw(Session["NavCandidateInputDataMenuListsubmit"].ToString());
    }
</div>

<style>
    .main-sidebar-header-bottom {
        height: 75px;
        padding: 0px 14px;
        width: 300px;
        background: #031F30;
        position: fixed;
        z-index: 999;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: left 0.3s ease, width 0.3s ease;
    }
    @@media (min-width: 768px) {
        .app.sidenav-toggled .main-sidebar-header-bottom {
            width: 80px;
        }
}
    .fa-chevron-right {
        background: #FFF;
        width: 15px;
        height: 15px;
        text-align: center;
        padding-top: 2px;
        border-radius: 50%;
        color: #FC273F;
        font-size: .70rem;
        margin-right: 5px;
        font-weight: bolder;
    }

    .completed {
        background: #FC273F!important;
        color: #FFF!important;
    }
    .fa-circle {
        font-size: 8px;
        color:#8D5FFF;
    }
</style>
