<!-- main-header -->

<div class="container-fluid p-0" style="padding:0px!important;">
    <div class="main-header-left ">
        <div class="app-sidebar__toggle me-2 app-sidebar__toggle_header me-2" data-bs-toggle="sidebar" style="width:10%;">
            <a class="open-toggle open-toggle-icon_header" href="#"><i class="bx bx-pin mt-2 me-2" style="transform: rotate(38deg); color:#000; font-size:2rem;" data-bs-placement="right" data-bs-toggle="tooltip" title="pin menu"></i></a>
            <a class="close-toggle close-toggle-icon_header" href="#"><i class="bx bx-pin mt-2" style="transform: rotate(-38deg); color:#000; font-size:2rem;" data-bs-placement="right" data-bs-toggle="tooltip" title="unpin menu"></i></a>
        </div>
        <div class="responsive-logo me-sm-2">
            <a href="index.html" id="UserLogo"><img src="~/assets/Client_Page_images/images_bulding.jpg" class="logo-1" alt="logo"></a>
            <a href="index.html" id="UserLogo"><img src="~/assets/Client_Page_images/images_bulding.jpg" class="dark-logo-1" alt="logo"></a>
            <a href="index.html" id="UserLogo"><img src="~/assets/Client_Page_images/images_bulding.jpg" class="logo-2" alt="logo"></a>
            <a href="index.html" id="UserLogo"><img src="~/assets/Client_Page_images/images_bulding.jpg" class="dark-logo-2" alt="logo"></a>
        </div>
        <div class="main-header-center ms-0 d-lg-block">
            <div class="dropdown main-profile-menu nav nav-item nav-link">
                <a class="profile-user d-flex" href=""><img alt="" src="~/assets/Client_Page_images/images_bulding.jpg"></a>
            </div>
        </div>
        @if (Session["CadidateUserName"] != null)
        {
            <div class="main-header-center-Username ms-1">
                <div class="box_1">
                    <p class="mb-0">@Convert.ToString(Session["CandidateNameForHeader"]) (<span class="CadidateUserName" style="color:#8D5FFF;">@Session["CadidateUserName"].ToString()</span>)</p>
                </div>
                <div class="box_2">
                    <p class="mb-0">@Convert.ToString(Session["ClientName"])</p>
                </div>
            </div>
        }
    </div>
    <div class="main-header-right p-2" id="mobile-toggle">
        <nav class="">
            <ul class="horizontalMenu-list" id="myDIV">
                <li class="horizontal-list" aria-haspopup="true"><a href='@Url.Action("Index", "Home")' class="header-right-list active">INSTRUCTION</a></li>
                <li class="horizontal-list" aria-haspopup="true"><a href='@Url.Action("FAQ", "Home")' class="header-right-list">FAQ</a></li>
                <li class="horizontal-list" aria-haspopup="true"><a href='@Url.Action("CandidateMedia", "Home")' class="header-right-list">How To Use Portal </a></li>
                <li class="horizontal-list" aria-haspopup="true"><a href='@Url.Action("UserManual", "Home")' class="header-right-list">User Manual</a></li>
                <li aria-haspopup="true" class="mobile_desk"><a href="@Url.Action("LogOutCandidate", "Account", new { area = "" })" class="logout" data-bs-placement="left" data-bs-toggle="tooltip" title="LogOut"><i class="bx bx-log-out logouticon"></i></a></li>
                <li aria-haspopup="true" class="mobile_log"><a href="@Url.Action("LogOutCandidate", "Account", new { area = "" })" class="logout" data-bs-placement="left" data-bs-toggle="tooltip" title="LogOut"><span>LogOut</span><i class="bx bx-log-out logouticon"></i></a></li>
            </ul>
        </nav>
    </div>
    <div class="responsive-toggle">
        <nav class="">
            <ul class="horizontalMenu-list">
                <li aria-haspopup="true">
                    <a href="javascript:void(0);" class="header-right-list right_menu" onclick="myFunction()">
                        <i class="fa fa-bars"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>


<style>
    .mobile_log{
    display:none;
    }
    @@media (max-width: 1100px) {
        .mobile_log {
            display: block;
        }
        .mobile_desk {
            display: none;
        }
    }

    @@media (max-width: 578px) {
        .main-logo {
            display: block !important;
        }
    }

    .right_menu {
        border: 1px solid #41628a;
        padding: 10px;
        background: #42638c;
        color: #FFF;
        transition: .3s ease-in-out;
    }

        .right_menu:hover {
            border: 1px solid #41628a;
            background: #FFF;
            color: #42638c;
        }
</style>
<!-- Tooltip js -->
<script src="~/assets/js/tooltip.js"></script>
<script>
    function myFunction() {
        var x = document.getElementById("mobile-toggle");
        if (x.className == "main-header-right") {
            x.className += " responsive";
        } else {
            x.className = "main-header-right";
        }
    }
</script>
<script>
    var header = document.getElementById("myDIV");
    var btns = header.getElementsByClassName("header-right-list");
    for (var i = 0; i < btns.length; i++) {
        btns[i].addEventListener("click", function () {
            var current = document.getElementsByClassName("active");
            current[0].className = current[0].className.replace(" active", "");
            this.className += " active";
        });
    }
</script>
