
<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<script src="~/Scripts/sweetalert2.all.min.js"></script>
<div class="row">
    <div class="col-md-12 popup">
        @{
            if (ViewBag.ErrorMsg != null)
            {
                string err = @ViewBag.ErrorMsg.ToString();
                string[] err2 = err.Split(',');
                <script>
                    Swal.fire({
                    icon: 'info',
                    //title: 'Mandatory Fields.',
                    html: '<div class="errormsg" style="text-align:left;"><ol type="1">@foreach (String item in err2){<li>@item</li>}</ol></div>',
                    timer: 20000
           })
                </script>
            }
            else if (TempData["ErrorMsg"] != null)
            {
                <script>
                    Swal.fire({
                    icon: 'info',
                    //title: 'Mandatory Fields.',
                    html:'<div class="errormsg">@TempData["ErrorMsg"].ToString()</div>',
                    timer: 20000
           })
                </script>
            }

            if (ViewBag.SuccessMsg != null)
            {
                <script>
                    Swal.fire({
                    icon: 'info',
                    //title: 'Mandatory Fields.',
                    html:'<div class="errormsg">@ViewBag.SuccessMsg.ToString()</div>',
                    timer: 20000
           })
                </script>
            }
            else if (TempData["SuccessMsg"] != null)
            {
                <script>
                    Swal.fire({
                    icon: 'info',
                    //title: 'Mandatory Fields.',
                    html:'<div class="errormsg">@TempData["SuccessMsg"].ToString()</div>',
                    timer: 20000
           })
                </script>
            }
            else if (TempData["AlertMsg"] != null)
            {
                <script>
                    Swal.fire({
                    icon: 'info',
                    //title: 'Mandatory Fields.',
                    html:'<div class="errormsg">@Html.Raw(@TempData["AlertMsg"].ToString())</div>',
                    timer: 20000
           })
                </script>
            }
            else if (TempData["SuccessAdded"] != null)
            {
                <script>
                    Swal.fire({
                    icon: 'info',
                    //title: 'Mandatory Fields.',
                    html:'<div class="errormsg">@Html.Raw(@TempData["SuccessAdded"].ToString())</div>',
                    timer: 20000
           })
                </script>
            }
            <div class="errormsg">@Html.ValidationMessage("")</div>
        }
    </div>
</div>
