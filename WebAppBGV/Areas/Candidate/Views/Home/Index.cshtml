<style>
    .instruction_table {
        width: 75%;
    }

    .table tr td {
        line-height: 1.4 !important;
    }

    @@media (max-width: 767px) {
        .instruction_table {
            width: 100%;
        }
    }

    .GFG {
        background-color: #8D5FFF !important;
        padding: 0.375rem 0.75rem;
        border-radius: 0px;
        border: 1px solid #8D5FFF !important;
        color: #FFF;
        text-align: center;
        display: inline-block;
        font-size: 19px;
        margin: 0px 0px;
        cursor: pointer;
        transition: all 0.5s;
        width: 100%;
        text-align: center;
    }

        .GFG:hover {
            color: #000;
            background: #FFF !important;
        }

        .GFG span {
            cursor: pointer;
            display: inline-block;
            position: relative;
            transition: 0.5s;
        }

            .GFG span:after {
                content: '\00bb';
                position: absolute;
                opacity: 0;
                top: 0;
                right: -20px;
                transition: 0.5s;
            }

        .GFG:hover span {
            padding-right: 15px;
            color: #000;
        }

            .GFG:hover span:after {
                opacity: 1;
                right: 0;
            }

    .Instr_text {
        white-space: break-spaces;
        -webkit-box-flex: 1;
        -ms-flex: 1 1 auto;
        flex: 1 1 auto;
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        color: #031F30 !important;
        position: relative;
        font-size: 13px;
        line-height: 1.5;
        vertical-align: middle;
        font-weight: 400;
        padding-left: 5px;
    }

    .Ins_img {
        width: 27.5px;
        height: 22px;
    }
</style>
