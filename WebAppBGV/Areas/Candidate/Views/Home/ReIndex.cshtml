@using WebAppBGV.CommonMethods;
@{
    ViewBag.Title = "BGV Instructions";
    Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";

}

@section LeftNavigation{ @Html.Partial("_NavLeftCandidateCaseInfoProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<style>
    .active {
        background: #cdeaeb;
    }
</style>
<br />
<div class="container">
    <div class="row">
        <div class="panel panel-primary">
            <div class="panel-body">
                <div class="new-panel">
                    <style>
                        table thead tr > th {
                            padding: 0% 1%;
                        }

                        table tbody tr > td {
                            padding: 0% 1%;
                        }
                    </style>
                    <h4>Please be ready with electronic (scanned) copy of applicable documents to proceed the BGV process.</h4>
                    <table width="100%" border="1">
                        <thead>
                            <tr>
                                <th>Check Type</th>
                                <th>Document Required</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (string item in ViewBag.CheckFamily)
                            {
                                if (@item == "12")
                                {
                                    <tr>
                                        <td>Employment</td>
                                        <td>Experience Letter / Relieving Letter / Salary Slip / Offer Letter </td>
                                    </tr>
                                }
                                if (@item == "11")
                                {
                                    <tr>
                                        <td>Education</td>
                                        <td>Degree Certificate / Final Year Mark sheet </td>
                                    </tr>
                                }
                                if (@item == "2")
                                {
                                    <tr>
                                        <td>Address</td>
                                        <td>Address Proof</td>
                                    </tr>
                                }
                                if (@item == "26")
                                {
                                    <tr>
                                        <td>National ID Check</td>
                                        <td>ID Proof</td>
                                    </tr>
                                }
                                if (@item == "40")
                                {
                                    <tr>
                                        <td>Credit Check</td>
                                        <td>PAN Card Copy</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <br />
                <div class="container">
                    <div class="col-md-12" style="text-align:center;">
                        <a href="~/Candidate/Home/UpdateCandidatePersonalDetails/@clsCommonMethods.PEncrypt( ViewBag.PersonalRowID.ToString())" class="GFG btn btn-primar"><span>Proceed </span> </a>
                    </div>
                </div>
                <h4>Please follow given below instructions to complete the BGV process:</h4>
                <p>
                    <ol style="line-height: 35px;">
                        <li>
                            Press <b>“Save”</b> button frequently in the page to prevent data loss.
                        </li>
                        <li>
                            Please upload clear copies of all documents, acceptable document format is PDF, JPG and JPEG, also size should not exceed 10 MB.
                        </li>
                        <li>
                            <b>Green colour</b> shows as completed checks others are pending to fill information or to upload documents.
                        </li>
                        <li>
                            Fill the personal information by clicking on the <b>Personal Info</b> hyperlink given in left hand menu.
                        </li>
                        <li>
                            <b>Download Letter of Authorization (LOA)</b> do the signature on the form scan the same document and upload in<br /> LOA/Signature field on the personal info page
                            <b>(Download LOA>>print>>Sign>>Scan>>Upload OR Upload Signature).</b>
                        </li>
                        <li> Click on any checks in left hand side to fill information and upload related documents by clicking of <b>Upload Document</b> button.</li>
                        <li>
                            If any check is not related to you then checked the  NA checkbox on top of the information block.
                        </li>
                        <li>
                            Do the same as given in point <b>No. 4</b> for all for all checks.
                        </li>
                        <li>
                            When all the information filled and docs uploaded then click on <b>“Final Submission”</b> to complete the process.
                        </li>
                        <li>
                            Please go through the <b>FAQ</b> and <b>User Manual</b> for more details.
                        </li>
                        <li>
                            If you have any difficulties to complete BGV process then write us at bgv.helpdesk@securitas-india.com. Response time is 24 hours.
                        </li>
                        <li>
                            You are facing problem login, please clear your browser history, close the browser and re
                            open the link again to login
                        </li>
                    </ol>
                </p>
            </div>
        </div>
    </div>
</div>
<div class="container">
    <div class="col-md-7" style="text-align:center;margin-top:60px;">
        <a href="~/Candidate/Home/UpdateCandidatePersonalDetails/" class="GFG btn btn-primar"><span>Proceed </span> </a>
    </div>
</div>
@section Scripts{


}

<style>
    .GFG {
        background-color: #fc223d;
        border: 2px solid rgb(255 255 255 / 15%);
        padding: 0px 100px;
        color: #f8f9fa;
        text-align: center;
        display: inline-block;
        font-size: 19px;
        margin: 0px 0px;
        cursor: pointer;
        transition: all 0.5s;
    }

        .GFG span {
            cursor: pointer;
            display: inline-block;
            position: relative;
            transition: 0.5s;
        }

            .GFG span:after {
                content: '\00bb';
                position: absolute;
                opacity: 0;
                top: 0;
                right: -20px;
                transition: 0.5s;
            }

        .GFG:hover span {
            padding-right: 25px;
        }

            .GFG:hover span:after {
                opacity: 1;
                right: 0;
            }
</style>
