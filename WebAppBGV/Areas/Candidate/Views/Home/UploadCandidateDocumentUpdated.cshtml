    $(document).on('change', 'input[name="chkPkgChks"]', function (e) {// on change of state
        var chkPkgChkss = '';
        $('input[name="chkPkgChks"]').each(function (index, value) {
            if (this.checked) {
                chkPkgChkss += this.value + ',';
                $("#" + this.value + "").removeAttr("disabled");
            }
            else {
                $("#" + this.value + "").attr("disabled", "disabled");
            }
        });

        if (chkPkgChkss.length > 0) {
            chkPkgChkss = chkPkgChkss.substring(0, chkPkgChkss.length - 1);
        } else { chkPkgChkss = ''; }
        $('#UploadHid').val(chkPkgChkss.trim());
    });


