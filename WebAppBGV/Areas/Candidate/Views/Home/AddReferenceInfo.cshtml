<div class="container-fluid form_container">

    @using (Html.BeginForm("AddReferenceInfo", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
        @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SubCheckId>
        @Html.Hidden("SubCheckId", SubCheckId.ToString())

        <input id="clientRowId" type="hidden" value=@clientRowId>
        @Html.Hidden("clientRowId", clientRowId.ToString())
        @Html.ValidationSummary()

        foreach (var category in Model)
        {
            <div class="row row-sm ps-3">

                @{
                    string[] nm = category.Key.Split('_');
                    if (nm[0] != "document")
                    {
                        if (@nm[2] == "textbox")
                        {
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                <label class="form-label mg-b-0 fw-bolder">
                                    @nm[1]
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <sup class="text-danger">*</sup>
                                        }
                                    }
                                </label>
                            </div>
                            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                <span class="text-danger tx-13"> @nm[4] </span>
                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                            </div>
                        }
                        if (@nm[2] == "dropdown")
                        {
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                <label class="form-label mg-b-0 fw-bolder">
                                    @nm[1]
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <sup class="text-danger">*</sup>
                                        }
                                    }
                                </label>
                            </div>
                            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                <span class="text-danger tx-13"> @nm[4] </span>
                                @{
                                    string[] nmOption = nm[7].Split(',');
                                }
                                <select class="form-select" name=@nm[0] id=@nm[0]>
                                    @for (int i = 0; i < nmOption.Length; i++)
                                    {
                                        if (@nmOption[i].Trim() == @nm[6])
                                        {
                                            <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                        }
                                        if (@nmOption[i].Trim() != @nm[6])
                                        {
                                            <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        if (@nm[2] == "checkbox")
                        {
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                <label class="form-label mg-b-0 fw-bolder">
                                    @nm[1]
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <sup class="text-danger">*</sup>
                                        }
                                    }
                                </label>
                            </div>
                            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                <span class="text-danger tx-13"> @nm[4] </span>
                                @{
                                    if (@nm[6] == "TRUE")
                                    {
                                        <input type="checkbox" id=@nm[0] name=@nm[0] value="checked" checked>
                                    }
                                    else
                                    {
                                        <input type="checkbox" id=@nm[0] name=@nm[0] value=@nm[0]>
                                    }
                                }

                            </div>
                        }
                        if (@nm[2] == "fileUpload")
                        {
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                <label class="form-label mg-b-0 fw-bolder">
                                    @nm[1]
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <sup class="text-danger">*</sup>
                                        }
                                    }
                                </label>
                            </div>
                            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                <span class="text-danger tx-13"> @nm[4] </span>
                                <input class="form-control dropify" type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                            </div>
                        }
                    }
                }
            </div>
        }
        <div class="row">
            <div class="col-sm-12 cytoscape-parent">
                <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
            </div>
        </div>

        <div class="row row-sm justify-content-center d-flex mt-3 mb-3">
            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 text-center mb-2">
                <input class="submit-btn ps-5 pe-5" type="submit" value="Save" id="btnSave" />
            </div>
        </div>
    }

    <div class="row row-sm d-flex justify-content-between ms-0">
        @{
            string[] NextPreviousButtonsURL = (string[])(Session["NextPreviousButtonsURL"]);
            for (int I = 0; I < NextPreviousButtonsURL.Length; I++)
            {
                if (NextPreviousButtonsURL[I] != null)
                {
                    string[] Nenu1 = NextPreviousButtonsURL[I].Split('|');
                    string NextURL = Nenu1[0];
                    if (Nenu1[0] == "End")
                    {
                        NextURL = Nenu1[1];
                    }
                    if (SubCheckId == Nenu1[4].ToString())
                    {
                        if (Nenu1[2] != "Start")
                        {
                            <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 mb-3">
                                <a href="@Nenu1[1]" class="previous_btn text-center">Previous<span></span></a>
                            </div>
                        }
                        else if (Nenu1[2] == "Start")
                        {
                            <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 mb-3">
                                <a href="~/Candidate/Home/UpdateCandidateDetails/@PersonalRowid" class="previous_btn text-center">Previous<span></span></a>
                            </div>
                        }

                        if (Nenu1[3] != "End")
                        {
                            <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 mb-3">
                                <a href="@NextURL" class="next_btn text-center nextbtn" id="nextss">Next<span></span></a>
                            </div>
                        }
                        else if (Nenu1[3] == "End")
                        {
                            <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 mb-3">
                                <a id="rtr" href="~/Candidate/Home/Digital_LOA/@PersonalRowid" class="next_btn text-center finalbtn"><span>Next</span></a>
                            </div>
                        }
                    }
                }
            }
        }
    </div>
</div>

