                    <input type="checkbox" id="notApplicableCheckbox" name="NotApplicable" value="true" @(isChecked ? "checked" : "") />
                    <b class="ms-2" style="color:white"> Not Applicable</b>
                </label>
            </div>
        }
        foreach (var category in Model)
        {
            <div class="row row-sm ps-3">
                @{
                    string[] nm = category.Key.Split('_');
                    if (nm[0] != "document")
                    {
                        if (@nm[2] == "textbox")
                        {
                            if (DateClientID == "75" || DateClientID == "974" || DateClientID == "684")
                            {
                                if (@nm[0] == "60")
                                {
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                        <label class="form-label mg-b-0 fw-bolder">
                                            @nm[1]
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <sup class="text-danger">*</sup>
                                                }
                                            }
                                        </label>
                                    </div>
                                    <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <input type="text" class="form-control" id="fromDate" placeholder="From" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <input type="text" class="form-control" id="ToDate" placeholder="To" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <span class="text-danger tx-13"> @nm[4] </span>
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength='@nm[5]' readonly>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                        <label class="form-label mg-b-0 fw-bolder">
                                            @nm[1]
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <sup class="text-danger">*</sup>
                                                }
                                            }
                                        </label>
                                    </div>
                                    <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                        <span class="text-danger tx-13"> @nm[4] </span>
                                        <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                    </div>
                                }

                            }
                            else
                            {
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                    <label class="form-label mg-b-0 fw-bolder">
                                        @nm[1]
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <sup class="text-danger">*</sup>
                                            }
                                        }
                                    </label>
                                </div>
                                <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                    <span class="text-danger tx-13"> @nm[4] </span>
                                    <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                </div>
                            }
                        }
                        if (@nm[2] == "dropdown")
                        {
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                <label class="form-label mg-b-0 fw-bolder">
                                    @nm[1]
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <sup class="text-danger">*</sup>
                                        }
                                    }
                                </label>
                            </div>
                            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                <span class="text-danger tx-13"> @nm[4] </span>
                                @{
                                    string[] nmOption = nm[7].Split(',');
                                }
                                <select class="form-select" name=@nm[0] id=@nm[0]>
                                    @for (int i = 0; i < nmOption.Length; i++)
                                    {
                                        if (@nmOption[i].Trim() == @nm[6])
                                        {
                                            <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                        }
                                        if (@nmOption[i].Trim() != @nm[6])
                                        {
                                            <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        if (@nm[2] == "checkbox")
                        {
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                <label class="form-label mg-b-0 fw-bolder">
                                    @nm[1]
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <sup class="text-danger">*</sup>
                                        }
                                    }
                                </label>
                            </div>
                            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                <span class="text-danger tx-13"> @nm[4] </span>
                                @{
                                    if (@nm[6] == "TRUE")
                                    {
                                        <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked>
                                    }
                                    else
                                    {
                                        <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0]>
                                    }
                                }

                            </div>
                        }
                        if (@nm[2] == "fileUpload")
                        {
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 mt-3 d-flex align-items-center">
                                <label class="form-label mg-b-0 fw-bolder">
                                    @nm[1]
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <sup class="text-danger">*</sup>
                                        }
                                    }
                                </label>
                            </div>

                            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 mt-3">
                                <span class="text-danger tx-13"> @nm[4] </span>
                                <input class="form-control dropify" type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                            </div>
                        }
                    }
                }

            </div>

        }
        <div class="row">
            <div class="col-sm-12 cytoscape-parent">
                <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
            </div>
        </div>

        <div class="row row-sm justify-content-center d-flex mt-3 mb-3">
            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 text-center mb-sm-2">
                <input class="submit-btn ps-5 pe-5" type="submit" value="Save" id="btnSave" />
            </div>
        </div>
    }

