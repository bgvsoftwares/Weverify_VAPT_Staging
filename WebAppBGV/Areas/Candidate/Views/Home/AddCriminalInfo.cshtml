    <script type="text/javascript">
  $(document).on("click", ".deletetempdoc", async function (e) {
      e.preventDefault();
      const $btn = $(this);
      const idParts = ($btn.attr("id") || "").split("_");
      const id = idParts[1] || "";
      const SubCheckRowID = idParts[2] || "";
      const PersonalRowid = $("#PersonalRowid").val();
      if (!id) {
          Swal.fire({ icon: 'error', title: 'Invalid document id.', timer: 2000, showConfirmButton: false });
          return;
      }
      const result = await Swal.fire({
          title: 'Do you want to delete the document?',
          showCancelButton: true,
          confirmButtonText: 'Yes, Delete it!',
          cancelButtonText: 'Cancel',
          reverseButtons: true,
          focusCancel: true,
          allowOutsideClick: () => !Swal.isLoading(),
          allowEscapeKey: () => !Swal.isLoading()
      });

      if (!result.isConfirmed) {
          // User clicked Cancel or dismissed — do nothing
          return;
      }

      Swal.fire({
          title: 'Deleting...',
          didOpen: () => { Swal.showLoading(); },
          allowOutsideClick: false,
          allowEscapeKey: false,
          showConfirmButton: false
      });

      $.ajax({
          type: "GET", // change to "POST" on both sides if you can
          url: '@Url.Action("DeleteCandidateUploadedTempDocs", "Home")',
          data: {
              id: id,
              SubCheckRowID: SubCheckRowID,
              PersonalRowid: PersonalRowid
          },
          dataType: "json",
          success: function (res) {
              Swal.close();
              if (res === true) {
                  Swal.fire({
                      icon: 'success',
                      title: 'Document deleted successfully!',
                      timer: 1800,
                      showConfirmButton: false
                  }).then(() => {
                      // Reload or remove the specific row:
                      // $btn.closest('tr').remove();
                      window.location.reload();
                  });
              } else {
                  Swal.fire({
                      icon: 'error',
                      title: 'Oops...',
                      text: 'There was an error deleting the document.',
                      timer: 3500
                  });
              }
          },
          error: function (xhr) {
              Swal.close();
              Swal.fire({
                  icon: 'error',
                  title: 'Request failed',
                  text: xhr.responseText || 'Please try again.',
                  timer: 3500
              });
          }
      });
  });
    </script>

