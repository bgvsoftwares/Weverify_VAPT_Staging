            function calculateDateDifference() {
                // Get the values from the datepickers
                var fromDate = $("#fromDate").val();
                var toDate = $("#ToDate").val();

                // Check if both dates are selected
                if (fromDate && toDate) {
                    // Split the month and year parts from the input (mm-yy format)
                    var fromDateParts = fromDate.split("-");
                    var toDateParts = toDate.split("-");

                    var fromMonth = parseInt(fromDateParts[0], 10);  // Get month (mm)
                    var fromYear = parseInt(fromDateParts[1], 10);   // Get year (yyyy)

                    var toMonth = parseInt(toDateParts[0], 10);      // Get month (mm)
                    var toYear = parseInt(toDateParts[1], 10);       // Get year (yyyy)

                    // Calculate the difference in years and months
                    var yearsDifference = toYear - fromYear;
                    var monthsDifference = toMonth - fromMonth;

                    // Adjust if the month difference is negative (i.e., toMonth is earlier in the year than fromMonth)
                    if (monthsDifference < 0) {
                        yearsDifference--;
                        monthsDifference += 12; // Add 12 months to the months difference
                    }

                    // Display the result in #60 (or wherever you want the result)
                    $("#36").val(yearsDifference + " years " + monthsDifference + " months");
