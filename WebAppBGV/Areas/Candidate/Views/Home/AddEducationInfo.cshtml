            var fileName = fileInput.value.split('\\').pop();

            // Block dangerous double extensions
            var doubleExtensionPattern = /\.(php|asp|aspx|jsp|exe|bat|cmd|sh)\./i;

            if (doubleExtensionPattern.test(fileName)) {
                alert('Double extension files are not allowed.');
                fileInput.value = '';
                return false;
            }

            if ((fileName.match(/\./g) || []).length > 1) {
