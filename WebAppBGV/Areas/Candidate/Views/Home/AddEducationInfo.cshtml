@if (TempData["ErrorMessage"] != null)
{
    <script>
Swal.fire({
        icon: 'error',
        timer: 5000,
        showConfirmButton: false,
        html: '<div style="color:#A32D2D; font-weight:500;">@TempData["ErrorMessage"].ToString()</div>'    });
    </script>
}
@if (ViewBag.Success != null)
{
    <script>
        var msg = @Html.Raw(Json.Encode(ViewBag.Success.ToString()));
        var iconType = 'info';
        if (msg.includes('Upload file extension not allowed')) {
            iconType = 'error';
        }
        else if (msg.includes('Document Uploaded Successfully')) {
            iconType = 'success';
        }
        Swal.fire({
            icon: iconType,
            text: msg,
            showConfirmButton: false,
            timer: 5000
        });
    </script>
}

