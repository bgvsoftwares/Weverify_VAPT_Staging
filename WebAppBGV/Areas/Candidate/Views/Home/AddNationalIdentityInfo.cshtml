        @Html.ValidationSummary()

        var clientRowID = clsCommonMethods.PDecrypt(clientRowId.ToString());
        var SubCheckRowID = clsCommonMethods.PDecrypt(SubCheckId.ToString());

        foreach (var category in Model)
        {
            <div class="row row-sm ps-3">
                @{
                    string[] nm = category.Key.Split('_');
