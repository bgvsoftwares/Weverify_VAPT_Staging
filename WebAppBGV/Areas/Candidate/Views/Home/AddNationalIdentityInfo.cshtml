@section Scripts{
    <script src="~/Scripts/normalizePlugin.js"></script>
    <script>
        //validation for candidatename
        document.getElementById('99').onkeypress = function (e) {
            if (!(/[a-z ]/i.test(String.fromCharCode(e.keyCode)))) {
                e.preventDefault();
                return false;
            }
        }
        //validation for candidatename
    </script>
    <script>
        $("#btnSave").click(function () {
            var obj = $('form input[type="text"]').NormalizedString();
            if (obj == false) {
                return false;
            }
        });
    </script>

    <script>
        function fileValidation(fileInput) {
            var filePath = fileInput.value;
            var allowedExtensions = /(\.gif|\.GIF\.doc|\.docx|\.xls|\.xlsx|\.pdf|\.rtf|\.txt|\.jpeg|\.jpg|\.png|\.eml|\.email|\.msg|\.DOC|\.DOCX|\.XLS|\.XLSX|\.PDF|\.RTF|\.TXT|\.JPEG|\.JPG|\.PNG|\.EML|\.EMAIL|\.MSG|\.zip|\.ZIP|\.rar|\.RAR)$/i;
            if (!allowedExtensions.exec(filePath)) {
                alert('Please upload file having extensions .doc/.gif/.GIF/.docx/.xls/.xlsx/.pdf/.rtf/.txt/.jpeg/.jpg/.png/.eml/.email/.msg/.DOC/.DOCX/.XLS/.XLSX/.PDF/.RTF/.TXT/.JPEG/.JPG/.PNG/.EML/.EMAIL/.MSG/.ZIP.zip only.');
                fileInput.value = '';
                return false;
            } else {
                return true;
            }
        }
    </script>


    <script type="text/javascript">
$(document).on("click", ".deletetempdoc", async function (e) {
    e.preventDefault();
    const $btn = $(this);
    const idParts = ($btn.attr("id") || "").split("_");
    const id = idParts[1] || "";
    const SubCheckRowID = idParts[2] || "";
    const PersonalRowid = $("#PersonalRowid").val();
    if (!id) {
        Swal.fire({ icon: 'error', title: 'Invalid document id.', timer: 2000, showConfirmButton: false });
        return;
    }
    const result = await Swal.fire({
        title: 'Do you want to delete the document?',
        showCancelButton: true,
        confirmButtonText: 'Yes, Delete it!',
        cancelButtonText: 'Cancel',
        reverseButtons: true,
        focusCancel: true,
        allowOutsideClick: () => !Swal.isLoading(),
        allowEscapeKey: () => !Swal.isLoading()
    });
    if (!result.isConfirmed) {
        return;
    }

    Swal.fire({
        title: 'Deleting...',
        didOpen: () => { Swal.showLoading(); },
        allowOutsideClick: false,
        allowEscapeKey: false,
        showConfirmButton: false
    });

    $.ajax({
        type: "GET",
        url: '@Url.Action("DeleteCandidateUploadedTempDocs", "Home")',
        data: {
            id: id,
            SubCheckRowID: SubCheckRowID,
            PersonalRowid: PersonalRowid
        },
        dataType: "json",
        success: function (res) {
            Swal.close();
            if (res === true) {
                Swal.fire({
                    icon: 'success',
                    title: 'Document deleted successfully!',
                    timer: 1800,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'There was an error deleting the document.',
                    timer: 3500
                });
            }
        },
        error: function (xhr) {
            Swal.close();
            Swal.fire({
                icon: 'error',
                title: 'Request failed',
                text: xhr.responseText || 'Please try again.',
                timer: 3500
            });
        }
    });
});
    </script>


    <script>
        $(document).on('change', 'input[name="chkPkgChks"]', function (e) {// on change of state
            var chkPkgChkss = '';
            $('input[name="chkPkgChks"]').each(function (index, value) {
                if (this.checked) {
                    chkPkgChkss += this.value + ',';
                    $("#" + this.value + "").removeAttr("disabled");
                }
                else {
                    $("#" + this.value + "").attr("disabled", "disabled");
                }
            });

            if (chkPkgChkss.length > 0) {
                chkPkgChkss = chkPkgChkss.substring(0, chkPkgChkss.length - 1);
            } else { chkPkgChkss = ''; }
            $('#UploadHid').val(chkPkgChkss.trim());
        });

