<div class="container-fluid form_container">

    <p class="text-danger align-content-center">
        Note:- Do not upload Aadhaar. Instead upload a PAN Card / Driving Licence (DL) / Passport.
    </p>

    @using (Html.BeginForm("AddNationalIdentityInfo", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
        @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

        <input id="SubCheckId" type="hidden" value=@SubCheckId>
        @Html.Hidden("SubCheckId", SubCheckId.ToString())

        <input id="clientRowId" type="hidden" value=@clientRowId>
