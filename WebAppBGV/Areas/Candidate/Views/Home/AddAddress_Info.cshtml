    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyArf0CUcQOyMq5hLv0DKXGzA8wIZA8Sgd4&callback=initMap"></script>
    <script>
        var map;
        var markers = [];
        function initMap(latlng = '28.51140252687881,77.08742339206746') {

            if ($('#504').val().length > 2) {
                latlng = $('#504').val();
            }
            var b = latlng.split(",");
            var latitude = parseFloat(b[0]);
            var longitude = parseFloat(b[1]);
            var lat_lng = { lat: latitude, lng: longitude };
            map = new google.maps.Map(document.getElementById('map_canvas'), {
                zoom: 16,
                center: lat_lng,
                mapTypeId: google.maps.MapTypeId.TERRAIN
            });
            // This event listener will call addMarker() when the map is clicked.
            map.addListener('click', function (event) {
                deleteMarkers();
                addMarker(event.latLng);
                $('#latlng').val(event.latLng);
                $('#504').val(event.latLng);
            });
            let infoWindow = new google.maps.InfoWindow({
                content: "Click the map to get Lat/Lng!",
                position: lat_lng,
            });

            infoWindow.open(map);

            map.addListener("click", (mapsMouseEvent) => {
                // Close the current InfoWindow.
                infoWindow.close();

                // Create a new InfoWindow.
                infoWindow = new google.maps.InfoWindow({
                    position: mapsMouseEvent.latLng,
                });
                infoWindow.setContent(
                    JSON.stringify(mapsMouseEvent.latLng.toJSON(), null, 2)
                );
                infoWindow.open(map);
            });
            // Adds a marker at the center of the map.

            if ($('#504').val() != '') {
                var loc = $('#504').val();
                var b = loc.split(",");
                var lat = parseFloat(b[0]);
                var long = parseFloat(b[1]);
                var latlong = { lat: lat, lng: long };
                addMarker(latlong);

                infoWindow = new google.maps.InfoWindow({
                    position: lat_lng,
                });
                infoWindow.setContent(
                    JSON.stringify(lat_lng.toJSON(), null, 2)
                );
                infoWindow.open(map);
            }

        }

        // Adds a marker to the map and push to the array.
        function addMarker(location) {
            var marker = new google.maps.Marker({
                position: location,
                map: map
            });
            markers.push(marker);
        }

        function setMapOnAll(map) {
            for (let i = 0; i < markers.length; i++) {
                markers[i].setMap(map);
            }
        }
        function hideMarkers() {
            setMapOnAll(null);
        }
        function deleteMarkers() {
            hideMarkers();
            markers = [];
        }
    </script>

    <script>

        $('#btnSearch').click(function () {
            $('#504').val('');
            var add = $.trim($("[id*=27]").val());
            var url = "/Candidate/Home/getlatlong?add=" + add;
            $.ajax({
                url: url,
                dataType: 'json',
                type: 'GET',
                async: false,
                //data: { pass: pass },
                success: function (result) {
                    initMap((JSON.stringify(result.pass.Latitude)) + ',' + (JSON.stringify(result.pass.Longitude)));
                },
                error: function (result) {

                }
            });
        });

    </script>
    <script type="text/javascript">
