            $('#32').change(function () {

                $('#HfCityName').val($('#32 option:selected').html());

            });

            $("#27").on("input", function () {
                var regexp = /[^a-zA-Z0-9\s-_/(),]/g;
                if ($(this).val().match(regexp)) {
