@using WebAppBGV.CommonMethods;
@model dynamic

@{
    ViewBag.Title = "Edit Candidate";
    Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Home", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";


    PersonalRowid = @ViewBag.PersonalRowid;

    clientRowId = @ViewBag.clientRowId;

}

@section LeftNavigation{ @Html.Partial("_NavLeftCandidateCaseInfoProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
<script src="~/Scripts/sweetalert2.all.min.js"></script>

@if (ViewBag.ErrorMsg != null)
{
    string err = @ViewBag.ErrorMsg.ToString();
    string[] err2 = err.Split(',');
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Mandatory Fields.',
            html: '<div class="errormsg" style="text-align:center;"><ol type="1">@foreach (String item in err2) {<li> @item</li> }</ol></div>',
            timer: 20000
        })
    </script>
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
Swal.fire({
        icon: 'error',
        timer: 5000,
        showConfirmButton: false,
        html: '<div style="color:#A32D2D; font-weight:500;">@TempData["ErrorMessage"].ToString()</div>'    });
    </script>
}
@if (ViewBag.Success != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            html:'<div class="errormsg">@ViewBag.Success.ToString()</div>',
            showConfirmButton: false,
            timer: 20000
        })
    </script>
}
@if (clientRowId == "559")
{
    if (ViewBag.Information != null)
    {
        <script>
        Swal.fire({
            icon: 'info',
            html:'<div class="errormsg">@ViewBag.Information.ToString()</div>',
            showConfirmButton: false,
            timer: 20000
        })
        </script>
    }

}

