<script>
    $(document).ready(function () {
        $('#ImageDataAdidas').change(function () {
            var fileSize = this.files[0].size; // Get the size of the selected file
            var maxSize = 1024 * 1024; // 1 MB in bytes
            var fileTypes = ['image/png', 'image/jpeg', 'image/jpg'];

            if ($.inArray(this.files[0].type, fileTypes) === -1) {
                alert('Please select a file of type PNG, JPEG, or JPG.');
                // Clear the file input to allow the user to select a different file
                $(this).val('');
                return;
            }

            if (fileSize > maxSize) {
                alert('Please select a file smaller than 1 MB.');
                // Clear the file input to allow the user to select a different file
                $(this).val('');
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        // Function to check file extension
        function fileCheck(input) {
            var fileExt = input.value.split('.').pop().toLowerCase();
            if ($.inArray(fileExt, ['png', 'jpg', 'jpeg']) == -1) {
                alert("Please select a valid Image");
                // Clear the file input
                $('#ImageData').val('');
            }
        }

        // Trigger fileCheck function on file selection change
        $('#ImageData').change(function () {
            fileCheck(this);
        });

        function fileCheck(input) {
            var fileExt = input.value.split('.').pop().toLowerCase();
