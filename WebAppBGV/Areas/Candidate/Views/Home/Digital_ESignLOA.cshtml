    $("#submitButton").click(function () {



        var canvas = document.getElementById("tools_sketch");

        // Get image as Base64
        var base64Image = canvas.toDataURL("image/png");



        // Set hidden field value
        document.getElementById("hfSign").value = base64Image;



        var obj = $('form input[type="text"]').NormalizedString();
        if (obj == false) {
            return false;
        }
        if (signaturePad.isEmpty()) {
            Swal.fire({
                icon: 'info',
                title: 'Info',
                html: '<div class="errormsg" style="text-align:center;">Please provide a signature first.</div>'
            });
            return false;
        }

        var nm = $("#Name").val();
        if (nm == '') {
            $("#Name").focus();
            Swal.fire({
                icon: 'info',
                title: 'Info',
                html: '<div class="errormsg" style="text-align:center;">Please enter name</div>'
            });
            return false;
        }
    });

    $("#Name").AlphabetWithSpace();


</script>
