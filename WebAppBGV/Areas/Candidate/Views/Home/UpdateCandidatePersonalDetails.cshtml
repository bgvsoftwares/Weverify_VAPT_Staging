@using WebAppBGV.CommonMethods;
@model dynamic

@{
    ViewBag.Title = "Edit Candidate";
    Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Home", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";


    PersonalRowid = @ViewBag.PersonalRowid;

    clientRowId = @ViewBag.clientRowId;
}

@section LeftNavigation{ @Html.Partial("_NavLeftCandidateCaseInfoProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

@if (ViewBag.ErrorMsg != null)
{
    string err = @ViewBag.ErrorMsg.ToString();
    string[] err2 = err.Split(',');
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Mandatory Fields.',
            html: '<div class="errormsg" style="text-align:left;"><ol type="1">@foreach(String item in err2){<li> @item</li> }</ol></div>'
       })
    </script>
}
@if (ViewBag.Success != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            html:'<div class="errormsg">@ViewBag.Success.ToString()</div>',
            showConfirmButton: false,
            timer: 1500
        })
    </script>
}

<div class="row" style="background:rgba(141, 195, 255, .1);width:auto!important;">
    <div class="col-md-12 mt-4">
        <div>


            @using (Html.BeginForm("UpdateCandidatePersonalDetails", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
                @Html.Hidden("PersonalRowid", PersonalRowid.ToString())
                <input id="clientRowId" type="hidden" value=@clientRowId>
                @Html.Hidden("clientRowId", clientRowId.ToString())

                foreach (var category in Model)
                {
                    <div class="container">
                        @{
                            string[] nm = category.Key.Split('_');

                            if (@nm[2] == "textbox")
                            {
                                <div class="row">

                                    <div class="col-25" style="padding-top:16px;">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-75">
                                        @if (clientRowId == "992" || clientRowId == "993" || clientRowId == "994")
                                        {
                                            <span style="color:red; font-size:1.1rem;">  @nm[4] </span>
                                        }

                                        @if (nm[0].ToString() == "8")
                                        {
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' readonly>
                                        }
                                        else if (nm[0].ToString() == "121")
                                        {
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' readonly>
                                        }
                                        else if (nm[0].ToString() == "124")
                                        {
                                            if (clientRowId.ToString() == "2")
                                            {
                                                <input type="password" class="form-control" style="font-family: monospace;" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                            }
                                        }
                                        else if (nm[0].ToString() == "125")
                                        {
                                            if (clientRowId.ToString() == "2")
                                            {
                                                <input type="password" class="form-control" style="font-family: monospace;" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                            }
                                        }

                                        else
                                        {
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]">
                                        }

                                    </div>

                                </div>
                            }
                            if (@nm[2] == "dropdown")
                            {
                                <div class="row">

                                    <div class="col-25" style="padding-top:16px;">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-75">
                                        <span style="color:red; font-size:1.1rem;"> @nm[4] </span>
                                        @{
                                            string[] nmOption = nm[7].Split(',');
                                        }
                                        <select name=@nm[0] id=@nm[0] style="width:30rem!important;">
                                            @for (int i = 0; i < nmOption.Length; i++)
                                            {
                                                if (@nmOption[i].Trim() == @nm[6])
                                                {
                                                    <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                                }
                                                if (@nmOption[i].Trim() != @nm[6])
                                                {
                                                    <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                                }
                                            }
                                        </select>

                                    </div>

                                </div>

                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="row">
                                    <div class="col-25">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-75">
                                        <span style="color:red; font-size:1.1rem;"> @nm[4] </span>
                                        @{
                                            if (@nm[6] == "TRUE")
                                            {
                                                <input type="checkbox" id=@nm[0] name=@nm[0] value="checked" checked>
                                            }
                                            else
                                            {
                                                <input type="checkbox" id=@nm[0] name=@nm[0] value=@nm[0]>
                                            }
                                        }

                                    </div>

                                </div>
                            }
                            if (@nm[2] == "fileUpload")
                            {
                                <div class="row">
                                    <div class="col-25">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-75">
                                        <span style="color:red; font-size:1.1rem;">  @nm[4] </span>
                                        <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                        @if (@category.Value == "15")
                                        {
                                            <lable>Please Upload LOA</lable>
                                        }
                                        else
                                        {
                                            <a title='@category.Value' value=@nm[0] id="LOA" target="_blank" href='@Url.Content("~/Uploads/" + @category.Value)'>@category.Value</a>
                                        }

                                    </div>

                                </div>

                            }
                        }

                    </div>

                }
                <br />
                <br />

                <div class="container">
                    <div class="row">
                        <div class="col-sm-2">

                        </div>
                        <div class="col-sm-4" style="text-align:center;">
                            <input type="submit" value="Save" style="width:15rem!important;  padding:5% 0 5% 0; border-radius:.90rem; font-size:1.6rem!important;" id="btnSave" />
                        </div>
                        <div class="col-sm-6">

                        </div>
                    </div>
                </div>

            }

            <div class="container">
                <div class="row">
                    @{
                        string[] NextPreviousButtonsURL = (string[])(Session["NextPreviousButtonsURL"]);
                        for (int I = 0; I < NextPreviousButtonsURL.Length; I++)
                        {
                            if (NextPreviousButtonsURL[I] != null)
                            {
                                string[] Nenu1 = NextPreviousButtonsURL[I].Split('|');
                                if (Nenu1[2] == "Start")
                                {
                                    <div class="col-sm-9">
                                        <a href="~/Candidate/Home/ReIndex/@clsCommonMethods.PEncrypt( PersonalRowid.ToString())" class="GFG btn btn-primar"><span>&laquo;&laquo;  Previous </span></a>

                                    </div>
                                    <div class="col-sm-3">
                                        <a href="@Nenu1[0]" class="GFG btn btn-primar"><span>Next  &raquo;&raquo;</span></a>
                                    </div>
                                }
                            }
                        }
                    }
                </div>
            </div>
            <div class="container"></div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Scripts/normalizePlugin.js"></script>
    <script type="text/javascript">
    $(function () {
        //Bind Candidate code
        $('#CaseType').change(function () {
            if ($("#CaseType").val() == "Normal") {
                GetClientTAT();
                var tat = $('#hdnTAT').val();
                $('#TAT').val(tat);
                $('#TAT').attr("readonly", true);
            }
            if ($("#CaseType").val() == "Priority") {
                $('#TAT').val(0);
                $('#TAT').attr("readonly", false);
            }
        });
    });

    function GetClientTAT() {
        var url = "/ProvidedInfo/GetClientTATByCandidateId/" + $("#PersonalRowID").val();
        $.ajax({
            url: url,
            type: 'GET',
            async: false,
            dataType: 'json',
            success: function (tat) {
                $('#hdnTAT').val(tat);
            }
        });
    }

        function validateForm() {
            var ClientRowID = $('#ClientRowID').val();
            if (ClientRowID != 647 && ClientRowID != 576 )
            {
                var loa = $('#LOA').attr('title');
                var ct = $('#CandidateTermsFile').val();
                if (loa == "Blank" && ct == "") {
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please upload signed agreement</div>'
                    });
                    return false;
                }
            }

            var Mcountry = $('#ddlMobCountry').val();


            //$("#MobileNo").val('');
            var Mob_No = $('#MobileNo').val();
            if (Mob_No == "") {
                $("#MobileNo").focus();
                Swal.fire({
                    icon: 'info',
                    title: 'Info',
                    html: '<div class="errormsg" style="text-align:center;">Please fill mobile no</div>'
                });
                return false;
            }

            if (Mcountry == 'India') {
                var minLength = 10;
                var maxLength = 10;
                //$("#MobileNo").attr("maxlength", 10);
                //$("#MobileNo").attr("minlength", 10);

                var char = $("#MobileNo").val();
                var charLength = $("#MobileNo").val().length;
                if (charLength < minLength) {
                    $("#MobileNo").focus();
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please fill 10 degit mobile no</div>'
                    });
                    return false;
                } else if (charLength > maxLength) {
                    $("#MobileNo").focus();
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please fill 10 degit mobile no</div>'
                    });
                    return false;

                }

            }

                if (ClientRowID == 679)
                {
                    var value = $('#mydrpNationalIDProof').val();
                    if (value != "Pan Card") {
                        $("#mydrpNationalIDProof").focus();
                        Swal.fire({
                            icon: 'info',
                            title: 'Info',
                            html: '<div class="errormsg" style="text-align:center;">Please select PAN card detail</div>'
                        });
                        return false;
                    }
                }
            //// For TATA Elxsi

            if (ClientRowID== 635)
            {
                var PersonalIdProof = $('#PersonalIdProof').attr('title');
                var ct = $('#UploadIdProof').val();
                if (PersonalIdProof == "Blank" && ct == "") {
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please upload Id proof detail</div>'
                    });
                    return false;
                }

                var FatherName = $("#FatherName").val();
                if (FatherName == "") {
                    $("#FatherName").focus();
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please fill father name</div>'
                    });
                    return false;
                }

                var MaritalStatus = $("#mydrpMaritalStatus").val();
                if (MaritalStatus == "") {
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please fill Marital Status</div>'
                    });
                    return false;
                }

                var DOJ = $("#DateofJoining").val();
                if (DOJ == "") {
                    $("#DateofJoining").focus();
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please fill Date of Joining</div>'
                    });
                    return false;
                }


            }

            if (ClientRowID == 647 || ClientRowID == 576)
            {
                var doj = $("#DateofJoining").val();
                if (doj == "") {
                    $("#DateofJoining").focus();
                    Swal.fire({
                        icon: 'info',
                        title: 'Info',
                        html: '<div class="errormsg" style="text-align:center;">Please fill Date of Joining</div>'
                    });
                    return false;
                }

            }


            var dob = $('#DOB').val();

        var doj = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';

    if (dob != '') {
        var str = dob.split('-');
        var dojday1 = str[2];
        var dojmonth1 = str[1];
        var dojyear1 = str[0];

        var dateOfBorth = new Date(dojyear1, dojmonth1 - 1, dojday1);

        var str1 = doj.split('-');
        var day = str1[2];
        var month = str1[1];
        var year = str1[0];

        var DateOfJoin = new Date(year, month - 1, day)

        var timeDiff = DateOfJoin - dateOfBorth;

        var diffDays = timeDiff / (1000 * 3600 * 24 * 365);
        var age = parseInt(diffDays);

        if (age < 18) {
            Swal.fire({
                icon: 'info',
                title: 'Info',
                html: '<div class="errormsg" style="text-align:center;">Age should be more than 18 years. from date of joining</div>'
            });
            return false;
        }
    }

    if ($("#CaseType").val() == "Priority") {
        GetClientTAT();
        var tat = $("#TAT").val();
        var hdtat = $("#hdnTAT").val();
        if (tat >= hdtat) {
            Swal.fire({
                icon: 'info',
                title: 'Info',
                html: '<div class="errormsg" style="text-align:center;">Please enter valid TAT</div>'
            });
            return false;
        }
        }




    var count = 0;
        if (document.getElementById("#AadhaarCardNo").val() != '') {
        count += 1;
    }
        if (document.getElementById("#DrivingLicenseNo").val() != '') {
        count += 1;
    }
    if (document.getElementById("#PassportNo").val() != '') {
        count += 1;
    }
        if (document.getElementById("#PanCardNo").val() != '') {
        count += 1;
    }
        if (document.getElementById("#VoterIDCardNo").val() != '') {

        count += 1;
    }
    if (count == 0) {
        Swal.fire({
            icon: 'info',
            title: 'Info',
            html: '<div class="errormsg" style="text-align:center;">Please enter atleast one document no details</div>'
        });
        return false;
    }

        return true;



}
    </script>

