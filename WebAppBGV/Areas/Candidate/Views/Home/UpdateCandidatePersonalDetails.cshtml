<script>
    //validation for candidatename
    document.getElementById('121').onkeypress = function (e) {
        if (!(/[a-z ]/i.test(String.fromCharCode(e.keyCode)))) {
            e.preventDefault();
            return false;
        }
    }

    $("#19").keypress(function (e) {
        $("19").attr("min", "10");
        var valueLength = this.value.length;
        if (valueLength == 10) {
            return false;
        }
        var kk = e.which;
        if (kk < 48 || kk > 57)
            e.preventDefault();
    });

    $("#btnSave").click(function () {
        var obj = $('form input[type="text"]').NormalizedString();
        if (obj == false) {
            return false;
        }

    });


</script>
