
@model dynamic
@{    
    Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Home", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));

    string msg = "";
    if (Request.QueryString["ErrorMsg"] != null)
    {
       msg = Request.QueryString["ErrorMsg"].ToString();
    }
    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    var clid = "";
    clid = Session["ClientRowID"].ToString();


    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    int clientno = @ViewBag.clientno;
    bool NACheckStatus = ViewBag.NACheckStatus;

}

<style>

    input[type=text], textarea {
        width: 100%;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    select {
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    label {
        padding: 12px 12px 12px 0;
        display: inline-block;
    }

    input[type=submit] {
        background-color: #04AA6D;
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        float: right;
    }

        input[type=submit]:hover {
            background-color: #45a049;
        }

    .container {
        border-radius: 5px;        
        font-size: 1.2rem !important;
    }

    .col-25 {
        float: left;
        width: 25%;
        margin-top: 20px;
    }

    .col-75 {
        float: left;
        width: 75%;
        margin-top: 6px;
    }

    #UplodVerificationDocs {
        margin-right: 0px !important;
        padding: 8% 7% 8% 7% !important;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }

    @@media screen and (max-width: 600px) {
        .col-25, .col-75, input[type=submit] {
            width: 100%;
            margin-top: 0;
        }
    }
</style>

<div class="card shadow-sm  bg-white rounded">
    @section LeftNavigation{ @Html.Partial("_NavLeftCandidateCaseInfoProvided") }
    @section DisplayTitle{ @Html.Partial("_DisplayTitle") }   
    @section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
</div>

@if (ViewBag.ErrorMsg != null)
{
    string err = @ViewBag.ErrorMsg.ToString();
    string[] err2 = err.Split(',');
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Mandatory Fields.',
            html: '<div class="errormsg" style="text-align:left;"><ol type="1">@foreach(String item in err2){<li> @item</li> }</ol></div>'
       })
    </script>
}
@if (ViewBag.Success != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            html:'<div class="errormsg">@ViewBag.Success.ToString()</div>',
            showConfirmButton: false,
            timer: 1500
        })
    </script>
}

<div class="row" style="background:rgba(141, 195, 255, .1);width:auto!important;">
    <div class="col-md-12 mt-4">
        <div>
            @using (Html.BeginForm("AddEmployment_Info", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
                @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

                <input id="SubCheckId" type="hidden" value=@SubCheckId>
                @Html.Hidden("SubCheckId", SubCheckId.ToString())

                <input id="clientRowId" type="hidden" value=@clientRowId>
                @Html.Hidden("clientRowId", clientRowId.ToString())

                <input type="hidden" id="OrganizationNameTemp" name="OrganizationNameTemp" value="@ViewBag.CompanyName" />

                @Html.ValidationSummary()


                <div id="NADiv" class='col-md-7' style="background-color:#3498db;height:30px;">
                    <center style="margin-top:5px;">
                        @if (clid == "974" || clid == "1089")
                        {
                            @Html.CheckBox("Notraised", NACheckStatus, new { onchange = "NotRaised(this)", @style = "display:none;" })
                        }
                        else
                        {
                            <label class="checkbox-inline" style="margin:-5px 20px 0 10px">
                                @Html.CheckBox("Notraised", NACheckStatus, new { onchange = "NotRaised(this)" })<b style="color:white">Not Applicable</b>
                            </label>
                        }

                    </center>
                </div>

                foreach (var category in Model)
                {
                    <div class="container">
                        @{
                            string[] nm = category.Key.Split('_');

                            if (@nm[2] == "textbox")
                            {
                                if (@nm[0] == "92") //"Organisation Name"
                                {

                                    <div class="row">
                                        <div class="col-25">
                                            @*<p style="color:red;">@nm[4]</p>*@

                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-25">
                                            @if (nm[4].ToString() != "")
                                            {
                                                <br />

                                            }
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <h7>*</h7>
                                                }
                                            }

                                            Organization Name
                                        </div>
                                        <div class="col-75">
                                            <span style="color:red; font-size:1rem;"> @nm[4] </span>
                                            <input type="text" class="form-control" id="OrganizationName" name="OrganizationName" value='@category.Value' maxlength="@nm[5]" />
                                            <input type="hidden" class="form-control" id="OrganizationId" name="OrganizationId" value=@ViewBag.OrgId />
                                        </div>
                                    </div>

                                }
                                else if (@nm[1] == "Address of the company")
                                {
                                    <div class="row">
                                        <div class="col-25">
                                            Address of the company
                                        </div>
                                        <div class="col-75">
                                            <input type="text" id="Addressofthecompany" name="Addressofthecompany" value='@category.Value' class="form-control" maxlength="@nm[5]" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-25">
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <h7>*</h7>
                                                }
                                            }
                                            @nm[1]
                                        </div>
                                        <div class="col-75">
                                            <span style="color:red; font-size:1.1rem;"> @nm[4] </span>
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@category.Value' maxlength="@nm[5]" autocomplete="off">
                                        </div>

                                    </div>
                                }
                            }
                            if (@nm[2] == "dropdown")
                            {
                                <div class="row">

                                    <div class="col-25">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-75">
                                        <span style="color:red; font-size:1.1rem;"> @nm[4] </span>
                                        @{
                                            string[] nmOption = nm[7].Split(',');
                                        }
                                        <select name=@nm[0] id=@nm[0] style="width: 30rem !important;">
                                            @for (int i = 0; i < nmOption.Length; i++)
                                            {
                                                if (@nmOption[i].Trim() == @nm[6])
                                                {
                                                    <option value="@nmOption[i].ToString()" selected>@nmOption[i]</option>
                                                }
                                                if (@nmOption[i].Trim() != @nm[6])
                                                {
                                                    <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                                }
                                            }
                                        </select>

                                    </div>

                                </div>

                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="row">
                                    <div class="card" style="margin-top:10px!important;">
                                        <div class="card-body" style="display:flex!important;">

                                            <div class="col-sm-1">

                                                @{
                                                    if (@nm[6] == "TRUE")
                                                    {
                                                        <input type="checkbox" id=@nm[0] name=@nm[0] value="checked" checked style="width:5rem!important;">
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" id=@nm[0] name=@nm[0] value=@nm[0] style="width:5rem!important;">
                                                    }
                                                }

                                            </div>
                                            <div class="col-sm-11">
                                                @{
                                                    if (@nm[3] == "mandatory")
                                                    {
                                                        <h7>*</h7>
                                                    }
                                                }
                                                <spn style="color:red;">@nm[1]</spn>
                                            </div>
                                            <div class="col-25">
                                                @nm[4]
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            if (@nm[2] == "fileUpload")
                            {
                                <div class="row">
                                    <div class="col-25">
                                        @{
                                            if (@nm[3] == "mandatory")
                                            {
                                                <h7>*</h7>
                                            }
                                        }
                                        @nm[1]
                                    </div>
                                    <div class="col-75">
                                        <span style="color:red; font-size:1.1rem;"> @nm[4] </span>
                                        <input type="file" id=@nm[0] name=@nm[0] accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                    </div>

                                </div>

                            }
                        }

                    </div>

                }
                <div class="row">
                    <div class="col-sm-12 cytoscape-parent">
                        <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                    </div>
                </div>

                <br />
                <div class="container">
                    <div class="row">
                        <div class="col-sm-3">

                        </div>
                        <div class="col-sm-2" style="text-align:center;">
                            <input type="submit" value="Submit" style="width:12.2rem!important; padding:7% 0 7% 0; border-radius:.90rem; font-size:1.6rem!important;" id="btnSave" />
                        </div>
                        <div class="col-sm-2">
                            @Html.ActionLink("Upload Document", "UploadCandidateDocumentUpdated", "Home", new { subCheckId = SubCheckId }, new { @class = " btn btn-primary", @id = "UplodVerificationDocs" })
                        </div>
                        <div class="col-sm-2"></div>
                    </div>
                </div>
            }
            <div class="container">
                <div class="row">
                    @{
                        string[] NextPreviousButtonsURL = (string[])(Session["NextPreviousButtonsURL"]);
                        for (int I = 0; I < NextPreviousButtonsURL.Length; I++)
                        {
                            if (NextPreviousButtonsURL[I] != null)
                            {
                                string[] Nenu1 = NextPreviousButtonsURL[I].Split('|');
                                string NextURL = Nenu1[0];
                                if (Nenu1[0] == "End")
                                {
                                    NextURL = Nenu1[1];
                                }
                                if (SubCheckId == Nenu1[4].ToString())
                                {
                                    if (Nenu1[2] != "Start")
                                    {
                                        <div class="col-sm-3">
                                            <a href="@Nenu1[1]" class="GFG btn btn-primar"><span>&laquo;&laquo; Previous</span></a>
                                        </div>
                                    }
                                    else if (Nenu1[2] == "Start")
                                    {
                                        <div class="col-sm-3">
                                            <a href="~/Candidate/Home/UpdateCandidateDetails/@PersonalRowid" class="GFG btn btn-primar"><span>&laquo;&laquo; Previous</span></a>
                                        </div>
                                    }

                                    if (Nenu1[3] != "End")
                                    {
                                        <div class="col-sm-5">
                                        </div>
                                        <div class="col-sm-3">
                                            <a href="@NextURL" class="GFG btn btn-primar"><span>Next &raquo;&raquo;</span></a>
                                        </div>
                                    }
                                    else if (Nenu1[3] == "End")
                                    {

                                        <div class="col-sm-4">
                                            <a href="~/Candidate/Home/FinalSubmit/@PersonalRowid" class="GFGSubmit btn btn-primar" style="padding: 5px 75px;"><span>Final Submission</span></a>
                                        </div>
                                    }
                                }
                            }

                        }

                    }

                </div>
            </div>
            <br />
            <br />
        </div>
    </div>
</div>

