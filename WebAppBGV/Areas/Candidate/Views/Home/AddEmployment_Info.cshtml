                changeYear: true,
                showButtonPanel: true,
                yearRange: '-65:+10',
            });

            $('#89').datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                yearRange: '-65:+10',
            });
        })

        $('#89').bind('copy paste cut', function (e)
        {
            e.preventDefault();
        });
        $('#88').bind('copy paste cut', function (e) {
            e.preventDefault();
        });


    </script>
    <script>
        $("#btnSave").click(function () {
            var obj = $('form input[type="text"]').NormalizedString();
            if (obj == false) {
                return false;
            }
        });

    </script>
    <style>
        .GFG {
            background-color: #11c9b7; /*#45a049;*/
            border: 2px solid rgb(255 255 255 / 15%);
            padding: 5px 10px;
            color: #f8f9fa;
            text-align: center;
            display: inline-block;
            font-size: 16px;
            margin: 0px 0px;
            cursor: pointer;
            transition: all 0.5s;
        }

            .GFG span:focus {
                content: '\00bb';
                position: absolute;
                opacity: 0;
                top: 0;
                right: -20px;
                transition: 0.5s;
            }

            .GFG:hover {
                background: #fc223d;
                color: black;
            }
    </style>
    <style>
        .GFGSubmit {
            background-color: #11c9b7; /*#45a049;*/
