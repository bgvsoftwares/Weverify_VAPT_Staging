            padding: 5px 10px;
            color: #f8f9fa;
            text-align: center;
            display: inline-block;
            font-size: 16px;
            margin: 0px 0px;
            cursor: pointer;
            transition: all 0.5s;
        }

            .GFGSubmit span:focus {
                content: '\00bb';
                position: absolute;
                opacity: 0;
                top: 0;
                right: -20px;
                transition: 0.5s;
            }

            .GFGSubmit:hover {
                background: #fc223d;
                color: black;
            }
    </style>


    <script>

        $(document).ready(function () {

            $('#142').on('change', function (e) {

                if ($('#142').val() == 'Fulltime' && '@ViewBag.clientno' == '1190') {

                    $("#143").val('Not Applicable');

                }

                else if ($('#142').val() == 'Part time' && '@ViewBag.clientno' == '1190') {

                    $("#143").val('');

                }

                else if ($('#142').val() == 'Through Outsourcing Agency' && '@ViewBag.clientno' == '1190') {

                    $("#143").val('');

                }

                else if ($('#142').val() == 'Not Applicable' && '@ViewBag.clientno' == '1190') {

                    $("#143").val('Not Applicable');

                }

                else {

                    $("#143").val('');

                }

            }).trigger('change');

        });

    </script>

}




