    <script type="text/javascript">
        $(document).ready(function () {

            if ('@ViewBag.NACheckStatus' == 'True')
            {
                $("#OrganizationName").val('Not Applicable');
                $("#141").val('Not Applicable');
                $("#93").val('Not Applicable');
                $("#143").val('Not Applicable');
                $("#147").val('Not Applicable');
                $("#95").val('Not Applicable');
                $("#94").val('Not Applicable');
                $("#87").val('Not Applicable');

                $("#149").val('Not Applicable');
                $("#150").val('Not Applicable');
                $("#148").val('Not Applicable');
                $("#96").val('Not Applicable');
                $("#147").val('Not Applicable');

                $("#91").val('Not Applicable');
                $("#88").val('Not Applicable');
                $("#89").val('Not Applicable');
            }
          if (('@ViewBag.clientno' != '576') || ('@ViewBag.clientno' == '576' && '@ViewBag.SubCheckId'!='68')) {

                $('#NADiv').show();
            }
            else {

                $('#NADiv').hide();
            }


            $("#OrganizationName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Candidate/Home/getEmployerlist",
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.CompanyName, value: item.CompanyRowID };
                            }))
                        }
                    })
                },
                minLength: 3,
                select: function (event, ui) {
                    event.preventDefault();
                },
                focus: function (event, ui) {
                    event.preventDefault();
                    var OrgName = ui.item.label;
                    $("#OrganizationName").val(OrgName);
                    $("#OrganizationNameTemp").val(OrgName);
                    $('#OrganizationId').val(ui.item.value);

                }
            });
        })

        $("#OrganizationName").blur(function () {
            if ($("#OrganizationName").val().trim() != $("#OrganizationNameTemp").val().trim()) {
                //alert($("#OrganizationName").val());
                //alert($("#OrganizationNameTemp").val());
                $("#OrganizationName").val("");
                $('#Addressofthecompany').val("");
                $('#OrganizationId').val("0");
            }
        });

        $(function () {
            $('#OrganizationName').change(function () {
                var CurOrg = $("#OrganizationName").val();
                var url = "/ProvidedInfo/EmploymentAddress/" + $("#OrganizationId").val();

                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (Address) {
                        $('#Addressofthecompany').val(Address);
                    }
                });
            });
        });

    </script>
    <script>
        //validation for candidatename
        document.getElementById('141').onkeypress = function (e) {
            if (!(/[a-z ]/i.test(String.fromCharCode(e.keyCode)))) {
                e.preventDefault();
                return false;
            }
        }
        document.getElementById('95').onkeypress = function (e) {
            if (!(/[a-z ]/i.test(String.fromCharCode(e.keyCode)))) {
                e.preventDefault();
                return false;
            }
        }

        document.getElementById('148').onkeypress = function (e) {
            if (!(/[a-z ]/i.test(String.fromCharCode(e.keyCode)))) {
                e.preventDefault();
                return false;
            }
        }

        //validation for candidatename


        //validation for Mobile Number and Pincode


        $("#147").keypress(function (e) {
            $("150").attr("min", "10");
            var valueLength = this.value.length;
            if (valueLength == 10) {
                return false;
            }
            var kk = e.which;
            if (kk < 48 || kk > 57)
                e.preventDefault();
        });

        $("#150").keypress(function (e) {
            $("150").attr("min", "10");
