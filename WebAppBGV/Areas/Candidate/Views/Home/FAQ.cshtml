@{
    ViewBag.Title = "FAQ";
    Layout = "~/Areas/Candidate/Views/Shared/_Layout.cshtml";

    string faIcon = string.Format("<i class='fa fa-reply' aria-hidden='true'></i> Back");
    string hyperLink = Html.ActionLink("linkTitle", "Index", "Home", null, new { @class = "headerbacklink" }).ToString();
    ViewBag.TitleBackBtn = new HtmlString(hyperLink.ToString().Replace("linkTitle", faIcon));
}
@section LeftNavigation{ @Html.Partial("_NavLeftCandidateCaseInfoProvided") }
@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@*@section DisplayMandatory{ @Html.Partial("_DisplayMandatory") }*@
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<!-- Interenal Accordion Css -->
<link href="~/assets/plugins/accordion/accordion.css" rel="stylesheet" />

<div class="row">
    <div class="col-lg-12 col-md-12">
        <div class="card overflow-hidden h-auto shadow-none rounded-0">
            <div class="card-header pb-0">
                <h3 class="card-title">What is WeVerify ?</h3>
                <p class="text-muted card-sub-title mb-0">
                    <span style="color:#8D5FFF; font-weight:bolder;">WeVerify</span> <span style="color:#031f30;">
                        is an automated application, which supports the BGV process across the globe.It is a complete module for pre & post hire screening process. The application allows minimal paper work as well as minimal email communications for tracking the live status
                        Account & Log-in.
                    </span>
                </p>
            </div>
            <div class="card-body">
                <ul class="accordion-list">
                    <li class="accordion_ul_li">
                        <h3>System Configuration & Settings </h3>
                        <div class="answer">
                            <ul class="mb-2" style="list-style-type:decimal;">
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        The link provided is not responding.
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list"><span>Step 1 :</span> Check the network settings</li>
                                        <li class="accordion-list"><span>Step 2 :</span> The application is on a secure platform with latest information security features, need to use <span style="color:#8d5FFF; font-weight:bolder;">Mozilla Firefox & Google Chrome.</span></li>
                                    </ul>
                                    <p class="m-0 ps-4 mt-2">If same error still pertains, need to share screenshot to the concerned HR, keeping <span style="color:#8d5FFF; font-weight:bolder;">bgv.helpdesk@securitas-india.com</span> in loop</p>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        Application is accessible, however not responding while user is clicking on the dashboard links.
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">User need to allow the pop-ups for all the functions of application to process smoothly. The links would direct user to applicable window/case count.</li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
                <ul class="accordion-list">
                    <li class="accordion_ul_li">
                        <h3>Size Limitation</h3>
                        <div class="answer">
                            <ul class="mb-2" style="list-style-type:decimal;">
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        Are there any file/size limitations for documents being uploaded in the application?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">Yes, the application does have some limitations.</li>
                                        <li class="accordion-list">It cannot accommodate files larger than 30MB if documentation exceeds this size, the documents may need to be split into two or more transactions.</li>
                                    </ul>
                                    <p class="m-0 ps-4 mt-2">If same error still pertains, need to share screenshot to the concerned HR, keeping <span style="color:#8d5FFF; font-weight:bolder;">bgv.helpdesk@securitas-india.com</span> in loop</p>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        What formats are acceptable for uploads?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">We can accept PDF, TIF, JPG and PJPEG formats for upload.</li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
                <ul class="accordion-list">
                    <li class="accordion_ul_li">
                        <h3>Background Verification Process</h3>
                        <div class="answer">
                            <ul class="mb-2" style="list-style-type:decimal;">
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        What is the process of updating details in the application?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">For knowing the process on how to update details on the application you may download the Candidate User Manual available on the portal.</li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        What is LOA and how do we upload it?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">LOA is Letter of authorization and one needs to first download and take a printout of the following document and fill the required details and further scan it or take a picture of that same document and further upload it.</li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        In case my current and permanent address are same
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">In such scenario you can only update details for Permanent address and can select NA in Current Address so that you do not have to update the details.</li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I recently shifted so I don’t have any address proof where I’m currently residing. Please suggest an alternative.
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            Any address proof will work whether it’s in the name of your parents/husband/landlord, but an address proof is necessary.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I’m currently residing in one of my relative’s house, so I don’t have any current address proof with me. Please suggest an alternative.
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            One can submit any of the mentioned document which confirms the address and it can be in the name of your relative as well.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        Do we need to upload all the documents in our highest qualification?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            No, one of the mentioned document is sufficient.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I recently graduated from college, I have not received by degree yet. So, what should I upload in this case?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            One can either upload the mark sheet or provisional certificate.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        What is Current Employment?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            Current employment is your most recent employment.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        Do I have to update my current employment details even if I’m working there
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            Yes, you will have to update your current employment details even if you are working there however you may mention the same in tenure as still working or serving notice till DD/MM/YYYY.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I have only worked in 1 organization before this, what do I have to upload in the other previous employment verification?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            Once you access the tab of the previous employment verification, you’ll be provided with an option on the top of the page saying not applicable. Kindly select that option and further press submit.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I still haven’t received my relieving letter from my previous organization. What should I upload in this case?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            One then needs to upload their resignation letter of the previous organization in the following case.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I have lost my relieving letter of my previous organization. Please assist on the following.
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            Kindly upload the resignation letter or contact your previous organization and ask for another copy and upload the same as soon as possible.
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I don’t know the company name of the Reference
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            In case you are not sure about the current organization of your previous reporting manager, ex-colleague, then you may leave it blank
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
                <ul class="accordion-list">
                    <li class="accordion_ul_li">
                        <h3>Application Error</h3>
                        <div class="answer">
                            <ul class="mb-2" style="list-style-type:decimal;">
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I have uploaded all the information but I’m not able to submit my application
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list"> Kindly make sure that all the bars are green, if not some of the information or document is left unattended. If same pertains, then need to write to the concerned HR, keeping bgv.helpdesk@securitas-india.com in loop.</li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        All the bars are green but I’m still not able to submit the documents.
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">Please check there might be some document or question unattended.</li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        I uploaded my document and filled the other required details but as soon as I submitted everything went blank.
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">The details are to be filled first and then upload the document. Then this issue will not appear.</li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        If I have attached any wrong documents, so can I replace it with correct documents?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            Yes, you can again upload the document from the same browse button, it will replace the previously uploaded document
                                        </li>
                                    </ul>
                                </li>
                                <li class="mb-2">
                                    <span class="fw-bold">
                                        How would I know that my application has been submitted?
                                    </span>
                                    <ul style="list-style-type:disc;">
                                        <li class="accordion-list">
                                            After submitting your application, you’ll receive a thank you email from the vendor which will confirm that your application has been successfully submitted.
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
