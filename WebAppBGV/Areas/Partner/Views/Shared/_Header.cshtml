<div class="row">
    <div class="col-sm-3 col-3 col-xs-3 col-md-3 col-lg-3 col-xl-3">
        <div class="logo_inner_client">BGV</div>
    </div>
    @if (Session["UserName"] != null)
    {
        <div class="col-sm-6 col-6 col-xs-6 col-md-6 col-lg-6 col-xl-6">
            <div class="middle_client_name" style="color:#000!important;">@Session["VendorName"].ToString()</div>
        </div>
        <div class="col-sm-2 col-2 col-xs-2 col-md-2 col-lg-2 col-xl-2">
            @if (Session["UserType"] != null && Session["UserType"].ToString() == "0")
            {
                <div class="user-top" style="color:#000!important;">@Session["ContactPerson"].ToString() (Partner)</div>
            }
            else
            {
                <div class="user-top" style="color:#000!important;">@Session["ContactPerson"].ToString() (Partner User)</div>
            }
        </div>
        @*<div class="col-sm-2 col-2 col-xs-2 col-md-2 col-lg-2 col-xl-2">
                <div class="logoff">@Html.ActionLink("Log Off", "LogOutVendor", "Account", new { area = "" }, new { @class = "btn bun-bg btn-default" })</div>
            </div>*@
        <div class="col col-lg-1 text-left">
            <button class="logout-btn" type="button" style="margin:15px 0px 0px 20px!important;">@Html.ActionLink("LogOut", "LogOutVendor", "Account", new { area = "" }, new { @class = "btn bun-bg btn-default" })<i class="fa fa-sign-out" aria-hidden="true"></i></button>
        </div>
    }
    else
    {
        <div class="col-md-6">
            <div class="middle_client_name">&nbsp;</div>
        </div>
        <div class="col-md-2">
            <div class="user-top">&nbsp;</div>
        </div>
        <div class="col-md-1">
            <div class="logoff">&nbsp;</div>
        </div>
    }
</div> 

<style>
    .user-top {
        font-size: 16px !important;
        /*color: #fff !important;*/
        text-align: right !important;
        margin-top: 18px !important;
        font-weight: 700 !important;
        font-family: 'Open Sans',sans-serif;
    }
</style>
