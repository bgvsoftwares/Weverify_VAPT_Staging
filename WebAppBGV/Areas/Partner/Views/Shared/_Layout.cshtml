<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BGV Vendor - @ViewBag.Title</title>
    <link href='@Url.Content("~/Content/bootstrap.min.css")' rel="stylesheet" type="text/css" />
    <link href='@Url.Content("~/Content/bootstrap-theme.min.css")' rel="stylesheet" />
    <link href='@Url.Content("~/Content/Site.css")' rel="stylesheet" type="text/css" />
    <link href='@Url.Content("~/Content/Style.css")' rel="stylesheet" type="text/css" />
    <script src='@Url.Content("~/Scripts/modernizr-2.8.3.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery-3.7.1.min.js")'></script>
    <script src='@Url.Content("~/Scripts/DisableBackForwordBtn.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <link href="~/Content/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/Content/New_Dashboard.css" rel="stylesheet" type="text/css" />
    <link href='@Url.Content("~/Content/custom.min.css")' rel="stylesheet" type="text/css" />

</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="header">
                    @Html.Partial("_Header")
                    <div class="row">
                        <div class="col-md-12">
                            <nav class="navbar navbar-default navbar-static-top" role="navigation">
                                <div class="container">
                                    <div class="navbar-collapse" id="navbar-collapse-1">
                                        <ul class="nav navbar-nav">
                                            <li><a href='@Url.Action("Index", "Home", new { area = "Partner" })'><i class="fa fa-home" aria-hidden="true"></i> Home</a></li>
                                            @*@if (Session["UserType"] != null && Session["UserType"].ToString() == "0")
                                                {
                                                    <li><a href='@Url.Action("AllocationToPatenerUser", "Home", new { area = "Partner" ,version="New",CaseStatus="UnAllocated"})'> Allocation To Partner Users </a></li>
                                                    <li><a href='@Url.Action("ManagePartnerAllocatedChecks", "Home", new { area = "Partner",version="New",CaseStatus="UserAllocated" })'> Manage Partner Allocated Checks</a></li>
                                                    <li><a href='@Url.Action("ManagePartnerReScynChecks", "Home", new { area = "Partner" })'> Re-Sync To Partner Users</a></li>
                                                    <li><a href='@Url.Action("DownloadMobApp", "Home", new { area = "Partner" })'> Download Mobile App</a></li>
                                                }
                                                else if (Session["UserType"] != null && Session["UserType"].ToString() == "1")
                                                {
                                                <li><a href='@Url.Action("ManagePartnerUserAllocatedChecks", "Home", new { area = "Partner" })'>Manage Allocated Checks</a></li>
                                                }*@
                                        </ul>
                                    </div>
                                </div>
                            </nav>
                        </div>
                    </div>
                </div>

                <div class="master-middle">
                    <div class="">
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <table width="100%" align="center">
                                <tr>
                                    @*<td width="16%" valign="top" class="left-frame">
                                            @RenderSection("LeftNavigation", required: false)
                                        </td>
                                        <td width="1%" valign="top">&nbsp;</td>*@
                                    <td valign="top" class="right-frame">
                                        @RenderSection("DisplayTitle", required: false)
                                        @RenderSection("DisplayErrorMessage", required: false)
                                        @RenderBody()
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="footer">
                    @Html.Partial("_Footer")
                </div>
            </div>
        </div>
    </div>

    <script src='@Url.Content("~/Scripts/bootstrap.min.js")'></script>
    @RenderSection("scripts", required: false)
</body>
</html>
