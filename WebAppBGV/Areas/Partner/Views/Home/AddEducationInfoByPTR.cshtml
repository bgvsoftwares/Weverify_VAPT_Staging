@using WebAppBGV.CommonMethods;
@model dynamic


@{
    string PersonalRowid = "";
    string SubCheckId = "";
    string clientRowId = "";
    string CheckStatuss = "";
    string checkStatusid = "";
    string degreeid = "";
    string degreeName = "";
    string CandCheckRowid = "";
    string TeamMemberRowID = "";

    PersonalRowid = @ViewBag.PersonalRowid;
    SubCheckId = @ViewBag.SubCheckId;
    clientRowId = @ViewBag.clientRowId;
    CheckStatuss = @ViewBag.CheckStatus;
    checkStatusid = @ViewBag.checkStatusid;
    CandCheckRowid = @ViewBag.CandCheckRowID;
    degreeName = @ViewBag.degreeName.Trim();    
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }

<div class="row">
    <div class="col-md-12">
        <div class="container">
            @if (ViewBag.ErrorMsg != null)
            {
                <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="errormsg">@ViewBag.Success.ToString()</div>
            }
            @using (Html.BeginForm("AddEducationInfoByPTR", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input id="PersonalRowid" type="hidden" value=@PersonalRowid>
                @Html.Hidden("PersonalRowid", PersonalRowid.ToString())

                <input id="SubCheckId" type="hidden" value=@SubCheckId>
                @Html.Hidden("SubCheckId", SubCheckId.ToString())

                <input id="clientRowId" type="hidden" value=@clientRowId>
                @Html.Hidden("clientRowId", clientRowId.ToString())

                <input id="checkStatusid" type="hidden" value=@checkStatusid>
                @Html.Hidden("checkStatusid", checkStatusid.ToString())

                @*<input id="CheckStatuss" type="hidden" value=@CheckStatuss>
                @Html.Hidden("CheckStatuss", CheckStatuss.ToString())*@

                <input type="hidden" id="CollegeId" name="CollegeId" value=@ViewBag.CollgegIdn />
                <input type="hidden" id="CollegeNameTemp" name="CollegeNameTemp" />

                <input id="Hfdegreeid" type="hidden" value=@degreeid>
                @Html.Hidden("Hfdegreeid", degreeid.ToString())

                @Html.Hidden("HfdegreeName", degreeName.ToString())
                foreach (var category in Model)
                {
                    <div class="row" style="margin-bottom:10px;">
                        @{
                            string[] nm = category.Key.Split('_');
                            string[] temp = category.Value.Split('_');


                            if (@nm[2] == "textbox")
                            {
                                <div class="col-md-4">
                                    @if (nm[4] != "")
                                    {
                                        <p style="margin-top:30px!important;">
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }
                                            @nm[1]
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            @if (@nm[3] == "mandatory")
                                            {
                                                <span style="color:red!important;">*</span>
                                            }
                                            else
                                            {
                                                <span style="color:red!important;">&nbsp;</span>
                                            }
                                            @nm[1]
                                        </p>
                                    }
                                </div>
                               

                                if (temp.Count() > 1 && @temp[1] != "")
                                {
                                    if (@nm[0] == "66")
                                    {
                                        <div class="col-md-8">
                                            <textarea name="66" id="66">@temp[1]</textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            @if (nm[4] != "")
                                            {
                                                <p style="color:red">@nm[4]</p>
                                            }
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[1]' autocomplete="off" maxlength="@nm[5]">
                                        </div>
                                    }
                                }
                                else
                                {
                                    if (@nm[0] == "66")
                                    {
                                        <div class="col-md-8">
                                            <textarea name="66" id="66">@temp[0]</textarea>
                                        </div>

                                    }
                                    else
                                    {
                                        <div class="col-md-4">
                                            @if (nm[4] != "")
                                            {
                                                <p style="color:red">@nm[4]</p>
                                            }
                                            <input type="text" class="form-control" name=@nm[0] id=@nm[0] value='@temp[0]' autocomplete="off" maxlength="@nm[5]">
                                        </div>

                                    }
                                }
                            }
                            if (@nm[2] == "dropdown")
                            {

                                <div class="col-md-4">
                                    @{
                                        if (@nm[3] == "mandatory")
                                        {
                                            <h7>*</h7>
                                        }
                                    }
                                    @nm[1]
                                </div>
                               
                                <div class="col-md-4">
                                    @nm[4]
                                    @{
                                        int lastindex = nm.Length;
                                        string[] nmOption = nm[lastindex - 1].Split(',');
                                        string Fvalue = "";
                                        Fvalue = nm[lastindex - 2].ToString();
                                        if (Fvalue == "")
                                        {
                                            Fvalue = nm[lastindex - 3].ToString();
                                        }
                                    }
                                    <select name=@nm[0] id='@nm[0]' autocomplete="off">
                                        @for (int i = 0; i < nmOption.Length; i++)
                                        {
                                            if (@nmOption[i].Trim() == Fvalue)
                                            {
                                                <option selected>@nmOption[i]</option>

                                            }
                                            else
                                            {

                                                <option value="@nmOption[i].ToString()">@nmOption[i]</option>
                                            }

                                        }
                                    </select>

                                    @Html.Hidden("HfdegreeName")
                                    <input id="HfdegreeName" type="hidden" value=@degreeName>


                                </div>


                            }
                            if (@nm[2] == "checkbox")
                            {
                                <div class="container">
                                    <div class="row">
                                        <div class="col-sm">
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <h7>*</h7>
                                                }
                                            }
                                            @nm[1]
                                        </div>
                                        <div class="col-sm">

                                            @{
                                                if (@nm[6] == "TRUE")
                                                {
                                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value="checked" checked autocomplete="off">
                                                }
                                                else
                                                {
                                                    <input type="checkbox" style="width:2rem!important;" id=@nm[0] name=@nm[0] value=@nm[0] autocomplete="off">
                                                }
                                            }

                                        </div>

                                    </div>
                                </div>

                            }
                            if (@nm[2] == "fileUpload")

                            {
                                <div class="container">
                                    <div class="row">
                                        <div class="col-sm">
                                            @{
                                                if (@nm[3] == "mandatory")
                                                {
                                                    <h7>*</h7>
                                                }
                                            }
                                            @nm[1]
                                        </div>
                                        <div class="col-sm">
                                            <input type="file" id=@nm[0] name='@nm[0]' autocomplete="off" accept=".png, .jpg, .jpeg, .pdf, .doc, .zip, .msg">
                                        </div>

                                    </div>
                                </div>

                            }
                        }

                    </div>

                }
                <div class="row">
                    <div class="col-sm-12 cytoscape-parent">
                        <div class="w-400 h-400 d-inline-block" id="cytoscape-container"></div>
                    </div>
                </div>

                <div class="form-group branch row ">

                    @Html.Label("CheckStatus", htmlAttributes: new { @class = "col-md-2 control-label" })
                    <div class="col-md-3">
                        @Html.DropDownList("CheckStatus", new List<SelectListItem>{
                       new SelectListItem{Text="Completed", Value="Completed"},
                       new SelectListItem{Text="Re-Visit", Value="Re-Visit"},
                       new SelectListItem{Text="Not-Doable", Value="Not-Doable"}
                   },"-- Select --", new { @class = "form-control" })
                    </div>
                </div>

                @Html.ActionLink("Back", "ManagePartnerAllocatedChecks", "Home", new { }, new { @class = "btn btn-default VerEmailDetails" })

                <div class="container" style="margin-bottom:30px!important;">
                    <div class="row">
                        <div class="col-sm">
                            <input type="submit" value="Submit" style="width:15rem!important; padding:5% 0 5% 0; border-radius:.90rem; font-size:1.6rem!important;" />
                        </div>
                        <div class="col-sm">
                            @Html.ActionLink("Attachment", "UplodEducationVerDocs", "Home", new { scid = SubCheckId, pe = PersonalRowid }, new { @class = "iframeUpdateVerDoc cboxElement callbacks btn btn-default", @id = "UplodVerificationDocs" })
                        </div>
                    </div>
                </div>

            }

        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/colorbox.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.colorbox-min.js"></script>
    <script src="~/Scripts/tinymceNew.min.js"></script>
    <script src="~/Scripts/tinymce-jquery.min.js"></script>

    <script>
        $('textarea').tinymce({
            height: 200,
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
                'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic backcolor | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | removeformat | help'
        });
        // Prevent jQuery UI dialog from blocking focusin
        $(document).on('focusin', function (e) {
            if ($(e.target).closest(".tox-tinymce, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length) {
                e.stopImmediatePropagation();
            }
        });
    </script>
    <script>
        $(document).ready(function () {
            $(".iframeActionHistories").colorbox({ iframe: true, width: "90%", height: "90%" });
        });
    </script>
    <style>
        .tox-tinymce {
            margin-top: 10px !important;
        }

        .tox-editor-header {
            box-shadow: none !important;
            z-index: 0 !important;
            border-bottom: 0.5px solid #000 !important;
        }

        .tox-statusbar__branding {
            display: none !important;
        }

        .mce-notification {
            display: none !important;
        }
    </style>
    <style>
        .ui-widget.ui-widget-content {
            width: 20%;
        }

        img {
            width: 50px;
            height: 25px;
        }
    </style>
    <script type="text/javascript">
                $(document).ready(function () {
                    var ErrorMsg = '@(ViewBag.ErrorMsg)';
                    var IsPV = '@(ViewBag.IsPV)';
                    if (ErrorMsg=='')
                    {
                        if (IsPV == '') {
                            $('#VerificationCloserDetails').css('visibility', 'visible');
                        }
                        else if (IsPV == 'Physical Verification') {
                            $('#VerificationCloserDetails').css('visibility', 'hidden');
                        }

                    }
                    else
                    {
                        $('#VerificationCloserDetails').css('visibility', 'hidden');
                    }

            $(".iframeUpdateStatus").colorbox({ iframe: true, width: "90%", height: "90%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(false);
                }
            });

            $(".iframeUpdateVerDoc").colorbox({ iframe: true, width: "90%", height: "90%" });
            $(".callbacks").colorbox({
                onClosed: function () {
                    window.location.reload(true);
                }
                    });
                    var text1 = $('#HfdegreeName').val();
        if ($('#72').val() != null) {

            $.getJSON('/Master/GetDegreeList/', function (data) {
                var items = '<option value="">--Select--</option>';
                $.each(data, function (i, degree) {
                    items += "<option value='" + degree.Value + "'>" + degree.Text + "</option>";
                });
                $('#72').html(items);
                $("#72 option").filter(function () {
                    return this.text == text1;
                }).attr('selected', true);
            });
             }

            $("#CollegeName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Master/getAutoCollegelist",
                        type: "POST",
                        dataType: "json",
                        data: { CollegeName: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.CollegeName, value: item.CollegeId };
                            }))
                        }
                    })
                },
                minLength: 2,
                select: function (event, ui) {
                    event.preventDefault();
                },
                focus: function (event, ui) {
                    event.preventDefault();
                    $("#CollegeName").val(ui.item.label);
                    $("#CollegeNameTemp").val(ui.item.label);
                    $('#CollegeId').val(ui.item.value);
                }
            });
        })

        $("#CollegeName").blur(function () {
            if ($("#CollegeName").val() != $("#CollegeNameTemp").val()) {
                $("#CollegeName").val("");
                $('#CollegeId').val("0");
                $('#CollegeAddress').val("");
            }
        });

        $(function () {
            $('#CollegeName').change(function () {
                var CurOrg = $("#CollegeName").val();
                var url = "/ProvidedInfo/CollegeAddress/" + $("#CollegeId").val();
                $.ajax({
                    url: url,
                    type: 'GET',
                    async: false,
                    dataType: 'json',
                    success: function (Address) {
                        $('#CollegeAddress').val(Address);
                    }
                });
            });

            $('#72').change(function () {

                $('#HfdegreeName').val($('#72 option:selected').text());

            });
                });



    </script>

}
<style>

    .mandatory-star {
        color: red;
    }

    .btn {
        padding: 10px 40px 10px 40px !important;
    }

    input[type=text], textarea {
        width: 100%;
        padding: 22px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    select {
        width: 100%;
        padding: 14px;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    label {
        padding: 12px 12px 12px 0;
        display: inline-block;
    }

    input[type=submit] {
        background-color: #04AA6D;
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        float: right;
    }

        input[type=submit]:hover {
            background-color: #45a049;
        }

    .container {
        border-radius: 5px;
        /*background-color: #f2f2f2;*/
        padding: 8px;
        font-size: 1.2rem !important;
    }

    .col-25 {
        float: left;
        width: 25%;
        margin-top: 6px;
    }

    .col-75 {
        float: left;
        width: 40%;
        margin-top: 6px;
        margin-left: 90px;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }


    /* Responsive layout - when the screen is less than 600px wide, make the two columns stack on top of each other instead of next to each other */
    @@media screen and (max-width: 600px) {
        .col-25, .col-75, input[type=submit] {
            width: 100%;
            margin-top: 0;
        }
    }
</style>
<style>
    .ui-widget.ui-widget-content {
        width: 20%;
    }

    img {
        width: 50px;
        height: 25px;
    }
</style>


<script type="text/javascript">
    $(document).ready(function () {
        $('#172').datepicker({
            dateFormat: "dd-M-yy",
            changeMonth: true,
            changeYear: true,
            showButtonPanel: true,
            maxDate: 'today',
        });
        var dNow = new Date();
        var localdate = (dNow.getFullYear() + '-' + (dNow.getMonth() + 1) + '-' + dNow.getDate());
        $('#OrderDate').val(localdate);
        $('#goBack').click(function () {
            parent.history.back();
            return false;
        });
    });
    $("#172").keypress(function (e) {
        return false;
    });
    $("#172").keydown(function (e) {
        return false;
    });

</script>
