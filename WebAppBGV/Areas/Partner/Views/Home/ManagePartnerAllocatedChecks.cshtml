@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>

    <script type="text/javascript">
        $(".Complete").on("click", function () {
            var str = $(this).attr("id").split("_");
            id = str[1];
            pid = str[2];
            subid = str[3];

            var flag = confirm('Are you sure to completed this check ?');
            if (id != "" && flag) {
                $.ajax({
                    type: "GET",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("CompletedByPRTMgr", "Home")',
                    data: { "id": id,"pid":pid,"subid":subid },
                    dataType: "json",
                    beforeSend: function () { },
                    success: function (data) {
                        if (data.result == true) {
                            alert("This Check is Completed Successfully!");
                            setTimeout(function () { window.location.replace("ManagePartnerAllocatedChecks"); }, 500);
                        }
                        else {
                            alert('There is some error');
                        }
                    }
                });
            }
        });

        //===========================================

                   $(document).ready(function () {
               // 1st replace first column header text with checkbox
               $("#grid th").each(function () {
                   if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                       $(this).text('');
                       $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                       //$(this).append("<span>Select All</span>");
                   }
               });

               //2nd click event for header checkbox for select /deselect all
               $('#select_all').change(function () {
                   $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                   var VerificationIds = '';
                   var OCVerIDs = '';
                   $('input[class="verificationId"]').each(function (index, value) {
                       if (this.checked) {
                           var id = this.value.split('_');
                           VerificationIds += id[0] + ',';
                           OCVerIDs += this.value + ',';
                       }
                   });
                   if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                       VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                       OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
                   } else {
                       VerificationIds = '';
                       OCVerIDs = '';
                   }

               });
           });
           $(document).on('change', 'input[class="verificationId"]', function (e) {// on change of state
               var VerificationIds = '';
               var OCVerIDs = '';
               $('input[class="verificationId"]').each(function (index, value) {
                   if (this.checked) {
                       var id = this.value.split('_');
                       VerificationIds += id[0] + ',';
                       OCVerIDs += this.value + ',';
                   }
               });

               if (false == $(this).prop("checked")) { //if this item is unchecked
                   $("#select_all").prop('checked', false); //change "select all" checked status to false
               }
               //check "select all" if all checkbox items are checked
               if ($('.verificationId:checked').length == $('.verificationId').length) {
                   $("#select_all").prop('checked', true);
               }

               if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                   VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                   OCVerIDs = OCVerIDs.substring(0, OCVerIDs.length - 1);
               } else {
                   VerificationIds = '';
                   OCVerIDs = '';
               }

           })





             document.getElementById('allocateButton').addEventListener('click', function() {


                 var selectedChecks = $('input[class="verificationId"]:checked');
                 var checkData = [];

                 selectedChecks.each(function () {
                     var id = $(this).val().split('_');
                     if (id.length > 1) {
                         checkData.push({
                             SubCheckRowID: id[1],
                             PersonalRowID: id[0]
                         });
                     }
                 });

                 var VendorLoginRowID = document.getElementById('vendorDropdown').value;

                 if (VendorLoginRowID.length === 0) {
                     /*alert('Please select a Partner before submitting.');*/
                     $('#Warningmessage').show();
                     e.preventDefault();
                     return;
                 }

                 if (checkData.length === 0) {
                     //alert('Please select at least one check before submitting.');
                     $('#Warningmessage').show();
                     e.preventDefault();
                     return;
                 }


                 $('#CheckData').val(JSON.stringify(checkData));

                  var form = document.createElement('form');
                  form.method = 'POST';
                  form.action = '@Url.Action("PartnerCheckMovement", "Home")';


                 var VendorLoginRowID = document.getElementById('vendorDropdown').value;
                  var checkData = document.getElementById('CheckData').value;

                  var inputVendorRowID = document.createElement('input');
                  inputVendorRowID.type = 'hidden';
                  inputVendorRowID.name = 'VendorRowID';
                 inputVendorRowID.value = VendorLoginRowID;

                  var inputCheckData = document.createElement('input');
                  inputCheckData.type = 'hidden';
                  inputCheckData.name = 'CheckData';
                  inputCheckData.value = checkData;

                  form.appendChild(inputVendorRowID);
                  form.appendChild(inputCheckData);

                  // Append the form to the body and submit
                  document.body.appendChild(form);
                  form.submit();
               });
        //==========================================
    </script>

}
