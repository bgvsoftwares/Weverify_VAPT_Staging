                                columns.Add(grid.Column(columnName: "Remarks", header: "Remarks", canSort: false, style: "td-2"));
                                columns.Add(grid.Column(columnName: "PartnerUserName", header: "Alloc Part User", canSort: false, style: "td-1"));
                                grid.Column(columnName: "VendorMobileNo", header: "Candidate Mobile No.", canSort: false, style: "td-1");
columns.Add(grid.Column(header: "Verification", format: (item) =>
{
    if (item.CheckFamilyRowID == 12)
    {
        return Html.ActionLink("Complete", "AddEmploymentInfoByPTR", "Home", new { PersonalRowID = item.PersonalRowID, subCheckId = item.SubCheckRowID, ClientRowId = item.ClientRowID }, null);
    }
