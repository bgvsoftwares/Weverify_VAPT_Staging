                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");


                                var columns = new List<WebGridColumn>();


                                if (isUserAllocated && (Session["VendorRowID"].ToString() == "141" || Session["VendorRowID"].ToString() == "140" || Session["VendorRowID"].ToString() == "1"))
                                {
                                    columns.Add(grid.Column(header: "{checkall}", format: @<text> <input type="checkbox" value="@(item.PersonalRowID + "_" + item.SubCheckFamilyId)" name="verificationId" class="verificationId" /> </text>, style: "checkbox-column"));
                                }

                                // Always add these columns
                                columns.Add(grid.Column(header: "No.", style: "", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex));
                                columns.Add(grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style: "td-2"));
                                columns.Add(grid.Column(columnName: "CompanyRefNo", header: "CompanyRefNo", canSort: false, style: "td-2"));
                                columns.Add(grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style: "td-2"));
                                columns.Add(grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style: "td-1"));
                                columns.Add(grid.Column(columnName: "StateName", header: "State", canSort: false, style: "td-1"));
