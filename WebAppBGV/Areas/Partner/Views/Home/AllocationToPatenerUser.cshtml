
@{
    ViewBag.Title = "Allocation To Patener Users";
    Layout = "~/Areas/Partner/Views/Shared/_Layout.cshtml";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }
@section DisplayErrorMessage{ @Html.Partial("_DisplayErrorMessage") }
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("AllocationToPatenerUser", "Home", FormMethod.Get))
                        {
                            if (!string.IsNullOrEmpty(Request.QueryString["CaseStatus"]))
                            {
                                @Html.Hidden("CaseStatus", Request.QueryString["CaseStatus"])
                            }
                            // @Html.HiddenFor(Model => Model.CaseStatus)
                        <div class="form-horizontal mt-3 mb-5" style="padding: 0px 100px;">
                            <div class="form-group branch search-frame row">
                                <label class="col-md-2 control-label font-weight-bold">State Name :</label>
                                <div class="col-md-10">
                                    @Html.DropDownList("StateRowID",
 new SelectList(ViewBag.VendorStatesList, "StateRowID", "StateName"),
 "-- Select State -- ",
 new { @class = "form-control" })
                                </div>
                            </div>
                            @Html.Hidden("VerificationIds", null)
                            <div class="form-group branch search-frame row">
                                <label class="col-md-2 control-label font-weight-bold">Keyword :</label>
                                <div class="col-md-4">
                                    @Html.TextBox("Search", null, new { @class = "form-control", placeholder = "Ex. Enter Candidate name, Ref No..." })
                                </div>

                                <label class="col-md-2 control-label font-weight-bold">Select User :</label>
                                <div class="col-md-4">
                                    @Html.DropDownList("VendorLoginRowID",
 new SelectList(ViewBag.VendorUserList, "VendorRowID", "VendorName"),
 "-- Select User -- ",
 new { @class = "form-control" })
                                </div>
                            </div>
                            @Html.Hidden("VerificationIds", null)
                            <div class="form-group branch search-frame row justify-content-center mt-4">
                                <div class="col-md-2 text-end">
                                    <input class="btn bun-bg btn-default" type="submit" value="Search" />
                                </div>
                                <div class="col-md-2">
                                    <input class="btn bun-bg btn-default" type="submit" id="btnAllocation" onclick="return validateForm()" value="Allocate" />
                                </div>
                                <div class="col-md-2">
                                    @{
                                        if (Request.QueryString["CaseStatus"] != null)
                                        {
                                            <div>
                                                @Html.ActionLink("Export Excel", "ExportExeclNonAllocatedReport", new { CaseStatus = Request.QueryString["CaseStatus"] }, new { @class = "btn bun-bg btn-default" })
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12 table table-striped">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "{checkall}",format: @<text> <input type="checkbox" value="@(item.VerificationRowID+"_"+item.CheckFamilyRowID)" name="verificationId" class="verificationId" /> </text>,style:"width: 3rem !important;"),
                                                                                                                                                grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                                                                                                                                grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-3"),
                                                                                                                                                grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"col-3"),
                                                                                                                                                grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"col-3"),
                                                                                                                                                grid.Column(columnName: "StateName", header: "State", canSort: false, style:"col-1"),
                                                                                                                                                grid.Column(columnName: "DistrictName", header: "City", canSort: false, style:"col-1"),
                                                                                                                                                grid.Column(columnName: "Address", header: "Address", canSort: false, style:"col-1"),
                                                                                                                                                //grid.Column(header : "Unique Component", format : (item) => {
                                                                                                                                                //     string ComponentID=item.UniqueComponentID;
                                                                                                                                                //    return ComponentID;
                                                                                                                                                //}, style:"col-md-2"),
                                                                                                                                                grid.Column("Ageing", format: (item) => item.ModifiedDate != null ? (DateTime.Now - item.ModifiedDate).Days : "", canSort: false,style:"col-1"),
                                                                                                                                                grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:"col-1"),
                                                                                                                                                 grid.Column(columnName: "PartnerUserName", header: "Alloc Part User", canSort: false, style:"col-3"),
                                                                                                                                                 grid.Column(columnName: "VendorMobileNo", header: "Candidate Mobile No.", canSort: false, style:"col-3"),

                                                                                                                           }
                                                                                                                    )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                            <br />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>

    @*<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>*@
    <script type="text/javascript">
        $(document).ready(function () {
            // 1st replace first column header text with checkbox
            $("#grid th").each(function () {
                if ($.trim($(this).text().toString().toLowerCase()) === "{checkall}") {
                    $(this).text('');
                    $("<input/>", { type: "checkbox", id: "select_all", value: "" }).appendTo($(this));
                    //$(this).append("<span>Select All</span>");
                }
            });

            //2nd click event for header checkbox for select /deselect all
            $('#select_all').change(function () {
                $('input[class="verificationId"]').prop('checked', $(this).prop('checked'));
                var VerificationIds = '';
                $('input[class="verificationId"]').each(function (index, value) {
                    if (this.checked) {
                        var id = this.value.split('_');
                        VerificationIds += id[0] + ',';
                    }
                });
                //if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
                if (VerificationIds.length > 0) {
                    VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
                } else {
                    VerificationIds = '';
                }
                $('#VerificationIds').val(VerificationIds.trim());
            });
        });

        function SearchFunction() {
            $('#VerificationIds').val("");
        }

        //3rd click event for checkbox of each row
        $(document).on('change', 'input[class="verificationId"]', function (e) {// on change of state
            var VerificationIds = '';
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) {
                    var id = this.value.split('_');
                    VerificationIds += id[0] + ',';
                }
            });

            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("#select_all").prop('checked', false); //change "select all" checked status to false
            }
            //check "select all" if all checkbox items are checked
            if ($('.verificationId:checked').length == $('.verificationId').length) {
                $("#select_all").prop('checked', true);
            }

            //if (VerificationIds.length > 0 && OCVerIDs.length > 0) {
            if (VerificationIds.length > 0) {
                VerificationIds = VerificationIds.substring(0, VerificationIds.length - 1);
            } else {
                VerificationIds = '';
            }
            $('#VerificationIds').val(VerificationIds.trim());
        })

        function validateForm() {
            if ($("#VendorLoginRowID").val() == 0) {
                alert("Select User For Allocation!");
                return false;
            }

            var count = 0;
            $('input[class="verificationId"]').each(function (index, value) {
                if (this.checked) { count += 1; }
            });

            if (count == 0) {
                alert("Please select atleast one case.");
                return false;
            }
            return true;
        }
    </script>
}
