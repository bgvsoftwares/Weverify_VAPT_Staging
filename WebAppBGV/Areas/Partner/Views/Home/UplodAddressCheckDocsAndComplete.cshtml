@model ViewModels.ProvidedInfoViewModel.VerifiedUploadAddressDocViewModel
@{
    ViewBag.Title = "Upload Address Check Ver Docs";
    Layout = null;
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" type="text/css" />
<link href="~/Content/colorbox.css" rel="stylesheet" />
<link href="~/Content/Site.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/modernizr-2.8.3.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<div class="row">
    <div class="col-md-12">
        @if (ViewBag.SuccessMsg != null)
        {
            <div class="successmsg">@ViewBag.SuccessMsg.ToString()</div>
        }

        @if (ViewBag.ErrorMsg != null)
        {
            <div class="errormsg">@ViewBag.ErrorMsg.ToString()</div>
        }
    </div>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="all-button-bg">
            <strong> Upload Address Check Ver Docs </strong>
        </div>
        @using (Html.BeginForm("UplodAddressCheckDocsAndComplete", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.SubCheckRowID)
            @Html.HiddenFor(model => model.PersonalRowID)
            @Html.HiddenFor(model => model.CheckStatus)
            @Html.HiddenFor(model => model.ClientRowID)
            <div class="form-horizontal">

                <div class="form-group branch row">
                    <label class="col-md-3 control-label">Document Type :</label>
                    <div class="col-md-3" style="padding-left:0px !important;">
                        @if (Model.ClientRowID == 990)
                        {
                            @Html.DropDownListFor(model => model.DocumentType, new List<SelectListItem>
                                    { new SelectListItem{Text="Verification Form", Value="Verification Form"},
                                new SelectListItem{Text="Housephoto", Value="Housephoto"},
                                    new SelectListItem{Text="LandmarkPhoto", Value="LandmarkPhoto"},
                                    new SelectListItem{Text="IDProof", Value="IDProof"},
                                    new SelectListItem{Text="EmployeePhoto", Value="EmployeePhoto"},
                                    new SelectListItem{Text="VerifierPhoto", Value="VerifierPhoto"},
                                    new SelectListItem{Text="NeighbourPhoto", Value="NeighbourPhoto"},
                                    new SelectListItem{Text="GPSLocation", Value="GPSLocation"},
                                    new SelectListItem{Text="Signature", Value="Signature"},
                                    },
                                "-- Select --",
                                new { @class = "form-control col-md-3" })
                        }
                        else
                        {
                            @Html.DropDownListFor(model => model.DocumentType, new List<SelectListItem>
                                     {new SelectListItem{Text="Verification Form", Value="Verification Form"},
                                     new SelectListItem{Text="Housephoto", Value="Housephoto"},
                                     new SelectListItem{Text="LandmarkPhoto", Value="LandmarkPhoto"},
                                     new SelectListItem{Text="IDProof", Value="IDProof"},
                                     new SelectListItem{Text="Area Photo", Value="Area Photo"},
                                     new SelectListItem{Text="Address Proof", Value="Address Proof"},
                                     new SelectListItem{Text="Digital Geo Tagging Details", Value="Digital Geo Tagging Details"},
                                     new SelectListItem{Text="Signature", Value="Signature"},
                                     new SelectListItem{Text="Others if any", Value="Others if any"},
                                     },
                                 "-- Select --",
                                 new { @id = "DocumentTypeDDL", @class = "form-control" })
                        }
                    </div>
                    <div class="col-md-3" id="OtherDocumentTypeDiv" style="display:none;">
                        @Html.TextBoxFor(model => model.OtherDocumentType, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3"></div>
                </div>

                <div class="form-group branch row">
                    @Html.LabelFor(model => model.UploadAddressDoc, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="form-control col-md-3">
                        @Html.TextBoxFor(model => model.UploadAddressDoc, new { @id = "UploadAddressDoc", @accept = "image/gif, image/jpeg, image/png, image/jpg", type = "file", multiple = "multiple" })
                    </div>
                    <div class="col-md-3">
                        <input class="btn bun-bg btn-default" type="submit" name="Upload" onclick="return validateForm()" value="Upload" />
                    </div>
                    <div class="col-md-3"></div>
                </div>
                <table width="100%" id="displaydoc">
                    <tr>
                        <td>
                            <div class="personal-details-head"><i class="fa fa-file-text-o" aria-hidden="true"></i> Document List :</div>
                        </td>
                    </tr>
                    <tr>
                        <td height="2"></td>
                    </tr>
                    <tr>
                        <td valign="top">

                            <table class="table">
                                <thead class="thead-inverse">
                                    <tr>
                                        <th class="top-head">Document Type</th>
                                        <th class="top-head">Partner File Name</th>
                                        <th class="top-head">Upload From</th>
                                        <th class="top-head">Remarks</th>
                                        <th class="top-head">Upload Date</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ViewBag.GetDocumentList)
                                    {
                                        <tr>
                                            <td class="name">@item.DocumentType</td>
                                            <td class="filename">
                                                @if (Session["VendorRowID"] != null && (item.GeoCo != null && item.GeoCo != ""))
                                                {
                                                    <table>
                                                        <tr>
                                                            <td style="font-size:xx-small"> <a href="@Url.Action("GetSubNotMatchMail", "Home", new { ImageName = item.FileName })">@item.FileName</a></td>
                                                            @*@if (item.GeoCo != "")
                                                                {*@
                                                            <td style="font-size:xx-small">  @item.GeoCo </td>
                                                            <td>
                                                                <a href="@Url.Action("MobiledeleteDoc", "Home", new { personalRowId = @item.PersonalRowID, subCheckId = @item.SubCheckRowID,doctype=@item.DocumentType,fileName=@item.FileName,gtr=HttpContext.Current.Request.Url.ToString().ToLower()  })" onclick="return confirm('Are you sure you want to delete doc?')"><img id="btndelete" src='@Url.Content("~/Images/Delete-Icon-PNG-Graphic-Cave.png")' width="5%" height="5%" /></a>
                                                            </td>

                                                            @*}*@


                                                        </tr>
                                                    </table>


                                                }
                                                else
                                                {
                                                    <a target="_blank" href='@Url.Content("~/Documents/CandidateDocuments/ProvidedDocuments/" + @item.FileName)'>@item.FileName</a>
                                                    <a href="@Url.Action("delete", "Home", new { personalRowId = @item.PersonalRowID, subCheckId = @item.SubCheckRowID,doctype=@item.DocumentType,fileName=@item.FileName,VerifiedUploadRowID = item.VerifiedUploadRowID,gtr=HttpContext.Current.Request.Url.ToString().ToLower()  })" onclick="return confirm('Are you sure you want to delete doc?')"><img id="btndelete" src='@Url.Content("~/Images/Delete-Icon-PNG-Graphic-Cave.png")' width="5%" height="5%" /></a>


                                                }


                                            </td>
                                            <td class="name">@item.DocumentUploadFrom</td>
                                            <td class="name">@item.Remarks</td>
                                            <td class="name">@item.UploadDate</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td height="12" colspan="5"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
                <div class="all-button-bg">
                    @*<input class="btn bun-bg btn-default" type="submit" value="Submit" />*@
                </div>
            </div>
        }

    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <script src='@Url.Content("~/Scripts/EventValidations.js")'></script>
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />


}
<script type="text/javascript">
    function validateForm() {
        var docType = $("#DocumentType").val();
        if (docType == '') {
            alert('Please select Document Type');
            return false;
        }

        if (document.getElementById("UploadAddressDoc").files.length == 0) {
            alert('Please upload document');
            return false;
        }
    }
</script>

<script>
    $(document).ready(function () {
        function fnToggleOtherBox() {
            var selected = $('#DocumentTypeDDL').val();
            if (selected === "Others if any") {
                $('#OtherDocumentTypeDiv').show();
            } else {
                $('#OtherDocumentTypeDiv').hide();
                $('#OtherDocumentTypeDiv input').val("");
            }
        }

        //on load (returns to form)
        fnToggleOtherBox();

        //DDL changes event
        $('#DocumentTypeDDL').change(function () {
            fnToggleOtherBox();
        });
    });
</script>



