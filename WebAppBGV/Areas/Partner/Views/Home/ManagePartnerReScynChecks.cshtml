

@{
    ViewBag.Title = "Manage Re-Sync Checks";
    Layout = "~/Areas/Partner/Views/Shared/_Layout.cshtml";
}

@section DisplayTitle{ @Html.Partial("_DisplayTitle") }

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        @using (Html.BeginForm("ManagePartnerReScynChecks", "Home", FormMethod.Get))
                        {
                            <div class="form-horizontal">
                                <div class="form-group branch search-frame">
                                    <label class="col-md-2 control-label">Partner User Name :</label>
                                    <div class="col-md-4">
                                        @Html.DropDownList("VendorUserRowID",
                                        new SelectList(ViewBag.VendorUserList, "VendorRowID", "VendorName"),
                                        "-- Select Vendor User -- ",
                                        new { @class = "form-control" })
                                    </div>
                                </div>                               
                                <div class="all-button-bg">
                                    <input class="btn bun-bg btn-default" type="submit" id="btnAllocation" onclick="return validateForm()" value="Search" />
                                    <input class="btn bun-bg btn-default" type="submit" id="btnResync" name="Resync"  onclick="return validateForm1()" value="Re-Sync" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model != null && Model.PQVerificationInfo != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            @{

                                WebGrid grid = new WebGrid(rowsPerPage: Model.PageSize, ajaxUpdateContainerId: "grid");
                                grid.Bind(Model.PQVerificationInfo, autoSortAndPage: false, rowCount: Model.TotalRecords);
                            }
                            @grid.GetHtml(
                                    htmlAttributes: new { id = "grid", @class = "table" },
                                    headerStyle: "thead-inverse",
                                    rowStyle: "ordertxt",
                                    footerStyle: "custpaging",
                                    mode: WebGridPagerModes.All,
                                    columns: new[]
                                    {
                                    grid.Column(header: "No.", style:"", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
                                    grid.Column(columnName: "ClientName", header: "Client Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "SubCheckName", header: "Check Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "PersonalName", header: "Candidate Name", canSort: false, style:"col-md-2"),
                                    grid.Column(columnName: "StateName", header: "State", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "DistrictName", header: "City", canSort: false, style:"col-md-1"),
                                    grid.Column(columnName: "UniqueComponentID", header: "Unique Component ID", canSort: false, style:"col-md-2"),
                                    grid.Column("Ageing", format: (item) => item.CreatedDate != null ? (DateTime.Now - item.CreatedDate).Days : "", canSort: false,style:"col-md-1"),
                                    grid.Column(columnName: "CheckStatus", header: "Status", canSort: false, style:"col-md-1"),
                                     grid.Column(columnName: "IsSynced", header: "IsSync", canSort: false, style:"col-md-2"),
                                    }
                             )
                            <div class="total-record">Total Records: @Model.TotalRecords</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src='@Url.Content("~/Scripts/jquery.validate.min.js")'></script>
    <script src='@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")'></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            if ($("#VendorUserRowID").val() > 0) {
                $("#btnResync").attr("disabled", false);
            }
            else {
                $("#btnResync").attr("disabled", true);
            }
            if (@Model.TotalRecords >0) {
                $("#btnResync").attr("disabled", false);
            }
            else {
                $("#btnResync").attr("disabled", true);
            }
        });
      
        $('#VendorUserRowID').change(function () {
            $("#btnResync").attr("disabled", true);
        });
        function validateForm1() {
            if ($("#VendorUserRowID").val() == 0) {
                alert("Select Partner User Name.");
                return false;
            }

            return true;
        }
        function validateForm() {
            $("#btnResync").attr("disabled", false);
            return true;
        }
    </script>

}
